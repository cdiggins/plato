// Positive: Evaluable has an object-safe member (Eval uses Self only as the receiver), so it
// has a non-generic view and an existential (type-position) reference to it is well-formed.
// Self-contained on purpose: fixtures compile without the stdlib, so no Number/Boolean here.
type Scalar
{
}

concept Evaluable
{
    Eval(x: Self, t: Scalar): Scalar;
}

type StoredEvaluable
{
    Source: Evaluable;
}
