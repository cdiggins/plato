{
  "name": "plato",
  "displayName": "Plato",
  "description": "Syntax highlighting and Go to Definition / Find References for the Plato programming language (.plato)",
  "version": "0.2.7",
  "publisher": "ara3d",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "plato",
    "geometry",
    "syntax",
    "navigation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ara3d/plato"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:plato"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.4.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "plato",
        "aliases": [
          "Plato",
          "plato"
        ],
        "extensions": [
          ".plato"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plato",
        "scopeName": "source.plato",
        "path": "./syntaxes/plato.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "plato.navigation.reload",
        "title": "Plato: Reload Navigation Index"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "editor.action.revealDefinition",
          "when": "resourceLangId == plato",
          "group": "navigation@1"
        },
        {
          "command": "editor.action.goToReferences",
          "when": "resourceLangId == plato",
          "group": "navigation@2"
        },
        {
          "command": "plato.navigation.reload",
          "when": "resourceLangId == plato",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Plato",
      "properties": {
        "plato.navigation.roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Plato source folders to index. Empty = discover from the open file (nearest stdlib / stdlib-legacy / … corpus) or each workspace folder."
        },
        "plato.navigation.cliProject": {
          "type": "string",
          "default": "",
          "description": "Path to Plato.Navigation.CLI.csproj (absolute, or relative to the first workspace folder). Leave empty to auto-discover under src/Plato.Navigation.CLI."
        },
        "plato.navigation.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "description": "dotnet executable used to build and run Plato.Navigation.CLI when no .exe is present."
        }
      }
    }
  }
}
