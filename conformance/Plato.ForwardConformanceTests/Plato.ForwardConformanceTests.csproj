<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FORWARD-stdlib conformance suite (sibling of Ara3D.SDK.ConformanceTests).

    Runs the reflection law runner over C# generated from the v3 forward stdlib
    (submodules\Plato\stdlib) merged with its law packet (submodules\Plato\stdlib-tests),
    against the Plato.Intrinsics.V2 runtime.

    STATUS (2026-07-29): codegen SUCCEEDS (1232 .g.cs files) — the old "No ground TIR for
    bodied ..." writer abort is fixed. The suite still does not build: the generated C# has
    324 compile errors in 25 files, mostly the concept-as-generic-interface lowering cluster.
    Tracked as plato-308; see README.md for the error map and why file-level quarantine was
    measured and rejected. BlockerGuardTests keeps this an explicit RED, never a vacuous green.
    Activate by fixing plato-308, then run tools\regen-forward-conformance.ps1 -Test.

    Run tools\regen-forward-conformance.ps1 (studio repo) before building: Generated\ is not
    committed. Deliberately not added to any .sln.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0660;CS0661;CS1591</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\Plato.Intrinsics.V2\Plato.Intrinsics.V2.projitems" Label="Shared" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\ara3d-sdk\src\Ara3D.Collections\Ara3D.Collections.csproj" />
    <ProjectReference Include="..\..\..\..\ara3d-sdk\src\Ara3D.Memory\Ara3D.Memory.csproj" />
    <ProjectReference Include="..\..\..\..\ara3d-sdk\src\Ara3D.Utils\Ara3D.Utils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <None Update="KnownFailures.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    NO file-level quarantine here, and that was MEASURED, not assumed. Excluding the 16
    generated files that fail to compile (the CS0315 surface/solid cluster and the CS0305
    implicit-field libraries) does not isolate them: CurvesSampling.g.cs and
    GeometryTraits.g.cs reference SurfaceOfRevolution / ExtrudedSurface / RuledSurface /
    SweptSurface / TubeSurface / CoonsPatch / SweptSolid directly, so the exclusion cascades
    into 148 CS0246 "type could not be found" errors. Quarantining those referrers in turn
    pulls in more. The forward stdlib is too densely linked for build-level quarantine; the
    codegen defects have to be fixed. See plato-308.
  -->

</Project>
