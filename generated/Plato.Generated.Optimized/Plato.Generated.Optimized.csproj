<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plato.Generated.Optimized - the extension-style, scalar-erased shape of the LEGACY Plato
    standard library with the full optimizer pipeline on.

    EMPTY SHELL since 2026-08-01: the .g.cs sources were deleted because the scalar-erasure
    recipe no longer matches the runtime. This project is kept, and kept in Plato.sln, so the
    recipe stays recorded and the solution builds green. See generated\README.md.

    Recipe - flags shown without the leading dashes:
        Plato.CLI legacy\stdlib-legacy generated\Plato.Generated.Optimized
            csharp-style=extensions scalar=float no-properties
            optimize optimize-arrays inline methods loops

    Not a golden (diff-gate retired 2026-07-30). docs.html / interfaces.txt are generator
    side-products and are gitignored.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Ara3D.Geometry</RootNamespace>
    <!-- Generated code produces a large number of benign warnings. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0660;CS0661;CS1591</NoWarn>
  </PropertyGroup>

  <!-- Link the handwritten intrinsics runtime (shared project). Its primitive no-arg members
       are METHODS (not properties), matching the no-properties recipe. -->
  <Import Project="..\..\src\Plato.Intrinsics\Plato.Intrinsics.projitems" Label="Shared" />

  <ItemGroup>
    <PackageReference Include="Ara3D.SDK.Core" Version="$(Ara3DVersion)" />
    <!-- This project compiles its own Ara3D.Geometry namespace; the package of that name
         is the old V1 library and would make every extension method ambiguous. -->
    <PackageReference Include="Ara3D.Geometry" Version="$(Ara3DVersion)" ExcludeAssets="compile" />
  </ItemGroup>

</Project>
