<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plato.Generated.Optimized - buildable golden of the extension-style, scalar-erased
    Plato standard library with the FULL OPTIMIZER PIPELINE ON. This is the intended
    adoption/shipping shape.

    Recipe (see generated\README.md) - flags shown without the leading dashes:
        Plato.CLI stdlib-legacy generated\Plato.Generated.Optimized
            csharp-style=extensions scalar=float
            optimize optimize-arrays inline methods loops

    Same recipe the Scalar conformance suite semantically gates. Diff against
    Plato.Generated.Unoptimized to see what the optimizer passes change.

    Regenerate with tools\regen-generated.ps1 (studio repo). The .g.cs files ARE committed
    (this is a golden); docs.html / interfaces.txt generator side-products are gitignored.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Ara3D.Geometry</RootNamespace>
    <!-- Generated code produces a large number of benign warnings. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0660;CS0661;CS1591</NoWarn>
  </PropertyGroup>

  <!-- Link the handwritten intrinsics runtime (shared project). V2 exposes the primitive
       no-arg members as METHODS (not properties), matching the no-properties recipe. -->
  <Import Project="..\..\src\Plato.Intrinsics\Plato.Intrinsics.projitems" Label="Shared" />

  <ItemGroup>
    <PackageReference Include="Ara3D.SDK.Core" Version="$(Ara3DVersion)" />
    <!-- This project compiles its own Ara3D.Geometry namespace; the package of that name
         is the old V1 library and would make every extension method ambiguous. -->
    <PackageReference Include="Ara3D.Geometry" Version="$(Ara3DVersion)" ExcludeAssets="compile" />
  </ItemGroup>

</Project>
