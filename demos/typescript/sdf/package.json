{
  "name": "plato-sdf-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive Three.js demo of Plato forward-stdlib SDFs, driven by TypeScript generated from stdlib.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:plato": "dotnet run --project ../../../src/Plato.CLI -c Release -- ../../../stdlib/foundation ../../../stdlib/geometry ../../../stdlib/graphics --out=./src/plato --typescript && node ./scripts/stamp-nocheck.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
