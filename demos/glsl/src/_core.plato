// Shared core for the Plato -> GLSL demos.
//
// Primitive scaffolding + concepts + intrinsics + scalar/vector math. Everything
// here is chosen to be GLSL-portable: pure functions over Number / Vector2D /
// Vector3D, no arrays of dynamic length, no function values. The bodiless
// Intrinsics map straight onto GLSL built-ins in Plato.GlslWriter.
//
// (This file is copied into each demo's input folder; the CLI compiles one folder
//  into one plato.glsl, so each demo is self-contained.)

// ---- Concepts ---------------------------------------------------------------

concept Equatable  { Equals(a: Self, b: Self): Boolean; }
concept Comparable { Compare(a: Self, b: Self): Integer; }
concept Numerical
{
    Add(a: Self, b: Self): Self;
    Subtract(a: Self, b: Self): Self;
    Negative(a: Self): Self;
}
concept Array<T>
{
    Count(xs: Self): Integer;
    At(xs: Self, n: Integer): T;
}

// ---- Primitive scaffolding (assumed by the compiler) ------------------------

type Number  implements Numerical, Comparable { }
type Integer implements Comparable { }
type Boolean { }
type String { }
type Character { }
type Dynamic { }
type Type { }

type Tuple2<T0, T1>     { X0: T0; X1: T1; }
type Tuple3<T0, T1, T2> { X0: T0; X1: T1; X2: T2; }
type Tuple4<T0, T1, T2, T3>         { X0: T0; X1: T1; X2: T2; X3: T3; }
type Tuple5<T0, T1, T2, T3, T4>     { X0: T0; X1: T1; X2: T2; X3: T3; X4: T4; }
type Tuple6<T0, T1, T2, T3, T4, T5> { X0: T0; X1: T1; X2: T2; X3: T3; X4: T4; X5: T5; }
type Tuple7<T0, T1, T2, T3, T4, T5, T6>     { X0: T0; X1: T1; X2: T2; X3: T3; X4: T4; X5: T5; X6: T6; }
type Tuple8<T0, T1, T2, T3, T4, T5, T6, T7> { X0: T0; X1: T1; X2: T2; X3: T3; X4: T4; X5: T5; X6: T6; X7: T7; }
type Function1<T0, TR>      { }
type Function2<T0, T1, TR>  { }

type Angle    { Radians: Number; }
type Vector2D implements Numerical { X: Number; Y: Number; }
type Vector3D implements Numerical { X: Number; Y: Number; Z: Number; }

// ---- Intrinsics: bodiless, mapped to GLSL built-ins by the writer -----------

library Intrinsics
{
    Add(x: Number, y: Number): Number;
    Subtract(x: Number, y: Number): Number;
    Multiply(x: Number, y: Number): Number;
    Divide(x: Number, y: Number): Number;
    Modulo(x: Number, y: Number): Number;
    Negative(x: Number): Number;

    LessThan(x: Number, y: Number): Boolean;
    GreaterThan(x: Number, y: Number): Boolean;
    LessThanOrEquals(x: Number, y: Number): Boolean;
    GreaterThanOrEquals(x: Number, y: Number): Boolean;
    Compare(x: Number, y: Number): Integer;
    Compare(x: Integer, y: Integer): Integer;
    LessThan(x: Integer, y: Integer): Boolean;
    LessThanOrEquals(x: Integer, y: Integer): Boolean;
    Equals(x: Integer, y: Integer): Boolean;
    Add(x: Integer, y: Integer): Integer;
    ToNumber(x: Integer): Number;

    And(x: Boolean, y: Boolean): Boolean;
    Or(x: Boolean, y: Boolean): Boolean;
    Not(x: Boolean): Boolean;

    Sqrt(x: Number): Number;
    Abs(x: Number): Number;
    Floor(x: Number): Number;
    Fract(x: Number): Number;
    Sign(x: Number): Number;
    Exp(x: Number): Number;
    Pow(x: Number, y: Number): Number;
    Min(x: Number, y: Number): Number;
    Max(x: Number, y: Number): Number;
    Clamp(x: Number, lo: Number, hi: Number): Number;
    Lerp(a: Number, b: Number, t: Number): Number;
    Step(edge: Number, x: Number): Number;
    SmoothStep(a: Number, b: Number, x: Number): Number;

    Cos(x: Angle): Number;
    Sin(x: Angle): Number;
    Tan(x: Angle): Number;
    Atan2(y: Number, x: Number): Angle;
}

// ---- Scalar helpers ---------------------------------------------------------

library Numbers
{
    Square(x: Number): Number => x * x;

    Turns(x: Number): Angle   => new Angle(x * 6.2831853071795862);
    Degrees(x: Number): Angle => new Angle(x * 0.017453292519943295);

    Pi(): Number    => 3.1415926535897931;
    TwoPi(): Number => 6.2831853071795862;

    // Polynomial smooth minimum (Inigo Quilez), blend radius k.
    SmoothMin(a: Number, b: Number, k: Number): Number
    {
        var h = (0.5 + 0.5 * (b - a) / k).Clamp(0.0, 1.0);
        return b.Lerp(a, h) - k * h * (1.0 - h);
    }
}

// ---- 2D vectors -------------------------------------------------------------

library Vectors2
{
    Add(a: Vector2D, b: Vector2D): Vector2D      => new Vector2D(a.X + b.X, a.Y + b.Y);
    Subtract(a: Vector2D, b: Vector2D): Vector2D => new Vector2D(a.X - b.X, a.Y - b.Y);
    Negative(v: Vector2D): Vector2D              => new Vector2D(-v.X, -v.Y);
    Scale(v: Vector2D, s: Number): Vector2D      => new Vector2D(v.X * s, v.Y * s);

    Dot(a: Vector2D, b: Vector2D): Number   => a.X * b.X + a.Y * b.Y;
    Cross(a: Vector2D, b: Vector2D): Number => a.X * b.Y - a.Y * b.X;

    LengthSquared(v: Vector2D): Number => v.Dot(v);
    Length(v: Vector2D): Number        => v.LengthSquared.Sqrt;
    Normalize(v: Vector2D): Vector2D   => v.Scale(1.0 / v.Length);
    Distance(a: Vector2D, b: Vector2D): Number => b.Subtract(a).Length;

    Abs(v: Vector2D): Vector2D          => new Vector2D(v.X.Abs, v.Y.Abs);
    Min(a: Vector2D, b: Vector2D): Vector2D => new Vector2D(a.X.Min(b.X), a.Y.Min(b.Y));
    Max(a: Vector2D, b: Vector2D): Vector2D => new Vector2D(a.X.Max(b.X), a.Y.Max(b.Y));
    Lerp(a: Vector2D, b: Vector2D, t: Number): Vector2D => a.Scale(1.0 - t).Add(b.Scale(t));

    UnitCircle(theta: Angle): Vector2D => new Vector2D(theta.Cos, theta.Sin);
}

// ---- 3D vectors -------------------------------------------------------------

library Vectors3
{
    Add(a: Vector3D, b: Vector3D): Vector3D      => new Vector3D(a.X + b.X, a.Y + b.Y, a.Z + b.Z);
    Subtract(a: Vector3D, b: Vector3D): Vector3D => new Vector3D(a.X - b.X, a.Y - b.Y, a.Z - b.Z);
    Negative(v: Vector3D): Vector3D              => new Vector3D(-v.X, -v.Y, -v.Z);
    Scale(v: Vector3D, s: Number): Vector3D      => new Vector3D(v.X * s, v.Y * s, v.Z * s);

    Dot(a: Vector3D, b: Vector3D): Number => a.X * b.X + a.Y * b.Y + a.Z * b.Z;
    Cross(a: Vector3D, b: Vector3D): Vector3D
        => new Vector3D(a.Y * b.Z - a.Z * b.Y, a.Z * b.X - a.X * b.Z, a.X * b.Y - a.Y * b.X);

    LengthSquared(v: Vector3D): Number => v.Dot(v);
    Length(v: Vector3D): Number        => v.LengthSquared.Sqrt;
    Normalize(v: Vector3D): Vector3D   => v.Scale(1.0 / v.Length);
    Distance(a: Vector3D, b: Vector3D): Number => b.Subtract(a).Length;

    Abs(v: Vector3D): Vector3D              => new Vector3D(v.X.Abs, v.Y.Abs, v.Z.Abs);
    Min(a: Vector3D, b: Vector3D): Vector3D => new Vector3D(a.X.Min(b.X), a.Y.Min(b.Y), a.Z.Min(b.Z));
    Max(a: Vector3D, b: Vector3D): Vector3D => new Vector3D(a.X.Max(b.X), a.Y.Max(b.Y), a.Z.Max(b.Z));
    MaxComponent(v: Vector3D): Number       => v.X.Max(v.Y).Max(v.Z);
    Lerp(a: Vector3D, b: Vector3D, t: Number): Vector3D => a.Scale(1.0 - t).Add(b.Scale(t));

    Reflect(v: Vector3D, n: Vector3D): Vector3D => v.Subtract(n.Scale(2.0 * v.Dot(n)));
}
