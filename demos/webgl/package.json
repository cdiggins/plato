{
  "name": "plato-webgl-demos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive Three.js demos of the Plato stdlib — polyhedra, polygons, CSG, deformers, curves, surfaces, noise, colour spaces, transforms, marching cubes and voxels — driven by TypeScript generated from stdlib, with a Gratify control panel.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe": "tsx scripts/probe.mts",
    "smoke": "tsx scripts/smoke.mts",
    "gen:plato": "dotnet run --project ../../src/Plato.CLI -c Release -- ../../stdlib/foundation ../../stdlib/geometry ../../stdlib/graphics --out=./src/plato --typescript && node ./scripts/stamp-nocheck.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
