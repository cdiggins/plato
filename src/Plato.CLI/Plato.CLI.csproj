<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- A generation retains about 1 GB of syntax and TIR, so collections are dominated by survivors: they need parallel
         marking, which server GC gives and a larger gen0 does not. Four heaps: on the final code they beat eight on wall, CPU and
         peak memory (2.7 GB against 3.5 GB), and one per thread (22) peaks at 6 GB. Tiered PGO instruments code a run this short never repays: 8 CPU seconds of about 47. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="4" />
    <RuntimeHostConfigurationOption Include="System.GC.NoAffinitize" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\parakeet\Parakeet.Parsers\Ara3D.Parakeet.Parsers.csproj" />
    <ProjectReference Include="..\..\parakeet\Parakeet\Ara3D.Parakeet.csproj" />
    <PackageReference Include="Ara3D.SDK.Core" Version="$(Ara3DVersion)" />
    <ProjectReference Include="..\Plato.AST\Plato.AST.csproj" />
    <ProjectReference Include="..\..\writers\Plato.CSharpWriter\Plato.CSharpWriter.csproj" />
    <ProjectReference Include="..\..\writers\Plato.TypeScriptWriter\Plato.TypeScriptWriter.csproj" />
    <ProjectReference Include="..\..\writers\Plato.RustWriter\Plato.RustWriter.csproj" />
    <ProjectReference Include="..\..\writers\Plato.GlslWriter\Plato.GlslWriter.csproj" />
    <ProjectReference Include="..\Plato.Compiler\Plato.Compiler.csproj" />
    <ProjectReference Include="..\Plato.Optimizer\Plato.Optimizer.csproj" />
    <ProjectReference Include="..\Plato.Interpreter\Plato.Interpreter.csproj" />
    <ProjectReference Include="..\Plato.Navigation\Plato.Navigation.csproj" />
    <ProjectReference Include="..\Plato.Laws\Plato.Laws.csproj" />
    <ProjectReference Include="..\..\writers\Plato.CppWriter\Plato.CppWriter.csproj" />
  </ItemGroup>

</Project>
