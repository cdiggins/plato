<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>1f9bcaa8-63e7-4782-ae6d-aeb2d7c89912</SharedGUID>
  </PropertyGroup>
  <!-- The Number profile (src/Plato.Intrinsics/NumberProfile.cs): cpu64 by default, or
       gpu32 with `dotnet build -p:PlatoNumberProfile=gpu32`. Code generated by Plato.CLI must be
       built under the profile it was generated with; its NumberProfile.g.cs checks. -->
  <PropertyGroup>
    <PlatoNumberProfile Condition="'$(PlatoNumberProfile)' == ''">cpu64</PlatoNumberProfile>
    <DefineConstants Condition="'$(PlatoNumberProfile)' == 'gpu32'">$(DefineConstants);PLATO_NUMBER_GPU32</DefineConstants>
  </PropertyGroup>
  <Target Name="PlatoCheckNumberProfile" BeforeTargets="CoreCompile" Condition="'$(PlatoNumberProfile)' != 'cpu64' And '$(PlatoNumberProfile)' != 'gpu32'">
    <Error Text="PlatoNumberProfile is '$(PlatoNumberProfile)'; expected cpu64 or gpu32." />
  </Target>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Plato.Intrinsics</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)ArrayIntrinsics.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Boolean.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Character.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GridExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Integer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Intrinsics.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Number.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)NumberProfile.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PlatoJson.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PlatoScalarJsonConverters.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PlatoBuffer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PlatoList.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)String.cs" />
  </ItemGroup>
</Project>