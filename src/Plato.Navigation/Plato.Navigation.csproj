<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plato.Navigation — a queryable navigation index (go-to-def, find-refs, outline, search)
    over a snapshot of Plato source. Reuses the compiler's parser and binder; it does NOT
    contain a second resolver, a writer, MCP, a file watcher, or any IDE dependency. It also
    hosts warm law runs through the interpreter (WarmLawRunner).
    Plan: docs/plato-navigation-index-plan.md (studio repo). Tracker: plato-236.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>Ara3D.Geometry.Navigation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\parakeet\Parakeet.Parsers\Ara3D.Parakeet.Parsers.csproj" />
    <ProjectReference Include="..\..\parakeet\Parakeet\Ara3D.Parakeet.csproj" />
    <PackageReference Include="Ara3D.SDK.Core" Version="$(Ara3DVersion)" />
    <ProjectReference Include="..\Plato.AST\Plato.AST.csproj" />
    <ProjectReference Include="..\Plato.Compiler\Plato.Compiler.csproj" />
    <!-- WarmLawRunner: law runs over a compilation kept between calls (TKT-331). -->
    <ProjectReference Include="..\Plato.Interpreter\Plato.Interpreter.csproj" />
    <!-- The compiled backend (plato_laws backend=csharp, TKT-354). -->
    <ProjectReference Include="..\Plato.Laws\Plato.Laws.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plato.Navigation.Tests" />
  </ItemGroup>

</Project>
