  "required_types": ["TirInliner", "TirFusion", "TirLiteralUnroller", "TirComponentUnroller", "TirArrayMaterializer", "TirLoopLowerer", "TirRewrite", "ITirInlineHost", "InlineReport", "ComponentUnroller"],
  "pages": ["README.md", "inlining.md", "fusion.md", "literal-expansion.md", "component-expansion.md", "materialization.md", "loops.md", "rewrite-infrastructure.md", "evaluation.md", "references.md"]
