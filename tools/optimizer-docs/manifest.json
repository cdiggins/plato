    "writers/Plato.CSharpWriter/CSharpWriter.cs",
    "writers/Plato.CSharpWriter/CSharpConcreteTypeWriter.cs",
    "writers/Plato.CSharpWriter/TirCSharpBodyWriter*.cs",
    "src/Plato.Compiler/Checking/Tir*.cs",
