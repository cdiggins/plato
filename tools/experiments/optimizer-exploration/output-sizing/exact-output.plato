library ExactOutputProbe
{
    ExactPairs(xs: Array<Number>, value: Function1<Number, Number>): Array<Number>
        => xs.FlatMap(x => [value(x), value(x)]);

    ExactDirect(value: Function1<Number, Number>): Array<Number>
        => [1.0, 2.0, 1.0].FlatMap(x => [value(x), value(x)]);

    ExactVariable(xs: Array<Number>, keep: Function1<Number, Boolean>): Array<Number>
        => xs.FlatMap(x => keep(x) ? [x] : [x, x]);
}
