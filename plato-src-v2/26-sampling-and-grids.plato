// Sampling metadata is explicit so arrays retain spatial meaning.

type GridAxis { Origin: Number; Spacing: Number; Count: Integer; }
type GridAxisPoints { Coordinates: IArray<Number>; }
type RectilinearGrid2D { X: GridAxisPoints; Y: GridAxisPoints; }
type RectilinearGrid3D { X: GridAxisPoints; Y: GridAxisPoints; Z: GridAxisPoints; }
type UniformGrid2D implements IUniformGrid<Point2D, Vector2> { Origin: Point2D; Spacing: Vector2; Size: Integer2; }
type UniformGrid3D implements IUniformGrid<Point3D, Vector3> { Origin: Point3D; Spacing: Vector3; Size: Integer3; }
type UniformGrid4D implements IUniformGrid<Point4D, Vector4> { Origin: Point4D; Spacing: Vector4; Size: Integer4; }
type UniformGridN implements IUniformGrid<PointN, VectorN> { Origin: PointN; Spacing: VectorN; Shape: ShapeND; }

type SampledScalarField2D implements ISampledField<UniformGrid2D, Number> { Grid: UniformGrid2D; Values: IArray2D<Number>; }
type SampledScalarField3D implements ISampledField<UniformGrid3D, Number> { Grid: UniformGrid3D; Values: IArray3D<Number>; }
type SampledScalarField4D implements ISampledField<UniformGrid4D, Number> { Grid: UniformGrid4D; Values: IArray4D<Number>; }
type SampledVectorField2D implements ISampledField<UniformGrid2D, Vector2> { Grid: UniformGrid2D; Values: IArray2D<Vector2>; }
type SampledVectorField3D implements ISampledField<UniformGrid3D, Vector3> { Grid: UniformGrid3D; Values: IArray3D<Vector3>; }
type SampledTensorField3D implements ISampledField<UniformGrid3D, Tensor3> { Grid: UniformGrid3D; Values: IArray3D<Tensor3>; }

type VoxelGrid<T> implements IVoxelGrid<T> { Grid: UniformGrid3D; Values: IArray3D<T>; }
type SparseVoxel<T> { Coordinate: Integer3; Value: T; }
type SparseVoxelGrid<T> { Grid: UniformGrid3D; Values: IArray<SparseVoxel<T>>; }
type AdaptiveCell3D { Bounds: Bounds3D; Level: Integer; Parent: Integer; Children: IArray<Integer>; }
type AdaptiveGrid3D<T> implements IAdaptiveGrid<AdaptiveCell3D> { Cells: IArray<AdaptiveCell3D>; Values: IArray<T>; }

type Sample1D<T> { Parameter: Number; Value: T; }
type SampleSet<T> { Samples: IArray<Sample1D<T>>; }
type PointSample<TPoint, TValue> implements ISample<TPoint, TValue> { Point: TPoint; Value: TValue; }
