// Instants and durations are deliberately different types.

type Duration implements IQuantity { Value: Number; }
type Instant { SecondsSinceEpoch: Number; }
type Date { Year: Integer; Month: Integer; Day: Integer; }
type TimeOfDay { Hour: Integer; Minute: Integer; Second: Number; }
type DateTime { Date: Date; TimeOfDay: TimeOfDay; Offset: Duration; }
type TimeInterval { Start: Instant; End: Instant; }
type FrameRate { Frames: Integer; Per: Duration; }
type FrameTime { Frame: Integer; Subframe: Number; Rate: FrameRate; }
type Timecode { Hours: Integer; Minutes: Integer; Seconds: Integer; Frames: Integer; Rate: FrameRate; }

interface ITimeVarying<T>
{
    ValueAt(value: Self, time: Instant): T;
}
