// Physical quantities expose magnitude and dimensional meaning independently.

interface IDimensioned
{
    Dimension(value: Self): Dimension;
}

interface IQuantityOf<TUnit>
    inherits IQuantity
{
    Unit(quantity: Self): TUnit;
}

interface IUnitOf<TQuantity>
    inherits IUnit
{ }

interface IUnitConvertible<TUnit>
{
    ConvertTo(value: Self, unit: TUnit): Self;
}

interface IVectorQuantity<TVector>
{
    Value(quantity: Self): TVector;
}

interface IPhysicalProperty<TValue>
{
    Value(property: Self): TValue;
}

interface ITolerance<TValue>
{
    Accepts(tolerance: Self, expected: TValue, actual: TValue): Boolean;
}
