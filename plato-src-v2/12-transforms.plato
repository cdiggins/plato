// Named transforms preserve intent and invariants.

type Translation2D implements ITranslation<Vector2>, ITransform<Point2D> { Offset: Vector2; }
type Rotation2D implements IRotation<Vector2>, ITransform<Point2D> { Angle: Angle; }
type Scale2D implements IScaling<Vector2>, ITransform<Point2D> { Factors: Vector2; }
type Shear2D { XByY: Number; YByX: Number; }
type Reflection2D implements IReflection<InfiniteLine2D>, ITransform<Point2D> { Axis: InfiniteLine2D; }
type RigidTransform2D implements IRigidTransform<Point2D, Vector2> { Translation: Vector2; Rotation: Angle; }
type AffineTransform2D implements IAffineTransform<Point2D, Vector2> { Matrix: Matrix3x2; }

type AxisAngle3D implements IRotation<Vector3> { Axis: Vector3; Angle: Angle; }
type Translation3D implements ITranslation<Vector3>, ITransform<Point3D> { Offset: Vector3; }
type Rotation3D implements IRotation<Vector3>, ITransform<Point3D> { Orientation: Quaternion; }
type Scale3D implements IScaling<Vector3>, ITransform<Point3D> { Factors: Vector3; }
type Shear3D { Matrix: Matrix3x3; }
type Reflection3D implements IReflection<Plane3D>, ITransform<Point3D> { Plane: Plane3D; }
type RigidTransform3D implements IRigidTransform<Point3D, Vector3> { Translation: Vector3; Rotation: Quaternion; }
type SimilarityTransform3D implements ISimilarityTransform<Point3D, Vector3> { Translation: Vector3; Rotation: Quaternion; UniformScale: Number; }
type AffineTransform3D implements IAffineTransform<Point3D, Vector3> { Matrix: Matrix4x4; }
type ProjectiveTransform3D implements IProjectiveTransform<Point3D> { Matrix: Matrix4x4; }
type DualQuaternion implements IRotationRepresentation<Vector3> { Real: Quaternion; Dual: Quaternion; }

type Rotation4D { Left: Quaternion; Right: Quaternion; }
type AffineTransform4D { Linear: Matrix4x4; Translation: Vector4; }
type AffineTransformN { Linear: Matrix; Translation: VectorN; }
