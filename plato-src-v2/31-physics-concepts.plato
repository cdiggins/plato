// Mechanics concepts separate kinematics, dynamics, particles, and continua.

interface IKinematicState<TPose, TVelocity>
{
    Pose(state: Self): TPose;
    Velocity(state: Self): TVelocity;
}

interface IRigidBodyState
    inherits IHasMassProperties
{
    Pose(state: Self): RigidTransform3D;
    LinearVelocity(state: Self): LinearVelocity3D;
    AngularVelocity(state: Self): AngularVelocity3D;
}

interface IParticleState<TPoint, TVector>
{
    Position(state: Self): TPoint;
    Velocity(state: Self): TVector;
    Mass(state: Self): Mass;
}

interface IForceVector<TVector>
    inherits IVectorQuantity<TVector>
{ }

interface IMomentumVector<TVector>
    inherits IVectorQuantity<TVector>
{ }

interface IContact<TPoint, TVector>
{
    Point(contact: Self): TPoint;
    Normal(contact: Self): TVector;
}

interface IPhysicalConstraint
    inherits IHasName
{
    Bodies(constraint: Self): IndexPair;
}

interface IParticleSystem<TParticle>
    inherits ITimeStamped
{
    Particles(system: Self): IArray<TParticle>;
}

interface IContinuumState<TGrid>
{
    Grid(state: Self): TGrid;
}

interface ISecondOrderTensorProperty<TTensor>
    inherits IPhysicalProperty<TTensor>
{ }
