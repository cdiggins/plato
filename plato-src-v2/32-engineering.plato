// Tolerances, materials, sections, loads, and finite elements.

type AbsoluteTolerance implements ITolerance<Number> { Value: Number; }
type RelativeTolerance implements ITolerance<Number> { Value: Number; }
type GeometricTolerance implements ITolerance<Point3D> { Linear: Length; Angular: Angle; }
type NumericTolerance implements ITolerance<Number> { Absolute: Number; Relative: Number; }

type IsotropicMaterialProperties implements IIsotropicMaterial
{
    Density: Density;
    YoungModulus: Pressure;
    PoissonRatio: Number;
    YieldStrength: Pressure;
    ThermalExpansion: Number;
    ThermalConductivity: Number;
}

type OrthotropicMaterialProperties implements IOrthotropicMaterial
{
    YoungModuli: Vector3;
    ShearModuli: Vector3;
    PoissonRatios: Vector3;
    Density: Density;
}

type BeamSection implements ISectionProperties
{
    Area: Area;
    Centroid: Point2D;
    SecondMoment: SymmetricTensor2;
    TorsionConstant: Number;
}

type BeamElement implements IFiniteElement<IndexPair> { Nodes: IndexPair; Section: BeamSection; Material: Integer; Orientation: Vector3; }
type ShellElement implements IFiniteElement<IndexLoop> { Nodes: IndexLoop; Thickness: Length; Material: Integer; }
type SolidElement implements IFiniteElement<IndexLoop> { Nodes: IndexLoop; Material: Integer; }

type NodalLoad implements INodalLoad { Node: Integer; Force: Force3D; Moment: Torque3D; }
type DistributedLoad implements IElementLoad { Element: Integer; Start: Force3D; End: Force3D; }
type PressureLoad implements ILoad { Face: Integer; Pressure: Pressure; }
type BoundaryCondition implements IBoundaryCondition { Node: Integer; FixedTranslation: Integer3; FixedRotation: Integer3; }

type FiniteElementModel implements IFiniteElementModel
{
    Nodes: IArray<Point3D>;
    Materials: IArray<IsotropicMaterialProperties>;
    Beams: IArray<BeamElement>;
    Shells: IArray<ShellElement>;
    Solids: IArray<SolidElement>;
    Loads: IArray<NodalLoad>;
    Constraints: IArray<BoundaryCondition>;
}

type LinearSystem implements ILinearSystem<SparseMatrix, IArray<Number>> { Matrix: SparseMatrix; RightHandSide: IArray<Number>; }
type EigenSystem implements IEigenProblem<SparseMatrix> { Matrix: SparseMatrix; MassMatrix: SparseMatrix; Modes: Integer; }
