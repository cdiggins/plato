// Surface capabilities distinguish parameterization, trimming, closure, and curvature.

interface IParametricSurface<TPoint>
    inherits ISurface<Vector2, TPoint>
{
    Domain(surface: Self): Domain2D;
}

interface IClosedSurface<TPoint>
    inherits IParametricSurface<TPoint>, IClosed, IOrientable
{ }

interface IOpenSurface<TPoint>
    inherits IParametricSurface<TPoint>, IOpen
{ }

interface IPeriodicSurface<TPoint>
    inherits IParametricSurface<TPoint>
{
    UPeriodic(surface: Self): Boolean;
    VPeriodic(surface: Self): Boolean;
}

interface ITrimmedSurface<TPoint>
    inherits IParametricSurface<TPoint>
{
    OuterBoundary(surface: Self): TrimLoop2D;
    InnerBoundaries(surface: Self): IArray<TrimLoop2D>;
}

interface IControlPointSurface<TPoint>
    inherits IParametricSurface<TPoint>
{
    ControlPoints(surface: Self): IArray2D<TPoint>;
}

interface IWeightedControlPointSurface<TControlPoint, TPoint>
    inherits IParametricSurface<TPoint>
{
    ControlPoints(surface: Self): IArray2D<TControlPoint>;
}

interface IDifferentiableSurface<TPoint, TVector>
    inherits IParametricSurface<TPoint>
{
    TangentU(surface: Self, parameter: Vector2): TVector;
    TangentV(surface: Self, parameter: Vector2): TVector;
}

interface ICurvatureSurface<TPoint, TCurvature>
    inherits IParametricSurface<TPoint>
{
    CurvatureAt(surface: Self, parameter: Vector2): TCurvature;
}

interface IHeightField<TPoint>
{
    HeightAt(field: Self, parameter: Point2D): Number;
    PointAt(field: Self, parameter: Point2D): TPoint;
}

interface ISubdivisionSurface<TMesh>
{
    ControlMesh(surface: Self): TMesh;
    Scheme(surface: Self): SubdivisionScheme;
}
