// Curve capabilities describe topology, parameterization, and differential queries.

interface IOpenCurve<TPoint>
    inherits ICurve<TPoint>, IOpen
{ }

interface IClosedCurve<TPoint>
    inherits ICurve<TPoint>, IClosed, IPeriodic<Number>
{ }

interface IDifferentiableCurve<TPoint, TVector>
    inherits ICurve<TPoint>
{
    TangentAt(curve: Self, parameter: Number): TVector;
}

interface ICurvatureCurve<TPoint, TCurvature>
    inherits ICurve<TPoint>
{
    CurvatureAt(curve: Self, parameter: Number): TCurvature;
}

interface IArcLengthParameterized<TPoint>
    inherits ICurve<TPoint>, IMeasurable<Number>
{
    EvaluateByLength(curve: Self, length: Number): TPoint;
}

interface IControlPointCurve<TPoint>
    inherits ICurve<TPoint>
{
    ControlPoints(curve: Self): IArray<TPoint>;
}

interface IWeightedControlPointCurve<TControlPoint, TPoint>
    inherits ICurve<TPoint>
{
    ControlPoints(curve: Self): IArray<TControlPoint>;
}

interface IKnotVectorCurve
{
    Degree(curve: Self): Integer;
    Knots(curve: Self): IArray<Number>;
}

interface IPiecewiseCurve<TPoint>
    inherits ICurve<TPoint>
{
    SegmentCount(curve: Self): Integer;
}

interface ISampledCurve<TPoint, TSample>
    inherits ICurve<TPoint>
{
    Samples(curve: Self): IArray<TSample>;
}

interface IArcLengthTable
{
    Samples(table: Self): IArray<ArcLengthSample>;
    TotalLength(table: Self): Number;
}
