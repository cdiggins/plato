// Optimization concepts make objectives, constraints, iterations, and results reusable.

interface IOptimizationVariable
    inherits IHasName
{
    InitialValue(variable: Self): Number;
    Bounds(variable: Self): VariableBounds;
}

interface IObjective<TVariables>
{
    Evaluate(objective: Self, variables: TVariables): Number;
}

interface IOptimizationConstraint<TVariables>
{
    Evaluate(constraint: Self, variables: TVariables): Number;
}

interface IOptimizationProblem<TVariables>
{
    InitialVariables(problem: Self): TVariables;
    Objective(problem: Self): Function1<TVariables, Number>;
}

interface IIterationState<TVariables>
{
    Index(iteration: Self): Integer;
    Variables(iteration: Self): TVariables;
    Objective(iteration: Self): Number;
}

interface IConvergenceResult<TValue>
{
    Value(result: Self): TValue;
    Converged(result: Self): Boolean;
    Iterations(result: Self): Integer;
}

interface IOptimizationResult<TVariables>
{
    Variables(result: Self): TVariables;
    Objective(result: Self): Number;
    Converged(result: Self): Boolean;
}

interface ILinearConstraint
{
    Coefficients(constraint: Self): VectorN;
    RightHandSide(constraint: Self): Number;
}
