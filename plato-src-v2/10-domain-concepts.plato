// Domains, intervals, containment, and parameter-space capabilities.

interface IInterval<T>
{
    Minimum(interval: Self): T;
    Maximum(interval: Self): T;
}

interface ISpan<T>
{
    Start(span: Self): T;
    End(span: Self): T;
}

interface IContains<T>
{
    Contains(container: Self, value: T): Boolean;
}

interface IClamps<T>
{
    Clamp(container: Self, value: T): T;
}

interface IParameterDomain<TParameter>
    inherits IContains<TParameter>
{ }

interface IDiscreteDomain<T>
    inherits IParameterDomain<T>, ICounted
{ }

interface ICartesianDomain<TAxis>
{
    Axes(domain: Self): IArray<TAxis>;
}

interface IBoundaryAware
{
    IncludesMinimum(value: Self): Boolean;
    IncludesMaximum(value: Self): Boolean;
}
