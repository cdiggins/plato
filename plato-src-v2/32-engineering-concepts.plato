// Engineering concepts cover tolerances, materials, elements, loads, and models.

interface IMaterialProperties { }

interface IIsotropicMaterial
    inherits IMaterialProperties
{
    Density(material: Self): Density;
}

interface IOrthotropicMaterial
    inherits IMaterialProperties
{
    Density(material: Self): Density;
}

interface ISectionProperties
{
    Area(section: Self): Area;
    Centroid(section: Self): Point2D;
}

interface IFiniteElement<TNodes>
{
    Nodes(element: Self): TNodes;
    Material(element: Self): Integer;
}

interface ILoad { }

interface INodalLoad
    inherits ILoad
{
    Node(load: Self): Integer;
}

interface IElementLoad
    inherits ILoad
{
    Element(load: Self): Integer;
}

interface IBoundaryCondition
{
    Node(condition: Self): Integer;
}

interface IFiniteElementModel
{
    Nodes(model: Self): IArray<Point3D>;
}

interface IEigenProblem<TMatrix>
{
    Matrix(problem: Self): TMatrix;
    MassMatrix(problem: Self): TMatrix;
}
