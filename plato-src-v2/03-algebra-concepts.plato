// Algebraic structure concepts avoid assuming every numeric type is a field.

interface IZero
{
    Zero(_: Self): Self;
}

interface IOne
{
    One(_: Self): Self;
}

interface IModulo
{
    Modulo(a: Self, b: Self): Self;
}

interface IAdditiveMonoid inherits IAdditive, IZero { }
interface IMultiplicativeMonoid inherits IMultiplicative, IOne { }
interface IRing inherits IAdditiveMonoid, IMultiplicativeMonoid { }
interface IAlgebraicField inherits IRing, IDivisible { }

interface IConjugatable
{
    Conjugate(value: Self): Self;
}

interface IDotProduct<TScalar>
{
    Dot(a: Self, b: Self): TScalar;
}

interface ICrossProduct
{
    Cross(a: Self, b: Self): Self;
}

interface IDifferentiable<TDerivative>
{
    Derivative(value: Self): TDerivative;
}

interface IComposable
{
    Compose(after: Self, before: Self): Self;
}

interface IInvertible
{
    Inverse(value: Self): Self;
}

interface IVectorSpace<TScalar>
    inherits IAdditive, IScalable<TScalar>
{ }

interface ILinearOperator<TVector>
{
    Apply(operator: Self, vector: TVector): TVector;
}

interface INormalizable
{
    Normalize(value: Self): Self;
}

interface IApproximateEquality<TTolerance>
{
    ApproximatelyEquals(a: Self, b: Self, tolerance: TTolerance): Boolean;
}
