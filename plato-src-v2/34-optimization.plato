// Optimization data distinguishes variables, objectives, constraints, and results.

type VariableBounds { Minimum: Number; Maximum: Number; }
type OptimizationVariable implements IOptimizationVariable { Name: String; InitialValue: Number; Bounds: VariableBounds; Scale: Number; }
type ObjectiveValue { Value: Number; Gradient: VectorN; }
type ConstraintValue { Value: Number; Gradient: VectorN; }
type OptimizationProblem implements IOptimizationProblem<VectorN>
{
    Variables: IArray<OptimizationVariable>;
    Objective: Function1<VectorN, Number>;
    Constraints: IArray<Function1<VectorN, Number>>;
}

type OptimizationIteration implements IIterationState<VectorN>
{
    Index: Integer;
    Variables: VectorN;
    Objective: Number;
    GradientNorm: Number;
    StepNorm: Number;
}

type OptimizationResult implements IOptimizationResult<VectorN>
{
    Variables: VectorN;
    Objective: Number;
    Iterations: IArray<OptimizationIteration>;
    Converged: Boolean;
    Reason: String;
}

type LinearConstraint implements ILinearConstraint, IOptimizationConstraint<VectorN> { Coefficients: VectorN; Relation: String; RightHandSide: Number; }
type LinearProgram { Objective: VectorN; Constraints: IArray<LinearConstraint>; Bounds: IArray<VariableBounds>; }
type QuadraticProgram { Quadratic: Matrix; Linear: VectorN; Constraints: IArray<LinearConstraint>; Bounds: IArray<VariableBounds>; }
type RootBracket { Minimum: Number; Maximum: Number; MinimumValue: Number; MaximumValue: Number; }
type RootResult implements IConvergenceResult<Number> { Value: Number; FunctionValue: Number; Iterations: Integer; Converged: Boolean; }
