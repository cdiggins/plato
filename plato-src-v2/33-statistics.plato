// Descriptive, multivariate, and distribution types.

type SampleStatistics implements IStatisticalSummary<Number>
{
    Count: Integer;
    Minimum: Number;
    Maximum: Number;
    Mean: Number;
    Variance: Number;
}

type WeightedSample implements IWeighted<Number> { Value: Number; Weight: Number; }
type HistogramBin { Minimum: Number; Maximum: Number; Count: Integer; }
type Histogram implements IHistogram { Bins: IArray<HistogramBin>; Underflow: Integer; Overflow: Integer; }
type Quantile { Probability: Number; Value: Number; }

type CovarianceMatrix implements IMultivariateModel { Means: VectorN; Covariance: Matrix; }
type PrincipalComponent { Direction: VectorN; Variance: Number; }
type PrincipalComponentAnalysis implements IMultivariateModel { Mean: VectorN; Components: IArray<PrincipalComponent>; }

type Probability implements IProbability { Value: Number; }
type UniformDistribution implements IDistribution<Number> { Minimum: Number; Maximum: Number; }
type NormalDistribution implements IDistribution<Number> { Mean: Number; StandardDeviation: Number; }
type LogNormalDistribution implements IDistribution<Number> { LogMean: Number; LogStandardDeviation: Number; }
type ExponentialDistribution implements IDistribution<Number> { Rate: Number; }
type PoissonDistribution implements IDistribution<Integer> { Rate: Number; }
type DiscreteOutcome<T> implements IWeighted<Probability> { Value: T; Probability: Probability; }
type DiscreteDistribution<T> implements IDiscreteDistribution<T> { Outcomes: IArray<DiscreteOutcome<T>>; }

type RegressionObservation implements IStatisticalObservation<VectorN, Number> { Inputs: VectorN; Output: Number; Weight: Number; }
type LinearRegressionModel implements IRegressionModel<VectorN, Number> { Intercept: Number; Coefficients: VectorN; }
