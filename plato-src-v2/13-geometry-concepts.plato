// Geometry is classified by embedding dimension, topology, and representation.

interface IGeometry { }
interface IGeometry2D inherits IGeometry { }
interface IGeometry3D inherits IGeometry { }
interface IGeometry4D inherits IGeometry { }
interface IGeometryND inherits IGeometry { }

interface IEmbedded<TPoint> { }

interface ITopologicalDimension
{
    TopologicalDimension(value: Self): Integer;
}

interface IBounded<TBounds>
{
    Bounds(value: Self): TBounds;
}

interface IOriented { }
interface IOrientable { }
interface IClosed { }
interface IOpen { }
interface IConvex { }
interface IManifold { }
interface IConnected { }

interface IMeasurable<TMeasure>
{
    Measure(value: Self): TMeasure;
}

interface ICentroid<TPoint>
{
    Centroid(value: Self): TPoint;
}

interface INormalAt<TPoint, TVector>
{
    NormalAt(value: Self, point: TPoint): TVector;
}

interface IParametric<TParameter, TPoint>
{
    Evaluate(value: Self, parameter: TParameter): TPoint;
}

interface IImplicit<TPoint>
{
    Contains(value: Self, point: TPoint): Boolean;
}

interface IDistanceField<TPoint, TDistance>
{
    Distance(value: Self, point: TPoint): TDistance;
}

interface ICurve<TPoint>
    inherits IParametric<Number, TPoint>, ITopologicalDimension
{ }

interface ICurve2D inherits IGeometry2D, ICurve<Point2D> { }
interface ICurve3D inherits IGeometry3D, ICurve<Point3D> { }
interface ICurve4D inherits IGeometry4D, ICurve<Point4D> { }
interface ICurveND inherits IGeometryND, ICurve<PointN> { }

interface ISurface2D inherits IGeometry2D { }
interface ISurface<TParameter, TPoint>
    inherits IParametric<TParameter, TPoint>, ITopologicalDimension
{ }

interface ISurface3D inherits IGeometry3D, ISurface<Vector2, Point3D> { }

interface IVolume<TPoint>
    inherits IImplicit<TPoint>, ITopologicalDimension
{ }

interface IVolume3D inherits IGeometry3D, IVolume<Point3D> { }
interface IHyperSurface4D inherits IGeometry4D, IParametric<Vector3, Point4D> { }

interface IDiscreteGeometry<TPoint>
{
    Points(value: Self): IArray<TPoint>;
}

interface IIndexedGeometry<TPoint, TIndex>
    inherits IDiscreteGeometry<TPoint>
{
    Indices(value: Self): IArray<TIndex>;
}

interface IPolyline<TPoint>
    inherits IDiscreteGeometry<TPoint>, ICurve<TPoint>
{ }

interface IPolygon<TPoint>
    inherits IPolyline<TPoint>, IClosed
{ }

interface IPrimitiveGeometry<TPoint>
    inherits IDiscreteGeometry<TPoint>
{ }
