// Read-only collection and dimensional-array concepts.

interface IArray<T>
    inherits ICounted, IIndexable<T>
{
    Count(values: Self): Integer;
    At(values: Self, index: Integer): T;
}

interface IArray2D<T> inherits IArray<T>
{
    Width(values: Self): Integer;
    Height(values: Self): Integer;
    At(values: Self, column: Integer, row: Integer): T;
}

interface IArray3D<T> inherits IArray<T>
{
    Width(values: Self): Integer;
    Height(values: Self): Integer;
    Depth(values: Self): Integer;
    At(values: Self, column: Integer, row: Integer, layer: Integer): T;
}

interface IArray4D<T> inherits IArray<T>
{
    Size0(values: Self): Integer;
    Size1(values: Self): Integer;
    Size2(values: Self): Integer;
    Size3(values: Self): Integer;
    At(values: Self, i0: Integer, i1: Integer, i2: Integer, i3: Integer): T;
}

interface IIndexable<T>
{
    At(values: Self, index: Integer): T;
}

interface ICounted
{
    Count(value: Self): Integer;
}

interface IComponents<T>
    inherits ICounted, IIndexable<T>
{
    Components(value: Self): IArray<T>;
}

interface ISliceable<T>
{
    Slice(values: Self, range: IndexRange): ArraySlice<T>;
}

interface IKeyValue<TKey, TValue>
{
    Key(value: Self): TKey;
    Value(value: Self): TValue;
}

interface IShaped
{
    Shape(value: Self): ShapeND;
}

interface IStrided
{
    Strides(value: Self): StridesND;
}

type IndexRange { Start: Integer; Count: Integer; }
type ArraySlice<T> { Values: IArray<T>; Range: IndexRange; }
type StridedSlice<T> { Values: IArray<T>; Start: Integer; Count: Integer; Stride: Integer; }
type ShapeND { Dimensions: IArray<Integer>; }
type StridesND { Values: IArray<Integer>; }
type ArrayND<T> implements IShaped, IStrided { Values: IArray<T>; Shape: ShapeND; Strides: StridesND; }
