// Differential geometry concepts expose jets, curvature, metrics, charts, and atlases.

interface IJet<TParameter, TPoint>
{
    Parameter(jet: Self): TParameter;
    Point(jet: Self): TPoint;
}

interface ICurveJet<TPoint, TVector>
    inherits IJet<Number, TPoint>
{
    FirstDerivative(jet: Self): TVector;
    SecondDerivative(jet: Self): TVector;
}

interface ISurfaceJet<TPoint, TVector>
    inherits IJet<Vector2, TPoint>
{
    DerivativeU(jet: Self): TVector;
    DerivativeV(jet: Self): TVector;
}

interface ICurveCurvature<TVector>
{
    Curvature(value: Self): Number;
    Normal(value: Self): TVector;
}

interface ISurfaceCurvature<TVector>
{
    Gaussian(value: Self): Number;
    Mean(value: Self): Number;
    MinimumDirection(value: Self): TVector;
    MaximumDirection(value: Self): TVector;
}

interface IMetricTensor<TTensor>
{
    Value(metric: Self): TTensor;
}

interface IManifoldChart<TParameter, TPoint>
{
    Domain(chart: Self): DomainND;
    Map(chart: Self): Function1<TParameter, TPoint>;
}

interface IAtlas<TChart>
{
    Charts(atlas: Self): IArray<TChart>;
}
