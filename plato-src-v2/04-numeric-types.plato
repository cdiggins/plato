// Numeric representations used by scientific and engineering algorithms.

type Rational implements IRationalScalar { Numerator: Integer; Denominator: Integer; }
type Complex implements IComplexScalar { Real: Number; Imaginary: Number; }
type DualNumber implements IDualScalar<Number, Number> { Value: Number; Derivative: Number; }
type Bicomplex implements IComponents<Complex> { Real: Complex; Imaginary: Complex; }
type Quaternion implements IRotationRepresentation<Vector3>, IComponents<Number>
{
    X: Number;
    Y: Number;
    Z: Number;
    W: Number;
}

type FixedPoint implements IFinitePrecision { RawValue: Integer; FractionalBits: Integer; }
type BigUnsigned implements IArbitraryPrecision, IComponents<Integer> { Limbs: IArray<Integer>; }
type BigInteger implements IArbitraryPrecision { Magnitude: BigUnsigned; IsNegative: Boolean; }
type DecimalNumber implements IArbitraryPrecision { Significand: BigInteger; Exponent: Integer; }

type Polynomial implements IPolynomial<Number> { Coefficients: IArray<Number>; }
type ComplexPolynomial implements IPolynomial<Complex> { Coefficients: IArray<Complex>; }
type PiecewisePolynomial implements IPiecewiseFunction<Number, Number> { Breaks: IArray<Number>; Pieces: IArray<Polynomial>; }
