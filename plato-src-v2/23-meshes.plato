// Meshes use explicit index types and optional attribute channels.

type LineMesh2D implements IMesh<Point2D, IndexPair, Bounds2D>
{
    Points: IArray<Point2D>;
    Indices: IArray<IndexPair>;
}

type LineMesh3D implements IMesh<Point3D, IndexPair, Bounds3D>
{
    Points: IArray<Point3D>;
    Indices: IArray<IndexPair>;
}

type TriangleMesh2D implements ISurfaceMesh<Point2D, IndexTriple, Bounds2D>
{
    Points: IArray<Point2D>;
    Indices: IArray<IndexTriple>;
}

type TriangleMesh3D implements ISurfaceMesh<Point3D, IndexTriple, Bounds3D>
{
    Points: IArray<Point3D>;
    Indices: IArray<IndexTriple>;
}

type QuadMesh3D implements ISurfaceMesh<Point3D, IndexQuad, Bounds3D>
{
    Points: IArray<Point3D>;
    Indices: IArray<IndexQuad>;
}

type PolygonMesh3D implements ISurfaceMesh<Point3D, IndexLoop, Bounds3D>
{
    Points: IArray<Point3D>;
    Indices: IArray<IndexLoop>;
}

type TetrahedralMesh3D implements IVolumeMesh<Point3D, IndexQuad, Bounds3D>
{
    Points: IArray<Point3D>;
    Indices: IArray<IndexQuad>;
}

type MeshAttribute<T> implements IAttributeChannel<T>
{
    Name: String;
    Association: AttributeAssociation;
    Values: IArray<T>;
}

type AttributeAssociation { Name: String; }
type MeshAttributes
{
    Scalars: IArray<MeshAttribute<Number>>;
    Vectors2: IArray<MeshAttribute<Vector2>>;
    Vectors3: IArray<MeshAttribute<Vector3>>;
    Colors: IArray<MeshAttribute<LinearRgba>>;
}

type AttributedTriangleMesh3D implements IAttributedGeometry<TriangleMesh3D, MeshAttributes> { Mesh: TriangleMesh3D; Attributes: MeshAttributes; }
