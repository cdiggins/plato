// Local differential properties for curves, surfaces, and manifolds.

type CurveJet2D implements ICurveJet<Point2D, Vector2>
{
    Parameter: Number;
    Point: Point2D;
    FirstDerivative: Vector2;
    SecondDerivative: Vector2;
}

type CurveJet3D implements ICurveJet<Point3D, Vector3>
{
    Parameter: Number;
    Point: Point3D;
    FirstDerivative: Vector3;
    SecondDerivative: Vector3;
    ThirdDerivative: Vector3;
}

type SurfaceJet3D implements ISurfaceJet<Point3D, Vector3>
{
    Parameter: Vector2;
    Point: Point3D;
    DerivativeU: Vector3;
    DerivativeV: Vector3;
    DerivativeUU: Vector3;
    DerivativeUV: Vector3;
    DerivativeVV: Vector3;
}

type CurveCurvature2D implements ICurveCurvature<Vector2> { Curvature: Number; Normal: Vector2; }
type CurveCurvature3D implements ICurveCurvature<Vector3> { Curvature: Number; Torsion: Number; Frame: Frame3D; }
type SurfaceCurvature3D implements ISurfaceCurvature<Vector3>
{
    Gaussian: Number;
    Mean: Number;
    Minimum: Number;
    Maximum: Number;
    MinimumDirection: Vector3;
    MaximumDirection: Vector3;
}

type MetricTensor2D implements IMetricTensor<SymmetricTensor2> { Value: SymmetricTensor2; }
type FundamentalForms3D { First: SymmetricTensor2; Second: SymmetricTensor2; }
type ManifoldChart<TPoint> implements IManifoldChart<PointN, TPoint> { Domain: DomainND; Map: Function1<PointN, TPoint>; }
type Atlas<TPoint> implements IAtlas<ManifoldChart<TPoint>> { Charts: IArray<ManifoldChart<TPoint>>; }
