// Axis-aligned, oriented, spherical, and higher-dimensional bounds.

type Bounds1D implements IInterval<Point1D>, IContains<Point1D>, IBounded<Bounds1D> { Minimum: Point1D; Maximum: Point1D; }
type Bounds2D implements IGeometry2D, IInterval<Point2D>, IContains<Point2D>, IBounded<Bounds2D> { Minimum: Point2D; Maximum: Point2D; }
type Bounds3D implements IGeometry3D, IInterval<Point3D>, IContains<Point3D>, IBounded<Bounds3D> { Minimum: Point3D; Maximum: Point3D; }
type Bounds4D implements IGeometry4D, IInterval<Point4D>, IContains<Point4D>, IBounded<Bounds4D> { Minimum: Point4D; Maximum: Point4D; }
type BoundsN implements IGeometryND, IInterval<PointN>, IContains<PointN>, IBounded<BoundsN> { Minimum: PointN; Maximum: PointN; }

type OrientedBounds2D { Frame: Frame2D; HalfExtents: Vector2; }
type OrientedBounds3D { Frame: Frame3D; HalfExtents: Vector3; }
type OrientedBounds4D { Frame: Frame4D; HalfExtents: Vector4; }
type BoundingCircle2D { Center: Point2D; Radius: Number; }
type BoundingSphere3D { Center: Point3D; Radius: Number; }
type BoundingSphere4D { Center: Point4D; Radius: Number; }
type BoundingSphereN { Center: PointN; Radius: Number; }

type BoundingCapsule2D { Axis: Segment2D; Radius: Number; }
type BoundingCapsule3D { Axis: Segment3D; Radius: Number; }
type BoundingEllipsoid3D { Frame: Frame3D; Radii: Vector3; }
