// Signals, spectra, filters, and dynamic systems.

interface ISignal<TTime, TValue>
{
    ValueAt(signal: Self, time: TTime): TValue;
}

interface ISampledSignal<T>
    inherits ITimeSeries<T>
{
    Rate(signal: Self): SamplingRate;
}

interface ISpectrum<T>
{
    Frequencies(spectrum: Self): IArray<Frequency>;
    Values(spectrum: Self): IArray<T>;
}

interface IFilter<TSignal>
{
    Apply(filter: Self, signal: TSignal): TSignal;
}

interface ITransferFunction
{
    Evaluate(model: Self, frequency: Frequency): Complex;
}

interface IDynamicSystem<TState, TInput, TOutput>
{
    NextState(system: Self, state: TState, input: TInput): TState;
    Output(system: Self, state: TState, input: TInput): TOutput;
}

interface IWindowFunction
    inherits IHasName
{
    Weight(window: Self, parameter: Number): Number;
}
