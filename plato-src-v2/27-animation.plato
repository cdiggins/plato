// Animation separates interpolation policy, keys, tracks, clips, and rigs.

type InterpolationMode implements IHasName { Name: String; }
type ExtrapolationMode implements IHasName { Name: String; }

type Keyframe<T> implements IKeyframe<T>
{
    Time: Duration;
    Value: T;
    Interpolation: InterpolationMode;
}

type TangentKeyframe<T> implements ITangentKeyframe<T>
{
    Time: Duration;
    Value: T;
    IncomingTangent: T;
    OutgoingTangent: T;
    Interpolation: InterpolationMode;
}

type AnimationTrack<T> implements IAnimationTrack<T>
{
    Keys: IArray<Keyframe<T>>;
    Before: ExtrapolationMode;
    After: ExtrapolationMode;
}

type TangentAnimationTrack<T> implements ITangentAnimationTrack<T>
{
    Keys: IArray<TangentKeyframe<T>>;
    Before: ExtrapolationMode;
    After: ExtrapolationMode;
}

type TransformTrack2D implements ITransformAnimation<Vector2, Angle>
{
    Translation: AnimationTrack<Vector2>;
    Rotation: AnimationTrack<Angle>;
    Scale: AnimationTrack<Vector2>;
}

type TransformTrack3D implements ITransformAnimation<Vector3, Quaternion>
{
    Translation: AnimationTrack<Vector3>;
    Rotation: AnimationTrack<Quaternion>;
    Scale: AnimationTrack<Vector3>;
}

type AnimationEvent implements IAnimationEvent { Time: Duration; Name: String; Payload: String; }
type AnimationClip implements IAnimationClip { Name: String; Duration: Duration; TransformTracks: IArray<TransformTrack3D>; Events: IArray<AnimationEvent>; }
type LayerWeight { Layer: Integer; Weight: Number; }
type AnimationLayer implements IAnimationLayer, IWeighted<Number> { Clip: AnimationClip; Weight: Number; Additive: Boolean; }
type AnimationStack implements IAnimationStack { Layers: IArray<AnimationLayer>; }

type Joint implements IHasName { Name: String; Parent: Integer; BindPose: RigidTransform3D; }
type Skeleton implements ISkeleton { Joints: IArray<Joint>; }
type JointPose implements IPose<RigidTransform3D> { Joint: Integer; Transform: RigidTransform3D; }
type SkeletonPose implements ISkeletonPose { Poses: IArray<JointPose>; }
type SkinWeight { Joint: Integer; Weight: Number; }
type VertexSkinWeights { Weights: IArray<SkinWeight>; }
type Skin implements ISkin { Skeleton: Skeleton; InverseBindPoses: IArray<AffineTransform3D>; VertexWeights: IArray<VertexSkinWeights>; }

type MorphTarget implements IMorphTarget { Name: String; PositionOffsets: IArray<Vector3>; NormalOffsets: IArray<Vector3>; }
type MorphWeights { Values: IArray<Number>; }
