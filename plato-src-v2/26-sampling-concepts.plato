// Grids and samples expose layout independently of stored values.

interface IGrid<TPoint>
{
    PointAt(grid: Self, index: PointN): TPoint;
    Shape(grid: Self): ShapeND;
}

interface IUniformGrid<TPoint, TVector>
    inherits IGrid<TPoint>
{
    Origin(grid: Self): TPoint;
    Spacing(grid: Self): TVector;
}

interface IRectilinearGrid<TAxis>
{
    Axes(grid: Self): IArray<TAxis>;
}

interface IAdaptiveGrid<TCell>
{
    Cells(grid: Self): IArray<TCell>;
}

interface ISample<TDomain, TValue>
    inherits IKeyValue<TDomain, TValue>
{ }

interface ISampleSet<TDomain, TValue>
{
    Samples(set: Self): IArray<PointSample<TDomain, TValue>>;
}

interface IVoxelGrid<T>
    inherits ISampledField<UniformGrid3D, T>
{ }

interface ISparseGrid<TCoordinate, TValue>
{
    Coordinates(grid: Self): IArray<TCoordinate>;
    Values(grid: Self): IArray<TValue>;
}
