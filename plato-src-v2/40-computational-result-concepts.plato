// Query results expose success, geometry, parameters, diagnostics, and fitted values.

interface IQueryResult
{
    Status(result: Self): QueryStatus;
}

interface IParameterizedResult<TParameter>
{
    Parameter(result: Self): TParameter;
}

interface IPointResult<TPoint>
{
    Point(result: Self): TPoint;
}

interface IDistanceResult<TDistance>
{
    Distance(result: Self): TDistance;
}

interface IRayHit<TPoint, TVector>
    inherits IPointResult<TPoint>, IParameterizedResult<Number>
{
    Normal(result: Self): TVector;
}

interface IIntersectionResult<TPoint>
    inherits IQueryResult, IPointResult<TPoint>
{ }

interface IFitResult<TModel>
{
    Model(result: Self): TModel;
    Quality(result: Self): FitQuality;
}

interface ITessellation<TPoint, TCell>
{
    Points(value: Self): IArray<TPoint>;
    Cells(value: Self): IArray<TCell>;
}

interface IConvexHull<TGeometry>
{
    Hull(value: Self): TGeometry;
    SourceIndices(value: Self): IArray<Integer>;
}
