// Encodings and color spaces are distinct types.

type LinearRgb implements IColor3<Number> { R: Number; G: Number; B: Number; }
type LinearRgba implements IColor4<Number> { R: Number; G: Number; B: Number; A: Number; }
type Srgb implements IColor3<Number> { R: Number; G: Number; B: Number; }
type Srgba implements IColor4<Number> { R: Number; G: Number; B: Number; A: Number; }
type ByteRgb implements IColor3<Integer> { R: Integer; G: Integer; B: Integer; }
type ByteRgba implements IColor4<Integer> { R: Integer; G: Integer; B: Integer; A: Integer; }

type Hsl implements IColor3<Number>, IColorWithHue { Hue: Angle; Saturation: Number; Lightness: Number; }
type Hsv implements IColor3<Number>, IColorWithHue { Hue: Angle; Saturation: Number; Value: Number; }
type XyzColor implements IColor3<Number> { X: Number; Y: Number; Z: Number; }
type LabColor implements IColor3<Number> { L: Number; A: Number; B: Number; }
type LchColor implements IColor3<Number>, IColorWithHue { L: Number; Chroma: Number; Hue: Angle; }
type OklabColor implements IColor3<Number> { L: Number; A: Number; B: Number; }
type OklchColor implements IColor3<Number>, IColorWithHue { L: Number; Chroma: Number; Hue: Angle; }
type SpectralColor implements IColor, ISpectralDistribution { Wavelengths: IArray<Length>; Values: IArray<Number>; }

type Chromaticity { X: Number; Y: Number; }
type WhitePoint { Chromaticity: Chromaticity; Luminance: Number; }
type ColorPrimaries { Red: Chromaticity; Green: Chromaticity; Blue: Chromaticity; White: WhitePoint; }
type TransferFunction { Name: String; Parameters: IArray<Number>; }
type ColorSpace implements IColorSpace { Name: String; Primaries: ColorPrimaries; Transfer: TransferFunction; }

type ColorStop { Position: Number; Color: LinearRgba; }
type ColorGradient implements IColorRamp { Stops: IArray<ColorStop>; Interpolation: String; }
type ColorPalette implements IPalette<LinearRgba> { Colors: IArray<LinearRgba>; }
