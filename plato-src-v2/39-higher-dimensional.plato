// Explicit 4D geometry plus dimension-generic structures.

type Triangle4D implements IGeometry4D, IPrimitiveGeometry<Point4D>, IBounded<Bounds4D> { A: Point4D; B: Point4D; C: Point4D; }
type Tetrahedron4D implements IGeometry4D, IPrimitiveGeometry<Point4D>, IBounded<Bounds4D> { A: Point4D; B: Point4D; C: Point4D; D: Point4D; }
type Pentachoron4D implements IGeometry4D, IPrimitiveGeometry<Point4D>, IBounded<Bounds4D> { A: Point4D; B: Point4D; C: Point4D; D: Point4D; E: Point4D; }
type Polytope4D implements IGeometry4D, IDiscreteGeometry<Point4D>, ICellTopology, IBounded<Bounds4D> { Vertices: IArray<Point4D>; Cells: IArray<IndexLoop>; }
type PolytopeN implements IGeometryND, IDiscreteGeometry<PointN>, IFaceTopology, IBounded<BoundsN> { Dimension: Integer; Vertices: IArray<PointN>; Facets: IArray<IndexLoop>; }

type SimplexN implements IGeometryND, IDiscreteGeometry<PointN>, IConvex, IBounded<BoundsN> { Vertices: IArray<PointN>; }
type SphereN implements IGeometryND, IImplicit<PointN>, IDistanceField<PointN, Number>, IBounded<BoundsN> { Center: PointN; Radius: Number; }
type EllipsoidN implements IGeometryND, IImplicit<PointN>, IBounded<BoundsN> { Center: PointN; QuadraticForm: Matrix; }
type ConvexPolytopeN implements IGeometryND, IImplicit<PointN>, IConvex, IBounded<BoundsN> { Dimension: Integer; HalfSpaces: IArray<HalfSpaceN>; }

type OrthonormalBasisN implements IBasis<VectorN> { Vectors: IArray<VectorN>; }
type SubspaceN { Origin: PointN; Basis: OrthonormalBasisN; }
type ProjectionN implements ILinearOperator<VectorN> { SourceDimension: Integer; TargetDimension: Integer; Matrix: Matrix; }
type CoordinateFrameN implements ICoordinateFrame<PointN, Matrix> { Origin: PointN; Basis: Matrix; }

type HyperGridCell4D { Coordinate: Integer4; Bounds: Bounds4D; }
type SimplicialComplexN implements ISimplicialComplex<IndexLoop> { Dimension: Integer; VertexCount: Integer; Simplices: IArray<IndexLoop>; }
