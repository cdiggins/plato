// Temporal position, extent, sampling, and event capabilities.

interface ITemporalPosition { }
interface ITemporalExtent { }

interface ITimeStamped
{
    Time(value: Self): Instant;
}

interface IHasDuration
{
    Duration(value: Self): Duration;
}

interface ITemporalInterval
{
    Start(value: Self): Instant;
    End(value: Self): Instant;
}

interface IPeriodic<TPeriod>
{
    Period(value: Self): TPeriod;
}

interface IFrameAddressable
{
    Frame(value: Self): Integer;
    Rate(value: Self): FrameRate;
}

interface ITimeSeries<T>
{
    Start(series: Self): Instant;
    Values(series: Self): IArray<T>;
}
