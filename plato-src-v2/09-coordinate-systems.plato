// Coordinate systems state conventions rather than hiding them in comments.

type Axis2D { Origin: Point2D; Direction: Vector2; }
type Axis3D { Origin: Point3D; Direction: Vector3; }
type Basis2D { X: Vector2; Y: Vector2; }
type Basis3D { X: Vector3; Y: Vector3; Z: Vector3; }
type Frame2D { Origin: Point2D; Basis: Basis2D; }
type Frame3D { Origin: Point3D; Basis: Basis3D; }
type Frame4D { Origin: Point4D; Basis0: Vector4; Basis1: Vector4; Basis2: Vector4; Basis3: Vector4; }

type PolarCoordinate { Radius: Number; Azimuth: Angle; }
type CylindricalCoordinate { Radius: Number; Azimuth: Angle; Height: Number; }
type SphericalCoordinate { Radius: Number; Azimuth: Angle; Inclination: Angle; }
type GeographicCoordinate { Latitude: Angle; Longitude: Angle; }
type GeographicPosition { Coordinate: GeographicCoordinate; Altitude: Length; }

type CoordinateConvention
{
    RightHanded: Boolean;
    UpAxis: Integer;
    ForwardAxis: Integer;
}

type CoordinateReferenceSystem { Name: String; Authority: String; Code: String; }
type ProjectedPosition2D { Point: Point2D; ReferenceSystem: CoordinateReferenceSystem; }
type ProjectedPosition3D { Point: Point3D; ReferenceSystem: CoordinateReferenceSystem; }
