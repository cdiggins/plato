// Rendering scene descriptions remain backend-neutral.

type Viewport { Origin: Integer2; Size: ImageSize; MinimumDepth: Number; MaximumDepth: Number; }
type PerspectiveProjection { VerticalFieldOfView: Angle; AspectRatio: Number; Near: Number; Far: Number; }
type OrthographicProjection { Width: Number; Height: Number; Near: Number; Far: Number; }
type ObliqueProjection { Direction: Vector3; Scale: Number; }
type Camera3D implements ICamera { Pose: RigidTransform3D; Projection: Matrix4x4; Viewport: Viewport; }

type TextureCoordinate { U: Number; V: Number; }
type TextureTransform { Offset: Vector2; Scale: Vector2; Rotation: Angle; }
type TextureReference { Name: String; Transform: TextureTransform; CoordinateSet: Integer; }
type SamplerState { Minification: String; Magnification: String; WrapU: String; WrapV: String; }

type MetallicRoughnessMaterial
{
    BaseColor: LinearRgba;
    Metallic: Number;
    Roughness: Number;
    BaseColorTexture: TextureReference;
    MetallicRoughnessTexture: TextureReference;
}

type SpecularGlossinessMaterial
{
    Diffuse: LinearRgba;
    Specular: LinearRgb;
    Glossiness: Number;
}

type VolumeMaterial { Absorption: LinearRgb; Scattering: LinearRgb; Anisotropy: Number; }
type Material implements IMaterial { Name: String; SurfaceModel: String; Parameters: IArray<Number>; Textures: IArray<TextureReference>; }

type DirectionalLight implements IDirectionalLight { Direction: Vector3; Color: LinearRgb; Intensity: Number; }
type PointLight implements IPositionalLight { Position: Point3D; Color: LinearRgb; Intensity: Number; Range: Number; }
type SpotLight implements IPositionalLight, IDirectionalLight { Position: Point3D; Direction: Vector3; InnerAngle: Angle; OuterAngle: Angle; Color: LinearRgb; Intensity: Number; }
type AreaLight implements ILight { Shape: Quad3D; Color: LinearRgb; Intensity: Number; }
type EnvironmentLight implements ILight { Texture: TextureReference; Intensity: Number; Rotation: Angle; }

type RenderInstance implements IRenderInstance { Geometry: Integer; Material: Integer; Transform: AffineTransform3D; }
type RenderScene implements IRenderScene
{
    Geometries: IArray<AttributedTriangleMesh3D>;
    Materials: IArray<Material>;
    Instances: IArray<RenderInstance>;
    Cameras: IArray<Camera3D>;
}
