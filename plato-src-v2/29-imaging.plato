// Raster, volume, channel, and camera-sensor data.

type PixelFormat { Name: String; Channels: Integer; BitsPerChannel: Integer; FloatingPoint: Boolean; }
type ImageSize { Width: Integer; Height: Integer; }
type ImageRegion implements IImageRegion { Origin: Integer2; Size: ImageSize; }
type Image<T> implements IImage<T> { Size: ImageSize; Pixels: IArray2D<T>; }
type MipLevel<T> { Level: Integer; Image: Image<T>; }
type MipChain<T> implements IMipmapped<MipLevel<T>> { Levels: IArray<MipLevel<T>>; }

type GrayImage { Pixels: Image<Number>; }
type RgbaImage { Pixels: Image<LinearRgba>; }
type DepthImage { Pixels: Image<Number>; Near: Number; Far: Number; }
type NormalImage { Pixels: Image<Vector3>; }
type LabelImage { Pixels: Image<Integer>; Labels: IArray<String>; }

type VolumeImage<T> implements IVolumeImage<T> { Size: Integer3; Voxels: IArray3D<T>; Spacing: Vector3; }
type ImageChannel<T> implements IImageChannel<T> { Name: String; Values: Image<T>; }
type MultiChannelImage implements IMultiChannelImage { Size: ImageSize; Channels: IArray<ImageChannel<Number>>; }

type LensDistortion { Radial: Vector3; Tangential: Vector2; }
type CameraIntrinsics implements ICameraIntrinsics
{
    FocalLength: Vector2;
    PrincipalPoint: Point2D;
    Skew: Number;
    ImageSize: ImageSize;
    Distortion: LensDistortion;
}

type CameraExtrinsics implements ICameraExtrinsics { WorldToCamera: RigidTransform3D; }
type CalibratedCamera implements ICameraCalibration { Intrinsics: CameraIntrinsics; Extrinsics: CameraExtrinsics; }
