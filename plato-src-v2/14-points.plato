// Points are positions; vectors are displacements.

type Point1D implements IGeometry { X: Number; }
type Point2D implements IGeometry2D, IMetric<Number> { X: Number; Y: Number; }
type Point3D implements IGeometry3D, IMetric<Number> { X: Number; Y: Number; Z: Number; }
type Point4D implements IGeometry4D, IMetric<Number> { X: Number; Y: Number; Z: Number; W: Number; }
type PointN implements IGeometryND, IMetric<Number> { Coordinates: IArray<Number>; }

type HomogeneousPoint2D { X: Number; Y: Number; W: Number; }
type HomogeneousPoint3D { X: Number; Y: Number; Z: Number; W: Number; }

type WeightedPoint2D { Point: Point2D; Weight: Number; }
type WeightedPoint3D { Point: Point3D; Weight: Number; }
type WeightedPoint4D { Point: Point4D; Weight: Number; }

type PointCloud2D implements IDiscreteGeometry<Point2D> { Points: IArray<Point2D>; }
type PointCloud3D implements IDiscreteGeometry<Point3D> { Points: IArray<Point3D>; }
type PointCloud4D implements IDiscreteGeometry<Point4D> { Points: IArray<Point4D>; }
type PointCloudN implements IDiscreteGeometry<PointN> { Points: IArray<PointN>; }

type OrientedPoint2D { Position: Point2D; Normal: Vector2; }
type OrientedPoint3D { Position: Point3D; Normal: Vector3; }
type SamplePoint3D { Position: Point3D; Normal: Vector3; Weight: Number; }
