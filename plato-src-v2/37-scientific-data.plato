// General scientific observations, tables, and experiment metadata.

type Identifier implements IIdentified<String> { Namespace: String; Value: String; }
type NamedValue<T> implements INamedValue<T> { Name: String; Value: T; }
type QuantityValue implements INamedValue<Quantity> { Name: String; Value: Quantity; }
type Observation<T> implements IObservation<T> { Subject: Identifier; Time: Instant; Value: T; }
type ObservationSeries<T> implements IObservationSeries<T> { Name: String; Observations: IArray<Observation<T>>; }

type DataColumn<T> implements IDataColumn<T> { Name: String; Unit: Unit; Values: IArray<T>; }
type NumericTable implements IDataTable { RowCount: Integer; Columns: IArray<DataColumn<Number>>; }
type DataSet implements IDataSet { Name: String; Description: String; Tables: IArray<NumericTable>; }

type ExperimentParameter { Name: String; Value: Quantity; }
type ExperimentRun implements IExperiment
{
    Id: Identifier;
    Started: Instant;
    Duration: Duration;
    Parameters: IArray<ExperimentParameter>;
    Results: DataSet;
}

type ChemicalElement { AtomicNumber: Integer; Symbol: String; AtomicMass: Mass; }
type Atom3D { Element: ChemicalElement; Position: Point3D; Charge: Number; }
type Bond { Atoms: IndexPair; Order: Number; }
type Molecule3D implements IChemicalStructure<Atom3D, Bond> { Atoms: IArray<Atom3D>; Bonds: IArray<Bond>; }

type CrystallographicCell { Basis: Basis3D; Origin: Point3D; }
type CrystalStructure implements IPeriodicStructure<CrystallographicCell> { Cell: CrystallographicCell; FractionalPositions: IArray<Point3D>; Elements: IArray<ChemicalElement>; }
