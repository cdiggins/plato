// Dense, sparse, fixed-size, and tensor representations.

type Matrix2x2 { Row0: Vector2; Row1: Vector2; }
type Matrix3x2 { Row0: Vector2; Row1: Vector2; Row2: Vector2; }
type Matrix3x3 { Row0: Vector3; Row1: Vector3; Row2: Vector3; }
type Matrix4x4 { Row0: Vector4; Row1: Vector4; Row2: Vector4; Row3: Vector4; }

type Matrix
{
    Rows: Integer;
    Columns: Integer;
    Values: IArray<Number>;
}

type ComplexMatrix
{
    Rows: Integer;
    Columns: Integer;
    Values: IArray<Complex>;
}

type SparseEntry { Row: Integer; Column: Integer; Value: Number; }
type SparseMatrix { Rows: Integer; Columns: Integer; Entries: IArray<SparseEntry>; }
type BandedMatrix { Rows: Integer; Columns: Integer; LowerBandwidth: Integer; UpperBandwidth: Integer; Values: IArray<Number>; }

type Tensor2 { XX: Number; XY: Number; YX: Number; YY: Number; }
type Tensor3 { Row0: Vector3; Row1: Vector3; Row2: Vector3; }
type SymmetricTensor2 { XX: Number; XY: Number; YY: Number; }
type SymmetricTensor3 { XX: Number; XY: Number; XZ: Number; YY: Number; YZ: Number; ZZ: Number; }
type Tensor { Shape: ShapeND; Values: IArray<Number>; }
