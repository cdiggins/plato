// Mesh concepts compose geometry, topology, attributes, and volumetric structure.

interface IMesh<TPoint, TFace, TBounds>
    inherits IIndexedGeometry<TPoint, TFace>, IBounded<TBounds>
{ }

interface ISurfaceMesh<TPoint, TFace, TBounds>
    inherits IMesh<TPoint, TFace, TBounds>, IOrientable
{ }

interface IVolumeMesh<TPoint, TCell, TBounds>
    inherits IMesh<TPoint, TCell, TBounds>
{ }

interface IAttributedGeometry<TGeometry, TAttributes>
{
    Geometry(value: Self): TGeometry;
    Attributes(value: Self): TAttributes;
}

interface IAttributeChannel<T>
    inherits IHasName
{
    Values(channel: Self): IArray<T>;
}

interface IVertexNormals
{
    Normals(value: Self): IArray<Vector3>;
}

interface ITextureCoordinates
{
    TextureCoordinates(value: Self): IArray<Vector2>;
}

interface IVertexColors
{
    Colors(value: Self): IArray<LinearRgba>;
}

interface ITopologyBacked<TTopology>
{
    Topology(value: Self): TTopology;
}
