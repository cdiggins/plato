// Explicit topology separates connectivity from embedded geometry.

type OrientedIndex implements IOrientedIndex { Index: Integer; Reversed: Boolean; }
type IndexPair { A: Integer; B: Integer; }
type IndexTriple { A: Integer; B: Integer; C: Integer; }
type IndexQuad { A: Integer; B: Integer; C: Integer; D: Integer; }
type IndexLoop { Indices: IArray<Integer>; }

type Graph implements IGraph { VertexCount: Integer; Edges: IArray<IndexPair>; }
type DirectedEdge { Source: Integer; Target: Integer; }
type DirectedGraph implements IDirectedGraph { VertexCount: Integer; Edges: IArray<DirectedEdge>; }

type HalfEdge
{
    Vertex: Integer;
    Face: Integer;
    Next: Integer;
    Previous: Integer;
    Twin: Integer;
}

type HalfEdgeTopology implements IHalfEdgeTopology
{
    VertexCount: Integer;
    FaceCount: Integer;
    HalfEdges: IArray<HalfEdge>;
}

type CellComplex implements ICellTopology
{
    VertexCount: Integer;
    Edges: IArray<IndexPair>;
    Faces: IArray<IndexLoop>;
    Cells: IArray<IndexLoop>;
}

type SimplicialComplex2D implements ISimplicialComplex<IndexTriple> { VertexCount: Integer; Edges: IArray<IndexPair>; Triangles: IArray<IndexTriple>; }
type SimplicialComplex3D implements ISimplicialComplex<IndexQuad> { VertexCount: Integer; Edges: IArray<IndexPair>; Triangles: IArray<IndexTriple>; Tetrahedra: IArray<IndexQuad>; }
type SubdivisionScheme implements ISubdivisionRule { Name: String; Iterations: Integer; BoundaryRule: String; }
