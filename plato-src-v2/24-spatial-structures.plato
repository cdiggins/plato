// Spatial acceleration structures remain pure data.

type MortonCode2D implements ISpatialCode<Integer2> { Value: Integer; }
type MortonCode3D implements ISpatialCode<Integer3> { Value: Integer; }
type GridCell2D implements ISpatialCell<Integer2, IndexRange> { Coordinate: Integer2; Items: IndexRange; }
type GridCell3D implements ISpatialCell<Integer3, IndexRange> { Coordinate: Integer3; Items: IndexRange; }

type BvhNode2D implements IBoundedNode<Bounds2D> { Bounds: Bounds2D; Children: IndexPair; Items: IndexRange; }
type BvhNode3D implements IBoundedNode<Bounds3D> { Bounds: Bounds3D; Children: IndexPair; Items: IndexRange; }
type Bvh2D implements ISpatialTree<BvhNode2D>, ISpatialIndex<Point2D, Integer> { Nodes: IArray<BvhNode2D>; ItemIndices: IArray<Integer>; }
type Bvh3D implements ISpatialTree<BvhNode3D>, ISpatialIndex<Point3D, Integer> { Nodes: IArray<BvhNode3D>; ItemIndices: IArray<Integer>; }

type QuadTreeNode { Bounds: Bounds2D; Children: IndexQuad; Items: IndexRange; }
type QuadTree implements ISpatialTree<QuadTreeNode>, ISpatialIndex<Point2D, Integer> { Nodes: IArray<QuadTreeNode>; ItemIndices: IArray<Integer>; }
type OctreeNode { Bounds: Bounds3D; Children: IArray<Integer>; Items: IndexRange; }
type Octree implements ISpatialTree<OctreeNode>, ISpatialIndex<Point3D, Integer> { Nodes: IArray<OctreeNode>; ItemIndices: IArray<Integer>; }

type KdTreeNode { Axis: Integer; Split: Number; Children: IndexPair; Items: IndexRange; }
type KdTree implements ISpatialTree<KdTreeNode>, ISpatialIndex<PointN, Integer> { Dimension: Integer; Nodes: IArray<KdTreeNode>; Points: IArray<PointN>; }
