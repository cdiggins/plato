// Spatial acceleration structures remain pure data.

type MortonCode2D { Value: Integer; }
type MortonCode3D { Value: Integer; }
type GridCell2D { Coordinate: Integer2; Items: IndexRange; }
type GridCell3D { Coordinate: Integer3; Items: IndexRange; }

type BvhNode2D { Bounds: Bounds2D; Children: IndexPair; Items: IndexRange; }
type BvhNode3D { Bounds: Bounds3D; Children: IndexPair; Items: IndexRange; }
type Bvh2D { Nodes: IArray<BvhNode2D>; ItemIndices: IArray<Integer>; }
type Bvh3D { Nodes: IArray<BvhNode3D>; ItemIndices: IArray<Integer>; }

type QuadTreeNode { Bounds: Bounds2D; Children: IndexQuad; Items: IndexRange; }
type QuadTree { Nodes: IArray<QuadTreeNode>; ItemIndices: IArray<Integer>; }
type OctreeNode { Bounds: Bounds3D; Children: IArray<Integer>; Items: IndexRange; }
type Octree { Nodes: IArray<OctreeNode>; ItemIndices: IArray<Integer>; }

type KdTreeNode { Axis: Integer; Split: Number; Children: IndexPair; Items: IndexRange; }
type KdTree { Dimension: Integer; Nodes: IArray<KdTreeNode>; Points: IArray<PointN>; }
