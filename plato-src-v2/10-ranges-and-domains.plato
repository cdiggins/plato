// Closed/open state is data, not an implicit naming convention.

type BoundaryInclusion { IncludeMinimum: Boolean; IncludeMaximum: Boolean; }
type NumberRange implements IInterval<Number>, IContains<Number>, IClamps<Number>, IBoundaryAware { Minimum: Number; Maximum: Number; Boundary: BoundaryInclusion; }
type IntegerRange implements IInterval<Integer>, IContains<Integer>, IClamps<Integer>, IBoundaryAware, IDiscreteDomain<Integer> { Minimum: Integer; Maximum: Integer; Boundary: BoundaryInclusion; }
type AngleRange implements IInterval<Angle>, IContains<Angle>, IClamps<Angle>, IBoundaryAware { Minimum: Angle; Maximum: Angle; Boundary: BoundaryInclusion; }
type ParameterRange implements IInterval<Number>, IParameterDomain<Number> { Minimum: Number; Maximum: Number; Periodic: Boolean; }
type Domain2D implements IParameterDomain<Vector2> { U: ParameterRange; V: ParameterRange; }
type Domain3D implements IParameterDomain<Vector3> { U: ParameterRange; V: ParameterRange; W: ParameterRange; }
type DomainND implements ICartesianDomain<ParameterRange>, IParameterDomain<PointN> { Axes: IArray<ParameterRange>; }

type NumberInterval implements IInterval<Number>, IContains<Number> { Minimum: Number; Maximum: Number; }
type ComplexRectangle { Real: NumberInterval; Imaginary: NumberInterval; }
type BoxInterval2 { X: NumberInterval; Y: NumberInterval; }
type BoxInterval3 { X: NumberInterval; Y: NumberInterval; Z: NumberInterval; }
type BoxInterval4 { X: NumberInterval; Y: NumberInterval; Z: NumberInterval; W: NumberInterval; }
