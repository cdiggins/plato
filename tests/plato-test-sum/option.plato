// Positive fixture: a generic sum type (TKT-443). The declaration names its parameter T; a
// library consumer spells the free type variable $T, as every generic signature does, and each
// use instantiates the sum afresh (Option<Number> in Wrap and Empty).
//
// Option<T> is also the motivating case for plato-079 (partiality cleanup): it replaces the
// `Tuple2<T, Boolean>` / sentinel-value conventions in the stdlib.

type Number { }

type Option<T> = None | Some(Value: T);

library Options {
    GetOrElse(o: Option<$T>, fallback: $T): $T =>
        match (o) {
            None => fallback;
            Some(v) => v;
        };

    Wrap(x: Number): Option<Number> => Option.Some(x);

    Empty(x: Number): Option<Number> => Option.None;

    KeepSome(o: Option<Number>): Option<Number> =>
        match (o) {
            None => Option.None;
            Some(v) => o;
        };
}
