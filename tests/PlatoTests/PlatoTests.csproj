<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- The imported Plato.Intrinsics.V2 shared sources use unsafe blocks (Vector4). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- plato-331: IntrinsicsV2SurfaceTests reflects over the handwritten V2 runtime to police the
       writer's PrimitiveSurfaceOverrides table. V2 is a shared project (no assembly of its own),
       so its sources compile into this test assembly, same as the conformance suites do. -->
  <Import Project="..\Plato.Intrinsics.V2\Plato.Intrinsics.V2.projitems" Label="Shared" />
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.3.2" />
    <!-- Wave-2 (plato-232) codegen gate: compile the emitted sum-type C# in-proc and run it. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.4.2" />
    <PackageReference Include="NUnit.Analyzers" Version="3.3.0" />
    <PackageReference Include="coverlet.collector" Version="3.1.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Plato.Compiler\Plato.Compiler.csproj" />
    <ProjectReference Include="..\PlatoTypeInference\PlatoTypeInference.csproj" />
    <!-- Test-only: the emit-differential harness diffs the experimental TirCSharpBodyWriter against
         the current CSharpFunctionBodyWriter. Does NOT affect the default emit path. -->
    <ProjectReference Include="..\Plato.CSharpWriter\Plato.CSharpWriter.csproj" />
    <ProjectReference Include="..\Plato.TypeScriptWriter\Plato.TypeScriptWriter.csproj" />
    <ProjectReference Include="..\Plato.RustWriter\Plato.RustWriter.csproj" />
    <!-- Parser + utils, so checker tests can build a Compilation from real .plato source. -->
    <ProjectReference Include="..\parakeet\Parakeet.Parsers\Ara3D.Parakeet.Parsers.csproj" />
    <PackageReference Include="Ara3D.SDK.Core" Version="$(Ara3DVersion)" />
    <!-- Required by the Plato.Intrinsics.V2 shared sources (PlatoBuffer/PlatoList). -->
  </ItemGroup>
  <ItemGroup>
    <Folder Include="output\" />
  </ItemGroup>
</Project>