// --specialize-callbacks: callees that take a callback, in the shapes the switch rewrites and the one it refuses.
library CallbackProbe
{
    // A statement body: the inliner refuses it, so without the switch the lambda survives as a delegate.
    Iterate(x: Number, f: Function1<Number, Number>): Number {
        var once = f(x);
        var twice = f(once);
        return twice + once;
    }

    // Forwards its callback to another statement-body callee: specialized at two depths.
    IterateTwice(x: Number, f: Function1<Number, Number>): Number {
        var once = x.Iterate(f);
        return once.Iterate(f);
    }

    // The callback is the receiver.
    Apply(f: Function1<Number, Number>, x: Number): Number {
        var y = f(x);
        return y + y;
    }

    // Stores the callback in a local: refused, the lambda stays.
    Stored(x: Number, f: Function1<Number, Number>): Number {
        var g = f;
        return g(x);
    }

    // A capturing lambda: k and x arrive as extra parameters of the clone.
    Scaled(x: Number, k: Number): Number => x.Iterate(a => a * k + x);
    // The same shape through the forwarding callee: the inner clone is the one Scaled uses.
    ScaledTwice(x: Number, k: Number): Number => x.IterateTwice(a => a * k + x);
    // A lambda without captures.
    Doubled(x: Number): Number => x.Iterate(a => a + a);
    Applied(x: Number, k: Number): Number => Apply(a => a * k, x);
    StoredDoubled(x: Number): Number => x.Stored(a => a + a);
    // Applies the callback to a computed argument: a lambda using its parameter twice cannot take it by
    // substitution (the work would repeat), so --specialize-callbacks-lean calls a helper with it.
    // A statement body, so the inliner leaves the call (and the work) in the argument.
    Shifted(x: Number): Number {
        var t = x * 2.0;
        return t + 1.0;
    }
    ShiftThen(x: Number, f: Function1<Number, Number>): Number {
        var y = f(x.Shifted);
        return y + 1.0;
    }
    Squared(x: Number, k: Number): Number => x.ShiftThen(a => a * a + k);
    // A validation caller: --specialize-callbacks-lean leaves its lambda alone.
    Check_Tripled(x: Number): Number => x.Iterate(a => a * 3.0);
}

type PairA { X: Number; Y: Number; }
type PairB { U: Number; V: Number; }

library CallbackProbeGeneric
{
    // A generic callee over Array: one clone per element type, though the lambda shape is the same.
    Agree(xs: Array<$T>, ys: Array<$T>, f: Function2<$T, $T, Boolean>): Boolean {
        var first = f(xs[0], ys[0]);
        var second = f(xs[1], ys[1]);
        return first ? second : false;
    }
    AgreeA(xs: Array<PairA>, ys: Array<PairA>): Boolean => xs.Agree(ys, (p, q) => true);
    AgreeB(xs: Array<PairB>, ys: Array<PairB>): Boolean => xs.Agree(ys, (p, q) => true);
}
