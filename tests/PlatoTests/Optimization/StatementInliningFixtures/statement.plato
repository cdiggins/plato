library StatementProbe {
    Deferred(n: Integer): Function1<Integer, Array<Integer>> => x => [n, x].Map(i => i + 1);
    LiteralMap(n: Integer): Array<Integer> => [n, n].Map(i => i + 1);
    LiteralRegion(n: Integer): Array<Integer> { var result = n.LiteralMap; return result; }
    ArrayCalls(n: Integer): Array<Integer> => [n.Twice, n.Twice];
