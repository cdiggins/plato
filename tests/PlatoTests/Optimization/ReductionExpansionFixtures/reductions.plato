library ReductionExpansionProbe
{
    RepeatedAccumulator(seed: Number, value: Function1<Number, Number>, combine: Function3<Number, Number, Number, Number>): Number
        => [value(1.0), value(2.0), value(3.0), value(4.0), value(5.0), value(6.0), value(7.0), value(8.0),
            value(9.0), value(10.0), value(11.0), value(12.0), value(13.0), value(14.0), value(15.0), value(16.0),
            value(17.0), value(18.0), value(19.0), value(20.0), value(21.0), value(22.0), value(23.0), value(24.0),
            value(25.0), value(26.0), value(27.0), value(28.0), value(29.0), value(30.0), value(31.0), value(32.0)]
            .Reduce(seed, (a, b) => combine(a, a, b));

    RepeatedElement(seed: Number, value: Function1<Number, Number>, combine: Function3<Number, Number, Number, Number>): Number
        => [value(1.0), value(2.0)].Reduce(seed, (a, b) => combine(a, b, b));

    SingleUse(seed: Number, value: Function1<Number, Number>, combine: Function3<Number, Number, Number, Number>): Number
        => [1.0, 2.0, 3.0].Reduce(seed, (a, b) => combine(a, b, 0.0));
}
