// Fixture of the decoder-wave rewrites (TKT-1138 and TKT-1142): each function is one case of the rule of
//   --bind-scrutinee  (src/Plato.Compiler/Checking/TirScrutineeBinding.cs),
//   --sink-bindings   (src/Plato.Compiler/Checking/TirSinkBindings.cs) or
//   --share-calls-wide (writers/Plato.CSharpWriter/Optimization/TirSharedCalls.cs),
// and each law states the value the plain reading gives. The tests count the calls of Cost, Row and IsKind
// in the tree, in the compiled code and in the interpreter.
type RewriteRow = Good(Value: Integer) | Bad(Code: Integer, About: Integer);

type RewriteKind = KindA | KindB | KindC;

library RewriteProbe
{
    Cost(n: Integer): Integer => n * n + 1;

    Row(n: Integer): RewriteRow => n > 0 ? RewriteRow.Good(n) : RewriteRow.Bad(n, 1);

    IsKind(n: Integer, k: RewriteKind): Boolean
        => match (k) {
            KindA => n > 0;
            KindB => n > 1;
            KindC => n > 2;
        };

    //== Match scrutinee: bound once

    // The scrutinee is a call and the match is the body.
    MatchBody(n: Integer): Integer
        => match (Row(n)) {
            Good(v) => v + 1;
            Bad(c, a) => c + a;
        };

    // The match is the value of a local.
    MatchInLocal(n: Integer): Integer
    {
        var r = match (Row(n)) {
            Good(v) => v + 1;
            Bad(c, a) => c + a;
        };
        return r * 2;
    }

    // The match is an operand of a call, so it is evaluated on every path.
    MatchOperand(n: Integer): Integer
        => 10 + match (Row(n)) {
            Good(v) => v;
            Bad(c, a) => c - a;
        };

    // The match is an arm of a conditional (TKT-1199): its scrutinee is not evaluated on every path, so the
    // return becomes an if whose arm declares the local.
    MatchInArm(n: Integer): Integer
        => n > 100 ? 0 : match (Row(n)) {
            Good(v) => v + 1;
            Bad(c, a) => c + a;
        };

    // The match is an arm of another match, on a field of its binder: the outer scrutinee is bound before
    // the statement and the inner one in the arm (TKT-1199).
    MatchInMatchArm(n: Integer): Integer
        => match (Row(n)) {
            Good(v) => match (Row(v - 2)) {
                Good(w) => w + 10;
                Bad(c, a) => c - a;
            };
            Bad(c, a) => c + a;
        };

    //== Match scrutinee: kept as written

    // A parameter costs nothing to repeat.
    MatchOnParameter(r: RewriteRow): Integer
        => match (r) {
            Good(v) => v + 1;
            Bad(c, a) => c + a;
        };

    // The match is an arm of a conditional that is the value of a local: no local can be declared in its arm.
    MatchInLocalArm(n: Integer): Integer
    {
        var r = n > 100 ? 0 : match (Row(n)) {
            Good(v) => v + 1;
            Bad(c, a) => c + a;
        };
        return r * 2;
    }

    // A lambda body is evaluated when the lambda is called.
    MatchInLambda(n: Integer): Array<Integer>
        => n.MapRange(i => match (Row(i)) {
            Good(v) => v + 1;
            Bad(c, a) => c + a;
        });

    //== Sink: evaluated on the arm that reads it

    // One read, in the arm of the returned conditional.
    SunkOneArm(n: Integer): Integer
    {
        var x = Cost(n);
        return n > 3 ? x + 1 : 0;
    }

    // The read is in the innermost arm of a chain.
    SunkChain(n: Integer): Integer
    {
        var x = Cost(n);
        return n > 9 ? 1 : (n > 5 ? 2 : (n > 3 ? x : 4));
    }

    // Two reads in the arm: the return becomes an if whose arm declares the local.
    SunkTwoReads(n: Integer): Integer
    {
        var x = Cost(n);
        return n > 3 ? x + x : 0;
    }

    // The read is in one branch of an if statement.
    SunkIfBranch(n: Integer): Integer
    {
        var x = Cost(n);
        if (n > 3) { return x + x; }
        return 0;
    }

    // A lambda in the arm reads it: the arm declares it once and the lambda reads the value.
    SunkLambdaArm(n: Integer): Array<Integer>
    {
        var x = Cost(n);
        return n > 3 ? n.MapRange(i => i + x) : n.MapRange(i => i);
    }

    // The local of a local: both move.
    SunkChained(n: Integer): Integer
    {
        var x = Cost(n);
        var y = Cost(x);
        return n > 3 ? y : 0;
    }

    //== Sink: kept

    // The condition reads it: it is evaluated on every path.
    SunkKeptCondition(n: Integer): Integer
    {
        var x = Cost(n);
        return x > 10 ? x : 0;
    }

    // Both arms read it.
    SunkKeptBothArms(n: Integer): Integer
    {
        var x = Cost(n);
        return n > 3 ? x + 1 : x + 2;
    }

    // The read is not under a conditional.
    SunkKeptStrict(n: Integer): Integer
    {
        var x = Cost(n);
        return x + 1;
    }

    // A lambda is not an arm: it may run any number of times, so the value is not moved into it.
    SunkKeptLambda(n: Integer): Array<Integer>
    {
        var x = Cost(n);
        return n.MapRange(i => i + x);
    }

    // A variable is free to read.
    SunkKeptCheap(n: Integer): Integer
    {
        var x = n;
        return n > 3 ? x + 1 : 0;
    }

    //== Wide sharing: across statements

    // The call is in two statements.
    AcrossStatements(n: Integer): Integer
    {
        var a = Cost(n) + 1;
        var b = Cost(n) * 2;
        return a + b;
    }

    // The first statement evaluates it on every path, the return names it again in an arm. The condition
    // reads a, so --sink-bindings leaves it where it is.
    AcrossBranch(n: Integer): Integer
    {
        var a = Cost(n);
        return a > 0 && n > 3 ? Cost(n) + a : 0;
    }

    // A sum case written as a factory is part of the call.
    AcrossKind(n: Integer): Integer
    {
        var a = IsKind(n, RewriteKind.KindA) ? 1 : 2;
        return IsKind(n, RewriteKind.KindA) ? a : 3;
    }

    // The earlier statement names it only on an arm: nothing is evaluated on every path.
    AcrossKept(n: Integer): Integer
    {
        var a = n > 3 ? Cost(n) : 0;
        return a + Cost(n);
    }

    // Different arguments are different calls.
    AcrossDifferent(n: Integer): Integer
    {
        var a = Cost(n);
        var b = Cost(n + 1);
        return a + b;
    }

    //== Wide sharing: in lambda bodies

    // The body names the call twice.
    InLambdaTwice(n: Integer): Array<Integer>
        => n.MapRange(i => Cost(i) + Cost(i));

    // The lambda names a call of the outer parameter that the block evaluates.
    InLambdaOuter(n: Integer): Array<Integer>
    {
        var a = Cost(n);
        return n.MapRange(i => i + Cost(n) + a);
    }

    // Only the branches name the call.
    InLambdaKept(n: Integer): Array<Integer>
        => n.MapRange(i => i > 2 ? Cost(i) : Cost(i) + 1);

    //== Probes: nullary calls whose evaluations the interpreter test counts

    Probe_MatchBody(): Integer => MatchBody(0 - 2);
    Probe_MatchInLocal(): Integer => MatchInLocal(0 - 2);
    Probe_MatchOperand(): Integer => MatchOperand(0 - 2);
    Probe_MatchInArm(): Integer => MatchInArm(0 - 2);
    Probe_MatchInMatchArm(): Integer => MatchInMatchArm(1);
    Probe_MatchInLocalArm(): Integer => MatchInLocalArm(0 - 2);
    Probe_SunkOneArm(): Integer => SunkOneArm(2);
    Probe_SunkChain(): Integer => SunkChain(10);
    Probe_SunkTwoReads(): Integer => SunkTwoReads(2);
    Probe_SunkIfBranch(): Integer => SunkIfBranch(2);
    Probe_SunkChained(): Integer => SunkChained(2);
    Probe_SunkKeptCondition(): Integer => SunkKeptCondition(2);

    //== Laws: the value the plain reading gives

    Law_MatchBody(): Boolean => MatchBody(4).Equals(5) && MatchBody(0 - 2).Equals(0 - 1);
    Law_MatchInLocal(): Boolean => MatchInLocal(4).Equals(10) && MatchInLocal(0 - 2).Equals(0 - 2);
    Law_MatchOperand(): Boolean => MatchOperand(4).Equals(14) && MatchOperand(0 - 2).Equals(7);
    Law_MatchOnParameter(): Boolean => MatchOnParameter(Row(4)).Equals(5) && MatchOnParameter(Row(0 - 2)).Equals(0 - 1);
    Law_MatchInArm(): Boolean => MatchInArm(4).Equals(5) && MatchInArm(200).Equals(0) && MatchInArm(0 - 2).Equals(0 - 1);
    Law_MatchInMatchArm(): Boolean => MatchInMatchArm(4).Equals(12) && MatchInMatchArm(1).Equals(0 - 2) && MatchInMatchArm(0 - 2).Equals(0 - 1);
    Law_MatchInLocalArm(): Boolean => MatchInLocalArm(4).Equals(10) && MatchInLocalArm(200).Equals(0) && MatchInLocalArm(0 - 2).Equals(0 - 2);
    Law_MatchInLambda(): Boolean => MatchInLambda(3).Equals([1, 2, 3]);
    Law_SunkOneArm(): Boolean => SunkOneArm(4).Equals(18) && SunkOneArm(2).Equals(0);
    Law_SunkChain(): Boolean => SunkChain(4).Equals(17) && SunkChain(6).Equals(2) && SunkChain(10).Equals(1) && SunkChain(2).Equals(4);
    Law_SunkTwoReads(): Boolean => SunkTwoReads(4).Equals(34) && SunkTwoReads(2).Equals(0);
    Law_SunkIfBranch(): Boolean => SunkIfBranch(4).Equals(34) && SunkIfBranch(2).Equals(0);
    Law_SunkChained(): Boolean => SunkChained(4).Equals(290) && SunkChained(2).Equals(0);
    Law_SunkKeptCondition(): Boolean => SunkKeptCondition(4).Equals(17) && SunkKeptCondition(2).Equals(0);
    Law_SunkKeptBothArms(): Boolean => SunkKeptBothArms(4).Equals(18) && SunkKeptBothArms(2).Equals(7);
    Law_SunkKeptStrict(): Boolean => SunkKeptStrict(3).Equals(11);
    Law_SunkLambdaArm(): Boolean => SunkLambdaArm(4).Equals([17, 18, 19, 20]) && SunkLambdaArm(2).Equals([0, 1]);
    Law_SunkKeptLambda(): Boolean => SunkKeptLambda(4).Equals([17, 18, 19, 20]) && SunkKeptLambda(2).Equals([5, 6]);
    Law_SunkKeptCheap(): Boolean => SunkKeptCheap(4).Equals(5) && SunkKeptCheap(2).Equals(0);
    Law_AcrossStatements(): Boolean => AcrossStatements(3).Equals(31);
    Law_AcrossBranch(): Boolean => AcrossBranch(4).Equals(34) && AcrossBranch(2).Equals(0);
    Law_AcrossKind(): Boolean => AcrossKind(4).Equals(1) && AcrossKind(0 - 1).Equals(3);
    Law_AcrossKept(): Boolean => AcrossKept(4).Equals(34) && AcrossKept(2).Equals(5);
    Law_AcrossDifferent(): Boolean => AcrossDifferent(2).Equals(15);
    Law_InLambdaTwice(): Boolean => InLambdaTwice(3).Equals([2, 4, 10]);
    Law_InLambdaOuter(): Boolean => InLambdaOuter(2).Equals([10, 11]);
    Law_InLambdaKept(): Boolean => InLambdaKept(4).Equals([2, 3, 6, 10]);
}
