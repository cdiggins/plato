<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the interpreter (src/Plato.Interpreter): unit tests over the fixtures beside this
       file, law runs over the forward stdlib, and the differential test that runs the stdlib's
       laws through both the interpreter and the C# backend (compiled in-process with Roslyn,
       the Plato.Intrinsics sources included, under both Number profiles) and compares them. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath Condition="'$(RunSettingsFilePath)' == '' and '$(VSTestTestCaseFilter)' == ''">$(MSBuildThisFileDirectory)..\default.runsettings</RunSettingsFilePath>
    <Platforms>AnyCPU;x64</Platforms>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.3.2" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.4.2" />
    <PackageReference Include="Ara3D.SDK.Core" Version="$(Ara3DVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Plato.Interpreter\Plato.Interpreter.csproj" />
    <ProjectReference Include="..\..\src\Plato.Laws\Plato.Laws.csproj" />
    <ProjectReference Include="..\..\src\Plato.Compiler\Plato.Compiler.csproj" />
    <ProjectReference Include="..\..\writers\Plato.CSharpWriter\Plato.CSharpWriter.csproj" />
    <ProjectReference Include="..\..\parakeet\Parakeet.Parsers\Ara3D.Parakeet.Parsers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
