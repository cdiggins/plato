// Fixture for the lane C1-b golden sets (TKT-1183): a counted List fill (presize), a closed constant and closed call sites (cache-constants).
// It is compiled with the foundation slice but without GoldenFixture.plato, so the existing snapshots do not move.
library GoldenFixtureC1b
{
    Squares(n: Integer): Array<Integer>
    {
        var xs = new List<Integer>();
        var i = 0;
        while (i < n)
        {
            xs = xs.Add(i * i);
            i = i + 1;
        }
        return xs.Freeze();
    }
    Counted(src: Array<Integer>): Array<Integer>
    {
        var xs = new List<Integer>();
        var i = 1;
        while (i < src.Count)
        {
            xs = xs.Add(src[i] + 1);
            i = i + 1;
        }
        return xs.Freeze();
    }
    Grown(n: Integer): Array<Integer>
    {
        var xs = new List<Integer>();
        var i = 0;
        while (i < n)
        {
            if (i % 3 == 0)
            {
                xs = xs.Add(i);
            }
            i = i + 1;
        }
        return xs.Freeze();
    }
    Newton(a: Number): Number
    {
        var x = a;
        var i = 0;
        while (i < 20)
        {
            x = x - (x * x - a) / (2.0 * x);
            i = i + 1;
        }
        return x;
    }
    RootOfTwo(): Number => Newton(2.0);
    ScaledRoot(a: Number): Number => a * Newton(3.0);
    TwoRoots(): Array<Number> => [Newton(2.0), 1.0];
}
