//==
// # Mesh topology
//
// Connectivity, separated from embedded geometry. Typed index structs make the
// role of every integer explicit: a VertexIndex can never be silently confused
// with a FaceIndex. All index types share one convention: Value is zero-based,
// and -1 means "none" / "not present".
//
// Adjacency tables use CSR (compressed sparse row) encoding: an Offsets array
// with (element count + 1) entries, where the items belonging to element i
// occupy the half-open range [Offsets[i], Offsets[i+1]) of the packed payload
// array, and the final offset equals the payload array's length.

//==
// ## Typed element indices

// A zero-based index of a vertex within a mesh or point set. -1 means "none".
type VertexIndex
    implements Value, Hashable, Comparable, IndexLike
{
    Value: Integer;
}

// A zero-based index of an undirected edge within a mesh edge list. -1 means "none".
type EdgeIndex
    implements Value, Hashable, Comparable, IndexLike
{
    Value: Integer;
}

// A zero-based index of a face within a mesh. -1 means "none".
type FaceIndex
    implements Value, Hashable, Comparable, IndexLike
{
    Value: Integer;
}

// A zero-based index of a face corner (one vertex slot of one face). For
// triangle meshes, corner c belongs to triangle c / 3 and slot c mod 3.
// -1 means "none".
type CornerIndex
    implements Value, Hashable, Comparable, IndexLike
{
    Value: Integer;
}

// A zero-based index of a half-edge (one directed side of an undirected
// edge). -1 means "none".
type HalfEdgeIndex
    implements Value, Hashable, Comparable, IndexLike
{
    Value: Integer;
}

// A zero-based index of a volumetric cell (tetrahedron, hexahedron, voxel
// region) within a cell complex. -1 means "none".
type CellIndex
    implements Value, Hashable, Comparable, IndexLike
{
    Value: Integer;
}

//==
// ## Edges as vertex pairs

// An undirected edge named by its two endpoint vertices. The canonical form
// orders the pair so that A.Value <= B.Value; producers emit canonical pairs
// unless documented otherwise (LineSet segments preserve authored direction).
type VertexPair
    implements Value, Hashable
{
    A: VertexIndex;
    B: VertexIndex;
}

// The undirected edges of a mesh, extracted once and stored canonically:
// each pair ordered A.Value <= B.Value, pairs sorted lexicographically.
// An edge's position in this array is its EdgeIndex.
type EdgeList
    implements Value
{
    Edges: Array<VertexPair>;
}

// Per-edge incident faces, parallel to an EdgeList: LeftFaces[i] is the face
// on the side of Edges[i] where the traversal A to B runs counter-clockwise
// along the face loop; RightFaces[i] is the opposite side. A boundary edge
// stores -1 in RightFaces; a wire edge stores -1 in both.
type EdgeAdjacency
    implements Value
{
    Edges: Array<VertexPair>;
    LeftFaces: Array<FaceIndex>;
    RightFaces: Array<FaceIndex>;
}

//==
// ## Half-edge structures

// One directed side of an undirected mesh edge. Origin is the vertex this
// half-edge leaves. Next and Previous walk the loop of the bordered face in
// counter-clockwise order. Twin is the oppositely directed half-edge, -1 when
// the edge is on a boundary. Face is the bordered face, -1 when this
// half-edge runs along a hole.
type HalfEdge
    implements Value
{
    Origin: VertexIndex;
    Twin: HalfEdgeIndex;
    Next: HalfEdgeIndex;
    Previous: HalfEdgeIndex;
    Face: FaceIndex;
}

// A 3D mesh in half-edge form, supporting constant-time neighborhood
// navigation. FaceHalfEdges[f] is one half-edge on face f's loop;
// VertexHalfEdges[v] is one half-edge leaving vertex v, -1 for an isolated
// vertex. Requires a manifold (possibly bounded) surface.
type HalfEdgeMesh
    implements Value, MeshTopology, HalfEdgeNavigable
{
    Positions: Array<Point3D>;
    HalfEdges: Array<HalfEdge>;
    FaceHalfEdges: Array<HalfEdgeIndex>;
    VertexHalfEdges: Array<HalfEdgeIndex>;
}

// One closed loop of boundary half-edges (half-edges whose Face is -1),
// listed in walk order around the hole.
type BoundaryLoop
    implements Value
{
    HalfEdges: Array<HalfEdgeIndex>;
}

//==
// ## Corner tables

// Triangle-corner connectivity. Corner c belongs to triangle c / 3; its next
// corner within the triangle is 3 * (c / 3) + ((c + 1) mod 3). Corners[c] is
// the vertex sitting at corner c. Opposites[c] is the corner facing the same
// edge from the adjacent triangle, or -1 when that edge is on the boundary.
type CornerTable
    implements Value
{
    Corners: Array<VertexIndex>;
    Opposites: Array<CornerIndex>;
}

//==
// ## Adjacency tables (CSR)

// Vertex-to-vertex adjacency in CSR form. Offsets has (vertex count + 1)
// entries; the neighbors of vertex v are Neighbors[Offsets[v] .. Offsets[v+1])
// (half-open), sorted ascending within each run.
type VertexAdjacency
    implements Value
{
    Offsets: Array<Integer>;
    Neighbors: Array<VertexIndex>;
}

// Face-to-face adjacency across shared edges, in CSR form. Offsets has
// (face count + 1) entries; the faces sharing an edge with face f are
// Neighbors[Offsets[f] .. Offsets[f+1]) (half-open).
type FaceAdjacency
    implements Value
{
    Offsets: Array<Integer>;
    Neighbors: Array<FaceIndex>;
}

// The faces incident to each vertex, in CSR form. Offsets has
// (vertex count + 1) entries; the faces touching vertex v are
// Faces[Offsets[v] .. Offsets[v+1]) (half-open).
type VertexFaceAdjacency
    implements Value
{
    Offsets: Array<Integer>;
    Faces: Array<FaceIndex>;
}

//==
// ## Topological classification

// The rotational direction of a face loop as seen from the front side.
// Value meanings: 0=CounterClockwise (the library default), 1=Clockwise.
type WindingOrderKind
{
    Value: Integer;
}

// How close a surface is to being a 2-manifold.
// Value meanings: 0=Unknown, 1=Manifold (every edge borders exactly two
// faces, vertex stars are disks), 2=ManifoldWithBoundary (edges border one
// or two faces), 3=NonManifold.
type ManifoldnessKind
{
    Value: Integer;
}

// Aggregate topological measurements of a mesh. EulerCharacteristic equals
// VertexCount - EdgeCount + FaceCount; a closed connected manifold of genus g
// has Euler characteristic 2 - 2g.
type TopologySummary
    implements Value
{
    VertexCount: Integer;
    EdgeCount: Integer;
    FaceCount: Integer;
    BoundaryLoopCount: Integer;
    ConnectedComponentCount: Integer;
    EulerCharacteristic: Integer;
    Manifoldness: ManifoldnessKind;
}

//==
// ## Topology concepts

// Anything with counted mesh elements: vertices, undirected edges, and faces.
concept MeshTopology
{
    VertexCount(x: Self): Integer;
    EdgeCount(x: Self): Integer;
    FaceCount(x: Self): Integer;
}

// Constant-time navigation over a half-edge structure. Callers must not pass
// -1; boundary conditions surface as -1 results (e.g. TwinOf on a boundary
// half-edge).
concept HalfEdgeNavigable
{
    OriginOf(x: Self, halfEdge: HalfEdgeIndex): VertexIndex;
    TwinOf(x: Self, halfEdge: HalfEdgeIndex): HalfEdgeIndex;
    NextOf(x: Self, halfEdge: HalfEdgeIndex): HalfEdgeIndex;
    PreviousOf(x: Self, halfEdge: HalfEdgeIndex): HalfEdgeIndex;
    FaceOf(x: Self, halfEdge: HalfEdgeIndex): FaceIndex;
}
