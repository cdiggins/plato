//==
// # Polygons and polylines
//
// Point-list geometry: open and closed vertex chains, simple polygons, polygons
// with holes, and the solids obtained by extruding or coning a polygon.
// Winding convention: counter-clockwise boundaries enclose positive area;
// holes wind opposite to the boundary that contains them.

//==
// # Polylines

// A chain of straight segments joining consecutive Points. When Closed, an
// extra segment joins the last point back to the first. At least two points.
type Polyline2D
    implements Geometry2D, Connected, Bounded2D, LengthMeasurable, PointSet2D, Deformable2D
{
    Points: Array<Point2D>;
    Closed: Boolean;
}

// A chain of straight segments in space. When Closed, an extra segment joins
// the last point back to the first.
type Polyline3D
    implements Geometry3D, Connected, Bounded3D, LengthMeasurable, PointSet3D, Deformable3D
{
    Points: Array<Point3D>;
    Closed: Boolean;
}

// A chain of straight segments in N-dimensional space. When Closed, an extra
// segment joins the last point back to the first. All points share one arity.
type PolylineN
    implements GeometryND, Connected, LengthMeasurable
{
    Points: Array<PointN>;
    Closed: Boolean;
}

//==
// # Polygons in the plane

// A simple closed polygon: Points are the boundary vertices in order, the last
// implicitly joined to the first. Invariants: at least three vertices, no edge
// crossings; counter-clockwise winding encloses positive area.
type Polygon2D
    implements Geometry2D, ClosedShape, Connected, PlanarMeasurable, Bounded2D, PointSet2D, Centroid2D, ContainsPoint2D, NearestPoint2D, Deformable2D
{
    Points: Array<Point2D>;
}

// A polygon whose vertices are in strictly convex position, counter-clockwise.
// The stronger invariant unlocks constant-cost support mapping and logarithmic
// containment tests.
type ConvexPolygon2D
    implements Geometry2D, ClosedShape, ConvexShape, Connected, PlanarMeasurable, Bounded2D, PointSet2D, Centroid2D, ContainsPoint2D, NearestPoint2D, SupportMappable2D, Deformable2D
{
    Points: Array<Point2D>;
}

// A polygonal region with holes: the area inside Boundary and outside every
// hole. Invariants: holes lie strictly inside the boundary, are mutually
// disjoint, and wind opposite to it.
type PolygonWithHoles2D
    implements Geometry2D, ClosedShape, Connected, PlanarMeasurable, Bounded2D, Centroid2D, ContainsPoint2D, Deformable2D
{
    Boundary: Polygon2D;
    Holes: Array<Polygon2D>;
}

// A multi-polygon region: the union of mutually disjoint components. The result
// shape of Boolean operations over polygons; possibly disconnected, possibly
// empty.
type PolygonSet2D
    implements Geometry2D, ClosedShape, PlanarMeasurable, Bounded2D, ContainsPoint2D, Deformable2D
{
    Polygons: Array<PolygonWithHoles2D>;
}

// A star polygon with PointCount tips alternating between OuterRadius and
// InnerRadius vertices about Center (2 * PointCount vertices in all); Rotation
// turns the first tip away from +X. Invariants: PointCount >= 3,
// 0 < InnerRadius <= OuterRadius.
type RegularStar2D
    implements Geometry2D, ClosedShape, Connected, PlanarMeasurable, Bounded2D, Centroid2D, ContainsPoint2D
{
    Center: Point2D;
    OuterRadius: Number;
    InnerRadius: Number;
    PointCount: Integer;
    Rotation: Angle;
}

//==
// # Polygons in space

// A planar polygon embedded in 3D: Points are coplanar boundary vertices in
// order, the last implicitly joined to the first. The normal follows the
// right-hand rule around the winding.
type Polygon3D
    implements Geometry3D, ClosedShape, Connected, Manifold, Orientable, PlanarMeasurable, Bounded3D, PointSet3D, Centroid3D, NearestPoint3D
{
    Points: Array<Point3D>;
}

//==
// # Polygon-derived solids

// The solid swept by translating Base along Offset: a general prism. Oblique
// when Offset is not perpendicular to the base plane; convex when the base is
// convex.
type Prism3D
    implements Geometry3D, ClosedShape, Connected, SpatialMeasurable, Bounded3D, Centroid3D, ContainsPoint3D
{
    Base: Polygon3D;
    Offset: Vector3;
}

// The solid cone over a polygon: all segments from points of Base to Apex.
// Degenerate when Apex lies in the base plane.
type Pyramid3D
    implements Geometry3D, ClosedShape, Connected, SpatialMeasurable, Bounded3D, Centroid3D, ContainsPoint3D
{
    Base: Polygon3D;
    Apex: Point3D;
}
