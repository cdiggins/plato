//==
// # Point clouds and voxel grids
//
// Unstructured samples (enriched point clouds) and regular volumetric
// rasters (voxel grids). All dense grids share one parameterization: Origin
// is the world position of the minimum corner of cell (0, 0, 0), CellSize is
// the world-space edge length of one cubic cell, and the grid's dimensions
// come from its value array. Cell (i, j, k) spans the half-open world box
// [Origin + (i,j,k)*CellSize, Origin + (i+1,j+1,k+1)*CellSize).

//==
// ## Enriched point clouds

// A point cloud carrying a unit normal per point: the input to surface
// reconstruction and oriented splatting. Positions and Normals are parallel.
type OrientedPointCloud3D
    implements Value, PointCloudable3D
{
    Positions: Array<Point3D>;
    Normals: Array<Direction3D>;
}

// A point cloud carrying a color per point. Positions and Colors are parallel.
type ColoredPointCloud3D
    implements Value, PointCloudable3D
{
    Positions: Array<Point3D>;
    Colors: Array<Color>;
}

// A fully attributed point cloud, as produced by LiDAR and photogrammetry.
// All channels are parallel to Positions; an empty channel array means the
// channel is absent. Intensities are unitless sensor return strengths.
type AttributedPointCloud3D
    implements Value, PointCloudable3D
{
    Positions: Array<Point3D>;
    Normals: Array<Direction3D>;
    Colors: Array<Color>;
    Intensities: Array<Number>;
}

//==
// ## Dense voxel grids

// A dense 3D raster of arbitrary cell values over a regular grid. The grid
// dimensions are those of Values.
type VoxelGrid3D<T>
{
    Origin: Point3D;
    CellSize: Number;
    Values: Array3D<T>;
}

// A dense binary occupancy raster in the plane: floor plans, walkability
// masks, 2D rasterized regions. True means the cell is occupied.
type OccupancyGrid2D
    implements Value
{
    Origin: Point2D;
    CellSize: Number;
    Occupied: Array2D<Boolean>;
}

// A dense binary occupancy raster in space: voxelized solids, collision
// masks, volume selections. True means the cell is occupied.
type OccupancyGrid3D
    implements Value
{
    Origin: Point3D;
    CellSize: Number;
    Occupied: Array3D<Boolean>;
}

// A dense scalar raster in the plane: heightfields sampled as density,
// coverage maps, accumulation buffers.
type DensityGrid2D
    implements Value
{
    Origin: Point2D;
    CellSize: Number;
    Values: Array2D<Number>;
}

// A dense scalar raster in space: smoke, medical volumes, distance samples,
// occupancy probabilities. Values are unitless; interpretation is the
// producer's contract.
type DensityGrid3D
    implements Value
{
    Origin: Point3D;
    CellSize: Number;
    Values: Array3D<Number>;
}

// A dense color raster in space: baked volumetric lighting, color-mapped
// scans, voxel art.
type VoxelColorGrid3D
    implements Value
{
    Origin: Point3D;
    CellSize: Number;
    Colors: Array3D<Color>;
}

// A dense narrow-band signed-distance raster: negative inside, positive
// outside, in world units. Cells farther from the surface than
// NarrowBandWidth hold BackgroundDistance with the correct sign.
type LevelSetGrid3D
    implements Value
{
    Origin: Point3D;
    CellSize: Number;
    Distances: Array3D<Number>;
    NarrowBandWidth: Number;
    BackgroundDistance: Number;
}

//==
// ## Sparse voxel grids

// A sparse voxel raster: only occupied cells are stored. Coordinates holds
// integer cell coordinates (unique, sorted lexicographically Z, then Y,
// then X); Values is parallel to Coordinates. Cells not listed are empty.
type SparseVoxelGrid3D<T>
{
    Origin: Point3D;
    CellSize: Number;
    Coordinates: Array<IntegerVector3>;
    Values: Array<T>;
}

// One dense block of a two-level sparse volume. Coordinate is the brick's
// position in brick units (world position = Origin + Coordinate scaled by
// brick size times cell size); Values is the brick's dense payload, cubic
// with the owning map's BrickSize on each side.
type VoxelBrick3D
    implements Value
{
    Coordinate: IntegerVector3;
    Values: Array3D<Number>;
}

// A two-level sparse volume: a sparse set of dense cubic bricks, each
// BrickSize cells on a side. Regions with no brick are empty. Bricks are
// unique and sorted by Coordinate (lexicographically Z, then Y, then X).
type BrickMap3D
    implements Value
{
    Origin: Point3D;
    CellSize: Number;
    BrickSize: Integer;
    Bricks: Array<VoxelBrick3D>;
}

//==
// ## Point-cloud and voxel concepts

// Anything that can shed its structure and yield its points as a bare
// position cloud: meshes, enriched clouds, scan slices.
concept PointCloudable3D
{
    ToPointCloud(x: Self): PointCloud3D;
}

// Anything that can be conservatively rasterized into a binary voxel grid
// at a caller-chosen cell size.
concept Voxelizable3D
{
    ToOccupancyGrid(x: Self, cellSize: Number): OccupancyGrid3D;
}
