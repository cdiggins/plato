//==
// # Image processing
//
// Descriptions of raster operations: convolution kernels, morphological and
// threshold operations, tonal and color adjustments, compositing modes, and
// resampling. These are parameter records — pure data consumed by processing
// functions in a later pass. Distances and radii are in pixels unless noted.

//==
// ## Convolution and blurs

// A dense 2D convolution kernel. Weights are row-major, Width times Height
// entries; odd dimensions center the kernel on the target pixel. Each output
// is the weighted sum times Scale plus Bias.
type ConvolutionKernel
    implements Value
{
    Width: Integer;
    Height: Integer;
    Weights: Array<Number>;
    Scale: Number;
    Bias: Number;
}

// A separable convolution: a horizontal pass then a vertical pass, equivalent
// to convolving with the outer product of the two tap arrays but far cheaper.
type SeparableKernel
    implements Value
{
    HorizontalTaps: Array<Number>;
    VerticalTaps: Array<Number>;
}

// Gaussian blur settings. Radius bounds the kernel extent in pixels; a Sigma
// of 0 or less derives the standard deviation from Radius.
type GaussianBlurParameters
    implements Value
{
    Radius: Integer;
    Sigma: Number;
}

// Box blur settings: a uniform square average of the given radius, repeated
// Passes times (three passes closely approximate a Gaussian).
type BoxBlurParameters
    implements Value
{
    Radius: Integer;
    Passes: Integer;
}

// Linear motion blur: smearing along a direction over a distance in pixels.
type MotionBlurParameters
    implements Value
{
    Angle: Angle;
    Distance: Number;
}

// Unsharp-mask sharpening: Amount scales the high-frequency difference added
// back; Radius is the blur extent; Threshold suppresses sharpening where the
// local difference is below it (noise protection).
type UnsharpMaskParameters
    implements Value
{
    Radius: Number;
    Amount: Number;
    Threshold: Number;
}

//==
// ## Edges, morphology, and thresholds

// An edge-detection operator.
// Value meanings: 0=Sobel, 1=Prewitt, 2=Scharr, 3=Laplacian,
// 4=LaplacianOfGaussian, 5=Canny.
type EdgeDetectionKind
{
    Value: Integer;
}

// Edge-detection settings. Canny uses both hysteresis thresholds; the other
// operators use LowThreshold alone as the magnitude cutoff.
type EdgeDetectionParameters
    implements Value
{
    Kind: EdgeDetectionKind;
    LowThreshold: Number;
    HighThreshold: Number;
}

// A mathematical-morphology operation.
// Value meanings: 0=Erode, 1=Dilate, 2=Open, 3=Close, 4=TopHat, 5=BlackHat,
// 6=Gradient (dilation minus erosion).
type MorphologyKind
{
    Value: Integer;
}

// The neighborhood shape a morphological operation sweeps over the image.
// Value meanings: 0=Box, 1=Disk, 2=Cross, 3=Diamond.
type StructuringElementKind
{
    Value: Integer;
}

// A complete morphological operation: what to do, with which element shape,
// how large, and how many times.
type MorphologyParameters
    implements Value
{
    Operation: MorphologyKind;
    Element: StructuringElementKind;
    Radius: Integer;
    Iterations: Integer;
}

// A thresholding strategy for reducing an image to two (or clamped) levels.
// Value meanings: 0=Binary, 1=BinaryInverted, 2=Truncate, 3=ToZero,
// 4=Otsu (automatic global level), 5=AdaptiveMean, 6=AdaptiveGaussian.
type ThresholdKind
{
    Value: Integer;
}

// Threshold settings. Level is the normalized cutoff (ignored by Otsu, which
// computes its own); BlockSize is the local window for adaptive kinds; Offset
// biases the computed local level.
type ThresholdParameters
    implements Value
{
    Kind: ThresholdKind;
    Level: Proportion;
    BlockSize: Integer;
    Offset: Number;
}

//==
// ## Channels and histograms

// A color channel selected for analysis or adjustment.
// Value meanings: 0=Red, 1=Green, 2=Blue, 3=Alpha, 4=Luminance, 5=Hue,
// 6=Saturation, 7=Value, 8=Lightness.
type ColorChannelKind
{
    Value: Integer;
}

// A distribution of one channel's pixel values. Counts holds the number of
// pixels per bin; the bins uniformly partition Range in order.
type ImageHistogram
    implements Value
{
    Channel: ColorChannelKind;
    Counts: Array<Integer>;
    Range: NumberInterval;
}

//==
// ## Tonal and color adjustments

// A monotone tone-mapping curve as control points in the unit square,
// smoothly interpolated: X is input level, Y is output level. Points ascend
// in X.
type ToneCurve
    implements Value
{
    Points: Array<Point2D>;
}

// A levels adjustment: input black/white points are remapped through a gamma
// (midtone) exponent onto output black/white points.
type LevelsAdjustment
    implements Value
{
    InputBlack: Number;
    InputWhite: Number;
    Gamma: Number;
    OutputBlack: Number;
    OutputWhite: Number;
}

// A curves adjustment: a master tone curve applied to all channels plus an
// independent curve per color channel.
type CurvesAdjustment
    implements Value
{
    Master: ToneCurve;
    Red: ToneCurve;
    Green: ToneCurve;
    Blue: ToneCurve;
}

// A linear color transform: each output RGBA is the matrix times the input
// RGBA plus Offset. Encodes saturation, channel mixing, sepia, and friends.
type ColorMatrixAdjustment
    implements Value
{
    Matrix: Matrix4x4;
    Offset: Vector4;
}

// A hue rotation with saturation scaling and lightness offset.
// SaturationScale of 1 and LightnessOffset of 0 leave those axes unchanged.
type HueSaturationAdjustment
    implements Value
{
    HueShift: Angle;
    SaturationScale: Number;
    LightnessOffset: Number;
}

// A white-balance correction toward a target illuminant: Temperature slides
// blue-orange, Tint slides green-magenta (0 is neutral).
type WhiteBalanceAdjustment
    implements Value
{
    Temperature: Temperature;
    Tint: Number;
}

// A brightness (additive) and contrast (scaling about mid-gray) adjustment;
// 0 brightness and 0 contrast is the identity.
type BrightnessContrastAdjustment
    implements Value
{
    Brightness: Number;
    Contrast: Number;
}

// An exposure adjustment in photographic stops: Stops multiplies linear light
// by two to that power; Offset lifts blacks; GammaCorrection bends midtones.
type ExposureAdjustment
    implements Value
{
    Stops: Number;
    Offset: Number;
    GammaCorrection: Number;
}

// A posterize adjustment: quantizes each channel to Levels evenly spaced
// values (Levels of 2 or more).
type PosterizeParameters
    implements Value
{
    Levels: Integer;
}

// A 3D color lookup table: a Size-cubed lattice of output colors indexed by
// input RGB. Colors holds Size cubed entries, red-fastest then green then
// blue; intermediate inputs interpolate trilinearly.
type ColorLookupTable
    implements Value
{
    Size: Integer;
    Colors: Array<Color>;
}

//==
// ## Compositing

// How a source color combines with a destination color when layered
// (Photoshop/CSS blend modes).
// Value meanings: 0=Normal, 1=Multiply, 2=Screen, 3=Overlay, 4=Darken,
// 5=Lighten, 6=ColorDodge, 7=ColorBurn, 8=HardLight, 9=SoftLight,
// 10=Difference, 11=Exclusion, 12=Hue, 13=Saturation, 14=Color,
// 15=Luminosity, 16=Add, 17=Subtract, 18=Divide.
type BlendModeKind
{
    Value: Integer;
}

// A Porter-Duff alpha-compositing operator: how source and destination
// coverage combine.
// Value meanings: 0=Clear, 1=Source, 2=Destination, 3=SourceOver,
// 4=DestinationOver, 5=SourceIn, 6=DestinationIn, 7=SourceOut,
// 8=DestinationOut, 9=SourceAtop, 10=DestinationAtop, 11=Xor, 12=Plus.
type PorterDuffKind
{
    Value: Integer;
}

//==
// ## Resampling, quantization, and lens effects

// A reconstruction filter used when resampling an image.
// Value meanings: 0=Nearest, 1=Bilinear, 2=Bicubic, 3=Lanczos2, 4=Lanczos3,
// 5=Mitchell, 6=CatmullRom, 7=Box.
type ResampleFilterKind
{
    Value: Integer;
}

// Resize settings. When PreserveAspect is true the image is fit within
// TargetSize keeping its aspect ratio; otherwise it stretches to fill.
type ResizeParameters
    implements Value
{
    TargetSize: IntegerSize2D;
    Filter: ResampleFilterKind;
    PreserveAspect: Boolean;
}

// A lossless pixel reorientation (the eight EXIF orientations).
// Value meanings: 0=Identity, 1=FlipHorizontal, 2=Rotate180, 3=FlipVertical,
// 4=Transpose, 5=Rotate90, 6=Transverse, 7=Rotate270.
type ImageOrientationKind
{
    Value: Integer;
}

// An error-diffusion or ordered-dithering pattern used when reducing color
// depth.
// Value meanings: 0=None, 1=Bayer2, 2=Bayer4, 3=Bayer8, 4=FloydSteinberg,
// 5=Atkinson, 6=BlueNoise, 7=WhiteNoise.
type DitherKind
{
    Value: Integer;
}

// Color-quantization settings: reduce an image to at most ColorCount palette
// entries, hiding banding with the chosen dither.
type QuantizeParameters
    implements Value
{
    ColorCount: Integer;
    Dither: DitherKind;
}

// Edge-preserving denoise settings: Strength sets how aggressively noise is
// removed within Radius, while PreserveDetail protects fine structure.
type DenoiseParameters
    implements Value
{
    Strength: Proportion;
    Radius: Integer;
    PreserveDetail: Proportion;
}

// A vignette: darkening toward the frame edges. Radius is where falloff
// begins (0 center, 1 corners); Softness widens the transition; Center is in
// normalized UV coordinates.
type VignetteParameters
    implements Value
{
    Strength: Proportion;
    Radius: Proportion;
    Softness: Proportion;
    Center: UvCoordinate;
}

// Chromatic aberration: radial separation of the color channels away from
// Center (normalized UV), Strength in pixels at the frame corner.
type ChromaticAberrationParameters
    implements Value
{
    Strength: Number;
    Center: UvCoordinate;
}
