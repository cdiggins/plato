//==
// # Vector styling
//
// How paths are painted: stroke geometry, dashing, solid and gradient paints,
// texture paints, markers, shadows, and the styled-path pairing of geometry
// with appearance. Consumes Path2D from file 40 and Color/ColorGradient from
// file 14; Texture2D is owned by file 47.

// The shape a stroke takes at the open end of a contour.
// Value meanings: 0=Butt (flat at the endpoint), 1=Round (semicircular cap),
// 2=Square (flat, extended past the endpoint by half the stroke width).
type LineCapKind
{
    Value: Integer;
}

// The shape a stroke takes where two segments meet at a corner.
// Value meanings: 0=Miter (sharp, subject to the miter limit), 1=Round,
// 2=Bevel.
type LineJoinKind
{
    Value: Integer;
}

// Where the stroke width sits relative to the path centerline.
// Value meanings: 0=Center (half each side), 1=Inside (toward the fill),
// 2=Outside.
type StrokeAlignKind
{
    Value: Integer;
}

// An on/off dash sequence applied along a stroked contour's arc length.
// Intervals alternate drawn and skipped lengths, starting with drawn, and
// repeat; an empty array means a solid stroke. Phase shifts the pattern's
// starting point along the contour, in the same units.
type DashPattern
    implements Value
{
    Intervals: Array<Number>;
    Phase: Number;
}

// The complete geometric description of how a path is stroked. Width is the
// total stroke width. MiterLimit caps a miter join's reach as a multiple of
// half the stroke width, as in SVG; joins beyond it fall back to bevel.
type StrokeStyle
    implements Value
{
    Width: Number;
    Cap: LineCapKind;
    Join: LineJoinKind;
    MiterLimit: Number;
    Dash: DashPattern;
    Align: StrokeAlignKind;
}

// How a gradient continues beyond its defining geometry.
// Value meanings: 0=Pad (clamp to the end colors), 1=Reflect (mirror
// repeat), 2=Repeat (tile).
type GradientSpreadKind
{
    Value: Integer;
}

// A gradient that varies linearly from Start to End, constant along lines
// perpendicular to the segment joining them.
type LinearGradient2D
    implements Value
{
    Start: Point2D;
    End: Point2D;
    Gradient: ColorGradient;
    Spread: GradientSpreadKind;
}

// A gradient that varies radially between a focal circle (Focus, FocusRadius)
// and an outer circle (Center, Radius), in the two-circle Canvas/Skia form.
// Focus equal to Center with FocusRadius zero gives the common single-circle
// case.
type RadialGradient2D
    implements Value
{
    Center: Point2D;
    Radius: Number;
    Focus: Point2D;
    FocusRadius: Number;
    Gradient: ColorGradient;
    Spread: GradientSpreadKind;
}

// A gradient that varies with angle around Center, starting at StartAngle and
// sweeping one full turn counter-clockwise.
type SweepGradient2D
    implements Value
{
    Center: Point2D;
    StartAngle: Angle;
    Gradient: ColorGradient;
    Spread: GradientSpreadKind;
}

// A paint sourced from a texture (file 47), positioned by an affine transform
// from texture space into the space of the geometry being filled.
type TexturePaint2D
    implements Value
{
    Texture: Texture2D;
    Transform: AffineTransform2D;
}

// The paint source a region is filled with: a single flat color, one of three
// gradient kinds, or a texture. Exactly one source applies per paint.
type Paint
    implements Value
    = Solid(Color: Color)                  // a single flat color
    | Linear(Gradient: LinearGradient2D)   // linear (axial) gradient
    | Radial(Gradient: RadialGradient2D)   // radial (two-circle) gradient
    | Sweep(Gradient: SweepGradient2D)     // angular sweep gradient
    | Texture(Paint: TexturePaint2D);      // a texture paint

// The complete description of how a region is painted: the paint source, and
// an Opacity that multiplies the chosen paint's alpha.
type FillStyle
    implements Value
{
    Paint: Paint;
    Opacity: Proportion;
}

// A small path stamped at positions along a host path: arrowheads, dots, SVG
// markers. The marker's own geometry is scaled to Size; ReferencePoint is the
// point in the marker's space that lands on the host path. When OrientToPath
// is true the marker rotates to follow the host path's tangent.
type PathMarker
    implements Value
{
    Path: Path2D;
    Size: Size2D;
    ReferencePoint: Vector2;
    OrientToPath: Boolean;
}

// A shadow cast by filled geometry: offset in the geometry's space, Gaussian
// blur radius, spread (outset applied before blurring; negative insets), and
// color including alpha.
type ShadowStyle2D
    implements Value
{
    Offset: Vector2;
    BlurRadius: Number;
    Spread: Number;
    Color: Color;
}

// A path paired with its appearance: fill first, then stroke on top. The
// canonical drawable unit of 2D vector graphics (see Scene2D in file 43).
type StyledPath2D
    implements Value
{
    Path: Path2D;
    Fill: FillStyle;
    Stroke: StrokeStyle;
}

// Controls for offsetting (insetting or outsetting) a path by a signed
// distance. Positive distances offset to the left of each contour's direction
// of travel, which expands counter-clockwise-wound closed contours. Join and
// MiterLimit shape the corners of the offset result; Cap shapes the ends of
// open contours.
type PathOffsetParameters
    implements Value
{
    Distance: Number;
    Join: LineJoinKind;
    MiterLimit: Number;
    Cap: LineCapKind;
}

// Controls for converting a dashed traversal of a path into concrete sub-path
// pieces (dash-to-path), one open contour per drawn interval of the pattern.
// Cap describes how the resulting pieces are intended to be terminated when
// stroked.
type PathDashParameters
    implements Value
{
    Pattern: DashPattern;
    Cap: LineCapKind;
}
