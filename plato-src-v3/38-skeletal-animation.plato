//==
// # Skeletal animation
//
// Bones, skeletons, poses, skinning, morph targets, and procedural constraints.
// Bones form a forest addressed by index into the owning skeleton's bone array;
// -1 is the "no bone" sentinel throughout. Poses are local: each bone's pose is
// expressed relative to its parent (roots relative to the model).

// A zero-based index of a bone within the owning skeleton's bone array.
// -1 means "no bone".
type BoneIndex
    implements Value, Hashable, Comparable, Index
{
    Value: Integer;
}

// A named node in a skeleton hierarchy. Parent indexes the owning skeleton's
// bone array; -1 marks a root. BindPose is the bone's rest pose relative to its
// parent (relative to the model for roots).
type Bone
    implements Value
{
    Name: String;
    Parent: BoneIndex;
    BindPose: Pose3D;
}

// An ordered array of bones forming a forest. Bones are topologically ordered:
// every bone's Parent index is less than its own index, so a single forward
// pass composes local poses into model space.
type Skeleton
    implements Value
{
    Bones: Array<Bone>;
}

// A full articulation of a skeleton: one local pose per bone, parallel to the
// owning skeleton's bone array. Composing along parent chains yields
// model-space poses.
type SkeletonPose
    implements Value
{
    LocalPoses: Array<Pose3D>;
}

// One bone's influence on a vertex: the bone's index in the skeleton and the
// blend weight of its transform.
type SkinWeight
    implements Value
{
    Bone: BoneIndex;
    Weight: Proportion;
}

// All bone influences on a single vertex. Weights sum to 1; renderers commonly
// keep the four largest.
type VertexSkinWeights
    implements Value
{
    Weights: Array<SkinWeight>;
}

// Binds a mesh to a skeleton for linear-blend skinning. InverseBindTransforms
// is parallel to the skeleton's bones and carries each bone's inverse
// model-space bind transform; VertexWeights is parallel to the mesh's vertices.
type SkinBinding
    implements Value
{
    Skeleton: Skeleton;
    InverseBindTransforms: Array<AffineTransform3D>;
    VertexWeights: Array<VertexSkinWeights>;
}

// A named blend-shape: per-vertex position and normal deltas added to the base
// mesh, scaled by the target's weight. Both delta arrays are parallel to the
// mesh's vertices; an empty NormalDeltas array means "positions only".
type MorphTarget
    implements Value
{
    Name: String;
    PositionDeltas: Array<Vector3>;
    NormalDeltas: Array<Vector3>;
}

// The activation weights of a mesh's morph targets, parallel to its target
// array. Weights are nominally in [0, 1]; values outside exaggerate or invert
// a target.
type MorphWeights
    implements Value
{
    Values: Array<Proportion>;
}

// The algorithm an inverse-kinematics chain is solved with.
// Value meanings: 0=TwoBone (analytic two-segment solve), 1=Ccd (cyclic
// coordinate descent), 2=Fabrik (forward-and-backward reaching).
type IkSolverKind
{
    Value: Integer;
}

// The goal of an inverse-kinematics solve: where the chain's end effector
// should be and how it should be oriented. The two weights blend the solved
// result over the input pose per goal component.
type IkTarget
    implements Value
{
    Position: Point3D;
    Orientation: Quaternion;
    PositionWeight: Proportion;
    OrientationWeight: Proportion;
}

// An inverse-kinematics chain: a run of bones solved so the last reaches the
// target. BoneIndices runs root-to-tip along a parent chain; PoleTarget pulls
// the chain's bend plane (elbow or knee direction); Iterations bounds the
// solver loop and Tolerance is the end-effector distance below which it stops
// early.
type IkChain
    implements Value
{
    BoneIndices: Array<BoneIndex>;
    Target: IkTarget;
    PoleTarget: Point3D;
    Solver: IkSolverKind;
    Iterations: Integer;
    Tolerance: Number;
}

// Aims one bone at a world-space target. Aim is the bone-local axis to point at
// the target; Up is the bone-local axis kept aligned to the world up to control
// roll. Weight blends the constrained result over the input pose.
type LookAtConstraint
    implements Value
{
    Bone: BoneIndex;
    Target: Point3D;
    Aim: Vector3;
    Up: Vector3;
    Weight: Proportion;
}

// Propagates a fraction of a source bone's twist about an axis onto another
// bone; used for forearm and neck twist distribution. Axis is expressed in the
// source bone's local space.
type TwistConstraint
    implements Value
{
    Bone: BoneIndex;
    SourceBone: BoneIndex;
    Axis: Vector3;
    Fraction: Proportion;
}

// Per-bone blend weights, parallel to the owning skeleton's bone array. Scales
// an animation layer's influence bone by bone (upper-body-only layers, fade-out
// at chain roots).
type BoneMask
    implements Value
{
    Weights: Array<Proportion>;
}

// Maps the bones of a source skeleton onto a target skeleton for animation
// retargeting. TargetBoneIndices is parallel to the source skeleton's bones;
// each entry is the corresponding target bone's index, or -1 when unmapped.
type RetargetMap
    implements Value
{
    TargetBoneIndices: Array<BoneIndex>;
}

// A named socket on a bone for attaching props and accessories. Offset places
// the socket relative to the bone.
type BoneSocket
    implements Value
{
    Name: String;
    Bone: BoneIndex;
    Offset: Pose3D;
}

// A skeletal animation clip: one transform track per bone, parallel to the
// target skeleton's bone array, plus trigger events. Track values are local
// (parent-relative) transforms.
type SkeletalClip
    implements Value
{
    Name: String;
    Duration: Duration;
    BoneTracks: Array<TransformTrack3D>;
    Events: Array<AnimationEvent>;
}
