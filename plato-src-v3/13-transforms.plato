//==
// # Transforms
//
// Rigid poses, TRS transforms, affine and projective maps, and coordinate frames.
// A transform maps points to points; concepts at the bottom mark types that can
// be carried through a transform.

// A rigid placement in the plane: position plus rotation. Also known as a 2D
// rigid transform.
type Pose2D
    implements Value, Interpolatable
{
    Position: Point2D;
    Rotation: Rotation2D;
}

// A rigid placement in space: position plus orientation. Also known as a 3D
// rigid transform; composition preserves distances and angles.
type Pose3D
    implements Value, Interpolatable
{
    Position: Point3D;
    Orientation: Quaternion;
}

// A translate-rotate-scale transform in 2D, applied scale first, then rotation,
// then translation.
type Transform2D
    implements Value
{
    Translation: Vector2D;
    Rotation: Rotation2D;
    Scale: Number2;
}

// A translate-rotate-scale transform in 3D, applied scale first, then rotation,
// then translation.
type Transform3D
    implements Value
{
    Translation: Vector3D;
    Rotation: Quaternion;
    Scale: Number3;
}

// A general 2D affine map: any composition of linear maps and translations.
type AffineTransform2D
    implements Value
{
    Matrix: Matrix3x2;
}

// A general 3D affine map: any composition of linear maps and translations.
type AffineTransform3D
    implements Value
{
    Matrix: Matrix4x3;
}

// A full 2D projective map (homography), operating on homogeneous coordinates.
type ProjectiveTransform2D
    implements Value
{
    Matrix: Matrix3x3;
}

// A full 3D projective map, operating on homogeneous coordinates; includes
// perspective projections.
type ProjectiveTransform3D
    implements Value
{
    Matrix: Matrix4x4;
}

// An orthonormal coordinate frame in the plane: an origin and two perpendicular
// unit axes.
type Frame2D
    implements Value
{
    Origin: Point2D;
    XAxis: Direction2D;
    YAxis: Direction2D;
}

// An orthonormal coordinate frame in space: an origin and three mutually
// perpendicular unit axes.
type Frame3D
    implements Value
{
    Origin: Point3D;
    XAxis: Direction3D;
    YAxis: Direction3D;
    ZAxis: Direction3D;
}

// Three basis vectors in 3D; not necessarily orthonormal.
type Basis3D
    implements Value
{
    X: Vector3D;
    Y: Vector3D;
    Z: Vector3D;
}

// A rigid motion (rotation plus translation) as a geometric-algebra motor,
// stored in dual-quaternion form: Real is the rotation, Dual encodes the
// translation as Dual = 0.5 * t * Real, where t is the translation as a pure
// quaternion. Unit dual quaternions are isomorphic to the motors of 3D PGA.
// https://en.wikipedia.org/wiki/Dual_quaternion
type Motor3D
    implements Value, Multiplicative
{
    Real: Quaternion;
    Dual: Quaternion;
}

// Can be carried through a transform of type TTransform, yielding a new Self.
concept Transformable<TTransform>
{
    Transform(x: Self, transform: TTransform): Self;
}

// Can be deformed by an arbitrary 2D point mapping.
concept Deformable2D
{
    Deform(x: Self, mapping: Function1<Point2D, Point2D>): Self;
}

// Can be deformed by an arbitrary 3D point mapping.
concept Deformable3D
{
    Deform(x: Self, mapping: Function1<Point3D, Point3D>): Self;
}

//==
// # Transform operations
//
// Conversions between every transform representation, application to points and
// vectors (`p.Transform(t)`), composition, inverses, and identity statics.
//
// Conventions used throughout:
// - Matrices are row-vector style (v * M), matching System.Numerics: the product
//   a.Multiply(b) applies a first, then b.
// - Quaternion Multiply is the Hamilton product (a.Multiply(b) applies b first);
//   Concatenate(a, b) applies a first, then b. Rotors and motors follow the
//   quaternion convention through their isomorphisms.
// - Compose(first, second) means "apply first, then second" on EVERY type, so
//   users never need to remember which product order a representation uses.
// - A function named after a type is a conversion; each is total on its stated
//   precondition (e.g. Pose3D(Matrix4x4) requires a rigid matrix).
// - EulerAngles: Yaw is about Y, Pitch about X, Roll about Z; RotationOrder
//   lists the axes in application order (first-applied first), about fixed
//   world axes.

library Transforms
{
    //==
    // Point support — the Difference obligations of Point2D/Point3D (Between
    // follows the b - a convention assumed by IntervalsTransforms), linear
    // interpolation, and explicit point <-> vector converters. These are
    // deliberately named (ToPoint / PositionVector) rather than implicit
    // conversions: silently coercing between positions and displacements would
    // defeat the point of keeping them distinct types.

    // The point displaced by delta.
    Add(p: Point2D, delta: Vector2D): Point2D
        => (p.X + delta.X, p.Y + delta.Y);

    // The point displaced by the negation of delta.
    Subtract(p: Point2D, delta: Vector2D): Point2D
        => (p.X - delta.X, p.Y - delta.Y);

    // The displacement from a to b (b - a).
    Between(a: Point2D, b: Point2D): Vector2D
        => (b.X - a.X, b.Y - a.Y);

    // Linear interpolation between two points; t is unclamped.
    Lerp(a: Point2D, b: Point2D, t: Number): Point2D
        => (a.X + (b.X - a.X) * t, a.Y + (b.Y - a.Y) * t);

    // The point displaced by delta.
    Add(p: Point3D, delta: Vector3D): Point3D
        => (p.X + delta.X, p.Y + delta.Y, p.Z + delta.Z);

    // The point displaced by the negation of delta.
    Subtract(p: Point3D, delta: Vector3D): Point3D
        => (p.X - delta.X, p.Y - delta.Y, p.Z - delta.Z);

    // The displacement from a to b (b - a).
    Between(a: Point3D, b: Point3D): Vector3D
        => (b.X - a.X, b.Y - a.Y, b.Z - a.Z);

    // Linear interpolation between two points; t is unclamped.
    Lerp(a: Point3D, b: Point3D, t: Number): Point3D
        => (a.X + (b.X - a.X) * t, a.Y + (b.Y - a.Y) * t, a.Z + (b.Z - a.Z) * t);

    // The point's displacement from the origin.
    PositionVector(p: Point2D): Vector2D
        => (p.X, p.Y);

    // The point's displacement from the origin.
    PositionVector(p: Point3D): Vector3D
        => (p.X, p.Y, p.Z);

    // The point at the tip of the vector, placed from the origin.
    ToPoint(v: Vector2D): Point2D
        => (v.X, v.Y);

    // The point at the tip of the vector, placed from the origin.
    ToPoint(v: Vector3D): Point3D
        => (v.X, v.Y, v.Z);

    //==
    // Identity statics — the do-nothing transform of each representation,
    // reachable as `Type.Identity` via the `_: Type` static convention.

    // The zero rotation.
    Identity(_: Rotation2D): Rotation2D
        => Rotation2D(0.0.Angle);

    // The identity rotor (scalar 1, no bivector part).
    Identity(_: Rotor2D): Rotor2D
        => (1.0, 0.0);

    // The identity quaternion (0, 0, 0, 1).
    Identity(_: Quaternion): Quaternion
        => (0.0, 0.0, 0.0, 1.0);

    // The identity rotor (scalar 1, no bivector part).
    Identity(_: Rotor3D): Rotor3D
        => (1.0, Bivector3D(0.0, 0.0, 0.0));

    // The identity motor (identity rotation, zero translation).
    Identity(_: Motor3D): Motor3D
        => (Quaternion.Identity, Quaternion(0.0, 0.0, 0.0, 0.0));

    // The pose at the origin with no rotation.
    Identity(_: Pose2D): Pose2D
        => (Point2D(0.0, 0.0), Rotation2D.Identity);

    // The pose at the origin with no rotation.
    Identity(_: Pose3D): Pose3D
        => (Point3D(0.0, 0.0, 0.0), Quaternion.Identity);

    // The TRS transform that leaves everything unchanged.
    Identity(_: Transform2D): Transform2D
        => (Vector2D(0.0, 0.0), Rotation2D.Identity, Number2(1.0, 1.0));

    // The TRS transform that leaves everything unchanged.
    Identity(_: Transform3D): Transform3D
        => (Vector3D(0.0, 0.0, 0.0), Quaternion.Identity, Number3(1.0, 1.0, 1.0));

    // The identity 2D affine map.
    Identity(_: Matrix3x2): Matrix3x2
        => (Number2(1.0, 0.0), Number2(0.0, 1.0), Number2(0.0, 0.0));

    // The identity 3x3 matrix.
    Identity(_: Matrix3x3): Matrix3x3
        => (Number3(1.0, 0.0, 0.0), Number3(0.0, 1.0, 0.0), Number3(0.0, 0.0, 1.0));

    // The identity 3D affine map.
    Identity(_: Matrix4x3): Matrix4x3
        => (Number3(1.0, 0.0, 0.0), Number3(0.0, 1.0, 0.0), Number3(0.0, 0.0, 1.0), Number3(0.0, 0.0, 0.0));

    // The identity 4x4 matrix.
    Identity(_: Matrix4x4): Matrix4x4
        => (Number4(1.0, 0.0, 0.0, 0.0), Number4(0.0, 1.0, 0.0, 0.0), Number4(0.0, 0.0, 1.0, 0.0), Number4(0.0, 0.0, 0.0, 1.0));

    // The identity 2D affine transform.
    Identity(_: AffineTransform2D): AffineTransform2D
        => AffineTransform2D(Matrix3x2.Identity);

    // The identity 3D affine transform.
    Identity(_: AffineTransform3D): AffineTransform3D
        => AffineTransform3D(Matrix4x3.Identity);

    // The identity 2D projective transform.
    Identity(_: ProjectiveTransform2D): ProjectiveTransform2D
        => ProjectiveTransform2D(Matrix3x3.Identity);

    // The identity 3D projective transform.
    Identity(_: ProjectiveTransform3D): ProjectiveTransform3D
        => ProjectiveTransform3D(Matrix4x4.Identity);

    //==
    // 2D rotations — Rotation2D is the angle form, Rotor2D the geometric-algebra
    // form (a unit complex number built from the half angle).
    // https://en.wikipedia.org/wiki/Rotation_matrix

    // Composition of two plane rotations: angles add (2D rotations commute).
    Multiply(a: Rotation2D, b: Rotation2D): Rotation2D
        => Rotation2D(a.Angle + b.Angle);

    // The opposite rotation.
    Inverse(a: Rotation2D): Rotation2D
        => Rotation2D(-a.Angle);

    // Linear interpolation of the stored angles; t is unclamped. Takes the
    // stored-angle path, not the shortest arc: interpolate raw angles when the
    // operands differ by more than a half turn.
    Lerp(a: Rotation2D, b: Rotation2D, t: Number): Rotation2D
        => Rotation2D(a.Angle + (b.Angle - a.Angle) * t);

    // Rotate a displacement counter-clockwise by the rotation's angle:
    // (x cos - y sin, x sin + y cos).
    Transform(v: Vector2D, r: Rotation2D): Vector2D {
        var c = r.Angle.Cos;
        var s = r.Angle.Sin;
        return (v.X * c - v.Y * s, v.X * s + v.Y * c);
    }

    // Rotate a point about the origin.
    Transform(p: Point2D, r: Rotation2D): Point2D
        => p.PositionVector.Transform(r).ToPoint;

    // Rotate a unit direction.
    Transform(d: Direction2D, r: Rotation2D): Direction2D
        => Direction2D(d.Vector.Transform(r));

    // The rotor of a plane rotation: R = cos(a/2) + sin(a/2) e12.
    // https://en.wikipedia.org/wiki/Rotor_(mathematics)
    Rotor2D(r: Rotation2D): Rotor2D {
        var h = r.Angle * 0.5;
        return (h.Cos, h.Sin);
    }

    // The angle form of a rotor (twice the half angle stored in the rotor).
    Rotation2D(r: Rotor2D): Rotation2D
        => Rotation2D(r.XY.Atan2(r.Scalar) * 2.0);

    // The geometric product of two rotors (complex multiplication); the result
    // rotates by the sum of the operands' angles.
    Multiply(a: Rotor2D, b: Rotor2D): Rotor2D
        => (a.Scalar * b.Scalar - a.XY * b.XY, a.Scalar * b.XY + a.XY * b.Scalar);

    // The reverse of the rotor: the opposite rotation (for a unit rotor the
    // reverse is the inverse).
    Inverse(r: Rotor2D): Rotor2D
        => (r.Scalar, -r.XY);

    // Rescale to unit magnitude, restoring the rotor invariant after repeated
    // products. Precondition: the rotor is not the zero element.
    Normalize(r: Rotor2D): Rotor2D {
        var m = (r.Scalar.Square + r.XY.Square).Sqrt;
        return (r.Scalar / m, r.XY / m);
    }

    // Apply the rotor's sandwich product R v ~R: a rotation by the full angle,
    // via the double-angle identities cos a = s^2 - b^2, sin a = 2 s b.
    Transform(v: Vector2D, r: Rotor2D): Vector2D {
        var c = r.Scalar.Square - r.XY.Square;
        var s = 2.0 * r.Scalar * r.XY;
        return (v.X * c - v.Y * s, v.X * s + v.Y * c);
    }

    // Rotate a point about the origin with a rotor.
    Transform(p: Point2D, r: Rotor2D): Point2D
        => p.PositionVector.Transform(r).ToPoint;

    //==
    // 3D rotation conversions — Quaternion is the hub: every other rotation
    // representation converts to and from it, so all pairs compose through it.
    // https://en.wikipedia.org/wiki/Quaternions_and_spatial_rotation

    // The elemental rotation about the world X axis.
    CreateRotationX(_: Quaternion, angle: Angle): Quaternion
        => Quaternion.CreateFromAxisAngle(Vector3D(1.0, 0.0, 0.0), angle);

    // The elemental rotation about the world Y axis.
    CreateRotationY(_: Quaternion, angle: Angle): Quaternion
        => Quaternion.CreateFromAxisAngle(Vector3D(0.0, 1.0, 0.0), angle);

    // The elemental rotation about the world Z axis.
    CreateRotationZ(_: Quaternion, angle: Angle): Quaternion
        => Quaternion.CreateFromAxisAngle(Vector3D(0.0, 0.0, 1.0), angle);

    // The quaternion of an axis-angle rotation.
    // https://en.wikipedia.org/wiki/Axis%E2%80%93angle_representation
    Quaternion(aa: AxisAngle): Quaternion
        => Quaternion.CreateFromAxisAngle(aa.Axis.Vector, aa.Angle);

    // The axis-angle form of a quaternion: angle = 2 acos(w), axis = the
    // normalized vector part. Near the identity the axis is arbitrary and the
    // world X axis is returned.
    AxisAngle(q: Quaternion): AxisAngle {
        var n = q.Normalize;
        var s = (1.0 - n.W.Square).Max(0.0).Sqrt;
        var axis = s < 0.000001
            ? Vector3D(1.0, 0.0, 0.0)
            : Vector3D(n.X / s, n.Y / s, n.Z / s);
        return (Direction3D(axis), n.W.Clamp(-1.0, 1.0).Acos * 2.0);
    }

    // The quaternion of chained elemental rotations, honoring the explicit
    // application order (the first-listed axis applies first, about fixed
    // world axes). X carries Pitch, Y carries Yaw, Z carries Roll.
    Quaternion(e: EulerAngles): Quaternion {
        var aboutX = Quaternion.CreateRotationX(e.Pitch);
        var aboutY = Quaternion.CreateRotationY(e.Yaw);
        var aboutZ = Quaternion.CreateRotationZ(e.Roll);
        return match (e.Order) {
            XYZ => aboutX.Concatenate(aboutY).Concatenate(aboutZ);
            XZY => aboutX.Concatenate(aboutZ).Concatenate(aboutY);
            YXZ => aboutY.Concatenate(aboutX).Concatenate(aboutZ);
            YZX => aboutY.Concatenate(aboutZ).Concatenate(aboutX);
            ZXY => aboutZ.Concatenate(aboutX).Concatenate(aboutY);
            ZYX => aboutZ.Concatenate(aboutY).Concatenate(aboutX);
        };
    }

    // The yaw-pitch-roll decomposition of a quaternion, in ZXY order (roll,
    // then pitch, then yaw — the order CreateFromYawPitchRoll applies). At the
    // gimbal-lock poles (pitch = +-90 degrees) yaw and roll are not unique.
    // https://en.wikipedia.org/wiki/Conversion_between_quaternions_and_Euler_angles
    EulerAngles(q: Quaternion): EulerAngles {
        var n = q.Normalize;
        var pitch = (2.0 * (n.W * n.X - n.Y * n.Z)).Clamp(-1.0, 1.0).Asin;
        var yaw = (2.0 * (n.X * n.Z + n.W * n.Y)).Atan2(1.0 - 2.0 * (n.X.Square + n.Y.Square));
        var roll = (2.0 * (n.X * n.Y + n.W * n.Z)).Atan2(1.0 - 2.0 * (n.X.Square + n.Z.Square));
        return (yaw, pitch, roll, RotationOrder.ZXY);
    }

    // The quaternion of a rotor, under the isomorphism (w, x, y, z) =
    // (Scalar, YZ, ZX, XY): each bivector plane maps to the quaternion unit
    // whose axis is perpendicular to it.
    Quaternion(r: Rotor3D): Quaternion
        => (r.Bivector.YZ, r.Bivector.ZX, r.Bivector.XY, r.Scalar);

    // The rotor of a quaternion (the inverse of the isomorphism above).
    Rotor3D(q: Quaternion): Rotor3D
        => (q.W, Bivector3D(q.X, q.Y, q.Z));

    // The rotor of an axis-angle rotation.
    Rotor3D(aa: AxisAngle): Rotor3D
        => aa.Quaternion.Rotor3D;

    // The geometric product of two rotors: the image of the Hamilton product
    // under the quaternion isomorphism, so a.Multiply(b) applies b first.
    Multiply(a: Rotor3D, b: Rotor3D): Rotor3D
        => a.Quaternion.Multiply(b.Quaternion).Rotor3D;

    // The reverse of the rotor: the opposite rotation (for a unit rotor the
    // reverse is the inverse).
    Inverse(r: Rotor3D): Rotor3D
        => (r.Scalar, Bivector3D(-r.Bivector.YZ, -r.Bivector.ZX, -r.Bivector.XY));

    // Rescale to unit magnitude, restoring the rotor invariant after repeated
    // products.
    Normalize(r: Rotor3D): Rotor3D
        => r.Quaternion.Normalize.Rotor3D;

    // Apply the rotor's sandwich product R v ~R.
    Transform(v: Vector3D, r: Rotor3D): Vector3D
        => v.Transform(r.Quaternion);

    // Rotate a point about the origin with a rotor.
    Transform(p: Point3D, r: Rotor3D): Point3D
        => p.PositionVector.Transform(r.Quaternion).ToPoint;

    // Rotate a point about the origin with a quaternion.
    Transform(p: Point3D, q: Quaternion): Point3D
        => p.PositionVector.Transform(q).ToPoint;

    // Rotate a unit direction.
    Transform(d: Direction3D, q: Quaternion): Direction3D
        => Direction3D(d.Vector.Transform(q));

    //==
    // Rotation matrices — 2D rotations embed in Matrix3x2, 3D rotations in
    // Matrix4x4. https://en.wikipedia.org/wiki/Rotation_matrix

    // The affine matrix of a plane rotation about the origin.
    Matrix3x2(r: Rotation2D): Matrix3x2
        => Matrix3x2.CreateRotation(r.Angle);

    // The affine matrix of a rotor's rotation.
    Matrix3x2(r: Rotor2D): Matrix3x2
        => r.Rotation2D.Matrix3x2;

    // The homogeneous matrix of a quaternion's rotation.
    Matrix4x4(q: Quaternion): Matrix4x4
        => Matrix4x4.CreateFromQuaternion(q);

    // The quaternion of a rotation matrix. Precondition: the upper 3x3 block
    // is orthonormal (a pure rotation, no scale or shear).
    Quaternion(m: Matrix4x4): Quaternion
        => Quaternion.CreateFromRotationMatrix(m);

    // The homogeneous matrix of an axis-angle rotation.
    Matrix4x4(aa: AxisAngle): Matrix4x4
        => Matrix4x4.CreateFromAxisAngle(aa.Axis.Vector, aa.Angle);

    // The homogeneous matrix of chained elemental rotations.
    Matrix4x4(e: EulerAngles): Matrix4x4
        => e.Quaternion.Matrix4x4;

    // The homogeneous matrix of a rotor's rotation.
    Matrix4x4(r: Rotor3D): Matrix4x4
        => r.Quaternion.Matrix4x4;

    //==
    // Rigid poses — position plus rotation; the natural "where is this object"
    // transform. https://en.wikipedia.org/wiki/Rigid_transformation

    // Apply the pose: rotate about the origin, then translate to Position.
    Transform(p: Point2D, pose: Pose2D): Point2D
        => pose.Position.Add(p.PositionVector.Transform(pose.Rotation));

    // Rotate a displacement by the pose's rotation (translation does not act
    // on vectors).
    Transform(v: Vector2D, pose: Pose2D): Vector2D
        => v.Transform(pose.Rotation);

    // The pose that applies `first`, then `second`.
    Compose(first: Pose2D, second: Pose2D): Pose2D
        => (first.Position.Transform(second), first.Rotation.Multiply(second.Rotation));

    // The pose that undoes this one: p' = R^-1 (p - t).
    Inverse(pose: Pose2D): Pose2D {
        var invRot = pose.Rotation.Inverse;
        return (pose.Position.PositionVector.Negative.Transform(invRot).ToPoint, invRot);
    }

    // Interpolate position and rotation independently; t is unclamped.
    Lerp(a: Pose2D, b: Pose2D, t: Number): Pose2D
        => (a.Position.Lerp(b.Position, t), a.Rotation.Lerp(b.Rotation, t));

    // The affine matrix of the pose (rotation, then translation).
    Matrix3x2(pose: Pose2D): Matrix3x2
        => pose.Rotation.Matrix3x2.Multiply(Matrix3x2.CreateTranslation(pose.Position.PositionVector));

    // The pose stored in a rigid affine matrix. Precondition: the matrix is a
    // rotation followed by a translation (no scale, shear, or reflection).
    Pose2D(m: Matrix3x2): Pose2D
        => (Point2D(m.Row3.X, m.Row3.Y), Rotation2D(m.Row1.Y.Atan2(m.Row1.X)));

    // Apply the pose: rotate about the origin, then translate to Position.
    Transform(p: Point3D, pose: Pose3D): Point3D
        => pose.Position.Add(p.PositionVector.Transform(pose.Orientation));

    // Rotate a displacement by the pose's orientation.
    Transform(v: Vector3D, pose: Pose3D): Vector3D
        => v.Transform(pose.Orientation);

    // The pose that applies `first`, then `second`.
    Compose(first: Pose3D, second: Pose3D): Pose3D
        => (first.Position.Transform(second), first.Orientation.Concatenate(second.Orientation));

    // The pose that undoes this one: p' = R^-1 (p - t).
    Inverse(pose: Pose3D): Pose3D {
        var invQ = pose.Orientation.Inverse;
        return (pose.Position.PositionVector.Negative.Transform(invQ).ToPoint, invQ);
    }

    // Interpolate position linearly and orientation spherically; t is unclamped.
    Lerp(a: Pose3D, b: Pose3D, t: Number): Pose3D
        => (a.Position.Lerp(b.Position, t), a.Orientation.Slerp(b.Orientation, t));

    // The homogeneous matrix of the pose (rotation, then translation).
    Matrix4x4(pose: Pose3D): Matrix4x4
        => pose.Orientation.Matrix4x4.Multiply(Matrix4x4.CreateTranslation(pose.Position.PositionVector));

    // The pose stored in a rigid homogeneous matrix. Precondition: the matrix
    // is a rotation followed by a translation (no scale, shear, or projection).
    Pose3D(m: Matrix4x4): Pose3D
        => (m.Translation.ToPoint, m.Rotation);

    //==
    // TRS transforms — scale, then rotate, then translate. Not closed under
    // composition (rotating a non-uniform scale leaves the TRS family), so
    // compose them through their matrix or affine forms.

    // Apply the transform: scale, rotate, then translate.
    Transform(p: Point2D, t: Transform2D): Point2D
        => p.PositionVector.Multiply(t.Scale).Transform(t.Rotation).Add(t.Translation).ToPoint;

    // Apply the scale and rotation to a displacement (translation does not act
    // on vectors).
    Transform(v: Vector2D, t: Transform2D): Vector2D
        => v.Multiply(t.Scale).Transform(t.Rotation);

    // The affine matrix of the transform: S * R * T in row-vector order.
    Matrix3x2(t: Transform2D): Matrix3x2
        => Matrix3x2.CreateScale(t.Scale).Multiply(t.Rotation.Matrix3x2).Multiply(Matrix3x2.CreateTranslation(t.Translation));

    // A rigid pose widened to a TRS transform with unit scale.
    Transform2D(pose: Pose2D): Transform2D
        => (pose.Position.PositionVector, pose.Rotation, Number2(1.0, 1.0));

    // The rigid part of the transform, discarding scale. Named Pose rather
    // than Pose2D because the conversion is lossy and must stay explicit.
    Pose(t: Transform2D): Pose2D
        => (t.Translation.ToPoint, t.Rotation);

    // Apply the transform: scale, rotate, then translate.
    Transform(p: Point3D, t: Transform3D): Point3D
        => p.PositionVector.Multiply(t.Scale).Transform(t.Rotation).Add(t.Translation).ToPoint;

    // Apply the scale and rotation to a displacement.
    Transform(v: Vector3D, t: Transform3D): Vector3D
        => v.Multiply(t.Scale).Transform(t.Rotation);

    // The homogeneous matrix of the transform: S * R * T in row-vector order.
    Matrix4x4(t: Transform3D): Matrix4x4
        => Matrix4x4.CreateScale(t.Scale).Multiply(t.Rotation.Matrix4x4).Multiply(Matrix4x4.CreateTranslation(t.Translation));

    // The TRS decomposition of a matrix. Precondition: the matrix is a
    // scale-rotate-translate composition (Decompose succeeds); shear and
    // projection are not representable.
    Transform3D(m: Matrix4x4): Transform3D {
        var d = m.Decompose;
        return (d.X2, d.X1, d.X0);
    }

    // A rigid pose widened to a TRS transform with unit scale.
    Transform3D(pose: Pose3D): Transform3D
        => (pose.Position.PositionVector, pose.Orientation, Number3(1.0, 1.0, 1.0));

    // The rigid part of the transform, discarding scale. Named Pose rather
    // than Pose3D because the conversion is lossy and must stay explicit.
    Pose(t: Transform3D): Pose3D
        => (t.Translation.ToPoint, t.Rotation);

    //==
    // Affine transforms — the general linear-plus-translation maps; the common
    // ground every 2D/3D transform above converts into, and the right place to
    // compose mixed transform kinds.
    // https://en.wikipedia.org/wiki/Affine_transformation

    // Apply the affine map to a point (includes the translation row).
    Transform(p: Point2D, a: AffineTransform2D): Point2D
        => p.PositionVector.Transform(a.Matrix).ToPoint;

    // Apply the linear part to a displacement (translation does not act on
    // vectors).
    Transform(v: Vector2D, a: AffineTransform2D): Vector2D
        => v.TransformNormal(a.Matrix);

    // The affine transform that applies `first`, then `second` (row-vector
    // matrix product).
    Compose(first: AffineTransform2D, second: AffineTransform2D): AffineTransform2D
        => AffineTransform2D(first.Matrix.Multiply(second.Matrix));

    // Alias for Compose, enabling the * operator: a * b applies a first.
    Multiply(a: AffineTransform2D, b: AffineTransform2D): AffineTransform2D
        => a.Compose(b);

    // The inverse map. Precondition: CanInvert (a non-zero determinant).
    Inverse(a: AffineTransform2D): AffineTransform2D
        => AffineTransform2D(a.Matrix.Invert.X0);

    // True when the affine map is invertible (non-zero determinant).
    CanInvert(a: AffineTransform2D): Boolean
        => a.Matrix.Invert.X1;

    // Any TRS transform is affine.
    AffineTransform2D(t: Transform2D): AffineTransform2D
        => AffineTransform2D(t.Matrix3x2);

    // Any rigid pose is affine.
    AffineTransform2D(pose: Pose2D): AffineTransform2D
        => AffineTransform2D(pose.Matrix3x2);

    // Any plane rotation is affine.
    AffineTransform2D(r: Rotation2D): AffineTransform2D
        => AffineTransform2D(r.Matrix3x2);

    // The 3D affine matrix widened to homogeneous form (fourth column 0,0,0,1).
    Matrix4x4(a: AffineTransform3D): Matrix4x4 {
        var m = a.Matrix;
        return (Number4(m.Row1.X, m.Row1.Y, m.Row1.Z, 0.0),
                Number4(m.Row2.X, m.Row2.Y, m.Row2.Z, 0.0),
                Number4(m.Row3.X, m.Row3.Y, m.Row3.Z, 0.0),
                Number4(m.Row4.X, m.Row4.Y, m.Row4.Z, 1.0));
    }

    // The affine part of a homogeneous matrix. Precondition: the matrix has no
    // projective component (its fourth column is 0, 0, 0, 1).
    AffineTransform3D(m: Matrix4x4): AffineTransform3D
        => AffineTransform3D(Matrix4x3(
            Number3(m.Row1.X, m.Row1.Y, m.Row1.Z),
            Number3(m.Row2.X, m.Row2.Y, m.Row2.Z),
            Number3(m.Row3.X, m.Row3.Y, m.Row3.Z),
            Number3(m.Row4.X, m.Row4.Y, m.Row4.Z)));

    // Apply the affine map to a point: row-vector product
    // p' = x Row1 + y Row2 + z Row3 + Row4.
    Transform(p: Point3D, a: AffineTransform3D): Point3D {
        var m = a.Matrix;
        var v = m.Row1.Multiply(p.X).Add(m.Row2.Multiply(p.Y)).Add(m.Row3.Multiply(p.Z)).Add(m.Row4);
        return (v.X, v.Y, v.Z);
    }

    // Apply the linear part to a displacement (the translation row is skipped).
    Transform(v: Vector3D, a: AffineTransform3D): Vector3D {
        var m = a.Matrix;
        var r = m.Row1.Multiply(v.X).Add(m.Row2.Multiply(v.Y)).Add(m.Row3.Multiply(v.Z));
        return (r.X, r.Y, r.Z);
    }

    // The affine transform that applies `first`, then `second`, computed
    // through the homogeneous forms.
    Compose(first: AffineTransform3D, second: AffineTransform3D): AffineTransform3D
        => first.Matrix4x4.Multiply(second.Matrix4x4).AffineTransform3D;

    // Alias for Compose, enabling the * operator: a * b applies a first.
    Multiply(a: AffineTransform3D, b: AffineTransform3D): AffineTransform3D
        => a.Compose(b);

    // The inverse map. Precondition: CanInvert (a non-zero determinant).
    Inverse(a: AffineTransform3D): AffineTransform3D
        => a.Matrix4x4.Invert.AffineTransform3D;

    // True when the affine map is invertible (non-zero determinant).
    CanInvert(a: AffineTransform3D): Boolean
        => a.Matrix4x4.CanInvert;

    // Any TRS transform is affine.
    AffineTransform3D(t: Transform3D): AffineTransform3D
        => t.Matrix4x4.AffineTransform3D;

    // Any rigid pose is affine.
    AffineTransform3D(pose: Pose3D): AffineTransform3D
        => pose.Matrix4x4.AffineTransform3D;

    // Any quaternion rotation is affine.
    AffineTransform3D(q: Quaternion): AffineTransform3D
        => q.Matrix4x4.AffineTransform3D;

    //==
    // Projective transforms — full homographies on homogeneous coordinates;
    // the widest transform family here, closed under composition.
    // https://en.wikipedia.org/wiki/Homography

    // The product of two 3x3 matrices (row times column). Also discharges the
    // Multiplicative obligation on Matrix3x3.
    Multiply(a: Matrix3x3, b: Matrix3x3): Matrix3x3 {
        var c1 = Number3(b.Row1.X, b.Row2.X, b.Row3.X);
        var c2 = Number3(b.Row1.Y, b.Row2.Y, b.Row3.Y);
        var c3 = Number3(b.Row1.Z, b.Row2.Z, b.Row3.Z);
        return (Number3(a.Row1.Dot(c1), a.Row1.Dot(c2), a.Row1.Dot(c3)),
                Number3(a.Row2.Dot(c1), a.Row2.Dot(c2), a.Row2.Dot(c3)),
                Number3(a.Row3.Dot(c1), a.Row3.Dot(c2), a.Row3.Dot(c3)));
    }

    // Any 2D affine map is projective (third column becomes 0, 0, 1).
    ProjectiveTransform2D(a: AffineTransform2D): ProjectiveTransform2D {
        var m = a.Matrix;
        return ProjectiveTransform2D(Matrix3x3(
            Number3(m.Row1.X, m.Row1.Y, 0.0),
            Number3(m.Row2.X, m.Row2.Y, 0.0),
            Number3(m.Row3.X, m.Row3.Y, 1.0)));
    }

    // Apply the homography: lift to homogeneous coordinates, map, and divide
    // by the resulting weight. Precondition: the point is not mapped onto the
    // line at infinity (weight is non-zero).
    Transform(p: Point2D, t: ProjectiveTransform2D): Point2D {
        var m = t.Matrix;
        var v = m.Row1.Multiply(p.X).Add(m.Row2.Multiply(p.Y)).Add(m.Row3);
        return (v.X / v.Z, v.Y / v.Z);
    }

    // The homography that applies `first`, then `second` (row-vector product).
    Compose(first: ProjectiveTransform2D, second: ProjectiveTransform2D): ProjectiveTransform2D
        => ProjectiveTransform2D(first.Matrix.Multiply(second.Matrix));

    // Alias for Compose, enabling the * operator: a * b applies a first.
    Multiply(a: ProjectiveTransform2D, b: ProjectiveTransform2D): ProjectiveTransform2D
        => a.Compose(b);

    // Any 3D affine map is projective.
    ProjectiveTransform3D(a: AffineTransform3D): ProjectiveTransform3D
        => ProjectiveTransform3D(a.Matrix4x4);

    // Apply the homography: lift to homogeneous coordinates, map, and divide
    // by the resulting weight. Precondition: the point is not mapped onto the
    // plane at infinity (weight is non-zero).
    Transform(p: Point3D, t: ProjectiveTransform3D): Point3D {
        var v = Number4(p.X, p.Y, p.Z, 1.0).Transform(t.Matrix);
        return (v.X / v.W, v.Y / v.W, v.Z / v.W);
    }

    // The homography that applies `first`, then `second` (row-vector product).
    Compose(first: ProjectiveTransform3D, second: ProjectiveTransform3D): ProjectiveTransform3D
        => ProjectiveTransform3D(first.Matrix.Multiply(second.Matrix));

    // Alias for Compose, enabling the * operator: a * b applies a first.
    Multiply(a: ProjectiveTransform3D, b: ProjectiveTransform3D): ProjectiveTransform3D
        => a.Compose(b);

    //==
    // Motors — rigid motions in dual-quaternion form. Real carries the
    // rotation; Dual = 0.5 * t * Real carries the translation t (all products
    // Hamilton). https://en.wikipedia.org/wiki/Dual_quaternion

    // The motor of a rigid pose.
    Motor3D(pose: Pose3D): Motor3D {
        var q = pose.Orientation;
        var t = Quaternion(pose.Position.X, pose.Position.Y, pose.Position.Z, 0.0);
        return (q, t.Multiply(q).Multiply(0.5));
    }

    // The pose of a motor: rotation from the real part, translation
    // t = 2 * Dual * conjugate(Real).
    Pose3D(m: Motor3D): Pose3D {
        var q = m.Real.Normalize;
        var t = m.Dual.Multiply(2.0).Multiply(q.Conjugate);
        return (Point3D(t.X, t.Y, t.Z), q);
    }

    // A pure rotation as a motor (zero translation).
    Motor3D(q: Quaternion): Motor3D
        => (q, Quaternion(0.0, 0.0, 0.0, 0.0));

    // A rotor's rotation as a motor.
    Motor3D(r: Rotor3D): Motor3D
        => r.Quaternion.Motor3D;

    // A pure translation as a motor (identity rotation).
    CreateTranslation(_: Motor3D, v: Vector3D): Motor3D
        => (Quaternion.Identity, Quaternion(v.X * 0.5, v.Y * 0.5, v.Z * 0.5, 0.0));

    // The dual-quaternion product: like the quaternion Hamilton product,
    // a.Multiply(b) is the motion b followed by a. Use Compose for
    // first-then-second ordering.
    Multiply(a: Motor3D, b: Motor3D): Motor3D
        => (a.Real.Multiply(b.Real), a.Real.Multiply(b.Dual).Add(a.Dual.Multiply(b.Real)));

    // The motor that applies `first`, then `second`.
    Compose(first: Motor3D, second: Motor3D): Motor3D
        => second.Multiply(first);

    // The motor that undoes this one (the dual-quaternion conjugate; an
    // inverse for unit motors).
    Inverse(m: Motor3D): Motor3D
        => (m.Real.Conjugate, m.Dual.Conjugate);

    // Rescale so the real part has unit magnitude, restoring the motor
    // invariant after repeated products. Precondition: the real part is not
    // zero.
    Normalize(m: Motor3D): Motor3D {
        var scale = 1.0 / m.Real.Length;
        return (m.Real.Multiply(scale), m.Dual.Multiply(scale));
    }

    // Apply the motor's rigid motion to a point.
    Transform(p: Point3D, m: Motor3D): Point3D
        => p.Transform(m.Pose3D);

    // Rotate a displacement by the motor's rotation (translation does not act
    // on vectors).
    Transform(v: Vector3D, m: Motor3D): Vector3D
        => v.Transform(m.Real);

    // The homogeneous matrix of the motor's rigid motion.
    Matrix4x4(m: Motor3D): Matrix4x4
        => m.Pose3D.Matrix4x4;

    //==
    // Frames and bases — orthonormal frames are rigid poses in matrix-friendly
    // clothing: the axes are the rotation, the origin is the translation.

    // The affine matrix mapping frame-local coordinates to world coordinates
    // (axes become the linear rows, the origin the translation row).
    Matrix3x2(f: Frame2D): Matrix3x2
        => (Number2(f.XAxis.Vector.X, f.XAxis.Vector.Y),
            Number2(f.YAxis.Vector.X, f.YAxis.Vector.Y),
            Number2(f.Origin.X, f.Origin.Y));

    // The frame of a rigid pose: the pose's rotated unit axes at its position.
    Frame2D(pose: Pose2D): Frame2D {
        var x = Vector2D(1.0, 0.0).Transform(pose.Rotation);
        var y = Vector2D(0.0, 1.0).Transform(pose.Rotation);
        return (pose.Position, Direction2D(x), Direction2D(y));
    }

    // The rigid pose of a frame. Precondition: the axes are orthonormal and
    // right-handed.
    Pose2D(f: Frame2D): Pose2D
        => f.Matrix3x2.Pose2D;

    // The homogeneous matrix mapping frame-local coordinates to world
    // coordinates.
    Matrix4x4(f: Frame3D): Matrix4x4 {
        var x = f.XAxis.Vector;
        var y = f.YAxis.Vector;
        var z = f.ZAxis.Vector;
        var o = f.Origin;
        return (Number4(x.X, x.Y, x.Z, 0.0),
                Number4(y.X, y.Y, y.Z, 0.0),
                Number4(z.X, z.Y, z.Z, 0.0),
                Number4(o.X, o.Y, o.Z, 1.0));
    }

    // The frame of a rigid pose: the pose's rotated unit axes at its position.
    Frame3D(pose: Pose3D): Frame3D {
        var q = pose.Orientation;
        var x = Vector3D(1.0, 0.0, 0.0).Transform(q);
        var y = Vector3D(0.0, 1.0, 0.0).Transform(q);
        var z = Vector3D(0.0, 0.0, 1.0).Transform(q);
        return (pose.Position, Direction3D(x), Direction3D(y), Direction3D(z));
    }

    // The rigid pose of a frame. Precondition: the axes are orthonormal and
    // right-handed.
    Pose3D(f: Frame3D): Pose3D
        => f.Matrix4x4.Pose3D;

    // The world-axis images under a rotation: the columns of its rotation
    // matrix as a (generally orthonormal) basis.
    Basis3D(q: Quaternion): Basis3D
        => (Vector3D(1.0, 0.0, 0.0).Transform(q),
            Vector3D(0.0, 1.0, 0.0).Transform(q),
            Vector3D(0.0, 0.0, 1.0).Transform(q));
}
