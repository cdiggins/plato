//==
// # Scientific data
//
// Measured and recorded data: named series, time series (regular and
// irregular), tabular data with typed columns, measurement records with
// uncertainty, and dataset metadata. Values carry their units explicitly via
// UnitOfMeasure rather than through the type system.

// The family of time-indexed collections: a sample count and a time for each
// zero-based sample index.
concept TimeSampled
    inherits Value
{
    SampleCount(x: Self): Integer;
    TimeAt(x: Self, index: Integer): Instant;
}

//==
// # Series

// A named sequence of numeric values sharing one unit: a plot trace, a sensor
// sweep, a spectrum row.
type DataSeries
{
    Name: String;
    Values: Array<Number>;
    Unit: UnitOfMeasure;
}

// A uniformly sampled time series: sample i occurs at Start plus i times
// SamplePeriod. Values are in Unit.
type TimeSeries
    implements TimeSampled
{
    Start: Instant;
    SamplePeriod: Duration;
    Values: Array<Number>;
    Unit: UnitOfMeasure;
}

// A time series with explicit, strictly increasing sample times. Times and
// Values are parallel arrays; values are in Unit.
type IrregularTimeSeries
    implements TimeSampled
{
    Times: Array<Instant>;
    Values: Array<Number>;
    Unit: UnitOfMeasure;
}

// A uniformly sampled series of 3D vectors (positions, velocities, field
// samples): sample i occurs at Start plus i times SamplePeriod. Components are
// in Unit.
type Vector3TimeSeries
    implements TimeSampled
{
    Start: Instant;
    SamplePeriod: Duration;
    Values: Array<Vector3>;
    Unit: UnitOfMeasure;
}

// A log of discrete labeled occurrences. Times is nondecreasing and parallel
// to Labels.
type EventLog
    implements TimeSampled
{
    Times: Array<Instant>;
    Labels: Array<String>;
}

// A label attached to a span of time: an annotation, a phase, an experiment
// stage.
type LabeledTimeInterval
{
    Interval: TimeInterval;
    Label: String;
}

//==
// # Tables

// The element type of a table column.
// Value meanings: 0=Number, 1=Integer, 2=String, 3=Boolean, 4=Instant.
type ColumnKind
{
    Value: Integer;
}

// A named, typed table column. Exactly one of the value arrays - the one
// matching Kind - is populated; the others are empty. Numeric columns state
// their unit via the owning dataset's metadata or the column name.
type DataColumn
{
    Name: String;
    Kind: ColumnKind;
    NumberValues: Array<Number>;
    IntegerValues: Array<Integer>;
    StringValues: Array<String>;
    BooleanValues: Array<Boolean>;
    InstantValues: Array<Instant>;
}

// A rectangular table of typed columns. Every column's populated array has
// exactly RowCount entries.
type DataTable
{
    Columns: Array<DataColumn>;
    RowCount: Integer;
}

//==
// # Measurements and metadata

// A single timestamped measurement. Value and Uncertainty are both expressed
// in Unit; Uncertainty is one standard deviation.
type MeasurementRecord
    implements Value
{
    Time: Instant;
    Value: Number;
    Uncertainty: Number;
    Unit: UnitOfMeasure;
}

// One key-value pair of dataset metadata (instrument id, operator, campaign).
type MetadataEntry
    implements Value
{
    Key: String;
    Value: String;
}

// Identifying information for a dataset: name, human-readable description,
// and open-ended metadata entries.
type DatasetDescriptor
{
    Name: String;
    Description: String;
    Metadata: Array<MetadataEntry>;
}

// Description of one acquisition channel of an instrument: what it measures,
// in which unit, and how often it samples.
type SensorChannel
{
    Name: String;
    Unit: UnitOfMeasure;
    SamplePeriod: Duration;
}

// A calibration mapping from raw readings to physical values as a piecewise
// linear function. InputValues is strictly increasing and parallel to
// OutputValues; inputs are in InputUnit, outputs in OutputUnit.
type CalibrationCurve
{
    InputValues: Array<Number>;
    OutputValues: Array<Number>;
    InputUnit: UnitOfMeasure;
    OutputUnit: UnitOfMeasure;
}

//==
// # Policies

// How samples are interpolated when a series is resampled onto new times.
// Value meanings: 0=Nearest, 1=Linear, 2=CubicSpline, 3=HoldPrevious,
// 4=HoldNext.
type ResamplingPolicyKind
{
    Value: Integer;
}

// How missing values in a series or column are treated during computation.
// Value meanings: 0=Skip (drop the sample), 1=Zero (substitute zero),
// 2=Interpolate (fill from neighbors), 3=Hold (repeat the previous value).
type MissingValuePolicyKind
{
    Value: Integer;
}
