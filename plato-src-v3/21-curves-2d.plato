//==
// # Analytic curves in 2D
//
// Named closed-form plane curves. Each type stores the minimal defining
// parameters; the canonical [0,1] curve parameter maps onto the documented
// sweep or domain. Types whose placement fields are absent are defined in
// canonical position (centered at or starting from the origin) and are placed
// elsewhere with a transform.

//==
// # Arcs and conic pieces

// A portion of a circle: the points at distance Radius from Center, swept over
// the angle interval measured from the +X axis.
type CircularArc2D
    implements Curve2D
{
    Center: Point2D;
    Radius: Number;
    Angles: AngleInterval;
}

// A portion of an axis-rotated ellipse. Radii holds the semi-axis lengths along
// the ellipse's local X and Y; Rotation tilts the major frame from the +X axis;
// Angles sweeps the parametric angle.
type EllipticalArc2D
    implements Curve2D
{
    Center: Point2D;
    Radii: Number2;
    Rotation: Angle;
    Angles: AngleInterval;
}

// A parabola in canonical position: y = Coefficient * x * x, vertex at the
// origin, opening along +Y. The parameter is x, ranging over Domain.
type Parabola2D
    implements Curve2D
{
    Coefficient: Number;
    Domain: NumberInterval;
}

//==
// # Function graphs

// The graph of a hanging chain: y = Scale * cosh(x / Scale). Scale is the
// classic catenary constant a; the parameter is x, ranging over Domain.
type Catenary2D
    implements Curve2D
{
    Scale: Number;
    Domain: NumberInterval;
}

// One or more cycles of a sine wave along the X axis:
// y = Amplitude * sin(2 * pi * x / Wavelength + Phase). The parameter is x,
// ranging over Domain.
type SineCurve2D
    implements Curve2D
{
    Amplitude: Number;
    Wavelength: Number;
    Phase: Angle;
    Domain: NumberInterval;
}

//==
// # Polynomial arcs

// A quadratic Bezier arc: interpolates P0 to P2, shaped by the middle control
// point P1. Tangents at the ends aim at P1.
type QuadraticBezier2D
    implements Curve2D
{
    P0: Point2D;
    P1: Point2D;
    P2: Point2D;
}

// A cubic Bezier arc: interpolates P0 to P3, shaped by the interior control
// points P1 and P2. The workhorse of vector graphics and font outlines.
type CubicBezier2D
    implements Curve2D
{
    P0: Point2D;
    P1: Point2D;
    P2: Point2D;
    P3: Point2D;
}

//==
// # Spirals and transition curves

// The Archimedean spiral r = StartRadius + GrowthRate * theta (theta in
// radians), swept over Angles: evenly spaced coils.
type ArchimedeanSpiral2D
    implements PolarCurve2D
{
    StartRadius: Number;
    GrowthRate: Number;
    Angles: AngleInterval;
}

// The logarithmic (equiangular) spiral r = StartRadius * exp(GrowthRate *
// theta), swept over Angles: self-similar coils, constant crossing angle.
type LogarithmicSpiral2D
    implements PolarCurve2D
{
    StartRadius: Number;
    GrowthRate: Number;
    Angles: AngleInterval;
}

// One branch of Fermat's spiral r = Scale * sqrt(theta), swept over Angles:
// evenly filling coils, the basis of sunflower/phyllotaxis layouts.
type FermatSpiral2D
    implements PolarCurve2D
{
    Scale: Number;
    Angles: AngleInterval;
}

// A clothoid (Euler spiral) arc: curvature grows linearly with arc length,
// kappa(s) = s / (Flatness * Flatness). The parameter is signed arc length s
// over Domain. The standard road and rail transition curve.
type Clothoid2D
    implements Curve2D, ArcLengthParameterized<Point2D>
{
    Flatness: Number;
    Domain: NumberInterval;
}

// The involute of a circle of radius Radius: the path of a taut string
// unwinding from the circle, over the unwinding-angle interval. The profile
// of standard gear teeth.
type CircleInvolute2D
    implements Curve2D
{
    Radius: Number;
    Angles: AngleInterval;
}

//==
// # Roulettes (rolling-circle curves)

// The path of a point on the rim of a circle of radius Radius rolling along
// the X axis: x = Radius * (theta - sin theta), y = Radius * (1 - cos theta),
// with the rolling angle theta swept over Angles.
type Cycloid2D
    implements Curve2D
{
    Radius: Number;
    Angles: AngleInterval;
}

// The path of a rim point on a circle of radius RollingRadius rolling outside
// a fixed circle of radius FixedRadius. Closes after a whole number of laps
// when the radius ratio is rational; the canonical parameter covers one lap
// around the fixed circle.
type Epicycloid2D
    implements Curve2D
{
    FixedRadius: Number;
    RollingRadius: Number;
}

// The path of a rim point on a circle of radius RollingRadius rolling inside
// a fixed circle of radius FixedRadius. Straight lines, ellipses, and the
// astroid arise from particular radius ratios.
type Hypocycloid2D
    implements Curve2D
{
    FixedRadius: Number;
    RollingRadius: Number;
}

// A generalized epicycloid: the traced point sits PoleDistance from the center
// of the rolling circle rather than on its rim (spirograph curves).
type Epitrochoid2D
    implements Curve2D
{
    FixedRadius: Number;
    RollingRadius: Number;
    PoleDistance: Number;
}

// A generalized hypocycloid: the traced point sits PoleDistance from the center
// of the circle rolling inside the fixed circle (spirograph curves).
type Hypotrochoid2D
    implements Curve2D
{
    FixedRadius: Number;
    RollingRadius: Number;
    PoleDistance: Number;
}

//==
// # Polar and figure curves

// The rose r = Radius * cos(PetalFrequency * theta). A whole odd frequency k
// yields k petals; a whole even k yields 2k petals; fractional frequencies
// close only over multiple turns.
type RoseCurve2D
    implements PolarCurve2D
{
    Radius: Number;
    PetalFrequency: Number;
}

// The cardioid r = 2 * Radius * (1 + cos theta): the heart-shaped path traced
// by a circle of radius Radius rolling around an equal fixed circle. Always
// closed; total width is 4 * Radius.
type Cardioid2D
    implements ClosedCurve2D
{
    Radius: Number;
}

// The limacon r = Offset + Amplitude * cos theta. Offset > Amplitude gives a
// dimpled oval, equality gives the cardioid, Offset < Amplitude adds an inner
// loop. Always closed.
type Limacon2D
    implements ClosedCurve2D
{
    Offset: Number;
    Amplitude: Number;
}

// The lemniscate of Bernoulli, r * r = Scale * Scale * cos(2 * theta): a
// figure-eight crossing itself at the origin; Scale is the half-width.
type Lemniscate2D
    implements ClosedCurve2D
{
    Scale: Number;
}

// A Lissajous figure: x = XAmplitude * sin(2 * pi * XFrequency * t + Phase),
// y = YAmplitude * sin(2 * pi * YFrequency * t). Closes when the frequency
// ratio is rational; the canonical parameter covers one combined period.
type Lissajous2D
    implements Curve2D
{
    XAmplitude: Number;
    YAmplitude: Number;
    XFrequency: Number;
    YFrequency: Number;
    Phase: Angle;
}

// The Gielis superformula, a polar shape family covering polygons, stars,
// and organic outlines. Symmetry is the lobe count m; Exponent1..3 are the
// n1, n2, n3 shape exponents; XRadius and YRadius are the a and b scale
// divisors. Closed when Symmetry is a whole number.
type Superformula2D
    implements PolarCurve2D
{
    Symmetry: Number;
    Exponent1: Number;
    Exponent2: Number;
    Exponent3: Number;
    XRadius: Number;
    YRadius: Number;
}
