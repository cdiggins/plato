//==
// # Vectors and numeric tuples
//
// Two families share the Vector concept. The Number2/3/4/8 family is the
// low-level intrinsic tier: fixed-arity tuples of Numbers with component-wise
// arithmetic, mapped directly onto each backend's native vector type
// (System.Numerics, vecN, floatN). The Vector2D/3D family is geometric:
// displacements and directions in 2D/3D space. Points (file 11) are positions;
// geometric vectors are the differences between them. Naming rule: a bare
// number counts components (Number3, Tuple3, IntegerVector3); a D suffix means
// the type lives in that-dimensional space (Vector3D, Point3D, Ray3D).

// The family of fixed-arity numeric vectors: component-wise arithmetic, norms,
// dot product, and component-wise extremes.
concept Vector
    inherits Numerical, Arithmetic, Indexable<Number>, Normed, Lattice, Hashable
{
    Dot(a: Self, b: Self): Number;
}

// A pair of Numbers: the low-level intrinsic 2-tuple.
type Number2
    implements Vector
{
    X: Number;
    Y: Number;
}

// A triple of Numbers: the low-level intrinsic 3-tuple.
type Number3
    implements Vector
{
    X: Number;
    Y: Number;
    Z: Number;
}

// A quadruple of Numbers: the low-level intrinsic 4-tuple; also used for
// homogeneous coordinates and RGBA math.
type Number4
    implements Vector
{
    X: Number;
    Y: Number;
    Z: Number;
    W: Number;
}

// An octuple of Numbers: the low-level intrinsic 8-tuple (SIMD-width lane math).
type Number8
    implements Vector
{
    X0: Number;
    X1: Number;
    X2: Number;
    X3: Number;
    X4: Number;
    X5: Number;
    X6: Number;
    X7: Number;
}

// A displacement or direction in 2D space.
type Vector2D
    implements Vector
{
    X: Number;
    Y: Number;
}

// A displacement or direction in 3D space.
type Vector3D
    implements Vector
{
    X: Number;
    Y: Number;
    Z: Number;
}

// An N-dimensional vector with runtime-determined arity.
type VectorN
    implements Vector
{
    Components: Array<Number>;
}

// A pair of whole-number components: pixel offsets, grid steps.
type IntegerVector2
    implements Value, Hashable
{
    X: Integer;
    Y: Integer;
}

// A triple of whole-number components: voxel offsets, 3D grid steps.
type IntegerVector3
    implements Value, Hashable
{
    X: Integer;
    Y: Integer;
    Z: Integer;
}

// A quadruple of whole-number components.
type IntegerVector4
    implements Value, Hashable
{
    X: Integer;
    Y: Integer;
    Z: Integer;
    W: Integer;
}

// A 2D direction: a Vector2D with the invariant that its magnitude is one.
type Direction2D
    implements Value
{
    Vector: Vector2D;
}

// A 3D direction: a Vector3D with the invariant that its magnitude is one.
type Direction3D
    implements Value
{
    Vector: Vector3D;
}
