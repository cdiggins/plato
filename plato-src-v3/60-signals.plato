//==
// # Signals
//
// Uniformly sampled signals, frequency-domain representations, analysis
// windows, digital filters, envelopes, and waveform generator descriptions.
// Conventions: sample i of a signal occurs at time i / SampleRate; spectrum
// bin k is centered at k * BinWidth with bin 0 at DC; filter gains are in
// decibels; generator types are pure parameter records.

// A uniformly sampled scalar signal. Sample i occurs at time i / SampleRate.
type SampledSignal
    implements Value
{
    SampleRate: Frequency;
    Samples: Array<Number>;
}

// A uniformly sampled signal with multiple interleaved channels. Samples are
// frame-interleaved (all channels of frame 0, then frame 1, ...); the sample
// count is a multiple of ChannelCount.
type MultichannelSignal
    implements Value
{
    SampleRate: Frequency;
    ChannelCount: Integer;
    Samples: Array<Number>;
}

// A single-sided magnitude/phase spectrum with uniform bins. Parallel arrays:
// bin k is centered at k * BinWidth (bin 0 is DC), with magnitude
// Magnitudes[k] and phase Phases[k].
type Spectrum
    implements Value
{
    BinWidth: Frequency;
    Magnitudes: Array<Number>;
    Phases: Array<Angle>;
}

// A complex-valued spectrum with uniform bins: Bins[k] holds the amplitude
// and phase of the component at k * BinWidth as one complex number.
type ComplexSpectrum
    implements Value
{
    BinWidth: Frequency;
    Bins: Array<Complex>;
}

// A time-frequency magnitude map from a short-time transform. The column
// index of Magnitudes selects the time frame (frame j starts at j * TimeStep)
// and the row index selects the frequency bin (bin k at k * BinWidth).
type Spectrogram
    implements Value
{
    TimeStep: Duration;
    BinWidth: Frequency;
    Magnitudes: Array2D<Number>;
}

//==
// # Analysis windows

// The taper shape applied to a block of samples before spectral analysis.
// The parameter-carrying kinds hold their own shape parameter; the parameter-
// free kinds carry none.
type WindowFunction
    implements Value
    = Rectangular
    | Hann
    | Hamming
    | Blackman
    | BlackmanHarris
    | Kaiser(Beta: Number)                    // the Kaiser beta
    | Gaussian(StandardDeviation: Number)     // standard deviation, in samples
    | Tukey(TaperFraction: Proportion);       // fraction of the window that is tapered

// A short-time analysis configuration. Size is the window length in samples;
// HopSize is the advance between consecutive windows.
type AnalysisWindow
    implements Value
{
    Function: WindowFunction;
    Size: Integer;
    HopSize: Integer;
}

//==
// # Filters

// The response shape of a second-order (biquad) filter section. The peaking
// and shelf shapes carry their gain in decibels; the others have none.
type BiquadResponse
    = LowPass
    | HighPass
    | BandPass
    | Notch
    | AllPass
    | PeakingEq(GainDecibels: Number)
    | LowShelf(GainDecibels: Number)
    | HighShelf(GainDecibels: Number);

// A second-order filter section in design terms: the response shape, the
// corner or center Frequency, and the quality factor Q (bandwidth).
type BiquadFilter
    implements Value
{
    Response: BiquadResponse;
    Frequency: Frequency;
    Q: Number;
}

// A finite-impulse-response filter: the output is the convolution of the
// input with Taps, where Taps[0] weights the current sample.
type FirFilter
    implements Value
{
    Taps: Array<Number>;
}

// An infinite-impulse-response filter in direct form. Feedforward
// coefficients (b) weight current and past inputs; feedback coefficients (a)
// weight past outputs, with FeedbackCoefficients[0] normalized to 1.
type IirFilter
    implements Value
{
    FeedforwardCoefficients: Array<Number>;
    FeedbackCoefficients: Array<Number>;
}

//==
// # Envelopes and generators

// An attack-decay-sustain-release amplitude envelope. Sustain is the level
// held after decay as a proportion of peak; the other stages are durations.
type AdsrEnvelope
    implements Value
{
    Attack: Duration;
    Decay: Duration;
    Sustain: Proportion;
    Release: Duration;
}

// The spectral color of a noise generator: White is flat, Pink -3 dB/octave,
// Brown -6 dB/octave, Blue +3 dB/octave.
type NoiseColor = White | Pink | Brown | Blue;

// A pure description of a noise generator: spectral color, peak amplitude,
// and the seed of its deterministic random sequence.
type NoiseSignal
    implements Value
{
    Color: NoiseColor;
    Amplitude: Number;
    Seed: Integer;
}

// The shape of a periodic test or synthesis waveform. Pulse carries its
// duty cycle: the high fraction of each period.
type Waveform
    = Sine
    | Square
    | Triangle
    | Sawtooth
    | Pulse(DutyCycle: Proportion);

// A pure description of a periodic waveform generator. Phase offsets the
// start of the cycle.
type WaveformGenerator
    implements Value
{
    Waveform: Waveform;
    Frequency: Frequency;
    Amplitude: Number;
    Phase: Angle;
}

//==
// # Rate conversion and mixing

// The interpolation used when resampling a signal to a new rate.
type SignalResampling = ZeroOrderHold | Linear | CubicHermite | WindowedSinc;

// A sample-rate conversion request: the source and target rates and the
// interpolation used between them.
type SampleRateConversion
    implements Value
{
    SourceRate: Frequency;
    TargetRate: Frequency;
    Interpolation: SignalResampling;
}

// The gain law of a crossfade between two signals: gains sum to 1 (Linear),
// squared gains sum to 1 (EqualPower), or smooth-stepped linear (SCurve).
type CrossfadeLaw = Linear | EqualPower | SCurve;

// A crossfade description: the gain law and the time taken to move fully
// from one signal to the other.
type CrossfadeParameters
    implements Value
{
    Law: CrossfadeLaw;
    Duration: Duration;
}

//==
// # Derived representations

// An analytic (Hilbert) representation of a real signal: parallel in-phase
// and quadrature sample arrays, from which instantaneous amplitude and
// phase follow.
type AnalyticSignal
    implements Value
{
    SampleRate: Frequency;
    InPhase: Array<Number>;
    Quadrature: Array<Number>;
}

// An inclusive band of frequencies from Low to High: equalizer bands,
// octave analysis, band-limited processing.
type FrequencyBand
    implements Value
{
    Low: Frequency;
    High: Frequency;
}
