//==
// # Points and coordinates
//
// Points are positions in a space; they are not vectors. Subtracting two points
// yields a vector, and adding a vector to a point yields a point (the Difference
// concept). Alternative coordinate systems are distinct types, not conventions.

// A position in some coordinate space. Marker concept for all point-like types.
concept Coordinate
    inherits Value, Equatable, Interpolatable
{ }

// A position in the 2D Cartesian plane.
type Point2D
    implements Coordinate, Difference<Vector2>, Hashable
{
    X: Number;
    Y: Number;
}

// A position in 3D Cartesian space.
type Point3D
    implements Coordinate, Difference<Vector3>, Hashable
{
    X: Number;
    Y: Number;
    Z: Number;
}

// A position in 4D Cartesian space.
type Point4D
    implements Coordinate, Difference<Vector4>, Hashable
{
    X: Number;
    Y: Number;
    Z: Number;
    W: Number;
}

// A position in N-dimensional Cartesian space.
type PointN
    implements Coordinate, Difference<VectorN>
{
    Components: Array<Number>;
}

// A 2D point in homogeneous form; the Cartesian point is (X/W, Y/W).
type HomogeneousPoint2D
    implements Value
{
    X: Number;
    Y: Number;
    W: Number;
}

// A 3D point in homogeneous form; the Cartesian point is (X/W, Y/W, Z/W).
type HomogeneousPoint3D
    implements Value
{
    X: Number;
    Y: Number;
    Z: Number;
    W: Number;
}

// A planar position as distance from origin and angle from the positive X axis.
type PolarCoordinate
    implements Value
{
    Radius: Number;
    Angle: Angle;
}

// A 3D position as planar polar coordinates plus height along Z.
type CylindricalCoordinate
    implements Value
{
    Radius: Number;
    Azimuth: Angle;
    Height: Number;
}

// A 3D position as radius, azimuth (about Z from +X), and inclination from the
// +Z pole.
type SphericalCoordinate
    implements Value
{
    Radius: Number;
    Azimuth: Angle;
    Inclination: Angle;
}

// Weights relative to a triangle's vertices; U + V + W = 1 on the triangle.
type BarycentricCoordinate
    implements Value
{
    U: Number;
    V: Number;
    W: Number;
}

// A normalized 2D surface parameter: texture lookup, patch evaluation.
type UvCoordinate
    implements Coordinate, Difference<Vector2>
{
    U: Number;
    V: Number;
}

// A normalized 3D volume parameter: 3D textures, trivariate patches.
type UvwCoordinate
    implements Coordinate, Difference<Vector3>
{
    U: Number;
    V: Number;
    W: Number;
}

// A position on a planet's surface: geodetic latitude, longitude, and altitude
// above the reference ellipsoid.
type GeoCoordinate
    implements Value
{
    Latitude: Angle;
    Longitude: Angle;
    Altitude: Length;
}
