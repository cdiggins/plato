//==
// # Procedural noise
//
// Pseudo-random fields for texturing, terrain, motion, and scattering. Every
// noise value type is a deterministic function of its parameters and Seed:
// the same inputs always reproduce the same field. Scalar noises nominally
// range over [-1, 1] unless a doc comment says otherwise. Frequency scales
// the input domain: higher frequency means smaller features.

//==
// ## Noise kinds

// The basis function family of a noise field.
type NoiseBasis = White | Value | Perlin | Simplex | Worley | Gabor;

// The distance metric Worley (cellular) noise uses between a query point and
// feature points.
type WorleyDistance = Euclidean | Manhattan | Chebyshev | Minkowski;

// Which feature-point distances Worley noise combines into its output:
// F1 is the distance to the nearest feature point, F2 to the second nearest;
// F2MinusF1 highlights cell borders.
type WorleyFeature = F1 | F2 | F2MinusF1 | F1PlusF2;

//==
// ## Basis noises

// Uncorrelated planar random values: a distinct pseudo-random number per
// point, with no spatial coherence. Ranges over [0, 1].
type WhiteNoise2D
    implements Value, ScalarField2D
{
    Seed: Integer;
}

// Uncorrelated spatial random values: a distinct pseudo-random number per
// point, with no spatial coherence. Ranges over [0, 1].
type WhiteNoise3D
    implements Value, ScalarField3D
{
    Seed: Integer;
}

// Planar value noise: random values on an integer lattice, smoothly
// interpolated between lattice points. Cheap, but shows lattice artifacts.
type ValueNoise2D
    implements Value, ScalarField2D
{
    Seed: Integer;
    Frequency: Number;
}

// Spatial value noise: random values on an integer lattice, smoothly
// interpolated between lattice points. Cheap, but shows lattice artifacts.
type ValueNoise3D
    implements Value, ScalarField3D
{
    Seed: Integer;
    Frequency: Number;
}

// Planar Perlin gradient noise: random gradients on an integer lattice with
// smooth interpolation. Zero at lattice points; band-limited and visually
// smooth.
type PerlinNoise2D
    implements Value, ScalarField2D
{
    Seed: Integer;
    Frequency: Number;
}

// Spatial Perlin gradient noise: random gradients on an integer lattice with
// smooth interpolation. Zero at lattice points; band-limited and visually
// smooth.
type PerlinNoise3D
    implements Value, ScalarField3D
{
    Seed: Integer;
    Frequency: Number;
}

// Planar simplex noise: gradient noise on a triangular lattice. Fewer
// directional artifacts and cheaper in higher dimensions than Perlin noise.
type SimplexNoise2D
    implements Value, ScalarField2D
{
    Seed: Integer;
    Frequency: Number;
}

// Spatial simplex noise: gradient noise on a tetrahedral lattice. Fewer
// directional artifacts and cheaper in higher dimensions than Perlin noise.
type SimplexNoise3D
    implements Value, ScalarField3D
{
    Seed: Integer;
    Frequency: Number;
}

// Planar Worley (cellular) noise: distances to randomly scattered feature
// points, one per lattice cell. Jitter in [0, 1] moves feature points from
// cell centers (0) to fully random positions (1). Produces cellular,
// crystalline, and cracked patterns; output is non-negative.
type WorleyNoise2D
    implements Value, ScalarField2D
{
    Seed: Integer;
    Frequency: Number;
    Jitter: Number;
    Distance: WorleyDistance;
    Feature: WorleyFeature;
}

// Spatial Worley (cellular) noise: distances to randomly scattered feature
// points, one per lattice cell. Jitter in [0, 1] moves feature points from
// cell centers (0) to fully random positions (1). Produces cellular,
// crystalline, and cracked patterns; output is non-negative.
type WorleyNoise3D
    implements Value, ScalarField3D
{
    Seed: Integer;
    Frequency: Number;
    Jitter: Number;
    Distance: WorleyDistance;
    Feature: WorleyFeature;
}

// Planar Gabor noise: sparse convolution of oriented Gabor kernels, giving
// direct spectral control. Orientation sets the dominant stripe direction;
// Bandwidth sets kernel falloff; Anisotropy in [0, 1] blends from isotropic
// (0) to fully oriented (1).
type GaborNoise2D
    implements Value, ScalarField2D
{
    Seed: Integer;
    Frequency: Number;
    Orientation: Angle;
    Bandwidth: Number;
    Anisotropy: Number;
}

// Spatial Gabor noise: sparse convolution of oriented Gabor kernels, giving
// direct spectral control. Direction sets the dominant oscillation axis;
// Bandwidth sets kernel falloff; Anisotropy in [0, 1] blends from isotropic
// (0) to fully oriented (1).
type GaborNoise3D
    implements Value, ScalarField3D
{
    Seed: Integer;
    Frequency: Number;
    Direction: Direction3D;
    Bandwidth: Number;
    Anisotropy: Number;
}

//==
// ## Fractal noises
//
// Multi-octave sums of a basis noise. Octaves counts the layers; each octave
// multiplies frequency by Lacunarity (typically 2) and amplitude by Gain
// (typically 0.5).

// Planar fractal Brownian motion: a sum of Octaves layers of the Basis noise
// with geometrically scaled frequency and amplitude. The workhorse for
// terrain, clouds, and natural textures.
type FbmNoise2D
    implements Value, ScalarField2D
{
    Basis: NoiseBasis;
    Seed: Integer;
    Frequency: Number;
    Octaves: Integer;
    Lacunarity: Number;
    Gain: Number;
}

// Spatial fractal Brownian motion: a sum of Octaves layers of the Basis noise
// with geometrically scaled frequency and amplitude. The workhorse for
// terrain, clouds, and natural textures.
type FbmNoise3D
    implements Value, ScalarField3D
{
    Basis: NoiseBasis;
    Seed: Integer;
    Frequency: Number;
    Octaves: Integer;
    Lacunarity: Number;
    Gain: Number;
}

// Planar turbulence: fractal Brownian motion summing absolute values of each
// octave. Non-negative, with a billowy, cloud-like character and creases at
// the basis zero crossings.
type TurbulenceNoise2D
    implements Value, ScalarField2D
{
    Basis: NoiseBasis;
    Seed: Integer;
    Frequency: Number;
    Octaves: Integer;
    Lacunarity: Number;
    Gain: Number;
}

// Spatial turbulence: fractal Brownian motion summing absolute values of each
// octave. Non-negative, with a billowy, cloud-like character and creases at
// the basis zero crossings.
type TurbulenceNoise3D
    implements Value, ScalarField3D
{
    Basis: NoiseBasis;
    Seed: Integer;
    Frequency: Number;
    Octaves: Integer;
    Lacunarity: Number;
    Gain: Number;
}

// Planar ridged multifractal noise: octaves of inverted absolute basis noise
// offset by Offset (typically 1), producing sharp ridge lines. Suited to
// mountainous terrain and lightning-like filaments.
type RidgedNoise2D
    implements Value, ScalarField2D
{
    Basis: NoiseBasis;
    Seed: Integer;
    Frequency: Number;
    Octaves: Integer;
    Lacunarity: Number;
    Gain: Number;
    Offset: Number;
}

// Spatial ridged multifractal noise: octaves of inverted absolute basis noise
// offset by Offset (typically 1), producing sharp ridge crests. Suited to
// mountainous terrain and vein-like structures.
type RidgedNoise3D
    implements Value, ScalarField3D
{
    Basis: NoiseBasis;
    Seed: Integer;
    Frequency: Number;
    Octaves: Integer;
    Lacunarity: Number;
    Gain: Number;
    Offset: Number;
}

//==
// ## Warped and derived noises

// Planar domain-warped noise: the sample point is displaced by a warp noise
// of WarpFrequency scaled by WarpStrength, applied Iterations times, before
// evaluating the Basis noise. Produces marbled, fluid-like patterns.
type DomainWarpNoise2D
    implements Value, ScalarField2D
{
    Basis: NoiseBasis;
    Seed: Integer;
    Frequency: Number;
    WarpStrength: Number;
    WarpFrequency: Number;
    Iterations: Integer;
}

// Spatial domain-warped noise: the sample point is displaced by a warp noise
// of WarpFrequency scaled by WarpStrength, applied Iterations times, before
// evaluating the Basis noise. Produces marbled, fluid-like patterns.
type DomainWarpNoise3D
    implements Value, ScalarField3D
{
    Basis: NoiseBasis;
    Seed: Integer;
    Frequency: Number;
    WarpStrength: Number;
    WarpFrequency: Number;
    Iterations: Integer;
}

// Planar curl noise: the 90-degree rotation of the gradient of a smooth
// scalar potential, yielding a divergence-free vector field. Ideal for
// advecting particles without sources or sinks.
type CurlNoise2D
    implements Value, VectorField2D
{
    Seed: Integer;
    Frequency: Number;
}

// Spatial curl noise: the curl of a smooth vector potential, yielding a
// divergence-free vector field. Ideal for incompressible, swirling motion
// of particles, smoke, and hair.
type CurlNoise3D
    implements Value, VectorField3D
{
    Seed: Integer;
    Frequency: Number;
}
