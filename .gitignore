# Build output
[Bb]in/
[Oo]bj/
.vs/

# Test run artifacts (dotnet/VS TestResults)
[Tt]est[Rr]esult*/

# Scratch command output (see tools/export-types-context.ps1)
.temp/*
!.temp/README.md

# Agent-local state: live git worktrees, machine-local symlinks, personal settings.
# Committed agent config (e.g. .claude/skills/) is intentionally NOT ignored.
.claude/settings.local.json
.claude/worktrees/
.claude/ara3d-sdk

# Regenerated conformance output for the SDK-facing surface. No project file and no
# handwritten source lives here — the whole folder is script output.
# NOTE: conformance/Plato.ForwardConformanceTests/Generated/ IS tracked; only this one is not.
conformance/Ara3D.SDK.ConformanceTests/Generated/

# Python bytecode from tools/*.py
tools/__pycache__/
