library ReferenceLoops {
    ReferenceSumTo(n: Integer): Integer {
        var sum = 0;
        var i = 0;
        while (i < n) {
            sum = sum + i;
            i = i + 1;
        }
        return sum;
    }
    Law_ReferenceWhile(): Boolean => ReferenceSumTo(5) == 10;
    Law_ReferenceEmptyLoop(): Boolean => ReferenceSumTo(0) == 0;
}
