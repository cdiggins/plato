// Minimal reference-example environment, not a stdlib source.
primitive Boolean { }
primitive Integer { }
primitive Number { }
primitive String { }
primitive Array<T> { }
primitive Function1<T, R> { }
type Tuple2<A, B> { X0: A; X1: B; }

library ExampleIntrinsics {
    Add(a: Integer, b: Integer): Integer;
    Multiply(a: Integer, b: Integer): Integer;
    LessThanOrEquals(a: Integer, b: Integer): Boolean;
    Not(x: Boolean): Boolean;
    LessThan(a: Integer, b: Integer): Boolean
        => a.LessThanOrEquals(b) ? a.Equals(b).Not : false;
    Equals(a: Integer, b: Integer): Boolean;
}
