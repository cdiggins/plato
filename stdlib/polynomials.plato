//==
// # Polynomials and series
//
// Dense and sparse polynomials, fixed-degree forms, rational functions, and
// truncated series in classical bases. Convention: dense coefficient arrays
// are in ASCENDING powers (Coefficients[k] multiplies x^k); the fixed-degree
// convenience types instead use the conventional school form with A on the
// highest power, as documented per type.

// A dense univariate polynomial. Coefficients[k] multiplies x^k (ascending
// powers); an empty array is the zero polynomial, and the degree is the
// coefficient count minus 1.
type Polynomial
    implements Value
{
    Coefficients: Array<Number>;
}

// A single term: Coefficient times x raised to a non-negative Power.
type Monomial
    implements Value
{
    Coefficient: Number;
    Power: Integer;
}

// A sparse polynomial as parallel arrays: term i is Coefficients[i] times x
// raised to Powers[i]. Powers are distinct, non-negative, and ascending.
type SparsePolynomial
    implements Value
{
    Powers: Array<Integer>;
    Coefficients: Array<Number>;
}

// The quadratic A*x^2 + B*x + C (descending school form).
type QuadraticPolynomial
    implements Value
{
    A: Number;
    B: Number;
    C: Number;
}

// The cubic A*x^3 + B*x^2 + C*x + D (descending school form).
type CubicPolynomial
    implements Value
{
    A: Number;
    B: Number;
    C: Number;
    D: Number;
}

// The quartic A*x^4 + B*x^3 + C*x^2 + D*x + E (descending school form).
type QuarticPolynomial
    implements Value
{
    A: Number;
    B: Number;
    C: Number;
    D: Number;
    E: Number;
}

// The roots of a real polynomial. RealRoots lists real roots in ascending
// order with multiplicity; ComplexRoots lists the strictly complex roots,
// one representative per conjugate pair (positive imaginary part).
type PolynomialRoots
    implements Value
{
    RealRoots: Array<Number>;
    ComplexRoots: Array<Complex>;
}

// A ratio of two polynomials. The Denominator is not the zero polynomial;
// the function is undefined at its roots (poles).
type RationalFunction
    implements Value
{
    Numerator: Polynomial;
    Denominator: Polynomial;
}

//==
// # Series in classical bases
//
// Truncated series: each stores the coefficients of finitely many basis
// terms, ascending by term index.

// A truncated power series about Center: the sum of Coefficients[k] times
// (x - Center)^k.
type PowerSeries
    implements Value
{
    Center: Number;
    Coefficients: Array<Number>;
}

// A truncated series over Chebyshev polynomials of the first kind:
// Coefficients[k] weights T_k evaluated after Interval is mapped linearly
// onto [-1, 1].
type ChebyshevSeries
    implements Value
{
    Interval: NumberInterval;
    Coefficients: Array<Number>;
}

// A truncated series over Legendre polynomials on [-1, 1]: Coefficients[k]
// weights P_k.
type LegendreSeries
    implements Value
{
    Coefficients: Array<Number>;
}

// A truncated series over physicists' Hermite polynomials: Coefficients[k]
// weights H_k.
type HermiteSeries
    implements Value
{
    Coefficients: Array<Number>;
}

// A polynomial over the Bernstein basis of degree count - 1 on [0, 1]:
// Coefficients[k] weights the k-th Bernstein basis polynomial. The
// coefficients act as control values, as in a Bezier curve.
type BernsteinPolynomial
    implements Value
{
    Coefficients: Array<Number>;
}

// A dense polynomial in two variables. The column index of Coefficients is
// the power of x and the row index is the power of y, so the entry at
// (i, j) multiplies x^i * y^j.
type BivariatePolynomial
    implements Value
{
    Coefficients: Array2D<Number>;
}

// A truncated real Fourier series. Term k oscillates at k times the
// Fundamental frequency; CosineCoefficients[0] is the constant (DC) term and
// SineCoefficients[0] is ignored. The two arrays have equal length.
type FourierSeries
    implements Value
{
    Fundamental: Frequency;
    CosineCoefficients: Array<Number>;
    SineCoefficients: Array<Number>;
}

//==
// # Composite and derived forms

// A piecewise polynomial (spline in polynomial form). Breakpoints ascend and
// number one more than Pieces; piece i applies on the half-open span from
// Breakpoints[i] to Breakpoints[i+1] and is evaluated in the local variable
// x - Breakpoints[i].
type PiecewisePolynomial
    implements Value
{
    Breakpoints: Array<Number>;
    Pieces: Array<Polynomial>;
}

// A Pade approximant about Center: the rational function Numerator over
// Denominator that matches a power series to the highest order the two
// degrees allow. The Denominator's constant term is normalized to 1.
type PadeApproximant
    implements Value
{
    Center: Number;
    Numerator: Polynomial;
    Denominator: Polynomial;
}

// A Sturm sequence for counting real roots in an interval by sign changes.
// Polynomials[0] is the original polynomial, Polynomials[1] its derivative,
// and each later entry is the negated remainder of the two before it.
type SturmChain
    implements Value
{
    Polynomials: Array<Polynomial>;
}

//==
// # library Polynomials
//
// Closed-form evaluation of the low-degree power-basis polynomials and of the
// cubic spline bases (Bezier, Hermite, Catmull-Rom), plus their first and second
// derivatives. Successor to `stdlib-legacy/algebra.plato`.
//
// The coefficients / control values are typed `Numerical`, which inherits
// Additive (a + b, a - b), Scalable (v * scalar, v / scalar) and NumericalLimits
// (Zero) — exactly the operations a polynomial in a scalar variable needs. So a
// single definition serves Number, Vector2D, Vector3D, Point deltas, Color, and
// every quantity type, as v1's `INumerical` versions did. The variable itself is
// always a plain `Number`; `Numerical` deliberately does NOT give
// Multiplicative, so `value * value` is unavailable here and every product with
// the parameter is written as a scalar multiply.
//
// These are the base case the curve/surface layer is missing: an `Eval` on
// CubicBezier2D/3D, HermiteCurve2D/3D or CatmullRomCurve2D/3D is a one-line call
// into the corresponding function below.
//
// Not repeated here: `Barycentric` (already generic on Numerical in
// core-algebra.library.plato) and `SmoothStep`/`SmootherStep` (Number-concrete
// shaping functions, also in core-algebra.library.plato).
//
// Conventions: coefficients come first in descending-power (school) order,
// matching QuadraticPolynomial/CubicPolynomial/QuarticPolynomial above; the
// variable is last. Bezier/Hermite/Catmull-Rom parameters t are in [0, 1].

library Polynomials
{
    //==
    // # Power-basis polynomials

    // m*x + b. https://en.wikipedia.org/wiki/Linear_equation
    Linear(m: Numerical, b: Numerical, x: Number): Numerical
        => m * x + b;

    // The derivative of Linear: the constant slope m.
    LinearDerivative(m: Numerical, b: Numerical, x: Number): Numerical
        => m;

    // The second derivative of Linear: zero everywhere.
    LinearSecondDerivative(m: Numerical, b: Numerical, x: Number): Numerical
        => m.Zero;

    // a*x^2 + b*x + c. https://en.wikipedia.org/wiki/Quadratic_function
    Quadratic(a: Numerical, b: Numerical, c: Numerical, x: Number): Numerical
        => a * x.Square + b * x + c;

    // The derivative of Quadratic: 2*a*x + b.
    QuadraticDerivative(a: Numerical, b: Numerical, c: Numerical, x: Number): Numerical
        => a * (2.0 * x) + b;

    // The second derivative of Quadratic: the constant 2*a.
    QuadraticSecondDerivative(a: Numerical, b: Numerical, c: Numerical, x: Number): Numerical
        => a * 2.0;

    // a*x^3 + b*x^2 + c*x + d. https://en.wikipedia.org/wiki/Cubic_function
    Cubic(a: Numerical, b: Numerical, c: Numerical, d: Numerical, x: Number): Numerical
        => a * (x.Square * x) + b * x.Square + c * x + d;

    // The derivative of Cubic: 3*a*x^2 + 2*b*x + c.
    CubicDerivative(a: Numerical, b: Numerical, c: Numerical, d: Numerical, x: Number): Numerical
        => a * (3.0 * x.Square) + b * (2.0 * x) + c;

    // The second derivative of Cubic: 6*a*x + 2*b.
    CubicSecondDerivative(a: Numerical, b: Numerical, c: Numerical, d: Numerical, x: Number): Numerical
        => a * (6.0 * x) + b * 2.0;

    // a*x^4 + b*x^3 + c*x^2 + d*x + e. https://en.wikipedia.org/wiki/Quartic_function
    Quartic(a: Numerical, b: Numerical, c: Numerical, d: Numerical, e: Numerical, x: Number): Numerical
        => a * (x.Square * x.Square) + b * (x.Square * x) + c * x.Square + d * x + e;

    // The derivative of Quartic: 4*a*x^3 + 3*b*x^2 + 2*c*x + d.
    QuarticDerivative(a: Numerical, b: Numerical, c: Numerical, d: Numerical, e: Numerical, x: Number): Numerical
        => a * (4.0 * x.Square * x) + b * (3.0 * x.Square) + c * (2.0 * x) + d;

    // The second derivative of Quartic: 12*a*x^2 + 6*b*x + 2*c.
    QuarticSecondDerivative(a: Numerical, b: Numerical, c: Numerical, d: Numerical, e: Numerical, x: Number): Numerical
        => a * (12.0 * x.Square) + b * (6.0 * x) + c * 2.0;

    //==
    // # Bezier bases
    //
    // https://en.wikipedia.org/wiki/B%C3%A9zier_curve
    // Control values in order; the curve leaves the first and arrives at the last.

    // The quadratic (3-point) Bezier at t: (1-t)^2*a + 2(1-t)t*b + t^2*c.
    QuadraticBezier(a: Numerical, b: Numerical, c: Numerical, t: Number): Numerical
        => a * (1.0 - t).Square
         + b * (2.0 * (1.0 - t) * t)
         + c * t.Square;

    // The first derivative (velocity) of the quadratic Bezier:
    // 2(1-t)(b - a) + 2t(c - b).
    QuadraticBezierDerivative(a: Numerical, b: Numerical, c: Numerical, t: Number): Numerical
        => (b - a) * (2.0 * (1.0 - t))
         + (c - b) * (2.0 * t);

    // The second derivative of the quadratic Bezier: the constant 2(a - 2b + c).
    QuadraticBezierSecondDerivative(a: Numerical, b: Numerical, c: Numerical, t: Number): Numerical
        => (a + c - b * 2.0) * 2.0;

    // The cubic (4-point) Bezier at t:
    // (1-t)^3*a + 3(1-t)^2*t*b + 3(1-t)t^2*c + t^3*d.
    CubicBezier(a: Numerical, b: Numerical, c: Numerical, d: Numerical, t: Number): Numerical
        => a * ((1.0 - t).Square * (1.0 - t))
         + b * (3.0 * (1.0 - t).Square * t)
         + c * (3.0 * (1.0 - t) * t.Square)
         + d * (t.Square * t);

    // The first derivative (velocity) of the cubic Bezier:
    // 3(1-t)^2(b - a) + 6(1-t)t(c - b) + 3t^2(d - c).
    CubicBezierDerivative(a: Numerical, b: Numerical, c: Numerical, d: Numerical, t: Number): Numerical
        => (b - a) * (3.0 * (1.0 - t).Square)
         + (c - b) * (6.0 * (1.0 - t) * t)
         + (d - c) * (3.0 * t.Square);

    // The second derivative of the cubic Bezier:
    // 6(1-t)(a - 2b + c) + 6t(b - 2c + d).
    CubicBezierSecondDerivative(a: Numerical, b: Numerical, c: Numerical, d: Numerical, t: Number): Numerical
        => (a + c - b * 2.0) * (6.0 * (1.0 - t))
         + (b + d - c * 2.0) * (6.0 * t);

    //==
    // # Cubic Hermite basis
    //
    // https://en.wikipedia.org/wiki/Cubic_Hermite_spline
    // Endpoints p0, p1 with outgoing tangent m0 and incoming tangent m1:
    //   H(t) = (2t^3 - 3t^2 + 1)*p0 + (t^3 - 2t^2 + t)*m0
    //        + (-2t^3 + 3t^2)*p1    + (t^3 - t^2)*m1

    // The cubic Hermite segment at t, passing through p0 at t=0 and p1 at t=1.
    Hermite(p0: Numerical, p1: Numerical, m0: Numerical, m1: Numerical, t: Number): Numerical
        => p0 * (2.0 * t.Square * t - 3.0 * t.Square + 1.0)
         + m0 * (t.Square * t - 2.0 * t.Square + t)
         + p1 * (3.0 * t.Square - 2.0 * t.Square * t)
         + m1 * (t.Square * t - t.Square);

    // The first derivative (velocity) of the cubic Hermite segment:
    // (6t^2 - 6t)*p0 + (3t^2 - 4t + 1)*m0 + (6t - 6t^2)*p1 + (3t^2 - 2t)*m1.
    HermiteDerivative(p0: Numerical, p1: Numerical, m0: Numerical, m1: Numerical, t: Number): Numerical
        => p0 * (6.0 * t.Square - 6.0 * t)
         + m0 * (3.0 * t.Square - 4.0 * t + 1.0)
         + p1 * (6.0 * t - 6.0 * t.Square)
         + m1 * (3.0 * t.Square - 2.0 * t);

    //==
    // # Catmull-Rom basis
    //
    // https://en.wikipedia.org/wiki/Cubic_Hermite_spline#Catmull-Rom_spline
    // Four control values; the segment runs from p1 (t=0) to p2 (t=1), with the
    // tangents taken from the neighbours p0 and p3 (uniform parameterization).
    //   CR(t) = 0.5 * [ 2*p1 + (p2 - p0)*t
    //                 + (2*p0 - 5*p1 + 4*p2 - p3)*t^2
    //                 + (3*p1 - p0 - 3*p2 + p3)*t^3 ]

    // The uniform Catmull-Rom segment at t, interpolating p1 to p2.
    CatmullRom(p0: Numerical, p1: Numerical, p2: Numerical, p3: Numerical, t: Number): Numerical
        => (p1 * 2.0
          + (p2 - p0) * t
          + (p0 * 2.0 + p2 * 4.0 - p1 * 5.0 - p3) * t.Square
          + (p1 * 3.0 + p3 - p0 - p2 * 3.0) * (t.Square * t)) * 0.5;

    // The first derivative (velocity) of the uniform Catmull-Rom segment:
    // 0.5 * [ (p2 - p0) + 2t*(2*p0 - 5*p1 + 4*p2 - p3) + 3t^2*(3*p1 - p0 - 3*p2 + p3) ].
    CatmullRomDerivative(p0: Numerical, p1: Numerical, p2: Numerical, p3: Numerical, t: Number): Numerical
        => ((p2 - p0)
          + (p0 * 2.0 + p2 * 4.0 - p1 * 5.0 - p3) * (2.0 * t)
          + (p1 * 3.0 + p3 - p0 - p2 * 3.0) * (3.0 * t.Square)) * 0.5;

    //==
    // # Evaluation of the declared polynomial types
    //
    // The array-backed forms fold their coefficient arrays with the P2 `Reduce`
    // primitive. Power-basis polynomials (dense, sparse, power series) evaluate
    // by Horner's rule below. The classical-basis series (Chebyshev, Legendre,
    // Hermite, Bernstein, Fourier) still await basis-specific recurrences
    // (Clenshaw / de Casteljau) rather than plain Horner; those are also
    // foldable but out of scope for this pass.

    // Evaluates a dense coefficient array given in ASCENDING powers at x by
    // Horner's rule: folding the highest-power coefficient first means no
    // explicit power of x is ever formed, which is both faster and more stable.
    // An empty array is the zero polynomial and evaluates to 0.
    HornerEval(coefficients: Array<Number>, x: Number): Number
        => MapRange(coefficients.Count, i => coefficients.At(coefficients.Count - 1 - i))
               .Reduce(0.0, (acc, c) => acc * x + c);

    // The value of the dense polynomial sum(Coefficients[k] * x^k) at x.
    Eval(p: Polynomial, x: Number): Number
        => HornerEval(p.Coefficients, x);

    // The value of the sparse polynomial sum(Coefficients[i] * x^Powers[i]) at
    // x. Each term forms its own power because the exponents are not contiguous.
    Eval(p: SparsePolynomial, x: Number): Number
        => MapRange(p.Powers.Count,
                    i => p.Coefficients.At(i) * x.Pow(p.Powers.At(i).ToNumber))
               .Reduce(0.0, (acc, term) => acc + term);

    // The value of the truncated power series sum(Coefficients[k]*(x-Center)^k)
    // at x, evaluated by Horner's rule in the shifted variable (x - Center).
    Eval(s: PowerSeries, x: Number): Number
        => HornerEval(s.Coefficients, x - s.Center);

    // The value of the single term Coefficient * x^Power at x.
    Eval(m: Monomial, x: Number): Number
        => m.Coefficient * x.Pow(m.Power.ToNumber);

    // The value of A*x^2 + B*x + C at x.
    Eval(p: QuadraticPolynomial, x: Number): Number
        => p.A * x.Square + p.B * x + p.C;

    // The value of A*x^3 + B*x^2 + C*x + D at x.
    Eval(p: CubicPolynomial, x: Number): Number
        => p.A * x.Square * x + p.B * x.Square + p.C * x + p.D;

    // The value of A*x^4 + B*x^3 + C*x^2 + D*x + E at x.
    Eval(p: QuarticPolynomial, x: Number): Number
        => p.A * x.Square * x.Square + p.B * x.Square * x + p.C * x.Square + p.D * x + p.E;

    // The derivative of A*x^2 + B*x + C: 2*A*x + B.
    Derivative(p: QuadraticPolynomial, x: Number): Number
        => 2.0 * p.A * x + p.B;

    // The derivative of A*x^3 + B*x^2 + C*x + D: 3*A*x^2 + 2*B*x + C.
    Derivative(p: CubicPolynomial, x: Number): Number
        => 3.0 * p.A * x.Square + 2.0 * p.B * x + p.C;

    // The derivative of A*x^4 + ... + E: 4*A*x^3 + 3*B*x^2 + 2*C*x + D.
    Derivative(p: QuarticPolynomial, x: Number): Number
        => 4.0 * p.A * x.Square * x + 3.0 * p.B * x.Square + 2.0 * p.C * x + p.D;

    // The rational function's value at x: the Numerator's value over the
    // Denominator's, each by Horner's rule. Undefined at the Denominator's
    // roots (poles).
    Eval(r: RationalFunction, x: Number): Number
        => r.Numerator.Eval(x) / r.Denominator.Eval(x);
}
