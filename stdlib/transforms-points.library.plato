//==
// # Point support
//
// The Difference obligations of Point2D/Point3D, point interpolation, and the
// explicit point <-> vector converters that every other transform library builds
// on. Kept separate from the representations because nothing here depends on a
// transform type.

library TransformsPoints
{
    //==
    // Point support — the two primitive Difference members of Point2D/Point3D
    // (Between follows the b - a convention assumed by IntervalsTransforms) and
    // the explicit point <-> vector converters. These converters are deliberately
    // named (ToPoint / PositionVector) rather than implicit conversions: silently
    // coercing between positions and displacements would defeat the point of
    // keeping them distinct types.
    //
    // Subtract (both spellings) and Lerp are NOT written here. They are derived
    // once over the concept in algebra-metric.library.plato from Add + Between
    // and the `where TDelta: Additive, TDelta: Scalable` bound (plato-306), which
    // is also what gives PointN / UvCoordinate / UvwCoordinate the same surface
    // without a line of their own.

    // The point displaced by delta.
    Add(p: Point2D, delta: Vector2D): Point2D
        => (p.X + delta.X, p.Y + delta.Y);

    // The displacement from a to b (b - a).
    Between(a: Point2D, b: Point2D): Vector2D
        => (b.X - a.X, b.Y - a.Y);

    // The point displaced by delta.
    Add(p: Point3D, delta: Vector3D): Point3D
        => (p.X + delta.X, p.Y + delta.Y, p.Z + delta.Z);

    // The displacement from a to b (b - a).
    Between(a: Point3D, b: Point3D): Vector3D
        => (b.X - a.X, b.Y - a.Y, b.Z - a.Z);

    // The point's displacement from the origin.
    PositionVector(p: Point2D): Vector2D
        => (p.X, p.Y);

    // The point's displacement from the origin.
    PositionVector(p: Point3D): Vector3D
        => (p.X, p.Y, p.Z);

    // The point at the tip of the vector, placed from the origin.
    ToPoint(v: Vector2D): Point2D
        => (v.X, v.Y);

    // The point at the tip of the vector, placed from the origin.
    ToPoint(v: Vector3D): Point3D
        => (v.X, v.Y, v.Z);
}
