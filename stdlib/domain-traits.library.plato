//==
// # DomainTraits — derived functions for the domain-specific concepts
//
// Bodies for the concepts declared across files 36 (easing), 37 (time-varying
// tracks), 40 (paths), 45 (images), 47 (procedural textures), 48 (cameras),
// 49 (lights), 53 (kinematics), 54 (rigid dynamics), 59 (probability),
// 65 (graphs), 67 (time-sampled data) and 68 (geospatial regions). Every
// function's first parameter is concept-typed, so each helper becomes available
// on every implementing type. Pure expressions only; all inputs are immutable
// and evaluation is side-effect free.
//
// Helpers build only on the declared surface of each concept, its inherited
// concepts, and the generic helpers already provided by lower-numbered packages
// (P1 CoreAlgebra: Abs, Half, MidPoint, ...; P2 Collections: Count-based
// emptiness). Where a concept lacks a member a helper would need, a
// TODO(concept-gap) note records the omission. See `../README.md` for naming
// and unit conventions.

library DomainTraits
{
    //==
    // # EasingFunction
    //
    // A pure map from normalized time to normalized progress, inheriting
    // Procedural<Number, Number> (its sole operation is Eval). Eval(0) is 0 and
    // Eval(1) is 1; intermediate values may leave [0, 1] (overshoot,
    // anticipation). Helpers rename and recombine that single evaluation.

    // The eased progress at normalized time t; a readable spelling of Eval.
    Progress(self: EasingFunction, t: Number): Number
        => self.Eval(t);

    // The progress remaining to completion at time t: 1 - progress.
    Remaining(self: EasingFunction, t: Number): Number
        => 1.0 - self.Eval(t);

    // The eased progress at the temporal midpoint (t = 0.5): a one-number shape
    // summary distinguishing ease-in (< 0.5) from ease-out (> 0.5).
    ProgressAtMidpoint(self: EasingFunction): Number
        => self.Eval(0.5);

    // The playback-reversed curve sampled at t: f(1 - t), which runs from 1 down
    // to 0 as t goes 0 to 1 (the source curve played backwards).
    EvaluateMirrored(self: EasingFunction, t: Number): Number
        => self.Eval(1.0 - t);

    // The reversed easing sampled at t: 1 - f(1 - t). This is the standard
    // ease-in to ease-out transform, preserving the pinned endpoints.
    EvaluateReversed(self: EasingFunction, t: Number): Number
        => 1.0 - self.Eval(1.0 - t);

    // True when the curve overshoots past full progress at time t (Back and
    // Elastic families exceed 1 before settling).
    OvershootsAt(self: EasingFunction, t: Number): Boolean
        => self.Eval(t) > 1.0;

    // True when the curve anticipates below zero at time t (pulls back before
    // advancing, as the Back family does near the start).
    AnticipatesAt(self: EasingFunction, t: Number): Boolean
        => self.Eval(t) < 0.0;

    //==
    // # TimeVarying<TValue>
    //
    // A value sampled at a moment in time via Sample(time: Duration). Key times
    // are Duration offsets from the owner's start, so helpers take explicit
    // boundary Durations rather than assuming a clip length.
    //
    // The change/delta helpers subtract two samples, which the type variable
    // $TValue supports by the same duck-typing the interval helpers rely on
    // (IntervalLike.Extent subtracts two $T). A formal `where TValue: Additive`
    // bound on TimeVarying is deferred: its implementors span keyframes-tracks.plato
    // (AnimationTrack/TangentTrack) and motion-graphics.plato, which are outside
    // this package's edit scope, so the bound cannot be filled tree-wide here.

    // The sampled value at a time offset; a readable spelling of Sample.
    ValueAt(self: TimeVarying<$TValue>, time: Duration): $TValue
        => self.Sample(time);

    // The value sampled at the midpoint of the [earlier, later] time span.
    SampleAtMidpoint(self: TimeVarying<$TValue>, earlier: Duration, later: Duration): $TValue
        => self.Sample(earlier.MidPoint(later));

    // The signed change in value over the [earlier, later] time span:
    // Sample(later) - Sample(earlier).
    Change(self: TimeVarying<$TValue>, earlier: Duration, later: Duration): $TValue
        => self.Sample(later).Subtract(self.Sample(earlier));

    //==
    // # PathLike
    //
    // Anything presentable as a vector Path2D via ToPath. Structural summaries
    // read the resulting path's contour list (an Array, hence Countable).

    // The number of contours in the presented path.
    ContourCount(self: PathLike): Integer
        => self.ToPath.Contours.Count;

    // True when the presented path has no contours (draws nothing).
    IsEmpty(self: PathLike): Boolean
        => self.ToPath.Contours.Count == 0;

    // True when the presented path has at least one contour.
    IsNotEmpty(self: PathLike): Boolean
        => self.ToPath.Contours.Count > 0;

    //==
    // # Image
    //
    // A raster with known dimensions (Size, Width, Height in whole pixels).

    // The total number of pixels: Width times Height.
    PixelCount(self: Image): Integer
        => self.Width * self.Height;

    // The width-to-height ratio of the image. Width and Height are widened to
    // Number via Integer.ToNumber. Precondition: Height is non-zero.
    AspectRatio(self: Image): Number
        => self.Width.ToNumber / self.Height.ToNumber;

    // True when the image has zero area (no pixels).
    IsEmpty(self: Image): Boolean
        => self.Width * self.Height == 0;

    // True when the image is exactly as wide as it is tall.
    IsSquare(self: Image): Boolean
        => self.Width == self.Height;

    // True when the image is wider than it is tall.
    IsLandscape(self: Image): Boolean
        => self.Width > self.Height;

    // True when the image is taller than it is wide.
    IsPortrait(self: Image): Boolean
        => self.Width < self.Height;

    // The index of the rightmost column (Width - 1); negative when empty.
    LastColumn(self: Image): Integer
        => self.Width - 1;

    // The index of the bottom row (Height - 1); negative when empty.
    LastRow(self: Image): Integer
        => self.Height - 1;

    // True when column x lies within [0, Width).
    IsValidColumn(self: Image, x: Integer): Boolean
        => x >= 0 && x < self.Width;

    // True when row y lies within [0, Height).
    IsValidRow(self: Image, y: Integer): Boolean
        => y >= 0 && y < self.Height;

    // True when pixel coordinate (x, y) lies inside the image.
    ContainsPixel(self: Image, x: Integer, y: Integer): Boolean
        => x >= 0 && x < self.Width && y >= 0 && y < self.Height;

    // The row-major flat index of pixel (x, y): y * Width + x. Matches the
    // row-major, top-left-first storage convention of the concrete image types.
    PixelIndex(self: Image, x: Integer, y: Integer): Integer
        => y * self.Width + x;

    //==
    // # ProceduralTexture
    //
    // A pattern evaluated directly at a UV coordinate via ColorAt. The color's
    // alpha channel drives the opacity helpers.

    // The alpha (opacity) sampled at the UV coordinate, on the color's 0-255
    // per-channel scale (Color, file 14).
    OpacityAt(self: ProceduralTexture, uv: UvCoordinate): Number
        => self.ColorAt(uv).A;

    // True where the sampled texel is fully opaque (alpha at or above 255).
    IsOpaqueAt(self: ProceduralTexture, uv: UvCoordinate): Boolean
        => self.ColorAt(uv).A >= 255.0;

    // True where the sampled texel is fully transparent (alpha at or below 0).
    IsTransparentAt(self: ProceduralTexture, uv: UvCoordinate): Boolean
        => self.ColorAt(uv).A <= 0.0;

    //==
    // # Camera
    //
    // A placed camera exposing a pose, near/far clip distances, and an image
    // aspect ratio (width over height). Invariant: 0 < Near < Far, so DepthSpan is
    // positive. AspectRatio is now a Camera concept member: PerspectiveCamera and
    // OrthographicCamera satisfy it with their field; the bodies below discharge
    // the obligation for the camera types that derive it from their optics.

    // The camera's eye position in world space: the pose's translation.
    EyePosition(self: Camera): Point3D
        => self.Pose.Position;

    // The depth of the rendered range: Far - Near. Precondition: Near < Far, so
    // the span is positive.
    DepthSpan(self: Camera): Number
        => self.Far - self.Near;

    // The scene distance halfway between the near and far clip planes.
    // Precondition: Near < Far.
    DepthMidpoint(self: Camera): Number
        => self.Near.MidPoint(self.Far);

    // The far-to-near clip ratio; large values indicate a depth range prone to
    // z-fighting under a perspective depth buffer. Precondition: Near is positive.
    ClipRatio(self: Camera): Number
        => self.Far / self.Near;

    // True when a scene depth lies within the rendered [Near, Far] range.
    ContainsDepth(self: Camera, depth: Number): Boolean
        => depth >= self.Near && depth <= self.Far;

    // The image aspect ratio (width over height) of a physical camera, taken from
    // its sensor dimensions. Precondition: SensorSize.Height is positive.
    AspectRatio(self: PhysicalCamera): Number
        => self.SensorSize.Width / self.SensorSize.Height;

    // A fisheye lens draws into a square-bounded image circle, so its aspect ratio
    // is 1 (the FieldOfView is a cone angle, not a width-to-height ratio).
    AspectRatio(self: FisheyeCamera): Number
        => 1.0;

    // The aspect ratio of an equirectangular panorama: the longitude sweep over
    // the latitude sweep. Precondition: the latitude sweep is non-degenerate.
    AspectRatio(self: EquirectangularCamera): Number
        => self.LongitudeSweep.Extent.Radians / self.LatitudeSweep.Extent.Radians;

    // The aspect ratio of a cylindrical panorama: the horizontal sweep over the
    // vertical field of view. Precondition: VerticalFov is non-degenerate.
    AspectRatio(self: PanoramicCamera): Number
        => self.HorizontalSweep.Radians / self.VerticalFov.Radians;

    // True when the image is wider than it is tall (aspect ratio above 1).
    IsLandscape(self: Camera): Boolean
        => self.AspectRatio > 1.0;

    // True when the image is taller than it is wide (aspect ratio below 1).
    IsPortrait(self: Camera): Boolean
        => self.AspectRatio < 1.0;

    //==
    // # LightSource
    //
    // A scene light whose sole concept member is the shadow-casting flag.

    // True when the light contributes shadows; a readable spelling of CastsShadows.
    IsShadowCaster(self: LightSource): Boolean
        => self.CastsShadows;

    // True when the light casts no shadows.
    IsShadowless(self: LightSource): Boolean
        => self.CastsShadows.Not;

    //==
    // # Kinematic2D
    //
    // A planar motion sampled by PositionAt (meters) and VelocityAt (meters per
    // second). Times are Durations since the motion's start.

    // The scalar speed at a time: the velocity's magnitude, in meters per second.
    SpeedAt(self: Kinematic2D, time: Duration): Number
        => self.VelocityAt(time).Magnitude;

    // The straight-line displacement from the earlier to the later time.
    DisplacementBetween(self: Kinematic2D, earlier: Duration, later: Duration): Vector2D
        => self.PositionAt(earlier).Between(self.PositionAt(later));

    // The straight-line distance covered between the two times (chord length).
    DistanceBetween(self: Kinematic2D, earlier: Duration, later: Duration): Number
        => self.PositionAt(earlier).Between(self.PositionAt(later)).Magnitude;

    // The average velocity over [earlier, later]: displacement over elapsed
    // seconds. Precondition: earlier and later differ.
    AverageVelocityBetween(self: Kinematic2D, earlier: Duration, later: Duration): Vector2D
        => self.PositionAt(earlier).Between(self.PositionAt(later)) / (later.Seconds - earlier.Seconds);

    // The average speed over [earlier, later]: chord distance over elapsed
    // seconds. Precondition: earlier and later differ.
    AverageSpeedBetween(self: Kinematic2D, earlier: Duration, later: Duration): Number
        => self.DistanceBetween(earlier, later) / (later.Seconds - earlier.Seconds);

    // True when the body is (nearly) at rest at a time, within the given
    // non-negative speed tolerance.
    IsStationaryAt(self: Kinematic2D, time: Duration, tolerance: Number): Boolean
        => self.VelocityAt(time).Magnitude <= tolerance;

    //==
    // # Kinematic3D
    //
    // A spatial motion; mirrors the planar speed, displacement, and rest helpers.

    // The scalar speed at a time: the velocity's magnitude, in meters per second.
    SpeedAt(self: Kinematic3D, time: Duration): Number
        => self.VelocityAt(time).Magnitude;

    // The straight-line displacement from the earlier to the later time.
    DisplacementBetween(self: Kinematic3D, earlier: Duration, later: Duration): Vector3D
        => self.PositionAt(earlier).Between(self.PositionAt(later));

    // The straight-line distance covered between the two times (chord length).
    DistanceBetween(self: Kinematic3D, earlier: Duration, later: Duration): Number
        => self.PositionAt(earlier).Between(self.PositionAt(later)).Magnitude;

    // The average velocity over [earlier, later]: displacement over elapsed
    // seconds. Precondition: earlier and later differ.
    AverageVelocityBetween(self: Kinematic3D, earlier: Duration, later: Duration): Vector3D
        => self.PositionAt(earlier).Between(self.PositionAt(later)) / (later.Seconds - earlier.Seconds);

    // The average speed over [earlier, later]: chord distance over elapsed
    // seconds. Precondition: earlier and later differ.
    AverageSpeedBetween(self: Kinematic3D, earlier: Duration, later: Duration): Number
        => self.DistanceBetween(earlier, later) / (later.Seconds - earlier.Seconds);

    // True when the body is (nearly) at rest at a time, within the given
    // non-negative speed tolerance.
    IsStationaryAt(self: Kinematic3D, time: Duration, tolerance: Number): Boolean
        => self.VelocityAt(time).Magnitude <= tolerance;

    //==
    // # ForceModel2D
    //
    // A planar environmental force model: ForceOn yields the newton force on a
    // body in its current state.

    // The magnitude of the force exerted on the body, in newtons.
    ForceMagnitudeOn(self: ForceModel2D, body: RigidBody2D): Number
        => self.ForceOn(body).Magnitude;

    // The acceleration this force imparts to the body: force over mass (F = m a),
    // in meters per second squared. Precondition: the body's mass is positive.
    AccelerationOn(self: ForceModel2D, body: RigidBody2D): Vector2D
        => self.ForceOn(body) / body.MassProperties.Mass.Amount;

    // True when the force on the body is negligible, within the given
    // non-negative tolerance in newtons.
    IsNegligibleOn(self: ForceModel2D, body: RigidBody2D, tolerance: Number): Boolean
        => self.ForceOn(body).Magnitude <= tolerance;

    //==
    // # ForceModel3D
    //
    // A spatial environmental force model; mirrors the planar helpers.

    // The magnitude of the force exerted on the body, in newtons.
    ForceMagnitudeOn(self: ForceModel3D, body: RigidBody3D): Number
        => self.ForceOn(body).Magnitude;

    // The acceleration this force imparts to the body: force over mass (F = m a),
    // in meters per second squared. Precondition: the body's mass is positive.
    AccelerationOn(self: ForceModel3D, body: RigidBody3D): Vector3D
        => self.ForceOn(body) / body.MassProperties.Mass.Amount;

    // True when the force on the body is negligible, within the given
    // non-negative tolerance in newtons.
    IsNegligibleOn(self: ForceModel3D, body: RigidBody3D, tolerance: Number): Boolean
        => self.ForceOn(body).Magnitude <= tolerance;

    //==
    // # ProbabilityDistribution
    //
    // A univariate distribution exposing Mean, Variance, Pdf, and Cdf. The
    // derived surface is the tail and interval probabilities that read from Cdf,
    // plus density comparisons.

    // The standard deviation: the square root of the variance, in the same units
    // as the values. Precondition: the variance is non-negative.
    StandardDeviation(self: ProbabilityDistribution): Number
        => self.Variance.Sqrt;

    // The cumulative probability of drawing at most value; a readable spelling
    // of Cdf.
    ProbabilityAtMost(self: ProbabilityDistribution, value: Number): Number
        => self.Cdf(value);

    // The survival function at value: the probability of drawing more than
    // value, 1 - Cdf(value).
    SurvivalAt(self: ProbabilityDistribution, value: Number): Number
        => 1.0 - self.Cdf(value);

    // The probability mass in the half-open interval (low, high]: Cdf(high) -
    // Cdf(low). Precondition: low <= high.
    ProbabilityBetween(self: ProbabilityDistribution, low: Number, high: Number): Number
        => self.Cdf(high) - self.Cdf(low);

    // The precision: the reciprocal of the variance. Precondition: the variance
    // is positive (undefined for the degenerate and heavy-tailed cases).
    Precision(self: ProbabilityDistribution): Number
        => 1.0 / self.Variance;

    // True when value a is at least as likely (dense) as value b under this
    // distribution.
    IsAtLeastAsLikelyAs(self: ProbabilityDistribution, a: Number, b: Number): Boolean
        => self.Pdf(a) >= self.Pdf(b);

    //==
    // # GraphLike
    //
    // A vertex-and-edge structure exposing VertexCount, EdgeCount, and the
    // directedness flag. Helpers include the handshake-lemma degree sum and the
    // completeness test.

    // True when the graph is undirected.
    IsUndirected(self: GraphLike): Boolean
        => self.IsDirected.Not;

    // True when the graph has no vertices.
    IsEmpty(self: GraphLike): Boolean
        => self.VertexCount == 0;

    // True when the graph has at least one vertex.
    IsNotEmpty(self: GraphLike): Boolean
        => self.VertexCount > 0;

    // True when the graph has at least one edge.
    HasEdges(self: GraphLike): Boolean
        => self.EdgeCount > 0;

    // The sum of all vertex degrees. By the handshake lemma this is twice the
    // edge count, whether the graph is directed (in-degree plus out-degree) or
    // undirected.
    DegreeSum(self: GraphLike): Integer
        => self.EdgeCount * 2;

    // The maximum number of simple edges the graph could hold: V*(V-1) directed,
    // V*(V-1)/2 undirected (no self-loops, no parallel edges).
    MaxPossibleEdges(self: GraphLike): Integer
        => self.IsDirected
            ? self.VertexCount * (self.VertexCount - 1)
            : self.VertexCount * (self.VertexCount - 1) / 2;

    // True when the graph holds every possible simple edge. Precondition: the
    // graph is simple (no self-loops or parallel edges).
    IsComplete(self: GraphLike): Boolean
        => self.EdgeCount == self.MaxPossibleEdges;

    // The average vertex degree: the degree sum (2E) over the vertex count, as a
    // Number via Integer.ToNumber. Precondition: the graph is non-empty.
    AverageDegree(self: GraphLike): Number
        => self.DegreeSum.ToNumber / self.VertexCount.ToNumber;

    // The edge density: actual edges over the maximum possible simple edges, in
    // [0, 1]. Precondition: the graph has at least two vertices (MaxPossibleEdges > 0).
    EdgeDensity(self: GraphLike): Number
        => self.EdgeCount.ToNumber / self.MaxPossibleEdges.ToNumber;

    //==
    // # TimeSampled
    //
    // A time-indexed collection: SampleCount samples, each with a TimeAt(index).
    // Times are Instants, so a span is their Difference (a Duration).

    // True when the collection holds no samples.
    IsEmpty(self: TimeSampled): Boolean
        => self.SampleCount == 0;

    // True when the collection holds at least one sample.
    IsNotEmpty(self: TimeSampled): Boolean
        => self.SampleCount > 0;

    // The index of the last sample (SampleCount - 1); negative when empty.
    LastSampleIndex(self: TimeSampled): Integer
        => self.SampleCount - 1;

    // True when index addresses a real sample, within [0, SampleCount).
    IsValidSampleIndex(self: TimeSampled, index: Integer): Boolean
        => index >= 0 && index < self.SampleCount;

    // The time of the first sample. Precondition: the collection is not empty.
    FirstTime(self: TimeSampled): Instant
        => self.TimeAt(0);

    // The time of the last sample. Precondition: the collection is not empty.
    LastTime(self: TimeSampled): Instant
        => self.TimeAt(self.SampleCount - 1);

    // The elapsed span from the first to the last sample. Precondition: the
    // collection is not empty.
    TimeSpan(self: TimeSampled): Duration
        => self.TimeAt(0).Between(self.TimeAt(self.SampleCount - 1));

    //==
    // # GeoRegion
    //
    // A surface region that tests whether it contains a geodetic coordinate
    // (altitude ignored).

    // True when the coordinate lies outside the region.
    ExcludesCoordinate(self: GeoRegion, coordinate: GeoCoordinate): Boolean
        => self.ContainsCoordinate(coordinate).Not;
}
