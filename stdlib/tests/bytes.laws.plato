// Law library for Bytes: the byte-sequence primitive the STEP front end lexes from
// (intrinsics.library.plato, bytes.library.plato; TKT-1143).
//
// Same conventions as `text.laws.plato`: `Law_*` Boolean functions are universally quantified over
// their parameters; the runner generates Strings of lower-case letters, Bytes of lower-case letters,
// and Integers in [-8, 8]. A String is the oracle: every operation on Bytes is checked against the
// same operation on the String of the same characters (Latin-1, one byte per character), and the
// number reads against the String reads, which are in turn pinned by `text.laws.plato`.
// Nothing here spells an Integer wider than 32 bits, so the laws hold in every profile.
library BytesLaws
{
    // The bytes of "zz", then s: a view of s that starts at 2 of a longer array, for the laws that
    // must not care which array or offset a view has.
    Padded(s: String): Bytes
        => FromIntegers(Concatenate([122, 122], Ints(s)));

    //==
    // Conversion to and from String.

    // The bytes of a String, read back as text, are the String.
    Law_ToTextInvertsToBytes(s: String): Boolean
        => s.ToBytes.ToText == s;

    // The text of generated bytes, converted back, is the same bytes.
    Law_ToBytesInvertsToText(b: Bytes): Boolean
        => b.ToText.ToBytes == b;

    // Same length, and the same code at every index.
    Law_CountAndAtAgreeWithString(s: String): Boolean
        => s.ToBytes.Count == s.Count
        && s.Count.Range.All(i => s.ToBytes.At(i) == s.At(i).ToInteger);

    // Witness: the characters of "abc", their codes, and Latin-1 beyond ASCII (233 is e acute, written as a code because a C++ String is UTF-8).
    Law_ConversionWitness(): Boolean
        => "abc".ToBytes.Count == 3 && "abc".ToBytes.At(1) == 98 && "".ToBytes.Count == 0
        && FromIntegers([233]).ToText.At(0).ToInteger == 233 && FromIntegers([233]).ToText.ToBytes == FromIntegers([233])
        && "ab".ToBytes.ToText == "ab";

    // Every byte value 0 to 255 is one character of that code, alone and in one string, and the bytes come back.
    Law_ToTextCoversTheFullByteRange(): Boolean
        => 256.Range.All(i => FromIntegers([i]).ToText.Count == 1 && FromIntegers([i]).ToText.At(0).ToInteger == i)
        && FromIntegers(MapRange(256, i => i)).ToText.Count == 256
        && 256.Range.All(i => FromIntegers(MapRange(256, k => k)).ToText.At(i).ToInteger == i)
        && FromIntegers(MapRange(256, i => i)).ToText.ToBytes == FromIntegers(MapRange(256, i => i));

    // The text of a slice is the characters of its range only, whatever surrounds it, and the empty view gives "".
    Law_ToTextOfASliceSeesOnlyTheSlice(s: String, start: Integer, count: Integer): Boolean
        => Padded(s).SubBytes(2, s.Count).SubBytes(start, count).ToText == Substring(s, start, count)
        && FromIntegers([]).ToText == "";

    // FromIntegers keeps the low 8 bits of each integer, so a byte is always 0 to 255.
    Law_FromIntegersKeepsTheLowEightBits(): Boolean
        => FromIntegers([256 + 65]).At(0) == 65 && FromIntegers([-1]).At(0) == 255
        && FromIntegers([255]).At(0) == 255 && FromIntegers([0, 1, 2]).Count == 3
        && FromIntegers(MapRange(0, i => i)).Count == 0 && FromIntegers(MapRange(0, i => i)) == "".ToBytes;

    //==
    // Slices. SubBytes clamps as Substring does, so Substring on the String is the oracle.

    // The clamped range is the String's Substring, for every start and count, negative or past the end.
    Law_SubBytesAgreesWithSubstring(s: String, start: Integer, count: Integer): Boolean
        => s.ToBytes.SubBytes(start, count).ToText == Substring(s, start, count);

    // The length is the size of the intersection of [start, start + count) with [0, Count).
    Law_SubBytesCountIsTheClampedRange(s: String, start: Integer, count: Integer): Boolean
        => s.ToBytes.SubBytes(start, count).Count
            == (count <= 0 ? 0 : (start + count).Min(s.Count).Subtract(start.Max(0)).Max(0));

    // A slice of a slice is the String's slice of its slice: the offsets add, the clamps compose.
    Law_SliceOfSliceAgreesWithSubstring(s: String, a: Integer, m: Integer, b: Integer, n: Integer): Boolean
        => s.ToBytes.SubBytes(a, m).SubBytes(b, n).ToText == Substring(Substring(s, a, m), b, n);

    // Slicing a view that starts inside a longer array reads only its own range: no byte of the
    // padding "zz" is ever visible, whatever the start and count.
    Law_ASliceNeverSeesOutsideItsView(s: String, start: Integer, count: Integer): Boolean
        => Padded(s).SubBytes(2, s.Count).SubBytes(start, count).ToText == Substring(s, start, count);

    // The endpoint form is the count form with count = exclusiveTo - from.
    Law_SliceIsHalfOpenByEndpoint(s: String, lo: Integer, hi: Integer): Boolean
        => s.ToBytes.Slice(lo, hi) == s.ToBytes.SubBytes(lo, hi - lo)
        && s.ToBytes.Slice(0, s.Count) == s.ToBytes;

    // Witness: the slice of a slice names the same bytes, and a view equals a fresh copy of them.
    Law_SliceWitness(): Boolean
        => "abcd".ToBytes.Slice(1, 3) == "bc".ToBytes && "abcd".ToBytes.SubBytes(1, 2) == "bc".ToBytes
        && "abcd".ToBytes.SubBytes(3, 9) == "d".ToBytes && "abcd".ToBytes.SubBytes(-1, 3) == "ab".ToBytes
        && "abcd".ToBytes.SubBytes(4, 1).Count == 0 && "abcd".ToBytes.SubBytes(0, 0).Count == 0
        && "abcd".ToBytes.SubBytes(1, 3).SubBytes(1, 1) == "c".ToBytes
        && "abcd".ToBytes.SubBytes(1, 3).SubBytes(2, 5) == "d".ToBytes
        && "abcd".ToBytes.SubBytes(1, 3).At(0) == 98 && "abcd".ToBytes.SubBytes(1, 3).Count == 3;

    //==
    // Equality and order. String order is ordinal (TKT-1124), so it is the oracle.

    // Equal Bytes are equal Strings.
    Law_EqualsAgreesWithString(a: String, b: String): Boolean
        => (a.ToBytes == b.ToBytes) == (a == b) && (a.ToBytes != b.ToBytes) == (a != b);

    // The order, strict and not, agrees with String's.
    Law_OrderAgreesWithStringOrdinal(a: String, b: String): Boolean
        => (a.ToBytes <= b.ToBytes) == (a <= b) && (a.ToBytes < b.ToBytes) == (a < b)
        && (a.ToBytes >= b.ToBytes) == (a >= b) && (a.ToBytes > b.ToBytes) == (a > b);

    // Compare is -1, 0 or 1 as String's is.
    Law_CompareAgreesWithString(a: String, b: String): Boolean
        => a.ToBytes.Compare(b.ToBytes) == a.Compare(b);

    // Compare of Bytes is negative, zero or positive as the order says, and flips with the arguments.
    Law_CompareIsAntisymmetric(a: Bytes, b: Bytes): Boolean
        => a.Compare(b) == 0 - b.Compare(a) && (a.Compare(b) == 0) == (a == b);

    // A total order: any two are comparable, and it is transitive.
    Law_OrderIsTotalAndTransitive(a: Bytes, b: Bytes, c: Bytes): Boolean
        => (a <= b || b <= a) && (!(a <= b && b <= c) || a <= c);

    // A prefix precedes its extension.
    Law_PrefixPrecedesExtension(a: Bytes, b: Bytes): Boolean
        => a <= FromIntegers(Concatenate(MapRange(a.Count, i => a.At(i)), MapRange(b.Count, i => b.At(i))));

    // Bytes order as unsigned values: 255 is after 1, not before, and "B" precedes "a".
    Law_OrderWitness(): Boolean
        => FromIntegers([255]) > FromIntegers([1]) && "B".ToBytes < "a".ToBytes
        && "ab".ToBytes < "abc".ToBytes && !("abc".ToBytes <= "ab".ToBytes)
        && "".ToBytes < "a".ToBytes && "".ToBytes == "".ToBytes
        && "abc".ToBytes.Compare("abd".ToBytes) == -1 && "abd".ToBytes.Compare("abc".ToBytes) == 1
        && "abc".ToBytes.Compare("abc".ToBytes) == 0;

    // Two views of different arrays and offsets that show the same bytes are equal.
    Law_EqualityIgnoresArrayAndOffset(s: String): Boolean
        => Padded(s).Slice(2, 2 + s.Count) == s.ToBytes && Padded(s).Slice(2, 2 + s.Count).Compare(s.ToBytes) == 0;

    //==
    // Hash: FNV-1a, 32 bits (intrinsics.library.plato). The test vectors are the published ones
    // (a: 0xE40C292C, foo: 0xA9F37ED7, foobar: 0xBF9CF968), compared as 16-bit halves so the laws
    // do not spell a constant wider than a 32-bit Integer.

    // The 16 low and 16 high bits of the hash.
    Low(h: Integer): Integer => h.BitwiseAnd(65535);
    High(h: Integer): Integer => h.ShiftRight(16).BitwiseAnd(65535);

    Law_HashWitness(): Boolean
        => Low("".ToBytes.Hash) == 40389 && High("".ToBytes.Hash) == 33052
        && Low("a".ToBytes.Hash) == 10540 && High("a".ToBytes.Hash) == 58380
        && Low("foo".ToBytes.Hash) == 32471 && High("foo".ToBytes.Hash) == 43507
        && Low("foobar".ToBytes.Hash) == 63848 && High("foobar".ToBytes.Hash) == 49052;

    // The hash depends on the bytes alone, not on the array they sit in or where.
    Law_HashIgnoresArrayAndOffset(s: String): Boolean
        => Padded(s).Slice(2, 2 + s.Count).Hash == s.ToBytes.Hash;

    // Equal bytes hash equal; the hash of a prefix range is the hash of the same bytes alone.
    Law_HashOfASliceIsTheHashOfItsBytes(s: String, start: Integer, count: Integer): Boolean
        => s.ToBytes.SubBytes(start, count).Hash == Substring(s, start, count).ToBytes.Hash;

    // Order matters and so does length.
    Law_HashDistinguishesWitness(): Boolean
        => "ab".ToBytes.Hash != "ba".ToBytes.Hash && "a".ToBytes.Hash != "aa".ToBytes.Hash
        && "".ToBytes.Hash != "a".ToBytes.Hash;

    //==
    // Numbers. ParseNumber on Bytes is the String's ParseNumber, bit for bit.

    // Accepted forms and their values, including those the P21 text uses: a trailing point,
    // a leading point, an explicit plus, an exponent with a sign, and the signed zero.
    Law_ParseNumberAcceptedForms(): Boolean
        => ParseNumber("1.".ToBytes).Value == 1.0 && ParseNumber("1.".ToBytes).Ok
        && ParseNumber("-0.5E-3".ToBytes).Value == -0.0005 && ParseNumber("-0.5E-3".ToBytes).Ok
        && ParseNumber(".5".ToBytes).Value == 0.5 && ParseNumber(".5".ToBytes).Ok
        && ParseNumber("+2".ToBytes).Value == 2.0 && ParseNumber("+2".ToBytes).Ok
        && ParseNumber("1.E-06".ToBytes).Value == 0.000001 && ParseNumber("1.E-06".ToBytes).Ok
        && ParseNumber("1.5e1".ToBytes).Value == 15.0 && ParseNumber("0".ToBytes).Ok
        && ParseNumber("123".ToBytes).Value == 123.0 && ParseNumber("-1.5E+2".ToBytes).Value == -150.0
        && ParseNumber("-0".ToBytes).Ok && 1.0 / ParseNumber("-0".ToBytes).Value < 0.0
        && 1.0 / ParseNumber("0".ToBytes).Value > 0.0;

    // Everything else is rejected with value 0: no digits, a bare exponent, words, hex, spaces,
    // a comma, two signs, two points, and a value that rounds to infinity.
    Law_ParseNumberRejectedForms(): Boolean
        => !ParseNumber("".ToBytes).Ok && !ParseNumber(".".ToBytes).Ok && !ParseNumber("1e".ToBytes).Ok
        && !ParseNumber("e5".ToBytes).Ok && !ParseNumber("+".ToBytes).Ok && !ParseNumber("-".ToBytes).Ok
        && !ParseNumber("NaN".ToBytes).Ok && !ParseNumber("Infinity".ToBytes).Ok && !ParseNumber("0x10".ToBytes).Ok
        && !ParseNumber(" 1".ToBytes).Ok && !ParseNumber("1 ".ToBytes).Ok && !ParseNumber("1,5".ToBytes).Ok
        && !ParseNumber("--1".ToBytes).Ok && !ParseNumber("1.5.2".ToBytes).Ok && !ParseNumber("1e999".ToBytes).Ok
        && !ParseNumber("1e+".ToBytes).Ok && !ParseNumber("1e5.5".ToBytes).Ok
        && ParseNumber("1e999".ToBytes).Value == 0.0 && ParseNumber("abc".ToBytes).Value == 0.0;

    // The correctly rounded values of the hard cases: a tie between two doubles rounds to even,
    // an underflow is zero, 0.1 is the double nearest to a tenth.
    Law_ParseNumberIsCorrectlyRounded(): Boolean
        => ParseNumber("0.1".ToBytes).Value == 0.1 && ParseNumber("9007199254740993".ToBytes).Value == 9007199254740992.0
        && ParseNumber("9007199254740995".ToBytes).Value == 9007199254740996.0
        && ParseNumber("1e-400".ToBytes).Value == 0.0 && ParseNumber("1e-400".ToBytes).Ok;

    // The read starts and stops at the view's own range, whatever surrounds it in the array.
    Law_ParseNumberReadsOnlyItsRange(): Boolean
        => ParseNumber("xx1.5E1yy".ToBytes.Slice(2, 7)).Value == 15.0 && ParseNumber("xx1.5E1yy".ToBytes.Slice(2, 7)).Ok
        && !ParseNumber("xx1.5E1yy".ToBytes.Slice(2, 8)).Ok && !ParseNumber("xx1.5E1yy".ToBytes.Slice(1, 7)).Ok
        && ParseNumber("1e5".ToBytes.Slice(0, 1)).Value == 1.0 && !ParseNumber("1e5".ToBytes.Slice(0, 2)).Ok;

    // The Bytes read agrees with the String read on generated text (words: both reject).
    Law_ParseNumberAgreesWithStringOnWords(s: String): Boolean
        => ParseNumber(s.ToBytes).Ok == ParseNumber(s).Ok && ParseNumber(s.ToBytes).Value == ParseNumber(s).Value;

    // And on numbers the library writes: the shortest text of x reads back as x from bytes.
    Law_ParseNumberRoundTripsNumberToShortestString(x: Number): Boolean
        => ParseNumber(NumberToShortestString(x).ToBytes).Ok && ParseNumber(NumberToShortestString(x).ToBytes).Value == x;

    // And on a plus sign in front of it, which the form allows, and a space after it, which it does not.
    Law_ParseNumberAgreesWithStringOnVariants(x: Number): Boolean
        => SameNumber(FromIntegers(Concatenate([43], Ints(NumberToShortestString(x)))))
        && SameNumber(FromIntegers(Concatenate(Ints(NumberToShortestString(x)), [32])))
        && !ParseNumber(FromIntegers(Concatenate(Ints(NumberToShortestString(x)), [32]))).Ok;

    SameNumber(b: Bytes): Boolean
        => ParseNumber(b).Ok == ParseNumber(b.ToText).Ok && ParseNumber(b).Value == ParseNumber(b.ToText).Value;

    Ints(s: String): Array<Integer>
        => MapRange(s.Count, i => s.At(i).ToInteger);

    // The raw intrinsic: NaN for a rejected text, the value otherwise, and no other input gives NaN.
    Law_NumberFromBytesIsNaNOnlyWhenRejected(): Boolean
        => "abc".ToBytes.NumberFromBytes.IsNaN && "1e".ToBytes.NumberFromBytes.IsNaN && "".ToBytes.NumberFromBytes.IsNaN
        && "1e999".ToBytes.NumberFromBytes.IsNaN && !"1.5".ToBytes.NumberFromBytes.IsNaN
        && "1.5".ToBytes.NumberFromBytes == 1.5 && "-0.5E-3".ToBytes.NumberFromBytes == -0.0005;

    //==
    // Integers.

    // Accepted forms: a sign is optional, leading zeros are digits, negative zero is zero.
    Law_ParseIntegerAcceptedForms(): Boolean
        => ParseInteger("-12".ToBytes).Value == -12 && ParseInteger("-12".ToBytes).Ok
        && ParseInteger("+7".ToBytes).Value == 7 && ParseInteger("+7".ToBytes).Ok
        && ParseInteger("007".ToBytes).Value == 7 && ParseInteger("0".ToBytes).Ok
        && ParseInteger("-0".ToBytes).Value == 0 && ParseInteger("-0".ToBytes).Ok
        && ParseInteger("2147483647".ToBytes).Value == 2147483647 && ParseInteger("2147483647".ToBytes).Ok
        && ParseInteger("-2147483647".ToBytes).Value == -2147483647 && ParseInteger("-2147483647".ToBytes).Ok;

    // Rejected forms have value 0: no digits, a point, an exponent, a space, a letter.
    Law_ParseIntegerRejectedForms(): Boolean
        => !ParseInteger("".ToBytes).Ok && !ParseInteger("+".ToBytes).Ok && !ParseInteger("-".ToBytes).Ok
        && !ParseInteger("1.0".ToBytes).Ok && !ParseInteger("1e3".ToBytes).Ok && !ParseInteger(" 1".ToBytes).Ok
        && !ParseInteger("1 ".ToBytes).Ok && !ParseInteger("--1".ToBytes).Ok && !ParseInteger("1a".ToBytes).Ok
        && !ParseInteger("99999999999999999999".ToBytes).Ok && !ParseInteger("-99999999999999999999".ToBytes).Ok
        && ParseInteger("99999999999999999999".ToBytes).Value == 0 && ParseInteger("1.0".ToBytes).Value == 0;

    // The range limits agree with the String read in the profile at hand: at the edge of
    // 64 bits, at the edge of 32, one past either, and far past.
    Law_ParseIntegerAgreesWithStringAtTheLimits(): Boolean
        => SameInteger("9223372036854775807") && SameInteger("9223372036854775808") && SameInteger("-9223372036854775808")
        && SameInteger("-9223372036854775809") && SameInteger("2147483647") && SameInteger("2147483648")
        && SameInteger("-2147483648") && SameInteger("-2147483649") && SameInteger("4294967296")
        && SameInteger("18446744073709551616") && SameInteger("0000000000000000000000000000012")
        && SameInteger("-0000000000000000000000000000012") && SameInteger("+9223372036854775807");

    SameInteger(t: String): Boolean
        => ParseInteger(t.ToBytes).Ok == ParseInteger(t).Ok && ParseInteger(t.ToBytes).Value == ParseInteger(t).Value;

    // The most negative Integer is reachable (the digits accumulate negatively, so no wider type is
    // needed), in whichever profile is at hand.
    Law_ParseIntegerReachesTheMinimum(): Boolean
        => (Integer.MaxValue == 2147483647 || (ParseInteger("-9223372036854775808".ToBytes).Value == Integer.MinValue
            && ParseInteger("-9223372036854775808".ToBytes).Ok))
        && (Integer.MaxValue != 2147483647 || (ParseInteger("-2147483648".ToBytes).Value == Integer.MinValue
            && ParseInteger("-2147483648".ToBytes).Ok));

    // The read stops at the view's range.
    Law_ParseIntegerReadsOnlyItsRange(): Boolean
        => ParseInteger("xx-123yy".ToBytes.Slice(2, 6)).Value == -123 && ParseInteger("xx-123yy".ToBytes.Slice(2, 6)).Ok
        && !ParseInteger("xx-123yy".ToBytes.Slice(2, 7)).Ok && ParseInteger("12345".ToBytes.Slice(1, 3)).Value == 23;

    // The Bytes read agrees with the String read on generated words and on small integers.
    Law_ParseIntegerAgreesWithString(s: String, n: Integer): Boolean
        => ParseInteger(s.ToBytes).Ok == ParseInteger(s).Ok
        && ParseInteger(NumberToShortestString(n.ToNumber).ToBytes).Value == n
        && ParseInteger(NumberToShortestString(n.ToNumber).ToBytes).Ok;
}
