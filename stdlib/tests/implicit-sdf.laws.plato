// Law library for the signed-distance primitives and distance operators
// (stdlib/geometry/implicit-sdf.library.plato).
//
// Same harness and conventions as foundation.laws.plato: Law_-prefixed Boolean
// functions, merged with stdlib/ only by tools/regen-forward-conformance.ps1.
// LawEq lives in FoundationLaws and is reused here.
// Every member referenced was verified against stdlib/geometry/implicit-sdf.library.plato
// (LIBRARIES.md rule 3).
//
// Every law below is over the closed-form primitives and the scalar distance
// operators, whose arguments are ordinary points, vectors and numbers. The field
// TYPES (FunctionSdf*, PlacedSdf*) are deliberately absent: each stores a lambda,
// which the law runner has no way to instantiate. The properties those types owe —
// that placement preserves distance, and that a placed gradient is the source
// gradient turned by the pose — are stated in their doc comments and are not
// covered here (plato-409).
//
// The theme is redundancy between independently written bodies: each law pins one
// primitive against a DIFFERENT primitive that must agree with it in a degenerate
// case. A law that merely restated a body's own formula would pass for any sign
// error made consistently in both places.
library ImplicitSdfLaws
{
    //==
    // Degenerate cases where one primitive must reduce to another.

    // Rounding by zero leaves the box unchanged: the rounded-box body inflates the
    // half-extents and subtracts the radius back off, so a zero radius must cancel.
    Law_RoundedBoxAtZeroRadiusIsBox(p: Point3D, halfExtents: Vector3D): Boolean
        => DistanceToRoundedBox(p, halfExtents, 0.0).LawEq(DistanceToBox(p, halfExtents));

    // The planar form of the same cancellation.
    Law_RoundedBox2DAtZeroRadiusIsBox(p: Point2D, halfExtents: Vector2D): Boolean
        => DistanceToRoundedBox(p, halfExtents, 0.0).LawEq(DistanceToBox(p, halfExtents));

    // A capsule whose two endpoints coincide at the origin is a sphere. Cross-checks
    // the segment-based capsule against the closed-form sphere.
    Law_DegenerateCapsuleIsSphere(p: Point3D, radius: Number): Boolean
        => DistanceToCapsule(p, Point3D(0.0, 0.0, 0.0), Point3D(0.0, 0.0, 0.0), radius)
            .LawEq(DistanceToSphere(p, radius));

    // A planar capsule with coincident endpoints is a circle.
    Law_DegenerateCapsule2DIsCircle(p: Point2D, radius: Number): Boolean
        => DistanceToCapsule(p, Point2D(0.0, 0.0), Point2D(0.0, 0.0), radius)
            .LawEq(DistanceToCircle(p, radius));

    // The vertical capsule is the general capsule running from the origin along Y.
    // Two independently written bodies that must agree everywhere.
    Law_VerticalCapsuleIsCapsuleAlongY(p: Point3D, height: Number, radius: Number): Boolean
        => DistanceToVerticalCapsule(p, height, radius)
            .LawEq(DistanceToCapsule(p, Point3D(0.0, 0.0, 0.0), Point3D(0.0, height, 0.0), radius));

    // A ring of zero thickness is the unsigned distance to its centre circle: the
    // ring is inside-out on both sides of the curve, so the sign cancels.
    Law_ZeroThicknessRingIsUnsignedCircle(p: Point2D, radius: Number): Boolean
        => DistanceToRing(p, radius, 0.0).LawEq(DistanceToCircle(p, radius).Abs);

    //==
    // The cone family collapses onto the primitives it generalizes.
    //
    // DistanceToCappedCone, DistanceToCappedCylinder and DistanceToCone are three
    // independently written exact bodies. Each law below forces two of them to agree
    // on a shape both can describe, which is the only cheap way to catch a sign or
    // index slip in a formula this long.

    // A capped cone with equal radii IS a capped cylinder.
    Law_EqualRadiusCappedConeIsCylinder(p: Point3D, halfHeight: Number, radius: Number): Boolean
        => DistanceToCappedCone(p, halfHeight, radius, radius)
            .LawEq(DistanceToCappedCylinder(p, halfHeight, radius));

    // A cone with its apex at the origin opening along +Y is the capped cone that
    // tapers to nothing, once the capped cone's centred frame is shifted onto the
    // cone's apex-at-origin frame. Guarded to the body's own precondition: the half
    // angle must be strictly between zero and a quarter turn.
    Law_ConeIsDegenerateCappedCone(p: Point3D, halfAngle: Angle, height: Number): Boolean
        => halfAngle.Sin <= 0.0 || halfAngle.Cos <= 0.0 || height <= 0.0
        || DistanceToCone(p, halfAngle, height)
            .LawEq(DistanceToCappedCone(
                Point3D(p.X, p.Y - height * 0.5, p.Z),
                height * 0.5,
                height * halfAngle.Sin / halfAngle.Cos,
                0.0));

    //==
    // Dimensional lifts.

    // Extruding a circle along Z is a capped cylinder about Z — the same solid the
    // spatial primitive describes about Y, so the axes are swapped to compare.
    Law_ExtrudedCircleIsCappedCylinder(p: Point3D, radius: Number, halfHeight: Number): Boolean
        => ExtrudedDistance(DistanceToCircle(Point2D(p.X, p.Y), radius), p.Z, halfHeight)
            .LawEq(DistanceToCappedCylinder(Point3D(p.X, p.Z, p.Y), halfHeight, radius));

    // Revolving about the Y axis with no offset sends a point to its distance from
    // that axis, so a revolved planar circle centred on the axis is a sphere.
    Law_RevolvedCircleIsSphere(p: Point3D, radius: Number): Boolean
        => DistanceToCircle(RevolvedPoint(p, 0.0), radius).LawEq(DistanceToSphere(p, radius));

    // Folding is idempotent: a position already in the +X half-space does not move.
    Law_MirrorXIsIdempotent(p: Point3D): Boolean
        => MirroredX(MirroredX(p)).X.LawEq(MirroredX(p).X);

    // Folding both axes at once is folding each in turn.
    Law_MirrorXZIsBothFolds(p: Point3D): Boolean
        => MirroredXZ(p).X.LawEq(MirroredZ(MirroredX(p)).X)
        && MirroredXZ(p).Z.LawEq(MirroredZ(MirroredX(p)).Z);

    //==
    // Planar and spatial primitives agree on the plane they share.
    //
    // Each planar primitive must equal its spatial counterpart evaluated on the
    // z = 0 slice through the shape's own centre. This is what "the 2D family
    // matches the 3D family" means operationally.

    // A circle is the z = 0 slice of the sphere of the same radius.
    Law_CircleIsSphereSlice(p: Point2D, radius: Number): Boolean
        => DistanceToCircle(p, radius).LawEq(DistanceToSphere(Point3D(p.X, p.Y, 0.0), radius));

    // A rectangle is the z = 0 slice of the box with the same half-extents in x and
    // y. The slice's own half-extent in z is irrelevant at z = 0 as long as it is
    // not the nearest face, so it is taken larger than the others.
    Law_BoxIsBoxSlice(p: Point2D, halfExtents: Vector2D): Boolean {
        var depth = halfExtents.X.Max(halfExtents.Y) + 1.0;
        return DistanceToBox(p, halfExtents)
            .LawEq(DistanceToBox(
                Point3D(p.X, p.Y, 0.0),
                Vector3D(halfExtents.X, halfExtents.Y, depth)));
    }

    // A line is the z = 0 slice of the plane with the same in-plane normal.
    Law_LineIsPlaneSlice(p: Point2D, normal: Vector2D, offset: Number): Boolean
        => DistanceToLine(p, normal, offset)
            .LawEq(DistanceToPlane(
                Point3D(p.X, p.Y, 0.0),
                Vector3D(normal.X, normal.Y, 0.0),
                offset));

    //==
    // Distance-operator algebra.
    //
    // The scalar CSG kernels are Min/Max underneath, so their laws are the lattice
    // identities plus the relations between the sharp and smooth forms.

    // Subtraction is intersection against the complement, which is what makes the
    // sign convention of Difference consistent with Intersection.
    Law_SubtractIsIntersectWithComplement(a: Number, b: Number): Boolean
        => SubtractDistance(a, b).LawEq(IntersectionDistance(a, b.Negative));

    // Union and intersection are commutative.
    Law_UnionIsCommutative(a: Number, b: Number): Boolean
        => UnionDistance(a, b).LawEq(UnionDistance(b, a));

    Law_IntersectionIsCommutative(a: Number, b: Number): Boolean
        => IntersectionDistance(a, b).LawEq(IntersectionDistance(b, a));

    // Union with self changes nothing (idempotence), and likewise intersection.
    Law_UnionIsIdempotent(a: Number): Boolean
        => UnionDistance(a, a).LawEq(a);

    Law_IntersectionIsIdempotent(a: Number): Boolean
        => IntersectionDistance(a, a).LawEq(a);

    // The union of two shapes is contained in each, so its distance is no greater
    // than either operand's — the absorption direction that makes Union a minimum.
    Law_UnionIsNoGreaterThanOperands(a: Number, b: Number): Boolean
        => UnionDistance(a, b) <= a && UnionDistance(a, b) <= b;

    // Intersection is the dual: no less than either operand.
    Law_IntersectionIsNoLessThanOperands(a: Number, b: Number): Boolean
        => IntersectionDistance(a, b) >= a && IntersectionDistance(a, b) >= b;

    // Exclusive-or is symmetric in its operands.
    Law_ExclusiveOrIsCommutative(a: Number, b: Number): Boolean
        => ExclusiveOrDistance(a, b).LawEq(ExclusiveOrDistance(b, a));

    //==
    // Smooth operators against their sharp counterparts.

    // Smoothing a union only ever rounds material ON: the blended distance is never
    // greater than the sharp minimum. Precondition mirrors the body's — a positive
    // blend radius.
    Law_SmoothUnionIsNoGreaterThanUnion(a: Number, b: Number, blendRadius: Number): Boolean
        => blendRadius <= 0.0
        || SmoothUnionDistance(a, b, blendRadius) <= UnionDistance(a, b) + 1e-4;

    // Smooth union is symmetric, like the sharp form it blends.
    Law_SmoothUnionIsCommutative(a: Number, b: Number, blendRadius: Number): Boolean
        => blendRadius <= 0.0
        || SmoothUnionDistance(a, b, blendRadius).LawEq(SmoothUnionDistance(b, a, blendRadius));

    // Smooth intersection is the De Morgan dual of smooth union, which is how the
    // body is defined; asserting it here pins the negation from being dropped.
    Law_SmoothIntersectionIsDualOfSmoothUnion(a: Number, b: Number, blendRadius: Number): Boolean
        => blendRadius <= 0.0
        || SmoothIntersectionDistance(a, b, blendRadius)
            .LawEq(SmoothUnionDistance(a.Negative, b.Negative, blendRadius).Negative);

    //==
    // Chamfered, circular and exponential joins against the sharp operators.

    // A chamfer only ever removes material from the sharp corner, never adds: the
    // bevel plane term can lower the minimum but the leading Min keeps it from
    // rising. Guarded to the body's precondition.
    Law_ChamferUnionIsNoGreaterThanUnion(a: Number, b: Number, width: Number): Boolean
        => width <= 0.0
        || ChamferUnionDistance(a, b, width) <= UnionDistance(a, b) + 1e-4;

    // Chamfered union is symmetric.
    Law_ChamferUnionIsCommutative(a: Number, b: Number, width: Number): Boolean
        => width <= 0.0
        || ChamferUnionDistance(a, b, width).LawEq(ChamferUnionDistance(b, a, width));

    // Chamfered difference is chamfered intersection against the complement — the
    // relation that keeps its sign convention consistent with the sharp operators.
    Law_ChamferDifferenceIsIntersectWithComplement(a: Number, b: Number, width: Number): Boolean
        => width <= 0.0
        || ChamferDifferenceDistance(a, b, width)
            .LawEq(ChamferIntersectionDistance(a, b.Negative, width));

    // The exact circular fillet, like every union variant, is symmetric.
    Law_CircularUnionIsCommutative(a: Number, b: Number, radius: Number): Boolean
        => radius <= 0.0
        || CircularUnionDistance(a, b, radius).LawEq(CircularUnionDistance(b, a, radius));

    // Far from the seam — where both operands exceed the fillet radius — the exact
    // circular union has nothing to round and must agree with the sharp minimum.
    Law_CircularUnionAwayFromSeamIsUnion(a: Number, b: Number, radius: Number): Boolean
        => radius <= 0.0 || a < radius || b < radius
        || CircularUnionDistance(a, b, radius).LawEq(UnionDistance(a, b));

    // The exponential smooth minimum is ASSOCIATIVE, which is the property that
    // distinguishes it from the polynomial form: combining three distances gives the
    // same answer whichever pair is blended first. The polynomial SmoothUnionDistance
    // does NOT satisfy this, which is why no matching law exists for it.
    Law_ExponentialSmoothUnionIsAssociative(a: Number, b: Number, c: Number, blendRadius: Number): Boolean
        => blendRadius <= 0.0
        || ExponentialSmoothUnionDistance(ExponentialSmoothUnionDistance(a, b, blendRadius), c, blendRadius)
            .LawEq(ExponentialSmoothUnionDistance(a, ExponentialSmoothUnionDistance(b, c, blendRadius), blendRadius));

    // Exponential smoothing, like the polynomial form, never exceeds the sharp
    // minimum it approximates.
    Law_ExponentialSmoothUnionIsNoGreaterThanUnion(a: Number, b: Number, blendRadius: Number): Boolean
        => blendRadius <= 0.0
        || ExponentialSmoothUnionDistance(a, b, blendRadius) <= UnionDistance(a, b) + 1e-4;

    //==
    // Complement and morph.

    // Complementing twice is the identity.
    Law_ComplementIsInvolution(a: Number): Boolean
        => ComplementDistance(ComplementDistance(a)).LawEq(a);

    // Difference is intersection against a complement, stated through the operator
    // rather than through raw negation.
    Law_SubtractIsIntersectWithComplementOperator(a: Number, b: Number): Boolean
        => SubtractDistance(a, b).LawEq(IntersectionDistance(a, ComplementDistance(b)));

    // A morph at its endpoints recovers each operand exactly.
    Law_MorphAtZeroIsFirst(a: Number, b: Number): Boolean
        => MorphDistance(a, b, 0.0).LawEq(a);

    Law_MorphAtOneIsSecond(a: Number, b: Number): Boolean
        => MorphDistance(a, b, 1.0).LawEq(b);

    //==
    // Joints. A groove and a tongue of the same dimensions are complementary cuts,
    // which is what lets them mate.

    // A groove of zero depth removes nothing.
    Law_ZeroDepthGrooveIsUnchanged(a: Number, b: Number, halfWidth: Number): Boolean
        => GrooveDistance(a, b, 0.0, halfWidth).LawEq(a.Max(a.Min(halfWidth - b.Abs)));

    // A tongue of zero height adds nothing.
    Law_ZeroHeightTongueIsUnchanged(a: Number, b: Number, halfWidth: Number): Boolean
        => TongueDistance(a, b, 0.0, halfWidth).LawEq(a.Min(a.Max(b.Abs - halfWidth)));

    // A pipe is radially symmetric in its two guiding surfaces.
    Law_PipeIsCommutative(a: Number, b: Number, radius: Number): Boolean
        => PipeDistance(a, b, radius).LawEq(PipeDistance(b, a, radius));

    //==
    // Modifier arithmetic.

    // Rounding inflates: a positive radius moves every distance inward by exactly
    // that much, so the surface moves outward.
    Law_RoundingSubtractsRadius(radius: Number, distance: Number): Boolean
        => SdfRoundingModifier(radius).ApplyToDistance(distance).LawEq(distance - radius);

    // A shell is symmetric about the source surface: points equidistant inside and
    // outside land at the same shell distance.
    Law_ShellIsSymmetricAboutSurface(thickness: Number, distance: Number): Boolean
        => SdfShellModifier(thickness).ApplyToDistance(distance)
            .LawEq(SdfShellModifier(thickness).ApplyToDistance(distance.Negative));

    // An onion of one layer reaches exactly one thickness inward.
    Law_SingleOnionDepthIsThickness(thickness: Number): Boolean
        => SdfOnionModifier(thickness, 1).TotalDepth.LawEq(thickness);
}
