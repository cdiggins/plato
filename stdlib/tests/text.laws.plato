// Law library for the text intrinsics the STEP parser needs: FromCharacters, Substring,
// ParseNumber, ParseInteger and NumberToShortestString (intrinsics.library.plato,
// text.library.plato).
//
// Same conventions as `foundation.laws.plato`: `Law_*` Boolean functions are universally
// quantified over their parameters; the runner generates Strings of lower-case letters and
// Numbers in [-10, 10], so the laws that need other text state it as a literal witness.
library TextLaws
{
    //==
    // FromCharacters.

    // The characters of a String, rebuilt, are the String.
    Law_FromCharactersOfCharactersIsIdentity(s: String): Boolean
        => FromCharacters(MapRange(s.Count, i => s.At(i))) == s;

    // Two-line witness: the characters of "ab" in reverse order make "ba"; none make "".
    Law_FromCharactersWitness(): Boolean
        => FromCharacters(["ab".At(1), "ab".At(0)]) == "ba"
        && FromCharacters(MapRange(0, i => "ab".At(i))) == "";

    //==
    // At, ToInteger and ToCharacter.

    // Two-line witness: the character at an index, its code, and the code's character.
    Law_CharacterWitness(): Boolean
        => "abc".At(1).ToInteger == 98 && "a".At(0).ToInteger == 97 && 97.ToCharacter.ToInteger == 97
        && 97.ToCharacter == "a".At(0) && FromCharacters([10.ToCharacter, 13.ToCharacter]).Count == 2
        && FromCharacters([10.ToCharacter, 13.ToCharacter]).At(0).ToInteger == 10;

    // At reads what FromCharacters wrote, at every index.
    Law_AtReadsWhatFromCharactersWrote(s: String): Boolean
        => FromCharacters(MapRange(s.Count, i => s.At(i))).Count == s.Count
        && s.Count.Range.All(i => s.At(i).ToInteger.ToCharacter == s.At(i));

    // The code of a character is in the Latin-1 range for the runner's lower-case letters, and ToCharacter inverts it.
    Law_ToCharacterInvertsToInteger(n: Integer): Boolean
        => n < 0 || n > 255 || n.ToCharacter.ToInteger == n;

    //==
    // String literals. The value of a literal is the characters between the quotes, verbatim; the writers
    // escape them, so a backslash and a non-ASCII character reach the generated C# and C++ unchanged.

    // "André\x" is seven characters: the e acute (233), a backslash (92) and an x.
    Law_StringLiteralKeepsBackslashAndNonAscii(): Boolean
        => "André\x".Count == 7 && "André\x".At(4).ToInteger == 233
        && "André\x".At(5).ToInteger == 92 && "André\x".At(6).ToInteger == 120
        && "André\x" == FromCharacters([65.ToCharacter, 110.ToCharacter, 100.ToCharacter, 114.ToCharacter, 233.ToCharacter, 92.ToCharacter, 120.ToCharacter]);

    //==
    // Substring.

    // The length is the size of the intersection of [start, start + count) with [0, Count).
    Law_SubstringCountIsTheClampedRange(s: String, start: Integer, count: Integer): Boolean
        => Substring(s, start, count).Count
            == (count <= 0 ? 0 : (start + count).Min(s.Count).Subtract(start.Max(0)).Max(0));

    // Each character is the source character at the same offset from the clamped start.
    Law_SubstringCharactersAreTheSourceCharacters(s: String, start: Integer, count: Integer): Boolean
        => Substring(s, start, count).Count.Range.All(i =>
            Substring(s, start, count).At(i) == s.At(start.Max(0) + i));

    // The whole String is its own substring from 0 for Count.
    Law_SubstringOfTheWholeRangeIsIdentity(s: String): Boolean
        => Substring(s, 0, s.Count) == s;

    // Two-line witness: the clamped cases and the empty ones.
    Law_SubstringWitness(): Boolean
        => Substring("abcd", 1, 2) == "bc" && Substring("abcd", -1, 3) == "ab" && Substring("abcd", 3, 9) == "d"
        && Substring("abcd", 0, 0) == "" && Substring("abcd", 4, 1) == "" && Substring("abcd", 0, -2) == "";

    //==
    // ParseNumber.

    // Two-line witness: the accepted forms and their values.
    Law_ParseNumberAcceptedForms(): Boolean
        => ParseNumber("1.5E1").Ok && ParseNumber("1.5E1").Value == 15.0 && ParseNumber("1.").Value == 1.0
        && ParseNumber(".5").Value == 0.5 && ParseNumber("1.E-06").Value == 0.000001 && ParseNumber("-2.5e+1").Value == -25.0
        && ParseNumber("+7").Value == 7.0 && ParseNumber("0").Ok && ParseNumber("1.").Ok && ParseNumber(".5").Ok && ParseNumber("1.E-06").Ok;

    // Two-line witness: the rejected forms are Ok false with Value 0.
    Law_ParseNumberRejectedForms(): Boolean
        => !ParseNumber("").Ok && !ParseNumber(".").Ok && !ParseNumber("-").Ok && !ParseNumber("1e").Ok && !ParseNumber("1e+").Ok
        && !ParseNumber("NaN").Ok && !ParseNumber("Infinity").Ok && !ParseNumber("0x10").Ok && !ParseNumber(" 1").Ok
        && !ParseNumber("1 ").Ok && !ParseNumber("1,5").Ok && !ParseNumber("1.5.2").Ok && !ParseNumber("1e999").Ok
        && ParseNumber("1e999").Value == 0.0 && ParseNumber("abc").Value == 0.0;

    // A text of letters, the runner's String, is never a number.
    Law_ParseNumberRejectsLetters(s: String): Boolean
        => s.Count == 0 || !ParseNumber(s).Ok;

    // Correct rounding: a decimal exactly halfway between two Numbers rounds to even, and the
    // nearest Number to 0.1 is the one the literal 0.1 denotes.
    Law_ParseNumberIsCorrectlyRounded(): Boolean
        => ParseNumber("0.1").Value == 0.1 && ParseNumber("9007199254740993").Value == 9007199254740992.0
        && ParseNumber("9007199254740995").Value == 9007199254740996.0 && ParseNumber("1e-400").Value == 0.0
        && ParseNumber("4.9e-324").Value > 0.0;

    // Negative zero survives: 1 / ParseNumber("-0") is negative infinity.
    Law_ParseNumberKeepsNegativeZero(): Boolean
        => 1.0 / ParseNumber("-0").Value < 0.0 && 1.0 / ParseNumber("0").Value > 0.0;

    //==
    // ParseInteger. Range edges depend on the profile (64-bit under cpu64, 32-bit under
    // cpu64i32), so the witnesses use values that overflow or fit both: 2147483647 fits,
    // 99999999999999999999 overflows. The 64-bit edges are in Plato.Intrinsics.Tests.

    // Two-line witness: accepted forms and their values.
    Law_ParseIntegerAcceptedForms(): Boolean
        => ParseInteger("-12").Ok && ParseInteger("-12").Value == -12 && ParseInteger("+7").Value == 7 && ParseInteger("007").Value == 7
        && ParseInteger("-0").Value == 0 && ParseInteger("-0").Ok && ParseInteger("2147483647").Value == 2147483647 && ParseInteger("-2147483648").Value == -2147483647 - 1;

    // Two-line witness: rejected forms and overflow are Ok false with Value 0.
    Law_ParseIntegerRejectedForms(): Boolean
        => !ParseInteger("").Ok && !ParseInteger("+").Ok && !ParseInteger("-").Ok && !ParseInteger("1.0").Ok && !ParseInteger("1e3").Ok
        && !ParseInteger(" 1").Ok && !ParseInteger("1 ").Ok && !ParseInteger("--1").Ok && !ParseInteger("0x10").Ok
        && !ParseInteger("99999999999999999999").Ok && !ParseInteger("-99999999999999999999").Ok
        && ParseInteger("99999999999999999999").Value == 0 && ParseInteger("1.0").Value == 0;

    // A text of letters, the runner's String, is never an integer.
    Law_ParseIntegerRejectsLetters(s: String): Boolean
        => s.Count == 0 || !ParseInteger(s).Ok;

    //==
    // NumberToShortestString and the round trip.

    // The round trip: reading the shortest text of a finite Number gives back that Number
    // exactly, sign of zero included (1 / x tells 0 from -0). The runner draws Numbers from
    // [-10, 10] and a few special values.
    Law_ParseNumberRoundTripsNumberToShortestString(x: Number): Boolean
        => ParseNumber(NumberToShortestString(x)).Ok
        && ParseNumber(NumberToShortestString(x)).Value == x
        && 1.0 / ParseNumber(NumberToShortestString(x)).Value == 1.0 / x;

    // The same round trip for values the generator does not draw: tiny, huge, repeating, and
    // sums that are not exactly their decimal.
    Law_ParseNumberRoundTripsHardNumbers(): Boolean
        => RoundTrips(0.1 + 0.2) && RoundTrips(1.0 / 3.0) && RoundTrips(5e-324) && RoundTrips(-2.5e-300)
        && RoundTrips(1.7976931348623157e308) && RoundTrips(123456789.123456789) && RoundTrips(9007199254740993.0)
        && RoundTrips(1e15) && RoundTrips(1e-5) && RoundTrips(4.35) && RoundTrips(-1e22);

    RoundTrips(x: Number): Boolean
        => ParseNumber(NumberToShortestString(x)).Value == x && ParseNumber(NumberToShortestString(x)).Ok;

    // Two-line witness: the layout of the text, and that the non-finite values are not numbers.
    Law_NumberToShortestStringWitness(): Boolean
        => NumberToShortestString(0.5) == "0.5" && NumberToShortestString(100.0) == "100" && NumberToShortestString(1e16) == "10000000000000000"
        && NumberToShortestString(1e17) == "1E+17" && NumberToShortestString(1e-5) == "1E-05" && NumberToShortestString(-1.5) == "-1.5" && NumberToShortestString(0.1) == "0.1";

    Law_NonFiniteNumbersHaveTextThatIsNotANumber(): Boolean
        => NumberToShortestString(0.0 / 0.0) == "NaN" && NumberToShortestString(1.0 / 0.0) == "Infinity"
        && NumberToShortestString(-1.0 / 0.0) == "-Infinity"
        && !ParseNumber("NaN").Ok && !ParseNumber("Infinity").Ok && !ParseNumber("-Infinity").Ok;

    //==
    // String order is ordinal: UTF-16 code units (bytes in the C++ prelude), never the culture's collation.

    // Upper case precedes lower case, a prefix precedes its extension, and the empty String precedes all.
    Law_StringOrderIsOrdinalWitness(): Boolean
        => !("a" < "B") && "B" < "a" && "a" > "B" && !("a" <= "B") && "B" <= "a"
        && "ab" < "abc" && !("abc" < "ab") && "abc" > "ab" && "" < "a" && !("a" < "")
        && "a" <= "a" && "a" >= "a" && !("a" < "a") && !("a" > "a")
        && "Z" < "a" && "_" < "a" && "A" < "_" && "é" > "z";

    // Codes 60 to 109 cover the upper-case letters, the punctuation between the cases and the first lower-case letters.
    Code(n: Integer): Integer
        => n.Abs % 50 + 60;

    TwoCharacters(a: Integer, b: Integer): String
        => FromCharacters([Code(a).ToCharacter, Code(b).ToCharacter]);

    // The order of two-character Strings is the lexicographic order of their character codes.
    Law_StringOrderIsLexicographicOverCharacterCodes(a: Integer, b: Integer, c: Integer, d: Integer): Boolean
        => (TwoCharacters(a, b) < TwoCharacters(c, d)) == (Code(a) < Code(c) || (Code(a) == Code(c) && Code(b) < Code(d)))
        && (TwoCharacters(a, b) <= TwoCharacters(c, d)) == (Code(a) < Code(c) || (Code(a) == Code(c) && Code(b) <= Code(d)))
        && (TwoCharacters(a, b) > TwoCharacters(c, d)) == (Code(a) > Code(c) || (Code(a) == Code(c) && Code(b) > Code(d)))
        && (TwoCharacters(a, b) >= TwoCharacters(c, d)) == (Code(a) > Code(c) || (Code(a) == Code(c) && Code(b) >= Code(d)));

    // A prefix precedes its extension, for the runner's Strings and a character after it.
    Law_PrefixPrecedesExtension(s: String, a: Integer): Boolean
        => s < FromCharacters(MapRange(s.Count + 1, i => i < s.Count ? s.At(i) : Code(a).ToCharacter))
        && !(FromCharacters(MapRange(s.Count + 1, i => i < s.Count ? s.At(i) : Code(a).ToCharacter)) <= s);

    // Totality: of two Strings exactly one of <, == and > holds, and <= is < or ==.
    Law_StringOrderIsTotal(s: String, t: String): Boolean
        => ((s < t ? 1 : 0) + (s == t ? 1 : 0) + (s > t ? 1 : 0)) == 1
        && (s <= t) == (s < t || s == t) && (s >= t) == (s > t || s == t);

    //==
    // Cbrt: the correctly rounded host cube root.

    // Cbrt inverts the cube bitwise on exactly representable cubes: the small integers and halves
    // (a half cubed is an eighth, still exact), either sign, and zero keeps its sign.
    Law_CbrtOfExactCubeIsTheRootBitwise(n: Integer): Boolean
        => CbrtRootsBack(n.ToNumber) && CbrtRootsBack(n.ToNumber * 0.5) && CbrtRootsBack(-(n.ToNumber));

    CbrtRootsBack(x: Number): Boolean
        => (x * x * x).Cbrt == x && 1.0 / (x * x * x).Cbrt == 1.0 / x;

    Law_CbrtWitness(): Boolean
        => 8.0.Cbrt == 2.0 && (-27.0).Cbrt == -3.0 && 0.0.Cbrt == 0.0 && 1.0 / 0.0.Cbrt == 1.0 / 0.0
        && 1.0 / (-0.0).Cbrt == -1.0 / 0.0 && 1.0.Cbrt == 1.0 && (-1.0).Cbrt == -1.0 && 0.125.Cbrt == 0.5
        && (1.0 / 0.0).Cbrt == 1.0 / 0.0 && (0.0 / 0.0).Cbrt.IsNaN;

    // Odd symmetry and monotonicity over the runner's Numbers.
    Law_CbrtIsOdd(x: Number): Boolean
        => (-x).Cbrt == -(x.Cbrt);
}
