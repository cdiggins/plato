// Law library for the text intrinsics the STEP parser needs: FromCharacters, Substring,
// ParseNumber, ParseInteger and NumberToShortestString (intrinsics.library.plato,
// text.library.plato).
//
// Same conventions as `foundation.laws.plato`: `Law_*` Boolean functions are universally
// quantified over their parameters; the runner generates Strings of lower-case letters and
// Numbers in [-10, 10], so the laws that need other text state it as a literal witness.
library TextLaws
{
    //==
    // FromCharacters.

    // The characters of a String, rebuilt, are the String.
    Law_FromCharactersOfCharactersIsIdentity(s: String): Boolean
        => FromCharacters(MapRange(s.Count, i => s.At(i))) == s;

    // Two-line witness: the characters of "ab" in reverse order make "ba"; none make "".
    Law_FromCharactersWitness(): Boolean
        => FromCharacters(["ab".At(1), "ab".At(0)]) == "ba"
        && FromCharacters(MapRange(0, i => "ab".At(i))) == "";

    //==
    // Substring.

    // The length is the size of the intersection of [start, start + count) with [0, Count).
    Law_SubstringCountIsTheClampedRange(s: String, start: Integer, count: Integer): Boolean
        => Substring(s, start, count).Count
            == (count <= 0 ? 0 : (start + count).Min(s.Count).Subtract(start.Max(0)).Max(0));

    // Each character is the source character at the same offset from the clamped start.
    Law_SubstringCharactersAreTheSourceCharacters(s: String, start: Integer, count: Integer): Boolean
        => Substring(s, start, count).Count.Range.All(i =>
            Substring(s, start, count).At(i) == s.At(start.Max(0) + i));

    // The whole String is its own substring from 0 for Count.
    Law_SubstringOfTheWholeRangeIsIdentity(s: String): Boolean
        => Substring(s, 0, s.Count) == s;

    // Two-line witness: the clamped cases and the empty ones.
    Law_SubstringWitness(): Boolean
        => Substring("abcd", 1, 2) == "bc" && Substring("abcd", -1, 3) == "ab" && Substring("abcd", 3, 9) == "d"
        && Substring("abcd", 0, 0) == "" && Substring("abcd", 4, 1) == "" && Substring("abcd", 0, -2) == "";

    //==
    // ParseNumber.

    // Two-line witness: the accepted forms and their values.
    Law_ParseNumberAcceptedForms(): Boolean
        => ParseNumber("1.5E1").Ok && ParseNumber("1.5E1").Value == 15.0 && ParseNumber("1.").Value == 1.0
        && ParseNumber(".5").Value == 0.5 && ParseNumber("1.E-06").Value == 0.000001 && ParseNumber("-2.5e+1").Value == -25.0
        && ParseNumber("+7").Value == 7.0 && ParseNumber("0").Ok && ParseNumber("1.").Ok && ParseNumber(".5").Ok && ParseNumber("1.E-06").Ok;

    // Two-line witness: the rejected forms are Ok false with Value 0.
    Law_ParseNumberRejectedForms(): Boolean
        => !ParseNumber("").Ok && !ParseNumber(".").Ok && !ParseNumber("-").Ok && !ParseNumber("1e").Ok && !ParseNumber("1e+").Ok
        && !ParseNumber("NaN").Ok && !ParseNumber("Infinity").Ok && !ParseNumber("0x10").Ok && !ParseNumber(" 1").Ok
        && !ParseNumber("1 ").Ok && !ParseNumber("1,5").Ok && !ParseNumber("1.5.2").Ok && !ParseNumber("1e999").Ok
        && ParseNumber("1e999").Value == 0.0 && ParseNumber("abc").Value == 0.0;

    // A text of letters, the runner's String, is never a number.
    Law_ParseNumberRejectsLetters(s: String): Boolean
        => s.Count == 0 || !ParseNumber(s).Ok;

    // Correct rounding: a decimal exactly halfway between two Numbers rounds to even, and the
    // nearest Number to 0.1 is the one the literal 0.1 denotes.
    Law_ParseNumberIsCorrectlyRounded(): Boolean
        => ParseNumber("0.1").Value == 0.1 && ParseNumber("9007199254740993").Value == 9007199254740992.0
        && ParseNumber("9007199254740995").Value == 9007199254740996.0 && ParseNumber("1e-400").Value == 0.0
        && ParseNumber("4.9e-324").Value > 0.0;

    // Negative zero survives: 1 / ParseNumber("-0") is negative infinity.
    Law_ParseNumberKeepsNegativeZero(): Boolean
        => 1.0 / ParseNumber("-0").Value < 0.0 && 1.0 / ParseNumber("0").Value > 0.0;

    //==
    // ParseInteger. Range edges depend on the profile (64-bit under cpu64, 32-bit under
    // cpu64i32), so the witnesses use values that overflow or fit both: 2147483647 fits,
    // 99999999999999999999 overflows. The 64-bit edges are in Plato.Intrinsics.Tests.

    // Two-line witness: accepted forms and their values.
    Law_ParseIntegerAcceptedForms(): Boolean
        => ParseInteger("-12").Ok && ParseInteger("-12").Value == -12 && ParseInteger("+7").Value == 7 && ParseInteger("007").Value == 7
        && ParseInteger("-0").Value == 0 && ParseInteger("-0").Ok && ParseInteger("2147483647").Value == 2147483647 && ParseInteger("-2147483648").Value == -2147483647 - 1;

    // Two-line witness: rejected forms and overflow are Ok false with Value 0.
    Law_ParseIntegerRejectedForms(): Boolean
        => !ParseInteger("").Ok && !ParseInteger("+").Ok && !ParseInteger("-").Ok && !ParseInteger("1.0").Ok && !ParseInteger("1e3").Ok
        && !ParseInteger(" 1").Ok && !ParseInteger("1 ").Ok && !ParseInteger("--1").Ok && !ParseInteger("0x10").Ok
        && !ParseInteger("99999999999999999999").Ok && !ParseInteger("-99999999999999999999").Ok
        && ParseInteger("99999999999999999999").Value == 0 && ParseInteger("1.0").Value == 0;

    // A text of letters, the runner's String, is never an integer.
    Law_ParseIntegerRejectsLetters(s: String): Boolean
        => s.Count == 0 || !ParseInteger(s).Ok;
}
