//==
// # Flat node tree and graph accessors
//
// Root-node lookup and index ordering for the flat, index-based structures:
// the SDF combination trees of `implicit-sdf-trees.types.plato` and the scalar field
// expression graphs of `fields-graphs.types.plato`. The recursive evaluators live in
// `implicit-sdf-trees.library.plato` and `fields-graphs.library.plato`; these
// name the entry point and the index ordering a walker relies on.

library FieldsImplicitsNodes
{
    //==
    // # SDF combination trees

    // The node producing the tree's final distance.
    RootNode(self: SdfTree2D): SdfNode2D
        => self.Nodes[self.Root.Value];

    // The node producing the tree's final distance.
    RootNode(self: SdfTree3D): SdfNode3D
        => self.Nodes[self.Root.Value];

    // Node indices order by position in the node array, so a tree's nodes are
    // already in a valid evaluation order.
    LessThanOrEquals(a: SdfNodeIndex, b: SdfNodeIndex): Boolean
        => a.Value <= b.Value;

    // A node index hashes as its underlying position.
    Hash(self: SdfNodeIndex): Integer
        => self.Value.Hash;

    //==
    // # Field expression graphs
    //
    // The same flat-graph shape over scalar fields.

    // The node producing the graph's result.
    RootNode(self: ScalarFieldGraph2D): ScalarFieldNode2D
        => self.Nodes[self.Root.Value];

    // The node producing the graph's result.
    RootNode(self: ScalarFieldGraph3D): ScalarFieldNode3D
        => self.Nodes[self.Root.Value];

    // Field node indices order by position in the node array.
    LessThanOrEquals(a: FieldNodeIndex, b: FieldNodeIndex): Boolean
        => a.Value <= b.Value;

    // A field node index hashes as its underlying position.
    Hash(self: FieldNodeIndex): Integer
        => self.Value.Hash;
}
