//==
// # Vector paths
//
// Resolution-independent 2D outlines in the SVG/Skia/Canvas tradition: a path
// is a list of contours, a contour is a connected run of segments, and a
// segment is one drawing verb (move, line, quadratic, cubic, arc, close).
// Styling lives in the `vector-styling-*` files, text and glyph outlines in the
// `text-*` files, and scene composition in `scene2d.types.plato`.

// One drawing verb of a contour, following SVG path semantics. Every segment
// starts at the previous segment's endpoint; each verb carries exactly the
// control data it needs and nothing more (the on-curve endpoint is always
// EndPoint). The arc form is the SVG elliptical arc: x/y radii, rotation of
// the ellipse axes, and the large-arc and sweep flags.
// (https://en.wikipedia.org/wiki/SVG)
type PathSegment2D
    implements Value
    = Move(EndPoint: Point2D)                                            // start a new sub-path
    | Line(EndPoint: Point2D)                                            // straight line to EndPoint
    | Quadratic(Control: Point2D, EndPoint: Point2D)                     // one control point
    | Cubic(Control1: Point2D, Control2: Point2D, EndPoint: Point2D)     // two control points
    | Arc(Radii: Number2, AxisRotation: Angle, LargeArc: Boolean, Sweep: Boolean, EndPoint: Point2D) // SVG elliptical arc
    | Close;                                                             // line back to the sub-path start

// A connected run of segments (a sub-path). When Closed is true the contour
// is implicitly sealed with a line back to its first point, equivalent to a
// trailing Close segment.
type Contour2D
    implements Value
{
    Segments: Array<PathSegment2D>;
    Closed: Boolean;
}

// How the interior of a self-intersecting or multi-contour path is decided.
// NonZero: inside where the winding count is nonzero. EvenOdd: inside where
// the crossing count is odd. (https://en.wikipedia.org/wiki/Nonzero-rule)
type FillRule = NonZero | EvenOdd;

// A complete vector path: zero or more contours plus the fill rule that
// decides its interior. The canonical exchange type for 2D outlines.
// (https://en.wikipedia.org/wiki/Vector_graphics)
type Path2D
    implements Value
{
    Contours: Array<Contour2D>;
    FillRule: FillRule;
}

// A zero-based index of a contour within a path's contour array. -1 means
// "no contour".
type ContourIndex
    implements Value, Hashable, Comparable, Index
{
    Value: Integer;
}

// A zero-based index of a segment within a contour's segment array. -1 means
// "no segment".
type PathSegmentIndex
    implements Value, Hashable, Comparable, Index
{
    Value: Integer;
}

// An address on a path: which contour, which segment within that contour, and
// the normalized parameter within that segment. An index of -1 means "no
// location".
type PathLocation
    implements Value
{
    Contour: ContourIndex;
    Segment: PathSegmentIndex;
    Parameter: Proportion;
}

// Per-corner elliptical rounding radii for converting rectangles to paths, in
// the order top-left, top-right, bottom-right, bottom-left. Each radius is an
// (x, y) half-extent pair; a zero pair means a sharp corner.
type CornerRadii2D
    implements Value
{
    TopLeft: Number2;
    TopRight: Number2;
    BottomRight: Number2;
    BottomLeft: Number2;
}

// The boolean (clipping) operation used when combining two paths.
// Difference is the first path minus the second.
// (https://en.wikipedia.org/wiki/Boolean_operations_on_polygons)
type PathBooleanOperation = Union | Intersection | Difference | ExclusiveOr;

// Controls for reducing a path's segment count while staying within a
// geometric error budget of Tolerance (in path units). When PreserveCorners
// is true, points where the tangent is discontinuous are never removed.
// (https://en.wikipedia.org/wiki/Ramer%E2%80%93Douglas%E2%80%93Peucker_algorithm)
type PathSimplifyParameters
    implements Value
{
    Tolerance: Number;
    PreserveCorners: Boolean;
}

// Controls for flattening curved segments into line segments. Tolerance is
// the maximum allowed deviation from the true curve, in path units.
// MaxSegmentCount caps the lines produced per curve; -1 means no cap.
type PathFlattenParameters
    implements Value
{
    Tolerance: Number;
    MaxSegmentCount: Integer;
}
