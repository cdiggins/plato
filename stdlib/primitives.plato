//==
// # Primitives
//
// Types the Plato compiler assumes to exist by name. This file declares them and
// states which foundational concepts they satisfy. Fields are intentionally absent
// on scalar primitives: their representations are intrinsic.

// A 64-bit floating-point approximation of a real number.
type Number
    implements Real
{ }

// A signed whole number.
type Integer
    implements Whole, Bitwise
{ }

// A truth value: true or false.
type Boolean
    implements Value, Orderable, Logical
{ }

// Immutable text.
type String
    implements Value, Orderable, Countable
{ }

// A single character of text.
type Character
    implements Value, Orderable
{ }

// A dynamically typed value; an escape hatch for interop.
type Dynamic
{ }

// The root reference type for interop with host platforms.
type Object
{ }

//==
// # Tuples
//
// Anonymous product types. Tuple literals construct them: (a, b) is a Tuple2.
// The compiler synthesizes a TupleN constructor for every type with N fields,
// and supports at most 10-field tuples — so no type may exceed 10 fields.

type Tuple2<T0, T1> { X0: T0; X1: T1; }
type Tuple3<T0, T1, T2> { X0: T0; X1: T1; X2: T2; }
type Tuple4<T0, T1, T2, T3> { X0: T0; X1: T1; X2: T2; X3: T3; }
type Tuple5<T0, T1, T2, T3, T4> { X0: T0; X1: T1; X2: T2; X3: T3; X4: T4; }
type Tuple6<T0, T1, T2, T3, T4, T5> { X0: T0; X1: T1; X2: T2; X3: T3; X4: T4; X5: T5; }
type Tuple7<T0, T1, T2, T3, T4, T5, T6> { X0: T0; X1: T1; X2: T2; X3: T3; X4: T4; X5: T5; X6: T6; }
type Tuple8<T0, T1, T2, T3, T4, T5, T6, T7> { X0: T0; X1: T1; X2: T2; X3: T3; X4: T4; X5: T5; X6: T6; X7: T7; }
type Tuple9<T0, T1, T2, T3, T4, T5, T6, T7, T8> { X0: T0; X1: T1; X2: T2; X3: T3; X4: T4; X5: T5; X6: T6; X7: T7; X8: T8; }
type Tuple10<T0, T1, T2, T3, T4, T5, T6, T7, T8, T9> { X0: T0; X1: T1; X2: T2; X3: T3; X4: T4; X5: T5; X6: T6; X7: T7; X8: T8; X9: T9; }

//==
// # Function types
//
// Pure function values. TR is the result type.

type Function0<TR> { }
type Function1<T0, TR> { }
type Function2<T0, T1, TR> { }
type Function3<T0, T1, T2, TR> { }
type Function4<T0, T1, T2, T3, TR> { }

//==
// # Arrays
//
// Immutable, eagerly-or-lazily backed ordered collections. The compiler maps
// indexing syntax to At.

// An immutable one-dimensional ordered collection.
type Array<T>
    implements Indexable<T>
{ }

// An immutable collection addressed by column and row.
type Array2D<T>
    implements Indexable2D<T>
{ }

// An immutable collection addressed by column, row, and layer.
type Array3D<T>
    implements Indexable3D<T>
{ }

// An immutable collection addressed by column, row, layer, and block.
type Array4D<T>
    implements Indexable4D<T>
{ }
