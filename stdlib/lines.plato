//==
// # Lines, rays, segments, and planes
//
// The flat (affine) primitives. Extent distinguishes them: a segment is bounded
// by two endpoints, a ray extends one way from its origin, a line extends both
// ways, and a plane extends in two dimensions. Half-planes, half-spaces, and
// slabs are the regions these flats bound.

//==
// # Segments

// A straight bounded span, directed from A to B. The point at parameter t in
// [0, 1] is A + (B - A) * t (t = 0 is A, t = 1 is B) -- the same parametric
// contract the ray and line types state. Degenerate when A equals B.
type LineSegment2D
    implements Geometry2D, OpenShape, Connected, Bounded2D, LengthMeasurable, PointSet2D, Centroid2D, NearestPoint2D, Deformable2D
{
    A: Point2D;
    B: Point2D;
}

// A straight bounded span in space, directed from A to B. The point at parameter
// t in [0, 1] is A + (B - A) * t. Degenerate when A equals B.
type LineSegment3D
    implements Geometry3D, OpenShape, Connected, Bounded3D, LengthMeasurable, PointSet3D, Centroid3D, NearestPoint3D, Deformable3D
{
    A: Point3D;
    B: Point3D;
}

//==
// # Infinite lines and rays

// An infinite straight line in the plane: all points Origin + Direction * t for
// any real t. Origin is any point on the line.
type Line2D
    implements Geometry2D, Connected, NearestPoint2D
{
    Origin: Point2D;
    Direction: Direction2D;
}

// An infinite straight line in space: all points Origin + Direction * t for any
// real t.
type Line3D
    implements Geometry3D, Connected, NearestPoint3D
{
    Origin: Point3D;
    Direction: Direction3D;
}

// A half-line in the plane: starts at Origin and extends along Direction only.
// The point at parameter t >= 0 is Origin + Direction * t.
type Ray2D
    implements Geometry2D, Connected, NearestPoint2D
{
    Origin: Point2D;
    Direction: Direction2D;
}

// A half-line in space: starts at Origin and extends along Direction only.
// The point at parameter t >= 0 is Origin + Direction * t.
type Ray3D
    implements Geometry3D, Connected, NearestPoint3D
{
    Origin: Point3D;
    Direction: Direction3D;
}

// The implicit (general) form of a 2D line: the points (x, y) satisfying
// A*x + B*y + C = 0. Coefficients need not be normalized; (A, B) is a normal
// of the line.
type LineEquation2D
    implements Value
{
    A: Number;
    B: Number;
    C: Number;
}

//==
// # Planes and half-spaces

// An infinite plane in Hesse normal form: the points p with Dot(Normal, p)
// equal to Distance. Distance is the signed distance from the world origin to
// the plane along Normal.
type Plane
    implements Geometry3D, Connected, Manifold, Orientable, NearestPoint3D
{
    // The plane's UNIT normal (unit by Direction3D's own invariant); it points into
    // the plane's front / positive half-space.
    Normal: Direction3D;

    // The SIGNED distance from the WORLD ORIGIN to the plane, measured along Normal
    // (the Hesse form's d) -- NOT the distance from an arbitrary reference point,
    // and easy to misread as a generic offset. Because Normal is a unit vector this
    // is a true length in the coordinate frame's own units, and the signed distance
    // of any point p is SignedDistance(plane, p) = Dot(Normal, p) - Distance.
    Distance: Number;
}

// The closed 3D region on and behind a boundary plane: the points p with
// Dot(Normal, p) <= Distance. The boundary's normal points out of the half-space.
type HalfSpace
    implements Geometry3D, ConvexShape, Connected, ContainsPoint3D, NearestPoint3D
{
    Boundary: Plane;
}

// The closed 2D region on and behind a boundary line in Hesse normal form: the
// points p with Dot(Normal, p) <= Distance. Normal points out of the half-plane.
type HalfPlane2D
    implements Geometry2D, ConvexShape, Connected, ContainsPoint2D, NearestPoint2D
{
    Normal: Direction2D;
    Distance: Number;
}

//==
// # Slabs

// The closed 2D region between two parallel lines: the points p whose signed
// distance Dot(Normal, p) lies within Interval. Interval runs from the lower to
// the upper signed distance.
type Slab2D
    implements Geometry2D, ConvexShape, Connected, ContainsPoint2D
{
    Normal: Direction2D;
    Interval: NumberInterval;
}

// The closed 3D region between two parallel planes: the points p whose signed
// distance Dot(Normal, p) lies within Interval. The workhorse of separating-axis
// and ray-box tests.
type Slab3D
    implements Geometry3D, ConvexShape, Connected, ContainsPoint3D
{
    Normal: Direction3D;
    Interval: NumberInterval;
}

//==
// # Query results

// The outcome of intersecting a line, ray, or segment with a Plane. Hit is the
// validity flag (CONVENTIONS.md - partial operations: a concrete result record
// with a validity field, never a generic Optional): when Hit is true, Point is
// the crossing point and Parameter its parameter along the queried primitive;
// when Hit is false (the primitive is parallel to the plane, including the
// coincident case, or crosses outside a ray's or segment's extent) Point and
// Parameter are the queried primitive's own origin and 0 and carry no meaning.
type PlaneHit3D
    implements Value
{
    Hit: Boolean;
    Point: Point3D;
    Parameter: Number;
}

//==
// # Flat-primitive operations
//
// The measure, centroid, containment and nearest-point bodies for the types above
// (`LIBRARIES.md` ground rules 1 and 10: an inline `library` block is the
// sanctioned home for bodies that belong beside their declarations).
//
// Conventions:
//   * `Bounds` for the two segment types comes from the generic
//     `Bounds(PointSet2D/3D)` in `geometry.library.plato`; nothing here respells it.
//   * Every `Direction` field is a UNIT vector by its type invariant, so the
//     projection formulas below divide by no length.
//   * `Contains` on the half-plane, half-space and slab regions is CLOSED: a point
//     exactly on the bounding line/plane is contained, matching the concept doc
//     ("for closed shapes the boundary counts as inside") and the `<=` in each
//     declaration's own doc comment.
//   * `ClosestPoint` on a REGION (half-plane, half-space) returns the query point
//     itself when the query is inside, as `NearestPoint2D`/`3D` permits.
//   * The signed distance of a point p from the world origin along a unit normal n
//     is Dot(n, p) — written `p.PositionVector.Dot(n.Vector)` here, since a point
//     is not a vector in this vocabulary (`transforms.plato`).

library Lines
{
    //==
    // # Line segments

    // The two endpoints, in the segment's own direction (A first).
    Points(s: LineSegment2D): Array<Point2D>
        => 2.MapRange(i => i == 0 ? s.A : s.B);

    // The two endpoints, A first.
    Points(s: LineSegment3D): Array<Point3D>
        => 2.MapRange(i => i == 0 ? s.A : s.B);

    // The distance between the endpoints.
    Length(s: LineSegment2D): Number
        => s.A.Between(s.B).Magnitude;

    // The distance between the endpoints.
    Length(s: LineSegment3D): Number
        => s.A.Between(s.B).Magnitude;

    // The midpoint: the center of mass of a uniform-density segment.
    Centroid(s: LineSegment2D): Point2D
        => s.A.MidPoint(s.B);

    // The midpoint of the segment.
    Centroid(s: LineSegment3D): Point3D
        => s.A.MidPoint(s.B);

    // The point of the segment nearest to `point` (the projection clamped to the
    // segment's span).
    ClosestPoint(s: LineSegment2D, point: Point2D): Point2D
        => ClosestPointOnSegment(s.A, s.B, point);

    // The point of the segment nearest to `point`.
    ClosestPoint(s: LineSegment3D, point: Point3D): Point3D
        => ClosestPointOnSegment(s.A, s.B, point);

    // The segment with both endpoints carried through the mapping.
    Deform(s: LineSegment2D, mapping: Function1<Point2D, Point2D>): LineSegment2D
        => (mapping(s.A), mapping(s.B));

    // The segment with both endpoints carried through the mapping.
    Deform(s: LineSegment3D, mapping: Function1<Point3D, Point3D>): LineSegment3D
        => (mapping(s.A), mapping(s.B));

    //==
    // # Infinite lines and rays
    //
    // The foot of the perpendicular from `point`: Origin + Direction * t with
    // t = Dot(point - Origin, Direction). The line takes t unrestricted; the ray
    // clamps t to the non-negative half, so a query behind the ray's origin
    // projects onto the origin itself.
    // https://en.wikipedia.org/wiki/Distance_from_a_point_to_a_line

    // The point of the line nearest to `point`.
    ClosestPoint(l: Line2D, point: Point2D): Point2D
        => l.Origin.Add(l.Direction.Vector.Multiply(l.Origin.Between(point).Dot(l.Direction.Vector)));

    // The point of the line nearest to `point`.
    ClosestPoint(l: Line3D, point: Point3D): Point3D
        => l.Origin.Add(l.Direction.Vector.Multiply(l.Origin.Between(point).Dot(l.Direction.Vector)));

    // The point of the ray nearest to `point`; the ray's origin when the query
    // lies behind it.
    ClosestPoint(r: Ray2D, point: Point2D): Point2D
        => r.Origin.Add(r.Direction.Vector.Multiply(
            r.Origin.Between(point).Dot(r.Direction.Vector).Max(0.0)));

    // The point of the ray nearest to `point`; the ray's origin when the query
    // lies behind it.
    ClosestPoint(r: Ray3D, point: Point3D): Point3D
        => r.Origin.Add(r.Direction.Vector.Multiply(
            r.Origin.Between(point).Dot(r.Direction.Vector).Max(0.0)));

    //==
    // # Parametric evaluation and inverse
    //
    // `PointAt` maps a parameter to a point; `Parameter` is its inverse, the
    // parameter of the point on the flat NEAREST to a query. Lines take t
    // unrestricted; rays clamp t to the non-negative half; segments run t over
    // [0, 1] between the endpoints (a query off the extent projects to the nearer
    // end). For a line and a ray, `PointAt(x, x.Parameter(p))` equals
    // `x.ClosestPoint(p)`.

    // The point at parameter t: Origin + Direction * t.
    PointAt(l: Line2D, t: Number): Point2D
        => l.Origin.Add(l.Direction.Vector.Multiply(t));

    // The point at parameter t: Origin + Direction * t.
    PointAt(l: Line3D, t: Number): Point3D
        => l.Origin.Add(l.Direction.Vector.Multiply(t));

    // The point at parameter t (t >= 0 lies on the ray): Origin + Direction * t.
    PointAt(r: Ray2D, t: Number): Point2D
        => r.Origin.Add(r.Direction.Vector.Multiply(t));

    // The point at parameter t (t >= 0 lies on the ray): Origin + Direction * t.
    PointAt(r: Ray3D, t: Number): Point3D
        => r.Origin.Add(r.Direction.Vector.Multiply(t));

    // The point at parameter t in [0, 1]: A + (B - A) * t.
    PointAt(s: LineSegment2D, t: Number): Point2D
        => s.A.Lerp(s.B, t);

    // The point at parameter t in [0, 1]: A + (B - A) * t.
    PointAt(s: LineSegment3D, t: Number): Point3D
        => s.A.Lerp(s.B, t);

    // The unclamped parameter of the foot of the perpendicular from `point`, so
    // PointAt of it is the line's nearest point. Exact because Direction is unit.
    Parameter(l: Line2D, point: Point2D): Number
        => l.Origin.Between(point).Dot(l.Direction.Vector);

    // The unclamped parameter of the foot of the perpendicular from `point`.
    Parameter(l: Line3D, point: Point3D): Number
        => l.Origin.Between(point).Dot(l.Direction.Vector);

    // The parameter of `point` clamped to the ray: never negative, so a query
    // behind the origin returns 0.
    Parameter(r: Ray2D, point: Point2D): Number
        => r.Origin.Between(point).Dot(r.Direction.Vector).Max(0.0);

    // The parameter of `point` clamped to the ray.
    Parameter(r: Ray3D, point: Point3D): Number
        => r.Origin.Between(point).Dot(r.Direction.Vector).Max(0.0);

    // The parameter of `point` clamped to [0, 1]: the projection onto the spine
    // A -> B, normalized by the squared span. Degenerate (0/0) only when A equals B.
    Parameter(s: LineSegment2D, point: Point2D): Number
        => (s.A.Between(point).Dot(s.A.Between(s.B)) / s.A.Between(s.B).MagnitudeSquared)
            .Clamp(0.0, 1.0);

    // The parameter of `point` clamped to [0, 1].
    Parameter(s: LineSegment3D, point: Point3D): Number
        => (s.A.Between(point).Dot(s.A.Between(s.B)) / s.A.Between(s.B).MagnitudeSquared)
            .Clamp(0.0, 1.0);

    //==
    // # Segment -> line / ray conversions
    //
    // The infinite carriers of an edge: the supporting line through A and B, and the
    // ray from A through B. Both need the unit direction A -> B, so both are
    // undefined for a degenerate (A == B) segment.

    // The infinite line through A and B, directed A -> B.
    SupportingLine(s: LineSegment3D): Line3D
        => (s.A, Direction3D(s.A.Between(s.B).Normalize));

    // The ray from A through B, directed A -> B.
    SupportingRay(s: LineSegment3D): Ray3D
        => (s.A, Direction3D(s.A.Between(s.B).Normalize));

    // The infinite line through A and B, directed A -> B.
    SupportingLine(s: LineSegment2D): Line2D
        => (s.A, Direction2D(s.A.Between(s.B).Normalize));

    // The ray from A through B, directed A -> B.
    SupportingRay(s: LineSegment2D): Ray2D
        => (s.A, Direction2D(s.A.Between(s.B).Normalize));

    //==
    // # Closest points between two flats
    //
    // The shortest connecting segment, returned A-on-first, B-on-second; its length
    // is the distance between the flats and its endpoints coincide when they cross.
    // https://en.wikipedia.org/wiki/Skew_lines#Distance

    // The mutually nearest points of two infinite lines. For PARALLEL lines the
    // connector is anchored at the first line's origin (any common perpendicular has
    // the same length). Directions are unit, so the 2x2 normal system reduces to
    // denom = 1 - Dot(d1, d2)^2.
    ClosestPoints(a: Line3D, b: Line3D): LineSegment3D
    {
        var d1 = a.Direction.Vector;
        var d2 = b.Direction.Vector;
        var r = b.Origin.Between(a.Origin);
        var f = d1.Dot(d2);
        var c = d1.Dot(r);
        var e = d2.Dot(r);
        var denom = 1.0 - f * f;
        var s = denom == 0.0 ? 0.0 : (f * e - c) / denom;
        var t = denom == 0.0 ? e : (e - f * c) / denom;
        return (a.Origin.Add(d1.Multiply(s)), b.Origin.Add(d2.Multiply(t)));
    }

    // The mutually nearest points of two segments, each parameter clamped to its own
    // [0, 1] extent (Ericson's segment-segment routine). Robust to a degenerate
    // (A == B) segment on either side: its span drops out of the division.
    // https://en.wikipedia.org/wiki/Distance_between_two_lines
    ClosestPoints(sa: LineSegment3D, sb: LineSegment3D): LineSegment3D
    {
        var d1 = sa.A.Between(sa.B);
        var d2 = sb.A.Between(sb.B);
        var r = sb.A.Between(sa.A);
        var a = d1.MagnitudeSquared;
        var e = d2.MagnitudeSquared;
        var f = d2.Dot(r);
        var c = d1.Dot(r);
        var b = d1.Dot(d2);
        var denom = a * e - b * b;
        var s0 = denom == 0.0 ? 0.0 : ((b * f - c * e) / denom).Clamp(0.0, 1.0);
        var t = (e == 0.0 ? 0.0 : (b * s0 + f) / e).Clamp(0.0, 1.0);
        var s = (a == 0.0 ? s0 : (t * b - c) / a).Clamp(0.0, 1.0);
        return (sa.A.Add(d1.Multiply(s)), sb.A.Add(d2.Multiply(t)));
    }

    //==
    // # Planes and half-spaces
    //
    // Hesse normal form: the plane is the set of p with Dot(Normal, p) = Distance,
    // so SignedDistance(p) = Dot(Normal, p) - Distance is the signed distance from
    // the plane, positive on the side the normal points to.
    // https://en.wikipedia.org/wiki/Hesse_normal_form

    // The signed distance from `point` to the plane, positive on the side the
    // normal points to. Exact because Normal is a unit vector by its invariant.
    SignedDistance(pl: Plane, point: Point3D): Number
        => point.PositionVector.Dot(pl.Normal.Vector) - pl.Distance;

    // The signed distance from `point` to the half-plane's boundary line, positive
    // outside the half-plane.
    SignedDistance(h: HalfPlane2D, point: Point2D): Number
        => point.PositionVector.Dot(h.Normal.Vector) - h.Distance;

    // The foot of the perpendicular from `point` onto the plane.
    ClosestPoint(pl: Plane, point: Point3D): Point3D
        => point.Subtract(pl.Normal.Vector.Multiply(pl.SignedDistance(point)));

    // Which side of the plane `point` lies on: +1 on the side Normal points to,
    // -1 behind, 0 on the plane. The sign of SignedDistance; the name every
    // clipping / BSP lesson reaches for.
    Side(pl: Plane, point: Point3D): Integer
        => pl.SignedDistance(point).Sign;

    // The plane through `point` with unit `normal`, in Hesse form: Distance is
    // Dot(normal, point), the signed distance from the world origin. The usual way
    // to build a plane from a point-and-normal (e.g. a triangle's vertex and face
    // normal).
    FromPointNormal(point: Point3D, normal: Direction3D): Plane
        => (normal, point.PositionVector.Dot(normal.Vector));

    // The same plane facing the other way: both Normal and Distance negated, so the
    // point set Dot(Normal, p) = Distance is unchanged while its front side flips.
    // The teachable one-liner that keeps the two fields in step.
    Flip(pl: Plane): Plane
        => (Direction3D(pl.Normal.Vector.Multiply(-1.0)), -pl.Distance);

    // The complementary closed half-space: the region on the other side of the same
    // boundary plane, obtained by flipping that plane.
    Flip(h: HalfSpace): HalfSpace
        => h.Boundary.Flip;

    // Where the infinite line crosses the plane. Misses (Hit false) only when the
    // line is parallel to the plane (Dot(Normal, Direction) = 0), including a line
    // lying in the plane -- there is then no single crossing point.
    Intersect(l: Line3D, pl: Plane): PlaneHit3D
    {
        var denom = l.Direction.Vector.Dot(pl.Normal.Vector);
        var t = 0.0 - pl.SignedDistance(l.Origin) / denom;
        return denom == 0.0
            ? PlaneHit3D(false, l.Origin, 0.0)
            : PlaneHit3D(true, l.PointAt(t), t);
    }

    // Where the ray crosses the plane. Misses when the ray is parallel to the plane
    // OR crosses behind the origin (t < 0).
    Intersect(r: Ray3D, pl: Plane): PlaneHit3D
    {
        var denom = r.Direction.Vector.Dot(pl.Normal.Vector);
        var t = 0.0 - pl.SignedDistance(r.Origin) / denom;
        return denom == 0.0 || t < 0.0
            ? PlaneHit3D(false, r.Origin, 0.0)
            : PlaneHit3D(true, r.PointAt(t), t);
    }

    // Where the segment crosses the plane, with Parameter in [0, 1] along A -> B.
    // Misses when the segment is parallel to the plane OR both endpoints lie on the
    // same side (the crossing parameter falls outside [0, 1]).
    Intersect(s: LineSegment3D, pl: Plane): PlaneHit3D
    {
        var denom = s.A.Between(s.B).Dot(pl.Normal.Vector);
        var t = 0.0 - pl.SignedDistance(s.A) / denom;
        return denom == 0.0 || t < 0.0 || t > 1.0
            ? PlaneHit3D(false, s.A, 0.0)
            : PlaneHit3D(true, s.PointAt(t), t);
    }

    // True when `point` lies on or behind the boundary plane
    // (Dot(Normal, point) <= Distance). Boundary inclusive.
    Contains(h: HalfSpace, point: Point3D): Boolean
        => h.Boundary.SignedDistance(point) <= 0.0;

    // The query point itself when it is inside the half-space, otherwise its
    // projection onto the boundary plane.
    ClosestPoint(h: HalfSpace, point: Point3D): Point3D
        => h.Contains(point) ? point : h.Boundary.ClosestPoint(point);

    // True when `point` lies on or behind the boundary line. Boundary inclusive.
    Contains(h: HalfPlane2D, point: Point2D): Boolean
        => h.SignedDistance(point) <= 0.0;

    // The query point itself when it is inside the half-plane, otherwise its
    // projection onto the boundary line.
    ClosestPoint(h: HalfPlane2D, point: Point2D): Point2D
        => h.Contains(point)
        ? point
        : point.Subtract(h.Normal.Vector.Multiply(h.SignedDistance(point)));

    //==
    // # Slabs
    //
    // A slab is the preimage of a closed number interval under the linear map
    // p -> Dot(Normal, p), so containment is exactly interval containment.
    // `Contains(IntervalLike, value)` (P4) is endpoint-inclusive and assumes the
    // interval is stored forward (Start <= End), which is the slab's own invariant.

    // True when the point's signed distance along Normal lies within Interval.
    Contains(s: Slab2D, point: Point2D): Boolean
        => s.Interval.Contains(point.PositionVector.Dot(s.Normal.Vector));

    // True when the point's signed distance along Normal lies within Interval.
    Contains(s: Slab3D, point: Point3D): Boolean
        => s.Interval.Contains(point.PositionVector.Dot(s.Normal.Vector));

    // The three axis-aligned slabs of a box, one per world axis (X, Y, Z), each
    // spanning that axis' Min..Max coordinate. A point lies in the box exactly when
    // it lies in all three slabs, which is the standard slab reduction of a
    // ray/box or box/box test.
    // https://en.wikipedia.org/wiki/Slab_method
    Slabs(b: Bounds3D): Array<Slab3D>
        => 3.MapRange(i =>
            i == 0 ? Slab3D(Direction3D(Vector3D.UnitX), NumberInterval(b.Min.X, b.Max.X))
            : (i == 1 ? Slab3D(Direction3D(Vector3D.UnitY), NumberInterval(b.Min.Y, b.Max.Y))
            : Slab3D(Direction3D(Vector3D.UnitZ), NumberInterval(b.Min.Z, b.Max.Z))));
}
