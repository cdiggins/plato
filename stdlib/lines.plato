//==
// # Line segments, infinite lines, and rays
//
// The one-dimensional flat (affine) primitives. Extent distinguishes them: a
// segment (https://en.wikipedia.org/wiki/Line_segment) is bounded by two endpoints,
// a ray (https://en.wikipedia.org/wiki/Ray_(geometry)) extends one way from its
// origin, and a line (https://en.wikipedia.org/wiki/Line_(geometry)) extends both
// ways. The two-dimensional flats and the regions they bound are in
// `lines-planes.plato`.

//==
// # Segments

// A straight bounded span, directed from A to B. The point at parameter t in
// [0, 1] is A + (B - A) * t (t = 0 is A, t = 1 is B) -- the same parametric
// contract the ray and line types state. Degenerate when A equals B.
type LineSegment2D
    implements Geometry2D, OpenShape, Connected, Bounded2D, LengthMeasurable, PointSet2D, Centroid2D, NearestPoint2D, Deformable2D
{
    A: Point2D;
    B: Point2D;
}

// A straight bounded span in space, directed from A to B. The point at parameter
// t in [0, 1] is A + (B - A) * t. Degenerate when A equals B.
type LineSegment3D
    implements Geometry3D, OpenShape, Connected, Bounded3D, LengthMeasurable, PointSet3D, Centroid3D, NearestPoint3D, Deformable3D
{
    A: Point3D;
    B: Point3D;
}

//==
// # Infinite lines and rays

// An infinite straight line in the plane: all points Origin + Direction * t for
// any real t. Origin is any point on the line.
type Line2D
    implements Geometry2D, Connected, NearestPoint2D
{
    Origin: Point2D;
    Direction: Direction2D;
}

// An infinite straight line in space: all points Origin + Direction * t for any
// real t.
type Line3D
    implements Geometry3D, Connected, NearestPoint3D
{
    Origin: Point3D;
    Direction: Direction3D;
}

// A half-line in the plane: starts at Origin and extends along Direction only.
// The point at parameter t >= 0 is Origin + Direction * t.
type Ray2D
    implements Geometry2D, Connected, NearestPoint2D
{
    Origin: Point2D;
    Direction: Direction2D;
}

// A half-line in space: starts at Origin and extends along Direction only.
// The point at parameter t >= 0 is Origin + Direction * t.
type Ray3D
    implements Geometry3D, Connected, NearestPoint3D
{
    Origin: Point3D;
    Direction: Direction3D;
}

// The implicit (general) form of a 2D line: the points (x, y) satisfying
// A*x + B*y + C = 0. Coefficients need not be normalized; (A, B) is a normal
// of the line. (https://en.wikipedia.org/wiki/Linear_equation)
type LineEquation2D
    implements Value
{
    A: Number;
    B: Number;
    C: Number;
}
