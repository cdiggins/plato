//==
// # Extents and sizes — concrete bodies
//
// Hashable obligations for the discrete extent types declared in
// `intervals-sizes.types.plato`.

library IntervalsSizes
{
    //==
    // # IntegerSize2D / IntegerSize3D

    Hash(self: IntegerSize2D): Integer
        => self.Width.Hash * 31 + self.Height.Hash;

    Hash(self: IntegerSize3D): Integer
        => ((self.Width.Hash * 31 + self.Height.Hash) * 31 + self.Depth.Hash);
}
