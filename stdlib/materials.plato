//==
// # Materials
//
// Backend-neutral surface appearance, modeled on the glTF 2.0
// metallic-roughness core with optional layer records mirroring the glTF
// material extensions. Colors are linear-light. Each layer record documents
// its own disabling convention (zero strength or black color); an absent layer
// is simply a disabled one. Texture references use the TextureBinding type of
// file 47.

// How a material's alpha is interpreted when compositing: alpha ignored
// (Opaque), a binary cutout discarding fragments below the carried Cutoff
// threshold (Mask, conventionally 0.5), or alpha compositing (Blend).
// (https://en.wikipedia.org/wiki/Alpha_compositing)
type AlphaMode
    = Opaque
    | Mask(Cutoff: Proportion)
    | Blend;

// Transparency controls. Opacity multiplies the base color's alpha
// component; Mode selects how the result is interpreted.
type AlphaSettings
    implements Value
{
    Mode: AlphaMode;
    Opacity: Proportion;
}

// The reflectance model a renderer should evaluate.
// (https://en.wikipedia.org/wiki/Bidirectional_reflectance_distribution_function)
type Brdf = Lambert | OrenNayar | GgxMetallicRoughness | Disney | Phong | BlinnPhong;

// The core physically-based material (glTF 2.0 metallic-roughness). BaseColor
// carries albedo for dielectrics, reflectance for metals, and the surface
// alpha. Metallic and Roughness follow the standard MR parameterization.
// EmissiveStrength is a dimensionless multiplier on EmissiveColor; physical
// pipelines may read the product as nits. NormalScale scales a bound normal
// map; OcclusionStrength scales a bound occlusion map (both bind via
// MaterialTextureSet). (https://en.wikipedia.org/wiki/Physically_based_rendering)
type Material
    implements Value
{
    BaseColor: Color;
    Metallic: Proportion;
    Roughness: Proportion;
    EmissiveColor: Color;
    EmissiveStrength: Number;
    NormalScale: Number;
    OcclusionStrength: Proportion;
    Alpha: AlphaSettings;
    DoubleSided: Boolean;
}

// The standard texture slots of a metallic-roughness material. Following
// glTF, the MetallicRoughness texture packs roughness in G and metallic in B,
// and Occlusion reads from R. An unbound TextureBinding (file 47) means the
// slot is unused and the scalar factors stand alone.
// (https://en.wikipedia.org/wiki/Texture_mapping)
type MaterialTextureSet
    implements Value
{
    BaseColor: TextureBinding;
    MetallicRoughness: TextureBinding;
    Normal: TextureBinding;
    Occlusion: TextureBinding;
    Emissive: TextureBinding;
}

// A metallic-roughness material paired with its texture set.
type TexturedMaterial
    implements Value
{
    Base: Material;
    Textures: MaterialTextureSet;
}

//==
// # Alternative and stylized materials

// The legacy specular-glossiness PBR workflow, kept for importing older
// assets. Prefer Material (metallic-roughness) for new content.
type SpecularGlossinessMaterial
    implements Value
{
    Diffuse: Color;
    Specular: Color;
    Glossiness: Proportion;
    Alpha: AlphaSettings;
    DoubleSided: Boolean;
}

// A shadeless material: Color is output exactly as authored, ignoring all
// lights.
type UnlitMaterial
    implements Value
{
    Color: Color;
    Alpha: AlphaSettings;
    DoubleSided: Boolean;
}

// Banded cel shading. StepCount is the number of discrete shading bands (2 =
// classic two-tone); ShadeColor is the darkened band color; RimColor is added
// at grazing angles with a RimPower falloff exponent; OutlineWidth is in
// pixels (0 = no outline). (https://en.wikipedia.org/wiki/Cel_shading)
type ToonMaterial
    implements Value
{
    BaseColor: Color;
    ShadeColor: Color;
    StepCount: Integer;
    RimColor: Color;
    RimPower: Number;
    OutlineColor: Color;
    OutlineWidth: Number;
}

// Material capture: shading is looked up from a pre-lit sphere image by
// view-space normal, baking lighting and reflectance into one texture. Tint
// multiplies the capture (white = unchanged).
type MatcapMaterial
    implements Value
{
    Capture: TextureBinding;
    Tint: Color;
}

// Renders triangle edges as lines of WireThickness pixels in WireColor, over
// faces filled with FaceColor; use a fully transparent FaceColor for edges
// only. (https://en.wikipedia.org/wiki/Wire-frame_model)
type WireframeMaterial
    implements Value
{
    WireColor: Color;
    FaceColor: Color;
    WireThickness: Number;
}
