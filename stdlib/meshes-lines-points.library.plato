//==
// # MeshesLinesPoints — deformation bodies for line sets and bare point clouds
//
// The Deformable2D/Deformable3D obligations of the face-free geometry in
// `meshes-lines-points.types.plato`: every stored position is carried through the
// mapping; the segment index pairs are pure connectivity and pass through
// unchanged.

library MeshesLinesPoints
{
    // The Deformable3D obligation: every vertex position carried through the
    // mapping, segment pairs unchanged.
    Deform(self: LineSet3D, mapping: Function1<Point3D, Point3D>): LineSet3D
        => (self.Positions.Map(mapping), self.Lines);

    // The Deformable2D obligation: every vertex position carried through the
    // mapping, segment pairs unchanged.
    Deform(self: LineSet2D, mapping: Function1<Point2D, Point2D>): LineSet2D
        => (self.Positions.Map(mapping), self.Lines);

    // The Deformable3D obligation: every position carried through the mapping.
    Deform(self: PointCloud3D, mapping: Function1<Point3D, Point3D>): PointCloud3D
        => PointCloud3D(self.Positions.Map(mapping));

    // The Deformable2D obligation: every position carried through the mapping.
    Deform(self: PointCloud2D, mapping: Function1<Point2D, Point2D>): PointCloud2D
        => PointCloud2D(self.Positions.Map(mapping));
}
