//==
// # Images — derived functions for IImage
//
// Bodies for the `IImage` concept declared in `images.concepts.plato`: a raster with
// known whole-pixel dimensions. The helpers derive the pixel count, the aspect
// and orientation tests, coordinate validity, and the row-major flat index that
// matches the tree's top-left-first storage convention. Pure expressions only;
// all inputs are immutable and evaluation is side-effect free. See
// `CONVENTIONS.md` for the UV-origin and image-storage convention.

library Images
{
    //==
    // # IImage
    //
    // A raster with known dimensions (Size, Width, Height in whole pixels).

    // The total number of pixels: Width times Height.
    PixelCount(self: IImage): Integer
        => self.Width * self.Height;

    // The width-to-height ratio of the image. Width and Height are widened to
    // Number via Integer.ToNumber. Precondition: Height is non-zero
    // (https://en.wikipedia.org/wiki/Aspect_ratio_%28image%29).
    AspectRatio(self: IImage): Number
        => self.Width.ToNumber / self.Height.ToNumber;

    // True when the image has zero area (no pixels).
    IsEmpty(self: IImage): Boolean
        => self.Width * self.Height == 0;

    // True when the image is exactly as wide as it is tall.
    IsSquare(self: IImage): Boolean
        => self.Width == self.Height;

    // True when the image is wider than it is tall.
    IsLandscape(self: IImage): Boolean
        => self.Width > self.Height;

    // True when the image is taller than it is wide.
    IsPortrait(self: IImage): Boolean
        => self.Width < self.Height;

    // The index of the rightmost column (Width - 1); negative when empty.
    LastColumn(self: IImage): Integer
        => self.Width - 1;

    // The index of the bottom row (Height - 1); negative when empty.
    LastRow(self: IImage): Integer
        => self.Height - 1;

    // True when column x lies within [0, Width).
    IsValidColumn(self: IImage, x: Integer): Boolean
        => x >= 0 && x < self.Width;

    // True when row y lies within [0, Height).
    IsValidRow(self: IImage, y: Integer): Boolean
        => y >= 0 && y < self.Height;

    // True when pixel coordinate (x, y) lies inside the image.
    ContainsPixel(self: IImage, x: Integer, y: Integer): Boolean
        => x >= 0 && x < self.Width && y >= 0 && y < self.Height;

    // The row-major flat index of pixel (x, y): y * Width + x. Matches the
    // row-major, top-left-first storage convention of the concrete image types
    // (https://en.wikipedia.org/wiki/Row-_and_column-major_order).
    PixelIndex(self: IImage, x: Integer, y: Integer): Integer
        => y * self.Width + x;

    //==
    // # Concrete image types — IImage dimension accessors
    //
    // Each raster stores its dimensions in Size; Width and Height project the
    // IntegerSize2D components for the IImage concept surface.

    Width(self: Bitmap): Integer
        => self.Size.Width;

    Height(self: Bitmap): Integer
        => self.Size.Height;

    Width(self: FloatImage): Integer
        => self.Size.Width;

    Height(self: FloatImage): Integer
        => self.Size.Height;

    Width(self: GrayscaleImage): Integer
        => self.Size.Width;

    Height(self: GrayscaleImage): Integer
        => self.Size.Height;

    Width(self: BinaryImage): Integer
        => self.Size.Width;

    Height(self: BinaryImage): Integer
        => self.Size.Height;

    Width(self: IndexedImage): Integer
        => self.Size.Width;

    Height(self: IndexedImage): Integer
        => self.Size.Height;

    Width(self: DepthImage): Integer
        => self.Size.Width;

    Height(self: DepthImage): Integer
        => self.Size.Height;

    Width(self: NormalImage): Integer
        => self.Size.Width;

    Height(self: NormalImage): Integer
        => self.Size.Height;
}
