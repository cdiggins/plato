//==
// # Image processing - tonal and color adjustments
//
// Per-pixel remappings of tone and color: the channel selector and histogram
// used to analyze an image, then the curves, levels, matrices, white balance,
// exposure, posterize, and 3D LUT records that describe how to change it.
// These are parameter records - pure data consumed by processing functions in
// a later pass.

//==
// ## Channels and histograms

// A color channel selected for analysis or adjustment.
// (https://en.wikipedia.org/wiki/Channel_(digital_image))
type ColorChannel
    = Red | Green | Blue | Alpha | Luminance | Hue | Saturation | Value | Lightness;

// A distribution of one channel's pixel values. Counts holds the number of
// pixels per bin; the bins uniformly partition Range in order.
// (https://en.wikipedia.org/wiki/Image_histogram)
type ImageHistogram
    implements Value
{
    Channel: ColorChannel;
    Counts: Array<Integer>;
    Range: NumberInterval;
}

//==
// ## Tonal and color adjustments

// A monotone tone-mapping curve as control points in the unit square,
// smoothly interpolated: X is input level, Y is output level. Points ascend
// in X. (https://en.wikipedia.org/wiki/Curve_(tonality))
type ToneCurve
    implements Value
{
    Points: Array<Point2D>;
}

// A levels adjustment: input black/white points are remapped through a gamma
// (midtone) exponent onto output black/white points.
type LevelsAdjustment
    implements Value
{
    InputBlack: Number;
    InputWhite: Number;
    Gamma: Number;
    OutputBlack: Number;
    OutputWhite: Number;
}

// A curves adjustment: a master tone curve applied to all channels plus an
// independent curve per color channel.
type CurvesAdjustment
    implements Value
{
    Master: ToneCurve;
    Red: ToneCurve;
    Green: ToneCurve;
    Blue: ToneCurve;
}

// A linear color transform: each output RGBA is the matrix times the input
// RGBA plus Offset. Encodes saturation, channel mixing, sepia, and friends.
type ColorMatrixAdjustment
    implements Value
{
    Matrix: Matrix4x4;
    Offset: Number4;
}

// A hue rotation with saturation scaling and lightness offset.
// SaturationScale of 1 and LightnessOffset of 0 leave those axes unchanged.
// (https://en.wikipedia.org/wiki/HSL_and_HSV)
type HueSaturationAdjustment
    implements Value
{
    HueShift: Angle;
    SaturationScale: Number;
    LightnessOffset: Number;
}

// A white-balance correction toward a target illuminant: Temperature slides
// blue-orange, Tint slides green-magenta (0 is neutral).
// (https://en.wikipedia.org/wiki/Color_balance)
type WhiteBalanceAdjustment
    implements Value
{
    Temperature: Temperature;
    Tint: Number;
}

// A brightness (additive) and contrast (scaling about mid-gray) adjustment;
// 0 brightness and 0 contrast is the identity.
type BrightnessContrastAdjustment
    implements Value
{
    Brightness: Number;
    Contrast: Number;
}

// An exposure adjustment in photographic stops: Stops multiplies linear light
// by two to that power; Offset lifts blacks; GammaCorrection bends midtones.
// (https://en.wikipedia.org/wiki/Exposure_(photography))
type ExposureAdjustment
    implements Value
{
    Stops: Number;
    Offset: Number;
    GammaCorrection: Number;
}

// A posterize adjustment: quantizes each channel to Levels evenly spaced
// values (Levels of 2 or more). (https://en.wikipedia.org/wiki/Posterization)
type PosterizeParameters
    implements Value
{
    Levels: Integer;
}

// A 3D color lookup table: a Size-cubed lattice of output colors indexed by
// input RGB. Colors holds Size cubed entries, red-fastest then green then
// blue; intermediate inputs interpolate trilinearly.
// (https://en.wikipedia.org/wiki/3D_lookup_table)
type ColorLookupTable
    implements Value
{
    Size: Integer;
    Colors: Array<Color>;
}
