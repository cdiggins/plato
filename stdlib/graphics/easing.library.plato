//==
// # Easing — derived functions for EasingFunction
//
// Bodies for the `EasingFunction` concept declared in `easing.concepts.plato`
// (the concrete easing types live in `easing.types.plato`). An easing
// function inherits `Procedural<Number, Number>`, so its sole operation is
// `Eval`; the helpers below rename and recombine that single evaluation
// (progress, remaining, mirrored and reversed playback, overshoot and
// anticipation tests). Pure expressions only; all inputs are immutable and
// evaluation is side-effect free. See `README.md` for naming and unit
// conventions.

library Easing
{
    //==
    // # EasingFunction
    //
    // A pure map from normalized time to normalized progress, inheriting
    // Procedural<Number, Number> (its sole operation is Eval). Eval(0) is 0 and
    // Eval(1) is 1; intermediate values may leave [0, 1] (overshoot,
    // anticipation). Helpers rename and recombine that single evaluation
    // (https://en.wikipedia.org/wiki/Inbetweening).

    // The eased progress at normalized time t; a readable spelling of Eval.
    Progress(self: EasingFunction, t: Number): Number
        => self.Eval(t);

    // The progress remaining to completion at time t: 1 - progress.
    Remaining(self: EasingFunction, t: Number): Number
        => 1.0 - self.Eval(t);

    // The eased progress at the temporal midpoint (t = 0.5): a one-number shape
    // summary distinguishing ease-in (< 0.5) from ease-out (> 0.5).
    ProgressAtMidpoint(self: EasingFunction): Number
        => self.Eval(0.5);

    // The playback-reversed curve sampled at t: f(1 - t), which runs from 1 down
    // to 0 as t goes 0 to 1 (the source curve played backwards).
    EvaluateMirrored(self: EasingFunction, t: Number): Number
        => self.Eval(1.0 - t);

    // The reversed easing sampled at t: 1 - f(1 - t). This is the standard
    // ease-in to ease-out transform, preserving the pinned endpoints.
    EvaluateReversed(self: EasingFunction, t: Number): Number
        => 1.0 - self.Eval(1.0 - t);

    // True when the curve overshoots past full progress at time t (Back and
    // Elastic families exceed 1 before settling).
    OvershootsAt(self: EasingFunction, t: Number): Boolean
        => self.Eval(t) > 1.0;

    // True when the curve anticipates below zero at time t (pulls back before
    // advancing, as the Back family does near the start).
    AnticipatesAt(self: EasingFunction, t: Number): Boolean
        => self.Eval(t) < 0.0;

    //==
    // # Parameterized easing curves — Procedural<Number, Number> Eval bodies

    // The Y coordinate of the cubic Bezier with endpoints (0, 0) and (1, 1) and
    // control points (P1.X, P1.Y), (P2.X, P2.Y), evaluated at parameter t.
    Eval(self: CubicBezierEasing, t: Number): Number
        => 0.0.CubicBezier(self.P1.Y, self.P2.Y, 1.0, t);

    // A CSS-style stepped easing: the StepPosition selects where each jump lands
    // within its interval (https://en.wikipedia.org/wiki/Step_function).
    Eval(self: StepEasing, t: Number): Number
        => match (self.Position) {
            JumpStart =>
                (((t * self.Steps.ToNumber).Floor + 1.0) / self.Steps.ToNumber).Min(1.0);
            JumpEnd =>
                t.StaircaseFloor(self.Steps);
            JumpNone =>
                self.Steps <= 1
                    ? t
                    : (t * self.Steps.ToNumber + 0.5).Floor / self.Steps.ToNumber;
            JumpBoth =>
                self.Steps <= 1
                    ? t
                    : ((t * (self.Steps - 1).ToNumber).Floor + 1.0) / self.Steps.ToNumber;
        };

    // Order 0 is linear; 1 is cubic smoothstep; 2 is quintic smootherstep; higher
    // orders fall back to linear until a closed form is added.
    Eval(self: SmoothstepEasing, t: Number): Number
        => self.Order == 0 ? t
         : self.Order == 1 ? t.SmoothStep
         : self.Order == 2 ? t.SmootherStep
         : t;

    //==
    // # ClassicEasing — the classic catalog as a curve
    //
    // https://en.wikipedia.org/wiki/Inbetweening
    // ClassicEasing is a selector, not a record, so its curve is written here.
    // Linear is the identity; every other selection is one family's ease-in
    // shape placed by its phase — Out is the reversed shape 1 - f(1 - t), and
    // InOut runs the In shape over the first half and the reversed one over the
    // second. Only the ten In shapes are spelled out; the phases are derived.

    // The decelerating bounce: four parabolic arcs of decreasing height over the
    // unit interval. The Bounce family is conventionally defined by this
    // out-phase shape, so the In shape below is its reversal rather than the
    // other way round.
    BounceOut(t: Number): Number {
        var amplitude = 7.5625;
        var period = 2.75;
        return t < 1.0 / period
                 ? amplitude * t * t
             : t < 2.0 / period
                 ? amplitude * (t - 1.5 / period) * (t - 1.5 / period) + 0.75
             : t < 2.5 / period
                 ? amplitude * (t - 2.25 / period) * (t - 2.25 / period) + 0.9375
             : amplitude * (t - 2.625 / period) * (t - 2.625 / period) + 0.984375;
    }

    // The ease-in (accelerating from rest) shape of a family at normalized
    // time t. Every shape is pinned at f(0) = 0 and f(1) = 1; Back and Elastic
    // deliberately dip below zero on the way.
    EaseIn(family: EasingFamily, t: Number): Number
        => match (family) {
            Quad => t * t;
            Cubic => t * t * t;
            Quart => t * t * t * t;
            Quint => t * t * t * t * t;
            Sine => 1.0 - Angle(t * Number.HalfPi).Cos;
            // 2^(10(t - 1)), pinned to 0 at the start where the power is 2^-10.
            Expo => t <= 0.0 ? 0.0 : 2.0.Pow(10.0 * (t - 1.0));
            Circ => 1.0 - (1.0 - t * t).Sqrt;
            // t^2 ((s + 1) t - s) with the conventional overshoot s = 1.70158,
            // which anticipates about 10% below zero before advancing.
            Back => 2.70158 * t * t * t - 1.70158 * t * t;
            // A growing oscillation that arrives at 1: the conventional
            // one-third-turn period with the endpoints pinned.
            Elastic => t <= 0.0 ? 0.0
                     : t >= 1.0 ? 1.0
                     : -(2.0.Pow(10.0 * t - 10.0))
                       * Angle((t * 10.0 - 10.75) * Number.Tau / 3.0).Sin;
            Bounce => 1.0 - BounceOut(1.0 - t);
        };

    // A family's curve in a given phase at normalized time t.
    EaseAt(family: EasingFamily, phase: EasingPhase, t: Number): Number
        => match (phase) {
            In => EaseIn(family, t);
            Out => 1.0 - EaseIn(family, 1.0 - t);
            InOut => t < 0.5
                       ? EaseIn(family, 2.0 * t) / 2.0
                       : 1.0 - EaseIn(family, 2.0 - 2.0 * t) / 2.0;
        };

    // The classic easing curve at normalized time t.
    Eval(self: ClassicEasing, t: Number): Number
        => match (self) {
            Linear => t;
            Eased(family, phase) => EaseAt(family, phase, t);
        };
}
