//==
// # Lights
//
// Sections, in order:
//  - Lights
//  - Shadows, masking, and auxiliary light settings

//==
// # Lights
//
// Light sources for rendering. Photometric units are chosen to match how each
// family is naturally specified:
// - DirectionalLight and AmbientLight carry Illuminance (lux): the light
//   arriving on a surface facing the light.
// - PointLight and SpotLight carry total emitted LuminousFlux (lumens);
//   renderers derive intensity in candela from the emission solid angle.
// - Shaped emitters (Area/Disk/Sphere/Tube) carry surface Luminance (nits,
//   cd/m^2), which is independent of emitter size.
// - EnvironmentLight and ProceduralSky use dimensionless Intensity multipliers
//   over stored or computed radiance.
// Positions, radii, and ranges are unit-agnostic scene Numbers; a Range of
// zero means unlimited reach.

// How light strength decays with distance from the source. InverseSquare is
// physically correct; Smooth is inverse-square with a windowed fade to zero
// at Range. (https://en.wikipedia.org/wiki/Inverse-square_law)
type Attenuation = None | Linear | Quadratic | InverseSquare | Smooth;

//==
// # Analytic light sources

// An infinitely distant light of uniform direction (sun, moon). Direction is
// the direction the light travels, from source toward the scene. Illuminance
// is measured on a surface perpendicular to Direction (sunlight is roughly
// 100000 lux). AngularDiameter is the apparent disk size driving soft-shadow
// penumbras; the sun subtends about 0.53 degrees.
// (https://en.wikipedia.org/wiki/Illuminance)
type DirectionalLight
    implements ILightSource
{
    Direction: Direction3D;
    Color: Color;
    Illuminance: Illuminance;
    AngularDiameter: Angle;
    CastsShadows: Boolean;
}

// An omnidirectional point emitter. Flux is the total emitted luminous power;
// intensity follows as Flux over 4 pi steradians. Range of zero means
// unlimited. (https://en.wikipedia.org/wiki/Luminous_flux)
type PointLight
    implements ILightSource
{
    Position: Point3D;
    Color: Color;
    Flux: LuminousFlux;
    Range: Number;
    Falloff: Attenuation;
    CastsShadows: Boolean;
}

// A cone-restricted point emitter. InnerAngle and OuterAngle are half-angles
// measured from the cone axis: full intensity inside InnerAngle, falling to
// zero at OuterAngle. Invariant: InnerAngle <= OuterAngle. Flux is the total
// power emitted within the cone.
type SpotLight
    implements ILightSource
{
    Position: Point3D;
    Direction: Direction3D;
    Color: Color;
    Flux: LuminousFlux;
    InnerAngle: Angle;
    OuterAngle: Angle;
    Range: Number;
    Falloff: Attenuation;
    CastsShadows: Boolean;
}

// A rectangular area emitter centered at Center. Orientation carries the
// rectangle's local axes (it emits along its local forward axis) and Size its
// extent. TwoSided emitters radiate from both faces.
type AreaLight
    implements ILightSource
{
    Center: Point3D;
    Orientation: Quaternion;
    Size: Size2D;
    Color: Color;
    Luminance: Luminance;
    TwoSided: Boolean;
    CastsShadows: Boolean;
}

// A flat circular emitter of the given Radius, facing along Normal.
type DiskLight
    implements ILightSource
{
    Center: Point3D;
    Normal: Direction3D;
    Radius: Number;
    Color: Color;
    Luminance: Luminance;
    TwoSided: Boolean;
    CastsShadows: Boolean;
}

// A spherical emitter radiating uniformly in all directions: a physically
// sized alternative to PointLight that yields soft shadows and visible
// highlights.
type SphereLight
    implements ILightSource
{
    Center: Point3D;
    Radius: Number;
    Color: Color;
    Luminance: Luminance;
    CastsShadows: Boolean;
}

// A capsule-shaped emitter along the segment from Start to End with the given
// Radius; models fluorescent tubes and light strips.
type TubeLight
    implements ILightSource
{
    Start: Point3D;
    End: Point3D;
    Radius: Number;
    Color: Color;
    Luminance: Luminance;
    CastsShadows: Boolean;
}

//==
// # Environment and ambient lighting

// IImage-based lighting from a cube map (`texturing.types.plato`). Rotation spins the
// environment about the world up axis. Intensity is a dimensionless scale on
// stored texel radiance; Tint multiplies it per channel (white = unchanged).
// (https://en.wikipedia.org/wiki/IImage-based_lighting)
type EnvironmentLight
    implements IValue
{
    Cube: TextureCube;
    Rotation: Angle;
    Intensity: Number;
    Tint: Color;
}

// An analytic clear-sky model (Preetham / Hosek-Wilkie family). SunDirection
// is the direction sunlight travels; Turbidity is atmospheric haze, roughly in
// [1, 10]; GroundAlbedo is the average ground reflectance feeding bounce
// light; Intensity is a dimensionless multiplier on the computed radiance.
type ProceduralSky
    implements IValue
{
    SunDirection: Direction3D;
    Turbidity: Number;
    GroundAlbedo: Color;
    Intensity: Number;
}

// A uniform, directionless fill light applied everywhere; the crudest ambient
// term.
type AmbientLight
    implements IValue
{
    Color: Color;
    Illuminance: Illuminance;
}

// A point probe capturing local incident light for re-lighting nearby objects.
// InfluenceRadius bounds the affected region in scene units; Intensity scales
// the captured radiance.
type LightProbe
    implements IValue
{
    Position: Point3D;
    InfluenceRadius: Number;
    Intensity: Number;
}

//==
// # Shadows, masking, and auxiliary light settings
//
// The per-light controls that accompany the emitters above without
// being emitters themselves: shadow-map rendering, layer masking, measured
// photometric profiles, and participating-media scattering. Distances and radii
// are unit-agnostic scene Numbers.

// Shadow-map rendering controls for one light. Resolution is the shadow map
// edge length in pixels. Bias and NormalBias offset depth comparisons along
// the view ray and surface normal to prevent acne. PenumbraSize scales
// soft-shadow width. CascadeCount splits a directional shadow into successive
// depth ranges (1 = no cascades). MaxDistance is the farthest shadowed
// distance in scene units. (https://en.wikipedia.org/wiki/Shadow_mapping)
type ShadowSettings
    implements IValue
{
    Resolution: Integer;
    Bias: Number;
    NormalBias: Number;
    PenumbraSize: Number;
    CascadeCount: Integer;
    MaxDistance: Number;
}

// A bitmask selecting which render layers a light illuminates: bit i set means
// the light affects the RenderLayer with IIndex i (`scene3d.types.plato`). All bits set means
// all layers.
type LightLayerMask
{
    Value: Integer;
}

// A reference to a measured IES photometric distribution profile, resolved by
// Name in the surrounding asset environment. Multiplier scales the profile's
// intensities (1 = as measured).
// See https://en.wikipedia.org/wiki/Photometry_(optics).
type IesProfileReference
    implements IValue
{
    Name: String;
    Multiplier: Number;
}

// Participating-media scattering along a light's volume ("god rays").
// Anisotropy is the Henyey-Greenstein g in [-1, 1]: 0 is isotropic, positive
// scatters forward. MaxDistance bounds the ray march in scene units.
// (https://en.wikipedia.org/wiki/Volumetric_lighting)
type VolumetricLightSettings
    implements IValue
{
    Enabled: Boolean;
    Intensity: Number;
    Anisotropy: Number;
    MaxDistance: Number;
}
