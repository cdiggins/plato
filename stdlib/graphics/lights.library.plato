//==
// # Lights — derived functions for LightSource
//
// Bodies for the `LightSource` concept declared in `lights.concepts.plato`, whose sole
// concept member is the shadow-casting flag; the helpers are its two readable
// spellings. Pure expressions only; all inputs are immutable and evaluation is
// side-effect free. See `README.md` for naming and unit conventions.

library Lights
{
    //==
    // # LightSource
    //
    // A scene light whose sole concept member is the shadow-casting flag.

    // True when the light contributes shadows; a readable spelling of CastsShadows.
    IsShadowCaster(self: LightSource): Boolean
        => self.CastsShadows;

    // True when the light casts no shadows.
    IsShadowless(self: LightSource): Boolean
        => self.CastsShadows.Not;
}
