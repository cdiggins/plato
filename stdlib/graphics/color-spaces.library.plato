//==
// # Color spaces — concrete bodies
//
// IHashable obligations for the color-science types declared in
// `color-spaces.types.plato`. Conversion functions live in a later pass.

library ColorSpaces
{
    //==
    // # ColorHSV — conversion to and from linear RGB
    //
    // The standard hexcone mapping (https://en.wikipedia.org/wiki/HSL_and_HSV):
    // hue picks the sector of the colour wheel, saturation how far from the grey
    // axis, value the height. The components are treated as LINEAR-light, matching
    // `Color`'s convention — an HSV triple that came from sRGB bytes must be
    // decoded first, exactly as the named-colour table warns.

    // One channel of the hexcone: the piecewise-linear wave for a channel offset
    // `shift` sectors around the wheel from red. `k` is the hue in sectors
    // (six per turn), and the wave is 1 at the channel's own sector, falling
    // linearly to 0 two sectors away.
    HsvChannel(self: ColorHSV, shift: Number): Number
    {
        var k = (shift + self.Hue.Turns * 6.0).Modulo(6.0);
        return self.Value
            - self.Value * self.Saturation * k.Min(4.0 - k).Clamp(0.0, 1.0);
    }

    // The linear RGB reading of an HSV triple, fully opaque.
    ToColor(self: ColorHSV): Color
        => (self.HsvChannel(5.0), self.HsvChannel(3.0), self.HsvChannel(1.0), 1.0);

    // The hexcone reading of a linear colour: value is the largest channel,
    // saturation the spread over it, hue the sector the largest channel picks.
    // Grey (zero spread) reads as hue zero, black additionally as saturation
    // zero; alpha does not participate.
    ToColorHSV(self: Color): ColorHSV
    {
        var value = self.R.Max(self.G).Max(self.B);
        var spread = value - self.R.Min(self.G).Min(self.B);
        var sector =
            spread == 0.0 ? 0.0
            : value == self.R ? ((self.G - self.B) / spread).Modulo(6.0)
            : value == self.G ? (self.B - self.R) / spread + 2.0
            : (self.R - self.G) / spread + 4.0;
        return ColorHSV(
            (sector / 6.0).Turns,
            value == 0.0 ? 0.0 : spread / value,
            value);
    }

    //==
    // # Chromaticity

    // Both xy coordinates participate in the digest.
    Hash(self: Chromaticity): Integer
        => self.X.Hash * 31 + self.Y.Hash;

    //==
    // # ColorXYZ — the INumerical obligations, component-wise over X/Y/Z
    //
    // Tristimulus values are a linear space by construction: CIE XYZ is defined
    // as an integral against the colour matching functions, so summing two
    // colours' tristimulus values is summing their spectra, and scaling is
    // scaling the radiance. That makes the component-wise arithmetic below
    // physically meaningful, unlike the same operations on a gamma-encoded or
    // perceptual space — which is exactly why ColorLab and friends next door are
    // plain `IValue` and get no arithmetic.

    // Component-wise sum: the tristimulus of the combined spectra.
    Add(a: ColorXYZ, b: ColorXYZ): ColorXYZ
        => (a.X + b.X, a.Y + b.Y, a.Z + b.Z);

    // Component-wise difference.
    Subtract(a: ColorXYZ, b: ColorXYZ): ColorXYZ
        => (a.X - b.X, a.Y - b.Y, a.Z - b.Z);

    // Component-wise negation: the additive inverse, not a realizable colour.
    Negative(a: ColorXYZ): ColorXYZ
        => (-a.X, -a.Y, -a.Z);

    // Component-wise linear interpolation; t is unclamped. Interpolating in XYZ
    // is a straight radiance blend — perceptually non-uniform, which is what
    // ColorLab and OkLab exist for.
    Lerp(a: ColorXYZ, b: ColorXYZ, t: Number): ColorXYZ
        => (a.X + (b.X - a.X) * t,
            a.Y + (b.Y - a.Y) * t,
            a.Z + (b.Z - a.Z) * t);

    // Scale every component: a change of radiance at constant chromaticity.
    Multiply(a: ColorXYZ, scalar: Number): ColorXYZ
        => (a.X * scalar, a.Y * scalar, a.Z * scalar);

    // Divide every component. Precondition: scalar is non-zero.
    Divide(a: ColorXYZ, scalar: Number): ColorXYZ
        => (a.X / scalar, a.Y / scalar, a.Z / scalar);

    // Component-wise remainder against a scalar.
    Modulo(a: ColorXYZ, scalar: Number): ColorXYZ
        => (a.X.Modulo(scalar), a.Y.Modulo(scalar), a.Z.Modulo(scalar));

    // The additive identity: no light at all.
    Zero(_: ColorXYZ): ColorXYZ
        => (0.0, 0.0, 0.0);

    // The multiplicative unit. Not a white point: equal tristimulus values are
    // the equal-energy illuminant E, and every other white (D65, D50) has its own
    // triple.
    One(_: ColorXYZ): ColorXYZ
        => (1.0, 1.0, 1.0);

    // The component-wise least representable value.
    MinValue(_: ColorXYZ): ColorXYZ
        => (Number.MinValue, Number.MinValue, Number.MinValue);

    // The component-wise greatest representable value.
    MaxValue(_: ColorXYZ): ColorXYZ
        => (Number.MaxValue, Number.MaxValue, Number.MaxValue);
}
