//==
// # Cameras — derived functions for ICamera
//
// Bodies for the `ICamera` interface declared in `cameras.concepts.plato`: eye position,
// clip-range arithmetic and the orientation tests, plus the `AspectRatio`
// obligation fills for the camera types that derive their aspect ratio from
// their optics rather than storing it as a field. Pure expressions only; all
// inputs are immutable and evaluation is side-effect free. See `CONVENTIONS.md`
// for the view-space convention.

library Cameras
{
    //==
    // # ICamera
    //
    // A placed camera exposing a pose, near/far clip distances, and an image
    // aspect ratio (width over height). Invariant: 0 < Near < Far, so DepthSpan is
    // positive. AspectRatio is now a ICamera interface member: PerspectiveCamera and
    // OrthographicCamera satisfy it with their field; the bodies below discharge
    // the obligation for the camera types that derive it from their optics.

    // The camera's eye position in world space: the pose's translation.
    EyePosition(self: ICamera): Point3D
        => self.Pose.Position;

    // The depth of the rendered range: Far - Near. Precondition: Near < Far, so
    // the span is positive.
    DepthSpan(self: ICamera): Number
        => self.Far - self.Near;

    // The scene distance halfway between the near and far clip planes.
    // Precondition: Near < Far.
    DepthMidpoint(self: ICamera): Number
        => self.Near.MidPoint(self.Far);

    // The far-to-near clip ratio; large values indicate a depth range prone to
    // z-fighting under a perspective depth buffer. Precondition: Near is positive
    // (https://en.wikipedia.org/wiki/Z-fighting).
    ClipRatio(self: ICamera): Number
        => self.Far / self.Near;

    // True when a scene depth lies within the rendered [Near, Far] range.
    ContainsDepth(self: ICamera, depth: Number): Boolean
        => depth >= self.Near && depth <= self.Far;

    // The image aspect ratio (width over height) of a physical camera, taken from
    // its sensor dimensions. Precondition: SensorSize.Height is positive.
    AspectRatio(self: PhysicalCamera): Number
        => self.SensorSize.Width / self.SensorSize.Height;

    // A fisheye lens draws into a square-bounded image circle, so its aspect ratio
    // is 1 (the FieldOfView is a cone angle, not a width-to-height ratio)
    // (https://en.wikipedia.org/wiki/Fisheye_lens).
    AspectRatio(self: FisheyeCamera): Number
        => 1.0;

    // The aspect ratio of an equirectangular panorama: the longitude sweep over
    // the latitude sweep. Precondition: the latitude sweep is non-degenerate
    // (https://en.wikipedia.org/wiki/Equirectangular_projection).
    AspectRatio(self: EquirectangularCamera): Number
        => self.LongitudeSweep.Extent.Radians / self.LatitudeSweep.Extent.Radians;

    // The aspect ratio of a cylindrical panorama: the horizontal sweep over the
    // vertical field of view. Precondition: VerticalFov is non-degenerate.
    AspectRatio(self: PanoramicCamera): Number
        => self.HorizontalSweep.Radians / self.VerticalFov.Radians;

    // True when the image is wider than it is tall (aspect ratio above 1).
    IsLandscape(self: ICamera): Boolean
        => self.AspectRatio > 1.0;

    // True when the image is taller than it is wide (aspect ratio below 1).
    IsPortrait(self: ICamera): Boolean
        => self.AspectRatio < 1.0;
}
