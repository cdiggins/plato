//==
// # Materials
//
// Sections, in order:
//  - Materials
//  - Material layers (glTF-extension shaped)

//==
// # Materials
//
// Backend-neutral surface appearance, modeled on the glTF 2.0
// metallic-roughness core with optional layer records mirroring the glTF
// material extensions. Colors are linear-light. Each layer record documents
// its own disabling convention (zero strength or black color); an absent layer
// is simply a disabled one. Texture references use the TextureBinding type of
// `texturing.types.plato`.

// How a material's alpha is interpreted when compositing: alpha ignored
// (Opaque), a binary cutout discarding fragments below the carried Cutoff
// threshold (Mask, conventionally 0.5), or alpha compositing (Blend).
// (https://en.wikipedia.org/wiki/Alpha_compositing)
type AlphaMode
    = Opaque
    | Mask(Cutoff: Proportion)
    | Blend;

// Transparency controls. Opacity multiplies the base color's alpha
// component; Mode selects how the result is interpreted.
type AlphaSettings
    implements IValue
{
    Mode: AlphaMode;
    Opacity: Proportion;
}

// The reflectance model a renderer should evaluate.
// (https://en.wikipedia.org/wiki/Bidirectional_reflectance_distribution_function)
type Brdf = Lambert | OrenNayar | GgxMetallicRoughness | Disney | Phong | BlinnPhong;

// The core physically-based material (glTF 2.0 metallic-roughness). BaseColor
// carries albedo for dielectrics, reflectance for metals, and the surface
// alpha. Metallic and Roughness follow the standard MR parameterization.
// EmissiveStrength is a dimensionless multiplier on EmissiveColor; physical
// pipelines may read the product as nits. NormalScale scales a bound normal
// map; OcclusionStrength scales a bound occlusion map (both bind via
// MaterialTextureSet). (https://en.wikipedia.org/wiki/Physically_based_rendering)
type Material
    implements IValue
{
    BaseColor: Color;
    Metallic: Proportion;
    Roughness: Proportion;
    EmissiveColor: Color;
    EmissiveStrength: Number;
    NormalScale: Number;
    OcclusionStrength: Proportion;
    Alpha: AlphaSettings;
    DoubleSided: Boolean;
}

// The standard texture slots of a metallic-roughness material. Following
// glTF, the MetallicRoughness texture packs roughness in G and metallic in B,
// and Occlusion reads from R. An unbound TextureBinding (`texturing.types.plato`) means the
// slot is unused and the scalar factors stand alone.
// (https://en.wikipedia.org/wiki/Texture_mapping)
type MaterialTextureSet
    implements IValue
{
    BaseColor: TextureBinding;
    MetallicRoughness: TextureBinding;
    Normal: TextureBinding;
    Occlusion: TextureBinding;
    Emissive: TextureBinding;
}

// A metallic-roughness material paired with its texture set.
type TexturedMaterial
    implements IValue
{
    Base: Material;
    Textures: MaterialTextureSet;
}

//==
// # Alternative and stylized materials

// The legacy specular-glossiness PBR workflow, kept for importing older
// assets. Prefer Material (metallic-roughness) for new content.
type SpecularGlossinessMaterial
    implements IValue
{
    Diffuse: Color;
    Specular: Color;
    Glossiness: Proportion;
    Alpha: AlphaSettings;
    DoubleSided: Boolean;
}

// A shadeless material: Color is output exactly as authored, ignoring all
// lights.
type UnlitMaterial
    implements IValue
{
    Color: Color;
    Alpha: AlphaSettings;
    DoubleSided: Boolean;
}

// Banded cel shading. StepCount is the number of discrete shading bands (2 =
// classic two-tone); ShadeColor is the darkened band color; RimColor is added
// at grazing angles with a RimPower falloff exponent; OutlineWidth is in
// pixels (0 = no outline). (https://en.wikipedia.org/wiki/Cel_shading)
type ToonMaterial
    implements IValue
{
    BaseColor: Color;
    ShadeColor: Color;
    StepCount: Integer;
    RimColor: Color;
    RimPower: Number;
    OutlineColor: Color;
    OutlineWidth: Number;
}

// Material capture: shading is looked up from a pre-lit sphere image by
// view-space normal, baking lighting and reflectance into one texture. Tint
// multiplies the capture (white = unchanged).
type MatcapMaterial
    implements IValue
{
    Capture: TextureBinding;
    Tint: Color;
}

// Renders triangle edges as lines of WireThickness pixels in WireColor, over
// faces filled with FaceColor; use a fully transparent FaceColor for edges
// only. (https://en.wikipedia.org/wiki/Wire-frame_model)
type WireframeMaterial
    implements IValue
{
    WireColor: Color;
    FaceColor: Color;
    WireThickness: Number;
}

//==
// # Material layers (glTF-extension shaped)
//
// The optional appearance layers stacked over the metallic-roughness base of
// the section above, one record per glTF material extension, plus the fully
// layered surface that gathers them. Each record documents its own disabling
// convention (zero strength or black color), so an absent layer is simply a
// disabled one.

// A thin lacquer layer over the base surface (car paint, varnish). Intensity 0
// disables the layer. IndexOfRefraction is 1.5 in the glTF extension.
type ClearCoatLayer
    implements IValue
{
    Intensity: Proportion;
    Roughness: Proportion;
    NormalScale: Number;
    IndexOfRefraction: Number;
}

// Micro-fiber retroreflection for cloth (velvet, satin). A black Color
// disables the layer. (https://en.wikipedia.org/wiki/Retroreflector)
type SheenLayer
    implements IValue
{
    Color: Color;
    Roughness: Proportion;
}

// Adjustable dielectric specular reflectance (glTF KHR_materials_specular).
// Strength scales the reflectance amount and Color tints it; Strength 1 with
// a white Color is the physical default.
// (https://en.wikipedia.org/wiki/Specular_reflection)
type SpecularLayer
    implements IValue
{
    Strength: Proportion;
    Color: Color;
}

// Light transmission through the surface with volume attenuation (glass,
// liquids, gemstones). Transmission 0 disables the layer. Thickness and
// AttenuationDistance are in scene units: light traveling AttenuationDistance
// through the medium is tinted to AttenuationColor.
// (https://en.wikipedia.org/wiki/Refractive_index)
type TransmissionLayer
    implements IValue
{
    Transmission: Proportion;
    IndexOfRefraction: Number;
    Thickness: Number;
    AttenuationColor: Color;
    AttenuationDistance: Number;
}

// Thin-film interference (soap bubbles, oil slicks, beetle shells). Intensity
// 0 disables the layer. Film thickness varies between ThicknessMinimum and
// ThicknessMaximum, measured in nanometers per the glTF extension.
// (https://en.wikipedia.org/wiki/Thin-film_interference)
type IridescenceLayer
    implements IValue
{
    Intensity: Proportion;
    IndexOfRefraction: Number;
    ThicknessMinimum: Number;
    ThicknessMaximum: Number;
}

// Direction-dependent roughness (brushed metal, hair, vinyl). Strength 0
// disables the layer; Rotation turns the tangent-space anisotropy direction.
// (https://en.wikipedia.org/wiki/Anisotropy)
type AnisotropyLayer
    implements IValue
{
    Strength: Proportion;
    Rotation: Angle;
}

// Sub-surface light diffusion (skin, wax, marble). Radius is the per-channel
// mean free path in scene units, uniformly scaled by Scale (0 disables);
// Anisotropy is the Henyey-Greenstein g in [-1, 1].
// (https://en.wikipedia.org/wiki/Subsurface_scattering)
type SubsurfaceParameters
    implements IValue
{
    Color: Color;
    Radius: Number3;
    Scale: Number;
    Anisotropy: Number;
}

// A fully layered surface: a textured metallic-roughness base plus every
// optional layer. Each layer's zero/black convention (see the layer docs)
// marks it disabled, so a plain surface is representable without waste.
type LayeredMaterial
    implements IValue
{
    Base: TexturedMaterial;
    ClearCoat: ClearCoatLayer;
    Sheen: SheenLayer;
    Specular: SpecularLayer;
    Transmission: TransmissionLayer;
    Iridescence: IridescenceLayer;
    Anisotropy: AnisotropyLayer;
    Subsurface: SubsurfaceParameters;
}
