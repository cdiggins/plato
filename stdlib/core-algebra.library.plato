//==
// # CoreAlgebra
//
// Derived functionality for the core (file 01) and algebra (file 02) concepts.
// Every function's first parameter is concept-typed, so the function becomes
// available on every type implementing that concept. Bodies are pure
// expressions built only from members declared on the concept, its inherited
// concepts, or other functions in this library.
//
// Successor to plato-src/core.library.plato + algebra.plato. Renames from v1:
//   Sqr -> Square, Pow3 -> Cube, Twice -> Double, CompareTo -> Compare,
//   ClampZeroOne -> Saturate, FromOne -> dropped, MultiplyEpsilon -> folded
//   into AlmostEqual(x, y, tolerance) with an explicit tolerance.

library CoreAlgebra
{
    //==
    // Orderable
    //
    // LessThanOrEquals itself cannot be derived here: it IS the primitive of
    // Orderable, so there is nothing on the concept surface to build it from.
    // The only mechanical lever for the outstanding LessThanOrEquals obligations
    // is a *narrower* concept whose implementors share a carrier with a known
    // order — that is `Index` (single `Value: Integer`), and its generic body
    // lives in `collections-functional.library.plato` because P2 owns `Index`
    // (LIBRARIES.md rule 10). It discharges every typed-index implementor.
    //
    // The remaining implementors have no shared derivable order and each needs a
    // concrete body in its owning package, not a generic one here:
    //   - Rational (numbers) — ordering is a/b <= c/d via cross-multiplication,
    //     and its sign handling depends on the denominator's sign. Not mechanical.
    //   - Proportion / Percent / Probability / Cardinal / SafetyFactor — trivially
    //     order on their single numeric field, but they are not Index implementors
    //     and their bodies belong to numbers.plato / engineering.plato territory.
    //   - Instant / BeatTime (time) — single-field, order on SecondsSinceEpoch
    //     and Beats respectively; concrete bodies for the time domain.
    //   - FrameTime (time) — carries Frame AND Rate. Comparing on Frame alone is
    //     WRONG whenever two FrameTimes carry different rates; a correct body
    //     must convert both to seconds. Explicitly not mechanical.
    //   - Boolean / String / Character (primitives) — host-intrinsic orders
    //     (false < true, lexicographic, code-point). Not expressible on a concept.
    // TODO(cross-package): fill the above in their owning packages.

    // True when a is strictly less than b.
    LessThan(a: Orderable, b: Orderable): Boolean
        => a <= b && a != b;

    // True when a is strictly greater than b.
    GreaterThan(a: Orderable, b: Orderable): Boolean
        => b.LessThan(a);

    // True when a is greater than or equal to b.
    GreaterThanOrEquals(a: Orderable, b: Orderable): Boolean
        => b <= a;

    // The lesser of the two values, using the total order.
    Lesser(a: Orderable, b: Orderable): Orderable
        => a <= b ? a : b;

    // The greater of the two values, using the total order.
    Greater(a: Orderable, b: Orderable): Orderable
        => a <= b ? b : a;

    // True when x lies within the inclusive range [lower, upper].
    Between(x: Orderable, lower: Orderable, upper: Orderable): Boolean
        => lower <= x && x <= upper;

    // Restricts x to the inclusive range [lower, upper] using the total order.
    // Assumes lower <= upper.
    Clamp(x: Orderable, lower: Orderable, upper: Orderable): Orderable
        => x.Greater(lower).Lesser(upper);

    // The least of three values, using the total order.
    Min3(a: Orderable, b: Orderable, c: Orderable): Orderable
        => a.Lesser(b).Lesser(c);

    // The greatest of three values, using the total order.
    Max3(a: Orderable, b: Orderable, c: Orderable): Orderable
        => a.Greater(b).Greater(c);

    // Three-way comparison derived from the total order: negative when a < b,
    // zero when equal, positive when a > b. Declared as a member on Comparable,
    // but derivable from Orderable alone, so it lives here on the base concept.
    Compare(a: Orderable, b: Orderable): Integer
        => a == b ? 0 : (a <= b ? -1 : 1);

    //==
    // Logical

    // Negated conjunction: not (a and b).
    Nand(a: Logical, b: Logical): Logical
        => a.And(b).Not;

    // Negated disjunction: not (a or b).
    Nor(a: Logical, b: Logical): Logical
        => a.Or(b).Not;

    // Material implication: a implies b, i.e. (not a) or b.
    Implies(a: Logical, b: Logical): Logical
        => a.Not.Or(b);

    //==
    // BooleanAlgebra

    // Logical equivalence (XNOR): true when a and b have the same truth value.
    Equivalent(a: BooleanAlgebra, b: BooleanAlgebra): BooleanAlgebra
        => a.ExclusiveOr(b).Not;

    //==
    // Bitwise

    // Bitwise negated-and of the corresponding bits of a and b.
    BitwiseNand(a: Bitwise, b: Bitwise): Bitwise
        => a.BitwiseAnd(b).BitwiseNot;

    // Bitwise negated-or of the corresponding bits of a and b.
    BitwiseNor(a: Bitwise, b: Bitwise): Bitwise
        => a.BitwiseOr(b).BitwiseNot;

    //==
    // Additive

    // The value added to itself: x + x. (Name overlaps C#'s Double type; unambiguous
    // here as a method and worth keeping for the additive-doubling idiom.)
    Double(x: Additive): Additive
        => x + x;

    //==
    // Multiplicative

    // The value multiplied by itself: x * x.
    Square(x: Multiplicative): Multiplicative
        => x * x;

    // The value raised to the third power: x * x * x.
    Cube(x: Multiplicative): Multiplicative
        => x * x * x;

    // The value raised to the fourth power.
    Pow4(x: Multiplicative): Multiplicative
        => x.Square.Square;

    // The value raised to the fifth power.
    Pow5(x: Multiplicative): Multiplicative
        => x.Square.Square * x;

    //==
    // Scalable

    // Half of x (divides by two).
    Half(x: Scalable): Scalable
        => x / 2.0;

    // One third of x (divides by three).
    Third(x: Scalable): Scalable
        => x / 3.0;

    // One quarter of x (divides by four).
    Quarter(x: Scalable): Scalable
        => x / 4.0;

    // One eighth of x. (v1 spelled this `Eight`, which named the wrong number;
    // renamed per LIBRARIES.md rule 4.)
    Eighth(x: Scalable): Scalable
        => x / 8.0;

    // One sixteenth of x.
    Sixteenth(x: Scalable): Scalable
        => x / 16.0;

    // One tenth of x.
    Tenth(x: Scalable): Scalable
        => x / 10.0;

    // One hundredth of x.
    Hundredth(x: Scalable): Scalable
        => x / 100.0;

    // One thousandth of x.
    Thousandth(x: Scalable): Scalable
        => x / 1000.0;

    // One millionth of x.
    Millionth(x: Scalable): Scalable
        => x / 1000000.0;

    // One billionth of x (short-scale billion, 1e9).
    Billionth(x: Scalable): Scalable
        => x / 1000000000.0;

    // A million times x.
    Million(x: Scalable): Scalable
        => x * 1000000.0;

    // A billion times x (short-scale billion, 1e9).
    Billion(x: Scalable): Scalable
        => x * 1000000000.0;

    // Scales x by the given percentage (100 yields x unchanged).
    Percent(x: Scalable, percent: Number): Scalable
        => x * (percent / 100.0);

    // Scalar-on-the-left multiplication, so `2.0 * v` reads as well as `v * 2.0`.
    // Delegates to the Scalable member; adds no new semantics.
    Multiply(scalar: Number, x: Scalable): Scalable
        => x * scalar;

    //==
    // Interpolatable

    // The midpoint between a and b (linear interpolation at t = 0.5).
    MidPoint(a: Interpolatable, b: Interpolatable): Interpolatable
        => a.Lerp(b, 0.5);

    // Linear interpolation with the parameter t clamped to [0, 1], so the result
    // never extrapolates beyond the a..b segment.
    LerpClamped(a: Interpolatable, b: Interpolatable, t: Number): Interpolatable
        => a.Lerp(b, t.Saturate);

    // Interpolates from a to b with smoothstep easing: the parameter t is reshaped
    // by the weight t*t*(3 - 2*t), giving zero slope at both ends for a gentle
    // start and stop. Requested cross-package by P3 (Coordinate). Assumes t in [0,1].
    SmoothLerp(a: Interpolatable, b: Interpolatable, t: Number): Interpolatable
        => a.Lerp(b, t * t * (3.0 - 2.0 * t));

    //==
    // Numerical

    // True when x equals the additive identity (zero).
    IsZero(x: Numerical): Boolean
        => x == x.Zero;

    // True when x equals the multiplicative identity (one).
    IsOne(x: Numerical): Boolean
        => x == x.One;

    // The weighted sum a*s + b*t of two values with scalar weights.
    LinearCombination(a: Numerical, b: Numerical, s: Number, t: Number): Numerical
        => a * s + b * t;

    // Barycentric blend of three values: at (u,v)=(0,0) yields a, (1,0) yields b,
    // (0,1) yields c.
    Barycentric(a: Numerical, b: Numerical, c: Numerical, u: Number, v: Number): Numerical
        => a + (b - a) * u + (c - a) * v;

    //==
    // Real

    // The absolute value of x (its magnitude on the number line).
    Abs(x: Real): Real
        => x.LessThan(x.Zero) ? x.Negative : x;

    // The sign of x as an integer: -1, 0, or +1.
    Sign(x: Real): Integer
        => x.Compare(x.Zero);

    // The complement of x within the unit interval: one minus x. Handy for weights
    // and easing (e.g. the (1 - t) factor in a Bezier blend).
    OneMinus(x: Real): Real
        => x.One - x;

    // True when x is strictly greater than zero.
    IsPositive(x: Real): Boolean
        => x.Zero.LessThan(x);

    // True when x is strictly less than zero.
    IsNegative(x: Real): Boolean
        => x.LessThan(x.Zero);

    // True when x and y differ by no more than the given (non-negative) tolerance.
    AlmostEqual(x: Real, y: Real, tolerance: Real): Boolean
        => (x - y).Abs <= tolerance;

    // True when x is within the given (non-negative) tolerance of zero.
    AlmostZero(x: Real, tolerance: Real): Boolean
        => x.Abs <= tolerance;

    // True when x sits at either end of the unit interval, within the given
    // (non-negative) tolerance. Useful for detecting degenerate curve parameters.
    AlmostZeroOrOne(x: Real, tolerance: Real): Boolean
        => x.AlmostZero(tolerance) || x.AlmostEqual(x.One, tolerance);

    // Clamps x to the inclusive range [0, 1].
    Saturate(x: Real): Real
        => x.Clamp(x.Zero, x.One);

    // The parameter t in [0,1] for which Lerp(a, b, t) equals value. Assumes a != b.
    InverseLerp(a: Real, b: Real, value: Real): Number
        => ((value - a) / (b - a)).ToNumber;

    // Remaps value from the input range [inputMin, inputMax] onto the output range
    // [outputMin, outputMax]. Assumes inputMin != inputMax.
    Remap(value: Real, inputMin: Real, inputMax: Real, outputMin: Real, outputMax: Real): Real
        => outputMin.Lerp(outputMax, inputMin.InverseLerp(inputMax, value));

    // Divides x by divisor, returning fallback instead when divisor is zero.
    SafeDivide(x: Real, divisor: Real, fallback: Real): Real
        => divisor.IsZero ? fallback : x / divisor;

    // The fractional part of x: x minus its floor, always in [0, 1). For negative
    // x this is the periodic fraction (e.g. FractionalPart(-0.25) = 0.75), matching Floor.
    FractionalPart(x: Real): Real
        => x - x.Floor;

    // x rounded to the nearest whole value, halves rounding up (toward +infinity),
    // via Floor(x + 1/2). Note: deliberately half-up, unlike the host intrinsic
    // Round (typically banker's rounding) — do not "simplify" to Round.
    RoundedToNearest(x: Real): Real
        => (x + x.One.Half).Floor;

    //==
    // Number
    //
    // A small set of shaping helpers that are deliberately Number-concrete rather
    // than generic over Real: they read the `Pow` intrinsic (declared only on
    // Number), and on a type that is simultaneously Multiplicative and Scalable a
    // generic `x * 2.0` has two equally good readings. Vector/quantity versions
    // belong with the component-wise lifting on `Vector` (P3), not here.

    // x raised to the reciprocal power: the y-th root of x. InversePow(x, 2) is
    // the square root, InversePow(x, 3) the cube root. Precondition: y is not zero.
    InversePow(x: Number, y: Number): Number
        => x.Pow(1.0 / y);

    // The classic smoothstep shaping function 3x^2 - 2x^3, with zero slope at
    // both ends of the unit interval. Assumes x is in [0, 1]; saturate first if not.
    // (For interpolation between two values use SmoothLerp above.)
    SmoothStep(x: Number): Number
        => x * x * (3.0 - 2.0 * x);

    // Ken Perlin's quintic shaping function 6x^5 - 15x^4 + 10x^3, with zero first
    // AND second derivative at both ends. Assumes x is in [0, 1].
    SmootherStep(x: Number): Number
        => x * x * x * (x * (x * 6.0 - 15.0) + 10.0);

    // The staircase function: x quantized down to the nearest of `steps` equal
    // treads per unit. Precondition: steps is positive.
    // https://mathworld.wolfram.com/StaircaseFunction.html
    StaircaseFloor(x: Number, steps: Integer): Number
        => (x * steps.ToNumber).Floor / steps.ToNumber;

    // The staircase function quantizing up to the nearest tread of `steps` per
    // unit. Precondition: steps is positive.
    StaircaseCeiling(x: Number, steps: Integer): Number
        => (x * steps.ToNumber).Ceiling / steps.ToNumber;

    // The staircase function quantizing to the nearest tread of `steps` per unit,
    // halves going up. Precondition: steps is positive.
    StaircaseRound(x: Number, steps: Integer): Number
        => (x * steps.ToNumber).RoundedToNearest / steps.ToNumber;

    //==
    // Whole

    // True when x equals zero.
    IsZero(x: Whole): Boolean
        => x == x.Zero;

    // True when x equals one.
    IsOne(x: Whole): Boolean
        => x == x.One;

    // The absolute value of x.
    Abs(x: Whole): Whole
        => x.LessThan(x.Zero) ? x.Negative : x;

    // The sign of x as an integer: -1, 0, or +1.
    Sign(x: Whole): Integer
        => x.Compare(x.Zero);

    // True when x is evenly divisible by two.
    IsEven(x: Whole): Boolean
        => x.Modulo(x.One + x.One) == x.Zero;

    // True when x is not evenly divisible by two.
    IsOdd(x: Whole): Boolean
        => x.IsEven.Not;

    // True when x is strictly greater than zero.
    IsPositive(x: Whole): Boolean
        => x.Zero.LessThan(x);

    // True when x is strictly less than zero.
    IsNegative(x: Whole): Boolean
        => x.LessThan(x.Zero);

    //==
    // Invertible
    //
    // No derivations: Inverse is the sole member and every useful combination
    // (e.g. a/b as a * b.Inverse) requires Multiplicative, which Invertible does
    // not inherit. Types that are both (Real via Arithmetic) get division directly.

    //==
    // Normed

    // True when x has unit length, within the given tolerance on the squared
    // magnitude (avoids the square root).
    IsUnit(x: Normed, tolerance: Number): Boolean
        => x.MagnitudeSquared.AlmostEqual(1.0, tolerance);

    // True when x has (near) zero length, within the given squared-magnitude tolerance.
    IsZeroLength(x: Normed, tolerance: Number): Boolean
        => x.MagnitudeSquared <= tolerance;

    //==
    // MetricSpace

    // True when a and b are within the given tolerance of each other.
    IsNear(a: MetricSpace, b: MetricSpace, tolerance: Number): Boolean
        => a.Distance(b) <= tolerance;

    // True when candidate is strictly nearer to reference than other is.
    // Example: origin.IsNearerThan(p, q) tests whether p is closer to origin than q.
    IsNearerThan(reference: MetricSpace, candidate: MetricSpace, other: MetricSpace): Boolean
        => reference.Distance(candidate).LessThan(reference.Distance(other));

    // Whichever of a and b is nearer to reference (ties resolve to a).
    Nearest(reference: MetricSpace, a: MetricSpace, b: MetricSpace): MetricSpace
        => reference.Distance(a) <= reference.Distance(b) ? a : b;

    //==
    // Lattice

    // Component-wise clamp of x into the inclusive box [min, max], derived from the
    // lattice Min/Max. Assumes min <= max component-wise. (Provides the default body
    // for the Clampable.Clamp member, since Clampable inherits Lattice.)
    Clamp(x: Lattice, min: Lattice, max: Lattice): Lattice
        => x.Max(min).Min(max);

    //==
    // Difference<TDelta>
    //
    // TODO(concept-gap): the useful derivations here (e.g. a midpoint between two
    // positions) need to scale a TDelta by 0.5 — i.e. they require TDelta : Scalable.
    // That is a *bound on the type parameter*, and Plato has no type-parameter
    // constraint syntax: no `where` clause, no `<T : Concept>` form, and no way to
    // bound a generic function's own type variable (verified by grep across stdlib).
    // So `MidPoint(a, b) => a.Add(a.Between(b).Multiply(0.5))` cannot type-check:
    // `Between(a, b) : TDelta` is an unbounded variable with no Multiply(Number).
    // The obligation also cannot be discharged from here — every Difference
    // implementor lives in points.plato / time.plato (Vector2D/3D/N, Duration),
    // which this package does not own. When the language gains type-parameter
    // bounds, add TDelta : Scalable to the Difference declaration and MidPoint
    // becomes a one-liner. Add(x, delta), Subtract(x, delta) and Between(a, b)
    // remain primitive per implementing type until then.
}
