//==
// # Surfaces
//
// Patches, control nets, and generated surfaces (revolve, extrude, rule, loft,
// sweep). Control nets use Array2D with the U direction along columns and the
// V direction along rows. Generator curves referenced as concepts (Curve2D,
// Curve3D) are supplied by any concrete curve type.

//==
// # Patches and control nets

// The bilinearly interpolated patch over four corner points: the simplest
// curved quadrilateral surface.
type BilinearPatch
    implements ParametricSurface
{
    P00: Point3D;
    P10: Point3D;
    P01: Point3D;
    P11: Point3D;
}

// A tensor-product Bezier patch: U degree = column count - 1, V degree =
// row count - 1. Interpolates the four corner control points.
type BezierPatch
    implements ParametricSurface
{
    ControlPoints: Array2D<Point3D>;
}

// A tensor-product B-spline surface. UKnots must hold column count + UDegree
// + 1 values, and VKnots row count + VDegree + 1 values.
type BSplineSurface
    implements ParametricSurface
{
    ControlPoints: Array2D<Point3D>;
    UDegree: Integer;
    VDegree: Integer;
    UKnots: KnotVector;
    VKnots: KnotVector;
}

// A non-uniform rational B-spline surface: a B-spline surface with per-point
// Weights (same dimensions as ControlPoints). The CAD interchange standard;
// represents quadrics exactly.
type NurbsSurface
    implements ParametricSurface
{
    ControlPoints: Array2D<Point3D>;
    Weights: Array2D<Number>;
    UDegree: Integer;
    VDegree: Integer;
    UKnots: KnotVector;
    VKnots: KnotVector;
}

// A rectangular piece of a plane: (u, v) in Domain maps to the frame origin
// plus u along the frame's X axis and v along its Y axis.
type PlanarPatch
    implements ParametricSurface
{
    Frame: Frame3D;
    Domain: Bounds2D;
}

// A Coons patch: the surface blended from four boundary curves. The curves
// must meet at the patch corners (Bottom/Top run in U, Left/Right run in V).
type CoonsPatch
    implements ParametricSurface
{
    Bottom: Curve3D;
    Right: Curve3D;
    Top: Curve3D;
    Left: Curve3D;
}

// A rectangular region of a sphere bounded by azimuth and inclination
// intervals (a latitude/longitude window).
type SphericalPatch
    implements ParametricSurface
{
    Sphere: Sphere;
    Azimuths: AngleInterval;
    Inclinations: AngleInterval;
}

//==
// # Generated surfaces

// The surface swept by revolving a profile curve about an axis. The profile's
// X coordinate is the radial distance from the axis and its Y coordinate runs
// along the axis; Angles is the sweep (a full turn closes the surface in U).
type SurfaceOfRevolution
    implements ParametricSurface
{
    Profile: Curve2D;
    Axis: Line3D;
    Angles: AngleInterval;
}

// The surface swept by translating a profile curve along a straight direction
// for a distance: U follows the profile, V the extrusion.
type ExtrudedSurface
    implements ParametricSurface
{
    Profile: Curve3D;
    Direction: Direction3D;
    Distance: Number;
}

// The ruled surface between two curves: straight line segments join Start and
// End at equal parameter values (U along the curves, V across the rulings).
type RuledSurface
    implements ParametricSurface
{
    Start: Curve3D;
    End: Curve3D;
}

// The surface interpolating an ordered stack of cross-section polylines:
// U runs around each section, V across sections. Sections must share point
// counts; Closed wraps the last section back to the first.
type LoftedSurface
    implements ParametricSurface
{
    Sections: Array<Polyline3D>;
    Closed: Boolean;
}

// The surface swept by a 2D profile carried along a 3D path in the path's
// rotation-minimizing frame: U follows the profile, V the path.
type SweptSurface
    implements ParametricSurface
{
    Profile: Curve2D;
    Path: Curve3D;
}

// A circular-section pipe around a path: the sweep of a circle of radius
// Radius held normal to the path (U around the circle, V along the path).
type TubeSurface
    implements ParametricSurface
{
    Path: Curve3D;
    Radius: Number;
}

// The surface displaced from a base surface by a constant Distance along its
// normal (positive Distance follows the base orientation).
type OffsetSurface
    implements ParametricSurface
{
    Base: ParametricSurface;
    Distance: Number;
}

//==
// # Bounded and sampled surfaces

// A parametric surface restricted to a region of its UV domain: OuterLoop is
// a closed counter-clockwise polyline in UV space, and Holes are closed
// clockwise loops removed from it. Not a rectangular patch, so only Surface.
type TrimmedSurface
    implements Surface
{
    Base: ParametricSurface;
    OuterLoop: Polyline2D;
    Holes: Array<Polyline2D>;
}

// A sampled elevation surface: Heights holds regular samples over the ground
// rectangle Domain in the XY plane (columns along X, rows along Y), with
// bilinear interpolation between samples. Terrain and displacement data.
type HeightField
    implements HeightFieldSurface
{
    Heights: Array2D<Number>;
    Domain: Bounds2D;
}

//==
// # Topological and subdivision surfaces

// A Mobius band: a strip of the given Width whose centerline circle of radius
// Radius lies in the frame's XY plane, twisted by HalfTwistCount half-turns
// over one lap. An odd count yields the one-sided surface.
type MobiusStrip
    implements ParametricSurface
{
    Frame: Frame3D;
    Radius: Number;
    Width: Number;
    HalfTwistCount: Integer;
}

// The subdivision scheme applied to a control mesh.
type SubdivisionScheme = CatmullClark | Loop | DooSabin;

// The limit surface of a control mesh under a subdivision scheme, evaluated
// (or approximated) at the given refinement level.
type SubdivisionSurface
    implements Surface
{
    ControlMesh: PolygonMesh3D;
    Scheme: SubdivisionScheme;
    Levels: Integer;
}

//==
// # Parametric evaluation
//
// The ParametricSurface obligations (Eval / ClosedU / ClosedV) for the types
// above. Same UV convention as `library Solids` in solids.plato: UV is the unit
// square, U is the first (profile / column) direction and V the second (sweep /
// row) direction, and ClosedU/ClosedV say whether the surface seams shut across
// that direction — which is exactly the pair
// `AllQuadFaceIndices(nCols, nRows, ClosedU, ClosedV)` in
// meshes-spatial.library.plato consumes.
//
// Only the closed-form surfaces get an `Eval` here. The control-net surfaces
// (Bezier / B-spline / NURBS / Coons) and the frame-carrying sweeps
// (SurfaceOfRevolution, SweptSurface, LoftedSurface, TubeSurface, OffsetSurface)
// need de Casteljau/de Boor evaluation or a rotation-minimizing frame, neither of
// which exists in this tree yet; they are left as TODO(content) below and keep
// only their closure answers, which ARE derivable and are what tessellation reads.

library Surfaces
{
    //==
    // Patches and control nets

    // Bilinear interpolation of the four corners: lerp along U on each V edge,
    // then lerp between those two results along V.
    Eval(s: BilinearPatch, uv: UvCoordinate): Point3D
        => s.P00.Lerp(s.P10, uv.U).Lerp(s.P01.Lerp(s.P11, uv.U), uv.V);
    ClosedU(s: BilinearPatch): Boolean => false;
    ClosedV(s: BilinearPatch): Boolean => false;

    // TODO(content): Eval needs de Casteljau over the control net.
    ClosedU(s: BezierPatch): Boolean => false;
    ClosedV(s: BezierPatch): Boolean => false;

    // TODO(content): Eval needs de Boor over the knot vectors.
    ClosedU(s: BSplineSurface): Boolean => false;
    ClosedV(s: BSplineSurface): Boolean => false;

    // TODO(content): Eval needs rational de Boor (weighted, then projected).
    ClosedU(s: NurbsSurface): Boolean => false;
    ClosedV(s: NurbsSurface): Boolean => false;

    // The frame origin displaced by the Domain-mapped parameters along the
    // frame's X and Y axes.
    Eval(s: PlanarPatch, uv: UvCoordinate): Point3D
        => s.Frame.PointInFrame(Point3D(s.Domain.Min.X.Lerp(s.Domain.Max.X, uv.U),
                                        s.Domain.Min.Y.Lerp(s.Domain.Max.Y, uv.V),
                                        0.0));
    ClosedU(s: PlanarPatch): Boolean => false;
    ClosedV(s: PlanarPatch): Boolean => false;

    // TODO(content): Eval needs the Coons blend of the four boundary curves,
    // which needs component-wise addition of Point3D (Point3D is Interpolatable,
    // not Additive, so the blend is not expressible with the current concepts).
    ClosedU(s: CoonsPatch): Boolean => false;
    ClosedV(s: CoonsPatch): Boolean => false;

    // A latitude/longitude window: U sweeps the azimuth interval, V the
    // inclination interval (measured from the sphere's +Z pole).
    Eval(s: SphericalPatch, uv: UvCoordinate): Point3D
    {
        var azimuth = s.Azimuths.Lerp(uv.U);
        var inclination = s.Inclinations.Lerp(uv.V);
        var r = s.Sphere.Radius;
        return (s.Sphere.Center.X + inclination.Sin * azimuth.Cos * r,
                s.Sphere.Center.Y + inclination.Sin * azimuth.Sin * r,
                s.Sphere.Center.Z + inclination.Cos * r);
    }
    // A window, not a full lap: closed only if the caller supplied a whole turn,
    // which the patch does not promise, so both answers are false.
    ClosedU(s: SphericalPatch): Boolean => false;
    ClosedV(s: SphericalPatch): Boolean => false;

    //==
    // Generated surfaces

    // TODO(content): Eval needs the profile lifted into the axis frame.
    // Closure in U is decidable, though: a sweep of a whole turn seams shut.
    ClosedU(s: SurfaceOfRevolution): Boolean
        => (s.Angles.End.Turns - s.Angles.Start.Turns).Abs >= 1.0;
    ClosedV(s: SurfaceOfRevolution): Boolean => false;

    // The profile translated along Direction by V * Distance.
    Eval(s: ExtrudedSurface, uv: UvCoordinate): Point3D
    {
        var p = s.Profile.Eval(uv.U);
        var d = s.Direction.Vector;
        var k = s.Distance * uv.V;
        return (p.X + d.X * k, p.Y + d.Y * k, p.Z + d.Z * k);
    }
    // The profile's own closure is a property of the supplied curve, not of the
    // extrusion, and Curve3D does not report it; the extrusion direction is open.
    ClosedU(s: ExtrudedSurface): Boolean => false;
    ClosedV(s: ExtrudedSurface): Boolean => false;

    // The straight ruling between the two curves at equal parameter.
    Eval(s: RuledSurface, uv: UvCoordinate): Point3D
        => s.Start.Eval(uv.U).Lerp(s.End.Eval(uv.U), uv.V);
    ClosedU(s: RuledSurface): Boolean => false;
    ClosedV(s: RuledSurface): Boolean => false;

    // TODO(content): Eval needs per-section polyline sampling and cross-section
    // interpolation. Closure across sections IS declared by the type.
    ClosedU(s: LoftedSurface): Boolean => false;
    ClosedV(s: LoftedSurface): Boolean => s.Closed;

    // TODO(content): Eval needs the path's rotation-minimizing frame.
    ClosedU(s: SweptSurface): Boolean => false;
    ClosedV(s: SweptSurface): Boolean => false;

    // TODO(content): Eval needs the path's rotation-minimizing frame. The
    // circular cross-section always seams shut in U.
    ClosedU(s: TubeSurface): Boolean => true;
    ClosedV(s: TubeSurface): Boolean => false;

    // TODO(content): Eval needs the base surface's normal, which ParametricSurface
    // does not expose (only DifferentiableSurface does). Closure is inherited from
    // the base: offsetting along the normal preserves seams.
    ClosedU(s: OffsetSurface): Boolean => s.Base.ClosedU;
    ClosedV(s: OffsetSurface): Boolean => s.Base.ClosedV;

    //==
    // Topological surfaces

    // One lap of the centerline circle in U, across the strip in V. The strip's
    // half-width direction rotates by HalfTwistCount half-turns over the lap, so
    // an odd count returns the strip to its start flipped: the one-sided surface.
    Eval(s: MobiusStrip, uv: UvCoordinate): Point3D
    {
        var lap = uv.U.Turns;
        var twist = (uv.U * s.HalfTwistCount.ToNumber * 0.5).Turns;
        var w = (uv.V - 0.5) * s.Width;
        var ring = s.Radius + w * twist.Cos;
        return s.Frame.PointInFrame(Point3D(ring * lap.Cos, ring * lap.Sin, w * twist.Sin));
    }
    // The lap closes in U (flipped when HalfTwistCount is odd); the strip has two
    // free boundary edges in V.
    ClosedU(s: MobiusStrip): Boolean => true;
    ClosedV(s: MobiusStrip): Boolean => false;
}
