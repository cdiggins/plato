//==
// # NumericStructures — derived functions for numeric structure concepts
//
// Bodies for the concepts declared in `06-quantities.plato` (Quantity),
// `08-vectors.plato` (Vector), `09-matrices.plato` (MatrixLike), and
// `11-points.plato` (Coordinate). Every function's first parameter is
// concept-typed, so each helper becomes available on every implementing type.
// Pure expressions only; all values are immutable, so nothing mutates in place.
// See `../README.md` for naming and unit conventions.
//
// This library builds on `01-core-algebra.library.plato` (CoreAlgebra): the
// generic Orderable helpers (Lesser, Greater, Clamp, Between), the Interpolatable
// helpers (MidPoint, LerpClamped), Additive.Double, Scalable.Half, and the
// Real helpers (Abs, Sign) already cover the inherited surface, so this file only
// adds what is specific to these four concepts.

library NumericStructures
{
    //==
    // # Quantity
    //
    // A one-dimensional measured amount (Value, Comparable, Hashable, Additive,
    // Scalable, Interpolatable) with an Amount projected to a raw Number.
    // Ordering (Lesser/Greater/Clamp/Between), MidPoint, LerpClamped, Double and
    // Half all come from CoreAlgebra via the inherited concepts; only the
    // Amount-based sign/zero predicates and the same-type absolute value are
    // added here. Quantity is deliberately not Arithmetic (multiplying two
    // quantities yields a different type), so no product helper is offered.

    // True when the underlying amount is exactly zero. (Quantity is not Numerical,
    // so CoreAlgebra's IsZero does not apply.)
    IsZero(self: Quantity): Boolean
        => self.Amount == 0.0;

    // True when the underlying amount is strictly greater than zero.
    IsPositive(self: Quantity): Boolean
        => self.Amount > 0.0;

    // True when the underlying amount is strictly less than zero.
    IsNegative(self: Quantity): Boolean
        => self.Amount < 0.0;

    // The sign of the quantity: 1 when positive, -1 when negative, 0 when zero.
    Sign(self: Quantity): Integer
        => self.Amount.Sign;

    // The absolute value: the quantity with a non-negative amount.
    Abs(self: Quantity): Quantity
        => self.IsNegative ? self.Negative : self;

    // The magnitude of the gap between two quantities; always non-negative.
    AbsoluteDifference(a: Quantity, b: Quantity): Quantity
        => (a - b).Abs;

    //==
    // # Vector
    //
    // Fixed-arity numeric vectors (Numerical, Arithmetic, Indexable<Number>,
    // Normed, Lattice, Hashable) with a Dot product. Magnitude and
    // MagnitudeSquared come from Normed; Min/Max are the component-wise lattice
    // operations. MidPoint and LerpClamped come from CoreAlgebra (Interpolatable).
    // Vector is Lattice but not Clampable, so the box clamps below stay here.
    //
    // The former concept-gap is closed: Vector now declares FromComponents and
    // Broadcast alongside the inherited At/Count, so the component surface is
    // read-and-construct. Everything below the "component-wise lifting" banner —
    // the map/zip/fold combinators, the reductions (SumComponents, MinComponent,
    // AvgComponent), the arithmetic and lattice bodies, the NumericalLimits
    // elements, and the per-component lifts of the Number intrinsics — is derived
    // once here and applies to every implementing type.

    // The unit vector in the same direction. Precondition: non-zero magnitude.
    Normalize(self: Vector): Vector
        => self / self.Magnitude;

    // The straight-line distance between the tips of two vectors.
    Distance(a: Vector, b: Vector): Number
        => (a - b).Magnitude;

    // The squared distance between two vectors; avoids the square root when only
    // relative distances are compared.
    DistanceSquared(a: Vector, b: Vector): Number
        => (a - b).MagnitudeSquared;

    // True when b lies within the given radius of a (inclusive). Compares squared
    // distances, so no square root is taken.
    WithinDistance(a: Vector, b: Vector, radius: Number): Boolean
        => a.DistanceSquared(b) <= radius * radius;

    // The signed length of self projected onto onto. Precondition: onto is non-zero.
    ScalarProjection(self: Vector, onto: Vector): Number
        => self.Dot(onto) / onto.Magnitude;

    // The component of self parallel to onto. Precondition: onto is non-zero.
    ProjectOnto(self: Vector, onto: Vector): Vector
        => onto * (self.Dot(onto) / onto.Dot(onto));

    // The component of self perpendicular to onto. Precondition: onto is non-zero.
    RejectFrom(self: Vector, onto: Vector): Vector
        => self - self.ProjectOnto(onto);

    // Reflects self across the plane whose normal is given. Precondition: normal
    // is a unit vector.
    Reflect(self: Vector, normal: Vector): Vector
        => self - normal * (2.0 * self.Dot(normal));

    // The cosine of the angle between a and b: Dot divided by the product of
    // magnitudes. Preconditions: a and b are non-zero.
    CosineSimilarity(a: Vector, b: Vector): Number
        => a.Dot(b) / (a.Magnitude * b.Magnitude);

    // The unsigned angle between a and b, in [0, Pi]. The cosine similarity is
    // clamped to [-1, 1] before Acos so floating-point drift cannot produce a NaN.
    // Preconditions: a and b are non-zero.
    AngleBetween(a: Vector, b: Vector): Angle
        => a.CosineSimilarity(b).Clamp(-1.0, 1.0).Acos;

    // A vector in the same direction as self but with the given length.
    // Precondition: self is non-zero.
    ScaledToLength(self: Vector, length: Number): Vector
        => self.Normalize * length;

    // Restricts each component of self to the box spanned by lo and hi, using the
    // component-wise lattice operations. Precondition: lo <= hi component-wise.
    Clamp(self: Vector, lo: Vector, hi: Vector): Vector
        => self.Max(lo).Min(hi);

    // Restricts each component of self to [0, 1] using the vector's own Zero and
    // One elements (the component-wise analogue of CoreAlgebra's Saturate).
    Saturate(self: Vector): Vector
        => self.Max(self.Zero).Min(self.One);

    //==
    // # Vector — component-wise lifting
    //
    // Vector declares FromComponents and Broadcast and inherits Count/At from
    // Indexable<Number>, so a vector can be both read as and rebuilt from an
    // Array<Number>. That closes the loop: the Array intrinsics (Map, Zip,
    // Reduce, All, Any) lift straight onto vectors, and every derived body below
    // is written once instead of once per concrete type. Successor to v1's
    // IArrayLike<T> combinators, without the extra taxonomy.
    //
    // As elsewhere in these libraries, the helpers return the bare concept type
    // Vector rather than the concrete implementing type.

    // The components of self as an Array<Number>, in index order.
    ComponentArray(self: Vector): Array<Number>
        => self.Count.Range.Map(i => self.At(i));

    // A vector of the same type with f applied to each component.
    MapComponents(self: Vector, f: Function1<Number, Number>): Vector
        => self.FromComponents(self.ComponentArray.Map(f));

    // A vector whose i-th component is f applied to the i-th components of a and
    // b. Precondition: a and b have the same arity.
    ZipComponents(a: Vector, b: Vector, f: Function2<Number, Number, Number>): Vector
        => a.FromComponents(a.ComponentArray.Zip(b.ComponentArray, f));

    // The three-way component-wise zip. Precondition: equal arities.
    ZipComponents(a: Vector, b: Vector, c: Vector, f: Function3<Number, Number, Number, Number>): Vector
        => a.FromComponents(a.ComponentArray.Zip(b.ComponentArray, c.ComponentArray, f));

    // Folds the components left to right, starting from initial.
    ReduceComponents(self: Vector, initial: Number, f: Function2<Number, Number, Number>): Number
        => self.ComponentArray.Reduce(initial, f);

    // True when every component satisfies the predicate.
    AllComponents(self: Vector, predicate: Function1<Number, Boolean>): Boolean
        => self.ComponentArray.All(predicate);

    // True when at least one component satisfies the predicate.
    AnyComponent(self: Vector, predicate: Function1<Number, Boolean>): Boolean
        => self.ComponentArray.Any(predicate);

    // True when the paired components of a and b all satisfy the predicate.
    AllZipComponents(a: Vector, b: Vector, f: Function2<Number, Number, Boolean>): Boolean
        => a.ComponentArray.Zip(b.ComponentArray, f).All(x => x);

    // True when the tripled components of a, b and c all satisfy the predicate.
    AllZipComponents(a: Vector, b: Vector, c: Vector, f: Function3<Number, Number, Number, Boolean>): Boolean
        => a.ComponentArray.Zip(b.ComponentArray, c.ComponentArray, f).All(x => x);

    // True when at least one paired component of a and b satisfies the predicate.
    AnyZipComponents(a: Vector, b: Vector, f: Function2<Number, Number, Boolean>): Boolean
        => a.ComponentArray.Zip(b.ComponentArray, f).Any(x => x);

    // True when at least one tripled component of a, b and c satisfies the predicate.
    AnyZipComponents(a: Vector, b: Vector, c: Vector, f: Function3<Number, Number, Number, Boolean>): Boolean
        => a.ComponentArray.Zip(b.ComponentArray, c.ComponentArray, f).Any(x => x);

    //==
    // # Vector — component reductions

    // The sum of all components.
    SumComponents(self: Vector): Number
        => self.ReduceComponents(0.0, (acc, x) => acc + x);

    // The sum of the squares of all components; the squared Euclidean norm.
    SumSqrComponents(self: Vector): Number
        => self.ReduceComponents(0.0, (acc, x) => acc + x * x);

    // The smallest component. Precondition: the vector has at least one component.
    MinComponent(self: Vector): Number
        => self.ReduceComponents(self.At(0), (acc, x) => acc.Min(x));

    // The largest component. Precondition: the vector has at least one component.
    MaxComponent(self: Vector): Number
        => self.ReduceComponents(self.At(0), (acc, x) => acc.Max(x));

    // The arithmetic mean of the components. Precondition: non-empty.
    AvgComponent(self: Vector): Number
        => self.SumComponents / self.Count.ToNumber;

    // The Euclidean length (the Normed member, derived from the components).
    Magnitude(self: Vector): Number
        => self.MagnitudeSquared.Sqrt;

    // The squared Euclidean length; avoids the square root.
    MagnitudeSquared(self: Vector): Number
        => self.SumSqrComponents;

    // The dot product: the sum of the products of corresponding components.
    // Precondition: a and b have the same arity.
    Dot(a: Vector, b: Vector): Number
        => a.ZipComponents(b, (x, y) => x * y).SumComponents;

    //==
    // # Vector — distinguished elements
    //
    // The NumericalLimits surface follows from Broadcast alone: each element is
    // the corresponding Number constant in every component.

    // The vector with every component zero (the additive identity).
    Zero(self: Vector): Vector
        => self.Broadcast(0.0);

    // The vector with every component one.
    One(self: Vector): Vector
        => self.Broadcast(1.0);

    // The vector with every component at the smallest representable Number.
    MinValue(self: Vector): Vector
        => self.Broadcast(Number.MinValue);

    // The vector with every component at the largest representable Number.
    MaxValue(self: Vector): Vector
        => self.Broadcast(Number.MaxValue);

    //==
    // # Vector — component-wise algebra
    //
    // The Additive / Arithmetic / Scalable / Lattice / Interpolatable surface,
    // all component-wise. Concrete types whose backend has a native vector
    // instruction (Number2/3/4/8 in `intrinsics.plato`) override these.

    // Component-wise sum.
    Add(a: Vector, b: Vector): Vector
        => a.ZipComponents(b, (x, y) => x + y);

    // Component-wise difference.
    Subtract(a: Vector, b: Vector): Vector
        => a.ZipComponents(b, (x, y) => x - y);

    // Component-wise (Hadamard) product.
    Multiply(a: Vector, b: Vector): Vector
        => a.ZipComponents(b, (x, y) => x * y);

    // Component-wise quotient. Precondition: no component of b is zero.
    Divide(a: Vector, b: Vector): Vector
        => a.ZipComponents(b, (x, y) => x / y);

    // Component-wise remainder. Precondition: no component of b is zero.
    Modulo(a: Vector, b: Vector): Vector
        => a.ZipComponents(b, (x, y) => x % y);

    // The vector with every component negated.
    Negative(self: Vector): Vector
        => self.MapComponents(x => x.Negative);

    // Every component scaled by a unitless scalar.
    Multiply(self: Vector, scalar: Number): Vector
        => self.MapComponents(x => x * scalar);

    // Every component divided by a unitless scalar. Precondition: scalar is non-zero.
    Divide(self: Vector, scalar: Number): Vector
        => self.MapComponents(x => x / scalar);

    // Every component reduced modulo a unitless scalar. Precondition: non-zero.
    Modulo(self: Vector, scalar: Number): Vector
        => self.MapComponents(x => x % scalar);

    // The component-wise minimum (the Lattice meet).
    Min(a: Vector, b: Vector): Vector
        => a.ZipComponents(b, (x, y) => x.Min(y));

    // The component-wise maximum (the Lattice join).
    Max(a: Vector, b: Vector): Vector
        => a.ZipComponents(b, (x, y) => x.Max(y));

    // Component-wise linear interpolation; t is unclamped.
    Lerp(a: Vector, b: Vector, t: Number): Vector
        => a.ZipComponents(b, (x, y) => x + (y - x) * t);

    //==
    // # Vector — lifted Number functions
    //
    // Each of these is the corresponding function from `intrinsics.plato` or
    // `core-algebra.library.plato` applied to every component. v1 wrote this list
    // once per vector type; here it is written once, full stop.

    // Component-wise absolute value.
    Abs(self: Vector): Vector
        => self.MapComponents(x => x.Abs);

    // Component-wise floor (largest whole value at or below each component).
    Floor(self: Vector): Vector
        => self.MapComponents(x => x.Floor);

    // Component-wise ceiling (smallest whole value at or above each component).
    Ceiling(self: Vector): Vector
        => self.MapComponents(x => x.Ceiling);

    // Component-wise truncation toward zero.
    Truncate(self: Vector): Vector
        => self.MapComponents(x => x.Truncate);

    // Component-wise square root. Precondition: no component is negative.
    Sqrt(self: Vector): Vector
        => self.MapComponents(x => x.Sqrt);

    // Component-wise cube root.
    Cbrt(self: Vector): Vector
        => self.MapComponents(x => x.Cbrt);

    // Component-wise exponential (e raised to each component).
    Exp(self: Vector): Vector
        => self.MapComponents(x => x.Exp);

    // Component-wise natural logarithm. Precondition: every component is positive.
    NaturalLog(self: Vector): Vector
        => self.MapComponents(x => x.NaturalLog);

    // Component-wise base-2 logarithm. Precondition: every component is positive.
    Log2(self: Vector): Vector
        => self.MapComponents(x => x.Log2);

    // Component-wise base-10 logarithm. Precondition: every component is positive.
    Log10(self: Vector): Vector
        => self.MapComponents(x => x.Log10);

    // Component-wise reciprocal. Precondition: no component is zero.
    Reciprocal(self: Vector): Vector
        => self.MapComponents(x => x.Reciprocal);

    // Each component raised to the corresponding component of power.
    Pow(self: Vector, power: Vector): Vector
        => self.ZipComponents(power, (x, y) => x.Pow(y));

    // Each component raised to the same scalar power.
    Pow(self: Vector, power: Number): Vector
        => self.MapComponents(x => x.Pow(power));

    // Each component given the sign of the corresponding component of sign.
    CopySign(self: Vector, sign: Vector): Vector
        => self.ZipComponents(sign, (x, y) => x.CopySign(y));

    // Component-wise fused multiply-add: self * y + z with a single rounding.
    FusedMultiplyAdd(self: Vector, y: Vector, z: Vector): Vector
        => self.ZipComponents(y, z, (a, b, c) => a.FusedMultiplyAdd(b, c));

    // Restricts every component to the scalar range [lo, hi]. Precondition: lo <= hi.
    Clamp(self: Vector, lo: Number, hi: Number): Vector
        => self.MapComponents(x => x.Clamp(lo, hi));

    // Component-wise fractional part: each component minus its floor, in [0, 1).
    FractionalPart(self: Vector): Vector
        => self.MapComponents(x => x.FractionalPart);

    // The component-wise complement within the unit interval: one minus each component.
    OneMinus(self: Vector): Vector
        => self.MapComponents(x => x.OneMinus);

    // Each component rounded to the nearest whole value, halves rounding up.
    RoundedToNearest(self: Vector): Vector
        => self.MapComponents(x => x.RoundedToNearest);

    // True when every pair of corresponding components differs by no more than
    // the given (non-negative) tolerance.
    AlmostEqual(a: Vector, b: Vector, tolerance: Number): Boolean
        => a.AllZipComponents(b, (x, y) => x.AlmostEqual(y, tolerance));

    // True when every component is within the given tolerance of zero.
    AlmostZero(self: Vector, tolerance: Number): Boolean
        => self.AllComponents(x => x.AlmostZero(tolerance));

    // True when every component lies in the inclusive box [lower, upper].
    Between(self: Vector, lower: Vector, upper: Vector): Boolean
        => self.AllZipComponents(lower, upper, (x, a, b) => x.Between(a, b));

    // True when every component is finite (no infinity, no NaN).
    IsFinite(self: Vector): Boolean
        => self.AllComponents(x => x.IsFinite);

    // True when at least one component is NaN.
    HasNaN(self: Vector): Boolean
        => self.AnyComponent(x => x.IsNaN);

    //==
    // # Vector construction, per concrete type
    //
    // FromComponents and Broadcast are the only primitives the generic bodies
    // above need; each implementing type supplies them once here through its
    // synthesized constructor. Everything else in this section is derived.

    // The 2-tuple built from the first two entries of xs.
    FromComponents(_: Number2, xs: Array<Number>): Number2
        => Number2(xs.At(0), xs.At(1));

    // The 2-tuple with both components set to x.
    Broadcast(_: Number2, x: Number): Number2
        => Number2(x, x);

    // The 3-tuple built from the first three entries of xs.
    FromComponents(_: Number3, xs: Array<Number>): Number3
        => Number3(xs.At(0), xs.At(1), xs.At(2));

    // The 3-tuple with every component set to x.
    Broadcast(_: Number3, x: Number): Number3
        => Number3(x, x, x);

    // The 4-tuple built from the first four entries of xs.
    FromComponents(_: Number4, xs: Array<Number>): Number4
        => Number4(xs.At(0), xs.At(1), xs.At(2), xs.At(3));

    // The 4-tuple with every component set to x.
    Broadcast(_: Number4, x: Number): Number4
        => Number4(x, x, x, x);

    // The 8-lane tuple built from the first eight entries of xs.
    FromComponents(_: Number8, xs: Array<Number>): Number8
        => Number8(xs.At(0), xs.At(1), xs.At(2), xs.At(3),
                   xs.At(4), xs.At(5), xs.At(6), xs.At(7));

    // The 8-lane tuple with every lane set to x.
    Broadcast(_: Number8, x: Number): Number8
        => Number8(x, x, x, x, x, x, x, x);

    // The 2D displacement built from the first two entries of xs.
    FromComponents(_: Vector2D, xs: Array<Number>): Vector2D
        => Vector2D(xs.At(0), xs.At(1));

    // The 2D displacement with both components set to x.
    Broadcast(_: Vector2D, x: Number): Vector2D
        => Vector2D(x, x);

    // The 3D displacement built from the first three entries of xs.
    FromComponents(_: Vector3D, xs: Array<Number>): Vector3D
        => Vector3D(xs.At(0), xs.At(1), xs.At(2));

    // The 3D displacement with every component set to x.
    Broadcast(_: Vector3D, x: Number): Vector3D
        => Vector3D(x, x, x);

    // The N-dimensional vector holding exactly the given components; the arity
    // is the length of xs.
    FromComponents(_: VectorN, xs: Array<Number>): VectorN
        => VectorN(xs);

    // The N-dimensional vector of the same arity as self with every component
    // set to x.
    Broadcast(self: VectorN, x: Number): VectorN
        => VectorN(self.Components.Count.Repeat(x));

    //==
    // # MatrixLike
    //
    // Dense numeric matrices (Value, Additive, Scalable) with RowCount,
    // ColumnCount, and ElementAt(row, column). Double and Half come from
    // CoreAlgebra (Additive / Scalable). The base concept has no multiplication,
    // transpose, or row/column extraction, so only shape queries, element access,
    // and the shape-preserving interpolation conveniences are derivable here.
    //
    // TODO(concept-gap): Trace, Transpose, and FrobeniusNorm remain blocked on the
    // MatrixLike surface, not on arithmetic: Trace needs a fold over the diagonal,
    // Transpose needs matrix construction, and FrobeniusNorm needs an element fold
    // (the square root itself is now available via Number.Sqrt). MatrixLike exposes
    // only ElementAt with no iteration or construction primitive, so none are derivable.

    // True when the matrix has equal row and column counts.
    IsSquare(self: MatrixLike): Boolean
        => self.RowCount == self.ColumnCount;

    // The total number of elements (rows times columns).
    ElementCount(self: MatrixLike): Integer
        => self.RowCount * self.ColumnCount;

    // True when the matrix has no elements (no rows or no columns).
    IsEmpty(self: MatrixLike): Boolean
        => self.RowCount == 0 || self.ColumnCount == 0;

    // True when the matrix is a single row.
    IsRowVector(self: MatrixLike): Boolean
        => self.RowCount == 1;

    // True when the matrix is a single column.
    IsColumnVector(self: MatrixLike): Boolean
        => self.ColumnCount == 1;

    // True when two matrices have the same row and column counts.
    SameShape(a: MatrixLike, b: MatrixLike): Boolean
        => a.RowCount == b.RowCount && a.ColumnCount == b.ColumnCount;

    // The element on the main diagonal at position i (i.e. element (i, i)).
    // Precondition: i is a valid row and column index.
    DiagonalElement(self: MatrixLike, i: Integer): Number
        => self.ElementAt(i, i);

    // Linear interpolation of two matrices, derived from Additive and Scalable.
    // t is unclamped: 0 yields a, 1 yields b. Precondition: a and b share a shape.
    Lerp(a: MatrixLike, b: MatrixLike, t: Number): MatrixLike
        => a + (b - a) * t;

    // The element-wise average of two matrices. Precondition: a and b share a shape.
    Average(a: MatrixLike, b: MatrixLike): MatrixLike
        => (a + b) / 2.0;

    //==
    // # Coordinate
    //
    // A position in some space (Value, Equatable, Interpolatable). Coordinate is a
    // marker concept whose only operation is Lerp, and CoreAlgebra already ships
    // MidPoint and LerpClamped on Interpolatable — which Coordinate inherits — so
    // every interpolation convenience it can support already exists upstream and
    // no Coordinate-specific body is added here.
    //
    // TODO(cross-package): CoreAlgebra (P1) should adopt a smoothstep easing on
    // Interpolatable, e.g.
    //   SmoothLerp(a: Interpolatable, b: Interpolatable, t: Number): Interpolatable
    //       => a.Lerp(b, t * t * (3.0 - 2.0 * t));
    // It uses only Lerp, so it belongs beside MidPoint/LerpClamped rather than
    // being duplicated per concept here (was previously on Vector and Coordinate).
    // TODO(concept-gap): Coordinate does not inherit MetricSpace or Difference, so
    // a generic Distance or Between-two-points delta cannot be defined at the
    // concept level; those live on the concrete point types via Difference<TDelta>.
}
