//==
// # NumericStructuresCoordinate — derived functions for point-like types
//
// The per-concrete-type Euclidean distances that stand in for a generic metric
// on the Coordinate concept (`points.concepts.plato`), plus the barycentric
// evaluation and normalization test for `points-parametric.plato`.

library NumericStructuresCoordinate
{
    //==
    // # Coordinate
    //
    // A position in some space (Value, Equatable, Interpolatable). Coordinate is a
    // marker concept whose only operation is Lerp, and CoreAlgebra already ships
    // MidPoint, LerpClamped and SmoothLerp on Interpolatable — which Coordinate
    // inherits — so every interpolation convenience it can support already exists
    // upstream (SmoothLerp landed at algebra-operations.library.plato) and no
    // Coordinate-specific body is added here.
    //
    // TODO(concept-gap): a generic Distance over Coordinate is out of reach, and
    // NOT via a cheap concept extension. All five implementors (Point2D, Point3D,
    // PointN in points.plato; UvCoordinate, UvwCoordinate in
    // points-parametric.plato) implement OriginBased<TDelta> (hence
    // Difference<TDelta>) — but each with a DIFFERENT delta type (Vector2D /
    // Vector3D / VectorN). So Coordinate cannot inherit Difference<TDelta>
    // without gaining a type parameter, which would cascade to
    // every bare `Coordinate` mention tree-wide (a generic-arity change, not merely
    // an added obligation). MetricSpace is likewise not inherited, and adding it
    // would impose a concrete Distance obligation on all five types. Both are too
    // invasive to justify here; the distance stays on the concrete point types.
    //
    // The Between-two-points delta is no longer part of this gap: plato-306 made
    // it derivable for every implementor at once. Distance is not, because it
    // additionally needs TDelta: Normed, and Difference cannot bind that —
    // Instant's delta is a Duration, which is not Normed. A library function
    // cannot add the bound either (no `where` on library functions), so the six
    // Distance / DistanceSquared bodies below stay concrete.
    //
    // So the Euclidean distance is provided per concrete point type below, each as
    // `Between(a, b).Magnitude` over that type's own Difference delta. This is the
    // sanctioned resolution of the "points lack MetricSpace" lessons (items 257,
    // 295): concrete functions rather than a concept obligation that would force a
    // generic-arity change on Coordinate. DistanceSquared mirrors Distance without
    // the square root, for radius and nearest-neighbour comparisons.

    // The Euclidean distance between two 2D positions.
    Distance(a: Point2D, b: Point2D): Number
        => a.Between(b).Magnitude;

    // The squared Euclidean distance between two 2D positions; avoids the square root.
    DistanceSquared(a: Point2D, b: Point2D): Number
        => a.Between(b).MagnitudeSquared;

    // The Euclidean distance between two 3D positions.
    Distance(a: Point3D, b: Point3D): Number
        => a.Between(b).Magnitude;

    // The squared Euclidean distance between two 3D positions; avoids the square root.
    DistanceSquared(a: Point3D, b: Point3D): Number
        => a.Between(b).MagnitudeSquared;

    // The Euclidean distance between two N-dimensional positions.
    // Precondition: a and b have the same arity.
    Distance(a: PointN, b: PointN): Number
        => a.Between(b).Magnitude;

    // The squared Euclidean distance between two N-dimensional positions.
    // Precondition: a and b have the same arity.
    DistanceSquared(a: PointN, b: PointN): Number
        => a.Between(b).MagnitudeSquared;

    //==
    // # UvCoordinate / UvwCoordinate — the OriginBased conversions
    //
    // Two lines each, and the whole affine surface (Add, Between, Subtract in
    // both spellings, Lerp, Origin) follows from them via
    // algebra-metric.library.plato. Before plato-306 these two types declared
    // `implements Difference<...>` and supplied no bodies at all, so every one of
    // those members was a throwing stub.
    //
    // The origin is the parameter-space origin: (0, 0) is the UV origin defined
    // in CONVENTIONS.md (top-left, U right, V down), not a world-space point.

    // The parameter's displacement from the UV origin.
    Offset(uv: UvCoordinate): Vector2D
        => (uv.U, uv.V);

    // The parameter at the given displacement from the UV origin.
    FromOffset(_: UvCoordinate, v: Vector2D): UvCoordinate
        => (v.X, v.Y);

    // The parameter's displacement from the UVW origin.
    Offset(uvw: UvwCoordinate): Vector3D
        => (uvw.U, uvw.V, uvw.W);

    // The parameter at the given displacement from the UVW origin.
    FromOffset(_: UvwCoordinate, v: Vector3D): UvwCoordinate
        => (v.X, v.Y, v.Z);

    //==
    // # BarycentricCoordinate (barycentric / affine-combination lessons)
    //
    // Vertex binding U -> A, V -> B, W -> C (points.plato). Evaluate takes the
    // three triangle vertices explicitly, so it lives in points territory rather
    // than needing a Triangle type. Computed as A + V*(B - A) + W*(C - A), which
    // equals U*A + V*B + W*C when U + V + W = 1 and stays well-defined regardless.

    // The point at these weights on the triangle (a, b, c): the affine combination
    // U*a + V*b + W*c on the support plane. Vertex binding U->a, V->b, W->c.
    Evaluate(self: BarycentricCoordinate, a: Point2D, b: Point2D, c: Point2D): Point2D
        => a + a.Between(b) * self.V + a.Between(c) * self.W;

    // The point at these weights on the triangle (a, b, c): the affine combination
    // U*a + V*b + W*c on the support plane. Vertex binding U->a, V->b, W->c.
    Evaluate(self: BarycentricCoordinate, a: Point3D, b: Point3D, c: Point3D): Point3D
        => a + a.Between(b) * self.V + a.Between(c) * self.W;

    // True when the weights sum to one within tolerance (a valid affine
    // combination identifying a point on the triangle's support plane). Does not
    // test the convexity condition U, V, W >= 0 (see the type doc comment).
    IsNormalized(self: BarycentricCoordinate, tolerance: Number): Boolean
        => (self.U + self.V + self.W).AlmostEqual(1.0, tolerance);
}
