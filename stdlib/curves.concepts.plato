//==
// # Curve concepts
//
// Continuous curves as pure functions: a curve maps one parameter to a position
// (the Procedural concept from `functional.concepts.plato`). Unless a type
// documents otherwise, the canonical parameter domain of a curve is the unit
// interval [0,1], and closed curves satisfy Eval(0) = Eval(1). The optional
// capabilities a curve may add on top — derivatives, moving frames, polar form,
// periodicity, arc-length measurement — are declared in
// `curves-capabilities.concepts.plato`. See https://en.wikipedia.org/wiki/Curve.

//==
// # Curves

// A continuous map from one real parameter to a value of TRange: the generic
// root of every curve. Dimension-agnostic curve helpers constrain on this, so
// an Eval-only derivation is written once instead of once per embedding
// (see `Sample` in curves-sampling.library.plato). Mirrors the
// `Field<TDomain, TValue>` root of `fields.concepts.plato`.
concept Curve<TRange>
    inherits Procedural<Number, TRange>
{ }

// A real-valued function of one real parameter, viewed as a curve: profiles,
// envelopes, cross-section laws, and interpolated channels.
concept Curve1D
    inherits Curve<Number>
{ }

// A continuous map from a parameter to a position in the plane
// (https://en.wikipedia.org/wiki/Parametric_equation).
concept Curve2D
    inherits Geometry2D, Curve<Point2D>
{ }

// A continuous map from a parameter to a position in space
// (https://en.wikipedia.org/wiki/Differential_geometry_of_curves).
concept Curve3D
    inherits Geometry3D, Curve<Point3D>
{ }

// A 2D curve that returns to its start: Eval(0) = Eval(1) with continuous closure.
// Marker concept; closure is a structural guarantee of the implementing type.
concept ClosedCurve2D
    inherits Curve2D
{ }

// A 3D curve that returns to its start: Eval(0) = Eval(1) with continuous closure.
concept ClosedCurve3D
    inherits Curve3D
{ }

//==
// # Angular curves

// A plane curve whose natural parameter is an angle: its defining equation
// sweeps a bearing about a center or pole (circles, ellipses, roulettes,
// figure curves). Implementors supply the angular evaluation; the bridge in
// `AngularCurves` below derives the canonical evaluation, mapping t in [0,1]
// to one full turn.
concept AngularCurve2D
    inherits Curve2D
{
    Eval(x: Self, angle: Angle): Point2D;
}

// A space curve whose natural parameter is an angle: helices, torus knots,
// and the other named space curves that wind about an axis. Implementors
// supply the angular evaluation; the bridge in `AngularCurves` below derives
// the canonical evaluation, mapping t in [0,1] to one full turn.
concept AngularCurve3D
    inherits Curve3D
{
    Eval(x: Self, angle: Angle): Point3D;
}

// The angular bridges: the canonical-parameter evaluation of an angular curve
// is derivable once for every implementor, so each angular curve costs only
// its Eval(Angle). Curves whose sweep is not a single full turn override
// Eval(Number) directly, exactly as the `Angles`-carrying spirals do over the
// generic polar mapping in `curves-2d-polar.library.plato`.
library AngularCurves
{
    // The position at the canonical parameter t: the angular evaluation taken
    // at t full turns.
    Eval(curve: AngularCurve2D, t: Number): Point2D
        => curve.Eval(t.Turns);

    // The position at the canonical parameter t: the angular evaluation taken
    // at t full turns.
    Eval(curve: AngularCurve3D, t: Number): Point3D
        => curve.Eval(t.Turns);
}
