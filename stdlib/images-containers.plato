//==
// # Image containers
//
// Images that hold something other than one plain 2D pixel grid: compressed
// file payloads, mip pyramids, tile grids, frame sequences, regions of
// interest, voxel volumes, and cubemap face sets. The single-grid pixel types
// they are built from live in `images.plato`.

//==
// ## Encoded, tiled, and multi-resolution images

// A compressed image file format; Hdr is Radiance HDR.
// (https://en.wikipedia.org/wiki/Image_file_format)
type ImageCodec
    = Png | Jpeg | WebP | Gif | Bmp | Tga | Tiff | Exr | Hdr | Ktx2 | Dds | Avif | Heic;

// An image in compressed (file) form: an opaque byte payload plus the codec
// that produced it. Each element of Bytes is one octet in [0, 255].
type EncodedImage
    implements Value
{
    Codec: ImageCodec;
    Bytes: Array<Integer>;
}

// A full mipmap pyramid. Levels[0] is the base image; each subsequent level
// halves both dimensions (rounding down, minimum 1) until 1x1.
// (https://en.wikipedia.org/wiki/Mipmap)
type MipChain
    implements Value
{
    Levels: Array<FloatImage>;
}

// A large image split into a row-major grid of tiles for streaming and
// caching. Interior tiles are exactly TileSize; right/bottom edge tiles may
// be smaller.
type TiledImage
    implements Value
{
    Size: IntegerSize2D;
    TileSize: IntegerSize2D;
    Tiles: Array<FloatImage>;
}

// A frame-sequence image (animated GIF/WebP style). FrameDurations pairs
// one-to-one with Frames; LoopCount is the replay count, 0 meaning forever.
type AnimatedImage
    implements Value
{
    Frames: Array<Bitmap>;
    FrameDurations: Array<Duration>;
    LoopCount: Integer;
}

// A rectangular region of interest within an image, in pixel coordinates.
// Contains Min, excludes Max (half-open, like IntegerBounds2D).
// (https://en.wikipedia.org/wiki/Region_of_interest)
type ImageRegion
    implements Value
{
    Bounds: IntegerBounds2D;
}

//==
// ## Volume and cubemap pixel data

// A dense 3D scalar grid (a voxel image): medical stacks, density fields
// baked to texels, 3D noise caches. Values are layer-major: layer, then row,
// then column; Count equals Width times Height times Depth.
// (https://en.wikipedia.org/wiki/Voxel)
type VolumeImage
    implements Value
{
    Size: IntegerSize3D;
    Values: Array<Number>;
}

// The six square faces of a cubemap as linear-light images, in the order
// +X, -X, +Y, -Y, +Z, -Z. All faces share the same square size.
// (https://en.wikipedia.org/wiki/Cube_mapping)
type CubemapImage
    implements Value
{
    Faces: Array<FloatImage>;
}
