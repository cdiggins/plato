//==
// # Sparse and banded matrices
//
// Matrices whose storage is proportional to their non-zero content rather than
// to their shape: coordinate-list sparse storage and the banded form of a
// matrix whose non-zeros hug the diagonal. The dense counterparts (and the
// MatrixLike concept) live in `matrices.types.plato`; these types deliberately
// do not claim MatrixLike, because element access is a search rather than an
// offset.
// Convention: see CONVENTIONS.md - Matrices (row-vector multiplication,
// v' = v M); rows and columns here mean the same thing they do there.

// One stored element of a sparse matrix: its zero-based position and value.
// Entries are unordered and a position may repeat; the value at a position is
// the sum of the entries that name it, which is what makes concatenation a
// correct sum.
// (https://en.wikipedia.org/wiki/Sparse_matrix#Coordinate_list_(COO))
type SparseMatrixEntry
    implements Value
{
    Row: Integer;
    Column: Integer;
    Value: Number;
}

// A matrix stored as its non-zero entries only (coordinate-list form). Any
// position absent from Entries is zero. Storage is proportional to the entry
// count, so this is the representation for the large, mostly-empty systems
// that arise in finite-element and graph problems.
// (https://en.wikipedia.org/wiki/Sparse_matrix)
type SparseMatrix
    implements Value
{
    NumRows: Integer;
    NumColumns: Integer;
    Entries: Array<SparseMatrixEntry>;
}

// A matrix whose non-zeros lie within a band about the main diagonal:
// element (r, c) may be non-zero only when -LowerBandwidth <= c - r <=
// UpperBandwidth. Values holds the band in row-major order, each row
// contributing LowerBandwidth + UpperBandwidth + 1 slots (positions off the
// matrix are stored and ignored), which is the layout that lets banded solvers
// run in linear time. Both bandwidths are non-negative; zero and zero is a
// diagonal matrix, one and one is tridiagonal.
// (https://en.wikipedia.org/wiki/Band_matrix)
type BandedMatrix
    implements Value
{
    NumRows: Integer;
    NumColumns: Integer;
    LowerBandwidth: Integer;
    UpperBandwidth: Integer;
    Values: Array<Number>;
}
