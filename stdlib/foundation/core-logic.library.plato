//==
// # CoreLogic
//
// Derived functionality for the logic concepts (`core-logic.concepts.plato`):
// the composite truth-functional connectives and their bit-level counterparts
// (https://en.wikipedia.org/wiki/Logical_connective). Shared provenance note:
// `core-comparison.library.plato`.

library CoreLogic
{
    //==
    // Logical

    // Negated conjunction: not (a and b). (https://en.wikipedia.org/wiki/NAND_gate)
    Nand(a: Logical, b: Logical): Logical
        => a.And(b).Not;

    // Negated disjunction: not (a or b). (https://en.wikipedia.org/wiki/NOR_gate)
    Nor(a: Logical, b: Logical): Logical
        => a.Or(b).Not;

    // Material implication: a implies b, i.e. (not a) or b.
    // (https://en.wikipedia.org/wiki/Material_conditional)
    Implies(a: Logical, b: Logical): Logical
        => a.Not.Or(b);

    //==
    // BooleanAlgebra

    // Logical equivalence (XNOR): true when a and b have the same truth value.
    // (https://en.wikipedia.org/wiki/XNOR_gate)
    Equivalent(a: BooleanAlgebra, b: BooleanAlgebra): BooleanAlgebra
        => a.ExclusiveOr(b).Not;

    //==
    // Bitwise

    // Bitwise negated-and of the corresponding bits of a and b.
    BitwiseNand(a: Bitwise, b: Bitwise): Bitwise
        => a.BitwiseAnd(b).BitwiseNot;

    // Bitwise negated-or of the corresponding bits of a and b.
    BitwiseNor(a: Bitwise, b: Bitwise): Bitwise
        => a.BitwiseOr(b).BitwiseNot;
}
