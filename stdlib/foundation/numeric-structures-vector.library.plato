//==
// # NumericStructuresVector — geometric helpers for the Vector concept
//
// The geometry that sits on top of Dot and Magnitude: distances, projection and
// rejection, reflection, angles between vectors, safe normalization, the 3D
// cross-product neighbourhood, the 2D planar perp, and the validated Direction
// factories. The component-wise machinery lives in
// `numeric-structures-components.library.plato` and
// `numeric-structures-algebra.library.plato`.

library NumericStructuresVector
{
    //==
    // # Vector
    //
    // Fixed-arity numeric vectors
    // (https://en.wikipedia.org/wiki/Vector_(mathematics_and_physics); Numerical,
    // Arithmetic, Indexable<Number>, Normed, Lattice, Hashable) with a Dot product
    // (https://en.wikipedia.org/wiki/Dot_product). Magnitude and
    // MagnitudeSquared come from Normed; Min/Max are the component-wise lattice
    // operations. MidPoint and LerpClamped come from CoreAlgebra (Interpolatable).
    // Vector is Lattice but not Clampable, so the box clamps below stay here.
    //
    // The former concept-gap is closed: Vector now declares FromComponents and
    // Broadcast alongside the inherited At/Count, so the component surface is
    // read-and-construct. Everything below the "component-wise lifting" banner —
    // the map/zip/fold combinators, the reductions (SumComponents, MinComponent,
    // AvgComponent), the arithmetic and lattice bodies, the NumericalLimits
    // elements, and the per-component lifts of the Number intrinsics — is derived
    // once here and applies to every implementing type.

    // The unit vector in the same direction. Precondition: non-zero magnitude.
    Normalize(self: Vector): Vector
        => self / self.Magnitude;

    // The straight-line distance between the tips of two vectors.
    Distance(a: Vector, b: Vector): Number
        => (a - b).Magnitude;

    // The squared distance between two vectors; avoids the square root when only
    // relative distances are compared.
    DistanceSquared(a: Vector, b: Vector): Number
        => (a - b).MagnitudeSquared;

    // True when b lies within the given radius of a (inclusive). Compares squared
    // distances, so no square root is taken.
    WithinDistance(a: Vector, b: Vector, radius: Number): Boolean
        => a.DistanceSquared(b) <= radius * radius;

    // The signed length of self projected onto onto. Precondition: onto is non-zero.
    ScalarProjection(self: Vector, onto: Vector): Number
        => self.Dot(onto) / onto.Magnitude;

    // The component of self parallel to onto
    // (https://en.wikipedia.org/wiki/Vector_projection). Precondition: onto is
    // non-zero.
    ProjectOnto(self: Vector, onto: Vector): Vector
        => onto * (self.Dot(onto) / onto.Dot(onto));

    // The component of self perpendicular to onto. Precondition: onto is non-zero.
    RejectFrom(self: Vector, onto: Vector): Vector
        => self - self.ProjectOnto(onto);

    // Reflects self across the plane whose normal is given. Precondition: normal
    // is a unit vector.
    Reflect(self: Vector, normal: Vector): Vector
        => self - normal * (2.0 * self.Dot(normal));

    // The cosine of the angle between a and b: Dot divided by the product of
    // magnitudes. Preconditions: a and b are non-zero.
    CosineSimilarity(a: Vector, b: Vector): Number
        => a.Dot(b) / (a.Magnitude * b.Magnitude);

    // The unsigned angle between a and b, in [0, Pi]. The cosine similarity is
    // clamped to [-1, 1] before Acos so floating-point drift cannot produce a NaN.
    // Preconditions: a and b are non-zero.
    AngleBetween(a: Vector, b: Vector): Angle
        => a.CosineSimilarity(b).Clamp(-1.0, 1.0).Acos;

    // A vector in the same direction as self but with the given length.
    // Precondition: self is non-zero.
    ScaledToLength(self: Vector, length: Number): Vector
        => self.Normalize * length;

    // Restricts each component of self to the box spanned by lo and hi, using the
    // component-wise lattice operations. Precondition: lo <= hi component-wise.
    Clamp(self: Vector, lo: Vector, hi: Vector): Vector
        => self.Max(lo).Min(hi);

    // Restricts each component of self to [0, 1] using the vector's own Zero and
    // One elements (the component-wise analogue of CoreAlgebra's Saturate).
    Saturate(self: Vector): Vector
        => self.Max(self.Zero).Min(self.One);

    //==
    // # Vector — safe normalization and directions (normalization pitfalls)
    //
    // Convention: see CONVENTIONS.md - Partial operations (fallback-parameter
    // style, no generic Optional). `Normalize` above carries a non-zero
    // precondition; these give callers a total path so the IsZeroLength guard is
    // written once here rather than at every call site.

    // The unit vector in the same direction as self, or fallback when self has
    // (near) zero length and no direction is defined. Total: never divides by zero.
    NormalizeOr(self: Vector, fallback: Vector): Vector
        => self.MagnitudeSquared > 0.0 ? self.Normalize : fallback;

    //==
    // # Vector3D — cross-product neighbourhood (cross-product lesson)
    //
    // Cross(Vector3D, Vector3D) itself is an intrinsic (intrinsics.library.plato;
    // https://en.wikipedia.org/wiki/Cross_product); these are the helpers that
    // sit immediately around it. Concrete Vector3D receivers so Cross and the
    // component accessors resolve to the 3D type.

    // The scalar triple product a . (b x c): the signed volume of the
    // parallelepiped spanned by the three vectors; zero iff they are coplanar
    // (https://en.wikipedia.org/wiki/Scalar_triple_product).
    ScalarTriple(a: Vector3D, b: Vector3D, c: Vector3D): Number
        => a.Dot(b.Cross(c));

    // True when a and b point along the same line (parallel or antiparallel),
    // judged by the length of their cross product relative to tolerance. Zero
    // vectors are treated as parallel to everything. tolerance is an absolute
    // bound on the cross-product magnitude.
    AreParallel(a: Vector3D, b: Vector3D, tolerance: Number): Boolean
        => a.Cross(b).MagnitudeSquared <= tolerance * tolerance;

    // The wedge (exterior) product a ^ b as a Bivector3D — the geometric-algebra
    // dual of the cross product under the shared right-hand convention: the
    // bivector components (YZ, ZX, XY) equal the (X, Y, Z) of a x b. Encodes the
    // oriented plane element (area and orientation) spanned by a and b.
    Wedge(a: Vector3D, b: Vector3D): Bivector3D
        => Bivector3D(
            a.Y * b.Z - a.Z * b.Y,
            a.Z * b.X - a.X * b.Z,
            a.X * b.Y - a.Y * b.X);

    //==
    // # Vector2D — planar perp and signed area (2D cross-product analog)
    //
    // 2D has no cross product; the honest planar primitives are the perpendicular
    // and the scalar (z-component) cross. Naming them here keeps 2D code from
    // faking a 3D cross.

    // The left perpendicular of v: v rotated +90 degrees (CCW), (-Y, X). Same
    // length as v; the right perpendicular is its negation.
    Perp(v: Vector2D): Vector2D
        => Vector2D(-v.Y, v.X);

    // The 2D scalar cross (perp-dot) a.X*b.Y - a.Y*b.X: the signed area of the
    // parallelogram spanned by a and b, positive when b is CCW from a. Equals the
    // z-component of the 3D cross of the lifted vectors.
    Cross(a: Vector2D, b: Vector2D): Number
        => a.X * b.Y - a.Y * b.X;

    //==
    // # Direction2D / Direction3D — validated factories (normalization pitfalls)
    //
    // Convention: see CONVENTIONS.md - Partial operations. `FromVector`
    // normalizes and carries a non-zero precondition; `TryFromVector` is the
    // total fallback form; `FromVectorUnchecked` wraps without normalizing and is
    // only correct when the argument is already unit length.

    // The unit direction of v. Precondition: v is non-zero (its length becomes the
    // divisor); zero input is undefined. Use TryFromVector for a total path.
    FromVector(v: Vector2D): Direction2D
        => Direction2D(v.Normalize);

    // The unit direction of v, or fallback when v has (near) zero length. Total.
    TryFromVector(v: Vector2D, fallback: Direction2D): Direction2D
        => v.MagnitudeSquared > 0.0 ? Direction2D(v.Normalize) : fallback;

    // Wraps v as a Direction2D WITHOUT normalizing. Unsafe: the caller asserts v
    // is already unit length; violating that silently breaks the Direction2D
    // invariant. Prefer FromVector unless the unit length is already established.
    FromVectorUnchecked(v: Vector2D): Direction2D
        => Direction2D(v);

    // The unit direction of v. Precondition: v is non-zero; zero input is
    // undefined. Use TryFromVector for a total path.
    FromVector(v: Vector3D): Direction3D
        => Direction3D(v.Normalize);

    // The unit direction of v, or fallback when v has (near) zero length. Total.
    TryFromVector(v: Vector3D, fallback: Direction3D): Direction3D
        => v.MagnitudeSquared > 0.0 ? Direction3D(v.Normalize) : fallback;

    // Wraps v as a Direction3D WITHOUT normalizing. Unsafe: the caller asserts v
    // is already unit length; violating that silently breaks the Direction3D
    // invariant. Prefer FromVector unless the unit length is already established.
    FromVectorUnchecked(v: Vector3D): Direction3D
        => Direction3D(v);

    //==
    // # VectorN

    // Folds component hashes in index order.
    Hash(self: VectorN): Integer
        => self.Components.Reduce(0, (acc, x) => acc * 31 + x.Hash);
}
