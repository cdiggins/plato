//==
// # Intrinsics — the host contract
//
// An **intrinsic** is a function the language declares but does not define: a
// signature terminated by `;` with no `=>` body, inside a `library` block. The
// host runtime supplies the implementation. This file is the complete contract a
// backend must satisfy — for C# that is the handwritten `Plato.Intrinsics.V2`;
// for a new backend (C++, GLSL, Rust) it is the porting checklist.
//
// **Rule: a bodiless intrinsic may mention only `primitive` types** (Number,
// Integer, Boolean, Character, String, Array, Buffer, List, Function0-9,
// Dynamic, Type — see `primitives.plato`). Everything that used to be declared
// here on Angle, Number2/3/4/8, Vector2D/3D, Matrix3x2/4x4 and Quaternion now
// has a portable Plato reference body in the corresponding `*-ops.library.plato`
// file. Those bodies define the semantics; a backend may substitute a verified
// native implementation (e.g. System.Numerics) as an optimization via its
// representation map and override table.
//
// Documented exception, this increment only: Array2D / Array3D appear below.
// They are declared as opaque field-less types, so their construction and
// traversal cannot yet be expressed in Plato. When they gain an honest layout
// (or a repr contract), those signatures move out too.
//
// Target backends, in priority order: C#, C++, CUDA, TypeScript, then GLSL, Rust,
// Python (see README.md "Target backends"). An intrinsic belongs here only if every
// priority-1..4 target can supply it natively or with a trivial shim; anything
// C#-specific stays out (see the notes at the bottom of this file).
//
// Bodiless declarations inside a `concept` are NOT intrinsics — those are
// obligations on whoever implements the concept, and the stdlib satisfies them in
// Plato. Only `library` blocks declare host intrinsics.
//
// This is the ONLY file in the library with bodiless declarations, and it stays
// that way.

library Intrinsics
{
    //==
    // Number

    Abs(self: Number): Number;
    Cbrt(self: Number): Number;
    Ceiling(self: Number): Number;
    Clamp(self: Number, min: Number, max: Number): Number;
    CopySign(self: Number, y: Number): Number;
    Exp(self: Number): Number;
    Floor(self: Number): Number;
    FusedMultiplyAdd(self: Number, y: Number, z: Number): Number;
    Log(self: Number, newBase: Number): Number;
    Log10(self: Number): Number;
    Log2(self: Number): Number;
    Min(self: Number, other: Number): Number;
    Max(self: Number, other: Number): Number;
    NaturalLog(self: Number): Number;
    Pow(self: Number, power: Number): Number;
    Reciprocal(self: Number): Number;
    Round(self: Number, digits: Integer): Number;
    Sign(self: Number): Integer;
    Sqrt(self: Number): Number;
    Square(self: Number): Number;
    Truncate(self: Number): Number;

    // Trigonometric kernel over radians-as-Number. The public trig surface lives
    // on Angle (angle-trig.library.plato) with plain Plato bodies delegating
    // here. The inverse family carries a `Radians` suffix because the public
    // Angle-returning `Acos(self: Number): Angle` overload shares the receiver
    // type and differs only in return type.
    Cos(self: Number): Number;
    Sin(self: Number): Number;
    Tan(self: Number): Number;
    Cosh(self: Number): Number;
    Sinh(self: Number): Number;
    Tanh(self: Number): Number;
    AcosRadians(self: Number): Number;
    AcoshRadians(self: Number): Number;
    AsinRadians(self: Number): Number;
    AsinhRadians(self: Number): Number;
    AtanRadians(self: Number): Number;
    Atan2Radians(self: Number, x: Number): Number;
    AtanhRadians(self: Number): Number;

    Add(a: Number, b: Number): Number;
    Subtract(a: Number, b: Number): Number;
    Multiply(a: Number, b: Number): Number;
    Divide(a: Number, b: Number): Number;
    Modulo(a: Number, b: Number): Number;
    Negative(n: Number): Number;

    Equals(a: Number, b: Number): Boolean;
    NotEquals(a: Number, b: Number): Boolean;
    LessThan(a: Number, b: Number): Boolean;
    LessThanOrEquals(a: Number, b: Number): Boolean;
    GreaterThan(a: Number, b: Number): Boolean;
    GreaterThanOrEquals(a: Number, b: Number): Boolean;
    Compare(a: Number, b: Number): Integer;
    Hash(self: Number): Integer;

    MinValue(_: Number): Number;
    MaxValue(_: Number): Number;
    Epsilon(_: Number): Number;
    Zero(_: Number): Number;
    One(_: Number): Number;

    // Mathematical constants, dispatched like the limits above: 0.0.Pi reads the
    // constant; the receiver's value is ignored.
    Pi(_: Number): Number;
    Tau(_: Number): Number;
    E(_: Number): Number;
    IsNaN(self: Number): Boolean;
    IsInfinite(self: Number): Boolean;
    IsFinite(self: Number): Boolean;
    ToInteger(self: Number): Integer;

    //==
    // Integer

    Abs(self: Integer): Integer;
    Add(a: Integer, b: Integer): Integer;
    Subtract(a: Integer, b: Integer): Integer;
    Multiply(a: Integer, b: Integer): Integer;
    Divide(a: Integer, b: Integer): Integer;
    Modulo(a: Integer, b: Integer): Integer;
    Negative(n: Integer): Integer;
    Sign(self: Integer): Integer;
    Min(a: Integer, b: Integer): Integer;
    Max(a: Integer, b: Integer): Integer;

    Equals(a: Integer, b: Integer): Boolean;
    NotEquals(a: Integer, b: Integer): Boolean;
    LessThan(a: Integer, b: Integer): Boolean;
    LessThanOrEquals(a: Integer, b: Integer): Boolean;
    GreaterThan(a: Integer, b: Integer): Boolean;
    GreaterThanOrEquals(a: Integer, b: Integer): Boolean;
    Compare(a: Integer, b: Integer): Integer;
    Hash(self: Integer): Integer;

    BitwiseAnd(a: Integer, b: Integer): Integer;
    BitwiseOr(a: Integer, b: Integer): Integer;
    BitwiseXor(a: Integer, b: Integer): Integer;
    BitwiseNot(x: Integer): Integer;
    ShiftLeft(x: Integer, bits: Integer): Integer;
    ShiftRight(x: Integer, bits: Integer): Integer;

    // Type-token constants, dispatched like the Number limits above: the
    // receiver's value is ignored, the handwritten wrapper defines the member.
    MinValue(_: Integer): Integer;
    MaxValue(_: Integer): Integer;
    Zero(_: Integer): Integer;
    One(_: Integer): Integer;

    ToNumber(self: Integer): Number;
    Range(self: Integer): Array<Integer>;

    //==
    // Boolean

    And(a: Boolean, b: Boolean): Boolean;
    Or(a: Boolean, b: Boolean): Boolean;
    Not(b: Boolean): Boolean;
    ExclusiveOr(a: Boolean, b: Boolean): Boolean;
    Equals(a: Boolean, b: Boolean): Boolean;
    Compare(a: Boolean, b: Boolean): Integer;
    Hash(self: Boolean): Integer;

    //==
    // Array
    //
    // Host-provided array construction and traversal: the map / reduce / zip /
    // slice family over Array, Array2D and Array3D
    // (https://en.wikipedia.org/wiki/Higher-order_function). No concept in this
    // vocabulary can build a collection, so these are the primitives every derived
    // collection helper is written against.

    All(xs: Array<$T>, f: Function1<$T, Boolean>): Boolean;
    Any(xs: Array<$T>, f: Function1<$T, Boolean>): Boolean;
    Append(self: Array<$T>, value: $T): Array<$T>;
    AtModulo(xs: Array<$T>, n: Integer): $T;
    CartesianProduct(columns: Array<$TColumn>, rows: Array<$TRow>, func: Function2<$TColumn, $TRow, $TResult>): Array2D<$TResult>;
    Concatenate(xs: Array<$T>, ys: Array<$T>): Array<$T>;
    Drop(xs: Array<$T>, n: Integer): Array<$T>;
    EveryNth(self: Array<$T>, n: Integer): Array<$T>;
    FlatMap(xs: Array<$T1>, f: Function1<$T1, Array<$T2>>): Array<$T2>;
    MakeArray2D(columns: Integer, rows: Integer, f: Function2<Integer, Integer, $T>): Array2D<$T>;
    Map(xs: Array<$T1>, f: Function1<$T1, $T2>): Array<$T2>;
    MapPairs(xs: Array<$T>, f: Function2<$T, $T, $TR>): Array<$TR>;
    MapTriplets(xs: Array<$T>, f: Function3<$T, $T, $T, $TR>): Array<$TR>;
    MapQuartets(xs: Array<$T>, f: Function4<$T, $T, $T, $T, $TR>): Array<$TR>;
    MapRange(n: Integer, f: Function1<Integer, $T>): Array<$T>;
    Prepend(self: Array<$T>, value: $T): Array<$T>;
    Reduce(xs: Array<$T>, acc: $U, f: Function2<$U, $T, $U>): $U;
    // First parameter is the count: the compiler requires a concrete first parameter,
    // so the V1 form Repeat(x, n) becomes Repeat(n, x).
    Repeat(n: Integer, x: $T): Array<$T>;
    Skip(xs: Array<$T>, n: Integer): Array<$T>;
    Slice(xs: Array<$T>, from: Integer, to: Integer): Array<$T>;
    Slices(xs: Array<$T>, size: Integer): Array2D<$T>;
    SubArray(xs: Array<$T>, from: Integer, count: Integer): Array<$T>;
    Take(xs: Array<$T>, n: Integer): Array<$T>;
    TakeLast(xs: Array<$T>, n: Integer): Array<$T>;
    Zip(xs: Array<$T1>, ys: Array<$T2>, f: Function2<$T1, $T2, $T3>): Array<$T3>;
    Zip(xs: Array<$T1>, ys: Array<$T2>, zs: Array<$T3>, f: Function3<$T1, $T2, $T3, $T4>): Array<$T4>;

    //==
    // Array2D and Array3D — documented exception to the primitive-only rule; see
    // the header note.

    At(xs: Array2D<$T>, i: Integer): $T;
    At(xs: Array3D<$T>, i: Integer): $T;
    Column(self: Array2D<$T>, col: Integer): Array<$T>;
    Row(self: Array2D<$T>, row: Integer): Array<$T>;
    Map(xs: Array2D<$T1>, f: Function1<$T1, $T2>): Array2D<$T2>;

    //==
    // Growable builder: unique type List<T>.
    //
    // Bodiless host signatures for the builder types declared in
    // `primitives-builders.types.plato`. Without them no builder call site
    // resolves. The single-parameter observers and consumers — `Count`, `Freeze`
    // and `EmptyList` — are declared alongside the mutators. Each carries a type
    // variable that is fully determined by its one parameter
    // (`Count(xs: List<$T>)` fixes `$T` from its argument), so a call site can
    // infer it. The runtime (`PlatoList`/`PlatoBuffer`) implements all of them.

    // The number of elements accumulated so far. Observes; does not consume.
    Count(xs: List<$T>): Integer;

    // The element at the given index. Observes; does not consume.
    At(xs: List<$T>, n: Integer): $T;

    // Appends one element and returns the same builder. Rebind or chain.
    Add(xs: List<$T>, x: $T): List<$T>;

    // Appends every element of the array, in order, and returns the same
    // builder. Rebind or chain.
    AddRange(xs: List<$T>, values: Array<$T>): List<$T>;

    // Overwrites the element at the given index and returns the same builder.
    // Precondition: 0 <= i < Count.
    Set(xs: List<$T>, i: Integer, x: $T): List<$T>;

    // Zero-copy handoff of the accumulated elements to an immutable Array<$T>.
    // Consumes: the builder is invalidated and any later use throws.
    Freeze(xs: List<$T>): Array<$T>;

    // A fresh empty List whose element type matches the given array. Lets a
    // generic body obtain a builder where the element type is a type variable,
    // without naming a concrete type in `new List<...>()`.
    EmptyList(xs: Array<$T>): List<$T>;

    //==
    // Fixed-size builder: unique type Buffer<T>.

    // The number of slots. Observes; does not consume.
    Count(xs: Buffer<$T>): Integer;

    // The value written to the given slot. Observes; does not consume.
    At(xs: Buffer<$T>, n: Integer): $T;

    // Writes one slot and returns the same builder. Rebind or chain.
    // Precondition: 0 <= i < Count.
    Set(xs: Buffer<$T>, i: Integer, x: $T): Buffer<$T>;

    // Zero-copy handoff of the written slots to an immutable Array<$T>.
    // Consumes: the builder is invalidated and any later use throws.
    Freeze(xs: Buffer<$T>): Array<$T>;
}

// Notes — intrinsics deliberately omitted from this file:
// - Everything on Angle, Number2/3/4/8, Vector2D/3D, Matrix3x2/4x4 and Quaternion:
//   migrated to Plato reference bodies (angle-trig, vectors-tuples-ops,
//   vectors-geometric-ops, matrices-ops, rotations-ops .library.plato). Backends
//   recover native performance through their representation map + override table.
// - Vector8 (entire section): C# System.Runtime.Intrinsics SIMD surface.
// - BitDecrement/BitIncrement, ILogB, ScaleB, IEEERemainder: IEEE-nextafter-grade
//   exotica; C++/CUDA have them, TypeScript and GLSL do not. Add back on demand.
// - MinMagnitude/MaxMagnitude, ReciprocalEstimate/ReciprocalSqrtEstimate: estimate
//   ops are hardware-specific; the exact forms (Reciprocal, 1/Sqrt) suffice.
// - RoundAwayFromZero/RoundToZero: only Round(digits) and Truncate survive; the
//   midpoint-rounding zoo is C#-specific.
// - Linear/Quadratic/Cubic polynomial evaluation: not intrinsic; belongs in the
//   `polynomials.library.plato` once implemented.
// - Columns/Rows (Array2D -> Array<Array<T>>): jagged views; derive in a library.
// - WithRow1..4 / WithX..W / WithElement: record-update helpers, not host intrinsics;
//   the compiler's with-syntax or library functions cover them.
// - Shift/Stride/WithNext/MapIndices/PrependAndAppend/Count overloads: niche array
//   forms; the surviving core (Map/Reduce/Zip/Slice/...) covers them.
// - First/Last/Middle/IsEmpty/Rest/Reverse/Indices: the compiler rejects bodiless
//   generic functions with fewer than two parameters, and the first four already
//   exist generically on Indexable/Countable in collections-indexable.library.plato (P2). Rest/Reverse/
//   Indices should be added to a collections implementation library as derived
//   functions (Skip(1) / MapRange over Count) rather than intrinsics.
