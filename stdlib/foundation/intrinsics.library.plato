//==
// # Intrinsics — the host contract
//
// An **intrinsic** is a function the language declares but does not define: a
// signature terminated by `;` with no `=>` body, inside a `library` block. The
// host runtime supplies the implementation. This file is the complete contract a
// backend must satisfy — for C# that is the handwritten `Plato.Intrinsics`;
// for a new backend (C++, GLSL, Rust) it is the porting checklist.
//
// **Rule: a bodiless intrinsic may mention only `primitive` types** (Number,
// Integer, Boolean, Character, String, Array, Buffer, List, Function0-9,
// Type — see `primitives.plato`).
//
// **Admission rule (plato-378): an intrinsic must not be expressible in Plato
// from the other intrinsics.** If a portable reference body exists, the function
// belongs in a `*.library.plato` file and the backend recovers native speed
// through its override table (plato-368), not by growing this list. Everything
// on Angle, Number2/3/4/8, Vector2D/3D, Matrix3x2/4x4 and Quaternion left under
// that rule; the array reshaping family and the derivable scalar surface
// followed it. `IntrinsicsSurfaceTests` pins the count so the list cannot drift
// back up.
//
// Target backends, in priority order: C#, C++, CUDA, TypeScript, then GLSL, Rust,
// Python (see README.md "Target backends"). An intrinsic belongs here only if every
// priority-1..4 target can supply it natively or with a trivial shim; anything
// C#-specific stays out (see the notes at the bottom of this file).
//
// Bodiless declarations inside a `interface` are NOT intrinsics — those are
// obligations on whoever implements the interface, and the stdlib satisfies them in
// Plato. Only `library` blocks declare host intrinsics.
//
// This is the ONLY file in the library with bodiless declarations, and it stays
// that way.

library Intrinsics
{
    //==
    // Number — the irreducible scalar kernel.
    //
    // Everything derivable from these has a reference body in
    // `primitives.library.plato`: Abs, Sign, Square, Reciprocal, Min,
    // Max, Ceiling, Truncate, Cbrt, Log/Log2/Log10, the Tan/Cosh/Sinh/Tanh
    // family, the whole inverse-trig family (over Atan2Radians and NaturalLog),
    // Zero/One/Tau/E, IsFinite, and the five relational operators the IOrderable
    // generics already cover.

    Add(a: Number, b: Number): Number;
    Subtract(a: Number, b: Number): Number;
    Multiply(a: Number, b: Number): Number;
    Divide(a: Number, b: Number): Number;
    Modulo(a: Number, b: Number): Number;
    Negative(n: Number): Number;

    // The total order and structural equality. LessThanOrEquals is the single
    // IOrderable primitive; LessThan / GreaterThan / GreaterThanOrEquals /
    // Compare / Clamp / Lesser / Greater all derive from it in
    // `core.library.plato`, and NotEquals from Equals.
    LessThanOrEquals(a: Number, b: Number): Boolean;
    Equals(a: Number, b: Number): Boolean;

    // Bit-level digest: not expressible over arithmetic.
    Hash(self: Number): Integer;

    // Rounding: Floor is the primitive, Ceiling and Truncate derive from it.
    // Round carries a digit count because decimal scaling loses precision when
    // synthesized from Floor.
    Floor(self: Number): Number;
    Round(self: Number, digits: Integer): Number;

    // Transcendental kernel. Pow stays a primitive because Exp(y * Log x) is
    // wrong for a negative base; FusedMultiplyAdd stays because its single
    // rounding is a SEMANTIC difference from a * b + c, not an optimization.
    Sqrt(self: Number): Number;
    Exp(self: Number): Number;
    NaturalLog(self: Number): Number;
    Pow(self: Number, power: Number): Number;
    FusedMultiplyAdd(self: Number, y: Number, z: Number): Number;

    // Trigonometric kernel over radians-as-Number. The public trig surface lives
    // on Angle (angles.library.plato) with plain Plato bodies delegating
    // here. Sin, Cos and the two-argument arctangent are the whole kernel:
    // Tan/Cosh/Sinh/Tanh and the six inverse forms derive from these plus Exp
    // and NaturalLog.
    Sin(self: Number): Number;
    Cos(self: Number): Number;
    Atan2Radians(self: Number, x: Number): Number;

    // Representation limits and the one constant that is not a formula over
    // another. Tau = 2 Pi and E = Exp(1) are derived.
    MinValue(_: Number): Number;
    MaxValue(_: Number): Number;
    Epsilon(_: Number): Number;
    Pi(_: Number): Number;

    // Non-finite classification: IsFinite is derived from these two.
    IsNaN(self: Number): Boolean;
    IsInfinite(self: Number): Boolean;

    ToInteger(self: Number): Integer;

    //==
    // Integer
    //
    // Derived in `primitives.library.plato`: Abs, Sign, Min, Max,
    // Zero, One, Range, and the relational family.

    Add(a: Integer, b: Integer): Integer;
    Subtract(a: Integer, b: Integer): Integer;
    Multiply(a: Integer, b: Integer): Integer;
    Divide(a: Integer, b: Integer): Integer;
    Modulo(a: Integer, b: Integer): Integer;
    Negative(n: Integer): Integer;

    LessThanOrEquals(a: Integer, b: Integer): Boolean;
    Equals(a: Integer, b: Integer): Boolean;
    Hash(self: Integer): Integer;

    BitwiseAnd(a: Integer, b: Integer): Integer;
    BitwiseOr(a: Integer, b: Integer): Integer;
    BitwiseXor(a: Integer, b: Integer): Integer;
    BitwiseNot(x: Integer): Integer;
    ShiftLeft(x: Integer, bits: Integer): Integer;
    ShiftRight(x: Integer, bits: Integer): Integer;

    MinValue(_: Integer): Integer;
    MaxValue(_: Integer): Integer;

    ToNumber(self: Integer): Number;

    //==
    // Boolean
    //
    // The three connectives. Equals, ExclusiveOr, Compare and Hash are derived
    // in `primitives.library.plato`; LessThanOrEquals (false orders before
    // true) is derived there too.

    And(a: Boolean, b: Boolean): Boolean;
    Or(a: Boolean, b: Boolean): Boolean;
    Not(b: Boolean): Boolean;

    //==
    // Character and String
    //
    // Both primitives declare `IOrderable` (primitives.plato), which the host must
    // discharge: text ordering is the platform's collation, not something Plato
    // can define. Operator-named, so the C# writer synthesizes the wrapper from
    // the runtime's comparison operators.

    LessThanOrEquals(a: Character, b: Character): Boolean;
    LessThanOrEquals(a: String, b: String): Boolean;

    // The only constructor of a String that is not a literal: the characters of the
    // array in order, and the empty String for the empty array. Irreducible: a String
    // is opaque, so no composition of the observers (Count, At) can build one.
    // Witness: FromCharacters of the characters of "ab" is "ab"; of none, "".
    FromCharacters(cs: Array<Character>): String;

    // The characters at the indices start to start + count - 1 that exist. The range
    // is clamped to the String at both ends, so a negative start, a count past the end,
    // a count of zero or less, and a range wholly outside never fail: the last two give
    // "". Expressible as FromCharacters over MapRange and At, but that copies and
    // allocates once per character and the STEP parser slices every keyword; the
    // intrinsic is one block copy. Witness: Substring("abcd", 1, 2) == "bc";
    // Substring("abcd", -1, 3) == "ab" and Substring("abcd", 3, 9) == "d".
    Substring(s: String, start: Integer, count: Integer): String;

    // Whether the text is a number in the P21 real forms: an optional sign, digits with
    // an optional point and more digits (at least one digit in all), then an optional
    // exponent E or e with an optional sign and digits. "1.", ".5" and "1.E-06" are
    // numbers. Anything else is not: "", ".", "1e", "NaN", "Infinity", "0x10", " 1", and
    // a text whose value rounds to infinity ("1e999"). The form is checked by hand so
    // that every runtime agrees on it; ParseNumber in text.library.plato pairs this with
    // NumberFromText. Witness: IsNumberText("1.E-06") and not IsNumberText("1e").
    IsNumberText(s: String): Boolean;

    // The value of the number the text spells, correctly rounded to the nearest Number by
    // the host's own parser (double.Parse in the invariant culture, std::from_chars in
    // C++), so the runtimes agree bit for bit; "-0" is negative zero. 0 when IsNumberText
    // is false. Not expressible in Plato: it is a correctly rounded decimal-to-binary
    // conversion, which needs the host's big-integer path or a table of powers.
    // Witness: NumberFromText("1.5E1") == 15.0 and NumberFromText("abc") == 0.0.
    NumberFromText(s: String): Number;

    // Whether the text is an optional sign and one or more decimal digits whose value fits
    // Integer under the profile (64-bit under cpu64, 32-bit under cpu64i32 and gpu32).
    // "-0", "+7" and "007" are integers. "", "+", "1.0", "1e3", " 1" and a value past the
    // range are not: overflow is reported, never wrapped. Pairs with IntegerFromText in
    // ParseInteger (text.library.plato). Witness: IsIntegerText("-12") and not
    // IsIntegerText("99999999999999999999").
    IsIntegerText(s: String): Boolean;

    // The Integer the text spells; 0 when IsIntegerText is false. Expressible in Plato with
    // a loop over At and an overflow test, but then every runtime owns a copy of the range
    // test and the profile decides it; one host call keeps the limits where the type's own
    // are. Witness: IntegerFromText("-12") == -12 and IntegerFromText("1.0") == 0.
    IntegerFromText(s: String): Integer;

    // The shortest text that reads back to this exact Number through NumberFromText, bit
    // for bit (the shortest round-trip digits, in the invariant culture): "0.1", "100",
    // "1E+17", "1E-05", "-0" (plain digits from 1E-04 up to below 1E+17, scientific
    // outside, as .NET writes the "R" form). NaN, Infinity and -Infinity are written "NaN", "Infinity" and
    // "-Infinity", and IsNumberText rejects all three, so only finite Numbers round-trip.
    // Not expressible in Plato: shortest round-trip digit generation needs the host's
    // algorithm (Ryu or Grisu with a fallback) and every runtime must pick the same digits.
    // Witness: NumberToShortestString(0.5) == "0.5" and NumberToShortestString(1e-5) == "1E-05".
    NumberToShortestString(x: Number): String;

    //==
    // Array — the five-function kernel.
    //
    // `Count` and `At` observe; `MapRange` is the ONLY constructor; `Reduce` is
    // the only sequential fold; `FlatMap` the only length-varying producer.
    // Every other array function in the previous contract is a reindexing of
    // MapRange, with a reference body in `primitives.library.plato`.
    //
    // Reduce and FlatMap cannot follow: neither is a reindexing of MapRange.
    // (An earlier note here said a body is a pure expression "with no loop".
    // That is false — bodies may use var/while/if and the List/Buffer builders,
    // per LIBRARIES.md ground rule 2. Only the no-recursion contract holds,
    // GLSL forbidding recursion outright. Whether these two are now expressible
    // and so belong in a library file per plato-378 has not been re-examined.)

    Count(xs: Array<$T>): Integer;
    At(xs: Array<$T>, n: Integer): $T;
    MapRange(n: Integer, f: Function1<Integer, $T>): Array<$T>;
    Reduce(xs: Array<$T>, acc: $U, f: Function2<$U, $T, $U>): $U;
    FlatMap(xs: Array<$T1>, f: Function1<$T1, Array<$T2>>): Array<$T2>;

    //==
    // Growable builder: unique type List<T>.
    //
    // Bodiless host signatures for the builder types declared in
    // `primitives.plato`. Without them no builder call site
    // resolves. The single-parameter observers and consumers — `Count`, `Freeze`
    // and `EmptyList` — are declared alongside the mutators. Each carries a type
    // variable that is fully determined by its one parameter
    // (`Count(xs: List<$T>)` fixes `$T` from its argument), so a call site can
    // infer it. The runtime (`PlatoList`/`PlatoBuffer`) implements all of them.

    // The number of elements accumulated so far. Observes; does not consume.
    Count(xs: List<$T>): Integer;

    // The element at the given index. Observes; does not consume.
    At(xs: List<$T>, n: Integer): $T;

    // Appends one element and returns the same builder. Rebind or chain.
    Add(xs: List<$T>, x: $T): List<$T>;

    // Appends every element of the array, in order, and returns the same
    // builder. Rebind or chain.
    AddRange(xs: List<$T>, values: Array<$T>): List<$T>;

    // Overwrites the element at the given index and returns the same builder.
    // Precondition: 0 <= i < Count.
    Set(xs: List<$T>, i: Integer, x: $T): List<$T>;

    // Zero-copy handoff of the accumulated elements to an immutable Array<$T>.
    // Consumes: the builder is invalidated and any later use throws.
    Freeze(xs: List<$T>): Array<$T>;

    // A fresh empty List whose element type matches the given array. Lets a
    // generic body obtain a builder where the element type is a type variable,
    // without naming a concrete type in `new List<...>()`.
    EmptyList(xs: Array<$T>): List<$T>;

    //==
    // Fixed-size builder: unique type Buffer<T>.

    // The number of slots. Observes; does not consume.
    Count(xs: Buffer<$T>): Integer;

    // The value written to the given slot. Observes; does not consume.
    At(xs: Buffer<$T>, n: Integer): $T;

    // Writes one slot and returns the same builder. Rebind or chain.
    // Precondition: 0 <= i < Count.
    Set(xs: Buffer<$T>, i: Integer, x: $T): Buffer<$T>;

    // Zero-copy handoff of the written slots to an immutable Array<$T>.
    // Consumes: the builder is invalidated and any later use throws.
    Freeze(xs: Buffer<$T>): Array<$T>;
}

// Notes — intrinsics deliberately omitted from this file:
// - Array2D / Array3D (the whole former section, plus MakeArray2D): they now carry
//   an honest layout in `primitives.types.plato` (Elements + ColumnCount +
//   RowCount [+ LayerCount]), so construction and traversal are ordinary Plato
//   bodies in `primitives.library.plato`. This retires the documented
//   exception to the primitive-only rule.
// - Everything on Angle, Number2/3/4/8, Vector2D/3D, Matrix3x2/4x4 and Quaternion:
//   migrated to Plato reference bodies (angle-trig, vectors-tuples-ops,
//   vectors-geometric-ops, matrices-ops, rotations-ops .library.plato). Backends
//   recover native performance through their representation map + override table.
// - Vector8 (entire section): C# System.Runtime.Intrinsics SIMD surface.
// - BitDecrement/BitIncrement, ILogB, ScaleB, IEEERemainder: IEEE-nextafter-grade
//   exotica; C++/CUDA have them, TypeScript and GLSL do not. Add back on demand.
// - MinMagnitude/MaxMagnitude, ReciprocalEstimate/ReciprocalSqrtEstimate: estimate
//   ops are hardware-specific; the exact forms (Reciprocal, 1/Sqrt) suffice.
// - RoundAwayFromZero/RoundToZero: only Round(digits) and Truncate survive; the
//   midpoint-rounding zoo is C#-specific.
// - Columns/Rows (Array2D -> Array<Array<T>>): jagged views; derive in a library.
// - WithRow1..4 / WithX..W / WithElement: record-update helpers, not host intrinsics;
//   the compiler's with-syntax or library functions cover them.
// - Shift/Stride/WithNext/MapIndices/PrependAndAppend: niche array forms; the
//   surviving kernel plus the derived family in primitives-arrays covers them.
// - Rest/Reverse/Indices: derived functions over MapRange and Count, not
//   intrinsics; they live in `primitives.library.plato`.
