//==
// # Matrices
//
// Sections, in order:
//  - Matrices and tensors
//  - Sparse and banded matrices

//==
// # Matrices and tensors
//
// Dense numeric matrices (https://en.wikipedia.org/wiki/Matrix_(mathematics))
// stored as row vectors: RowN holds row N, so element (r, c) is component c of
// row r. Fixed sizes cover graphics and geometry; MatrixN and Tensor cover
// scientific computing. The IMatrixLike concept they implement is declared in
// `matrices.concepts.plato`.
// Convention: see CONVENTIONS.md - Matrices (System.Numerics-compatible row-vector
// multiplication, v' = v M).
// Discoverability: the concrete operations for the fixed-size
// matrices (Determinant, Invert, Multiply, Transform, Lerp, ...) are declared on
// the intrinsic hub in `intrinsics.library.plato`, not restated here;
// concept-generic helpers (Trace, FrobeniusNorm, IsSquare, ...) live in
// `numeric-structures.library.plato`.

// A 2x2 matrix: 2D linear maps (rotation, scale, shear).
type Matrix2x2
    implements IMatrixLike, IMultiplicative
{
    Row1: Number2;
    Row2: Number2;
}

// A 3x3 matrix: 3D linear maps, 2D homogeneous transforms, orientation bases.
type Matrix3x3
    implements IMatrixLike, IMultiplicative
{
    Row1: Number3;
    Row2: Number3;
    Row3: Number3;
}

// A 4x4 matrix: 3D homogeneous transforms and projections
// (https://en.wikipedia.org/wiki/Transformation_matrix).
type Matrix4x4
    implements IMatrixLike, IMultiplicative
{
    Row1: Number4;
    Row2: Number4;
    Row3: Number4;
    Row4: Number4;
}

// A 3-row, 2-column matrix: a 2D affine map (2x2 linear part plus a translation
// row).
type Matrix3x2
    implements IMatrixLike
{
    Row1: Number2;
    Row2: Number2;
    Row3: Number2;
}

// A 4-row, 3-column matrix: a 3D affine map (3x3 linear part plus a translation
// row).
type Matrix4x3
    implements IMatrixLike
{
    Row1: Number3;
    Row2: Number3;
    Row3: Number3;
    Row4: Number3;
}

// A symmetric 3x3 matrix stored as its six unique elements
// (https://en.wikipedia.org/wiki/Symmetric_matrix): inertia tensors,
// covariance, stress and strain states.
type SymmetricMatrix3x3
    implements IValue
{
    M11: Number; M12: Number; M13: Number;
    M22: Number; M23: Number;
    M33: Number;
}

// A dense matrix with runtime-determined shape, row-major storage.
type MatrixN
    implements IMatrixLike
{
    NumRows: Integer;
    NumColumns: Integer;
    Components: Array<Number>;
}

// A dense multi-dimensional numeric array with arbitrary rank
// (https://en.wikipedia.org/wiki/Tensor). Extents lists the size of each
// dimension; storage is row-major.
type Tensor
    implements IValue
{
    Extents: Array<Integer>;
    Components: Array<Number>;
}

//==
// # Sparse and banded matrices
//
// Matrices whose storage is proportional to their non-zero content rather than
// to their shape: coordinate-list sparse storage and the banded form of a
// matrix whose non-zeros hug the diagonal. The dense counterparts (and the
// IMatrixLike concept) are the section above; these types deliberately
// do not claim IMatrixLike, because element access is a search rather than an
// offset.
// Convention: see CONVENTIONS.md - Matrices (row-vector multiplication,
// v' = v M); rows and columns here mean the same thing they do there.

// One stored element of a sparse matrix: its zero-based position and value.
// Entries are unordered and a position may repeat; the value at a position is
// the sum of the entries that name it, which is what makes concatenation a
// correct sum.
// (https://en.wikipedia.org/wiki/Sparse_matrix#Coordinate_list_(COO))
type SparseMatrixEntry
    implements IValue
{
    Row: Integer;
    Column: Integer;
    Value: Number;
}

// A matrix stored as its non-zero entries only (coordinate-list form). Any
// position absent from Entries is zero. Storage is proportional to the entry
// count, so this is the representation for the large, mostly-empty systems
// that arise in finite-element and graph problems.
// (https://en.wikipedia.org/wiki/Sparse_matrix)
type SparseMatrix
    implements IValue
{
    NumRows: Integer;
    NumColumns: Integer;
    Entries: Array<SparseMatrixEntry>;
}

// A matrix whose non-zeros lie within a band about the main diagonal:
// element (r, c) may be non-zero only when -LowerBandwidth <= c - r <=
// UpperBandwidth. Values holds the band in row-major order, each row
// contributing LowerBandwidth + UpperBandwidth + 1 slots (positions off the
// matrix are stored and ignored), which is the layout that lets banded solvers
// run in linear time. Both bandwidths are non-negative; zero and zero is a
// diagonal matrix, one and one is tridiagonal.
// (https://en.wikipedia.org/wiki/Band_matrix)
type BandedMatrix
    implements IValue
{
    NumRows: Integer;
    NumColumns: Integer;
    LowerBandwidth: Integer;
    UpperBandwidth: Integer;
    Values: Array<Number>;
}
