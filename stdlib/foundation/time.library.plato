//==
// # Time arithmetic
//
// Affine Instant / Duration operations for the types of `time.types.plato`.
// Instants are positions on a time line; Durations are differences between
// them — deliberately distinct from Number (same discipline as Size2D vs
// Vector2D in `intervals.types.plato`). Duration already discharges its
// IQuantity obligations via `quantities.library.plato` / Amount-FromAmount in
// `quantities.library.plato`; this file adds Instant IDifference
// and IComparable fills, plus the Duration↔Number and Duration/Duration
// operators that IQuantity alone does not cover.

library Time
{
    //==
    // Instant — the two IOriginBased<Duration> conversions, plus IComparable.
    // The epoch IS the origin, so the conversions are the same field under its
    // two names: seconds since the epoch, and a span of seconds.
    //
    // Add, Between, Subtract (both spellings) and Lerp are all derived over the
    // IDifference and IOriginBased concepts in algebra.library.plato. Between keeps the
    // b - a orientation, matching the point types. Instant gains interpolation
    // and an Origin (the epoch, now nameable) it never had. The commuted
    // Add(Duration, Instant) stays concrete: library dispatch is on the first
    // parameter, which must be a concrete type or concept, so a generic
    // reversed-operand form cannot be written.

    // The instant's displacement from the epoch.
    Offset(t: Instant): Duration
        => new Duration(t.SecondsSinceEpoch);

    // The instant at the given span after the epoch.
    FromOffset(_: Instant, d: Duration): Instant
        => new Instant(d.Seconds);

    // Commutative form of Add(Instant, Duration).
    Add(d: Duration, t: Instant): Instant
        => t.Add(d);

    // Total order by seconds since the epoch.
    LessThanOrEquals(a: Instant, b: Instant): Boolean
        => a.SecondsSinceEpoch <= b.SecondsSinceEpoch;

    //==
    // Duration — extra scalar and ratio forms beyond IQuantity.
    // Add/Subtract/Negative/Multiply(Duration, Number)/Divide(Duration, Number)
    // already come from quantities.library.plato via Amount/FromAmount.

    // Scale a span from the left: n * d.
    Multiply(scalar: Number, d: Duration): Duration
        => new Duration(scalar * d.Seconds);

    // The dimensionless ratio of two spans. Precondition: b is non-zero.
    Divide(a: Duration, b: Duration): Number
        => a.Seconds / b.Seconds;

    //==
    // # FrameTime and BeatTime — the IComparable fills
    //
    // Both order along their own time line, so both compare on their count. For
    // FrameTime that is the FRAME NUMBER, not the wall-clock instant: comparing
    // two frame times under different rates would need a common time line, and
    // silently converting would make the order depend on a field the caller may
    // not have meant to vary. Convert to Instant first if that is the question.

    // Frame positions order by frame number. Precondition: both share a rate.
    LessThanOrEquals(a: FrameTime, b: FrameTime): Boolean
        => a.Frame <= b.Frame;

    // Beat positions order by beat count.
    LessThanOrEquals(a: BeatTime, b: BeatTime): Boolean
        => a.Beats <= b.Beats;
}
