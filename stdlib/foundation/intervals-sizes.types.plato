//==
// # Extents and sizes
//
// Non-negative extents rather than positions: the width/height/depth of a
// region. They are deliberately distinct from the vector types, so a size can
// never be mistaken for a displacement, and from the bounding regions of
// `intervals-bounds.types.plato`, which pair a size with a placement.

// A continuous 2D extent: width and height.
type Size2D
    implements Value
{
    Width: Number;
    Height: Number;
}

// A continuous 3D extent: width, height, and depth.
type Size3D
    implements Value
{
    Width: Number;
    Height: Number;
    Depth: Number;
}

// A discrete 2D extent: image and grid dimensions.
type IntegerSize2D
    implements Value, Hashable
{
    Width: Integer;
    Height: Integer;
}

// A discrete 3D extent: voxel-grid dimensions.
type IntegerSize3D
    implements Value, Hashable
{
    Width: Integer;
    Height: Integer;
    Depth: Integer;
}
