//==
// # Statistics
//
// Sections, in order:
//  - Statistics
//  - Covariance, correlation, and fits

//==
// # Statistics
//
// Univariate descriptive statistics: summaries, histograms, quantiles, and
// the smoothing and outlier rules applied to a single sample
// (https://en.wikipedia.org/wiki/Descriptive_statistics). Conventions: sample
// statistics use Bessel's correction (divide by n - 1); kurtosis is excess
// kurtosis (a normal distribution scores 0). The bivariate surface --
// covariance, correlation, and fits -- follows in the next section.

// Descriptive statistics of a univariate sample. Variance and StandardDeviation
// use the sample (n - 1) convention; Skewness and Kurtosis are standardized
// moments, with Kurtosis reported as excess (normal = 0).
type SummaryStatistics
    implements IValue
{
    Count: Integer;
    Sum: Number;
    Mean: Number;
    Variance: Number;
    StandardDeviation: Number;
    Minimum: Number;
    Maximum: Number;
    Skewness: Number;
    Kurtosis: Number;
}

// A Welford-style streaming accumulator. M2 is the running sum of squared
// deviations from the current mean; sample variance = M2 / (Count - 1).
type RunningStatistics
    implements IValue
{
    Count: Integer;
    Mean: Number;
    M2: Number;
}

// A value paired with a non-negative weight, for weighted means, weighted
// fits, and importance sampling.
// (https://en.wikipedia.org/wiki/Weighted_arithmetic_mean)
type WeightedValue<T>
{
    Value: T;
    Weight: Number;
}

// Counts of values falling into uniform bins across Range. Counts[i] tallies
// the half-open bin [Start + i*w, Start + (i+1)*w), where w is the Range
// length divided by the bin count; the final bin also includes the Range End.
// Values outside Range are not counted.
type Histogram
    implements IValue
{
    Range: NumberInterval;
    Counts: Array<Integer>;
}

// A joint histogram of two variables over uniform bins. The column index of
// Counts selects the x bin, the row index selects the y bin; bin edges follow
// the same half-open convention as Histogram.
type Histogram2D
    implements IValue
{
    RangeX: NumberInterval;
    RangeY: NumberInterval;
    Counts: Array2D<Integer>;
}

// Sample quantiles as parallel arrays: Values[i] is the data value at
// cumulative probability Levels[i] (https://en.wikipedia.org/wiki/Quantile).
// Levels ascend and lie in [0, 1].
type Quantiles
    implements IValue
{
    Levels: Array<Probability>;
    Values: Array<Number>;
}

// The classic five-number summary: extremes, quartiles, and median.
type FiveNumberSummary
    implements IValue
{
    Minimum: Number;
    LowerQuartile: Number;
    Median: Number;
    UpperQuartile: Number;
    Maximum: Number;
}

// Box-plot statistics: the five-number summary plus whisker ends (the most
// extreme data values within 1.5 interquartile ranges of the quartiles) and
// the data values lying beyond the whiskers.
type BoxPlotStatistics
    implements IValue
{
    Summary: FiveNumberSummary;
    LowerWhisker: Number;
    UpperWhisker: Number;
    Outliers: Array<Number>;
}

//==
// # Smoothing and outliers

// A moving-average smoother, each kind carrying exactly its own controls
// (https://en.wikipedia.org/wiki/Moving_average): a flat window of WindowSize
// samples (Simple), an exponential smoother with alpha in (0, 1]
// (Exponential), or a Gaussian-weighted window with its standard deviation in
// samples (Gaussian).
type MovingAverage
    = Simple(WindowSize: Integer)
    | Exponential(Alpha: Proportion)
    | Gaussian(WindowSize: Integer, StandardDeviation: Number);

// An outlier test. Each statistic carries its threshold in its own native
// scale: standard deviations for ZScore
// (https://en.wikipedia.org/wiki/Standard_score), interquartile-range
// multiples beyond the quartiles for Iqr, and median-absolute-deviation
// multiples for Mad (https://en.wikipedia.org/wiki/Median_absolute_deviation).
type OutlierDetection
    = ZScore(Threshold: Number)
    | Iqr(Threshold: Number)
    | Mad(Threshold: Number);

//==
// # Covariance, correlation, and fits
//
// The bivariate half of the statistics vocabulary: sample covariances, the
// correlation statistics computed from paired observations, and the
// least-squares models fitted to them. Paired arrays are index-aligned and
// equal in length; the univariate summaries are the section above, and
// the derived readings of these records in
// `statistics.library.plato`.

// The 2x2 symmetric covariance of a bivariate sample: Xx and Yy are the
// variances of x and y; Xy is their covariance.
type Covariance2D
    implements IValue
{
    Xx: Number;
    Xy: Number;
    Yy: Number;
}

// The 3x3 symmetric covariance of a trivariate sample.
type Covariance3D
    implements IValue
{
    Matrix: SymmetricMatrix3x3;
}

// The correlation statistic to compute.
type CorrelationStatistic = Pearson | Spearman | Kendall;

// A correlation coefficient in [-1, 1] together with the statistic used and
// the number of paired observations behind it.
type CorrelationCoefficient
    implements IValue
{
    Statistic: CorrelationStatistic;
    Value: Number;
    SampleCount: Integer;
}

// An ordinary least-squares line y = Slope * x + Intercept. RSquared is the
// coefficient of determination in [0, 1].
type LinearFit
    implements IValue
{
    Slope: Number;
    Intercept: Number;
    RSquared: Number;
}

// A least-squares polynomial fit. Coefficients[k] multiplies x^k (ascending
// powers). RSquared is the coefficient of determination in [0, 1].
type PolynomialFit
    implements IValue
{
    Coefficients: Array<Number>;
    RSquared: Number;
}
