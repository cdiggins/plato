//==
// # Gamma- and beta-family bodies
//
// The `ProbabilityDistribution` obligations for GammaDistribution,
// BetaDistribution, ChiSquaredDistribution and StudentTDistribution. These four
// share one shape: their Mean and Variance are elementary closed forms, while
// every Pdf and Cdf goes through the special-function vocabulary of the
// `numbers-special-*` libraries — `Gamma`/`LogGamma`, `Beta`, and the
// regularized incomplete forms `RegularizedGammaP` and `RegularizedBeta`.
// The accuracy of each body is bounded by the accuracy stated on those
// functions (roughly 1e-12 relative on their primary domains).

library RandomContinuousGamma
{
    //==
    // # GammaDistribution
    //
    // Parameterization: SHAPE (k) and SCALE (theta) — theta is a scale, NOT a
    // rate; the rate form uses beta = 1 / theta. Support is x > 0.
    // Precondition: Shape > 0 and Scale > 0.
    // https://en.wikipedia.org/wiki/Gamma_distribution

    // The mean: Shape * Scale.
    Mean(self: GammaDistribution): Number
        => self.Shape * self.Scale;

    // The variance: Shape * Scale^2.
    Variance(self: GammaDistribution): Number
        => self.Shape * self.Scale.Square;

    // The gamma density: x^(k-1) * exp(-x/theta) / (Gamma(k) * theta^k) for
    // x > 0, zero at and below zero (the x = 0 endpoint is taken as 0 even for
    // k < 1, where the true density diverges).
    Pdf(self: GammaDistribution, value: Number): Number
        => value <= 0.0
            ? 0.0
            : value.Pow(self.Shape - 1.0) * (-value / self.Scale).Exp
                / (Gamma(self.Shape) * self.Scale.Pow(self.Shape));

    // The gamma CDF: the regularized lower incomplete gamma P(k, x/theta) for
    // x > 0, zero at and below zero.
    Cdf(self: GammaDistribution, value: Number): Number
        => value <= 0.0
            ? 0.0
            : RegularizedGammaP(self.Shape, value / self.Scale);

    //==
    // # BetaDistribution
    //
    // Parameterization: shape parameters Alpha and Beta, support the closed
    // interval [0, 1]. Precondition: Alpha > 0 and Beta > 0.
    // https://en.wikipedia.org/wiki/Beta_distribution

    // The mean: Alpha / (Alpha + Beta).
    Mean(self: BetaDistribution): Number
        => self.Alpha / (self.Alpha + self.Beta);

    // The variance: Alpha*Beta / ((Alpha+Beta)^2 * (Alpha+Beta+1)).
    Variance(self: BetaDistribution): Number
        => self.Alpha * self.Beta
         / ((self.Alpha + self.Beta).Square * (self.Alpha + self.Beta + 1.0));

    // The beta density: x^(a-1) * (1-x)^(b-1) / B(a, b) on (0, 1), zero
    // outside the open interval (the endpoints are taken as 0 even where the
    // true density diverges, i.e. a < 1 at 0 or b < 1 at 1).
    Pdf(self: BetaDistribution, value: Number): Number
        => value <= 0.0 || value >= 1.0
            ? 0.0
            : value.Pow(self.Alpha - 1.0) * (1.0 - value).Pow(self.Beta - 1.0)
                / Beta(self.Alpha, self.Beta);

    // The beta CDF: the regularized incomplete beta I_x(a, b), clamped to 0
    // below the support and 1 above it.
    Cdf(self: BetaDistribution, value: Number): Number
        => value <= 0.0
            ? 0.0
            : value >= 1.0
                ? 1.0
                : RegularizedBeta(self.Alpha, self.Beta, value);

    //==
    // # ChiSquaredDistribution
    //
    // Parameterization: DegreesOfFreedom (k), the number of squared standard
    // normals summed. Support is x > 0. Precondition: DegreesOfFreedom > 0.
    // https://en.wikipedia.org/wiki/Chi-squared_distribution

    // The mean: the degrees of freedom.
    Mean(self: ChiSquaredDistribution): Number
        => self.DegreesOfFreedom;

    // The variance: twice the degrees of freedom.
    Variance(self: ChiSquaredDistribution): Number
        => 2.0 * self.DegreesOfFreedom;

    // The chi-squared density: x^(k/2-1) * exp(-x/2) / (2^(k/2) * Gamma(k/2))
    // for x > 0, zero at and below zero — the gamma density with shape k/2 and
    // scale 2.
    Pdf(self: ChiSquaredDistribution, value: Number): Number
    {
        var h = 0.5 * self.DegreesOfFreedom;
        return value <= 0.0
            ? 0.0
            : value.Pow(h - 1.0) * (-0.5 * value).Exp / (2.0.Pow(h) * Gamma(h));
    }

    // The chi-squared CDF: the regularized lower incomplete gamma P(k/2, x/2)
    // for x > 0, zero at and below zero.
    Cdf(self: ChiSquaredDistribution, value: Number): Number
        => value <= 0.0
            ? 0.0
            : RegularizedGammaP(0.5 * self.DegreesOfFreedom, 0.5 * value);

    //==
    // # StudentTDistribution
    //
    // Parameterization: DegreesOfFreedom (nu), location 0 and scale 1 (this is
    // the standard, non-shifted t). Support is the whole real line.
    // Precondition: DegreesOfFreedom > 0.
    // https://en.wikipedia.org/wiki/Student%27s_t-distribution

    // The mean: 0 by symmetry. Precondition: DegreesOfFreedom > 1 — the mean is
    // undefined at or below one degree of freedom, where this reports 0 anyway.
    Mean(self: StudentTDistribution): Number
        => 0.0;

    // The variance: nu / (nu - 2). Precondition: DegreesOfFreedom > 2; the
    // variance is infinite on (1, 2] and undefined at or below 1.
    Variance(self: StudentTDistribution): Number
        => self.DegreesOfFreedom / (self.DegreesOfFreedom - 2.0);

    // The Student-t density: (1 + t^2/nu)^(-(nu+1)/2) / (sqrt(nu) * B(1/2, nu/2)).
    Pdf(self: StudentTDistribution, value: Number): Number
    {
        var nu = self.DegreesOfFreedom;
        return (1.0 + value.Square / nu).Pow(-0.5 * (nu + 1.0))
             / (nu.Sqrt * Beta(0.5, 0.5 * nu));
    }

    // The Student-t CDF through the regularized incomplete beta: with
    // x = nu / (nu + t^2), the tail is I_x(nu/2, 1/2) / 2, so the CDF is the
    // tail for t < 0 and one minus the tail for t >= 0 (by the symmetry of the
    // density about 0; at t = 0 both branches give exactly 1/2).
    Cdf(self: StudentTDistribution, value: Number): Number
    {
        var nu = self.DegreesOfFreedom;
        var tail = 0.5 * RegularizedBeta(0.5 * nu, 0.5, nu / (nu + value.Square));
        return value < 0.0 ? tail : 1.0 - tail;
    }
}
