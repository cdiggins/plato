//==
// # Numbers
//
// Sections, in order:
//  - Extended numbers
//  - Dual numbers

//==
// # Extended numbers
//
// Number-like value types beyond the primitives: constrained scalars, exact
// ratios, complex numbers, and typed indices.

// A complex number with real and imaginary parts
// (https://en.wikipedia.org/wiki/Complex_number).
type Complex
    implements INumerical
{
    Real: Number;
    Imaginary: Number;
}

// An exact ratio of two integers
// (https://en.wikipedia.org/wiki/Rational_number). Denominator is never zero.
type Rational
    implements IValue, IComparable
{
    Numerator: Integer;
    Denominator: Integer;
}

// A unitless scalar expected to lie in [0, 1]: blend weights, normalized
// parameters, opacity.
type Proportion
    implements INumerical, IComparable
{
    Value: Number;
}

// A proportion expressed per hundred: 45.0 means 45%.
// (https://en.wikipedia.org/wiki/Percentage)
type Percent
    implements INumerical, IComparable
{
    Value: Number;
}

// A probability in [0, 1]. (https://en.wikipedia.org/wiki/Probability)
type Probability
    implements INumerical, IComparable
{
    Value: Number;
}

// A zero-based position within a caller-supplied or owning item list:
// primitives handed to a spatial structure, fields referenced by a graph,
// entries of a scene pool. -1 means "none". The general-purpose index type;
// domains with richer element vocabularies declare their own (VertexIndex,
// BoneIndex, ...).
type ItemIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

// A count of items; never negative. (https://en.wikipedia.org/wiki/Cardinal_number)
type Cardinal
    implements IValue, IComparable
{
    Value: Integer;
}

// The tolerance for a floating-point near-equality test, combining an absolute
// floor with a relative (proportional to magnitude) term: two numbers x and y
// are close when |x - y| <= Absolute + Relative * max(|x|, |y|). Both fields are
// non-negative. This is the ONE numerical-comparison epsilon record for the
// whole library (see CONVENTIONS.md - Floating-point comparison); the AlmostEqual
// overloads in algebra.library.plato accept it. Engineering Tolerance
// (uncertainty.types.plato) is a manufacturing acceptance allowance, NOT this type.
type ComparisonTolerance
    implements IValue
{
    Absolute: Number;
    Relative: Number;
}

//==
// # Dual numbers
//
// The carrier of forward-mode automatic differentiation: a value paired with
// the derivative of that value with respect to one seed variable. Evaluating
// any composition of the arithmetic in `numbers.library.plato` over duals
// yields the exact derivative alongside the result, with no finite-difference
// step size and no symbolic expansion.

// A value carried together with its first derivative with respect to a single
// seed variable: the algebra of x + e*x', where e is nilpotent (e^2 = 0).
// Seed an input with Derivative 1 (`x.DualVariable`) and every constant with
// Derivative 0 (`c.DualConstant`); the derivative of the whole expression falls
// out of the arithmetic. (https://en.wikipedia.org/wiki/Dual_number)
type DualNumber
    implements INumerical
{
    Value: Number;
    Derivative: Number;
}
