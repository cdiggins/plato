//==
// # Core
//
// Sections, in order:
//  - Core comparison
//  - Core logic

library Core
{
    //==
    // # Core comparison
    //
    // Derived functionality for the comparison concepts
    // (`core.concepts.plato`): the strict/relaxed relational operators,
    // extrema, range tests, and three-way comparison, all built on the single
    // `LessThanOrEquals` primitive of `IOrderable`
    // (https://en.wikipedia.org/wiki/Total_order).
    //
    // This file also carries the shared provenance note for the whole
    // Derived functionality for the `core.concepts.plato` and
    // `algebra.concepts.plato` concepts.
    // Every function's first parameter is concept-typed, so the function becomes
    // available on every type implementing that concept. Bodies are pure
    // expressions built only from members declared on the concept, its inherited
    // concepts, or other functions in this library.

    //==
    // IOrderable
    //
    // LessThanOrEquals itself cannot be derived here: it IS the primitive of
    // IOrderable, so there is nothing on the concept surface to build it from.
    // The only mechanical lever for the outstanding LessThanOrEquals obligations
    // is a *narrower* concept whose implementors share a carrier with a known
    // order — that is `IIndex` (single `Value: Integer`), and its generic body
    // lives in `collections.library.plato` because P2 owns `IIndex`
    // (LIBRARIES.md rule 10). It discharges every typed-index implementor.
    //
    // The remaining implementors have no shared derivable order and each needs a
    // concrete body in its owning package, not a generic one here:
    //   - Rational (numbers) — ordering is a/b <= c/d via cross-multiplication,
    //     and its sign handling depends on the denominator's sign. Not mechanical.
    //   - Proportion / Percent / Probability / Cardinal / SafetyFactor — trivially
    //     order on their single numeric field, but they are not IIndex implementors
    //     and their bodies belong to numbers.types.plato / engineering-*.plato territory.
    //   - Instant / BeatTime (time) — single-field, order on SecondsSinceEpoch
    //     and Beats respectively; concrete bodies for the time domain.
    //   - FrameTime (time) — carries Frame AND Rate. Comparing on Frame alone is
    //     WRONG whenever two FrameTimes carry different rates; a correct body
    //     must convert both to seconds. Explicitly not mechanical.
    //   - Boolean / String / Character (primitives) — host-intrinsic orders
    //     (false < true, lexicographic, code-point). Not expressible on a concept.
    // TODO(cross-package): fill the above in their owning packages.

    //==
    // IEquatable
    //
    // Inequality is the negation of equality, once, for every IEquatable. Written
    // against `Equals` explicitly rather than the `!=` operator, which desugars
    // to this very function. Added by plato-378 so that Number, Integer and
    // Boolean no longer each need a NotEquals intrinsic.

    // True when the two values are not equal.
    NotEquals(a: IEquatable, b: IEquatable): Boolean
        => !a.Equals(b);

    // True when a is strictly less than b.
    LessThan(a: IOrderable, b: IOrderable): Boolean
        => a <= b && a != b;

    // True when a is strictly greater than b.
    GreaterThan(a: IOrderable, b: IOrderable): Boolean
        => b.LessThan(a);

    // True when a is greater than or equal to b.
    GreaterThanOrEquals(a: IOrderable, b: IOrderable): Boolean
        => b <= a;

    // The lesser of the two values, using the total order.
    Lesser(a: IOrderable, b: IOrderable): IOrderable
        => a <= b ? a : b;

    // The greater of the two values, using the total order.
    Greater(a: IOrderable, b: IOrderable): IOrderable
        => a <= b ? b : a;

    // True when x lies within the inclusive range [lower, upper].
    Between(x: IOrderable, lower: IOrderable, upper: IOrderable): Boolean
        => lower <= x && x <= upper;

    // Restricts x to the inclusive range [lower, upper] using the total order.
    // Assumes lower <= upper.
    Clamp(x: IOrderable, lower: IOrderable, upper: IOrderable): IOrderable
        => x.Greater(lower).Lesser(upper);

    // The least of three values, using the total order.
    Min3(a: IOrderable, b: IOrderable, c: IOrderable): IOrderable
        => a.Lesser(b).Lesser(c);

    // The greatest of three values, using the total order.
    Max3(a: IOrderable, b: IOrderable, c: IOrderable): IOrderable
        => a.Greater(b).Greater(c);

    // Three-way comparison derived from the total order: negative when a < b,
    // zero when equal, positive when a > b. Declared as a member on IComparable,
    // but derivable from IOrderable alone, so it lives here on the base concept.
    Compare(a: IOrderable, b: IOrderable): Integer
        => a == b ? 0 : (a <= b ? -1 : 1);

    //==
    // # Core logic
    //
    // Derived functionality for the logic concepts (`core.concepts.plato`):
    // the composite truth-functional connectives and their bit-level counterparts
    // (https://en.wikipedia.org/wiki/Logical_connective).

    //==
    // ILogical

    // Negated conjunction: not (a and b). (https://en.wikipedia.org/wiki/NAND_gate)
    Nand(a: ILogical, b: ILogical): ILogical
        => a.And(b).Not;

    // Negated disjunction: not (a or b). (https://en.wikipedia.org/wiki/NOR_gate)
    Nor(a: ILogical, b: ILogical): ILogical
        => a.Or(b).Not;

    // Material implication: a implies b, i.e. (not a) or b.
    // (https://en.wikipedia.org/wiki/Material_conditional)
    Implies(a: ILogical, b: ILogical): ILogical
        => a.Not.Or(b);

    //==
    // IBooleanAlgebra

    // ILogical equivalence (XNOR): true when a and b have the same truth value.
    // (https://en.wikipedia.org/wiki/XNOR_gate)
    Equivalent(a: IBooleanAlgebra, b: IBooleanAlgebra): IBooleanAlgebra
        => a.ExclusiveOr(b).Not;

    //==
    // IBitwise

    // IBitwise negated-and of the corresponding bits of a and b.
    BitwiseNand(a: IBitwise, b: IBitwise): IBitwise
        => a.BitwiseAnd(b).BitwiseNot;

    // IBitwise negated-or of the corresponding bits of a and b.
    BitwiseNor(a: IBitwise, b: IBitwise): IBitwise
        => a.BitwiseOr(b).BitwiseNot;
}
