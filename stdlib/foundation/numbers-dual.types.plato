//==
// # Dual numbers
//
// The carrier of forward-mode automatic differentiation: a value paired with
// the derivative of that value with respect to one seed variable. Evaluating
// any composition of the arithmetic in `numbers-dual.library.plato` over duals
// yields the exact derivative alongside the result, with no finite-difference
// step size and no symbolic expansion.

// A value carried together with its first derivative with respect to a single
// seed variable: the algebra of x + e*x', where e is nilpotent (e^2 = 0).
// Seed an input with Derivative 1 (`x.DualVariable`) and every constant with
// Derivative 0 (`c.DualConstant`); the derivative of the whole expression falls
// out of the arithmetic. (https://en.wikipedia.org/wiki/Dual_number)
type DualNumber
    implements Numerical
{
    Value: Number;
    Derivative: Number;
}
