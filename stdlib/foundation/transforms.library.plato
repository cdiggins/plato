//==
// # Transforms
//
// Sections, in order:
//  - Affine and projective transform operations
//  - Elementary transforms
//  - Frame and basis operations
//  - Transform identity statics
//  - Motor operations
//  - Point support
//  - Rigid pose operations
//  - Rotation operations and conversions
//  - TRS transform operations

library Transforms
{
    //==
    // # Affine and projective transform operations
    //
    // Application, composition, inversion, and the widening conversions into the
    // affine and projective transforms of `transforms.types.plato` — the common
    // ground where transforms of different kinds are composed.

    //==
    // Affine transforms — the general linear-plus-translation maps; the common
    // ground every 2D/3D transform above converts into, and the right place to
    // compose mixed transform kinds.
    // https://en.wikipedia.org/wiki/Affine_transformation

    // Apply the affine map to a point (includes the translation row).
    Transform(p: Point2D, a: AffineTransform2D): Point2D
        => p.PositionVector.Transform(a.Matrix).ToPoint;

    // Alias for Transform with transform-on-left (* operator): a * p.
    Multiply(a: AffineTransform2D, p: Point2D): Point2D
        => Transform(p, a);

    // Apply the linear part to a displacement (translation does not act on
    // vectors).
    Transform(v: Vector2D, a: AffineTransform2D): Vector2D
        => v.TransformNormal(a.Matrix);

    // Alias for Transform with transform-on-left (* operator): a * v.
    Multiply(a: AffineTransform2D, v: Vector2D): Vector2D
        => Transform(v, a);

    // The affine transform that applies `first`, then `second` (row-vector
    // matrix product).
    Compose(first: AffineTransform2D, second: AffineTransform2D): AffineTransform2D
        => AffineTransform2D(first.Matrix * second.Matrix);

    // Alias for Compose, enabling the * operator: a * b applies a first.
    Multiply(a: AffineTransform2D, b: AffineTransform2D): AffineTransform2D
        => a.Compose(b);

    // The inverse map. Precondition: CanInvert (a non-zero determinant).
    Inverse(a: AffineTransform2D): AffineTransform2D
        => AffineTransform2D(a.Matrix.Invert.X0);

    // True when the affine map is invertible (non-zero determinant).
    CanInvert(a: AffineTransform2D): Boolean
        => a.Matrix.Invert.X1;

    // Any TRS transform is affine.
    AffineTransform2D(t: TrsTransform2D): AffineTransform2D
        => AffineTransform2D(t.Matrix3x2);

    // Any rigid pose is affine.
    AffineTransform2D(pose: Pose2D): AffineTransform2D
        => AffineTransform2D(pose.Matrix3x2);

    // Any plane rotation is affine.
    AffineTransform2D(r: Rotation2D): AffineTransform2D
        => AffineTransform2D(r.Matrix3x2);

    // The 3D affine matrix widened to homogeneous form (fourth column 0,0,0,1).
    Matrix4x4(a: AffineTransform3D): Matrix4x4 {
        var m = a.Matrix;
        return (Number4(m.Row1.X, m.Row1.Y, m.Row1.Z, 0.0),
                Number4(m.Row2.X, m.Row2.Y, m.Row2.Z, 0.0),
                Number4(m.Row3.X, m.Row3.Y, m.Row3.Z, 0.0),
                Number4(m.Row4.X, m.Row4.Y, m.Row4.Z, 1.0));
    }

    // The affine part of a homogeneous matrix. Precondition: the matrix has no
    // projective component (its fourth column is 0, 0, 0, 1).
    AffineTransform3D(m: Matrix4x4): AffineTransform3D
        => AffineTransform3D(Matrix4x3(
            Number3(m.Row1.X, m.Row1.Y, m.Row1.Z),
            Number3(m.Row2.X, m.Row2.Y, m.Row2.Z),
            Number3(m.Row3.X, m.Row3.Y, m.Row3.Z),
            Number3(m.Row4.X, m.Row4.Y, m.Row4.Z)));

    // Apply the affine map to a point: row-vector product
    // p' = x Row1 + y Row2 + z Row3 + Row4.
    Transform(p: Point3D, a: AffineTransform3D): Point3D {
        var m = a.Matrix;
        var v = m.Row1 * p.X + m.Row2 * p.Y + m.Row3 * p.Z + m.Row4;
        return (v.X, v.Y, v.Z);
    }

    // Alias for Transform with transform-on-left (* operator): a * p.
    Multiply(a: AffineTransform3D, p: Point3D): Point3D
        => Transform(p, a);

    // Apply the linear part to a displacement (the translation row is skipped).
    Transform(v: Vector3D, a: AffineTransform3D): Vector3D {
        var m = a.Matrix;
        var r = m.Row1 * v.X + m.Row2 * v.Y + m.Row3 * v.Z;
        return (r.X, r.Y, r.Z);
    }

    // Alias for Transform with transform-on-left (* operator): a * v.
    Multiply(a: AffineTransform3D, v: Vector3D): Vector3D
        => Transform(v, a);

    // The affine transform that applies `first`, then `second`, computed
    // through the homogeneous forms.
    Compose(first: AffineTransform3D, second: AffineTransform3D): AffineTransform3D
        => (first.Matrix4x4 * second.Matrix4x4).AffineTransform3D;

    // Alias for Compose, enabling the * operator: a * b applies a first.
    Multiply(a: AffineTransform3D, b: AffineTransform3D): AffineTransform3D
        => a.Compose(b);

    // The inverse map. Precondition: CanInvert (a non-zero determinant).
    Inverse(a: AffineTransform3D): AffineTransform3D
        => a.Matrix4x4.Invert.AffineTransform3D;

    // True when the affine map is invertible (non-zero determinant).
    CanInvert(a: AffineTransform3D): Boolean
        => a.Matrix4x4.CanInvert;

    // Any TRS transform is affine.
    AffineTransform3D(t: TrsTransform3D): AffineTransform3D
        => t.Matrix4x4.AffineTransform3D;

    // Any rigid pose is affine.
    AffineTransform3D(pose: Pose3D): AffineTransform3D
        => pose.Matrix4x4.AffineTransform3D;

    // Any quaternion rotation is affine.
    AffineTransform3D(q: Quaternion): AffineTransform3D
        => q.Matrix4x4.AffineTransform3D;

    //==
    // Projective transforms — full homographies on homogeneous coordinates;
    // the widest transform family here, closed under composition.
    // https://en.wikipedia.org/wiki/Homography

    // The product of two 3x3 matrices (row times column). Also discharges the
    // IMultiplicative obligation on Matrix3x3.
    Multiply(a: Matrix3x3, b: Matrix3x3): Matrix3x3 {
        var c1 = Number3(b.Row1.X, b.Row2.X, b.Row3.X);
        var c2 = Number3(b.Row1.Y, b.Row2.Y, b.Row3.Y);
        var c3 = Number3(b.Row1.Z, b.Row2.Z, b.Row3.Z);
        return (Number3(a.Row1.Dot(c1), a.Row1.Dot(c2), a.Row1.Dot(c3)),
                Number3(a.Row2.Dot(c1), a.Row2.Dot(c2), a.Row2.Dot(c3)),
                Number3(a.Row3.Dot(c1), a.Row3.Dot(c2), a.Row3.Dot(c3)));
    }

    // Any 2D affine map is projective (third column becomes 0, 0, 1).
    Transform2D(a: AffineTransform2D): Transform2D {
        var m = a.Matrix;
        return Transform2D(Matrix3x3(
            Number3(m.Row1.X, m.Row1.Y, 0.0),
            Number3(m.Row2.X, m.Row2.Y, 0.0),
            Number3(m.Row3.X, m.Row3.Y, 1.0)));
    }

    // Apply the homography: lift to homogeneous coordinates, map, and divide
    // by the resulting weight. Precondition: the point is not mapped onto the
    // line at infinity (weight is non-zero).
    Transform(p: Point2D, t: Transform2D): Point2D {
        var m = t.Matrix;
        var v = m.Row1 * p.X + m.Row2 * p.Y + m.Row3;
        return (v.X / v.Z, v.Y / v.Z);
    }

    // Alias for Transform with transform-on-left (* operator): t * p.
    Multiply(t: Transform2D, p: Point2D): Point2D
        => Transform(p, t);

    // The homography that applies `first`, then `second` (row-vector product).
    Compose(first: Transform2D, second: Transform2D): Transform2D
        => Transform2D(first.Matrix * second.Matrix);

    // Alias for Compose, enabling the * operator: a * b applies a first.
    Multiply(a: Transform2D, b: Transform2D): Transform2D
        => a.Compose(b);

    // Any 3D affine map is projective.
    Transform3D(a: AffineTransform3D): Transform3D
        => Transform3D(a.Matrix4x4);

    // Apply the homography: lift to homogeneous coordinates, map, and divide
    // by the resulting weight. Precondition: the point is not mapped onto the
    // plane at infinity (weight is non-zero).
    Transform(p: Point3D, t: Transform3D): Point3D {
        var v = Number4(p.X, p.Y, p.Z, 1.0).Transform(t.Matrix);
        return (v.X / v.W, v.Y / v.W, v.Z / v.W);
    }

    // Alias for Transform with transform-on-left (* operator): t * p.
    Multiply(t: Transform3D, p: Point3D): Point3D
        => Transform(p, t);

    // The homography that applies `first`, then `second` (row-vector product).
    Compose(first: Transform3D, second: Transform3D): Transform3D
        => Transform3D(first.Matrix * second.Matrix);

    // Alias for Compose, enabling the * operator: a * b applies a first.
    Multiply(a: Transform3D, b: Transform3D): Transform3D
        => a.Compose(b);

    //==
    // # Elementary transforms
    //
    // The single-purpose transforms of `transforms.types.plato` — translation,
    // scaling, reflection, and the about-a-centre forms. Each one names what it
    // does instead of hiding it in a matrix, and each converts into the affine
    // transform of its dimension (its `IAffine2D` / `IAffine3D` obligation), which
    // is where transforms of different kinds are composed.

    //==
    // Translations — a rigid shift. A translation moves positions but not
    // displacements, so its action on a vector is the identity.
    // https://en.wikipedia.org/wiki/Translation_(geometry)

    // The translation as an affine map (identity linear part).
    AffineTransform2D(t: Translation2D): AffineTransform2D
        => AffineTransform2D(Matrix3x2.CreateTranslation(t.Vector));

    // Shift the point by the translation's displacement.
    Transform(p: Point2D, t: Translation2D): Point2D
        => p + t.Vector;

    // Alias for Transform with transform-on-left (* operator): t * p.
    Multiply(t: Translation2D, p: Point2D): Point2D
        => Transform(p, t);

    // A translation does not act on displacements.
    Transform(v: Vector2D, t: Translation2D): Vector2D
        => v;

    // Alias for Transform with transform-on-left (* operator): t * v.
    Multiply(t: Translation2D, v: Vector2D): Vector2D
        => Transform(v, t);

    // The translation that undoes this one (the opposite displacement).
    Inverse(t: Translation2D): Translation2D
        => Translation2D(-t.Vector);

    // The zero translation.
    Identity(_: Translation2D): Translation2D
        => Translation2D(Vector2D.Zero);

    // The translation as an affine map (identity linear part).
    AffineTransform3D(t: Translation3D): AffineTransform3D
        => Matrix4x4.CreateTranslation(t.Vector).AffineTransform3D;

    // Shift the point by the translation's displacement.
    Transform(p: Point3D, t: Translation3D): Point3D
        => p + t.Vector;

    // Alias for Transform with transform-on-left (* operator): t * p.
    Multiply(t: Translation3D, p: Point3D): Point3D
        => Transform(p, t);

    // A translation does not act on displacements.
    Transform(v: Vector3D, t: Translation3D): Vector3D
        => v;

    // Alias for Transform with transform-on-left (* operator): t * v.
    Multiply(t: Translation3D, v: Vector3D): Vector3D
        => Transform(v, t);

    // The translation that undoes this one (the opposite displacement).
    Inverse(t: Translation3D): Translation3D
        => Translation3D(-t.Vector);

    // The zero translation.
    Identity(_: Translation3D): Translation3D
        => Translation3D(Vector3D.Zero);

    //==
    // Scalings about the origin — per-axis and uniform. Unlike a translation a
    // scaling is linear, so it acts on displacements as well as positions.
    // https://en.wikipedia.org/wiki/Scaling_(geometry)

    // The per-axis scaling as an affine map.
    AffineTransform2D(s: Scaling2D): AffineTransform2D
        => AffineTransform2D(Matrix3x2.CreateScale(s.Amount));

    // Scale the point's offset from the origin per axis.
    Transform(p: Point2D, s: Scaling2D): Point2D
        => (p.PositionVector * s.Amount).ToPoint;

    // Alias for Transform with transform-on-left (* operator): s * p.
    Multiply(s: Scaling2D, p: Point2D): Point2D
        => Transform(p, s);

    // Scale the displacement per axis.
    Transform(v: Vector2D, s: Scaling2D): Vector2D
        => v * s.Amount;

    // Alias for Transform with transform-on-left (* operator): s * v.
    Multiply(s: Scaling2D, v: Vector2D): Vector2D
        => Transform(v, s);

    // The reciprocal scaling. Precondition: no component of Amount is zero.
    Inverse(s: Scaling2D): Scaling2D
        => Scaling2D(Number2(1.0 / s.Amount.X, 1.0 / s.Amount.Y));

    // The unit scaling.
    Identity(_: Scaling2D): Scaling2D
        => Scaling2D(Number2.One);

    // The per-axis scaling as an affine map.
    AffineTransform3D(s: Scaling3D): AffineTransform3D
        => Matrix4x4.CreateScale(s.Amount).AffineTransform3D;

    // Scale the point's offset from the origin per axis.
    Transform(p: Point3D, s: Scaling3D): Point3D
        => (p.PositionVector * s.Amount).ToPoint;

    // Alias for Transform with transform-on-left (* operator): s * p.
    Multiply(s: Scaling3D, p: Point3D): Point3D
        => Transform(p, s);

    // Scale the displacement per axis.
    Transform(v: Vector3D, s: Scaling3D): Vector3D
        => v * s.Amount;

    // Alias for Transform with transform-on-left (* operator): s * v.
    Multiply(s: Scaling3D, v: Vector3D): Vector3D
        => Transform(v, s);

    // The reciprocal scaling. Precondition: no component of Amount is zero.
    Inverse(s: Scaling3D): Scaling3D
        => Scaling3D(Number3(1.0 / s.Amount.X, 1.0 / s.Amount.Y, 1.0 / s.Amount.Z));

    // The unit scaling.
    Identity(_: Scaling3D): Scaling3D
        => Scaling3D(Number3.One);

    // The uniform scaling as an affine map.
    AffineTransform2D(s: UniformScaling2D): AffineTransform2D
        => AffineTransform2D(Matrix3x2.CreateScale(s.Amount));

    // Scale the point's offset from the origin.
    Transform(p: Point2D, s: UniformScaling2D): Point2D
        => (p.PositionVector * s.Amount).ToPoint;

    // Alias for Transform with transform-on-left (* operator): s * p.
    Multiply(s: UniformScaling2D, p: Point2D): Point2D
        => Transform(p, s);

    // Scale the displacement.
    Transform(v: Vector2D, s: UniformScaling2D): Vector2D
        => v * s.Amount;

    // Alias for Transform with transform-on-left (* operator): s * v.
    Multiply(s: UniformScaling2D, v: Vector2D): Vector2D
        => Transform(v, s);

    // The reciprocal scaling. Precondition: Amount is not zero.
    Inverse(s: UniformScaling2D): UniformScaling2D
        => UniformScaling2D(1.0 / s.Amount);

    // The unit scaling.
    Identity(_: UniformScaling2D): UniformScaling2D
        => UniformScaling2D(1.0);

    // The uniform scaling as an affine map.
    AffineTransform3D(s: UniformScaling3D): AffineTransform3D
        => Matrix4x4.CreateScale(s.Amount).AffineTransform3D;

    // Scale the point's offset from the origin.
    Transform(p: Point3D, s: UniformScaling3D): Point3D
        => (p.PositionVector * s.Amount).ToPoint;

    // Alias for Transform with transform-on-left (* operator): s * p.
    Multiply(s: UniformScaling3D, p: Point3D): Point3D
        => Transform(p, s);

    // Scale the displacement.
    Transform(v: Vector3D, s: UniformScaling3D): Vector3D
        => v * s.Amount;

    // Alias for Transform with transform-on-left (* operator): s * v.
    Multiply(s: UniformScaling3D, v: Vector3D): Vector3D
        => Transform(v, s);

    // The reciprocal scaling. Precondition: Amount is not zero.
    Inverse(s: UniformScaling3D): UniformScaling3D
        => UniformScaling3D(1.0 / s.Amount);

    // The unit scaling.
    Identity(_: UniformScaling3D): UniformScaling3D
        => UniformScaling3D(1.0);

    //==
    // Reflections — the mirror in a line (2D) or a plane (3D). A reflection is
    // its own inverse, and no reflection is the identity map, so there is no
    // Identity static here. https://en.wikipedia.org/wiki/Reflection_(mathematics)

    // The mirror as an affine map: translate the mirror's origin to the world
    // origin, reflect the basis, translate back. The linear rows are the images
    // of the world axes, so the reflection formula is not restated.
    AffineTransform2D(r: Reflection2D): AffineTransform2D {
        var o = r.Origin.PositionVector;
        var n = Vector2D(-r.Direction.Vector.Y, r.Direction.Vector.X);
        var x = Vector2D(1.0, 0.0).Reflect(n);
        var y = Vector2D(0.0, 1.0).Reflect(n);
        var linear = AffineTransform2D(Matrix3x2(
            Number2(x.X, x.Y),
            Number2(y.X, y.Y),
            Number2(0.0, 0.0)));
        return AffineTransform2D(Matrix3x2.CreateTranslation(-o))
            .Compose(linear)
            .Compose(AffineTransform2D(Matrix3x2.CreateTranslation(o)));
    }

    // Mirror the point in the line: reflect its offset from the line's origin.
    Transform(p: Point2D, r: Reflection2D): Point2D
        => r.Origin + r.Origin.Between(p).Transform(r);

    // Alias for Transform with transform-on-left (* operator): r * p.
    Multiply(r: Reflection2D, p: Point2D): Point2D
        => Transform(p, r);

    // Mirror the displacement in the line's direction (a reflection is linear,
    // so it does act on displacements).
    Transform(v: Vector2D, r: Reflection2D): Vector2D
        => v.Reflect(Vector2D(-r.Direction.Vector.Y, r.Direction.Vector.X));

    // Alias for Transform with transform-on-left (* operator): r * v.
    Multiply(r: Reflection2D, v: Vector2D): Vector2D
        => Transform(v, r);

    // A reflection is an involution: it undoes itself.
    Inverse(r: Reflection2D): Reflection2D
        => r;

    // The mirror as an affine map: translate the mirror's origin to the world
    // origin, reflect the basis, translate back.
    AffineTransform3D(r: Reflection3D): AffineTransform3D {
        var o = r.Origin.PositionVector;
        var n = r.Normal.Vector;
        var x = Vector3D(1.0, 0.0, 0.0).Reflect(n);
        var y = Vector3D(0.0, 1.0, 0.0).Reflect(n);
        var z = Vector3D(0.0, 0.0, 1.0).Reflect(n);
        var linear = AffineTransform3D(Matrix4x3(
            Number3(x.X, x.Y, x.Z),
            Number3(y.X, y.Y, y.Z),
            Number3(z.X, z.Y, z.Z),
            Number3(0.0, 0.0, 0.0)));
        return Matrix4x4.CreateTranslation(-o).AffineTransform3D
            .Compose(linear)
            .Compose(Matrix4x4.CreateTranslation(o).AffineTransform3D);
    }

    // Mirror the point in the plane: reflect its offset from the plane's origin.
    Transform(p: Point3D, r: Reflection3D): Point3D
        => r.Origin + r.Origin.Between(p).Transform(r);

    // Alias for Transform with transform-on-left (* operator): r * p.
    Multiply(r: Reflection3D, p: Point3D): Point3D
        => Transform(p, r);

    // Mirror the displacement in the plane's normal (a reflection is linear, so
    // it does act on displacements).
    Transform(v: Vector3D, r: Reflection3D): Vector3D
        => v.Reflect(r.Normal.Vector);

    // Alias for Transform with transform-on-left (* operator): r * v.
    Multiply(r: Reflection3D, v: Vector3D): Vector3D
        => Transform(v, r);

    // A reflection is an involution: it undoes itself.
    Inverse(r: Reflection3D): Reflection3D
        => r;

    //==
    // About-a-centre transforms — a rotation or a scaling conjugated by the
    // translation of its centre. The linear part is unaffected by the centre, so
    // their action on displacements is the centre-free one.

    // The rotation about the centre as an affine map.
    AffineTransform2D(r: RotationAbout2D): AffineTransform2D
        => AffineTransform2D(Matrix3x2.CreateRotation(r.Rotation.Angle, r.Center));

    // Rotate the point about the centre.
    Transform(p: Point2D, r: RotationAbout2D): Point2D
        => r.Center + r.Center.Between(p).Transform(r.Rotation);

    // Alias for Transform with transform-on-left (* operator): r * p.
    Multiply(r: RotationAbout2D, p: Point2D): Point2D
        => Transform(p, r);

    // Rotate the displacement (the centre does not act on displacements).
    Transform(v: Vector2D, r: RotationAbout2D): Vector2D
        => v.Transform(r.Rotation);

    // Alias for Transform with transform-on-left (* operator): r * v.
    Multiply(r: RotationAbout2D, v: Vector2D): Vector2D
        => Transform(v, r);

    // The opposite rotation about the same centre.
    Inverse(r: RotationAbout2D): RotationAbout2D
        => (r.Rotation.Inverse, r.Center);

    // The zero rotation about the origin.
    Identity(_: RotationAbout2D): RotationAbout2D
        => (Rotation2D.Identity, Point2D.Origin);

    // The rotation about the centre as an affine map: translate the centre to
    // the world origin, rotate, translate back.
    AffineTransform3D(r: RotationAbout3D): AffineTransform3D {
        var c = r.Center.PositionVector;
        return Matrix4x4.CreateTranslation(-c).AffineTransform3D
            .Compose(r.Rotation.AffineTransform3D)
            .Compose(Matrix4x4.CreateTranslation(c).AffineTransform3D);
    }

    // Rotate the point about the centre.
    Transform(p: Point3D, r: RotationAbout3D): Point3D
        => r.Center + r.Center.Between(p).Transform(r.Rotation);

    // Alias for Transform with transform-on-left (* operator): r * p.
    Multiply(r: RotationAbout3D, p: Point3D): Point3D
        => Transform(p, r);

    // Rotate the displacement (the centre does not act on displacements).
    Transform(v: Vector3D, r: RotationAbout3D): Vector3D
        => v.Transform(r.Rotation);

    // Alias for Transform with transform-on-left (* operator): r * v.
    Multiply(r: RotationAbout3D, v: Vector3D): Vector3D
        => Transform(v, r);

    // The opposite rotation about the same centre.
    Inverse(r: RotationAbout3D): RotationAbout3D
        => (r.Rotation.Inverse, r.Center);

    // The zero rotation about the origin.
    Identity(_: RotationAbout3D): RotationAbout3D
        => (Quaternion.Identity, Point3D.Origin);

    // The scaling about the centre as an affine map.
    AffineTransform2D(s: ScalingAbout2D): AffineTransform2D
        => AffineTransform2D(Matrix3x2.CreateScale(s.Amount, s.Center));

    // Scale the point's offset from the centre per axis.
    Transform(p: Point2D, s: ScalingAbout2D): Point2D
        => s.Center + s.Center.Between(p) * s.Amount;

    // Alias for Transform with transform-on-left (* operator): s * p.
    Multiply(s: ScalingAbout2D, p: Point2D): Point2D
        => Transform(p, s);

    // Scale the displacement per axis (the centre does not act on
    // displacements).
    Transform(v: Vector2D, s: ScalingAbout2D): Vector2D
        => v * s.Amount;

    // Alias for Transform with transform-on-left (* operator): s * v.
    Multiply(s: ScalingAbout2D, v: Vector2D): Vector2D
        => Transform(v, s);

    // The reciprocal scaling about the same centre. Precondition: no component
    // of Amount is zero.
    Inverse(s: ScalingAbout2D): ScalingAbout2D
        => (Number2(1.0 / s.Amount.X, 1.0 / s.Amount.Y), s.Center);

    // The unit scaling about the origin.
    Identity(_: ScalingAbout2D): ScalingAbout2D
        => (Number2.One, Point2D.Origin);

    // The scaling about the centre as an affine map: translate the centre to the
    // world origin, scale, translate back.
    AffineTransform3D(s: ScalingAbout3D): AffineTransform3D {
        var c = s.Center.PositionVector;
        return Matrix4x4.CreateTranslation(-c).AffineTransform3D
            .Compose(Matrix4x4.CreateScale(s.Amount).AffineTransform3D)
            .Compose(Matrix4x4.CreateTranslation(c).AffineTransform3D);
    }

    // Scale the point's offset from the centre per axis.
    Transform(p: Point3D, s: ScalingAbout3D): Point3D
        => s.Center + s.Center.Between(p) * s.Amount;

    // Alias for Transform with transform-on-left (* operator): s * p.
    Multiply(s: ScalingAbout3D, p: Point3D): Point3D
        => Transform(p, s);

    // Scale the displacement per axis (the centre does not act on
    // displacements).
    Transform(v: Vector3D, s: ScalingAbout3D): Vector3D
        => v * s.Amount;

    // Alias for Transform with transform-on-left (* operator): s * v.
    Multiply(s: ScalingAbout3D, v: Vector3D): Vector3D
        => Transform(v, s);

    // The reciprocal scaling about the same centre. Precondition: no component
    // of Amount is zero.
    Inverse(s: ScalingAbout3D): ScalingAbout3D
        => (Number3(1.0 / s.Amount.X, 1.0 / s.Amount.Y, 1.0 / s.Amount.Z), s.Center);

    // The unit scaling about the origin.
    Identity(_: ScalingAbout3D): ScalingAbout3D
        => (Number3.One, Point3D.Origin);

    //==
    // Aiming — the rotation that points an object along a direction.

    // The rotation that aims local -Z along `forward` with local +Y as close to
    // `up` as possible, matching the view-space frame of
    // CONVENTIONS.md - View space. Built from the CreateWorld basis so the
    // handedness is stated in exactly one place. Preconditions (unchecked):
    // `forward` and `up` are not parallel.
    LookRotation(forward: Direction3D, up: Direction3D): Quaternion
        => Matrix4x4.CreateWorld(Point3D.Origin, forward.Vector, up.Vector).Quaternion;

    //==
    // # Frame and basis operations
    //
    // Matrix interchange between the coordinate frames of `transforms.types.plato`
    // and the rigid poses they are equivalent to, plus the basis of a rotation.

    //==
    // Frames and bases — orthonormal frames are rigid poses in matrix-friendly
    // clothing: the axes are the rotation, the origin is the translation.

    // The affine matrix mapping frame-local coordinates to world coordinates
    // (axes become the linear rows, the origin the translation row).
    Matrix3x2(f: Frame2D): Matrix3x2
        => (Number2(f.XAxis.Vector.X, f.XAxis.Vector.Y),
            Number2(f.YAxis.Vector.X, f.YAxis.Vector.Y),
            Number2(f.Origin.X, f.Origin.Y));

    // The frame of a rigid pose: the pose's rotated unit axes at its position.
    Frame2D(pose: Pose2D): Frame2D {
        var x = Vector2D(1.0, 0.0).Transform(pose.Rotation);
        var y = Vector2D(0.0, 1.0).Transform(pose.Rotation);
        return (pose.Position, Direction2D(x), Direction2D(y));
    }

    // The rigid pose of a frame. Precondition: the axes are orthonormal and
    // right-handed.
    Pose2D(f: Frame2D): Pose2D
        => f.Matrix3x2.Pose2D;

    // Any frame is affine: its frame-local-to-world matrix is the affine map.
    AffineTransform2D(f: Frame2D): AffineTransform2D
        => AffineTransform2D(f.Matrix3x2);

    // The homogeneous matrix mapping frame-local coordinates to world
    // coordinates.
    Matrix4x4(f: Frame3D): Matrix4x4 {
        var x = f.XAxis.Vector;
        var y = f.YAxis.Vector;
        var z = f.ZAxis.Vector;
        var o = f.Origin;
        return (Number4(x.X, x.Y, x.Z, 0.0),
                Number4(y.X, y.Y, y.Z, 0.0),
                Number4(z.X, z.Y, z.Z, 0.0),
                Number4(o.X, o.Y, o.Z, 1.0));
    }

    // The frame of a rigid pose: the pose's rotated unit axes at its position.
    Frame3D(pose: Pose3D): Frame3D {
        var q = pose.Orientation;
        var x = Vector3D(1.0, 0.0, 0.0).Transform(q);
        var y = Vector3D(0.0, 1.0, 0.0).Transform(q);
        var z = Vector3D(0.0, 0.0, 1.0).Transform(q);
        return (pose.Position, Direction3D(x), Direction3D(y), Direction3D(z));
    }

    // The rigid pose of a frame. Precondition: the axes are orthonormal and
    // right-handed.
    Pose3D(f: Frame3D): Pose3D
        => f.Matrix4x4.Pose3D;

    // Any frame is affine: its frame-local-to-world matrix is the affine map.
    AffineTransform3D(f: Frame3D): AffineTransform3D
        => f.Matrix4x4.AffineTransform3D;

    // The world-axis images under a rotation: the columns of its rotation
    // matrix as a (generally orthonormal) basis.
    Basis3D(q: Quaternion): Basis3D
        => (Vector3D(1.0, 0.0, 0.0).Transform(q),
            Vector3D(0.0, 1.0, 0.0).Transform(q),
            Vector3D(0.0, 0.0, 1.0).Transform(q));

    // The linear map that sends the world axes to the basis vectors; the
    // translation row is zero, since a basis carries no origin.
    AffineTransform3D(b: Basis3D): AffineTransform3D
        => AffineTransform3D(Matrix4x3(
            Number3(b.X.X, b.X.Y, b.X.Z),
            Number3(b.Y.X, b.Y.Y, b.Y.Z),
            Number3(b.Z.X, b.Z.Y, b.Z.Z),
            Number3(0.0, 0.0, 0.0)));

    //==
    // # Transform identity statics
    //
    // The do-nothing transform of every representation in the transform family,
    // gathered in one place so the identity of a rotation, a pose, a TRS transform,
    // a matrix, an affine map, or a projective map is found by the same lookup.

    //==
    // Identity statics — the do-nothing transform of each representation,
    // reachable as `Type.Identity` via the `_: Type` static convention.

    // The zero rotation.
    Identity(_: Rotation2D): Rotation2D
        => Rotation2D(0.0.Angle);

    // The identity rotor (scalar 1, no bivector part).
    Identity(_: Rotor2D): Rotor2D
        => (1.0, 0.0);

    // The identity quaternion (0, 0, 0, 1).
    Identity(_: Quaternion): Quaternion
        => (0.0, 0.0, 0.0, 1.0);

    // The identity rotor (scalar 1, no bivector part).
    Identity(_: Rotor3D): Rotor3D
        => (1.0, Bivector3D(0.0, 0.0, 0.0));

    // The identity motor (identity rotation, zero translation).
    Identity(_: Motor3D): Motor3D
        => (Quaternion.Identity, Quaternion(0.0, 0.0, 0.0, 0.0));

    // The pose at the origin with no rotation.
    Identity(_: Pose2D): Pose2D
        => (Point2D.Origin, Rotation2D.Identity);

    // The pose at the origin with no rotation.
    Identity(_: Pose3D): Pose3D
        => (Point3D.Origin, Quaternion.Identity);

    // The TRS transform that leaves everything unchanged.
    Identity(_: TrsTransform2D): TrsTransform2D
        => (Vector2D.Zero, Rotation2D.Identity, Number2.One);

    // The TRS transform that leaves everything unchanged.
    Identity(_: TrsTransform3D): TrsTransform3D
        => (Vector3D.Zero, Quaternion.Identity, Number3.One);

    // The identity 2D affine map.
    Identity(_: Matrix3x2): Matrix3x2
        => (Number2(1.0, 0.0), Number2(0.0, 1.0), Number2(0.0, 0.0));

    // The identity 3x3 matrix.
    Identity(_: Matrix3x3): Matrix3x3
        => (Number3(1.0, 0.0, 0.0), Number3(0.0, 1.0, 0.0), Number3(0.0, 0.0, 1.0));

    // The identity 3D affine map.
    Identity(_: Matrix4x3): Matrix4x3
        => (Number3(1.0, 0.0, 0.0), Number3(0.0, 1.0, 0.0), Number3(0.0, 0.0, 1.0), Number3(0.0, 0.0, 0.0));

    // The identity 4x4 matrix.
    Identity(_: Matrix4x4): Matrix4x4
        => (Number4(1.0, 0.0, 0.0, 0.0), Number4(0.0, 1.0, 0.0, 0.0), Number4(0.0, 0.0, 1.0, 0.0), Number4(0.0, 0.0, 0.0, 1.0));

    // The identity 2D affine transform.
    Identity(_: AffineTransform2D): AffineTransform2D
        => AffineTransform2D(Matrix3x2.Identity);

    // The identity 3D affine transform.
    Identity(_: AffineTransform3D): AffineTransform3D
        => AffineTransform3D(Matrix4x3.Identity);

    // The identity 2D projective transform.
    Identity(_: Transform2D): Transform2D
        => Transform2D(Matrix3x3.Identity);

    // The identity 3D projective transform.
    Identity(_: Transform3D): Transform3D
        => Transform3D(Matrix4x4.Identity);

    //==
    // # Motor operations
    //
    // Construction, the dual-quaternion product, inversion, normalization, and
    // application for the rigid-motion motors of `transforms.types.plato`.

    //==
    // Motors — rigid motions in dual-quaternion form. IReal carries the
    // rotation; Dual = 0.5 * t * IReal carries the translation t (all products
    // Hamilton). https://en.wikipedia.org/wiki/Dual_quaternion

    // The motor of a rigid pose.
    Motor3D(pose: Pose3D): Motor3D {
        var q = pose.Orientation;
        var t = Quaternion(pose.Position.X, pose.Position.Y, pose.Position.Z, 0.0);
        return (q, t * q * 0.5);
    }

    // The pose of a motor: rotation from the real part, translation
    // t = 2 * Dual * conjugate(IReal).
    Pose3D(m: Motor3D): Pose3D {
        var q = m.Real.Normalize;
        var t = m.Dual * 2.0 * q.Conjugate;
        return (Point3D(t.X, t.Y, t.Z), q);
    }

    // A pure rotation as a motor (zero translation).
    Motor3D(q: Quaternion): Motor3D
        => (q, Quaternion(0.0, 0.0, 0.0, 0.0));

    // A rotor's rotation as a motor.
    Motor3D(r: Rotor3D): Motor3D
        => r.Quaternion.Motor3D;

    // A pure translation as a motor (identity rotation).
    CreateTranslation(_: Motor3D, v: Vector3D): Motor3D
        => (Quaternion.Identity, Quaternion(v.X * 0.5, v.Y * 0.5, v.Z * 0.5, 0.0));

    // The dual-quaternion product: like the quaternion Hamilton product,
    // a.Multiply(b) is the motion b followed by a. Use Compose for
    // first-then-second ordering.
    Multiply(a: Motor3D, b: Motor3D): Motor3D
        => (a.Real * b.Real, a.Real * b.Dual + a.Dual * b.Real);

    // The motor that applies `first`, then `second`.
    Compose(first: Motor3D, second: Motor3D): Motor3D
        => second * first;

    // The motor that undoes this one (the dual-quaternion conjugate; an
    // inverse for unit motors).
    Inverse(m: Motor3D): Motor3D
        => (m.Real.Conjugate, m.Dual.Conjugate);

    // Rescale so the real part has unit magnitude, restoring the motor
    // invariant after repeated products. Precondition: the real part is not
    // zero.
    Normalize(m: Motor3D): Motor3D {
        var scale = 1.0 / m.Real.Length;
        return (m.Real * scale, m.Dual * scale);
    }

    // Apply the motor's rigid motion to a point.
    Transform(p: Point3D, m: Motor3D): Point3D
        => p.Transform(m.Pose3D);

    // Alias for Transform with transform-on-left (* operator): m * p.
    Multiply(m: Motor3D, p: Point3D): Point3D
        => Transform(p, m);

    // Rotate a displacement by the motor's rotation (translation does not act
    // on vectors).
    Transform(v: Vector3D, m: Motor3D): Vector3D
        => v.Transform(m.Real);

    // Alias for Transform with transform-on-left (* operator): m * v.
    Multiply(m: Motor3D, v: Vector3D): Vector3D
        => Transform(v, m);

    // The homogeneous matrix of the motor's rigid motion.
    Matrix4x4(m: Motor3D): Matrix4x4
        => m.Pose3D.Matrix4x4;

    //==
    // # Point support
    //
    // The IDifference obligations of Point2D/Point3D, point interpolation, and the
    // explicit point <-> vector converters that every other transform library builds
    // on. Kept separate from the representations because nothing here depends on a
    // transform type.

    //==
    // Point support — the IOriginBased conversions of Point2D/Point3D/PointN, and
    // the explicit point <-> vector converters spelled in the direction callers
    // read them.
    //
    // NOTHING else is written here. Add, Between, Subtract (both spellings) and
    // Lerp are all derived from Offset and FromOffset via algebra.library.plato.
    // The converters remain deliberately named
    // rather than implicit conversions: silently coercing between positions and
    // displacements would defeat the point of keeping them distinct types.

    // The point's displacement from the origin.
    Offset(p: Point2D): Vector2D
        => (p.X, p.Y);

    // The point at the given displacement from the origin.
    FromOffset(_: Point2D, v: Vector2D): Point2D
        => (v.X, v.Y);

    // The point's displacement from the origin.
    Offset(p: Point3D): Vector3D
        => (p.X, p.Y, p.Z);

    // The point at the given displacement from the origin.
    FromOffset(_: Point3D, v: Vector3D): Point3D
        => (v.X, v.Y, v.Z);

    // The point's displacement from the origin. Arity is carried by the
    // component array, so no separate arity argument is needed.
    // Written as an explicit construction, not a parenthesized value: the single field is an
    // Array, and a C# backend cannot declare the implicit conversion for an interface-typed
    // field (CS0552), so the structural form has nothing to convert through.
    Offset(p: PointN): VectorN
        => VectorN(p.Components);

    // The point at the given displacement from the origin, of the delta's arity.
    FromOffset(_: PointN, v: VectorN): PointN
        => PointN(v.Components);

    //==
    // The named point <-> vector converters. These are the long-standing spelling
    // (curves-shapes.library.plato and the transform libraries call PositionVector);
    // they now delegate to the IOriginBased conversions rather than restating the
    // field copy, so there is one place where a point becomes a vector.
    // ToPoint reads in the opposite direction from FromOffset — it dispatches on
    // the VECTOR, which is what callers holding a vector want.

    // The point's displacement from the origin.
    PositionVector(p: Point2D): Vector2D
        => p.Offset;

    // The point's displacement from the origin.
    PositionVector(p: Point3D): Vector3D
        => p.Offset;

    // The point at the tip of the vector, placed from the origin.
    ToPoint(v: Vector2D): Point2D
        => (v.X, v.Y);

    // The point at the tip of the vector, placed from the origin.
    ToPoint(v: Vector3D): Point3D
        => (v.X, v.Y, v.Z);

    //==
    // # Rigid pose operations
    //
    // Application, composition, inversion, interpolation, and matrix interchange for
    // the rigid poses of `transforms.types.plato`.

    //==
    // Rigid poses — position plus rotation; the natural "where is this object"
    // transform. https://en.wikipedia.org/wiki/Rigid_transformation

    // Apply the pose: rotate about the origin, then translate to Position.
    Transform(p: Point2D, pose: Pose2D): Point2D
        => pose.Position + p.PositionVector.Transform(pose.Rotation);

    // Alias for Transform with transform-on-left (* operator): pose * p.
    Multiply(pose: Pose2D, p: Point2D): Point2D
        => Transform(p, pose);

    // Rotate a displacement by the pose's rotation (translation does not act
    // on vectors).
    Transform(v: Vector2D, pose: Pose2D): Vector2D
        => v.Transform(pose.Rotation);

    // Alias for Transform with transform-on-left (* operator): pose * v.
    Multiply(pose: Pose2D, v: Vector2D): Vector2D
        => Transform(v, pose);

    // The pose that applies `first`, then `second`.
    Compose(first: Pose2D, second: Pose2D): Pose2D
        => (first.Position.Transform(second), first.Rotation * second.Rotation);

    // Alias for Compose, enabling the * operator: a * b applies a first.
    Multiply(a: Pose2D, b: Pose2D): Pose2D
        => a.Compose(b);

    // The pose that undoes this one: p' = R^-1 (p - t).
    Inverse(pose: Pose2D): Pose2D {
        var invRot = pose.Rotation.Inverse;
        return (pose.Position.PositionVector.Negative.Transform(invRot).ToPoint, invRot);
    }

    // Interpolate position and rotation independently; t is unclamped.
    Lerp(a: Pose2D, b: Pose2D, t: Number): Pose2D
        => (a.Position.Lerp(b.Position, t), a.Rotation.Lerp(b.Rotation, t));

    // The affine matrix of the pose (rotation, then translation).
    Matrix3x2(pose: Pose2D): Matrix3x2
        => pose.Rotation.Matrix3x2 * Matrix3x2.CreateTranslation(pose.Position.PositionVector);

    // The pose stored in a rigid affine matrix. Precondition: the matrix is a
    // rotation followed by a translation (no scale, shear, or reflection).
    Pose2D(m: Matrix3x2): Pose2D
        => (Point2D(m.Row3.X, m.Row3.Y), Rotation2D(m.Row1.Y.Atan2(m.Row1.X)));

    // Apply the pose: rotate about the origin, then translate to Position.
    Transform(p: Point3D, pose: Pose3D): Point3D
        => pose.Position + p.PositionVector.Transform(pose.Orientation);

    // Alias for Transform with transform-on-left (* operator): pose * p.
    Multiply(pose: Pose3D, p: Point3D): Point3D
        => Transform(p, pose);

    // Rotate a displacement by the pose's orientation.
    Transform(v: Vector3D, pose: Pose3D): Vector3D
        => v.Transform(pose.Orientation);

    // Alias for Transform with transform-on-left (* operator): pose * v.
    Multiply(pose: Pose3D, v: Vector3D): Vector3D
        => Transform(v, pose);

    // The pose that applies `first`, then `second`.
    Compose(first: Pose3D, second: Pose3D): Pose3D
        => (first.Position.Transform(second), first.Orientation.Concatenate(second.Orientation));

    // Alias for Compose, enabling the * operator: a * b applies a first.
    Multiply(a: Pose3D, b: Pose3D): Pose3D
        => a.Compose(b);

    // The pose that undoes this one: p' = R^-1 (p - t).
    Inverse(pose: Pose3D): Pose3D {
        var invQ = pose.Orientation.Inverse;
        return (pose.Position.PositionVector.Negative.Transform(invQ).ToPoint, invQ);
    }

    // Interpolate position linearly and orientation spherically; t is unclamped.
    Lerp(a: Pose3D, b: Pose3D, t: Number): Pose3D
        => (a.Position.Lerp(b.Position, t), a.Orientation.Slerp(b.Orientation, t));

    // The homogeneous matrix of the pose (rotation, then translation).
    Matrix4x4(pose: Pose3D): Matrix4x4
        => pose.Orientation.Matrix4x4 * Matrix4x4.CreateTranslation(pose.Position.PositionVector);

    // The pose stored in a rigid homogeneous matrix. Precondition: the matrix
    // is a rotation followed by a translation (no scale, shear, or projection).
    Pose3D(m: Matrix4x4): Pose3D
        => (m.Translation.ToPoint, m.Rotation);

    //==
    // Rigid conversions — the Pose obligations of `IRigid2D` / `IRigid3D`. Each
    // rigid representation names the pose it is: a translation is a pose with
    // the identity rotation, a rotation is a pose at the origin, a
    // rotation-about-a-centre is the conjugation of the two. Composition and
    // inversion of any two rigid transforms stay inside the family, which is
    // what the interface buys over IAffine2D/IAffine3D.

    // A translation is the pose at that offset with no rotation.
    Pose2D(t: Translation2D): Pose2D
        => (t.Vector.ToPoint, Rotation2D.Identity);

    // A translation is the pose at that offset with no rotation.
    Pose3D(t: Translation3D): Pose3D
        => (t.Vector.ToPoint, Quaternion.Identity);

    // A plane rotation is the pose at the origin with that rotation.
    Pose2D(r: Rotation2D): Pose2D
        => (Point2D.Origin, r);

    // A quaternion is the pose at the origin with that orientation.
    Pose3D(q: Quaternion): Pose3D
        => (Point3D.Origin, q);

    // Any 3D rotation representation is the pose at the origin with its
    // quaternion; this one body serves AxisAngle, EulerAngles and Rotor3D.
    Pose3D(r: IRotational3D): Pose3D
        => r.Quaternion.Pose3D;

    // Rotating about a centre: translate the centre to the origin, rotate,
    // translate back.
    Pose2D(r: RotationAbout2D): Pose2D {
        var c = r.Center.PositionVector;
        return ((c - c.Transform(r.Rotation)).ToPoint, r.Rotation);
    }

    // Rotating about a centre: translate the centre to the origin, rotate,
    // translate back.
    Pose3D(r: RotationAbout3D): Pose3D {
        var c = r.Center.PositionVector;
        return ((c - c.Transform(r.Rotation)).ToPoint, r.Rotation);
    }

    // Any rigid transform is affine, through the pose it names. Concrete
    // conversions on the individual types take precedence over this one.
    AffineTransform2D(x: IRigid2D): AffineTransform2D
        => x.Pose2D.AffineTransform2D;

    // Any rigid transform is affine, through the pose it names.
    AffineTransform3D(x: IRigid3D): AffineTransform3D
        => x.Pose3D.AffineTransform3D;

    // Rigid transforms are closed under composition: apply `first`, then
    // `second`, with no matrix round-trip and no drift out of the family.
    Compose(first: IRigid2D, second: IRigid2D): Pose2D
        => first.Pose2D.Compose(second.Pose2D);

    // Rigid transforms are closed under composition: apply `first`, then
    // `second`.
    Compose(first: IRigid3D, second: IRigid3D): Pose3D
        => first.Pose3D.Compose(second.Pose3D);

    //==
    // # Rotation operations and conversions
    //
    // Application, composition, inversion, and interchange for every rotation
    // representation declared in `rotations.types.plato` — Rotation2D, Rotor2D,
    // Quaternion, AxisAngle, EulerAngles, Rotor3D — together with their embeddings
    // into the affine and homogeneous matrices. Quaternion is the hub: every 3D
    // representation converts to and from it, so all pairs compose through it.

    //==
    // 2D rotations — Rotation2D is the angle form, Rotor2D the geometric-algebra
    // form (a unit complex number built from the half angle).
    // https://en.wikipedia.org/wiki/Rotation_matrix

    // Composition of two plane rotations: angles add (2D rotations commute).
    Multiply(a: Rotation2D, b: Rotation2D): Rotation2D
        => Rotation2D(a.Angle + b.Angle);

    // The opposite rotation.
    Inverse(a: Rotation2D): Rotation2D
        => Rotation2D(-a.Angle);

    // Linear interpolation of the stored angles; t is unclamped. Takes the
    // stored-angle path, not the shortest arc: interpolate raw angles when the
    // operands differ by more than a half turn.
    Lerp(a: Rotation2D, b: Rotation2D, t: Number): Rotation2D
        => Rotation2D(a.Angle + (b.Angle - a.Angle) * t);

    // Rotate a displacement counter-clockwise by the rotation's angle:
    // (x cos - y sin, x sin + y cos).
    Transform(v: Vector2D, r: Rotation2D): Vector2D {
        var c = r.Angle.Cos;
        var s = r.Angle.Sin;
        return (v.X * c - v.Y * s, v.X * s + v.Y * c);
    }

    // Alias for Transform with transform-on-left (* operator): r * v.
    Multiply(r: Rotation2D, v: Vector2D): Vector2D
        => Transform(v, r);

    // Rotate a point about the origin.
    Transform(p: Point2D, r: Rotation2D): Point2D
        => p.PositionVector.Transform(r).ToPoint;

    // Alias for Transform with transform-on-left (* operator): r * p.
    Multiply(r: Rotation2D, p: Point2D): Point2D
        => Transform(p, r);

    // Rotate a unit direction.
    Transform(d: Direction2D, r: Rotation2D): Direction2D
        => Direction2D(d.Vector.Transform(r));

    // Alias for Transform with transform-on-left (* operator): r * d.
    Multiply(r: Rotation2D, d: Direction2D): Direction2D
        => Transform(d, r);

    // The rotor of a plane rotation: R = cos(a/2) + sin(a/2) e12.
    // https://en.wikipedia.org/wiki/Rotor_(mathematics)
    Rotor2D(r: Rotation2D): Rotor2D {
        var h = r.Angle * 0.5;
        return (h.Cos, h.Sin);
    }

    // The angle form of a rotor (twice the half angle stored in the rotor).
    Rotation2D(r: Rotor2D): Rotation2D
        => Rotation2D(r.XY.Atan2(r.Scalar) * 2.0);

    // The geometric product of two rotors (complex multiplication); the result
    // rotates by the sum of the operands' angles.
    Multiply(a: Rotor2D, b: Rotor2D): Rotor2D
        => (a.Scalar * b.Scalar - a.XY * b.XY, a.Scalar * b.XY + a.XY * b.Scalar);

    // The reverse of the rotor: the opposite rotation (for a unit rotor the
    // reverse is the inverse).
    Inverse(r: Rotor2D): Rotor2D
        => (r.Scalar, -r.XY);

    // Rescale to unit magnitude, restoring the rotor invariant after repeated
    // products. Precondition: the rotor is not the zero element.
    Normalize(r: Rotor2D): Rotor2D {
        var m = (r.Scalar.Square + r.XY.Square).Sqrt;
        return (r.Scalar / m, r.XY / m);
    }

    // Apply the rotor's sandwich product R v ~R: a rotation by the full angle,
    // via the double-angle identities cos a = s^2 - b^2, sin a = 2 s b.
    Transform(v: Vector2D, r: Rotor2D): Vector2D {
        var c = r.Scalar.Square - r.XY.Square;
        var s = 2.0 * r.Scalar * r.XY;
        return (v.X * c - v.Y * s, v.X * s + v.Y * c);
    }

    // Alias for Transform with transform-on-left (* operator): r * v.
    Multiply(r: Rotor2D, v: Vector2D): Vector2D
        => Transform(v, r);

    // Rotate a point about the origin with a rotor.
    Transform(p: Point2D, r: Rotor2D): Point2D
        => p.PositionVector.Transform(r).ToPoint;

    // Alias for Transform with transform-on-left (* operator): r * p.
    Multiply(r: Rotor2D, p: Point2D): Point2D
        => Transform(p, r);

    //==
    // 3D rotation conversions — Quaternion is the hub: every other rotation
    // representation converts to and from it, so all pairs compose through it.
    // https://en.wikipedia.org/wiki/Quaternions_and_spatial_rotation

    // The elemental rotation about the world X axis.
    CreateRotationX(_: Quaternion, angle: Angle): Quaternion
        => Quaternion.CreateFromAxisAngle(Vector3D.UnitX, angle);

    // The elemental rotation about the world Y axis.
    CreateRotationY(_: Quaternion, angle: Angle): Quaternion
        => Quaternion.CreateFromAxisAngle(Vector3D.UnitY, angle);

    // The elemental rotation about the world Z axis.
    CreateRotationZ(_: Quaternion, angle: Angle): Quaternion
        => Quaternion.CreateFromAxisAngle(Vector3D.UnitZ, angle);

    // The quaternion of an axis-angle rotation.
    // https://en.wikipedia.org/wiki/Axis%E2%80%93angle_representation
    Quaternion(aa: AxisAngle): Quaternion
        => Quaternion.CreateFromAxisAngle(aa.Axis.Vector, aa.Angle);

    // The axis-angle form of a quaternion: angle = 2 acos(w), axis = the
    // normalized vector part. Near the identity the axis is arbitrary and the
    // world X axis is returned.
    AxisAngle(q: Quaternion): AxisAngle {
        var n = q.Normalize;
        var s = (1.0 - n.W.Square).Max(0.0).Sqrt;
        var axis = s < 0.000001
            ? Vector3D.UnitX
            : Vector3D(n.X / s, n.Y / s, n.Z / s);
        return (Direction3D(axis), n.W.Clamp(-1.0, 1.0).Acos * 2.0);
    }

    // Chain three elemental rotations in the given application order (the
    // first-listed axis applies first, about fixed world axes). The receiver
    // is the order because the TIR body writer currently grounds a match only
    // when its subject is a bare parameter.
    ChainRotations(order: RotationOrder, aboutX: Quaternion, aboutY: Quaternion, aboutZ: Quaternion): Quaternion =>
        match (order) {
            XYZ => aboutX.Concatenate(aboutY).Concatenate(aboutZ);
            XZY => aboutX.Concatenate(aboutZ).Concatenate(aboutY);
            YXZ => aboutY.Concatenate(aboutX).Concatenate(aboutZ);
            YZX => aboutY.Concatenate(aboutZ).Concatenate(aboutX);
            ZXY => aboutZ.Concatenate(aboutX).Concatenate(aboutY);
            ZYX => aboutZ.Concatenate(aboutY).Concatenate(aboutX);
        };

    // The quaternion of chained elemental rotations, honoring the explicit
    // application order. X carries Pitch, Y carries Yaw, Z carries Roll.
    Quaternion(e: EulerAngles): Quaternion =>
        e.Order.ChainRotations(
            Quaternion.CreateRotationX(e.Pitch),
            Quaternion.CreateRotationY(e.Yaw),
            Quaternion.CreateRotationZ(e.Roll));

    // The yaw-pitch-roll decomposition of a quaternion, in ZXY order (roll,
    // then pitch, then yaw — the order CreateFromYawPitchRoll applies). At the
    // gimbal-lock poles (pitch = +-90 degrees) yaw and roll are not unique.
    // https://en.wikipedia.org/wiki/Conversion_between_quaternions_and_Euler_angles
    EulerAngles(q: Quaternion): EulerAngles {
        var n = q.Normalize;
        var pitch = (2.0 * (n.W * n.X - n.Y * n.Z)).Clamp(-1.0, 1.0).Asin;
        var yaw = (2.0 * (n.X * n.Z + n.W * n.Y)).Atan2(1.0 - 2.0 * (n.X.Square + n.Y.Square));
        var roll = (2.0 * (n.X * n.Y + n.W * n.Z)).Atan2(1.0 - 2.0 * (n.X.Square + n.Z.Square));
        return (yaw, pitch, roll, RotationOrder.ZXY);
    }

    // The quaternion of a rotor, under the isomorphism (w, x, y, z) =
    // (Scalar, YZ, ZX, XY): each bivector plane maps to the quaternion unit
    // whose axis is perpendicular to it.
    Quaternion(r: Rotor3D): Quaternion
        => (r.Bivector.YZ, r.Bivector.ZX, r.Bivector.XY, r.Scalar);

    // The rotor of a quaternion (the inverse of the isomorphism above).
    Rotor3D(q: Quaternion): Rotor3D
        => (q.W, Bivector3D(q.X, q.Y, q.Z));

    // The rotor of an axis-angle rotation.
    Rotor3D(aa: AxisAngle): Rotor3D
        => aa.Quaternion.Rotor3D;

    // The geometric product of two rotors: the image of the Hamilton product
    // under the quaternion isomorphism, so a.Multiply(b) applies b first.
    Multiply(a: Rotor3D, b: Rotor3D): Rotor3D
        => (a.Quaternion * b.Quaternion).Rotor3D;

    // The reverse of the rotor: the opposite rotation (for a unit rotor the
    // reverse is the inverse).
    Inverse(r: Rotor3D): Rotor3D
        => (r.Scalar, Bivector3D(-r.Bivector.YZ, -r.Bivector.ZX, -r.Bivector.XY));

    // Rescale to unit magnitude, restoring the rotor invariant after repeated
    // products.
    Normalize(r: Rotor3D): Rotor3D
        => r.Quaternion.Normalize.Rotor3D;

    // Apply the rotor's sandwich product R v ~R.
    Transform(v: Vector3D, r: Rotor3D): Vector3D
        => v.Transform(r.Quaternion);

    // Alias for Transform with transform-on-left (* operator): r * v.
    Multiply(r: Rotor3D, v: Vector3D): Vector3D
        => Transform(v, r);

    // Rotate a point about the origin with a rotor.
    Transform(p: Point3D, r: Rotor3D): Point3D
        => p.PositionVector.Transform(r.Quaternion).ToPoint;

    // Alias for Transform with transform-on-left (* operator): r * p.
    Multiply(r: Rotor3D, p: Point3D): Point3D
        => Transform(p, r);

    // Rotate a point about the origin with a quaternion.
    Transform(p: Point3D, q: Quaternion): Point3D
        => p.PositionVector.Transform(q).ToPoint;

    // Alias for Transform with transform-on-left (* operator): q * p.
    Multiply(q: Quaternion, p: Point3D): Point3D
        => Transform(p, q);

    // Rotate a unit direction.
    Transform(d: Direction3D, q: Quaternion): Direction3D
        => Direction3D(d.Vector.Transform(q));

    // Alias for Transform with transform-on-left (* operator): q * d.
    Multiply(q: Quaternion, d: Direction3D): Direction3D
        => Transform(d, q);

    //==
    // Rotation matrices — 2D rotations embed in Matrix3x2, 3D rotations in
    // Matrix4x4. https://en.wikipedia.org/wiki/Rotation_matrix

    // The affine matrix of a plane rotation about the origin.
    Matrix3x2(r: Rotation2D): Matrix3x2
        => Matrix3x2.CreateRotation(r.Angle);

    // The affine matrix of a rotor's rotation.
    Matrix3x2(r: Rotor2D): Matrix3x2
        => r.Rotation2D.Matrix3x2;

    // The homogeneous matrix of a quaternion's rotation.
    Matrix4x4(q: Quaternion): Matrix4x4
        => Matrix4x4.CreateFromQuaternion(q);

    // The quaternion of a rotation matrix. Precondition: the upper 3x3 block
    // is orthonormal (a pure rotation, no scale or shear).
    Quaternion(m: Matrix4x4): Quaternion
        => Quaternion.CreateFromRotationMatrix(m);

    // The homogeneous matrix of an axis-angle rotation.
    Matrix4x4(aa: AxisAngle): Matrix4x4
        => Matrix4x4.CreateFromAxisAngle(aa.Axis.Vector, aa.Angle);

    // The homogeneous matrix of chained elemental rotations.
    Matrix4x4(e: EulerAngles): Matrix4x4
        => e.Quaternion.Matrix4x4;

    // The homogeneous matrix of a rotor's rotation.
    Matrix4x4(r: Rotor3D): Matrix4x4
        => r.Quaternion.Matrix4x4;

    //==
    // # TRS transform operations
    //
    // Application, matrix interchange, and the lossy widening/narrowing between a
    // rigid pose and the TRS transforms of `transforms.types.plato`.

    //==
    // TRS transforms — scale, then rotate, then translate. Not closed under
    // composition (rotating a non-uniform scale leaves the TRS family), so
    // compose them through their matrix or affine forms.

    // Apply the transform: scale, rotate, then translate.
    Transform(p: Point2D, t: TrsTransform2D): Point2D
        => ((p.PositionVector * t.Scale).Transform(t.Rotation) + t.Translation).ToPoint;

    // Alias for Transform with transform-on-left (* operator): t * p.
    Multiply(t: TrsTransform2D, p: Point2D): Point2D
        => Transform(p, t);

    // Apply the scale and rotation to a displacement (translation does not act
    // on vectors).
    Transform(v: Vector2D, t: TrsTransform2D): Vector2D
        => (v * t.Scale).Transform(t.Rotation);

    // Alias for Transform with transform-on-left (* operator): t * v.
    Multiply(t: TrsTransform2D, v: Vector2D): Vector2D
        => Transform(v, t);

    // The affine matrix of the transform: S * R * T in row-vector order.
    Matrix3x2(t: TrsTransform2D): Matrix3x2
        => Matrix3x2.CreateScale(t.Scale) * t.Rotation.Matrix3x2
            * Matrix3x2.CreateTranslation(t.Translation);

    // Compose through the affine closure. TRS is not closed under composition
    // (rotating a non-uniform scale leaves the TRS family); the product is the
    // matrix form of first-then-second, re-read as TRS with unit shear assumed.
    // Prefer AffineTransform2D.Compose when the result must stay exact.
    Compose(first: TrsTransform2D, second: TrsTransform2D): AffineTransform2D
        => AffineTransform2D(first).Compose(AffineTransform2D(second));

    // Alias for Compose, enabling the * operator: a * b applies a first.
    // Returns AffineTransform2D because TRS is not closed under composition.
    Multiply(a: TrsTransform2D, b: TrsTransform2D): AffineTransform2D
        => a.Compose(b);

    // A rigid pose widened to a TRS transform with unit scale.
    TrsTransform2D(pose: Pose2D): TrsTransform2D
        => (pose.Position.PositionVector, pose.Rotation, Number2.One);

    // The rigid part of the transform, discarding scale. Named Pose rather
    // than Pose2D because the conversion is lossy and must stay explicit.
    Pose(t: TrsTransform2D): Pose2D
        => (t.Translation.ToPoint, t.Rotation);

    // Apply the transform: scale, rotate, then translate.
    Transform(p: Point3D, t: TrsTransform3D): Point3D
        => ((p.PositionVector * t.Scale).Transform(t.Rotation) + t.Translation).ToPoint;

    // Alias for Transform with transform-on-left (* operator): t * p.
    Multiply(t: TrsTransform3D, p: Point3D): Point3D
        => Transform(p, t);

    // Apply the scale and rotation to a displacement.
    Transform(v: Vector3D, t: TrsTransform3D): Vector3D
        => (v * t.Scale).Transform(t.Rotation);

    // Alias for Transform with transform-on-left (* operator): t * v.
    Multiply(t: TrsTransform3D, v: Vector3D): Vector3D
        => Transform(v, t);

    // The homogeneous matrix of the transform: S * R * T in row-vector order.
    Matrix4x4(t: TrsTransform3D): Matrix4x4
        => Matrix4x4.CreateScale(t.Scale) * t.Rotation.Matrix4x4
            * Matrix4x4.CreateTranslation(t.Translation);

    // Compose through the matrix product, then re-decompose into TRS.
    // Precondition: the product is a scale-rotate-translate composition
    // (Decompose succeeds); shear is not representable as TrsTransform3D.
    Compose(first: TrsTransform3D, second: TrsTransform3D): TrsTransform3D
        => TrsTransform3D(first.Matrix4x4 * second.Matrix4x4);

    // Alias for Compose, enabling the * operator: a * b applies a first.
    Multiply(a: TrsTransform3D, b: TrsTransform3D): TrsTransform3D
        => a.Compose(b);

    // The TRS decomposition of a matrix. Precondition: the matrix is a
    // scale-rotate-translate composition (Decompose succeeds); shear and
    // projection are not representable.
    TrsTransform3D(m: Matrix4x4): TrsTransform3D {
        var d = m.Decompose;
        return (d.X2, d.X1, d.X0);
    }

    // A rigid pose widened to a TRS transform with unit scale.
    TrsTransform3D(pose: Pose3D): TrsTransform3D
        => (pose.Position.PositionVector, pose.Orientation, Number3.One);

    // The rigid part of the transform, discarding scale. Named Pose rather
    // than Pose3D because the conversion is lossy and must stay explicit.
    Pose(t: TrsTransform3D): Pose3D
        => (t.Translation.ToPoint, t.Rotation);
}
