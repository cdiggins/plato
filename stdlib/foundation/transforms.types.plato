//==
// # Transforms
//
// Sections, in order:
//  - Affine and projective transforms
//  - Coordinate frames and bases
//  - Motors
//  - Rigid poses
//  - TRS transforms
//  - Elementary transforms

//==
// # Affine and projective transforms
//
// The two widest transform families: affine maps (any composition of linear maps
// and translations) and projective maps (full homographies on homogeneous
// coordinates). Affine is the common ground every other representation converts
// into, and projective is closed under composition, so mixed-kind composition
// belongs here. Each is a thin wrapper over the matrix that carries it
// (`matrices.types.plato`); the operations live in
// `transforms.library.plato`.
//
// The projective types carry the UNQUALIFIED names `Transform2D` / `Transform3D`
// because they are the widest map of their dimension: every other representation
// converts into one, so they are what `Transformable2D` / `Transformable3D`
// (`transforms.concepts.plato`) accept. The narrower families are named for what
// narrows them — `AffineTransform*D`, `TrsTransform*D`, `Pose*D`.

// A general 2D affine map: any composition of linear maps and translations
// (https://en.wikipedia.org/wiki/Affine_transformation).
type AffineTransform2D
    implements Value, Affine2D
{
    Matrix: Matrix3x2;
}

// A general 3D affine map: any composition of linear maps and translations
// (https://en.wikipedia.org/wiki/Affine_transformation).
type AffineTransform3D
    implements Value, Affine3D
{
    Matrix: Matrix4x3;
}

// A full 2D projective map (homography), operating on homogeneous coordinates:
// the widest transform of the plane, and the one `Transformable2D` carries
// (https://en.wikipedia.org/wiki/Homography).
type Transform2D
    implements Value
{
    Matrix: Matrix3x3;
}

// A full 3D projective map, operating on homogeneous coordinates; includes
// perspective projections. The widest transform of space, and the one
// `Transformable3D` carries (https://en.wikipedia.org/wiki/Homography).
type Transform3D
    implements Value
{
    Matrix: Matrix4x4;
}

//==
// # Coordinate frames and bases
//
// An origin with a set of axes: the matrix-friendly clothing of a rigid pose,
// where the axes are the rotation and the origin is the translation. Frames carry
// an orthonormality invariant; a bare Basis3D does not. The operations live in
// `transforms.library.plato`.

// An orthonormal coordinate frame in the plane: an origin and two perpendicular
// unit axes.
type Frame2D
    implements Value, Rigid2D
{
    Origin: Point2D;
    XAxis: Direction2D;
    YAxis: Direction2D;
}

// An orthonormal coordinate frame in space: an origin and three mutually
// perpendicular unit axes.
type Frame3D
    implements Value, Rigid3D
{
    Origin: Point3D;
    XAxis: Direction3D;
    YAxis: Direction3D;
    ZAxis: Direction3D;
}

// Three basis vectors in 3D; not necessarily orthonormal
// (https://en.wikipedia.org/wiki/Basis_(linear_algebra)).
type Basis3D
    implements Value, Affine3D
{
    X: Vector3D;
    Y: Vector3D;
    Z: Vector3D;
}

//==
// # Motors
//
// A rigid motion in geometric-algebra form, stored as a dual quaternion. The
// motor is the representation that interpolates a rotation and a translation
// together rather than independently, and composes by a single product. The
// operations live in `transforms.library.plato`.

// A rigid motion (rotation plus translation) as a geometric-algebra motor,
// stored in dual-quaternion form: Real is the rotation, Dual encodes the
// translation as Dual = 0.5 * t * Real, where t is the translation as a pure
// quaternion. Unit dual quaternions are isomorphic to the motors of 3D PGA.
// https://en.wikipedia.org/wiki/Dual_quaternion
type Motor3D
    implements Value, Multiplicative, Rigid3D
{
    Real: Quaternion;
    Dual: Quaternion;
}

//==
// # Rigid poses
//
// Position plus rotation: the natural "where is this object" transform, in the
// plane and in space. Composition preserves distances and angles, so a pose is
// the representation to reach for whenever no scale or shear is wanted. The
// operations live in `transforms.library.plato`.

// A rigid placement in the plane: position plus rotation. Also known as a 2D
// rigid transform (https://en.wikipedia.org/wiki/Rigid_transformation).
type Pose2D
    implements Value, Interpolatable, Rigid2D
{
    Position: Point2D;
    Rotation: Rotation2D;
}

// A rigid placement in space: position plus orientation. Also known as a 3D
// rigid transform (https://en.wikipedia.org/wiki/Rigid_transformation);
// composition preserves distances and angles.
type Pose3D
    implements Value, Interpolatable, Rigid3D
{
    Position: Point3D;
    Orientation: Quaternion;
}

//==
// # TRS transforms
//
// Translate-rotate-scale transforms in 2D and 3D: the authoring-friendly
// representation whose three parts are edited independently. They are NOT closed
// under composition — rotating a non-uniform scale leaves the TRS family — so
// compose them through their matrix or affine forms
//. The operations live in
// `transforms.library.plato`.

// A translate-rotate-scale transform in 2D, applied scale first, then rotation,
// then translation.
type TrsTransform2D
    implements Value, Affine2D
{
    Translation: Vector2D;
    Rotation: Rotation2D;
    Scale: Number2;
}

// A translate-rotate-scale transform in 3D, applied scale first, then rotation,
// then translation.
type TrsTransform3D
    implements Value, Affine3D
{
    Translation: Vector3D;
    Rotation: Quaternion;
    Scale: Number3;
}

//==
// # Elementary transforms
//
// The single-purpose building blocks — the atoms — of the transform surface: one
// named operation each, in the plane and in space. Every one of them converts to
// the general affine transform of its dimension, and that affine form is how they
// compose: the elementary families are NOT closed under composition (two
// translations compose to a translation, but a rotation and a scaling do not stay
// in either family). The `*About*` types apply their operation about `Center`
// rather than about the origin. The operations live in
// `transforms.library.plato`.

// A translation in the plane: every point is displaced by the same vector
// (https://en.wikipedia.org/wiki/Translation_(geometry)).
type Translation2D
    implements Value, Rigid2D
{
    Vector: Vector2D;
}

// A translation in space: every point is displaced by the same vector
// (https://en.wikipedia.org/wiki/Translation_(geometry)).
type Translation3D
    implements Value, Rigid3D
{
    Vector: Vector3D;
}

// An axis-aligned scaling about the origin in the plane, with an independent
// factor per axis (https://en.wikipedia.org/wiki/Scaling_(geometry)).
type Scaling2D
    implements Value, Affine2D
{
    Amount: Number2;
}

// An axis-aligned scaling about the origin in space, with an independent factor
// per axis (https://en.wikipedia.org/wiki/Scaling_(geometry)).
type Scaling3D
    implements Value, Affine3D
{
    Amount: Number3;
}

// A uniform scaling about the origin in the plane: the same factor on every axis,
// so angles are preserved (https://en.wikipedia.org/wiki/Homothety).
type UniformScaling2D
    implements Value, Affine2D
{
    Amount: Number;
}

// A uniform scaling about the origin in space: the same factor on every axis, so
// angles are preserved (https://en.wikipedia.org/wiki/Homothety).
type UniformScaling3D
    implements Value, Affine3D
{
    Amount: Number;
}

// A mirror across a line in the plane, given as a point on the line and the
// direction along it (https://en.wikipedia.org/wiki/Reflection_(mathematics)).
type Reflection2D
    implements Value, Affine2D
{
    Origin: Point2D;
    Direction: Direction2D;
}

// A mirror across a plane in space, given as a point on the plane and its unit
// normal (https://en.wikipedia.org/wiki/Reflection_(mathematics)).
type Reflection3D
    implements Value, Affine3D
{
    Origin: Point3D;
    Normal: Direction3D;
}

// A rotation in the plane about an arbitrary center rather than the origin
// (https://en.wikipedia.org/wiki/Rotation_(mathematics)).
type RotationAbout2D
    implements Value, Rigid2D
{
    Rotation: Rotation2D;
    Center: Point2D;
}

// A rotation in space about an arbitrary center rather than the origin; the
// rotation axis passes through Center
// (https://en.wikipedia.org/wiki/Rotation_(mathematics)).
type RotationAbout3D
    implements Value, Rigid3D
{
    Rotation: Quaternion;
    Center: Point3D;
}

// An axis-aligned scaling in the plane about an arbitrary center rather than the
// origin; Center is the one fixed point
// (https://en.wikipedia.org/wiki/Scaling_(geometry)).
type ScalingAbout2D
    implements Value, Affine2D
{
    Amount: Number2;
    Center: Point2D;
}

// An axis-aligned scaling in space about an arbitrary center rather than the
// origin; Center is the one fixed point
// (https://en.wikipedia.org/wiki/Scaling_(geometry)).
type ScalingAbout3D
    implements Value, Affine3D
{
    Amount: Number3;
    Center: Point3D;
}
