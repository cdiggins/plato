//==
// # Vectors
//
// Sections, in order:
//  - Geometric vector operations
//  - Integer vectors — concrete bodies
//  - Portable bodies for the numeric tuples

library Vectors
{
    //==
    // # Geometric vector operations
    //
    // The portable reference bodies for Vector2D and Vector3D — magnitude,
    // normalization, the arithmetic operators, dot and cross products, reflection,
    // and transformation by matrix or quaternion. These used to be bodiless
    // intrinsics; the semantics here match System.Numerics Vector2 / Vector3
    // element for element, so a backend may substitute the native call.
    // Convention: see CONVENTIONS.md - Matrices (row-vector multiplication, v' = v M).
    //
    // Matrix element naming below follows the row-vector layout of
    // `matrices.types.plato`: for Matrix3x2, M11 = Row1.X ... M32 = Row3.Y, and Row3
    // is the translation; for Matrix4x4, M11 = Row1.X ... M44 = Row4.W, and Row4 is
    // the translation.

    //==
    // Vector2D — magnitude and arithmetic

    // The Euclidean length. https://en.wikipedia.org/wiki/Euclidean_vector#Length
    Length(self: Vector2D): Number
        => self.LengthSquared.Sqrt;

    // The squared length: cheaper than Length, and enough for comparisons.
    LengthSquared(self: Vector2D): Number
        => self.X.Square + self.Y.Square;

    // The vector rescaled to unit length. No zero guard: normalizing the zero
    // vector yields NaN components, matching System.Numerics.
    Normalize(self: Vector2D): Vector2D
        => self / self.Length;

    // Component-wise sum.
    Add(left: Vector2D, right: Vector2D): Vector2D
        => (left.X + right.X, left.Y + right.Y);

    // Component-wise difference.
    Subtract(left: Vector2D, right: Vector2D): Vector2D
        => (left.X - right.X, left.Y - right.Y);

    // Uniform scale.
    Multiply(left: Vector2D, scalar: Number): Vector2D
        => (left.X * scalar, left.Y * scalar);

    // Uniform scale with the scalar on the left.
    Multiply(scalar: Number, right: Vector2D): Vector2D
        => (scalar * right.X, scalar * right.Y);

    // Per-axis scale by a pair of factors.
    Multiply(left: Vector2D, factors: Number2): Vector2D
        => (left.X * factors.X, left.Y * factors.Y);

    // Uniform division. Dividing by zero yields infinite or NaN components.
    Divide(left: Vector2D, scalar: Number): Vector2D
        => (left.X / scalar, left.Y / scalar);

    // The vector pointing the opposite way.
    Negative(value: Vector2D): Vector2D
        => (-value.X, -value.Y);

    // The dot product. https://en.wikipedia.org/wiki/Dot_product
    Dot(self: Vector2D, right: Vector2D): Number
        => self.X * right.X + self.Y * right.Y;

    // The reflection of the vector off a line with the given normal:
    // v - 2 (v . n) n. Precondition: `normal` is unit length.
    // https://en.wikipedia.org/wiki/Reflection_(mathematics)
    Reflect(self: Vector2D, normal: Vector2D): Vector2D
        => self - normal * (2.0 * self.Dot(normal));

    //==
    // Vector2D — transformation

    // Apply a 2D affine map, including the translation row (Row3).
    Transform(self: Vector2D, matrix: Matrix3x2): Vector2D
        => (self.X * matrix.Row1.X + self.Y * matrix.Row2.X + matrix.Row3.X,
            self.X * matrix.Row1.Y + self.Y * matrix.Row2.Y + matrix.Row3.Y);

    // Alias for Transform with transform-on-left (* operator): matrix * self.
    Multiply(matrix: Matrix3x2, self: Vector2D): Vector2D
        => self.Transform(matrix);

    // Apply the 2D part of a homogeneous map, including the translation row
    // (Row4): (X M11 + Y M21 + M41, X M12 + Y M22 + M42).
    Transform(self: Vector2D, matrix: Matrix4x4): Vector2D
        => (self.X * matrix.Row1.X + self.Y * matrix.Row2.X + matrix.Row4.X,
            self.X * matrix.Row1.Y + self.Y * matrix.Row2.Y + matrix.Row4.Y);

    // Alias for Transform with transform-on-left (* operator): matrix * self.
    Multiply(matrix: Matrix4x4, self: Vector2D): Vector2D
        => self.Transform(matrix);

    // Rotate the vector by a quaternion, treating it as the z = 0 vector and
    // dropping the resulting z. The doubled-component expansion of the sandwich
    // product q v q*. https://en.wikipedia.org/wiki/Quaternions_and_spatial_rotation
    Transform(self: Vector2D, rotation: Quaternion): Vector2D {
        var x2 = rotation.X + rotation.X;
        var y2 = rotation.Y + rotation.Y;
        var z2 = rotation.Z + rotation.Z;
        var wz2 = rotation.W * z2;
        var xx2 = rotation.X * x2;
        var xy2 = rotation.X * y2;
        var yy2 = rotation.Y * y2;
        var zz2 = rotation.Z * z2;
        return (self.X * (1.0 - yy2 - zz2) + self.Y * (xy2 - wz2),
                self.X * (xy2 + wz2) + self.Y * (1.0 - xx2 - zz2));
    }

    // Alias for Transform with transform-on-left (* operator): rotation * self.
    Multiply(rotation: Quaternion, self: Vector2D): Vector2D
        => self.Transform(rotation);

    // Apply only the linear part of a 2D affine map: the translation row is
    // skipped, as it must be for displacements and normals.
    TransformNormal(self: Vector2D, matrix: Matrix3x2): Vector2D
        => (self.X * matrix.Row1.X + self.Y * matrix.Row2.X,
            self.X * matrix.Row1.Y + self.Y * matrix.Row2.Y);

    // Apply only the linear part of a homogeneous map.
    TransformNormal(self: Vector2D, matrix: Matrix4x4): Vector2D
        => (self.X * matrix.Row1.X + self.Y * matrix.Row2.X,
            self.X * matrix.Row1.Y + self.Y * matrix.Row2.Y);

    // The combined hash of the components.
    Hash(self: Vector2D): Integer
        => self.X.Hash.CombineHash(self.Y.Hash);

    //==
    // Vector3D — magnitude and arithmetic

    // The Euclidean length. https://en.wikipedia.org/wiki/Euclidean_vector#Length
    Length(self: Vector3D): Number
        => self.LengthSquared.Sqrt;

    // The squared length: cheaper than Length, and enough for comparisons.
    LengthSquared(self: Vector3D): Number
        => self.X.Square + self.Y.Square + self.Z.Square;

    // The vector rescaled to unit length. No zero guard: normalizing the zero
    // vector yields NaN components, matching System.Numerics.
    Normalize(self: Vector3D): Vector3D
        => self / self.Length;

    // Component-wise sum.
    Add(left: Vector3D, right: Vector3D): Vector3D
        => (left.X + right.X, left.Y + right.Y, left.Z + right.Z);

    // Component-wise difference.
    Subtract(left: Vector3D, right: Vector3D): Vector3D
        => (left.X - right.X, left.Y - right.Y, left.Z - right.Z);

    // Uniform scale.
    Multiply(left: Vector3D, scalar: Number): Vector3D
        => (left.X * scalar, left.Y * scalar, left.Z * scalar);

    // Uniform scale with the scalar on the left.
    Multiply(scalar: Number, right: Vector3D): Vector3D
        => (scalar * right.X, scalar * right.Y, scalar * right.Z);

    // Per-axis scale by a triple of factors.
    Multiply(left: Vector3D, factors: Number3): Vector3D
        => (left.X * factors.X, left.Y * factors.Y, left.Z * factors.Z);

    // Uniform division. Dividing by zero yields infinite or NaN components.
    Divide(left: Vector3D, scalar: Number): Vector3D
        => (left.X / scalar, left.Y / scalar, left.Z / scalar);

    // The vector pointing the opposite way.
    Negative(value: Vector3D): Vector3D
        => (-value.X, -value.Y, -value.Z);

    // The dot product. https://en.wikipedia.org/wiki/Dot_product
    Dot(self: Vector3D, right: Vector3D): Number
        => self.X * right.X + self.Y * right.Y + self.Z * right.Z;

    // The cross product: the vector perpendicular to both operands, with
    // magnitude equal to the area of the parallelogram they span.
    // https://en.wikipedia.org/wiki/Cross_product
    Cross(self: Vector3D, right: Vector3D): Vector3D
        => (self.Y * right.Z - self.Z * right.Y,
            self.Z * right.X - self.X * right.Z,
            self.X * right.Y - self.Y * right.X);

    // The reflection of the vector off a plane with the given normal:
    // v - 2 (v . n) n. Precondition: `normal` is unit length.
    // https://en.wikipedia.org/wiki/Reflection_(mathematics)
    Reflect(self: Vector3D, normal: Vector3D): Vector3D
        => self - normal * (2.0 * self.Dot(normal));

    //==
    // Vector3D — transformation

    // Apply a homogeneous map, including the translation row (Row4):
    // v' = x Row1 + y Row2 + z Row3 + Row4, dropping the w component.
    Transform(self: Vector3D, matrix: Matrix4x4): Vector3D
        => (self.X * matrix.Row1.X + self.Y * matrix.Row2.X + self.Z * matrix.Row3.X + matrix.Row4.X,
            self.X * matrix.Row1.Y + self.Y * matrix.Row2.Y + self.Z * matrix.Row3.Y + matrix.Row4.Y,
            self.X * matrix.Row1.Z + self.Y * matrix.Row2.Z + self.Z * matrix.Row3.Z + matrix.Row4.Z);

    // Alias for Transform with transform-on-left (* operator): matrix * self.
    Multiply(matrix: Matrix4x4, self: Vector3D): Vector3D
        => self.Transform(matrix);

    // Rotate the vector by a quaternion: the doubled-component expansion of the
    // sandwich product q v q*.
    // https://en.wikipedia.org/wiki/Quaternions_and_spatial_rotation
    Transform(self: Vector3D, rotation: Quaternion): Vector3D {
        var x2 = rotation.X + rotation.X;
        var y2 = rotation.Y + rotation.Y;
        var z2 = rotation.Z + rotation.Z;
        var wx2 = rotation.W * x2;
        var wy2 = rotation.W * y2;
        var wz2 = rotation.W * z2;
        var xx2 = rotation.X * x2;
        var xy2 = rotation.X * y2;
        var xz2 = rotation.X * z2;
        var yy2 = rotation.Y * y2;
        var yz2 = rotation.Y * z2;
        var zz2 = rotation.Z * z2;
        return (self.X * (1.0 - yy2 - zz2) + self.Y * (xy2 - wz2) + self.Z * (xz2 + wy2),
                self.X * (xy2 + wz2) + self.Y * (1.0 - xx2 - zz2) + self.Z * (yz2 - wx2),
                self.X * (xz2 - wy2) + self.Y * (yz2 + wx2) + self.Z * (1.0 - xx2 - yy2));
    }

    // Alias for Transform with transform-on-left (* operator): rotation * self.
    Multiply(rotation: Quaternion, self: Vector3D): Vector3D
        => self.Transform(rotation);

    // Apply only the linear part of a homogeneous map: the translation row is
    // skipped, as it must be for displacements and normals.
    TransformNormal(self: Vector3D, matrix: Matrix4x4): Vector3D
        => (self.X * matrix.Row1.X + self.Y * matrix.Row2.X + self.Z * matrix.Row3.X,
            self.X * matrix.Row1.Y + self.Y * matrix.Row2.Y + self.Z * matrix.Row3.Y,
            self.X * matrix.Row1.Z + self.Y * matrix.Row2.Z + self.Z * matrix.Row3.Z);

    // The combined hash of the components.
    Hash(self: Vector3D): Integer
        => self.X.Hash.CombineHash(self.Y.Hash).CombineHash(self.Z.Hash);

    //==
    // # Integer vectors — concrete bodies
    //
    // IHashable obligations for the fixed-arity integer tuples declared in
    // `vectors.types.plato`.

    Hash(self: IntegerVector2): Integer
        => self.X.Hash * 31 + self.Y.Hash;

    Hash(self: IntegerVector3): Integer
        => ((self.X.Hash * 31 + self.Y.Hash) * 31 + self.Z.Hash);

    Hash(self: IntegerVector4): Integer
        => (((self.X.Hash * 31 + self.Y.Hash) * 31 + self.Z.Hash) * 31 + self.W.Hash);

    //==
    // # Portable bodies for the numeric tuples
    //
    // The concrete per-component operations on Number2 / Number3 / Number4 /
    // Number8 (`vectors.types.plato`). These used to be bodiless
    // declarations in `intrinsics.library.plato` forwarded to System.Numerics;
    // they are ordinary Plato now, so the host contract mentions only primitive
    // types. A backend may still substitute a native vector instruction for any of
    // them through its representation map and override table — these bodies define
    // what that substitution must compute.
    //
    // The generic component-wise surface in
    // `numeric-structures.library.plato` computes the same values through
    // Map/Zip over ComponentArray; the fixed-arity bodies here are the ones a
    // backend can map onto a single SIMD instruction, and they are written out lane
    // by lane for exactly that reason.
    //
    // Semantics match System.Numerics: Multiply and Divide of two tuples are
    // component-wise (Hadamard), never a dot product; Length is the Euclidean norm;
    // Clamp / Min / Max act per component; Number4.Transform follows the ROW-vector
    // convention v' = v M (CONVENTIONS.md - Matrices).

    //==
    // # Number2

    // The squared Euclidean length; avoids the square root.
    LengthSquared(self: Number2): Number
        => self.X * self.X + self.Y * self.Y;

    // The Euclidean length.
    Length(self: Number2): Number
        => self.LengthSquared.Sqrt;

    // Component-wise absolute value.
    Abs(self: Number2): Number2
        => (self.X.Abs, self.Y.Abs);

    // Component-wise square root. Precondition: no component is negative.
    Sqrt(self: Number2): Number2
        => (self.X.Sqrt, self.Y.Sqrt);

    // Component-wise sum.
    Add(left: Number2, right: Number2): Number2
        => (left.X + right.X, left.Y + right.Y);

    // Component-wise difference.
    Subtract(left: Number2, right: Number2): Number2
        => (left.X - right.X, left.Y - right.Y);

    // Component-wise (Hadamard) product, not a dot product.
    Multiply(left: Number2, right: Number2): Number2
        => (left.X * right.X, left.Y * right.Y);

    // Every component scaled by a scalar.
    Multiply(left: Number2, scalar: Number): Number2
        => (left.X * scalar, left.Y * scalar);

    // Every component scaled by a scalar, scalar on the left.
    Multiply(scalar: Number, right: Number2): Number2
        => (scalar * right.X, scalar * right.Y);

    // Component-wise quotient. Precondition: no component of right is zero.
    Divide(left: Number2, right: Number2): Number2
        => (left.X / right.X, left.Y / right.Y);

    // Every component divided by a scalar. Precondition: scalar is non-zero.
    Divide(left: Number2, scalar: Number): Number2
        => (left.X / scalar, left.Y / scalar);

    // The tuple with every component negated.
    Negative(value: Number2): Number2
        => (-value.X, -value.Y);

    // The dot product: the sum of the products of corresponding components.
    Dot(self: Number2, right: Number2): Number
        => self.X * right.X + self.Y * right.Y;

    // Each component restricted to the corresponding [min, max] range.
    // Precondition: min <= max component-wise.
    Clamp(self: Number2, min: Number2, max: Number2): Number2
        => (self.X.Clamp(min.X, max.X), self.Y.Clamp(min.Y, max.Y));

    // The component-wise maximum.
    Max(self: Number2, value2: Number2): Number2
        => (self.X.Max(value2.X), self.Y.Max(value2.Y));

    // The component-wise minimum.
    Min(self: Number2, value2: Number2): Number2
        => (self.X.Min(value2.X), self.Y.Min(value2.Y));

    // The IHashable obligation: every component folded into one digest.
    Hash(self: Number2): Integer
        => self.X.Hash.CombineHash(self.Y.Hash);

    //==
    // # Number3

    // The squared Euclidean length; avoids the square root.
    LengthSquared(self: Number3): Number
        => self.X * self.X + self.Y * self.Y + self.Z * self.Z;

    // The Euclidean length.
    Length(self: Number3): Number
        => self.LengthSquared.Sqrt;

    // Component-wise absolute value.
    Abs(self: Number3): Number3
        => (self.X.Abs, self.Y.Abs, self.Z.Abs);

    // Component-wise square root. Precondition: no component is negative.
    Sqrt(self: Number3): Number3
        => (self.X.Sqrt, self.Y.Sqrt, self.Z.Sqrt);

    // Component-wise sum.
    Add(left: Number3, right: Number3): Number3
        => (left.X + right.X, left.Y + right.Y, left.Z + right.Z);

    // Component-wise difference.
    Subtract(left: Number3, right: Number3): Number3
        => (left.X - right.X, left.Y - right.Y, left.Z - right.Z);

    // Component-wise (Hadamard) product, not a dot or cross product.
    Multiply(left: Number3, right: Number3): Number3
        => (left.X * right.X, left.Y * right.Y, left.Z * right.Z);

    // Every component scaled by a scalar.
    Multiply(left: Number3, scalar: Number): Number3
        => (left.X * scalar, left.Y * scalar, left.Z * scalar);

    // Every component scaled by a scalar, scalar on the left.
    Multiply(scalar: Number, right: Number3): Number3
        => (scalar * right.X, scalar * right.Y, scalar * right.Z);

    // Component-wise quotient. Precondition: no component of right is zero.
    Divide(left: Number3, right: Number3): Number3
        => (left.X / right.X, left.Y / right.Y, left.Z / right.Z);

    // Every component divided by a scalar. Precondition: scalar is non-zero.
    Divide(left: Number3, scalar: Number): Number3
        => (left.X / scalar, left.Y / scalar, left.Z / scalar);

    // The tuple with every component negated.
    Negative(value: Number3): Number3
        => (-value.X, -value.Y, -value.Z);

    // The dot product: the sum of the products of corresponding components.
    Dot(self: Number3, right: Number3): Number
        => self.X * right.X + self.Y * right.Y + self.Z * right.Z;

    // Each component restricted to the corresponding [min, max] range.
    // Precondition: min <= max component-wise.
    Clamp(self: Number3, min: Number3, max: Number3): Number3
        => (self.X.Clamp(min.X, max.X),
                   self.Y.Clamp(min.Y, max.Y),
                   self.Z.Clamp(min.Z, max.Z));

    // The component-wise maximum.
    Max(self: Number3, value2: Number3): Number3
        => (self.X.Max(value2.X), self.Y.Max(value2.Y), self.Z.Max(value2.Z));

    // The component-wise minimum.
    Min(self: Number3, value2: Number3): Number3
        => (self.X.Min(value2.X), self.Y.Min(value2.Y), self.Z.Min(value2.Z));

    // The IHashable obligation: every component folded into one digest.
    Hash(self: Number3): Integer
        => self.X.Hash.CombineHash(self.Y.Hash).CombineHash(self.Z.Hash);

    //==
    // # Number4

    // The squared Euclidean length; avoids the square root.
    LengthSquared(self: Number4): Number
        => self.X * self.X + self.Y * self.Y + self.Z * self.Z + self.W * self.W;

    // The Euclidean length.
    Length(self: Number4): Number
        => self.LengthSquared.Sqrt;

    // Component-wise absolute value.
    Abs(self: Number4): Number4
        => (self.X.Abs, self.Y.Abs, self.Z.Abs, self.W.Abs);

    // Component-wise square root. Precondition: no component is negative.
    Sqrt(self: Number4): Number4
        => (self.X.Sqrt, self.Y.Sqrt, self.Z.Sqrt, self.W.Sqrt);

    // Component-wise sum.
    Add(left: Number4, right: Number4): Number4
        => (left.X + right.X, left.Y + right.Y, left.Z + right.Z, left.W + right.W);

    // Component-wise difference.
    Subtract(left: Number4, right: Number4): Number4
        => (left.X - right.X, left.Y - right.Y, left.Z - right.Z, left.W - right.W);

    // Component-wise (Hadamard) product, not a dot product.
    Multiply(left: Number4, right: Number4): Number4
        => (left.X * right.X, left.Y * right.Y, left.Z * right.Z, left.W * right.W);

    // Every component scaled by a scalar.
    Multiply(left: Number4, scalar: Number): Number4
        => (left.X * scalar, left.Y * scalar, left.Z * scalar, left.W * scalar);

    // Every component scaled by a scalar, scalar on the left.
    Multiply(scalar: Number, right: Number4): Number4
        => (scalar * right.X, scalar * right.Y, scalar * right.Z, scalar * right.W);

    // Component-wise quotient. Precondition: no component of right is zero.
    Divide(left: Number4, right: Number4): Number4
        => (left.X / right.X, left.Y / right.Y, left.Z / right.Z, left.W / right.W);

    // Every component divided by a scalar. Precondition: scalar is non-zero.
    Divide(left: Number4, scalar: Number): Number4
        => (left.X / scalar, left.Y / scalar, left.Z / scalar, left.W / scalar);

    // The tuple with every component negated.
    Negative(value: Number4): Number4
        => (-value.X, -value.Y, -value.Z, -value.W);

    // The dot product: the sum of the products of corresponding components.
    Dot(self: Number4, right: Number4): Number
        => self.X * right.X + self.Y * right.Y + self.Z * right.Z + self.W * right.W;

    // Each component restricted to the corresponding [min, max] range.
    // Precondition: min <= max component-wise.
    Clamp(self: Number4, min: Number4, max: Number4): Number4
        => (self.X.Clamp(min.X, max.X),
                   self.Y.Clamp(min.Y, max.Y),
                   self.Z.Clamp(min.Z, max.Z),
                   self.W.Clamp(min.W, max.W));

    // The component-wise maximum.
    Max(self: Number4, value2: Number4): Number4
        => (self.X.Max(value2.X), self.Y.Max(value2.Y),
                   self.Z.Max(value2.Z), self.W.Max(value2.W));

    // The component-wise minimum.
    Min(self: Number4, value2: Number4): Number4
        => (self.X.Min(value2.X), self.Y.Min(value2.Y),
                   self.Z.Min(value2.Z), self.W.Min(value2.W));

    // The IHashable obligation: every component folded into one digest.
    Hash(self: Number4): Integer
        => self.X.Hash.CombineHash(self.Y.Hash).CombineHash(self.Z.Hash).CombineHash(self.W.Hash);

    //==
    // # Number4 — homogeneous transforms
    //
    // Row-vector convention: v' = v M, so component j of the result pairs the
    // whole of v with COLUMN j of the matrix (Convention: see CONVENTIONS.md -
    // Matrices). Rows are Number4, so M(i,j) is Row<i>.<j-th field>: M11 is
    // Row1.X, M21 is Row2.X, and so on.

    // The 4-vector carried through a 4x4 transform, treating it as a homogeneous
    // coordinate: no perspective divide, W is produced by the fourth column.
    Transform(self: Number4, matrix: Matrix4x4): Number4
        => (
            self.X * matrix.Row1.X + self.Y * matrix.Row2.X + self.Z * matrix.Row3.X + self.W * matrix.Row4.X,
            self.X * matrix.Row1.Y + self.Y * matrix.Row2.Y + self.Z * matrix.Row3.Y + self.W * matrix.Row4.Y,
            self.X * matrix.Row1.Z + self.Y * matrix.Row2.Z + self.Z * matrix.Row3.Z + self.W * matrix.Row4.Z,
            self.X * matrix.Row1.W + self.Y * matrix.Row2.W + self.Z * matrix.Row3.W + self.W * matrix.Row4.W);

    // Operator spelling of the transform above, with the matrix on the left.
    // The argument order is the historical `M * v` reading; the computation is
    // still the row-vector product v M.
    Multiply(matrix: Matrix4x4, self: Number4): Number4
        => self.Transform(matrix);

    // The 4-vector whose XYZ part is rotated by a unit quaternion, with W passed
    // through untouched. The coefficients are the quaternion-to-matrix identity
    // written inline (https://en.wikipedia.org/wiki/Quaternions_and_spatial_rotation),
    // matching System.Numerics term for term.
    Transform(self: Number4, rotation: Quaternion): Number4
    {
        var x2 = rotation.X + rotation.X;
        var y2 = rotation.Y + rotation.Y;
        var z2 = rotation.Z + rotation.Z;
        var wx2 = rotation.W * x2;
        var wy2 = rotation.W * y2;
        var wz2 = rotation.W * z2;
        var xx2 = rotation.X * x2;
        var xy2 = rotation.X * y2;
        var xz2 = rotation.X * z2;
        var yy2 = rotation.Y * y2;
        var yz2 = rotation.Y * z2;
        var zz2 = rotation.Z * z2;
        return (
            self.X * (1.0 - yy2 - zz2) + self.Y * (xy2 - wz2) + self.Z * (xz2 + wy2),
            self.X * (xy2 + wz2) + self.Y * (1.0 - xx2 - zz2) + self.Z * (yz2 - wx2),
            self.X * (xz2 - wy2) + self.Y * (yz2 + wx2) + self.Z * (1.0 - xx2 - yy2),
            self.W);
    }

    // Operator spelling of the quaternion rotation above, rotation on the left.
    Multiply(rotation: Quaternion, self: Number4): Number4
        => self.Transform(rotation);

    //==
    // # Number8
    //
    // Eight independent lanes: every operation below is lane-wise, with no
    // horizontal mixing except Dot, which sums all eight products.

    // Lane-wise sum.
    Add(left: Number8, right: Number8): Number8
        => (left.X0 + right.X0, left.X1 + right.X1, left.X2 + right.X2, left.X3 + right.X3,
                   left.X4 + right.X4, left.X5 + right.X5, left.X6 + right.X6, left.X7 + right.X7);

    // Lane-wise difference.
    Subtract(left: Number8, right: Number8): Number8
        => (left.X0 - right.X0, left.X1 - right.X1, left.X2 - right.X2, left.X3 - right.X3,
                   left.X4 - right.X4, left.X5 - right.X5, left.X6 - right.X6, left.X7 - right.X7);

    // Lane-wise product.
    Multiply(left: Number8, right: Number8): Number8
        => (left.X0 * right.X0, left.X1 * right.X1, left.X2 * right.X2, left.X3 * right.X3,
                   left.X4 * right.X4, left.X5 * right.X5, left.X6 * right.X6, left.X7 * right.X7);

    // Every lane scaled by a scalar.
    Multiply(left: Number8, scalar: Number): Number8
        => (left.X0 * scalar, left.X1 * scalar, left.X2 * scalar, left.X3 * scalar,
                   left.X4 * scalar, left.X5 * scalar, left.X6 * scalar, left.X7 * scalar);

    // Every lane scaled by a scalar, scalar on the left.
    Multiply(scalar: Number, right: Number8): Number8
        => (scalar * right.X0, scalar * right.X1, scalar * right.X2, scalar * right.X3,
                   scalar * right.X4, scalar * right.X5, scalar * right.X6, scalar * right.X7);

    // Lane-wise quotient. Precondition: no lane of right is zero.
    Divide(left: Number8, right: Number8): Number8
        => (left.X0 / right.X0, left.X1 / right.X1, left.X2 / right.X2, left.X3 / right.X3,
                   left.X4 / right.X4, left.X5 / right.X5, left.X6 / right.X6, left.X7 / right.X7);

    // Every lane divided by a scalar. Precondition: scalar is non-zero.
    Divide(left: Number8, scalar: Number): Number8
        => (left.X0 / scalar, left.X1 / scalar, left.X2 / scalar, left.X3 / scalar,
                   left.X4 / scalar, left.X5 / scalar, left.X6 / scalar, left.X7 / scalar);

    // The tuple with every lane negated.
    Negative(value: Number8): Number8
        => (-value.X0, -value.X1, -value.X2, -value.X3,
                   -value.X4, -value.X5, -value.X6, -value.X7);

    // Lane-wise absolute value.
    Abs(self: Number8): Number8
        => (self.X0.Abs, self.X1.Abs, self.X2.Abs, self.X3.Abs,
                   self.X4.Abs, self.X5.Abs, self.X6.Abs, self.X7.Abs);

    // Lane-wise square root. Precondition: no lane is negative.
    Sqrt(self: Number8): Number8
        => (self.X0.Sqrt, self.X1.Sqrt, self.X2.Sqrt, self.X3.Sqrt,
                   self.X4.Sqrt, self.X5.Sqrt, self.X6.Sqrt, self.X7.Sqrt);

    // The dot product: the sum of the products of corresponding lanes.
    Dot(self: Number8, right: Number8): Number
        => self.X0 * right.X0 + self.X1 * right.X1 + self.X2 * right.X2 + self.X3 * right.X3
         + self.X4 * right.X4 + self.X5 * right.X5 + self.X6 * right.X6 + self.X7 * right.X7;

    // The lane-wise maximum.
    Max(self: Number8, value2: Number8): Number8
        => (self.X0.Max(value2.X0), self.X1.Max(value2.X1),
                   self.X2.Max(value2.X2), self.X3.Max(value2.X3),
                   self.X4.Max(value2.X4), self.X5.Max(value2.X5),
                   self.X6.Max(value2.X6), self.X7.Max(value2.X7));

    // The lane-wise minimum.
    Min(self: Number8, value2: Number8): Number8
        => (self.X0.Min(value2.X0), self.X1.Min(value2.X1),
                   self.X2.Min(value2.X2), self.X3.Min(value2.X3),
                   self.X4.Min(value2.X4), self.X5.Min(value2.X5),
                   self.X6.Min(value2.X6), self.X7.Min(value2.X7));

    // The IHashable obligation: every lane folded into one digest.
    Hash(self: Number8): Integer
        => self.X0.Hash.CombineHash(self.X1.Hash).CombineHash(self.X2.Hash)
               .CombineHash(self.X3.Hash).CombineHash(self.X4.Hash)
               .CombineHash(self.X5.Hash).CombineHash(self.X6.Hash)
               .CombineHash(self.X7.Hash);
}
