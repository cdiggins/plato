//==
// # Matrices
//
// Sections, in order:
//  - Dense matrix members — the IMatrix, IAdditive and IScalable surface
//  - Sparse and banded matrix readings

library Matrices
{
    //==
    // # Dense matrix members — the IMatrix, IAdditive and IScalable surface
    //
    // The per-type bodies that make the concrete matrices of `matrices.types.plato`
    // genuine `IMatrix` implementations: the shape pair (RowCount, ColumnCount),
    // zero-based element access, and the element-wise IAdditive / IScalable
    // arithmetic. Without these the generated members throw, so the whole derived
    // surface in `numeric-structures.library.plato` (Trace, FrobeniusNorm,
    // Lerp, ...) is unreachable.
    //
    // Convention: see CONVENTIONS.md - Matrices. Rows are stored as vectors, so
    // element (r, c) is component c of row r, and `Row1` is row index 0. The rows
    // are themselves `IVector`s, so element-wise arithmetic is just the same
    // operation applied per row, and `ElementAt` bottoms out in `IVector.At`.
    //
    // `Add`, `Subtract`, `Multiply(scalar)` and `Divide(scalar)` for `Matrix3x2` and
    // `Matrix4x4` are NOT restated here — those two types carry their full
    // System.Numerics-compatible surface in `matrices-ops.library.plato`, and only
    // the members that file omits appear below.

    //==
    // # Matrix2x2

    // Two rows.
    RowCount(self: Matrix2x2): Integer => 2;

    // Two columns.
    ColumnCount(self: Matrix2x2): Integer => 2;

    // Element (row, column), zero-based; column indexes into the row vector.
    // Precondition: 0 <= row < 2 and 0 <= column < 2.
    ElementAt(self: Matrix2x2, row: Integer, column: Integer): Number
        => row == 0
            ? (column == 0 ? self.Row1.X : self.Row1.Y)
            : (column == 0 ? self.Row2.X : self.Row2.Y);

    // Element-wise sum.
    Add(a: Matrix2x2, b: Matrix2x2): Matrix2x2
        => (a.Row1 + b.Row1, a.Row2 + b.Row2);

    // Element-wise difference.
    Subtract(a: Matrix2x2, b: Matrix2x2): Matrix2x2
        => (a.Row1 - b.Row1, a.Row2 - b.Row2);

    // Every element negated (the additive inverse).
    Negative(self: Matrix2x2): Matrix2x2
        => (-self.Row1, -self.Row2);

    // Composition of two linear maps: applying the result is applying a then b,
    // which under the row-vector convention is each row of a carried through b.
    Multiply(a: Matrix2x2, b: Matrix2x2): Matrix2x2
        => (Number2(a.Row1.X * b.Row1.X + a.Row1.Y * b.Row2.X,
                    a.Row1.X * b.Row1.Y + a.Row1.Y * b.Row2.Y),
            Number2(a.Row2.X * b.Row1.X + a.Row2.Y * b.Row2.X,
                    a.Row2.X * b.Row1.Y + a.Row2.Y * b.Row2.Y));

    // Every element scaled.
    Multiply(self: Matrix2x2, scalar: Number): Matrix2x2
        => (self.Row1 * scalar, self.Row2 * scalar);

    // Every element divided.
    Divide(self: Matrix2x2, scalar: Number): Matrix2x2
        => (self.Row1 / scalar, self.Row2 / scalar);

    // Every element reduced modulo the scalar.
    Modulo(self: Matrix2x2, scalar: Number): Matrix2x2
        => (self.Row1 % scalar, self.Row2 % scalar);

    //==
    // # Matrix3x3

    // Three rows.
    RowCount(self: Matrix3x3): Integer => 3;

    // Three columns.
    ColumnCount(self: Matrix3x3): Integer => 3;

    // Element (row, column), zero-based.
    // Precondition: 0 <= row < 3 and 0 <= column < 3.
    ElementAt(self: Matrix3x3, row: Integer, column: Integer): Number
        => row == 0 ? self.RowElement(self.Row1, column)
         : (row == 1 ? self.RowElement(self.Row2, column)
                     : self.RowElement(self.Row3, column));

    // One component of a three-component row, by column index.
    RowElement(self: Matrix3x3, row: Number3, column: Integer): Number
        => column == 0 ? row.X : (column == 1 ? row.Y : row.Z);

    // Element-wise sum.
    Add(a: Matrix3x3, b: Matrix3x3): Matrix3x3
        => (a.Row1 + b.Row1, a.Row2 + b.Row2, a.Row3 + b.Row3);

    // Element-wise difference.
    Subtract(a: Matrix3x3, b: Matrix3x3): Matrix3x3
        => (a.Row1 - b.Row1, a.Row2 - b.Row2, a.Row3 - b.Row3);

    // Every element negated.
    Negative(self: Matrix3x3): Matrix3x3
        => (-self.Row1, -self.Row2, -self.Row3);

    // Every element scaled.
    Multiply(self: Matrix3x3, scalar: Number): Matrix3x3
        => (self.Row1 * scalar, self.Row2 * scalar, self.Row3 * scalar);

    // Every element divided.
    Divide(self: Matrix3x3, scalar: Number): Matrix3x3
        => (self.Row1 / scalar, self.Row2 / scalar, self.Row3 / scalar);

    // Every element reduced modulo the scalar.
    Modulo(self: Matrix3x3, scalar: Number): Matrix3x3
        => (self.Row1 % scalar, self.Row2 % scalar, self.Row3 % scalar);

    //==
    // # Matrix4x4
    //
    // Add, Subtract, Multiply(scalar) and Divide(scalar) live in
    // `matrices-ops.library.plato`; only the members that file leaves out are here.

    // Four rows.
    RowCount(self: Matrix4x4): Integer => 4;

    // Four columns.
    ColumnCount(self: Matrix4x4): Integer => 4;

    // Element (row, column), zero-based.
    // Precondition: 0 <= row < 4 and 0 <= column < 4.
    ElementAt(self: Matrix4x4, row: Integer, column: Integer): Number
        => row == 0 ? self.RowElement(self.Row1, column)
         : (row == 1 ? self.RowElement(self.Row2, column)
         : (row == 2 ? self.RowElement(self.Row3, column)
                     : self.RowElement(self.Row4, column)));

    // One component of a four-component row, by column index.
    RowElement(self: Matrix4x4, row: Number4, column: Integer): Number
        => column == 0 ? row.X : (column == 1 ? row.Y : (column == 2 ? row.Z : row.W));

    // Every element negated.
    Negative(self: Matrix4x4): Matrix4x4
        => (-self.Row1, -self.Row2, -self.Row3, -self.Row4);

    // Every element reduced modulo the scalar.
    Modulo(self: Matrix4x4, scalar: Number): Matrix4x4
        => (self.Row1 % scalar, self.Row2 % scalar, self.Row3 % scalar, self.Row4 % scalar);

    //==
    // # Matrix3x2 — the 2D affine map
    //
    // Add, Subtract, Multiply(scalar) and Divide(scalar) live in
    // `matrices-ops.library.plato`.

    // Three rows: the 2x2 linear block plus the translation row.
    RowCount(self: Matrix3x2): Integer => 3;

    // Two columns.
    ColumnCount(self: Matrix3x2): Integer => 2;

    // Element (row, column), zero-based.
    // Precondition: 0 <= row < 3 and 0 <= column < 2.
    ElementAt(self: Matrix3x2, row: Integer, column: Integer): Number
        => row == 0 ? (column == 0 ? self.Row1.X : self.Row1.Y)
         : (row == 1 ? (column == 0 ? self.Row2.X : self.Row2.Y)
                     : (column == 0 ? self.Row3.X : self.Row3.Y));

    // Every element negated, translation row included.
    Negative(self: Matrix3x2): Matrix3x2
        => (-self.Row1, -self.Row2, -self.Row3);

    // Every element reduced modulo the scalar.
    Modulo(self: Matrix3x2, scalar: Number): Matrix3x2
        => (self.Row1 % scalar, self.Row2 % scalar, self.Row3 % scalar);

    //==
    // # Matrix4x3 — the 3D affine map

    // Four rows: the 3x3 linear block plus the translation row.
    RowCount(self: Matrix4x3): Integer => 4;

    // Three columns.
    ColumnCount(self: Matrix4x3): Integer => 3;

    // Element (row, column), zero-based.
    // Precondition: 0 <= row < 4 and 0 <= column < 3.
    ElementAt(self: Matrix4x3, row: Integer, column: Integer): Number
        => row == 0 ? self.RowElement(self.Row1, column)
         : (row == 1 ? self.RowElement(self.Row2, column)
         : (row == 2 ? self.RowElement(self.Row3, column)
                     : self.RowElement(self.Row4, column)));

    // One component of a three-component row, by column index.
    RowElement(self: Matrix4x3, row: Number3, column: Integer): Number
        => column == 0 ? row.X : (column == 1 ? row.Y : row.Z);

    // Element-wise sum.
    Add(a: Matrix4x3, b: Matrix4x3): Matrix4x3
        => (a.Row1 + b.Row1, a.Row2 + b.Row2, a.Row3 + b.Row3, a.Row4 + b.Row4);

    // Element-wise difference.
    Subtract(a: Matrix4x3, b: Matrix4x3): Matrix4x3
        => (a.Row1 - b.Row1, a.Row2 - b.Row2, a.Row3 - b.Row3, a.Row4 - b.Row4);

    // Every element negated, translation row included.
    Negative(self: Matrix4x3): Matrix4x3
        => (-self.Row1, -self.Row2, -self.Row3, -self.Row4);

    // Every element scaled.
    Multiply(self: Matrix4x3, scalar: Number): Matrix4x3
        => (self.Row1 * scalar, self.Row2 * scalar, self.Row3 * scalar, self.Row4 * scalar);

    // Every element divided.
    Divide(self: Matrix4x3, scalar: Number): Matrix4x3
        => (self.Row1 / scalar, self.Row2 / scalar, self.Row3 / scalar, self.Row4 / scalar);

    // Every element reduced modulo the scalar.
    Modulo(self: Matrix4x3, scalar: Number): Matrix4x3
        => (self.Row1 % scalar, self.Row2 % scalar, self.Row3 % scalar, self.Row4 % scalar);

    //==
    // # MatrixN — runtime shape, row-major storage
    //
    // The shape travels with the value, so the binary operations take their
    // result shape from the left operand. Precondition on Add and Subtract: both
    // operands have the same shape.

    // The row count carried by the value.
    RowCount(self: MatrixN): Integer => self.NumRows;

    // The column count carried by the value.
    ColumnCount(self: MatrixN): Integer => self.NumColumns;

    // Element (row, column), zero-based, from the row-major component array.
    // Precondition: 0 <= row < NumRows and 0 <= column < NumColumns.
    ElementAt(self: MatrixN, row: Integer, column: Integer): Number
        => self.Components[row * self.NumColumns + column];

    // Spelled as explicit constructions rather than as bare tuples: a MatrixN
    // result that is still a tuple when the next expression reads a field off it
    // renders as a call on the field name (CS1955) once the shipping recipe turns
    // field reads into methods. Naming the type gives the field read something
    // to bind to.

    // Element-wise sum, in the shape of `a`.
    Add(a: MatrixN, b: MatrixN): MatrixN
        => MatrixN(a.NumRows, a.NumColumns, a.Components.Zip(b.Components, (x, y) => x + y));

    // Element-wise difference, in the shape of `a`.
    Subtract(a: MatrixN, b: MatrixN): MatrixN
        => MatrixN(a.NumRows, a.NumColumns, a.Components.Zip(b.Components, (x, y) => x - y));

    // Every element negated.
    Negative(self: MatrixN): MatrixN
        => MatrixN(self.NumRows, self.NumColumns, self.Components.Map(x => -x));

    // Every element scaled.
    Multiply(self: MatrixN, scalar: Number): MatrixN
        => MatrixN(self.NumRows, self.NumColumns, self.Components.Map(x => x * scalar));

    // Every element divided.
    Divide(self: MatrixN, scalar: Number): MatrixN
        => MatrixN(self.NumRows, self.NumColumns, self.Components.Map(x => x / scalar));

    // Every element reduced modulo the scalar.
    Modulo(self: MatrixN, scalar: Number): MatrixN
        => MatrixN(self.NumRows, self.NumColumns, self.Components.Map(x => x % scalar));

    //==
    // # Sparse and banded matrix readings
    //
    // Element access and the shape statistics of the storage forms declared in
    // `matrices.types.plato`. Element access on a sparse matrix is a sum over
    // the entries naming that position — the coordinate-list invariant — so a
    // position with no entry reads as zero and duplicate entries accumulate, and
    // concatenating two entry lists is exactly matrix addition.
    //
    // Only relations that follow from the field definitions appear here: factorizing
    // or solving these systems needs a numerical kernel this vocabulary does not
    // declare.

    //==
    // # Sparse element access
    //
    // https://en.wikipedia.org/wiki/Sparse_matrix#Coordinate_list_(COO)

    // The value at a zero-based position: the sum of the entries naming it,
    // and zero when no entry does.
    ElementAt(self: SparseMatrix, row: Integer, column: Integer): Number
        => self.Entries.Reduce(0.0, (total, e) =>
            total + (e.Row == row && e.Column == column ? e.Value : 0.0));

    // True when the position carries at least one stored entry. A stored entry
    // whose value is zero still counts as stored.
    IsStored(self: SparseMatrix, row: Integer, column: Integer): Boolean
        => self.Entries.Any(e => e.Row == row && e.Column == column);

    // True when the entry lies on the main diagonal.
    IsDiagonal(self: SparseMatrixEntry): Boolean
        => self.Row == self.Column;

    // True when the entry stores a zero: a position the coordinate list names
    // but does not actually populate, which counts as stored but not as a
    // non-zero.
    IsExplicitZero(self: SparseMatrixEntry): Boolean
        => self.Value == 0.0;

    // The signed diagonal offset of the entry: zero on the main diagonal,
    // positive above it, negative below.
    DiagonalOffset(self: SparseMatrixEntry): Integer
        => self.Column - self.Row;

    //==
    // # Sparse shape statistics

    // The number of stored entries, which is not the number of non-zeros when
    // entries repeat a position or store an explicit zero.
    StoredCount(self: SparseMatrix): Integer
        => self.Entries.Count;

    // The number of positions the dense form would occupy.
    DenseCount(self: SparseMatrix): Integer
        => self.NumRows * self.NumColumns;

    // The stored fraction of the dense shape, in [0, 1] for a matrix with no
    // repeated positions. Precondition: the matrix has a non-empty shape.
    // (https://en.wikipedia.org/wiki/Sparse_matrix)
    FillFraction(self: SparseMatrix): Number
        => self.StoredCount.ToNumber / self.DenseCount.ToNumber;

    // The complement of FillFraction: the fraction of the dense shape left
    // implicit. This is the number usually quoted as "sparsity".
    Sparsity(self: SparseMatrix): Number
        => 1.0 - self.FillFraction;

    // True when the matrix has as many rows as columns.
    IsSquareShape(self: SparseMatrix): Boolean
        => self.NumRows == self.NumColumns;

    // True when no entry lies off the main diagonal.
    IsDiagonalMatrix(self: SparseMatrix): Boolean
        => self.Entries.All(e => e.IsDiagonal);

    // The trace: the sum of the diagonal entries.
    // (https://en.wikipedia.org/wiki/Trace_(linear_algebra))
    DiagonalSum(self: SparseMatrix): Number
        => self.Entries.Reduce(0.0, (total, e) =>
            total + (e.IsDiagonal ? e.Value : 0.0));

    //==
    // # Banded shape
    //
    // https://en.wikipedia.org/wiki/Band_matrix

    // The width of the stored band: the lower and upper half-bandwidths plus
    // the diagonal itself. This is the per-row stride of Values.
    BandWidth(self: BandedMatrix): Integer
        => self.LowerBandwidth + self.UpperBandwidth + 1;

    // True when the position falls inside the band, and so may be non-zero.
    IsInBand(self: BandedMatrix, row: Integer, column: Integer): Boolean
        => column - row >= -self.LowerBandwidth
        && column - row <= self.UpperBandwidth;

    // The index into Values of a position inside the band. Precondition:
    // IsInBand holds for the position.
    BandOffset(self: BandedMatrix, row: Integer, column: Integer): Integer
        => row * self.BandWidth + (column - row + self.LowerBandwidth);

    // The value at a zero-based position: the banded slot when the position is
    // inside the band, and zero outside it.
    ElementAt(self: BandedMatrix, row: Integer, column: Integer): Number
        => self.IsInBand(row, column)
            ? self.Values[self.BandOffset(row, column)]
            : 0.0;

    // The number of slots the band occupies, including the off-matrix corners
    // the layout stores and ignores. This is the expected length of Values.
    BandSlotCount(self: BandedMatrix): Integer
        => self.NumRows * self.BandWidth;

    // True when the matrix has as many rows as columns.
    IsSquareShape(self: BandedMatrix): Boolean
        => self.NumRows == self.NumColumns;

    // True when the band is the main diagonal alone.
    IsDiagonalMatrix(self: BandedMatrix): Boolean
        => self.LowerBandwidth == 0 && self.UpperBandwidth == 0;

    // True when the band is one off-diagonal wide on each side.
    // (https://en.wikipedia.org/wiki/Tridiagonal_matrix)
    IsTridiagonal(self: BandedMatrix): Boolean
        => self.LowerBandwidth == 1 && self.UpperBandwidth == 1;

    // True when nothing is stored above the diagonal.
    // (https://en.wikipedia.org/wiki/Triangular_matrix)
    IsLowerTriangular(self: BandedMatrix): Boolean
        => self.UpperBandwidth == 0;

    // True when nothing is stored below the diagonal.
    IsUpperTriangular(self: BandedMatrix): Boolean
        => self.LowerBandwidth == 0;
}
