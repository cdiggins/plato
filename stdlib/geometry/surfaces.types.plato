//==
// # Surfaces
//
// Sections, in order:
//  - Generated surfaces
//  - ISurface patches and control nets
//  - Trimmed, sampled, topological, and subdivision surfaces

//==
// # Generated surfaces
//
// Surfaces defined by carrying a generator curve through space: revolve,
// extrude, rule, loft, sweep, tube, and offset. Generator curves referenced as
// concepts (ICurve2D, ICurve3D) are supplied by any concrete curve type, so these
// types compose with everything in the curve files. Evaluation lives in
// `surfaces.library.plato`.

//==
// # Generated surfaces

// The surface swept by revolving a profile curve about an axis
// (https://en.wikipedia.org/wiki/Surface_of_revolution). The profile's X
// coordinate is the radial distance from the axis and its Y coordinate runs
// along the axis; Angles is the sweep (a full turn closes the surface in U).
type SurfaceOfRevolution
    implements IParametricSurface
{
    Profile: ICurve2D;
    Axis: InfiniteLine3D;
    Angles: AngleInterval;
}

// The surface swept by translating a profile curve along a straight direction
// for a distance: U follows the profile, V the extrusion.
type ExtrudedSurface
    implements IParametricSurface
{
    Profile: ICurve3D;
    Direction: Direction3D;
    Distance: Number;
}

// The ruled surface between two curves: straight line segments join Start and
// End at equal parameter values (https://en.wikipedia.org/wiki/Ruled_surface).
// U along the curves, V across the rulings.
type RuledSurface
    implements IParametricSurface
{
    Start: ICurve3D;
    End: ICurve3D;
}

// The surface interpolating an ordered stack of cross-section polylines:
// U runs around each section, V across sections. Sections must share point
// counts; Closed wraps the last section back to the first
// (https://en.wikipedia.org/wiki/Loft_(3D)).
type LoftedSurface
    implements IParametricSurface, IDeformable3D
{
    Sections: Array<Polyline3D>;
    Closed: Boolean;
}

// The surface swept by a 2D profile carried along a 3D path in the path's
// rotation-minimizing frame: U follows the profile, V the path.
type SweptSurface
    implements IParametricSurface
{
    Profile: ICurve2D;
    Path: ICurve3D;
}

// A circular-section pipe around a path: the sweep of a circle of radius
// Radius held normal to the path (U around the circle, V along the path)
// (https://en.wikipedia.org/wiki/Channel_surface).
type TubeSurface
    implements IParametricSurface
{
    Path: ICurve3D;
    Radius: Number;
}

// The surface displaced from a base surface by a constant Distance along its
// normal (positive Distance follows the base orientation)
// (https://en.wikipedia.org/wiki/Parallel_curve).
type OffsetSurface
    implements IParametricSurface
{
    Base: IParametricSurface;
    Distance: Number;
}

//==
// # ISurface patches and control nets
//
// The rectangular surface pieces: corner-interpolated and control-net patches
// (Bezier, B-spline, NURBS), the flat and spherical windows, and the Coons blend
// of four boundary curves (https://en.wikipedia.org/wiki/Parametric_surface).
// Control nets use Array2D with the U direction along columns and the V
// direction along rows. Evaluation lives in `surfaces.library.plato`.

//==
// # Patches and control nets

// The bilinearly interpolated patch over four corner points: the simplest
// curved quadrilateral surface
// (https://en.wikipedia.org/wiki/Bilinear_interpolation).
type BilinearPatch
    implements IParametricSurface, IDeformable3D
{
    P00: Point3D;
    P10: Point3D;
    P01: Point3D;
    P11: Point3D;
}

// A tensor-product Bezier patch: U degree = column count - 1, V degree =
// row count - 1 (https://en.wikipedia.org/wiki/B%C3%A9zier_surface).
// Interpolates the four corner control points.
type BezierPatch
    implements IParametricSurface, IDeformable3D
{
    ControlPoints: Array2D<Point3D>;
}

// A tensor-product B-spline surface. UKnots must hold column count + UDegree
// + 1 values, and VKnots row count + VDegree + 1 values
// (https://en.wikipedia.org/wiki/B-spline).
type BSplineSurface
    implements IParametricSurface, IDeformable3D
{
    ControlPoints: Array2D<Point3D>;
    UDegree: Integer;
    VDegree: Integer;
    UKnots: KnotVector;
    VKnots: KnotVector;
}

// A non-uniform rational B-spline surface: a B-spline surface with per-point
// Weights (same dimensions as ControlPoints)
// (https://en.wikipedia.org/wiki/Non-uniform_rational_B-spline). The CAD
// interchange standard; represents quadrics exactly.
type NurbsSurface
    implements IParametricSurface, IDeformable3D
{
    ControlPoints: Array2D<Point3D>;
    Weights: Array2D<Number>;
    UDegree: Integer;
    VDegree: Integer;
    UKnots: KnotVector;
    VKnots: KnotVector;
}

// A rectangular piece of a plane: (u, v) in Domain maps to the frame origin
// plus u along the frame's X axis and v along its Y axis.
type PlanarPatch
    implements IParametricSurface
{
    Frame: Frame3D;
    Domain: Bounds2D;
}

// A Coons patch: the surface blended from four boundary curves
// (https://en.wikipedia.org/wiki/Coons_patch). The curves must meet at the
// patch corners (Bottom/Top run in U, Left/Right run in V).
type CoonsPatch
    implements IParametricSurface
{
    Bottom: ICurve3D;
    Right: ICurve3D;
    Top: ICurve3D;
    Left: ICurve3D;
}

// A rectangular region of a sphere bounded by azimuth and inclination
// intervals (a latitude/longitude window).
type SphericalPatch
    implements IParametricSurface
{
    Sphere: Sphere;
    Azimuths: AngleInterval;
    Inclinations: AngleInterval;
}

//==
// # Trimmed, sampled, topological, and subdivision surfaces
//
// The surfaces that are not rectangular UV patches: a parametric surface
// restricted by trim loops, a sampled elevation field, the one-sided Mobius
// band, and the limit surface of a control mesh under a subdivision scheme.
// Evaluation of the Mobius band lives in `surfaces.library.plato`; the others
// are declarations only.

//==
// # Bounded and sampled surfaces

// A parametric surface restricted to a region of its UV domain: OuterLoop is
// a closed counter-clockwise polyline in UV space, and Holes are closed
// clockwise loops removed from it. Not a rectangular patch, so only ISurface.
type TrimmedSurface
    implements ISurface
{
    Base: IParametricSurface;
    OuterLoop: Polyline2D;
    Holes: Array<Polyline2D>;
}

// A sampled elevation surface: Heights holds regular samples over the ground
// rectangle Domain in the XY plane (columns along X, rows along Y), with
// bilinear interpolation between samples
// (https://en.wikipedia.org/wiki/Heightmap). Terrain and displacement data.
type HeightField
    implements IHeightFieldSurface
{
    Heights: Array2D<Number>;
    Domain: Bounds2D;
}

//==
// # Topological and subdivision surfaces

// A Mobius band: a strip of the given Width whose centerline circle of radius
// Radius lies in the frame's XY plane, twisted by HalfTwistCount half-turns
// over one lap (https://en.wikipedia.org/wiki/M%C3%B6bius_strip). An odd count
// yields the one-sided surface.
type MobiusStrip
    implements IParametricSurface
{
    Frame: Frame3D;
    Radius: Number;
    Width: Number;
    HalfTwistCount: Integer;
}

// The subdivision scheme applied to a control mesh
// (https://en.wikipedia.org/wiki/Subdivision_surface).
type SubdivisionScheme = CatmullClark | Loop | DooSabin;

// The limit surface of a control mesh under a subdivision scheme, evaluated
// (or approximated) at the given refinement level
// (https://en.wikipedia.org/wiki/Subdivision_surface).
type SubdivisionSurface
    implements ISurface, IDeformable3D
{
    ControlMesh: PolygonMesh3D;
    Scheme: SubdivisionScheme;
    Levels: Integer;
}
