//==
// # Polygons
//
// Sections, in order:
//  - Polygons in the plane
//  - Polylines
//  - Polygons in space and the solids swept from them

//==
// # Polygons in the plane
//
// Point-list regions of the plane (https://en.wikipedia.org/wiki/Polygon): the simple
// polygon, its strictly convex refinement, the region with holes, the multi-polygon
// set Boolean operations return, and the regular star. Winding convention:
// counter-clockwise boundaries enclose positive area; holes wind opposite to the
// boundary that contains them.

// A simple closed polygon: Points are the boundary vertices in order, the last
// implicitly joined to the first. Invariants: at least three vertices, no edge
// crossings; counter-clockwise winding encloses positive area.
// (https://en.wikipedia.org/wiki/Simple_polygon)
type Polygon2D
    implements IGeometry2D, IClosedShape, IConnected, IArea, IBounded2D, IPointSet2D, ICentroid2D, IContainsPoint2D, INearestPoint2D, IDeformable2D
{
    Points: Array<Point2D>;
}

// A polygon whose vertices are in strictly convex position, counter-clockwise.
// The stronger invariant unlocks constant-cost support mapping and logarithmic
// containment tests. (https://en.wikipedia.org/wiki/Convex_polygon)
type ConvexPolygon2D
    implements IGeometry2D, IClosedShape, IConvexShape, IConnected, IArea, IBounded2D, IPointSet2D, ICentroid2D, IContainsPoint2D, INearestPoint2D, ISupport2D, IDeformable2D
{
    Points: Array<Point2D>;
}

// A polygonal region with holes: the area inside Boundary and outside every
// hole. Invariants: holes lie strictly inside the boundary, are mutually
// disjoint, and wind opposite to it.
// (https://en.wikipedia.org/wiki/Polygon_with_holes)
type PolygonWithHoles2D
    implements IGeometry2D, IClosedShape, IConnected, IArea, IBounded2D, ICentroid2D, IContainsPoint2D, IDeformable2D
{
    Boundary: Polygon2D;
    Holes: Array<Polygon2D>;
}

// A multi-polygon region: the union of mutually disjoint components. The result
// shape of Boolean operations over polygons; possibly disconnected, possibly
// empty. (https://en.wikipedia.org/wiki/Boolean_operations_on_polygons)
type PolygonSet2D
    implements IGeometry2D, IClosedShape, IArea, IBounded2D, IContainsPoint2D, IDeformable2D
{
    Polygons: Array<PolygonWithHoles2D>;
}

// A star polygon with PointCount tips alternating between OuterRadius and
// InnerRadius vertices about Center (2 * PointCount vertices in all); Rotation
// turns the first tip away from +X (https://en.wikipedia.org/wiki/Star_polygon).
// Invariants: PointCount >= 3, 0 < InnerRadius <= OuterRadius.
type RegularStar2D
    implements IGeometry2D, IClosedShape, IConnected, IArea, IBounded2D, ICentroid2D, IContainsPoint2D
{
    Center: Point2D;
    OuterRadius: Number;
    InnerRadius: Number;
    PointCount: Integer;
    Rotation: Angle;
}

//==
// # Polylines
//
// Open and closed vertex chains
// (https://en.wikipedia.org/wiki/Polygonal_chain) in the plane, in space, and in
// N dimensions. The `Closed` flag decides whether the wrap-around edge from the last
// vertex back to the first counts.

// A chain of straight segments joining consecutive Points. When Closed, an
// extra segment joins the last point back to the first. At least two points.
type Polyline2D
    implements IGeometry2D, IConnected, IBounded2D, ILength, IPointSet2D, IDeformable2D
{
    Points: Array<Point2D>;
    Closed: Boolean;
}

// A chain of straight segments in space. When Closed, an extra segment joins
// the last point back to the first.
type Polyline3D
    implements IGeometry3D, IConnected, IBounded3D, ILength, IPointSet3D, IDeformable3D
{
    Points: Array<Point3D>;
    Closed: Boolean;
}

// A chain of straight segments in N-dimensional space. When Closed, an extra
// segment joins the last point back to the first. All points share one arity.
type PolylineN
    implements IGeometryND, IConnected, ILength
{
    Points: Array<PointN>;
    Closed: Boolean;
}

//==
// # Polygons in space and the solids swept from them
//
// The planar polygon embedded in 3D, whose normal follows the right-hand rule around
// its winding, and the two solids obtained from it: the prism swept by translating
// the polygon along a vector, and the pyramid coned over it from an apex.

//==
// # Polygons in space

// A planar polygon embedded in 3D: Points are coplanar boundary vertices in
// order, the last implicitly joined to the first. The normal follows the
// right-hand rule around the winding.
type Polygon3D
    implements IGeometry3D, IClosedShape, IConnected, IManifold, IOrientable, IArea, IBounded3D, IPointSet3D, ICentroid3D, INearestPoint3D, IDeformable3D
{
    Points: Array<Point3D>;
}

//==
// # Polygon-derived solids

// The solid swept by translating Base along Offset: a general prism
// (https://en.wikipedia.org/wiki/Prism_(geometry)). Oblique when Offset is not
// perpendicular to the base plane; convex when the base is convex.
// NOT Deformable3D: the type stores a sweep VECTOR, and a point mapping has no
// principled action on a vector — the image of a translational sweep under a
// nonlinear mapping is not a translational sweep.
type Prism3D
    implements IGeometry3D, IClosedShape, IConnected, IVolume, IBounded3D, ICentroid3D, IContainsPoint3D
{
    Base: Polygon3D;
    Offset: Vector3D;
}

// The solid cone over a polygon: all segments from points of Base to Apex
// (https://en.wikipedia.org/wiki/Pyramid_(geometry)). Degenerate when Apex lies
// in the base plane.
type Pyramid3D
    implements IGeometry3D, IClosedShape, IConnected, IVolume, IBounded3D, ICentroid3D, IContainsPoint3D, IDeformable3D
{
    Base: Polygon3D;
    Apex: Point3D;
}
