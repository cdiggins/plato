//==
// # Noise
//
// Sections, in order:
//  - Noise — the shared lattice vocabulary
//  - Basis noise evaluation
//  - Fractal noise evaluation
//  - Warped and derived noise evaluation

library Noise
{
    //==
    // # Noise — the shared lattice vocabulary
    //
    // The hashing and lattice-gradient primitives every noise field in
    // the basis, fractal and warped sections are written against. Nothing
    // here is a field itself: these are the deterministic pseudo-random building
    // blocks, kept in one place so that two noises given the same Seed and the same
    // lattice cell agree.
    //
    // The pseudo-randomness is integer hashing, not a random number generator: there
    // is no state, and `LatticeHash(seed, i, j)` is a pure function of its three
    // arguments. The exact constants are NOT part of the contract — values will
    // differ between library versions — but within one version every backend must
    // agree, which is why the mixing is written in whole-number arithmetic that
    // wraps rather than in floating point.
    //
    // Convention: Frequency scales the input domain, so a lattice cell is
    // 1 / Frequency wide, and higher frequency means smaller features. Scalar noises
    // range over [-1, 1] unless a doc comment says otherwise.

    //==
    // # Integer hashing

    // A whole-number avalanche mix: one bit of input changes about half the
    // output bits. The xor-shift-multiply shape of the Murmur3 finalizer. The
    // multiplications are expected to wrap.
    NoiseMix(x: Integer): Integer {
        var h1 = x.BitwiseXor(x.ShiftRight(15)) * 668265261;
        var h2 = h1.BitwiseXor(h1.ShiftRight(13)) * 374761393;
        return h2.BitwiseXor(h2.ShiftRight(16));
    }

    // The pseudo-random integer belonging to planar lattice cell (ix, iy) of the
    // field with this seed. Each coordinate is mixed before folding so that
    // neighbouring cells do not share low bits.
    LatticeHash(seed: Integer, ix: Integer, iy: Integer): Integer
        => NoiseMix(seed.CombineHash(NoiseMix(ix)).CombineHash(NoiseMix(iy)));

    // The pseudo-random integer belonging to spatial lattice cell (ix, iy, iz).
    LatticeHash(seed: Integer, ix: Integer, iy: Integer, iz: Integer): Integer
        => NoiseMix(seed.CombineHash(NoiseMix(ix)).CombineHash(NoiseMix(iy)).CombineHash(NoiseMix(iz)));

    //==
    // # Hash to number
    //
    // The low 24 bits are taken so the value is non-negative whatever the sign
    // convention of the host's shift, and 24 bits is exactly the mantissa a
    // single-precision backend can carry without rounding two hashes together.

    // The hash as a number in [0, 1).
    HashToUnit(h: Integer): Number
        => h.BitwiseAnd(16777215).ToNumber / 16777216.0;

    // The hash as a number in [-1, 1).
    HashToSigned(h: Integer): Number
        => HashToUnit(h) * 2.0 - 1.0;

    //==
    // # ILattice gradients
    //
    // Gradient (Perlin-family) noise needs a unit vector per lattice cell rather
    // than a scalar. Both are drawn from the hash by inverse transform sampling,
    // which is uniform over the circle and over the sphere respectively — the
    // classic 8- and 12-entry gradient tables are an optimization, not the
    // definition, and a table costs a branch chain in a language without arrays
    // of constants.

    // The unit gradient of planar lattice cell (ix, iy): the hash read as an
    // angle.
    LatticeGradient2D(seed: Integer, ix: Integer, iy: Integer): Vector2D {
        var a = HashToUnit(LatticeHash(seed, ix, iy)).Turns;
        return (a.Cos, a.Sin);
    }

    // The unit gradient of spatial lattice cell (ix, iy, iz): a uniform point on
    // the sphere, height sampled first (Archimedes' theorem) and the azimuth
    // taken from a second mix of the same hash.
    LatticeGradient3D(seed: Integer, ix: Integer, iy: Integer, iz: Integer): Vector3D {
        var h = LatticeHash(seed, ix, iy, iz);
        var z = HashToSigned(h);
        var r = (1.0 - z * z).Sqrt;
        var a = HashToUnit(NoiseMix(h)).Turns;
        return (r * a.Cos, r * a.Sin, z);
    }

    //==
    // # Feature points
    //
    // Cellular (Worley) noise scatters one feature point per lattice cell.
    // Jitter in [0, 1] moves it from the cell centre (0) to anywhere in the cell
    // (1); the two (three) coordinates come from independent mixes of the cell
    // hash.

    // The feature point of planar cell (ix, iy), in cell-local coordinates
    // (the returned offsets are relative to the cell's lower corner).
    FeatureOffset2D(seed: Integer, ix: Integer, iy: Integer, jitter: Number): Vector2D {
        var h = LatticeHash(seed, ix, iy);
        var hx = HashToUnit(h);
        var hy = HashToUnit(NoiseMix(h));
        return (0.5 + (hx - 0.5) * jitter, 0.5 + (hy - 0.5) * jitter);
    }

    // The feature point of spatial cell (ix, iy, iz), in cell-local coordinates.
    FeatureOffset3D(seed: Integer, ix: Integer, iy: Integer, iz: Integer, jitter: Number): Vector3D {
        var h = LatticeHash(seed, ix, iy, iz);
        var hx = HashToUnit(h);
        var hy = HashToUnit(NoiseMix(h));
        var hz = HashToUnit(NoiseMix(NoiseMix(h)));
        return (0.5 + (hx - 0.5) * jitter,
                0.5 + (hy - 0.5) * jitter,
                0.5 + (hz - 0.5) * jitter);
    }

    //==
    // # Distance metrics

    // The distance between two planar offsets under the chosen Worley metric.
    // Minkowski is the p = 3 member of the family, the usual stand-in for the
    // "rounded Manhattan" look.
    // https://en.wikipedia.org/wiki/Minkowski_distance
    WorleyLength(d: Vector2D, metric: WorleyDistance): Number
        => match (metric) {
            Euclidean => d.Length;
            Manhattan => d.X.Abs + d.Y.Abs;
            Chebyshev => d.X.Abs.Max(d.Y.Abs);
            Minkowski => (d.X.Abs.Pow(3.0) + d.Y.Abs.Pow(3.0)).Pow(1.0 / 3.0);
        };

    // The distance between two spatial offsets under the chosen Worley metric.
    WorleyLength(d: Vector3D, metric: WorleyDistance): Number
        => match (metric) {
            Euclidean => d.Length;
            Manhattan => d.X.Abs + d.Y.Abs + d.Z.Abs;
            Chebyshev => d.X.Abs.Max(d.Y.Abs).Max(d.Z.Abs);
            Minkowski => (d.X.Abs.Pow(3.0) + d.Y.Abs.Pow(3.0) + d.Z.Abs.Pow(3.0)).Pow(1.0 / 3.0);
        };

    //==
    // # Feature combination

    // The two nearest feature distances combined as the chosen feature asks.
    // Precondition: f1 <= f2.
    WorleyCombine(f1: Number, f2: Number, feature: WorleyFeature): Number
        => match (feature) {
            F1 => f1;
            F2 => f2;
            F2MinusF1 => f2 - f1;
            F1PlusF2 => f1 + f2;
        };

    // The smallest of an array of distances.
    NearestDistance(distances: Array<Number>): Number
        => distances.Reduce(Number.MaxValue, (acc, d) => acc.Min(d));

    // The smallest distance strictly greater than `nearest` — the second feature
    // distance, given the first. Ties with `nearest` are skipped, so a point
    // equidistant from two features reports the next distinct feature.
    SecondNearestDistance(distances: Array<Number>, nearest: Number): Number
        => distances.Reduce(Number.MaxValue, (acc, d) => d <= nearest ? acc : acc.Min(d));

    //==
    // # Basis dispatch
    //
    // The fractal and warped noises are parameterized by a `NoiseBasis` case, not
    // by a basis field value, so they need one entry point turning a case plus
    // (seed, frequency) into a sample. Worley and Gabor carry parameters the
    // enumeration cannot express; neutral choices stand in, and a field wanting
    // others uses that basis type directly rather than through a fractal.
    // Every case is remapped to the same nominal [-1, 1] so octaves of different
    // bases sum sensibly; the White and Worley shifts are not exact at the ends.

    // A sample of the named basis noise at the given seed and frequency.
    BasisValue2D(basis: NoiseBasis, seed: Integer, frequency: Number, p: Point2D): Number
        => match (basis) {
            White => WhiteNoise2D(seed).Eval(p) * 2.0 - 1.0;
            Value => ValueNoise2D(seed, frequency).Eval(p);
            Perlin => PerlinNoise2D(seed, frequency).Eval(p);
            Simplex => SimplexNoise2D(seed, frequency).Eval(p);
            Worley => 1.0 - 2.0 * WorleyNoise2D(seed, frequency, 1.0,
                                                WorleyDistance.Euclidean, WorleyFeature.F1).Eval(p);
            Gabor => GaborNoise2D(seed, frequency, 0.0.Turns, 1.0, 0.0).Eval(p);
        };

    // A sample of the named basis noise at the given seed and frequency.
    BasisValue3D(basis: NoiseBasis, seed: Integer, frequency: Number, p: Point3D): Number
        => match (basis) {
            White => WhiteNoise3D(seed).Eval(p) * 2.0 - 1.0;
            Value => ValueNoise3D(seed, frequency).Eval(p);
            Perlin => PerlinNoise3D(seed, frequency).Eval(p);
            Simplex => SimplexNoise3D(seed, frequency).Eval(p);
            Worley => 1.0 - 2.0 * WorleyNoise3D(seed, frequency, 1.0,
                                                WorleyDistance.Euclidean, WorleyFeature.F1).Eval(p);
            Gabor => GaborNoise3D(seed, frequency, Direction3D(Vector3D.UnitZ), 1.0, 0.0).Eval(p);
        };

    //==
    // # Basis noise evaluation
    //
    // The `Eval` bodies for the single-octave noise fields of
    // `noise.types.plato`, written against the shared lattice vocabulary above
    // (hashing, gradients, feature points, metrics). The
    // fractal sums below layer these.
    //
    // Every body multiplies the query point by Frequency first, so a lattice cell is
    // one unit wide in the working coordinates and `Floor` gives the cell index.
    // Scalar output ranges over [-1, 1] except white noise, which is [0, 1) as its
    // declaration says.
    //
    // The gradient noises interpolate with `SmootherStep` (Perlin's quintic fade),
    // not `SmoothStep`: the cubic leaves a second-derivative discontinuity at the
    // lattice planes that shows up as banding once the field is differentiated, which
    // the fractal and warped noises do constantly.

    //==
    // # White noise
    //
    // No lattice and no interpolation: the coordinates themselves are hashed, so
    // two points however close have unrelated values.

    // The uncorrelated value at this point, in [0, 1).
    Eval(self: WhiteNoise2D, p: Point2D): Number
        => HashToUnit(LatticeHash(self.Seed, p.X.Hash, p.Y.Hash));

    // The uncorrelated value at this point, in [0, 1).
    Eval(self: WhiteNoise3D, p: Point3D): Number
        => HashToUnit(LatticeHash(self.Seed, p.X.Hash, p.Y.Hash, p.Z.Hash));

    //==
    // # Value noise
    //
    // One random value per lattice corner, faded between them. Cheap, and the
    // extrema sit ON the lattice, which is the lattice artifact the type's doc
    // comment warns about.

    // The faded bilinear blend of the four surrounding corner values.
    Eval(self: ValueNoise2D, p: Point2D): Number {
        var x = p.X * self.Frequency;
        var y = p.Y * self.Frequency;
        var i = x.Floor.ToInteger;
        var j = y.Floor.ToInteger;
        var u = (x - x.Floor).SmootherStep;
        var v = (y - y.Floor).SmootherStep;
        var c00 = HashToSigned(LatticeHash(self.Seed, i, j));
        var c10 = HashToSigned(LatticeHash(self.Seed, i + 1, j));
        var c01 = HashToSigned(LatticeHash(self.Seed, i, j + 1));
        var c11 = HashToSigned(LatticeHash(self.Seed, i + 1, j + 1));
        return c00.Lerp(c10, u).Lerp(c01.Lerp(c11, u), v);
    }

    // The faded trilinear blend of the eight surrounding corner values.
    Eval(self: ValueNoise3D, p: Point3D): Number {
        var x = p.X * self.Frequency;
        var y = p.Y * self.Frequency;
        var z = p.Z * self.Frequency;
        var i = x.Floor.ToInteger;
        var j = y.Floor.ToInteger;
        var k = z.Floor.ToInteger;
        var u = (x - x.Floor).SmootherStep;
        var v = (y - y.Floor).SmootherStep;
        var w = (z - z.Floor).SmootherStep;
        var c000 = HashToSigned(LatticeHash(self.Seed, i, j, k));
        var c100 = HashToSigned(LatticeHash(self.Seed, i + 1, j, k));
        var c010 = HashToSigned(LatticeHash(self.Seed, i, j + 1, k));
        var c110 = HashToSigned(LatticeHash(self.Seed, i + 1, j + 1, k));
        var c001 = HashToSigned(LatticeHash(self.Seed, i, j, k + 1));
        var c101 = HashToSigned(LatticeHash(self.Seed, i + 1, j, k + 1));
        var c011 = HashToSigned(LatticeHash(self.Seed, i, j + 1, k + 1));
        var c111 = HashToSigned(LatticeHash(self.Seed, i + 1, j + 1, k + 1));
        var lo = c000.Lerp(c100, u).Lerp(c010.Lerp(c110, u), v);
        var hi = c001.Lerp(c101, u).Lerp(c011.Lerp(c111, u), v);
        return lo.Lerp(hi, w);
    }

    //==
    // # Perlin gradient noise
    //
    // One random unit GRADIENT per lattice corner; each corner contributes the
    // dot product of its gradient with the offset to the query point, so the
    // field is zero at every corner. The trailing constants normalize the
    // theoretical extremum (sqrt(N)/2 for unit gradients in N dimensions) back to
    // one. https://en.wikipedia.org/wiki/Perlin_noise

    // The faded blend of the four corner gradient contributions.
    Eval(self: PerlinNoise2D, p: Point2D): Number {
        var x = p.X * self.Frequency;
        var y = p.Y * self.Frequency;
        var i = x.Floor.ToInteger;
        var j = y.Floor.ToInteger;
        var dx = x - x.Floor;
        var dy = y - y.Floor;
        var u = dx.SmootherStep;
        var v = dy.SmootherStep;
        var n00 = LatticeGradient2D(self.Seed, i, j).Dot((dx, dy));
        var n10 = LatticeGradient2D(self.Seed, i + 1, j).Dot((dx - 1.0, dy));
        var n01 = LatticeGradient2D(self.Seed, i, j + 1).Dot((dx, dy - 1.0));
        var n11 = LatticeGradient2D(self.Seed, i + 1, j + 1).Dot((dx - 1.0, dy - 1.0));
        return n00.Lerp(n10, u).Lerp(n01.Lerp(n11, u), v) * Number.SqrtTwo;
    }

    // The faded blend of the eight corner gradient contributions.
    Eval(self: PerlinNoise3D, p: Point3D): Number {
        var x = p.X * self.Frequency;
        var y = p.Y * self.Frequency;
        var z = p.Z * self.Frequency;
        var i = x.Floor.ToInteger;
        var j = y.Floor.ToInteger;
        var k = z.Floor.ToInteger;
        var dx = x - x.Floor;
        var dy = y - y.Floor;
        var dz = z - z.Floor;
        var u = dx.SmootherStep;
        var v = dy.SmootherStep;
        var w = dz.SmootherStep;
        var n000 = LatticeGradient3D(self.Seed, i, j, k).Dot((dx, dy, dz));
        var n100 = LatticeGradient3D(self.Seed, i + 1, j, k).Dot((dx - 1.0, dy, dz));
        var n010 = LatticeGradient3D(self.Seed, i, j + 1, k).Dot((dx, dy - 1.0, dz));
        var n110 = LatticeGradient3D(self.Seed, i + 1, j + 1, k).Dot((dx - 1.0, dy - 1.0, dz));
        var n001 = LatticeGradient3D(self.Seed, i, j, k + 1).Dot((dx, dy, dz - 1.0));
        var n101 = LatticeGradient3D(self.Seed, i + 1, j, k + 1).Dot((dx - 1.0, dy, dz - 1.0));
        var n011 = LatticeGradient3D(self.Seed, i, j + 1, k + 1).Dot((dx, dy - 1.0, dz - 1.0));
        var n111 = LatticeGradient3D(self.Seed, i + 1, j + 1, k + 1).Dot((dx - 1.0, dy - 1.0, dz - 1.0));
        var lo = n000.Lerp(n100, u).Lerp(n010.Lerp(n110, u), v);
        var hi = n001.Lerp(n101, u).Lerp(n011.Lerp(n111, u), v);
        return lo.Lerp(hi, w) * 1.1547005383792515;
    }

    //==
    // # Simplex noise
    //
    // Gustavson's construction: skew the query point onto a simplex lattice, take
    // the N+1 corners of the containing simplex, and sum a radially symmetric
    // falloff (t^4, t = r0 - |d|^2) times each corner's gradient contribution.
    // Three corners instead of four in 2D and four instead of eight in 3D, with
    // no directional bias from the axis-aligned cube.
    // The falloff radius (0.5 in 2D, 0.6 in 3D) and the output scale are
    // Gustavson's, the scale multiplied by sqrt(2) because the gradients here are
    // unit vectors where his table holds vectors of length sqrt(2).
    // https://en.wikipedia.org/wiki/Simplex_noise

    // One corner's contribution: the quartic falloff times the gradient dot the
    // offset, or zero once the query point leaves the corner's radius of
    // influence.
    SimplexCorner2D(seed: Integer, i: Integer, j: Integer, dx: Number, dy: Number): Number {
        var t = 0.5 - dx * dx - dy * dy;
        var falloff = t * t * t * t;
        return t < 0.0 ? 0.0 : falloff * LatticeGradient2D(seed, i, j).Dot((dx, dy));
    }

    // The sum of the three simplex corner contributions.
    Eval(self: SimplexNoise2D, p: Point2D): Number {
        // The skew and unskew factors of the 2D simplex lattice.
        var skew = (Number.SqrtThree - 1.0) / 2.0;
        var unskew = (3.0 - Number.SqrtThree) / 6.0;
        var x = p.X * self.Frequency;
        var y = p.Y * self.Frequency;
        var s = (x + y) * skew;
        var i = (x + s).Floor;
        var j = (y + s).Floor;
        var t = (i + j) * unskew;
        var x0 = x - (i - t);
        var y0 = y - (j - t);
        // Which of the two triangles of the skewed cell the point fell in.
        var i1 = x0 > y0 ? 1.0 : 0.0;
        var j1 = x0 > y0 ? 0.0 : 1.0;
        var ii = i.ToInteger;
        var jj = j.ToInteger;
        return (SimplexCorner2D(self.Seed, ii, jj, x0, y0)
              + SimplexCorner2D(self.Seed, ii + i1.ToInteger, jj + j1.ToInteger,
                                x0 - i1 + unskew, y0 - j1 + unskew)
              + SimplexCorner2D(self.Seed, ii + 1, jj + 1,
                                x0 - 1.0 + 2.0 * unskew, y0 - 1.0 + 2.0 * unskew))
             * 98.99494936611666;
    }

    // One corner's contribution in three dimensions; zero outside its radius.
    SimplexCorner3D(seed: Integer, i: Integer, j: Integer, k: Integer, dx: Number, dy: Number, dz: Number): Number {
        var t = 0.6 - dx * dx - dy * dy - dz * dz;
        var falloff = t * t * t * t;
        return t < 0.0 ? 0.0 : falloff * LatticeGradient3D(seed, i, j, k).Dot((dx, dy, dz));
    }

    // The sum of the four simplex corner contributions.
    Eval(self: SimplexNoise3D, p: Point3D): Number {
        // The skew and unskew factors of the 3D simplex lattice: 1/3 and 1/6.
        var skew = 1.0 / 3.0;
        var unskew = 1.0 / 6.0;
        var x = p.X * self.Frequency;
        var y = p.Y * self.Frequency;
        var z = p.Z * self.Frequency;
        var s = (x + y + z) * skew;
        var i = (x + s).Floor;
        var j = (y + s).Floor;
        var k = (z + s).Floor;
        var t = (i + j + k) * unskew;
        var x0 = x - (i - t);
        var y0 = y - (j - t);
        var z0 = z - (k - t);
        // The traversal order of the containing tetrahedron, written as the rank
        // of each coordinate rather than the usual six-way branch: the second
        // corner steps along the largest coordinate, the third along the two
        // largest.
        var i1 = x0 >= y0 && x0 >= z0 ? 1.0 : 0.0;
        var j1 = y0 > x0 && y0 >= z0 ? 1.0 : 0.0;
        var k1 = z0 > x0 && z0 > y0 ? 1.0 : 0.0;
        var i2 = x0 >= y0 || x0 >= z0 ? 1.0 : 0.0;
        var j2 = y0 > x0 || y0 >= z0 ? 1.0 : 0.0;
        var k2 = z0 > x0 || z0 > y0 ? 1.0 : 0.0;
        var ii = i.ToInteger;
        var jj = j.ToInteger;
        var kk = k.ToInteger;
        return (SimplexCorner3D(self.Seed, ii, jj, kk, x0, y0, z0)
              + SimplexCorner3D(self.Seed, ii + i1.ToInteger, jj + j1.ToInteger, kk + k1.ToInteger,
                                x0 - i1 + unskew, y0 - j1 + unskew, z0 - k1 + unskew)
              + SimplexCorner3D(self.Seed, ii + i2.ToInteger, jj + j2.ToInteger, kk + k2.ToInteger,
                                x0 - i2 + 2.0 * unskew, y0 - j2 + 2.0 * unskew, z0 - k2 + 2.0 * unskew)
              + SimplexCorner3D(self.Seed, ii + 1, jj + 1, kk + 1,
                                x0 - 1.0 + 3.0 * unskew, y0 - 1.0 + 3.0 * unskew, z0 - 1.0 + 3.0 * unskew))
             * 45.254833995939045;
    }

    //==
    // # Worley (cellular) noise
    //
    // One feature point per lattice cell; the value combines the distances to the
    // nearest feature points. The 3x3 (3x3x3) neighbourhood is enough because a
    // jittered feature point never leaves its own cell, so nothing outside the
    // ring can be nearer than something inside it.
    // https://en.wikipedia.org/wiki/Worley_noise

    // The distance from the query offset to the feature point of the k-th cell of
    // the 3x3 neighbourhood, k counted row-major from the lower-left cell.
    WorleyNeighbour2D(self: WorleyNoise2D, i: Integer, j: Integer, fx: Number, fy: Number, k: Integer): Number {
        var dx = k % 3 - 1;
        var dy = k / 3 - 1;
        var feature = FeatureOffset2D(self.Seed, i + dx, j + dy, self.Jitter);
        var offset = Vector2D(dx.ToNumber + feature.X - fx, dy.ToNumber + feature.Y - fy);
        return WorleyLength(offset, self.Distance);
    }

    // The chosen combination of the two nearest feature distances. Non-negative.
    Eval(self: WorleyNoise2D, p: Point2D): Number {
        var x = p.X * self.Frequency;
        var y = p.Y * self.Frequency;
        var i = x.Floor.ToInteger;
        var j = y.Floor.ToInteger;
        var fx = x - x.Floor;
        var fy = y - y.Floor;
        var distances = 9.MapRange(k => self.WorleyNeighbour2D(i, j, fx, fy, k));
        var f1 = NearestDistance(distances);
        return WorleyCombine(f1, SecondNearestDistance(distances, f1), self.Feature);
    }

    // The distance from the query offset to the feature point of the k-th cell of
    // the 3x3x3 neighbourhood, k counted x fastest then y then z.
    WorleyNeighbour3D(self: WorleyNoise3D, i: Integer, j: Integer, k: Integer, fx: Number, fy: Number, fz: Number, n: Integer): Number {
        var dx = n % 3 - 1;
        var dy = n / 3 % 3 - 1;
        var dz = n / 9 - 1;
        var feature = FeatureOffset3D(self.Seed, i + dx, j + dy, k + dz, self.Jitter);
        var offset = Vector3D(dx.ToNumber + feature.X - fx,
                              dy.ToNumber + feature.Y - fy,
                              dz.ToNumber + feature.Z - fz);
        return WorleyLength(offset, self.Distance);
    }

    // The chosen combination of the two nearest feature distances. Non-negative.
    Eval(self: WorleyNoise3D, p: Point3D): Number {
        var x = p.X * self.Frequency;
        var y = p.Y * self.Frequency;
        var z = p.Z * self.Frequency;
        var i = x.Floor.ToInteger;
        var j = y.Floor.ToInteger;
        var k = z.Floor.ToInteger;
        var fx = x - x.Floor;
        var fy = y - y.Floor;
        var fz = z - z.Floor;
        var distances = 27.MapRange(n => self.WorleyNeighbour3D(i, j, k, fx, fy, fz, n));
        var f1 = NearestDistance(distances);
        return WorleyCombine(f1, SecondNearestDistance(distances, f1), self.Feature);
    }

    //==
    // # Gabor noise
    //
    // Sparse convolution: one Gabor kernel — a Gaussian envelope times a plane
    // wave — per lattice cell, summed over the neighbourhood. Bandwidth is the
    // envelope's decay rate, so a large bandwidth localizes each kernel and
    // widens the spectrum; Anisotropy blends each kernel's own random orientation
    // (0) toward the field's stated one (1).
    // https://en.wikipedia.org/wiki/Gabor_filter

    // One cell's kernel, evaluated at the query offset.
    GaborKernel2D(self: GaborNoise2D, i: Integer, j: Integer, fx: Number, fy: Number, k: Integer): Number {
        var dx = k % 3 - 1;
        var dy = k / 3 - 1;
        var ci = i + dx;
        var cj = j + dy;
        var h = LatticeHash(self.Seed, ci, cj);
        var impulse = FeatureOffset2D(self.Seed, ci, cj, 1.0);
        var vx = dx.ToNumber + impulse.X - fx;
        var vy = dy.ToNumber + impulse.Y - fy;
        var envelope = (-Number.Pi * self.Bandwidth * (vx * vx + vy * vy)).Exp;
        // The kernel's wave direction: its own random orientation dragged toward
        // the field's by Anisotropy.
        var own = HashToUnit(NoiseMix(h)).Turns;
        var direction = Vector2D(own.Cos.Lerp(self.Orientation.Cos, self.Anisotropy),
                                 own.Sin.Lerp(self.Orientation.Sin, self.Anisotropy)).Normalize;
        var phase = Angle((vx * direction.X + vy * direction.Y) * Number.Tau);
        return HashToSigned(h) * envelope * phase.Cos;
    }

    // The summed kernel response over the 3x3 neighbourhood.
    Eval(self: GaborNoise2D, p: Point2D): Number {
        var x = p.X * self.Frequency;
        var y = p.Y * self.Frequency;
        var i = x.Floor.ToInteger;
        var j = y.Floor.ToInteger;
        var fx = x - x.Floor;
        var fy = y - y.Floor;
        return 9.MapRange(k => self.GaborKernel2D(i, j, fx, fy, k)).Reduce(0.0, (acc, v) => acc + v);
    }

    // One cell's kernel in three dimensions.
    GaborKernel3D(self: GaborNoise3D, i: Integer, j: Integer, k: Integer, fx: Number, fy: Number, fz: Number, n: Integer): Number {
        var dx = n % 3 - 1;
        var dy = n / 3 % 3 - 1;
        var dz = n / 9 - 1;
        var ci = i + dx;
        var cj = j + dy;
        var ck = k + dz;
        var h = LatticeHash(self.Seed, ci, cj, ck);
        var impulse = FeatureOffset3D(self.Seed, ci, cj, ck, 1.0);
        var v = Vector3D(dx.ToNumber + impulse.X - fx,
                         dy.ToNumber + impulse.Y - fy,
                         dz.ToNumber + impulse.Z - fz);
        var envelope = (-Number.Pi * self.Bandwidth * v.LengthSquared).Exp;
        var own = LatticeGradient3D(self.Seed, ck, ci, cj);
        var direction = own.Lerp(self.Direction.Vector, self.Anisotropy).Normalize;
        var phase = Angle(v.Dot(direction) * Number.Tau);
        return HashToSigned(h) * envelope * phase.Cos;
    }

    // The summed kernel response over the 3x3x3 neighbourhood.
    Eval(self: GaborNoise3D, p: Point3D): Number {
        var x = p.X * self.Frequency;
        var y = p.Y * self.Frequency;
        var z = p.Z * self.Frequency;
        var i = x.Floor.ToInteger;
        var j = y.Floor.ToInteger;
        var k = z.Floor.ToInteger;
        var fx = x - x.Floor;
        var fy = y - y.Floor;
        var fz = z - z.Floor;
        return 27.MapRange(n => self.GaborKernel3D(i, j, k, fx, fy, fz, n)).Reduce(0.0, (acc, v) => acc + v);
    }

    //==
    // # Fractal noise evaluation
    //
    // The `Eval` bodies for the multi-octave sums of `noise.types.plato`.
    // Every one is the same shape: sample the Basis noise Octaves times, the k-th
    // octave at Frequency * Lacunarity^k with weight Gain^k, and divide by the total
    // weight so the result keeps the basis's own range rather than growing with the
    // octave count.
    //
    // The per-octave seed is offset by the octave index. Reusing one seed across
    // octaves would make every layer the SAME field at different scales, which is
    // visible as a self-similar grid rather than as detail.
    //
    // Octaves is a runtime count, so each sum is `MapRange` over the octave indices
    // followed by `Reduce` — the vocabulary has no loop, and recursion would rebuild
    // the weights at every level.

    //==
    // # Weights
    //
    // Shared by all three families: the k-th octave's amplitude, and the total
    // that normalizes the sum. With Gain < 1 the total converges to
    // 1 / (1 - Gain), so a high octave count costs weight but not range.

    // The amplitude of octave k: gain raised to the octave index.
    OctaveWeight(gain: Number, k: Integer): Number
        => gain.Pow(k.ToNumber);

    // The sum of the octave amplitudes, which every fractal sum divides by.
    // Returns one for a zero octave count so the division is still defined.
    TotalWeight(gain: Number, octaves: Integer): Number {
        var total = octaves.MapRange(k => OctaveWeight(gain, k)).Reduce(0.0, (acc, w) => acc + w);
        return total <= 0.0 ? 1.0 : total;
    }

    //==
    // # Fractional Brownian motion
    //
    // The plain weighted sum: signed, and nominally back in [-1, 1] after
    // normalization. https://en.wikipedia.org/wiki/Fractional_Brownian_motion

    // The signed contribution of octave k.
    FbmOctave(basis: NoiseBasis, seed: Integer, frequency: Number, lacunarity: Number, gain: Number, p: Point2D, k: Integer): Number
        => BasisValue2D(basis, seed + k, frequency * lacunarity.Pow(k.ToNumber), p)
           * OctaveWeight(gain, k);

    // The signed contribution of octave k.
    FbmOctave(basis: NoiseBasis, seed: Integer, frequency: Number, lacunarity: Number, gain: Number, p: Point3D, k: Integer): Number
        => BasisValue3D(basis, seed + k, frequency * lacunarity.Pow(k.ToNumber), p)
           * OctaveWeight(gain, k);

    // The normalized sum of the octaves.
    Eval(self: FbmNoise2D, p: Point2D): Number
        => self.Octaves
            .MapRange(k => FbmOctave(self.Basis, self.Seed, self.Frequency, self.Lacunarity, self.Gain, p, k))
            .Reduce(0.0, (acc, v) => acc + v)
           / TotalWeight(self.Gain, self.Octaves);

    // The normalized sum of the octaves.
    Eval(self: FbmNoise3D, p: Point3D): Number
        => self.Octaves
            .MapRange(k => FbmOctave(self.Basis, self.Seed, self.Frequency, self.Lacunarity, self.Gain, p, k))
            .Reduce(0.0, (acc, v) => acc + v)
           / TotalWeight(self.Gain, self.Octaves);

    //==
    // # Turbulence
    //
    // The same sum over the ABSOLUTE value of each octave. Non-negative, and the
    // creases where an octave crosses zero are the billowy character the type's
    // doc comment describes.

    // The non-negative contribution of octave k.
    TurbulenceOctave(basis: NoiseBasis, seed: Integer, frequency: Number, lacunarity: Number, gain: Number, p: Point2D, k: Integer): Number
        => BasisValue2D(basis, seed + k, frequency * lacunarity.Pow(k.ToNumber), p).Abs
           * OctaveWeight(gain, k);

    // The non-negative contribution of octave k.
    TurbulenceOctave(basis: NoiseBasis, seed: Integer, frequency: Number, lacunarity: Number, gain: Number, p: Point3D, k: Integer): Number
        => BasisValue3D(basis, seed + k, frequency * lacunarity.Pow(k.ToNumber), p).Abs
           * OctaveWeight(gain, k);

    // The normalized sum of the rectified octaves; in [0, 1].
    Eval(self: TurbulenceNoise2D, p: Point2D): Number
        => self.Octaves
            .MapRange(k => TurbulenceOctave(self.Basis, self.Seed, self.Frequency, self.Lacunarity, self.Gain, p, k))
            .Reduce(0.0, (acc, v) => acc + v)
           / TotalWeight(self.Gain, self.Octaves);

    // The normalized sum of the rectified octaves; in [0, 1].
    Eval(self: TurbulenceNoise3D, p: Point3D): Number
        => self.Octaves
            .MapRange(k => TurbulenceOctave(self.Basis, self.Seed, self.Frequency, self.Lacunarity, self.Gain, p, k))
            .Reduce(0.0, (acc, v) => acc + v)
           / TotalWeight(self.Gain, self.Octaves);

    //==
    // # Ridged multifractal
    //
    // Each octave is inverted and squared: `(Offset - |basis|)^2`. The inversion
    // turns the basis's zero crossings into the maxima — the ridge lines — and
    // the square sharpens them. Non-negative; normalized by Offset^2 times the
    // weight total, which is the value a perfectly ridged sample would reach.
    // https://en.wikipedia.org/wiki/Multifractal_system

    // The ridged contribution of octave k.
    RidgedOctave(basis: NoiseBasis, seed: Integer, frequency: Number, lacunarity: Number, gain: Number, offset: Number, p: Point2D, k: Integer): Number {
        var signal = offset - BasisValue2D(basis, seed + k, frequency * lacunarity.Pow(k.ToNumber), p).Abs;
        return signal * signal * OctaveWeight(gain, k);
    }

    // The ridged contribution of octave k.
    RidgedOctave(basis: NoiseBasis, seed: Integer, frequency: Number, lacunarity: Number, gain: Number, offset: Number, p: Point3D, k: Integer): Number {
        var signal = offset - BasisValue3D(basis, seed + k, frequency * lacunarity.Pow(k.ToNumber), p).Abs;
        return signal * signal * OctaveWeight(gain, k);
    }

    // The scale that brings the ridged sum back to a nominal [0, 1]: the value the
    // sum reaches when every octave rides its ridge. One when Offset is zero.
    RidgedTotal(gain: Number, offset: Number, octaves: Integer): Number
        => offset == 0.0 ? 1.0 : offset * offset * TotalWeight(gain, octaves);

    // The normalized sum of the ridged octaves; nominally in [0, 1].
    Eval(self: RidgedNoise2D, p: Point2D): Number
        => self.Octaves
            .MapRange(k => RidgedOctave(self.Basis, self.Seed, self.Frequency, self.Lacunarity, self.Gain, self.Offset, p, k))
            .Reduce(0.0, (acc, v) => acc + v)
           / RidgedTotal(self.Gain, self.Offset, self.Octaves);

    // The normalized sum of the ridged octaves; nominally in [0, 1].
    Eval(self: RidgedNoise3D, p: Point3D): Number
        => self.Octaves
            .MapRange(k => RidgedOctave(self.Basis, self.Seed, self.Frequency, self.Lacunarity, self.Gain, self.Offset, p, k))
            .Reduce(0.0, (acc, v) => acc + v)
           / RidgedTotal(self.Gain, self.Offset, self.Octaves);

    //==
    // # Warped and derived noise evaluation
    //
    // The `Eval` bodies for `noise.types.plato`: domain warping, which moves
    // the sample point before evaluating the basis, and curl noise, which reads a
    // divergence-free vector field off the derivatives of a scalar (2D) or vector
    // (3D) potential.
    //
    // Iterations is a runtime count and each warp step consumes the PREVIOUS
    // displaced point, so the warp is written as a recursion rather than as the
    // MapRange + Reduce the fractal sums use — the steps do not commute and there is
    // nothing to sum.
    //
    // The curl bodies differentiate by central difference. The step is a fixed
    // 1e-3 in the field's own input units: small enough that the second-order error
    // is invisible next to the noise itself, large enough to stay well clear of
    // catastrophic cancellation in single precision.

    //==
    // # Domain warping
    //
    // Each iteration displaces the point by a warp noise sampled at the point
    // itself, so the field folds through itself repeatedly — the marbling. The
    // two (three) displacement components come from decorrelated seeds; sharing
    // one would displace every point along the diagonal.

    // The point after `remaining` further warp iterations.
    WarpPoint(basis: NoiseBasis, seed: Integer, strength: Number, frequency: Number, p: Point2D, remaining: Integer): Point2D
        => remaining <= 0
            ? p
            : WarpPoint(basis, seed, strength, frequency,
                Point2D(p.X + strength * BasisValue2D(basis, seed + 101, frequency, p),
                        p.Y + strength * BasisValue2D(basis, seed + 227, frequency, p)),
                remaining - 1);

    // The point after `remaining` further warp iterations.
    WarpPoint(basis: NoiseBasis, seed: Integer, strength: Number, frequency: Number, p: Point3D, remaining: Integer): Point3D
        => remaining <= 0
            ? p
            : WarpPoint(basis, seed, strength, frequency,
                Point3D(p.X + strength * BasisValue3D(basis, seed + 101, frequency, p),
                        p.Y + strength * BasisValue3D(basis, seed + 227, frequency, p),
                        p.Z + strength * BasisValue3D(basis, seed + 373, frequency, p)),
                remaining - 1);

    // The basis noise sampled at the warped point.
    Eval(self: DomainWarpNoise2D, p: Point2D): Number
        => BasisValue2D(self.Basis, self.Seed, self.Frequency,
            WarpPoint(self.Basis, self.Seed, self.WarpStrength, self.WarpFrequency, p, self.Iterations));

    // The basis noise sampled at the warped point.
    Eval(self: DomainWarpNoise3D, p: Point3D): Number
        => BasisValue3D(self.Basis, self.Seed, self.Frequency,
            WarpPoint(self.Basis, self.Seed, self.WarpStrength, self.WarpFrequency, p, self.Iterations));

    //==
    // # Curl noise
    //
    // The curl of a smooth potential is divergence-free by construction (the
    // divergence of a curl is identically zero), which is exactly what advecting
    // particles wants: no sources and no sinks, so density is preserved.
    // https://en.wikipedia.org/wiki/Curl_(mathematics)
    //
    // Perlin noise is the potential in both dimensions: it is smooth enough that
    // the difference quotient is meaningful, unlike value or Worley noise.

    // The finite-difference step, in the field's input units.
    CurlStep(self: CurlNoise2D): Number => 0.001;

    // The finite-difference step, in the field's input units.
    CurlStep(self: CurlNoise3D): Number => 0.001;

    // The scalar potential whose rotated gradient is the field.
    CurlPotential(self: CurlNoise2D, p: Point2D): Number
        => PerlinNoise2D(self.Seed, self.Frequency).Eval(p);

    // In two dimensions the curl of a scalar potential is its gradient turned a
    // quarter turn: (dPsi/dy, -dPsi/dx).
    Eval(self: CurlNoise2D, p: Point2D): Vector2D {
        var h = self.CurlStep;
        var dpsiDx = (self.CurlPotential(Point2D(p.X + h, p.Y))
                    - self.CurlPotential(Point2D(p.X - h, p.Y))) / (2.0 * h);
        var dpsiDy = (self.CurlPotential(Point2D(p.X, p.Y + h))
                    - self.CurlPotential(Point2D(p.X, p.Y - h))) / (2.0 * h);
        return (dpsiDy, -dpsiDx);
    }

    // One component of the vector potential: three decorrelated Perlin fields,
    // selected by index 0, 1 or 2.
    CurlPotential(self: CurlNoise3D, p: Point3D, component: Integer): Number
        => PerlinNoise3D(self.Seed + component * 8191, self.Frequency).Eval(p);

    // The partial derivative of potential component `component` along axis
    // `axis` (0 = X, 1 = Y, 2 = Z), by central difference.
    CurlDerivative(self: CurlNoise3D, p: Point3D, component: Integer, axis: Integer): Number {
        var h = self.CurlStep;
        var step = Vector3D(axis == 0 ? h : 0.0, axis == 1 ? h : 0.0, axis == 2 ? h : 0.0);
        return (self.CurlPotential(p + step, component)
              - self.CurlPotential(p - step, component)) / (2.0 * h);
    }

    // The curl of the vector potential:
    // (dPsi3/dy - dPsi2/dz, dPsi1/dz - dPsi3/dx, dPsi2/dx - dPsi1/dy).
    Eval(self: CurlNoise3D, p: Point3D): Vector3D
        => (self.CurlDerivative(p, 2, 1) - self.CurlDerivative(p, 1, 2),
            self.CurlDerivative(p, 0, 2) - self.CurlDerivative(p, 2, 0),
            self.CurlDerivative(p, 1, 0) - self.CurlDerivative(p, 0, 1));
}
