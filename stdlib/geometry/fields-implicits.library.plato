//==
// # Fields implicits
//
// Sections, in order:
//  - IField evaluation and scalar/vector queries
//  - Differentiable field bodies
//  - Signed distance and membership queries
//  - Constant and function-valued field algebra
//  - Metaball influence and summation
//  - Flat node tree and graph accessors
//  - Sampled signed distance field lattice geometry
//  - Function-valued implicit shape algebra
//  - Time-varying field bodies

library FieldsImplicits
{
    //==
    // # IField evaluation and scalar/vector queries
    //
    // Bodies for the root `IField` interface and the plain scalar and vector fields
    // declared in `fields.concepts.plato`. Every field inherits
    // `IProcedural<TDomain, TRange>`, whose sole operation is `Eval(x, input)`. The
    // generic `ValueAt` below names that evaluation for every field;
    // interface-specific helpers exist only where they carry semantic weight beyond
    // respelling Eval (sign and level-set queries, magnitude, flow direction). See
    // `README.md` for naming and unit conventions.

    //==
    // # IField<TDomain, TValue>
    //
    // The root spatial-field capability: a pure mapping from a domain position to
    // a value. Only `Eval` is available, so the single helper is a readable alias
    // that serves every field type — color, complex, tensor, vector, direction —
    // which is why those interfaces add no pure-evaluation alias of their own.

    // The field's value at a domain position; a readable spelling of Eval.
    ValueAt(self: IField<$TDomain, $TValue>, point: $TDomain): $TValue
        => self.Eval(point);

    //==
    // # IScalarField2D
    //
    // A real-valued field over the plane. Level-set membership and sign queries
    // are the natural derived surface over a bare scalar evaluation
    // (https://en.wikipedia.org/wiki/Level_set).
    // TODO(interface-gap): a numeric finite-difference gradient would need to sample
    // the field at points offset from `point`, but no sanctioned Point2D offset
    // operation is in scope here (IDifference.Add needs a Vector2D that ICoordinate
    // cannot supply); use IDifferentiableScalarField2D for gradients instead.

    // True where the field is strictly positive at the point. Note: values within
    // rounding of zero classify by sign noise; use IsNearLevelAt for a balanced,
    // tolerance-based test around a level.
    IsPositiveAt(self: IScalarField2D, point: Point2D): Boolean
        => self.Eval(point) > 0.0;

    // True where the field is strictly negative at the point. Note: near-zero
    // values classify by sign noise; use IsNearLevelAt around zero for balance.
    IsNegativeAt(self: IScalarField2D, point: Point2D): Boolean
        => self.Eval(point) < 0.0;

    // True where the field's value at the point is at or above level: the closed
    // super-level-set membership test { p : field(p) >= level }.
    IsAtOrAboveLevel(self: IScalarField2D, point: Point2D, level: Number): Boolean
        => self.Eval(point) >= level;

    // True where the field's value at the point is within tolerance of level: a
    // balanced test for the level set. Precondition: tolerance is non-negative.
    IsNearLevelAt(self: IScalarField2D, point: Point2D, level: Number, tolerance: Number): Boolean
        => (self.Eval(point) - level).Abs <= tolerance;

    //==
    // # IScalarField3D
    //
    // A real-valued field over space. Mirrors the planar sign and level-set
    // queries above.

    // True where the field is strictly positive at the point. Note: near-zero
    // values classify by sign noise; prefer IsNearLevelAt for a balanced test.
    IsPositiveAt(self: IScalarField3D, point: Point3D): Boolean
        => self.Eval(point) > 0.0;

    // True where the field is strictly negative at the point. Note: near-zero
    // values classify by sign noise; prefer IsNearLevelAt for a balanced test.
    IsNegativeAt(self: IScalarField3D, point: Point3D): Boolean
        => self.Eval(point) < 0.0;

    // True where the field's value at the point is at or above level: the closed
    // super-level-set membership test.
    IsAtOrAboveLevel(self: IScalarField3D, point: Point3D, level: Number): Boolean
        => self.Eval(point) >= level;

    // True where the field's value at the point is within tolerance of level.
    // Precondition: tolerance is non-negative.
    IsNearLevelAt(self: IScalarField3D, point: Point3D, level: Number, tolerance: Number): Boolean
        => (self.Eval(point) - level).Abs <= tolerance;

    //==
    // # IVectorField2D
    //
    // A planar vector field. Evaluation itself is the generic ValueAt; the helpers
    // here project the sampled vector to scalar and direction summaries.

    // The length of the sampled vector: flow speed or displacement magnitude.
    MagnitudeAt(self: IVectorField2D, point: Point2D): Number
        => self.Eval(point).Magnitude;

    // The unit flow direction of the sampled vector. Precondition: the field is
    // non-zero at the point.
    FlowDirectionAt(self: IVectorField2D, point: Point2D): Vector2D
        => self.Eval(point).Normalize;

    //==
    // # IVectorField3D
    //
    // A spatial vector field. Mirrors the planar magnitude and flow-direction
    // helpers.

    // The length of the sampled vector: flow speed or displacement magnitude.
    MagnitudeAt(self: IVectorField3D, point: Point3D): Number
        => self.Eval(point).Magnitude;

    // The unit flow direction of the sampled vector. Precondition: the field is
    // non-zero at the point.
    FlowDirectionAt(self: IVectorField3D, point: Point3D): Vector3D
        => self.Eval(point).Normalize;

    //==
    // # IDirectionField2D / IDirectionField3D
    //
    // Fields of unit directions. Evaluation is the generic ValueAt(IField), which
    // already returns the sampled Direction2D / Direction3D, so no interface-
    // specific helper carries weight beyond it.

    //==
    // # IColorField2D / IColorField3D
    //
    // Color fields (procedural textures, gradients, solid textures). Evaluation is
    // the generic ValueAt(IField); no further helper is derivable from Eval alone.

    //==
    // # IComplexField2D
    //
    // A complex-valued planar field. Evaluation is the generic ValueAt(IField);
    // complex-specific analysis needs members Complex does not expose here.

    //==
    // # ITensorField2D / ITensorField3D
    //
    // Matrix-valued fields. Evaluation is the generic ValueAt(IField); tensor
    // invariants are not derivable from the IMatrix surface (see the P3
    // NumericStructures gaps).

    //==
    // # Differentiable field bodies
    //
    // Bodies for the differentiable field interfaces declared in
    // `fields.concepts.plato`: gradient directions, slope, and
    // stationarity for scalar fields, and the divergence / curl classifiers that
    // name local flow behaviour for vector fields.

    //==
    // # IDifferentiableScalarField2D
    //
    // A planar scalar field with an analytic first derivative. The gradient points
    // toward steepest increase; helpers name the directions and critical points.

    // The gradient direction of steepest increase, unit length. Precondition: the
    // gradient is non-zero at the point.
    SteepestAscentDirectionAt(self: IDifferentiableScalarField2D, point: Point2D): Vector2D
        => self.GradientAt(point).Normalize;

    // The direction of steepest decrease, unit length: the negated gradient.
    // Precondition: the gradient is non-zero at the point.
    SteepestDescentDirectionAt(self: IDifferentiableScalarField2D, point: Point2D): Vector2D
        => self.GradientAt(point).Normalize.Negative;

    // The unit outward normal to the level curve through the point: the unit
    // gradient. For an EXACT signed distance field this is the boundary normal.
    // Precondition: the gradient is non-zero at the point.
    BoundaryNormalAt(self: IDifferentiableScalarField2D, point: Point2D): Vector2D
        => self.SteepestAscentDirectionAt(point);

    // The steepness of the field at the point: the gradient's length.
    SlopeAt(self: IDifferentiableScalarField2D, point: Point2D): Number
        => self.GradientAt(point).Magnitude;

    // True where the gradient nearly vanishes (a critical point) within tolerance.
    IsStationaryAt(self: IDifferentiableScalarField2D, point: Point2D, tolerance: Number): Boolean
        => self.GradientAt(point).Magnitude <= tolerance;

    //==
    // # IDifferentiableScalarField3D
    //
    // A spatial scalar field with an analytic first derivative. For a signed
    // distance field the normalized gradient is the outward surface normal.

    // The gradient direction of steepest increase, unit length. Precondition: the
    // gradient is non-zero at the point.
    SteepestAscentDirectionAt(self: IDifferentiableScalarField3D, point: Point3D): Vector3D
        => self.GradientAt(point).Normalize;

    // The direction of steepest decrease, unit length: the negated gradient.
    // Precondition: the gradient is non-zero at the point.
    SteepestDescentDirectionAt(self: IDifferentiableScalarField3D, point: Point3D): Vector3D
        => self.GradientAt(point).Normalize.Negative;

    // The outward surface normal at the point: the unit gradient. The true normal
    // only for an EXACT signed distance field; a field that merely bounds the
    // distance reports a direction that is not it.
    // Precondition: the gradient is non-zero at the point.
    SurfaceNormalAt(self: IDifferentiableScalarField3D, point: Point3D): Vector3D
        => self.SteepestAscentDirectionAt(point);

    // The steepness of the field at the point: the gradient's length.
    SlopeAt(self: IDifferentiableScalarField3D, point: Point3D): Number
        => self.GradientAt(point).Magnitude;

    // True where the gradient nearly vanishes (a critical point) within tolerance.
    IsStationaryAt(self: IDifferentiableScalarField3D, point: Point3D, tolerance: Number): Boolean
        => self.GradientAt(point).Magnitude <= tolerance;

    //==
    // # IDifferentiableVectorField2D
    //
    // A planar vector field with first derivatives: divergence (trace of the
    // Jacobian) and scalar curl. The predicates classify local flow behaviour.

    // True where the field neither expands nor compresses within tolerance
    // (divergence-free / incompressible flow)
    // (https://en.wikipedia.org/wiki/Incompressible_flow).
    IsIncompressibleAt(self: IDifferentiableVectorField2D, point: Point2D, tolerance: Number): Boolean
        => self.DivergenceAt(point).Abs <= tolerance;

    // True where the field spreads outward (positive divergence): a source. Note:
    // near-zero divergence classifies by sign noise; use IsIncompressibleAt for a
    // balanced test.
    IsSourceAt(self: IDifferentiableVectorField2D, point: Point2D): Boolean
        => self.DivergenceAt(point) > 0.0;

    // True where the field converges inward (negative divergence): a sink. Note:
    // near-zero divergence classifies by sign noise; use IsIncompressibleAt for a
    // balanced test.
    IsSinkAt(self: IDifferentiableVectorField2D, point: Point2D): Boolean
        => self.DivergenceAt(point) < 0.0;

    // True where the field has no local rotation within tolerance (irrotational)
    // (https://en.wikipedia.org/wiki/Irrotational_flow).
    IsIrrotationalAt(self: IDifferentiableVectorField2D, point: Point2D, tolerance: Number): Boolean
        => self.CurlAt(point).Abs <= tolerance;

    //==
    // # IDifferentiableVectorField3D
    //
    // A spatial vector field with first derivatives: divergence and the curl
    // vector (vorticity). Mirrors the planar classifiers with a vector curl.

    // True where the field neither expands nor compresses within tolerance
    // (divergence-free / incompressible flow).
    IsIncompressibleAt(self: IDifferentiableVectorField3D, point: Point3D, tolerance: Number): Boolean
        => self.DivergenceAt(point).Abs <= tolerance;

    // True where the field spreads outward (positive divergence): a source. Note:
    // near-zero divergence classifies by sign noise; use IsIncompressibleAt for a
    // balanced test.
    IsSourceAt(self: IDifferentiableVectorField3D, point: Point3D): Boolean
        => self.DivergenceAt(point) > 0.0;

    // True where the field converges inward (negative divergence): a sink. Note:
    // near-zero divergence classifies by sign noise; use IsIncompressibleAt for a
    // balanced test.
    IsSinkAt(self: IDifferentiableVectorField3D, point: Point3D): Boolean
        => self.DivergenceAt(point) < 0.0;

    // The strength of local rotation: the length of the curl (vorticity) vector
    // (https://en.wikipedia.org/wiki/Vorticity).
    VorticityMagnitudeAt(self: IDifferentiableVectorField3D, point: Point3D): Number
        => self.CurlAt(point).Magnitude;

    // True where the field has no local rotation within tolerance (irrotational).
    IsIrrotationalAt(self: IDifferentiableVectorField3D, point: Point3D, tolerance: Number): Boolean
        => self.CurlAt(point).Magnitude <= tolerance;

    //==
    // # Signed distance and membership queries
    //
    // Bodies for the implicit interfaces declared in `implicit-sdf.concepts.plato`:
    // the inside / outside / boundary surface a signed distance field induces, and
    // the matching membership surface for predicate-only regions and volumes.

    //==
    // # ISignedDistanceField2D
    //
    // A planar SDF: value is the signed distance to a boundary curve, negative
    // inside. The rich inside/outside/boundary surface builds on that one scalar
    // (https://en.wikipedia.org/wiki/Signed_distance_function).

    // The signed distance from the point to the boundary; a readable spelling of
    // Eval. Negative inside, zero on the boundary, positive outside.
    DistanceAt(self: ISignedDistanceField2D, point: Point2D): Number
        => self.Eval(point);

    // The unsigned distance from the point to the boundary: the magnitude of the
    // signed distance.
    ClearanceAt(self: ISignedDistanceField2D, point: Point2D): Number
        => self.Eval(point).Abs;

    // True when the point is strictly inside the boundary (negative distance).
    IsInside(self: ISignedDistanceField2D, point: Point2D): Boolean
        => self.Eval(point) < 0.0;

    // True when the point is strictly outside the boundary (positive distance).
    IsOutside(self: ISignedDistanceField2D, point: Point2D): Boolean
        => self.Eval(point) > 0.0;

    // True when the point lies on the boundary curve within the given tolerance.
    // Precondition: tolerance is non-negative.
    IsOnBoundary(self: ISignedDistanceField2D, point: Point2D, tolerance: Number): Boolean
        => self.Eval(point).Abs <= tolerance;

    // True when the point is inside or exactly on the boundary (distance <= 0):
    // the closed-region membership test.
    Contains(self: ISignedDistanceField2D, point: Point2D): Boolean
        => self.Eval(point) <= 0.0;

    // How far the point lies inside the boundary: positive within, zero or
    // negative outside. The negated signed distance.
    PenetrationDepthAt(self: ISignedDistanceField2D, point: Point2D): Number
        => self.Eval(point).Negative;

    //==
    // # ISignedDistanceField3D
    //
    // A spatial SDF: value is the signed distance to a surface, negative inside.
    // Mirrors the planar inside/outside/surface surface.

    // The signed distance from the point to the surface; a readable spelling of
    // Eval. Negative inside, zero on the surface, positive outside.
    DistanceAt(self: ISignedDistanceField3D, point: Point3D): Number
        => self.Eval(point);

    // The unsigned distance from the point to the surface: the magnitude of the
    // signed distance.
    ClearanceAt(self: ISignedDistanceField3D, point: Point3D): Number
        => self.Eval(point).Abs;

    // True when the point is strictly inside the surface (negative distance).
    IsInside(self: ISignedDistanceField3D, point: Point3D): Boolean
        => self.Eval(point) < 0.0;

    // True when the point is strictly outside the surface (positive distance).
    IsOutside(self: ISignedDistanceField3D, point: Point3D): Boolean
        => self.Eval(point) > 0.0;

    // True when the point lies on the surface within the given tolerance.
    // Precondition: tolerance is non-negative.
    IsOnSurface(self: ISignedDistanceField3D, point: Point3D, tolerance: Number): Boolean
        => self.Eval(point).Abs <= tolerance;

    // True when the point is inside or exactly on the surface (distance <= 0):
    // the closed-solid membership test.
    Contains(self: ISignedDistanceField3D, point: Point3D): Boolean
        => self.Eval(point) <= 0.0;

    // How far the point lies inside the surface: positive within, zero or
    // negative outside. The negated signed distance.
    DepthBelowSurfaceAt(self: ISignedDistanceField3D, point: Point3D): Number
        => self.Eval(point).Negative;

    //==
    // # IImplicitRegion2D
    //
    // A planar region defined by a membership predicate; carries no distance.
    // Naming aligns with the SDF surface: Contains / IsInside / IsOutside.

    // True when the point is inside the region; a readable spelling of Eval.
    Contains(self: IImplicitRegion2D, point: Point2D): Boolean
        => self.Eval(point);

    // True when the point is inside the region. Alias of Contains aligning with
    // the signed-distance-field vocabulary.
    IsInside(self: IImplicitRegion2D, point: Point2D): Boolean
        => self.Eval(point);

    // True when the point is outside the region.
    IsOutside(self: IImplicitRegion2D, point: Point2D): Boolean
        => self.Eval(point).Not;

    //==
    // # IImplicitVolume3D
    //
    // A spatial volume defined by a membership predicate; carries no distance.
    // Naming aligns with the SDF surface: Contains / IsInside / IsOutside.

    // True when the point is inside the volume; a readable spelling of Eval.
    Contains(self: IImplicitVolume3D, point: Point3D): Boolean
        => self.Eval(point);

    // True when the point is inside the volume. Alias of Contains aligning with
    // the signed-distance-field vocabulary.
    IsInside(self: IImplicitVolume3D, point: Point3D): Boolean
        => self.Eval(point);

    // True when the point is outside the volume.
    IsOutside(self: IImplicitVolume3D, point: Point3D): Boolean
        => self.Eval(point).Not;

    //==
    // # Constant and function-valued field algebra
    //
    // Bodies for the constant fields of `fields.types.plato` and the
    // function-valued fields of `fields.types.plato`, plus the combinator
    // algebra over them: lifting any field interface implementor into stored-function
    // form, pointwise composition, and constructive solid geometry on distance
    // fields. Every combinator returns a NEW field holding the composed lambda.

    //==
    // # Constant fields
    //
    // The trivial fields: the same value at every point. Their evaluation ignores
    // the position entirely, which is what makes them the neutral leaves of a
    // field expression.

    // The constant value, at every point of the plane.
    Eval(self: ConstantScalarField2D, point: Point2D): Number
        => self.Value;

    // The constant value, at every point of space.
    Eval(self: ConstantScalarField3D, point: Point3D): Number
        => self.Value;

    // The constant vector, at every point of the plane.
    Eval(self: ConstantVectorField2D, point: Point2D): Vector2D
        => self.Value;

    // The constant vector, at every point of space.
    Eval(self: ConstantVectorField3D, point: Point3D): Vector3D
        => self.Value;

    //==
    // # Function-valued fields
    //
    // Evaluation of a field that STORES a function: invoke the stored function.
    // This is the base case that makes the combinators below possible — each one
    // builds a new field whose stored function closes over the operand fields.

    // The stored function applied to the position.
    Eval(self: ScalarFunctionField2D, point: Point2D): Number
        => self.Function(point);

    // The stored function applied to the position.
    Eval(self: ScalarFunctionField3D, point: Point3D): Number
        => self.Function(point);

    // The stored function applied to the position.
    Eval(self: VectorFunctionField2D, point: Point2D): Vector2D
        => self.Function(point);

    // The stored function applied to the position.
    Eval(self: VectorFunctionField3D, point: Point3D): Vector3D
        => self.Function(point);

    //==
    // # Lifting any field into function-valued form
    //
    // One interface-typed function per family lifts EVERY implementor of that field
    // interface — constant fields, metaball systems, sampled SDFs, noise, and the
    // function-valued fields themselves — into the combinator algebra below.
    //
    // Each is named after its return type, so each is an IMPLICIT conversion: the
    // lifted field evaluates to the same value at every point as the field it came
    // from, nothing is sampled or approximated, and no parameter is invented
    // (Convention: see CONVENTIONS.md - Conversions).

    // The field as a function-valued planar scalar field, holding a lambda that
    // evaluates this field.
    ScalarFunctionField2D(self: IScalarField2D): ScalarFunctionField2D
        => ScalarFunctionField2D(p => self.Eval(p));

    // The field as a function-valued spatial scalar field, holding a lambda that
    // evaluates this field.
    ScalarFunctionField3D(self: IScalarField3D): ScalarFunctionField3D
        => ScalarFunctionField3D(p => self.Eval(p));

    // The field as a function-valued planar vector field.
    VectorFunctionField2D(self: IVectorField2D): VectorFunctionField2D
        => VectorFunctionField2D(p => self.Eval(p));

    // The field as a function-valued spatial vector field.
    VectorFunctionField3D(self: IVectorField3D): VectorFunctionField3D
        => VectorFunctionField3D(p => self.Eval(p));

    //==
    // # Scalar field combinators
    //
    // Pointwise composition. Every combinator returns a NEW field holding the
    // composed lambda; nothing is evaluated until the result is sampled. Combine
    // is the primitive — the rest are one-liners over it.

    // Two fields merged pointwise by a binary operator.
    Combine(a: ScalarFunctionField2D, b: ScalarFunctionField2D, op: Function2<Number, Number, Number>): ScalarFunctionField2D
        => ScalarFunctionField2D(p => op(a.Eval(p), b.Eval(p)));

    // Two fields merged pointwise by a binary operator.
    Combine(a: ScalarFunctionField3D, b: ScalarFunctionField3D, op: Function2<Number, Number, Number>): ScalarFunctionField3D
        => ScalarFunctionField3D(p => op(a.Eval(p), b.Eval(p)));

    // The field with its output value transformed by f (a range warp).
    MapValue(self: ScalarFunctionField2D, f: Function1<Number, Number>): ScalarFunctionField2D
        => ScalarFunctionField2D(p => f(self.Eval(p)));

    // The field with its output value transformed by f (a range warp).
    MapValue(self: ScalarFunctionField3D, f: Function1<Number, Number>): ScalarFunctionField3D
        => ScalarFunctionField3D(p => f(self.Eval(p)));

    // The field with its input position transformed by f before evaluation (a
    // domain warp): bending, twisting, tiling, and instancing are all domain warps.
    MapDomain(self: ScalarFunctionField2D, f: Function1<Point2D, Point2D>): ScalarFunctionField2D
        => ScalarFunctionField2D(p => self.Eval(f(p)));

    // The field with its input position transformed by f before evaluation.
    MapDomain(self: ScalarFunctionField3D, f: Function1<Point3D, Point3D>): ScalarFunctionField3D
        => ScalarFunctionField3D(p => self.Eval(f(p)));

    // The sum of two fields, pointwise.
    Add(a: ScalarFunctionField2D, b: ScalarFunctionField2D): ScalarFunctionField2D
        => a.Combine(b, (x, y) => x + y);

    // The sum of two fields, pointwise.
    Add(a: ScalarFunctionField3D, b: ScalarFunctionField3D): ScalarFunctionField3D
        => a.Combine(b, (x, y) => x + y);

    //==
    // # Constructive solid geometry on distance fields
    //
    // SDF convention: union is the pointwise minimum, intersection the maximum,
    // difference the left field against the negated right
    // (https://en.wikipedia.org/wiki/Constructive_solid_geometry). Fidelity
    // (`implicit-sdf.concepts.plato`), for exact operands: union is exact,
    // everything else here is a lower bound. Nothing in this section can turn a
    // bound into a non-bound.

    // The union of two planar distance fields: the pointwise minimum. Exact.
    Union(a: ScalarFunctionField2D, b: ScalarFunctionField2D): ScalarFunctionField2D
        => a.Combine(b, (x, y) => x.Min(y));

    // The union of two spatial distance fields: the pointwise minimum. Exact.
    Union(a: ScalarFunctionField3D, b: ScalarFunctionField3D): ScalarFunctionField3D
        => a.Combine(b, (x, y) => x.Min(y));

    // The intersection of two planar distance fields: the pointwise maximum. A
    // lower bound.
    Intersection(a: ScalarFunctionField2D, b: ScalarFunctionField2D): ScalarFunctionField2D
        => a.Combine(b, (x, y) => x.Max(y));

    // The intersection of two spatial distance fields: the pointwise maximum. A
    // lower bound.
    Intersection(a: ScalarFunctionField3D, b: ScalarFunctionField3D): ScalarFunctionField3D
        => a.Combine(b, (x, y) => x.Max(y));

    // The first field with the second carved out of it: a against the negated b.
    // A lower bound.
    Difference(a: ScalarFunctionField2D, b: ScalarFunctionField2D): ScalarFunctionField2D
        => a.Combine(b, (x, y) => x.Max(y.Negative));

    // The first field with the second carved out of it: a against the negated b.
    // A lower bound.
    Difference(a: ScalarFunctionField3D, b: ScalarFunctionField3D): ScalarFunctionField3D
        => a.Combine(b, (x, y) => x.Max(y.Negative));

    // The union of two spatial distance fields blended over blendRadius: the
    // polynomial smooth minimum. A lower bound.
    // Precondition: blendRadius is positive.
    SmoothUnion(a: ScalarFunctionField3D, b: ScalarFunctionField3D, blendRadius: Number): ScalarFunctionField3D
        => a.Combine(b, (x, y) => SmoothUnionDistance(x, y, blendRadius));

    // The field grown (positive amount) or shrunk (negative amount) by a constant
    // distance: the offset surface of a distance field. Exact; at worst a lower
    // bound where a negative amount erodes a feature away entirely.
    Offset(self: ScalarFunctionField2D, amount: Number): ScalarFunctionField2D
        => self.MapValue(x => x - amount);

    // The field grown (positive amount) or shrunk (negative amount) by a constant.
    // Exact, with the same erosion caveat as the planar form.
    Offset(self: ScalarFunctionField3D, amount: Number): ScalarFunctionField3D
        => self.MapValue(x => x - amount);

    // The complement of a distance field: inside and outside swapped. Exact — only
    // the sign changes.
    Complement(self: ScalarFunctionField2D): ScalarFunctionField2D
        => self.MapValue(x => x.Negative);

    // The complement of a distance field: inside and outside swapped. Exact.
    Complement(self: ScalarFunctionField3D): ScalarFunctionField3D
        => self.MapValue(x => x.Negative);

    //==
    // # Metaball influence and summation
    //
    // Summed radial falloff kernels over the metaball types declared in
    // `implicit-sdf.types.plato`. The system's field value is the total
    // influence minus the threshold, so its zero level set is the blob boundary
    // (https://en.wikipedia.org/wiki/Metaballs).

    // The influence of one planar ball at a point: Strength at the centre, falling
    // smoothly to zero at Radius and staying zero beyond it.
    InfluenceAt(self: MetaBall2D, point: Point2D): Number
        => self.Strength * MetaBallFalloff(self.Center.Between(point).Magnitude / self.Radius);

    // The influence of one spatial ball at a point; negative strengths carve.
    InfluenceAt(self: MetaBall3D, point: Point3D): Number
        => self.Strength * MetaBallFalloff(self.Center.Between(point).Magnitude / self.Radius);

    // The radial falloff kernel as a function of distance measured in radii: one
    // at the centre, zero at and beyond one radius, with vanishing first and
    // second derivatives at both ends. The classic Wyvill cubic (1 - r^2)^3.
    MetaBallFalloff(normalizedDistance: Number): Number
        => (1.0 - normalizedDistance * normalizedDistance).Saturate.Cube;

    // The blob field value: the summed influence of every ball, less Threshold.
    // Negative outside the blob, zero on its outline, positive inside — note this
    // is the OPPOSITE sign convention to a signed distance field.
    Eval(self: MetaBallSystem2D, point: Point2D): Number
        => self.Balls.Reduce(0.0, (total, ball) => total + ball.InfluenceAt(point)) - self.Threshold;

    // The blob field value: the summed influence of every ball, less Threshold.
    Eval(self: MetaBallSystem3D, point: Point3D): Number
        => self.Balls.Reduce(0.0, (total, ball) => total + ball.InfluenceAt(point)) - self.Threshold;

    //==
    // # Flat node tree and graph accessors
    //
    // Root-node lookup and index ordering for the flat, index-based structures:
    // the SDF combination trees of `implicit-sdf.types.plato` and the scalar field
    // expression graphs of `fields.types.plato`. The recursive evaluators live in
    // `implicit-sdf.library.plato` and `fields-graphs.library.plato`; these
    // name the entry point and the index ordering a walker relies on.

    //==
    // # SDF combination trees

    // The node producing the tree's final distance.
    RootNode(self: SdfTree2D): SdfNode2D
        => self.Nodes[self.Root.Value];

    // The node producing the tree's final distance.
    RootNode(self: SdfTree3D): SdfNode3D
        => self.Nodes[self.Root.Value];

    // SdfNodeIndex implements IIndex, so its ordering and hash are the derived
    // IIndex bodies in `collections.library.plato`: node indices order by
    // position in the node array, which is already a valid evaluation order.

    //==
    // # IField expression graphs
    //
    // The same flat-graph shape over scalar fields.

    // The node producing the graph's result.
    RootNode(self: ScalarFieldGraph2D): ScalarFieldNode2D
        => self.Nodes[self.Root.Value];

    // The node producing the graph's result.
    RootNode(self: ScalarFieldGraph3D): ScalarFieldNode3D
        => self.Nodes[self.Root.Value];

    // FieldNodeIndex likewise implements IIndex, so its ordering and hash come
    // from the derived IIndex bodies.

    //==
    // # Sampled signed distance field lattice geometry
    //
    // Node counts and node spacing for the discretized SDFs of
    // `implicit-sdf.types.plato`. The interpolating evaluators live in
    // `implicit-sdf.library.plato` (they need local bindings for the
    // per-axis fractional weights); the lattice geometry below is what they and any
    // resampler are written against.

    // The number of lattice nodes along each axis. Both axes include their
    // endpoints, so a node count of n spans n - 1 cells.
    NodeCounts(self: SampledSdf2D): IntegerVector2
        => (self.Values.ColumnCount, self.Values.RowCount);

    // The number of lattice nodes along each axis.
    NodeCounts(self: SampledSdf3D): IntegerVector3
        => (self.Values.ColumnCount, self.Values.RowCount, self.Values.LayerCount);

    // The spacing between adjacent lattice nodes along each axis: the sampling
    // resolution, and the scale of the interpolation error.
    NodeSpacing(self: SampledSdf2D): Vector2D
        => (
            (self.Bounds.Max.X - self.Bounds.Min.X) / (self.Values.ColumnCount - 1).ToNumber,
            (self.Bounds.Max.Y - self.Bounds.Min.Y) / (self.Values.RowCount - 1).ToNumber);

    // The spacing between adjacent lattice nodes along each axis.
    NodeSpacing(self: SampledSdf3D): Vector3D
        => (
            (self.Bounds.Max.X - self.Bounds.Min.X) / (self.Values.ColumnCount - 1).ToNumber,
            (self.Bounds.Max.Y - self.Bounds.Min.Y) / (self.Values.RowCount - 1).ToNumber,
            (self.Bounds.Max.Z - self.Bounds.Min.Z) / (self.Values.LayerCount - 1).ToNumber);

    //==
    // # Function-valued implicit shape algebra
    //
    // Bodies for the stored-function implicit shapes of
    // `implicit-sdf.types.plato`: evaluation, the lifts from any SDF interface
    // implementor, and the CSG algebra closed over each form — SDF booleans are
    // min/max on the stored distance, region booleans are the Boolean connectives
    // on the stored predicate.
    //
    // Every SDF operator here defers to the matching `*Distance` kernel in
    // `implicit-sdf.library.plato` and inherits the fidelity claim stated there —
    // exact, a lower bound, or not a bound (`implicit-sdf.concepts.plato`). A
    // region or volume operator carries no distance and so no such claim.

    // The stored distance function applied to the position.
    Eval(self: FunctionSdf2D, point: Point2D): Number
        => self.Function(point);

    // The stored distance function applied to the position.
    Eval(self: FunctionSdf3D, point: Point3D): Number
        => self.Function(point);

    // The stored membership predicate applied to the position.
    Eval(self: FunctionRegion2D, point: Point2D): Boolean
        => self.Function(point);

    // The stored membership predicate applied to the position.
    Eval(self: FunctionVolume3D, point: Point3D): Boolean
        => self.Function(point);

    // Any planar SDF as a function-valued one, so the combinators below apply to
    // every implementor. Implicit: the same distance at every point
    // (Convention: see CONVENTIONS.md - Conversions).
    FunctionSdf2D(self: ISignedDistanceField2D): FunctionSdf2D
        => FunctionSdf2D(p => self.Eval(p));

    // Any spatial SDF as a function-valued one. Implicit, for the same reason.
    FunctionSdf3D(self: ISignedDistanceField3D): FunctionSdf3D
        => FunctionSdf3D(p => self.Eval(p));

    // The region a planar SDF induces: inside is where the distance is negative.
    // Discards the distance, keeping only membership — and `< 0.0` also excludes
    // the zero level set — so this stays an explicit ToX, never a conversion.
    ToRegion(self: ISignedDistanceField2D): FunctionRegion2D
        => FunctionRegion2D(p => self.Eval(p) < 0.0);

    // The volume a spatial SDF induces: inside is where the distance is negative.
    ToVolume(self: ISignedDistanceField3D): FunctionVolume3D
        => FunctionVolume3D(p => self.Eval(p) < 0.0);

    // The union of two planar SDFs: the pointwise minimum distance. Exact.
    Union(a: FunctionSdf2D, b: FunctionSdf2D): FunctionSdf2D
        => FunctionSdf2D(p => a.Eval(p).Min(b.Eval(p)));

    // The union of two spatial SDFs: the pointwise minimum distance. Exact.
    Union(a: FunctionSdf3D, b: FunctionSdf3D): FunctionSdf3D
        => FunctionSdf3D(p => a.Eval(p).Min(b.Eval(p)));

    // The intersection of two planar SDFs: the pointwise maximum distance. Exact
    // only near the surviving surface; elsewhere a lower bound.
    Intersection(a: FunctionSdf2D, b: FunctionSdf2D): FunctionSdf2D
        => FunctionSdf2D(p => a.Eval(p).Max(b.Eval(p)));

    // The intersection of two spatial SDFs: the pointwise maximum distance. A
    // lower bound, exact only near the surviving surface.
    Intersection(a: FunctionSdf3D, b: FunctionSdf3D): FunctionSdf3D
        => FunctionSdf3D(p => a.Eval(p).Max(b.Eval(p)));

    // The first shape with the second carved out of it. A lower bound.
    Difference(a: FunctionSdf2D, b: FunctionSdf2D): FunctionSdf2D
        => FunctionSdf2D(p => a.Eval(p).Max(b.Eval(p).Negative));

    // The first shape with the second carved out of it. A lower bound.
    Difference(a: FunctionSdf3D, b: FunctionSdf3D): FunctionSdf3D
        => FunctionSdf3D(p => a.Eval(p).Max(b.Eval(p).Negative));

    // Everything the planar shape is not: inside and outside exchanged. Exact.
    // Carries no bounded form — the complement of a bounded region is unbounded.
    Complement(self: FunctionSdf2D): FunctionSdf2D
        => FunctionSdf2D(p => ComplementDistance(self.Eval(p)));

    // Everything the spatial shape is not: inside and outside exchanged. Exact.
    Complement(self: FunctionSdf3D): FunctionSdf3D
        => FunctionSdf3D(p => ComplementDistance(self.Eval(p)));

    // A linear morph from the first planar shape to the second. A lower
    // bound, exact only where the two operands agree.
    // Precondition: t lies in [0, 1].
    Morph(a: FunctionSdf2D, b: FunctionSdf2D, t: Number): FunctionSdf2D
        => FunctionSdf2D(p => MorphDistance(a.Eval(p), b.Eval(p), t));

    // A linear morph from the first spatial shape to the second. A lower
    // bound, exact only where the two operands agree.
    // Precondition: t lies in [0, 1].
    Morph(a: FunctionSdf3D, b: FunctionSdf3D, t: Number): FunctionSdf3D
        => FunctionSdf3D(p => MorphDistance(a.Eval(p), b.Eval(p), t));

    // The union of two planar SDFs with a 45-degree chamfer of the given width
    // across the seam. Precondition: width is positive.
    ChamferUnion(a: FunctionSdf2D, b: FunctionSdf2D, width: Number): FunctionSdf2D
        => FunctionSdf2D(p => ChamferUnionDistance(a.Eval(p), b.Eval(p), width));

    // The union of two spatial SDFs with a 45-degree chamfer across the seam.
    // Precondition: width is positive.
    ChamferUnion(a: FunctionSdf3D, b: FunctionSdf3D, width: Number): FunctionSdf3D
        => FunctionSdf3D(p => ChamferUnionDistance(a.Eval(p), b.Eval(p), width));

    // The chamfered intersection of two planar SDFs.
    // Precondition: width is positive.
    ChamferIntersection(a: FunctionSdf2D, b: FunctionSdf2D, width: Number): FunctionSdf2D
        => FunctionSdf2D(p => ChamferIntersectionDistance(a.Eval(p), b.Eval(p), width));

    // The chamfered intersection of two spatial SDFs.
    // Precondition: width is positive.
    ChamferIntersection(a: FunctionSdf3D, b: FunctionSdf3D, width: Number): FunctionSdf3D
        => FunctionSdf3D(p => ChamferIntersectionDistance(a.Eval(p), b.Eval(p), width));

    // The first planar shape with the second chamfer-subtracted.
    // Precondition: width is positive.
    ChamferDifference(a: FunctionSdf2D, b: FunctionSdf2D, width: Number): FunctionSdf2D
        => FunctionSdf2D(p => ChamferDifferenceDistance(a.Eval(p), b.Eval(p), width));

    // The first spatial shape with the second chamfer-subtracted.
    // Precondition: width is positive.
    ChamferDifference(a: FunctionSdf3D, b: FunctionSdf3D, width: Number): FunctionSdf3D
        => FunctionSdf3D(p => ChamferDifferenceDistance(a.Eval(p), b.Eval(p), width));

    // The part of the plane inside exactly one of the two shapes.
    ExclusiveOr(a: FunctionSdf2D, b: FunctionSdf2D): FunctionSdf2D
        => FunctionSdf2D(p => ExclusiveOrDistance(a.Eval(p), b.Eval(p)));

    // The part of space inside exactly one of the two shapes.
    ExclusiveOr(a: FunctionSdf3D, b: FunctionSdf3D): FunctionSdf3D
        => FunctionSdf3D(p => ExclusiveOrDistance(a.Eval(p), b.Eval(p)));

    // The union of two planar SDFs blended over blendRadius: the polynomial smooth
    // minimum. Unlike the sharp Union, this is differentiable across the seam.
    // Precondition: blendRadius is positive.
    SmoothUnion(a: FunctionSdf2D, b: FunctionSdf2D, blendRadius: Number): FunctionSdf2D
        => FunctionSdf2D(p => SmoothUnionDistance(a.Eval(p), b.Eval(p), blendRadius));

    // The union of two spatial SDFs blended over blendRadius: the polynomial
    // smooth minimum. Precondition: blendRadius is positive.
    SmoothUnion(a: FunctionSdf3D, b: FunctionSdf3D, blendRadius: Number): FunctionSdf3D
        => FunctionSdf3D(p => SmoothUnionDistance(a.Eval(p), b.Eval(p), blendRadius));

    // The intersection of two planar SDFs blended over blendRadius: the De Morgan
    // dual of the smooth union. Precondition: blendRadius is positive.
    SmoothIntersection(a: FunctionSdf2D, b: FunctionSdf2D, blendRadius: Number): FunctionSdf2D
        => FunctionSdf2D(p => SmoothIntersectionDistance(a.Eval(p), b.Eval(p), blendRadius));

    // The intersection of two spatial SDFs blended over blendRadius.
    // Precondition: blendRadius is positive.
    SmoothIntersection(a: FunctionSdf3D, b: FunctionSdf3D, blendRadius: Number): FunctionSdf3D
        => FunctionSdf3D(p => SmoothIntersectionDistance(a.Eval(p), b.Eval(p), blendRadius));

    // The first planar shape with the second carved out, the cut filleted over
    // blendRadius. Precondition: blendRadius is positive.
    SmoothDifference(a: FunctionSdf2D, b: FunctionSdf2D, blendRadius: Number): FunctionSdf2D
        => FunctionSdf2D(p => SmoothDifferenceDistance(a.Eval(p), b.Eval(p), blendRadius));

    // The first spatial shape with the second carved out, the cut filleted over
    // blendRadius. Precondition: blendRadius is positive.
    SmoothDifference(a: FunctionSdf3D, b: FunctionSdf3D, blendRadius: Number): FunctionSdf3D
        => FunctionSdf3D(p => SmoothDifferenceDistance(a.Eval(p), b.Eval(p), blendRadius));

    // The shape grown (positive amount) or shrunk (negative amount) by a constant
    // distance: the offset surface. Rounds convex edges by amount. Exact; at worst
    // a lower bound where a negative amount erodes a feature away entirely.
    Offset(self: FunctionSdf2D, amount: Number): FunctionSdf2D
        => FunctionSdf2D(p => self.Eval(p) - amount);

    // The shape grown or shrunk by a constant distance: the offset surface. Exact,
    // with the same erosion caveat as the planar form.
    Offset(self: FunctionSdf3D, amount: Number): FunctionSdf3D
        => FunctionSdf3D(p => self.Eval(p) - amount);

    // The outline of a planar shape: the band within half of thickness on either
    // side of its boundary curve. Exact. Precondition: thickness is positive.
    Shell(self: FunctionSdf2D, thickness: Number): FunctionSdf2D
        => FunctionSdf2D(p => self.Eval(p).Abs - thickness * 0.5);

    // The shell of a shape: the region within half of thickness on either side of
    // its surface. Exact. Precondition: thickness is positive.
    Shell(self: FunctionSdf3D, thickness: Number): FunctionSdf3D
        => FunctionSdf3D(p => self.Eval(p).Abs - thickness * 0.5);

    // The shape sampled at a warped position: bending, twisting, tiling, and
    // instancing are all domain warps. Exact when f is a rigid motion, and a lower
    // bound when f is a contraction. Any f that STRETCHES — a twist, a bend, a
    // non-uniform scale — makes the result exceed the true distance, which is not
    // a bound at all and tunnels a sphere tracer; divide by f's Lipschitz constant
    // to recover a lower bound.
    MapDomain(self: FunctionSdf3D, f: Function1<Point3D, Point3D>): FunctionSdf3D
        => FunctionSdf3D(p => self.Eval(f(p)));

    // The union of two planar regions: inside either one.
    Union(a: FunctionRegion2D, b: FunctionRegion2D): FunctionRegion2D
        => FunctionRegion2D(p => a.Eval(p) || b.Eval(p));

    // The intersection of two planar regions: inside both.
    Intersection(a: FunctionRegion2D, b: FunctionRegion2D): FunctionRegion2D
        => FunctionRegion2D(p => a.Eval(p) && b.Eval(p));

    // The first region with the second removed: inside a and not inside b.
    Difference(a: FunctionRegion2D, b: FunctionRegion2D): FunctionRegion2D
        => FunctionRegion2D(p => a.Eval(p) && b.Eval(p).Not);

    // Everything outside the region.
    Complement(self: FunctionRegion2D): FunctionRegion2D
        => FunctionRegion2D(p => self.Eval(p).Not);

    // The union of two spatial volumes: inside either one.
    Union(a: FunctionVolume3D, b: FunctionVolume3D): FunctionVolume3D
        => FunctionVolume3D(p => a.Eval(p) || b.Eval(p));

    // The intersection of two spatial volumes: inside both.
    Intersection(a: FunctionVolume3D, b: FunctionVolume3D): FunctionVolume3D
        => FunctionVolume3D(p => a.Eval(p) && b.Eval(p));

    // The first volume with the second removed: inside a and not inside b.
    Difference(a: FunctionVolume3D, b: FunctionVolume3D): FunctionVolume3D
        => FunctionVolume3D(p => a.Eval(p) && b.Eval(p).Not);

    // Everything outside the volume.
    Complement(self: FunctionVolume3D): FunctionVolume3D
        => FunctionVolume3D(p => self.Eval(p).Not);

    //==
    // # Concrete shapes as signed distance fields
    //
    // The bridge from the boundary-representation geometry types to the implicit
    // ones: a shape becomes the field reporting the distance to it, after which the
    // whole implicit surface — CSG, smoothing, offsetting, ray marching, sampling
    // onto a lattice — applies to it. Explicit `ToSdf` and never an implicit
    // conversion, because the field cannot recover the shape it came from
    // (Convention: see CONVENTIONS.md - Conversions).
    //
    // These bodies hold the lambda that the primitive bodies in
    // `implicit-sdf.library.plato` deliberately do not: each `ToSdf` closes over its
    // shape and defers to the matching closed-form primitive, which is what keeps
    // the primitives portable and the placement in one place. Fidelity follows from
    // that: every field here is EXACT (`implicit-sdf.concepts.plato`), except the
    // quad patch in space, which is exact only while its four corners are coplanar
    // and not a bound at all once they are not.
    //
    // Read the doc comment for what the sign means, because it differs by shape:
    //
    //  - A SOLID (sphere, disk, capsule, triangle in the plane) gives a true signed
    //    field: negative inside, zero on the boundary, positive outside.
    //  - An unbounded HALF-REGION (a plane, a half-space, a half-plane) gives the
    //    signed field of the region behind its boundary.
    //  - A ZERO-THICKNESS shape (a segment; a triangle or quad patch in space) has
    //    no interior for a sign to describe, so its field is non-negative everywhere
    //    and zero only on the shape itself. It is still a usable distance field —
    //    ray marching and offsetting work — but `IsInside` is false everywhere, and
    //    a Boolean subtraction against it removes nothing. Use the overload taking a
    //    radius or a thickness to get the solid form instead, which is the shape's
    //    Minkowski sum with a ball and has an exact signed distance.

    // The distance to the sphere's surface: negative inside the ball.
    ToSdf(s: Sphere): FunctionSdf3D
        => FunctionSdf3D(p => s.Center.Between(p).Magnitude - s.Radius);

    // The distance to the circle: negative inside the disk.
    ToSdf(c: Circle): FunctionSdf2D
        => FunctionSdf2D(p => c.Center.Between(p).Magnitude - c.Radius);

    // The distance to the capsule's surface: negative inside the swept solid.
    ToSdf(c: Capsule3D): FunctionSdf3D
        => FunctionSdf3D(p => DistanceToCapsule(p, c.A, c.B, c.Radius));

    // The planar form: negative inside the stadium.
    ToSdf(c: Capsule2D): FunctionSdf2D
        => FunctionSdf2D(p => DistanceToCapsule(p, c.A, c.B, c.Radius));

    // The distance to the annulus: negative between the two circles, positive both
    // inside the hole and outside the outer rim.
    ToSdf(a: Annulus): FunctionSdf2D
        => FunctionSdf2D(p =>
            (a.Center.Between(p).Magnitude - (a.InnerRadius + a.OuterRadius) * 0.5).Abs
            - (a.OuterRadius - a.InnerRadius) * 0.5);

    // The plane as the field of the half-space BEHIND it: negative on the back side,
    // positive on the side Normal points to. A plane has no thickness, so this is
    // the only reading of it that carries a sign; take `.Abs` of the result for the
    // unsigned distance to the plane itself.
    ToSdf(pl: Plane): FunctionSdf3D
        => FunctionSdf3D(p => pl.SignedDistance(p));

    // The half-space's own field: negative inside it, which is the same field as its
    // boundary plane's, stated on the type that actually denotes the solid region.
    ToSdf(h: HalfSpace): FunctionSdf3D
        => FunctionSdf3D(p => h.Boundary.SignedDistance(p));

    // The planar counterpart: negative inside the half-plane.
    ToSdf(h: HalfPlane2D): FunctionSdf2D
        => FunctionSdf2D(p => h.SignedDistance(p));

    // The distance to the segment. Zero-thickness: non-negative everywhere, zero
    // only on the segment.
    ToSdf(l: Line2D): FunctionSdf2D
        => FunctionSdf2D(p => DistanceToSegment(l.A, l.B, p));

    // The segment thickened by radius — a stadium, and a true signed field.
    // Equivalent to `Capsule2D(l.A, l.B, radius).ToSdf`.
    ToSdf(l: Line2D, radius: Number): FunctionSdf2D
        => FunctionSdf2D(p => DistanceToCapsule(p, l.A, l.B, radius));

    // The distance to the segment in space. Zero-thickness, as in the plane.
    ToSdf(l: Line3D): FunctionSdf3D
        => FunctionSdf3D(p => DistanceToSegment(l.A, l.B, p));

    // The segment thickened by radius — a capsule, and a true signed field.
    ToSdf(l: Line3D, radius: Number): FunctionSdf3D
        => FunctionSdf3D(p => DistanceToCapsule(p, l.A, l.B, radius));

    // The triangle in the plane is a SOLID region, so this is a true signed field:
    // negative inside. Winding-agnostic, following DistanceToTriangle.
    ToSdf(t: Triangle2D): FunctionSdf2D
        => FunctionSdf2D(p => DistanceToTriangle(p, t.A, t.B, t.C));

    // The quadrilateral in the plane, likewise solid and signed. Concave rings are
    // handled; the ring must be simple. Precondition: as DistanceToQuad.
    ToSdf(q: Quad2D): FunctionSdf2D
        => FunctionSdf2D(p => DistanceToQuad(p, q.A, q.B, q.C, q.D));

    // The triangle in SPACE is a patch, not a solid: zero-thickness, so the field is
    // non-negative and zero only on the patch. This is the per-face building block a
    // mesh-to-field conversion would take the minimum over — with the caveat that
    // the minimum of unsigned face fields is itself unsigned, and recovering a sign
    // for a closed mesh needs a separate inside test.
    ToSdf(t: Triangle3D): FunctionSdf3D
        => FunctionSdf3D(p => UnsignedDistanceToTriangle(p, t.A, t.B, t.C));

    // The triangle patch given a thickness: the plate of all points within half of
    // thickness of it, with rounded edges and rim. A true signed field.
    ToSdf(t: Triangle3D, thickness: Number): FunctionSdf3D
        => FunctionSdf3D(p =>
            UnsignedDistanceToTriangle(p, t.A, t.B, t.C) - thickness * 0.5);

    // The quad patch in space: zero-thickness, as the triangle. Exact for a planar
    // quad; see UnsignedDistanceToQuad for the non-planar caveat.
    ToSdf(q: Quad3D): FunctionSdf3D
        => FunctionSdf3D(p => UnsignedDistanceToQuad(p, q.A, q.B, q.C, q.D));

    // The quad patch thickened into a rounded plate. A true signed field.
    ToSdf(q: Quad3D, thickness: Number): FunctionSdf3D
        => FunctionSdf3D(p =>
            UnsignedDistanceToQuad(p, q.A, q.B, q.C, q.D) - thickness * 0.5);

    //==
    // # Time-varying field bodies
    //
    // Bodies for the time-varying field interfaces declared in
    // `fields.concepts.plato`: sampling at an instant, and the change
    // and monotonicity queries between two instants.

    //==
    // # ITimeVaryingScalarField2D
    //
    // A planar scalar field evolving over a timeline; sampled at (point, time).
    // TODO(interface-gap): an average rate of change would divide the value change
    // by the elapsed time, but Instant differences yield a Duration and no
    // sanctioned Duration-to-Number division is in scope here; only the raw
    // change and monotonicity tests are offered.

    // The scalar value at the point at a given instant; a readable spelling of
    // EvalAtTime.
    ValueAtTime(self: ITimeVaryingScalarField2D, point: Point2D, time: Instant): Number
        => self.EvalAtTime(point, time);

    // The change in value at the point from the earlier instant to the later one.
    ChangeBetween(self: ITimeVaryingScalarField2D, point: Point2D, earlier: Instant, later: Instant): Number
        => self.EvalAtTime(point, later) - self.EvalAtTime(point, earlier);

    // True where the value at the point is greater at the later instant than the
    // earlier one.
    HasIncreasedBetween(self: ITimeVaryingScalarField2D, point: Point2D, earlier: Instant, later: Instant): Boolean
        => self.EvalAtTime(point, later) > self.EvalAtTime(point, earlier);

    // True where the value at the point is smaller at the later instant than the
    // earlier one.
    HasDecreasedBetween(self: ITimeVaryingScalarField2D, point: Point2D, earlier: Instant, later: Instant): Boolean
        => self.EvalAtTime(point, later) < self.EvalAtTime(point, earlier);

    //==
    // # ITimeVaryingScalarField3D
    //
    // A spatial scalar field evolving over a timeline.

    // The scalar value at the point at a given instant; a readable spelling of
    // EvalAtTime.
    ValueAtTime(self: ITimeVaryingScalarField3D, point: Point3D, time: Instant): Number
        => self.EvalAtTime(point, time);

    // The change in value at the point from the earlier instant to the later one.
    ChangeBetween(self: ITimeVaryingScalarField3D, point: Point3D, earlier: Instant, later: Instant): Number
        => self.EvalAtTime(point, later) - self.EvalAtTime(point, earlier);

    // True where the value at the point is greater at the later instant than the
    // earlier one.
    HasIncreasedBetween(self: ITimeVaryingScalarField3D, point: Point3D, earlier: Instant, later: Instant): Boolean
        => self.EvalAtTime(point, later) > self.EvalAtTime(point, earlier);

    // True where the value at the point is smaller at the later instant than the
    // earlier one.
    HasDecreasedBetween(self: ITimeVaryingScalarField3D, point: Point3D, earlier: Instant, later: Instant): Boolean
        => self.EvalAtTime(point, later) < self.EvalAtTime(point, earlier);

    //==
    // # ITimeVaryingVectorField2D
    //
    // A planar vector field evolving over a timeline: 2D flows and animated
    // displacement maps.

    // The vector at the point at a given instant; a readable spelling of
    // EvalAtTime.
    VectorAtTime(self: ITimeVaryingVectorField2D, point: Point2D, time: Instant): Vector2D
        => self.EvalAtTime(point, time);

    // The flow speed at the point at a given instant: the sampled vector's length.
    MagnitudeAtTime(self: ITimeVaryingVectorField2D, point: Point2D, time: Instant): Number
        => self.EvalAtTime(point, time).Magnitude;

    // The change in the vector at the point from the earlier instant to the later.
    ChangeBetween(self: ITimeVaryingVectorField2D, point: Point2D, earlier: Instant, later: Instant): Vector2D
        => self.EvalAtTime(point, later) - self.EvalAtTime(point, earlier);

    //==
    // # ITimeVaryingVectorField3D
    //
    // A spatial vector field evolving over a timeline: fluid velocity, wind, and
    // turbulence used for advection.

    // The vector at the point at a given instant; a readable spelling of
    // EvalAtTime.
    VectorAtTime(self: ITimeVaryingVectorField3D, point: Point3D, time: Instant): Vector3D
        => self.EvalAtTime(point, time);

    // The flow speed at the point at a given instant: the sampled vector's length.
    MagnitudeAtTime(self: ITimeVaryingVectorField3D, point: Point3D, time: Instant): Number
        => self.EvalAtTime(point, time).Magnitude;

    // The change in the vector at the point from the earlier instant to the later.
    ChangeBetween(self: ITimeVaryingVectorField3D, point: Point3D, earlier: Instant, later: Instant): Vector3D
        => self.EvalAtTime(point, later) - self.EvalAtTime(point, earlier);
}
