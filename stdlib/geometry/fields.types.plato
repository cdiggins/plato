//==
// # Fields
//
// Sections, in order:
//  - Constant fields
//  - Function-valued fields
//  - Field expression graphs

//==
// # Constant fields
//
// The trivial fields: the same value everywhere. Useful as defaults and as
// leaves of field expressions. Their evaluation bodies live in
// `fields-implicits.library.plato`.

// A planar scalar field with the same value at every point.
type ConstantScalarField2D
    implements Value, ScalarField2D
{
    Value: Number;
}

// A spatial scalar field with the same value at every point.
type ConstantScalarField3D
    implements Value, ScalarField3D
{
    Value: Number;
}

// A planar vector field with the same vector at every point.
type ConstantVectorField2D
    implements Value, VectorField2D
{
    Value: Vector2D;
}

// A spatial vector field with the same vector at every point.
type ConstantVectorField3D
    implements Value, VectorField3D
{
    Value: Vector3D;
}

//==
// # Function-valued fields
//
// A field that **stores a function value** rather than deriving its value from
// stored data. This is the compositional layer beneath the declarative node
// graphs of the next section: a function-valued field is built from a
// lambda, evaluated by invoking the stored function, and combined with another
// field into a new field holding the composed lambda. The combinators (Combine,
// MapValue, MapDomain, Union, Intersection, Difference, Offset) live in
// `fields-implicits.library.plato`; `ToFunctionField` lifts any field
// concept implementor into this form so the combinators apply to all of them.
//
// These are deliberately monomorphic (one type per domain/range pair) rather
// than one generic function-carrying type: the monomorphic shape is what
// monomorphizes cleanly to every backend.
//
// **Domain and range dimensions.** A Procedural is classified by what it maps
// from and to; the dimension of the domain is the dimension of the form's
// parameter space, the dimension of the range is the space it lives in. The
// field concepts of `fields.concepts.plato` are the point-domain rows of that
// table:
//
//   Number  -> Number    a scalar function of one variable (an easing curve)
//   Number  -> Point2D   a parametric curve in the plane
//   Number  -> Point3D   a parametric curve in space
//   Point2D -> Number    a planar scalar field (a 2D signed distance field)
//   Point2D -> Vector2D  a planar vector field
//   Point2D -> Point3D   a parametric surface in space
//   Point3D -> Number    a spatial scalar field (a 3D signed distance field)
//   Point3D -> Vector3D  a spatial vector field
//
// A Procedural whose range is Boolean is a **predicate**: a threshold over a
// Number domain, a region over Point2D, a volume over Point3D — membership
// with no distance information (see `implicit-sdf.concepts.plato`). A
// Procedural over an integer domain is a discrete field: an unbounded array, a
// texture sampler, or a voxel grid. Continuous forms are analytic and
// resolution independent; discrete forms (meshes, polylines, point clouds,
// sampled grids) instead enumerate a countable set of primitives.

// A planar scalar field defined by a stored function from a plane position to a
// number. The canonical function-valued field: heightmaps, masks, potentials,
// and planar signed distances all take this form.
type ScalarFunctionField2D
    implements ScalarField2D
{
    Function: Function1<Point2D, Number>;
}

// A spatial scalar field defined by a stored function from a space position to
// a number: densities, potentials, and implicit surfaces.
type ScalarFunctionField3D
    implements ScalarField3D
{
    Function: Function1<Point3D, Number>;
}

// A planar vector field defined by a stored function from a plane position to a
// 2D vector: gradients, flows, and displacement maps.
type VectorFunctionField2D
    implements VectorField2D
{
    Function: Function1<Point2D, Vector2D>;
}

// A spatial vector field defined by a stored function from a space position to
// a 3D vector: velocity fields, force fields, and displacement fields.
type VectorFunctionField3D
    implements VectorField3D
{
    Function: Function1<Point3D, Vector3D>;
}

//==
// # Field expression graphs
//
// Flat, index-based combinator graphs over scalar fields. Each node is one
// operation carrying exactly the operands it consumes: operand nodes referenced
// by index into the owning graph's node array (operands are always lower-indexed
// nodes), and externally supplied source fields referenced by index into a
// caller-maintained field list. The recursive evaluators live in
// `fields-graphs.library.plato`.

// A zero-based index of a node within a field expression graph's node array.
// Operands always reference lower-indexed nodes; -1 means "none".
type FieldNodeIndex
    implements Value, Hashable, Comparable, Index
{
    Value: Integer;
}

// One node of a flat planar scalar-field expression graph: a single operation
// carrying exactly the operands it consumes. FieldNodeIndex fields are node
// indices into the owning graph; FieldIndex is an index into an external list
// of planar scalar fields; Constant carries a literal. Lerp's Weight and Clamp's/Remap's
// bounds are themselves nodes; Remap linearly maps Input from [FromLow, FromHigh]
// onto the unit range [0, 1].
type ScalarFieldNode2D
    implements Value
    = Source(FieldIndex: ItemIndex)                              // read an external planar scalar field
    | Constant(Value: Number)                                    // a literal constant
    | Add(Left: FieldNodeIndex, Right: FieldNodeIndex)                         // Left + Right
    | Subtract(Left: FieldNodeIndex, Right: FieldNodeIndex)                    // Left - Right
    | Multiply(Left: FieldNodeIndex, Right: FieldNodeIndex)                    // Left * Right
    | Divide(Left: FieldNodeIndex, Right: FieldNodeIndex)                      // Left / Right
    | Minimum(Left: FieldNodeIndex, Right: FieldNodeIndex)                     // min(Left, Right)
    | Maximum(Left: FieldNodeIndex, Right: FieldNodeIndex)                     // max(Left, Right)
    | Negate(Input: FieldNodeIndex)                                            // -Input
    | AbsoluteValue(Input: FieldNodeIndex)                                     // |Input|
    | Lerp(A: FieldNodeIndex, B: FieldNodeIndex, Weight: FieldNodeIndex)       // A blended toward B by Weight
    | Clamp(Input: FieldNodeIndex, Low: FieldNodeIndex, High: FieldNodeIndex)  // Input clamped to [Low, High]
    | Remap(Input: FieldNodeIndex, FromLow: FieldNodeIndex, FromHigh: FieldNodeIndex) // Input remapped from [FromLow, FromHigh] to [0, 1]
    | Threshold(Input: FieldNodeIndex, Level: FieldNodeIndex);                 // 1 where Input >= Level, else 0

// A flat expression graph combining planar scalar fields. Nodes may only
// reference lower-indexed nodes, making the array a valid topological order;
// Root is the index of the node producing the result.
type ScalarFieldGraph2D
    implements Value
{
    Nodes: Array<ScalarFieldNode2D>;
    Root: FieldNodeIndex;
}

// One node of a flat spatial scalar-field expression graph, mirroring
// ScalarFieldNode2D: a single operation carrying exactly the operands it
// consumes. FieldNodeIndex fields are node indices into the owning graph;
// FieldIndex is an index into an external list of spatial scalar fields;
// Constant carries a literal.
type ScalarFieldNode3D
    implements Value
    = Source(FieldIndex: ItemIndex)                              // read an external spatial scalar field
    | Constant(Value: Number)                                    // a literal constant
    | Add(Left: FieldNodeIndex, Right: FieldNodeIndex)                         // Left + Right
    | Subtract(Left: FieldNodeIndex, Right: FieldNodeIndex)                    // Left - Right
    | Multiply(Left: FieldNodeIndex, Right: FieldNodeIndex)                    // Left * Right
    | Divide(Left: FieldNodeIndex, Right: FieldNodeIndex)                      // Left / Right
    | Minimum(Left: FieldNodeIndex, Right: FieldNodeIndex)                     // min(Left, Right)
    | Maximum(Left: FieldNodeIndex, Right: FieldNodeIndex)                     // max(Left, Right)
    | Negate(Input: FieldNodeIndex)                                            // -Input
    | AbsoluteValue(Input: FieldNodeIndex)                                     // |Input|
    | Lerp(A: FieldNodeIndex, B: FieldNodeIndex, Weight: FieldNodeIndex)       // A blended toward B by Weight
    | Clamp(Input: FieldNodeIndex, Low: FieldNodeIndex, High: FieldNodeIndex)  // Input clamped to [Low, High]
    | Remap(Input: FieldNodeIndex, FromLow: FieldNodeIndex, FromHigh: FieldNodeIndex) // Input remapped from [FromLow, FromHigh] to [0, 1]
    | Threshold(Input: FieldNodeIndex, Level: FieldNodeIndex);                 // 1 where Input >= Level, else 0

// A flat expression graph combining spatial scalar fields. Nodes may only
// reference lower-indexed nodes, making the array a valid topological order;
// Root is the index of the node producing the result.
type ScalarFieldGraph3D
    implements Value
{
    Nodes: Array<ScalarFieldNode3D>;
    Root: FieldNodeIndex;
}
