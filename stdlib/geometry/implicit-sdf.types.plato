//==
// # Implicit SDF
//
// Sections, in order:
//  - Bounded function-valued signed distance fields
//  - Function-valued implicit shapes
//  - Metaballs
//  - SDF modifiers
//  - Sampled signed distance fields
//  - SDF combination trees

//=
// # Bounded function-valued signed distance fields
//
// Analytic SDFs packaged with a conservative AABB for culling, tiling, and
// CSG acceleration. Bounds do not change distance evaluation: Eval /
// DistanceAt always delegate to the inner FunctionSdf. Prefer loose bounds
// over tight ones — incorrect tight bounds cause false culls.
// Convention: see CONVENTIONS.md - Bounds.
// Related: `SignedDistanceField*` / `BoundedSignedDistanceField*` in
// `implicit-sdf.concepts.plato`; sampled lattices with Bounds below; operators
// in `implicit-sdf.library.plato`.

// A planar function SDF with a conservative bounding rectangle. Outside
// Bounds the solid may be treated as empty for culling; the stored distance
// function is still evaluated on request.
type BoundedSdf2D
    implements Value, BoundedSignedDistanceField2D
{
    Sdf: FunctionSdf2D;
    Bounds: Bounds2D;
}

// A spatial function SDF with a conservative bounding box. Outside Bounds
// the solid may be treated as empty for culling; the stored distance
// function is still evaluated on request.
type BoundedSdf3D
    implements Value, BoundedSignedDistanceField3D
{
    Sdf: FunctionSdf3D;
    Bounds: Bounds3D;
}

//==
// # Function-valued implicit shapes
//
// The implicit counterparts of the function-valued fields in
// `fields.types.plato`: a value that STORES the distance function or the
// membership predicate rather than storing data it is derived from. These are
// what the closed-form distance primitives and the CSG combinators in
// `implicit-sdf.library.plato` and
// `fields-implicits.library.plato` produce and consume, and they are the
// only implementors of ImplicitRegion2D and ImplicitVolume3D — a predicate has
// nothing to store but its predicate.
//
// A distance field carries strictly more information than a region: every SDF
// induces a region (inside is distance < 0), but a region cannot recover a
// distance. Prefer the SDF form wherever a closed-form distance exists.

// A planar signed distance field defined by a stored distance function:
// negative inside the boundary curve, zero on it, positive outside.
type FunctionSdf2D
    implements SignedDistanceField2D
{
    Function: Function1<Point2D, Number>;
}

// A spatial signed distance field defined by a stored distance function:
// negative inside the surface, zero on it, positive outside.
type FunctionSdf3D
    implements SignedDistanceField3D
{
    Function: Function1<Point3D, Number>;
}

// A planar region defined by a stored membership predicate: true inside.
// Carries no distance information.
type FunctionRegion2D
    implements ImplicitRegion2D
{
    Function: Function1<Point2D, Boolean>;
}

// A spatial volume defined by a stored membership predicate: true inside.
// Carries no distance information.
type FunctionVolume3D
    implements ImplicitVolume3D
{
    Function: Function1<Point3D, Boolean>;
}

//==
// # Metaballs
//
// Smooth organic shapes from summed radial falloff kernels
// (https://en.wikipedia.org/wiki/Metaballs). The implicit surface is the level
// set (https://en.wikipedia.org/wiki/Level_set) where the summed influence
// equals the threshold. The falloff kernel and the summation live in
// `fields-implicits.library.plato`.

// A planar metaball: a radial falloff kernel centered at a point. Influence
// is Strength at the center and falls to zero at Radius.
type MetaBall2D
    implements Value
{
    Center: Point2D;
    Radius: Number;
    Strength: Number;
}

// A spatial metaball: a radial falloff kernel centered at a point. Influence
// is Strength at the center and falls to zero at Radius. Negative strengths
// carve away from the surface.
type MetaBall3D
    implements Value
{
    Center: Point3D;
    Radius: Number;
    Strength: Number;
}

// A planar blob system: the field value at a point is the summed influence
// of all balls minus Threshold, so the zero level set is the blob outline.
type MetaBallSystem2D
    implements Value, ScalarField2D
{
    Balls: Array<MetaBall2D>;
    Threshold: Number;
}

// A spatial blob system: the field value at a point is the summed influence
// of all balls minus Threshold, so the zero level set is the blob surface.
type MetaBallSystem3D
    implements Value, ScalarField3D
{
    Balls: Array<MetaBall3D>;
    Threshold: Number;
}

//==
// # SDF modifiers
//
// Parameter records for standard distance-field transformations. Each
// describes how a source SDF is reshaped; the source itself is supplied by
// the evaluation context. The functions that apply them live in
// `implicit-sdf.library.plato`.

// Rounds sharp edges and corners by subtracting Radius from the distance,
// inflating the shape and smoothing its features.
type SdfRoundingModifier
    implements Value
{
    Radius: Number;
}

// Replaces a solid with its shell: the region within half of Thickness on
// either side of the original surface.
type SdfShellModifier
    implements Value
{
    Thickness: Number;
}

// Replaces a solid with Count concentric shells spaced by Thickness, like
// the layers of an onion. Count of 1 is equivalent to a single shell.
type SdfOnionModifier
    implements Value
{
    Thickness: Number;
    Count: Integer;
}

// Stretches a planar shape by splitting it at the origin and inserting a
// straight section of the given extent along each axis.
type SdfElongationModifier2D
    implements Value
{
    Amount: Vector2D;
}

// Stretches a spatial shape by splitting it at the origin and inserting a
// straight section of the given extent along each axis.
type SdfElongationModifier3D
    implements Value
{
    Amount: Vector3D;
}

// Tiles a planar shape on a lattice with the given period per axis. Counts
// bounds the repetitions per axis; a non-positive count means unbounded
// repetition along that axis.
type SdfRepetitionModifier2D
    implements Value
{
    Period: Vector2D;
    Counts: IntegerVector2;
}

// Tiles a spatial shape on a lattice with the given period per axis. Counts
// bounds the repetitions per axis; a non-positive count means unbounded
// repetition along that axis.
type SdfRepetitionModifier3D
    implements Value
{
    Period: Vector3D;
    Counts: IntegerVector3;
}

// Twists a spatial shape about the Z axis: each horizontal slice rotates by
// AnglePerUnit times its height.
type SdfTwistModifier3D
    implements Value
{
    AnglePerUnit: Angle;
}

// Bends a spatial shape about the Y axis with the given curvature (turning
// angle per unit of length along X); 0 leaves the shape unchanged.
type SdfBendModifier3D
    implements Value
{
    Curvature: Number;
}

// Displaces a surface by a scalar field: Source indexes a caller-supplied
// list of spatial scalar fields whose value, scaled by Amplitude, offsets
// the distance. The result is a bound, not an exact distance.
type SdfDisplacementModifier3D
    implements Value
{
    Source: ItemIndex;
    Amplitude: Number;
}

//==
// # Sampled signed distance fields
//
// Discretized SDFs: distance values on a regular lattice over a bounding
// region, interpolated between samples on evaluation. The interpolating
// evaluators live in `implicit-sdf.library.plato`; the lattice
// geometry accessors in `fields-implicits.library.plato`.

// A planar SDF discretized on a regular lattice spanning Bounds. Values holds
// one signed distance per lattice node, in row-major column/row order;
// evaluation between nodes interpolates bilinearly. Implements the bounded
// SDF concept: Bounds are the lattice domain (finite support), not merely
// a culling hint.
type SampledSdf2D
    implements Value, BoundedSignedDistanceField2D
{
    Values: Array2D<Number>;
    Bounds: Bounds2D;
}

// A spatial SDF discretized on a regular lattice spanning Bounds. Values holds
// one signed distance per lattice node, in column/row/layer order; evaluation
// between nodes interpolates trilinearly. Implements the bounded SDF concept:
// Bounds are the lattice domain (finite support).
type SampledSdf3D
    implements Value, BoundedSignedDistanceField3D
{
    Values: Array3D<Number>;
    Bounds: Bounds3D;
}

//==
// # SDF combination trees
//
// Constructive solid geometry (https://en.wikipedia.org/wiki/Constructive_solid_geometry)
// over signed distance fields, stored as flat arrays of nodes. Leaves reference
// primitives by index into a caller-supplied primitive list; interior nodes
// combine two children by node index. The recursive evaluators live in
// `implicit-sdf.library.plato`.

// The Boolean or blending operation an SDF combination node applies.
// Union is the distance minimum, Intersection the maximum, Difference the
// left child minus the right. Smooth variants blend over their own Radius;
// Blend linearly interpolates the two child distances by Weight.
type SdfCombine
    = Union
    | Intersection
    | Difference
    | ExclusiveOr
    | SmoothUnion(Radius: Number)
    | SmoothIntersection(Radius: Number)
    | SmoothDifference(Radius: Number)
    | Blend(Weight: Proportion);

// A zero-based index of a node within an SDF combination tree's node array.
// Nodes only reference lower-indexed nodes; -1 means "unused".
type SdfNodeIndex
    implements Value, Hashable, Comparable, Index
{
    Value: Integer;
}

// One node of a flat planar SDF tree. Leaves reference a primitive by index
// into an external primitive list; interior nodes combine two lower-indexed
// nodes. Child references are node indices, never embedded nodes.
type SdfNode2D
    implements Value
    = Leaf(Primitive: ItemIndex)
    | Interior(Combine: SdfCombine, Left: SdfNodeIndex, Right: SdfNodeIndex);

// A flat planar SDF combination tree. Nodes may only reference lower-indexed
// nodes; Root is the index of the node producing the final distance. Leaf
// primitive indices resolve against a caller-supplied list of planar SDFs.
type SdfTree2D
    implements Value
{
    Nodes: Array<SdfNode2D>;
    Root: SdfNodeIndex;
}

// One node of a flat spatial SDF tree. Leaves reference a primitive by index
// into an external primitive list; interior nodes combine two lower-indexed
// nodes. Child references are node indices, never embedded nodes.
type SdfNode3D
    implements Value
    = Leaf(Primitive: ItemIndex)
    | Interior(Combine: SdfCombine, Left: SdfNodeIndex, Right: SdfNodeIndex);

// A flat spatial SDF combination tree. Nodes may only reference lower-indexed
// nodes; Root is the index of the node producing the final distance. Leaf
// primitive indices resolve against a caller-supplied list of spatial SDFs.
type SdfTree3D
    implements Value
{
    Nodes: Array<SdfNode3D>;
    Root: SdfNodeIndex;
}
