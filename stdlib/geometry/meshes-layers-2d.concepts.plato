//==
// # Planar mesh geometry layers
//
// The planar twins of the named layers in `meshes-layers.concepts.plato`: the
// same view / storage split over Point2D. These are not a lesser case of the 3D
// names — UV domains, profile and cap regions, finite-element meshes and
// navigation meshes all live natively in the plane, and a planar algorithm
// should not have to accept a 3D shape to be reused.
// Convention: see CONVENTIONS.md - Winding, handedness, and normals.

// Straight segments in the plane over their own endpoints: sketch overlays,
// hatch patterns, planar graphs drawn as geometry.
concept LineGeometry2D
    inherits Geometry2D, PrimitiveGeometry<Point2D, Line2D>
{ }

// Triangles in the plane, wound counter-clockwise: triangulations, Delaunay
// output, finite-element cells.
concept TriangleGeometry2D
    inherits Geometry2D, PrimitiveGeometry<Point2D, Triangle2D>
{ }

// Quadrilaterals in the plane, wound counter-clockwise: structured grid cells
// and quad-dominant planar layouts.
concept QuadGeometry2D
    inherits Geometry2D, PrimitiveGeometry<Point2D, Quad2D>
{ }

// Segments in the plane over a shared vertex pool, each spelled as a vertex
// pair. `LineSet2D` (`meshes-lines-points.types.plato`) is the concrete type.
concept IndexedLineGeometry2D
    inherits IndexedGeometry<Point2D, Line2D, VertexPair>, LineGeometry2D
{ }

// Triangles in the plane over a shared vertex pool, each spelled as a
// TriangleFace: concretely `TriangleMesh2D` (`meshes.types.plato`).
concept IndexedTriangleGeometry2D
    inherits IndexedGeometry<Point2D, Triangle2D, TriangleFace>, TriangleGeometry2D
{ }

// Quadrilaterals in the plane over a shared vertex pool, each spelled as a
// QuadFace: structured planar grids and quad meshing output.
concept IndexedQuadGeometry2D
    inherits IndexedGeometry<Point2D, Quad2D, QuadFace>, QuadGeometry2D
{ }
