//==
// # Meshes polygon
//
// Sections, in order:
//  - MeshesPolygon — face and corner access for PolygonMesh3D
//  - Constructing and exporting PolygonMesh3D
//  - Half-edge navigation over PolygonMesh3D corners
//  - The IMeshIncidence rung for PolygonMesh3D

library MeshesPolygon
{
    //==
    // # MeshesPolygon — face and corner access for PolygonMesh3D
    //
    // PolygonMesh3D HAS a `JaggedArray<VertexIndex>` face table with one row per
    // face, so row arithmetic — RowCount / RowLength / Row / RowElement — comes from
    // `collections.library.plato` through `self.Faces` and is NOT restated
    // here. What this library adds is the mesh reading of those rows, and the one thing
    // the packing seam does not name: the CORNER.
    //
    // A corner is one vertex slot of one face, numbered globally by its position in
    // the packed values. That global corner number doubles as a half-edge
    // identifier — corner c is the directed edge from its own vertex to the next
    // corner of the same face — which is what lets the Conway operators run with no
    // side table at all. The navigation built on it follows in the sections below.

    //==
    // IMeshElementCounts obligations. VertexCount and FaceCount are direct reads;
    // UndirectedEdgeCount dedupes through the canonical-corner rule, so it holds
    // for open meshes as well as closed ones.

    // The number of positions the faces index into.
    VertexCount(self: PolygonMesh3D): Integer
        => self.Positions.Count;

    // The number of faces: one face-table row each.
    FaceCount(self: PolygonMesh3D): Integer
        => self.Faces.RowCount;

    // The number of undirected edges: one per canonical corner. An interior edge
    // is named by the lower half of its twin pair, a boundary edge by its only
    // corner, so no edge is double-counted and none is missed. The canonical rule
    // itself is `IsCanonicalCorner`, below.
    UndirectedEdgeCount(self: PolygonMesh3D): Integer
        => self.CornerCount
            .MapRange(c => self.IsCanonicalCorner(CornerIndex(c)) ? 1 : 0)
            .Reduce(0, (acc, hit) => acc + hit);

    //==
    // Corners: the global vertex slots, and the face-relative way in.

    // The total number of face corners across the whole mesh.
    CornerCount(self: PolygonMesh3D): Integer
        => self.Faces.Values.Count;

    // The number of vertices of a face. Precondition: 0 <= face < FaceCount.
    FaceArity(self: PolygonMesh3D, face: Integer): Integer
        => self.Faces.RowLength(face);

    // The corner at face f's slot-th vertex, wrapping around the face so
    // slot + 1 is always the next corner counter-clockwise.
    // Precondition: 0 <= face < FaceCount, slot >= 0.
    FaceCorner(self: PolygonMesh3D, face: Integer, slot: Integer): CornerIndex
        => CornerIndex(self.Faces.Offsets[face] + (slot % self.FaceArity(face)));

    // The vertex a corner refers to. Precondition: the corner is present.
    CornerVertex(self: PolygonMesh3D, corner: CornerIndex): VertexIndex
        => self.Faces.Values[corner];

    // The position a corner refers to. Precondition: the corner is present.
    CornerPosition(self: PolygonMesh3D, corner: CornerIndex): Point3D
        => self.Positions[self.CornerVertex(corner)];

    //==
    // IWhole-face views. The vertex loop itself is `Faces.Row(face)`.

    // The positions of one face in counter-clockwise order.
    // Precondition: 0 <= face < FaceCount.
    FacePositions(self: PolygonMesh3D, face: Integer): Array<Point3D>
        => self.Faces.Row(face).Map(v => self.Positions[v.Value]);

    // The average of a face's vertex positions. Coincides with the area centroid
    // only for a regular face, which is exactly the polyhedral case the Conway
    // dual needs (https://en.wikipedia.org/wiki/Centroid).
    FaceCentroid(self: PolygonMesh3D, face: Integer): Point3D
        => self.FacePositions(face).AverageOfPoints;

    // Every face centroid, in face order: the vertex positions of the dual.
    FaceCentroids(self: PolygonMesh3D): Array<Point3D>
        => self.FaceCount.MapRange(f => self.FaceCentroid(f));

    // The IDeformable3D obligation: every vertex position carried through the
    // mapping, the face table unchanged.
    Deform(self: PolygonMesh3D, mapping: Function1<Point3D, Point3D>): PolygonMesh3D
        => (self.Positions.Map(mapping), self.Faces);

    //==
    // # Constructing and exporting PolygonMesh3D
    //
    // The two directions the polygon mesh is crossed: IN from face vertex loops
    // (packed through `FromRows` in `collections.library.plato`, the one
    // place ragged rows become offsets) and OUT to the triangle-mesh interchange
    // form, plus the whole-mesh position maps the polyhedra seeds are stated with.
    //
    // Nothing here reads connectivity — that is the incidence section below.

    //==
    // Construction.

    // A polygon mesh from explicit face vertex loops, each wound
    // counter-clockwise seen from outside.
    // Convention: see CONVENTIONS.md - Winding, handedness, and normals.
    PolygonMeshOfFaces(positions: Array<Point3D>, faces: Array<Array<VertexIndex>>): PolygonMesh3D
        => (positions, FromRows(faces));

    // The same, from plain vertex numbers: the readable form for the literal
    // face tables of the polyhedra seeds.
    PolygonMeshOfVertexNumbers(positions: Array<Point3D>, faces: Array<Array<Integer>>): PolygonMesh3D
        => PolygonMeshOfFaces(positions, faces.Map(face => face.Map(v => VertexIndex(v))));

    //==
    // IWhole-mesh position maps. Connectivity is untouched, so these are the
    // cheap way to place a mesh: the packing is shared, only positions differ.

    // Every vertex pushed out onto the unit sphere. For a polyhedron built from
    // a symmetric vertex table this is what makes the circumscribed radius
    // exactly one, and it is the canonical form the Conway operators return.
    ProjectedToUnitSphere(self: PolygonMesh3D): PolygonMesh3D
        => (self.Positions.Map(p => p.PositionVector.Normalize.ToPoint), self.Faces);

    // Every vertex scaled about the origin. Applied to a unit-sphere mesh this
    // sets the circumscribed radius.
    ScaledAboutOrigin(self: PolygonMesh3D, factor: Number): PolygonMesh3D
        => (self.Positions.Map(p => (p.PositionVector * factor).ToPoint), self.Faces);

    //==
    // Export.

    // One face fanned into triangles from its first vertex: (A, B, C),
    // (A, C, D), … — arity - 2 of them, and exact for a convex face
    // (https://en.wikipedia.org/wiki/Fan_triangulation). Every catalog
    // polyhedron has convex faces; a non-convex face needs a real
    // triangulator instead.
    FaceTriangleFan(self: PolygonMesh3D, face: Integer): Array<TriangleFace>
        => (self.FaceArity(face) - 2).MapRange(i =>
            TriangleFace(self.CornerVertex(self.FaceCorner(face, 0)),
                         self.CornerVertex(self.FaceCorner(face, i + 1)),
                         self.CornerVertex(self.FaceCorner(face, i + 2))));

    // The IMeshable3D obligation: fan every face, sharing the position array
    // unchanged so vertex numbering survives the conversion.
    ToTriangleMesh(self: PolygonMesh3D): TriangleMesh3D
        => (self.Positions,
            self.FaceCount.MapRange(f => f).FlatMap(f => self.FaceTriangleFan(f)));

    //==
    // # Half-edge navigation over PolygonMesh3D corners
    //
    // A corner (see the corner section above) is a directed edge: corner c runs
    // from its own vertex to the vertex of the next corner in the same face. That
    // makes the packed corner array a complete half-edge structure with no side
    // table — the twin of a corner is simply the corner running the other way,
    // found by search rather than stored
    // (https://en.wikipedia.org/wiki/Doubly_connected_edge_list).
    //
    // The searches are linear, so the walks below are quadratic in corner count.
    // That is the right trade for the catalog solids (a truncated icosahedron has
    // 180 corners) and deliberately keeps the mesh free of a built adjacency
    // structure; building and storing half-edge adjacency is separate work.
    //
    // Preconditions throughout: the mesh is a CLOSED manifold — every corner has a
    // twin, and the corners around a vertex form one closed cycle. On an open mesh
    // TwinCorner returns the "none" index and the ring walk does not terminate
    // correctly.

    //==
    // Walking within one face.

    // The face a corner belongs to: the number of face starts at or before it.
    // Precondition: the corner is present.
    CornerFace(self: PolygonMesh3D, corner: CornerIndex): FaceIndex
        => FaceIndex(self.FaceCount
            .MapRange(f => self.Faces.Offsets[f] <= corner.Value ? 1 : 0)
            .Reduce(0, (acc, hit) => acc + hit) - 1);

    // The next corner counter-clockwise around the same face, wrapping from the
    // last corner back to the first. Precondition: the corner is present.
    NextCorner(self: PolygonMesh3D, corner: CornerIndex): CornerIndex
    {
        var face = self.CornerFace(corner).Value;
        return self.FaceCorner(face, corner.Value - self.Faces.Offsets[face] + 1);
    }

    // The vertex a corner points AT, reading the corner as a directed edge: the
    // vertex of the next corner of the same face.
    CornerDestination(self: PolygonMesh3D, corner: CornerIndex): VertexIndex
        => self.CornerVertex(self.NextCorner(corner));

    // The point a fraction t along the edge a corner runs: t = 0 is the corner's
    // own vertex, t = 1 the vertex it points at. The twin runs the other way, so
    // CornerLerp(twin, t) is the point at 1 - t along the same edge.
    CornerLerp(self: PolygonMesh3D, corner: CornerIndex, t: Number): Point3D
        => self.CornerPosition(corner).Lerp(self.CornerPosition(self.NextCorner(corner)), t);

    //==
    // Crossing an edge, and turning around a vertex.

    // The corner running the opposite way along the same undirected edge: the
    // one whose vertex is this corner's destination and whose destination is
    // this corner's vertex. Returns the "none" index when there is none (a
    // boundary edge).
    TwinCorner(self: PolygonMesh3D, corner: CornerIndex): CornerIndex
    {
        var from = self.CornerVertex(corner);
        var to = self.CornerDestination(corner);
        return CornerIndex(self.CornerCount
            .MapRange(c => CornerIndex(c))
            .Reduce(-1, (found, other) =>
                self.CornerVertex(other).Equals(to) && self.CornerDestination(other).Equals(from)
                    ? other.Value
                    : found));
    }

    // The next corner outgoing from the SAME vertex, turning one face along:
    // cross the edge to the neighbouring face, then step to that face's corner
    // at this vertex.
    RotateAroundVertex(self: PolygonMesh3D, corner: CornerIndex): CornerIndex
        => self.NextCorner(self.TwinCorner(corner));

    //==
    // The corners of one vertex.

    // The number of faces meeting at a vertex, which for a closed manifold is
    // also its edge count: one outgoing corner per incident face.
    VertexDegree(self: PolygonMesh3D, vertex: VertexIndex): Integer
        => self.CornerCount
            .MapRange(c => self.Faces.Values[c].Equals(vertex) ? 1 : 0)
            .Reduce(0, (acc, hit) => acc + hit);

    // The lowest-numbered corner at a vertex: the ring walk's starting point.
    // Scans downwards so the last match kept is the smallest. Returns the "none"
    // index for a vertex no face uses.
    FirstCornerOfVertex(self: PolygonMesh3D, vertex: VertexIndex): CornerIndex
        => CornerIndex(self.CornerCount
            .MapRange(i => self.CornerCount - 1 - i)
            .Reduce(-1, (found, c) => self.Faces.Values[c].Equals(vertex) ? c : found));

    // Every corner outgoing from a vertex, in rotation order around it: start at
    // the lowest-numbered one and turn one face at a time. The walk closes back
    // on its start after exactly VertexDegree steps, so the degree — not a
    // termination test — bounds it.
    VertexCornerRing(self: PolygonMesh3D, vertex: VertexIndex): Array<CornerIndex>
    {
        var first = self.FirstCornerOfVertex(vertex);
        var turns = self.VertexDegree(vertex) - 1;
        return turns.MapRange(i => i)
            .Reduce([first], (ring, turn) => ring.Append(self.RotateAroundVertex(ring.Last)));
    }

    // The same ring walked the other way round. A face built around a vertex
    // winds opposite to the rotation that generated it, so the operators that
    // emit one vertex-face per vertex take this order to keep every face of the
    // result wound counter-clockwise from outside.
    ReversedVertexCornerRing(self: PolygonMesh3D, vertex: VertexIndex): Array<CornerIndex>
    {
        var ring = self.VertexCornerRing(vertex);
        return ring.Count.MapRange(i => ring[ring.Count - 1 - i]);
    }

    //==
    // Numbering the undirected edges.
    //
    // An undirected edge is a twin pair, named by its lower corner. Numbering
    // edges by the rank of that corner among all such "canonical" corners gives
    // a dense edge numbering derived entirely from the packing — which is what
    // the ambo operator needs to place one new vertex per edge.

    // True when this corner names its undirected edge: the lower half of a twin
    // pair, or a boundary corner, which has no twin to share the naming with.
    // Convention: see CONVENTIONS.md - Typed indices - -1 means none.
    IsCanonicalCorner(self: PolygonMesh3D, corner: CornerIndex): Boolean
    {
        var twin = self.TwinCorner(corner);
        return twin.IsNone.Or(corner.Value < twin.Value);
    }

    // The dense index of a corner's undirected edge: how many canonical corners
    // precede this edge's own canonical corner. Both halves of a twin pair give
    // the same answer, a boundary corner names its own edge, and the results
    // cover [0, UndirectedEdgeCount) on open and closed meshes alike.
    CornerUndirectedEdge(self: PolygonMesh3D, corner: CornerIndex): UndirectedEdgeIndex
    {
        var twin = self.TwinCorner(corner);
        var canonical = twin.IsNone ? corner.Value : corner.Value.Min(twin.Value);
        return UndirectedEdgeIndex(canonical
            .MapRange(c => self.IsCanonicalCorner(CornerIndex(c)) ? 1 : 0)
            .Reduce(0, (acc, hit) => acc + hit));
    }

    //==
    // # The IMeshIncidence rung for PolygonMesh3D
    //
    // The six incidence queries of `IMeshIncidence` (`topology.concepts.plato`),
    // answered from the packed corner table with no stored adjacency structure. This
    // is the middle rung of the topology ladder: enough to walk the mesh, split it
    // into components, and classify manifoldness, without committing to a built
    // stored half-edge structure.
    //
    // Unlike the ring walks above, nothing here
    // requires a closed manifold: every body is a corner scan, and a boundary edge —
    // whose corner has no twin — is reported as an edge with one incident face.
    //
    // Cost: `CornerUndirectedEdge` is already quadratic in corner count, so the
    // scans that call it per corner are cubic. That is the accepted trade for the
    // catalog solids this representation serves (a truncated icosahedron has 180
    // corners); a stored side table is separate work.
    //
    // Non-manifold limitation: `TwinCorner` resolves to a single opposite corner, so
    // an edge shared by three or more faces cannot be represented faithfully and
    // `FacesOfUndirectedEdge` reports at most two. `IsNonManifoldUndirectedEdge`
    // (`meshes.library.plato`) therefore never fires for this type.

    //==
    // Locating an edge's naming corner.

    // The canonical corner that names an undirected edge, or the "none" index if
    // no corner does. The inverse of `CornerUndirectedEdge`.
    // Convention: see CONVENTIONS.md - Typed indices - -1 means none.
    CanonicalCornerOfUndirectedEdge(self: PolygonMesh3D, edge: UndirectedEdgeIndex): CornerIndex
        => CornerIndex(self.CornerCount
            .MapRange(c => CornerIndex(c))
            .Reduce(-1, (found, c) =>
                self.IsCanonicalCorner(c).And(self.CornerUndirectedEdge(c).Equals(edge))
                    ? c.Value
                    : found));

    // True when either end of the directed edge a corner runs is this vertex.
    CornerTouchesVertex(self: PolygonMesh3D, corner: CornerIndex, vertex: VertexIndex): Boolean
        => self.CornerVertex(corner).Equals(vertex)
            .Or(self.CornerDestination(corner).Equals(vertex));

    //==
    // IMeshIncidence obligations — face side.

    // The corner loop of a face, counter-clockwise: the face's own row of the
    // packed table.
    VerticesOfFace(self: PolygonMesh3D, face: FaceIndex): Array<VertexIndex>
        => self.Faces.Row(face.Value);

    // The undirected edges bounding a face, one per corner, in corner order.
    UndirectedEdgesOfFace(self: PolygonMesh3D, face: FaceIndex): Array<UndirectedEdgeIndex>
        => self.FaceArity(face.Value)
            .MapRange(slot => self.CornerUndirectedEdge(self.FaceCorner(face.Value, slot)));

    //==
    // IMeshIncidence obligations — vertex side.

    // Every face using a vertex, in ascending corner order. An empty result means
    // an isolated vertex. Ascending corner order rather than rotation order, so
    // the answer does not depend on the vertex ring closing.
    FacesOfVertex(self: PolygonMesh3D, vertex: VertexIndex): Array<FaceIndex>
        => self.CornerCount
            .MapRange(c => CornerIndex(c))
            .Reduce(Repeat(0, FaceIndex(0)),
                (acc, c) => self.CornerVertex(c).Equals(vertex)
                    ? acc.Append(self.CornerFace(c))
                    : acc);

    // Every undirected edge with this vertex as an endpoint, each once. Folded
    // over canonical corners only, which is what makes it once rather than twice.
    UndirectedEdgesOfVertex(self: PolygonMesh3D, vertex: VertexIndex): Array<UndirectedEdgeIndex>
        => self.CornerCount
            .MapRange(c => CornerIndex(c))
            .Reduce(Repeat(0, UndirectedEdgeIndex(0)),
                (acc, c) => self.IsCanonicalCorner(c).And(self.CornerTouchesVertex(c, vertex))
                    ? acc.Append(self.CornerUndirectedEdge(c))
                    : acc);

    //==
    // IMeshIncidence obligations — edge side.

    // The two endpoints of an undirected edge, ordered A.Value <= B.Value to
    // match the canonical ordering of `UndirectedEdgeList`
    // (`topology.types.plato`). Direction is not recoverable from an
    // undirected edge; read the naming corner for that.
    VerticesOfUndirectedEdge(self: PolygonMesh3D, edge: UndirectedEdgeIndex): VertexPair
    {
        var corner = self.CanonicalCornerOfUndirectedEdge(edge);
        var a = self.CornerVertex(corner);
        var b = self.CornerDestination(corner);
        return a.Value <= b.Value ? (a, b) : (b, a);
    }

    // The faces meeting at an undirected edge: two for an interior edge, one for
    // a boundary edge. Read from the naming corner and its twin rather than by
    // scanning, which keeps this quadratic instead of cubic.
    FacesOfUndirectedEdge(self: PolygonMesh3D, edge: UndirectedEdgeIndex): Array<FaceIndex>
    {
        var corner = self.CanonicalCornerOfUndirectedEdge(edge);
        var twin = self.TwinCorner(corner);
        return twin.IsNone
            ? [self.CornerFace(corner)]
            : [self.CornerFace(corner), self.CornerFace(twin)];
    }
}
