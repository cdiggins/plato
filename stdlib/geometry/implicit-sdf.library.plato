//==
// # Implicit SDF
//
// Sections, in order:
//  - Bounded SDF evaluation, packaging, culling, and CSG
//  - SDF modifier application
//  - Distance operators
//  - Signed distance primitives
//  - Sampled signed distance field evaluation
//  - SDF combination tree evaluation

library ImplicitSdf
{
    //=
    // # Bounded SDF evaluation, packaging, culling, and CSG
    //
    // Bodies for `BoundedSdf2D/3D` (`implicit-sdf.types.plato`) and culling
    // helpers over every `BoundedSignedDistanceField*`. Bounds are conservative
    // hints: Eval always delegates to the inner field; MayIntersect /
    // IsCulledBy / MayContainPoint use Bounds only.

    //==
    // # Evaluation and packaging

    // The inner planar distance function at the point. Bounds are ignored.
    Eval(self: BoundedSdf2D, point: Point2D): Number
        => self.Sdf.Eval(point);

    // The inner spatial distance function at the point. Bounds are ignored.
    Eval(self: BoundedSdf3D, point: Point3D): Number
        => self.Sdf.Eval(point);

    // Package a planar function SDF with conservative domain bounds.
    WithBounds(self: FunctionSdf2D, bounds: Bounds2D): BoundedSdf2D
        => BoundedSdf2D(self, bounds);

    // Package a spatial function SDF with conservative domain bounds.
    WithBounds(self: FunctionSdf3D, bounds: Bounds3D): BoundedSdf3D
        => BoundedSdf3D(self, bounds);

    // Any planar SDF as a bounded function SDF with the given domain hint.
    WithBounds(self: SignedDistanceField2D, bounds: Bounds2D): BoundedSdf2D
        => self.ToFunctionSdf.WithBounds(bounds);

    // Any spatial SDF as a bounded function SDF with the given domain hint.
    WithBounds(self: SignedDistanceField3D, bounds: Bounds3D): BoundedSdf3D
        => self.ToFunctionSdf.WithBounds(bounds);

    // Drop the bounds, keeping only the stored planar distance function.
    ToFunctionSdf(self: BoundedSdf2D): FunctionSdf2D
        => self.Sdf;

    // Drop the bounds, keeping only the stored spatial distance function.
    ToFunctionSdf(self: BoundedSdf3D): FunctionSdf3D
        => self.Sdf;

    //==
    // # Culling (concept surface — SampledSdf and BoundedSdf)

    // True when the two conservative domains overlap (touching counts). A
    // false result means the solids cannot intersect if each Bounds encloses
    // its non-positive region.
    MayIntersect(a: BoundedSignedDistanceField2D, b: BoundedSignedDistanceField2D): Boolean
        => a.Bounds.Overlaps(b.Bounds);

    // True when the two conservative domains overlap (touching counts).
    MayIntersect(a: BoundedSignedDistanceField3D, b: BoundedSignedDistanceField3D): Boolean
        => a.Bounds.Overlaps(b.Bounds);

    // True when this field's domain overlaps the query rectangle — the query
    // is not entirely outside, so evaluation may still matter.
    MayIntersect(self: BoundedSignedDistanceField2D, query: Bounds2D): Boolean
        => self.Bounds.Overlaps(query);

    // True when this field's domain overlaps the query box.
    MayIntersect(self: BoundedSignedDistanceField3D, query: Bounds3D): Boolean
        => self.Bounds.Overlaps(query);

    // True when the query rectangle lies entirely outside this field's
    // conservative domain: safe to skip for solid queries under the enclosure
    // invariant.
    IsCulledBy(self: BoundedSignedDistanceField2D, query: Bounds2D): Boolean
        => self.MayIntersect(query).Not;

    // True when the query box lies entirely outside this field's domain.
    IsCulledBy(self: BoundedSignedDistanceField3D, query: Bounds3D): Boolean
        => self.MayIntersect(query).Not;

    // True when the point lies inside the conservative domain. False means the
    // point cannot be inside the solid if Bounds enclose every non-positive
    // distance; true is inconclusive.
    MayContainPoint(self: BoundedSignedDistanceField2D, point: Point2D): Boolean
        => self.Bounds.Contains(point);

    // True when the point lies inside the conservative domain.
    MayContainPoint(self: BoundedSignedDistanceField3D, point: Point3D): Boolean
        => self.Bounds.Contains(point);

    //==
    // # CSG with bound propagation (function wrappers only)

    // Pointwise minimum distance; bounds are the union of the operands.
    Union(a: BoundedSdf2D, b: BoundedSdf2D): BoundedSdf2D
        => BoundedSdf2D(a.Sdf.Union(b.Sdf), UnionOfBounds(a.Bounds, b.Bounds));

    // Pointwise minimum distance; bounds are the union of the operands.
    Union(a: BoundedSdf3D, b: BoundedSdf3D): BoundedSdf3D
        => BoundedSdf3D(a.Sdf.Union(b.Sdf), UnionOfBounds(a.Bounds, b.Bounds));

    // Pointwise maximum distance; bounds are the intersection of the operands
    // (may be empty).
    Intersection(a: BoundedSdf2D, b: BoundedSdf2D): BoundedSdf2D
        => BoundedSdf2D(a.Sdf.Intersection(b.Sdf), IntersectionOfBounds(a.Bounds, b.Bounds));

    // Pointwise maximum distance; bounds are the intersection of the operands.
    Intersection(a: BoundedSdf3D, b: BoundedSdf3D): BoundedSdf3D
        => BoundedSdf3D(a.Sdf.Intersection(b.Sdf), IntersectionOfBounds(a.Bounds, b.Bounds));

    // First shape with the second carved out. Bounds stay those of `a`
    // (difference only shrinks the solid).
    Difference(a: BoundedSdf2D, b: BoundedSdf2D): BoundedSdf2D
        => BoundedSdf2D(a.Sdf.Difference(b.Sdf), a.Bounds);

    // First shape with the second carved out. Bounds stay those of `a`.
    Difference(a: BoundedSdf3D, b: BoundedSdf3D): BoundedSdf3D
        => BoundedSdf3D(a.Sdf.Difference(b.Sdf), a.Bounds);

    // Offset surface: distance shifted by amount. Bounds grow by Abs(amount)
    // so a positive offset (larger solid) stays enclosed; a negative offset
    // keeps a conservative (possibly loose) domain.
    Offset(self: BoundedSdf2D, amount: Number): BoundedSdf2D
        => BoundedSdf2D(self.Sdf.Offset(amount), GrowBounds(self.Bounds, amount.Abs));

    // Offset surface with bounds grown by Abs(amount).
    Offset(self: BoundedSdf3D, amount: Number): BoundedSdf3D
        => BoundedSdf3D(self.Sdf.Offset(amount), GrowBounds(self.Bounds, amount.Abs));

    // Smooth union over blendRadius; bounds are the union of the operands
    // grown by blendRadius (blend can extend past either solid).
    // Precondition: blendRadius is positive.
    SmoothUnion(a: BoundedSdf3D, b: BoundedSdf3D, blendRadius: Number): BoundedSdf3D
        => BoundedSdf3D(
            a.Sdf.SmoothUnion(b.Sdf, blendRadius),
            GrowBounds(UnionOfBounds(a.Bounds, b.Bounds), blendRadius));

    //==
    // # SDF modifier application
    //
    // The parameter records declared in `implicit-sdf.types.plato`, applied to
    // a source field. Value modifiers reshape an already-sampled distance; domain
    // modifiers reshape the position BEFORE the source is sampled, so they compose
    // with `MapDomain`. Domain modifiers other than repetition preserve exact
    // distances; repetition, twist, bend, and displacement return bounds.

    // The rounded distance: subtracting the radius inflates the shape and rounds
    // its edges. (IQ: opRound.)
    ApplyToDistance(self: SdfRoundingModifier, distance: Number): Number
        => distance - self.Radius;

    // The shell distance: the region within half of Thickness on either side of
    // the source surface. (IQ: opOnion, single layer.)
    ApplyToDistance(self: SdfShellModifier, distance: Number): Number
        => distance.Abs - self.Thickness * 0.5;

    // The distance to the outermost of the concentric shells. Repeat this with the
    // distance it returns to peel the next layer; Count layers reach TotalDepth.
    ApplyToDistance(self: SdfOnionModifier, distance: Number): Number
        => distance.Abs - self.Thickness;

    // How far the full onion reaches inward from the source surface: one thickness
    // per shell.
    TotalDepth(self: SdfOnionModifier): Number
        => self.Thickness * self.Count.ToNumber;

    // The displaced distance: the source distance offset by the sampled scalar
    // field value scaled by Amplitude. The result is a bound, not exact.
    // (IQ: opDisplace.)
    ApplyToDistance(self: SdfDisplacementModifier3D, distance: Number, sourceValue: Number): Number
        => distance + self.Amplitude * sourceValue;

    // The position of this modifier's displacement field in the caller-supplied
    // list of spatial scalar fields.
    SourceFieldIndex(self: SdfDisplacementModifier3D): Integer
        => self.Source.Value;

    // The folded position for an elongated planar shape: the source is sampled at
    // the position pulled back toward the origin by up to Amount on each axis,
    // which inserts a straight section of that extent. (IQ: opElongate.)
    ApplyToDomain(self: SdfElongationModifier2D, point: Point2D): Point2D
        => Point2D(
            point.X - point.X.Clamp(self.Amount.X.Negative, self.Amount.X),
            point.Y - point.Y.Clamp(self.Amount.Y.Negative, self.Amount.Y));

    // The folded position for an elongated spatial shape. (IQ: opElongate.)
    ApplyToDomain(self: SdfElongationModifier3D, point: Point3D): Point3D
        => Point3D(
            point.X - point.X.Clamp(self.Amount.X.Negative, self.Amount.X),
            point.Y - point.Y.Clamp(self.Amount.Y.Negative, self.Amount.Y),
            point.Z - point.Z.Clamp(self.Amount.Z.Negative, self.Amount.Z));

    // One coordinate folded into its lattice cell, centred on the cell: the
    // coordinate minus the nearest whole multiple of period. Repetition is limited
    // to count cells on either side of the origin; a non-positive count repeats
    // without limit. Precondition: period is positive. (IQ: opRepetition/opRepLim.)
    RepeatedCoordinate(coordinate: Number, period: Number, count: Integer): Number {
        var cell = (coordinate / period + 0.5).Floor;
        var limit = count.ToNumber;
        var bounded = count > 0 ? cell.Clamp(limit.Negative, limit) : cell;
        return coordinate - period * bounded;
    }

    // The position within its lattice cell for a planar tiling: the source is
    // sampled once per cell of the given period, bounded by Counts per axis.
    ApplyToDomain(self: SdfRepetitionModifier2D, point: Point2D): Point2D
        => Point2D(
            RepeatedCoordinate(point.X, self.Period.X, self.Counts.X),
            RepeatedCoordinate(point.Y, self.Period.Y, self.Counts.Y));

    // The position within its lattice cell for a spatial tiling, bounded by Counts.
    ApplyToDomain(self: SdfRepetitionModifier3D, point: Point3D): Point3D
        => Point3D(
            RepeatedCoordinate(point.X, self.Period.X, self.Counts.X),
            RepeatedCoordinate(point.Y, self.Period.Y, self.Counts.Y),
            RepeatedCoordinate(point.Z, self.Period.Z, self.Counts.Z));

    // The half-extent of a bounded planar tiling: the distance from the origin to
    // the outer face of the last repeated cell on each axis. Meaningless on an
    // axis whose count is non-positive (that axis repeats without limit).
    RepetitionExtent(self: SdfRepetitionModifier2D): Vector2D
        => Vector2D(
            self.Period.X * self.Counts.X.ToNumber,
            self.Period.Y * self.Counts.Y.ToNumber);

    // The half-extent of a bounded spatial tiling; see the planar form.
    RepetitionExtent(self: SdfRepetitionModifier3D): Vector3D
        => Vector3D(
            self.Period.X * self.Counts.X.ToNumber,
            self.Period.Y * self.Counts.Y.ToNumber,
            self.Period.Z * self.Counts.Z.ToNumber);

    // The point rotated about the Z axis by the given angle: the XY components
    // turn, Z is unchanged. Shared by the twist and bend domain modifiers.
    RotatedAboutZ(point: Point3D, angle: Angle): Point3D
        => Point3D(
            point.X * angle.Cos - point.Y * angle.Sin,
            point.X * angle.Sin + point.Y * angle.Cos,
            point.Z);

    // The untwisted position for a shape twisted about the Z axis: each slice is
    // rotated back by AnglePerUnit times its height before the source is sampled.
    // The result is a bound, not an exact distance. (IQ: opTwist.)
    ApplyToDomain(self: SdfTwistModifier3D, point: Point3D): Point3D
        => RotatedAboutZ(point, self.AnglePerUnit * point.Z);

    // The unbent position for a shape bent about the Y axis: the turn accumulates
    // with distance along X at the given curvature. The result is a bound, not an
    // exact distance. (IQ: opCheapBend.)
    ApplyToDomain(self: SdfBendModifier3D, point: Point3D): Point3D
        => RotatedAboutZ(point, (self.Curvature * point.X).Angle);

    //==
    // # Distance operators
    //
    // Pointwise CSG on already-sampled distances: the scalar kernels the field
    // combinators in `fields-implicits.library.plato` are written in terms
    // of, usable directly inside a hand-written distance function without
    // allocating a field.

    // The union of two sampled distances: the minimum.
    UnionDistance(a: Number, b: Number): Number
        => a.Min(b);

    // The intersection of two sampled distances: the maximum.
    IntersectionDistance(a: Number, b: Number): Number
        => a.Max(b);

    // The first distance with the second subtracted from it: a against negated b.
    SubtractDistance(a: Number, b: Number): Number
        => a.Max(b.Negative);

    // The symmetric difference of two sampled distances: inside exactly one of
    // the two shapes. (IQ: opXor.)
    ExclusiveOrDistance(a: Number, b: Number): Number
        => a.Min(b).Max(a.Max(b).Negative);

    // The polynomial smooth minimum of two distances, blended over blendRadius.
    // Reduces to the plain minimum as blendRadius approaches zero.
    // Precondition: blendRadius is positive. (IQ: opSmoothUnion.)
    SmoothUnionDistance(a: Number, b: Number, blendRadius: Number): Number {
        var h = (0.5 + 0.5 * (b - a) / blendRadius).Clamp(0.0, 1.0);
        return b.Lerp(a, h) - blendRadius * h * (1.0 - h);
    }

    // The smooth intersection: the smooth union of the negated distances,
    // negated. Precondition: blendRadius is positive. (IQ: opSmoothIntersection.)
    SmoothIntersectionDistance(a: Number, b: Number, blendRadius: Number): Number
        => SmoothUnionDistance(a.Negative, b.Negative, blendRadius).Negative;

    // The smooth difference: a smoothly intersected with the complement of b.
    // Precondition: blendRadius is positive. (IQ: opSmoothSubtraction.)
    SmoothDifferenceDistance(a: Number, b: Number, blendRadius: Number): Number
        => SmoothIntersectionDistance(a, b.Negative, blendRadius);

    //==
    // # Signed distance primitives
    //
    // Closed-form distance functions for primitives centred at the origin, after
    // Inigo Quilez: https://iquilezles.org/articles/distfunctions/
    //
    // Deliberately array-free, lambda-free, and free of function-valued fields:
    // only scalar and fixed-arity vector arithmetic over Point2D/Point3D and
    // Vector2D/Vector3D, plus `var` locals, which every target dialect has. That
    // is what lets these bodies port to GLSL, C++, and CUDA unchanged. Keep it
    // that way - build compositions with the combinators in
    // `fields-implicits.library.plato`, never inside these bodies.

    // The signed distance from a point to a sphere of the given radius centred at
    // the origin. (IQ: sdSphere.)
    DistanceToSphere(p: Point3D, radius: Number): Number
        => p.PositionVector.Magnitude - radius;

    // The signed distance from a point to an axis-aligned box with the given
    // half-extents, centred at the origin. The exterior part is the length of the
    // positive per-axis surface offsets, the interior part the largest (least
    // negative) offset. (IQ: sdBox.)
    DistanceToBox(p: Point3D, halfExtents: Vector3D): Number {
        var q = Vector3D(
            p.X.Abs - halfExtents.X,
            p.Y.Abs - halfExtents.Y,
            p.Z.Abs - halfExtents.Z);
        return Vector3D(q.X.Max(0.0), q.Y.Max(0.0), q.Z.Max(0.0)).Magnitude
             + q.X.Max(q.Y.Max(q.Z)).Min(0.0);
    }

    // The signed distance from a point to an axis-aligned box with the given
    // half-extents whose edges are rounded by radius. The rounding grows the box,
    // so halfExtents describes the box before rounding. (IQ: sdRoundBox.)
    DistanceToRoundedBox(p: Point3D, halfExtents: Vector3D, radius: Number): Number {
        var q = Vector3D(
            p.X.Abs - halfExtents.X + radius,
            p.Y.Abs - halfExtents.Y + radius,
            p.Z.Abs - halfExtents.Z + radius);
        return Vector3D(q.X.Max(0.0), q.Y.Max(0.0), q.Z.Max(0.0)).Magnitude
             + q.X.Max(q.Y.Max(q.Z)).Min(0.0)
             - radius;
    }

    // The signed distance from a point to a torus lying in the XZ plane, centred
    // at the origin: majorRadius is the ring radius, tubeRadius the tube radius.
    // (IQ: sdTorus.)
    DistanceToTorus(p: Point3D, majorRadius: Number, tubeRadius: Number): Number {
        var q = Vector2D(Vector2D(p.X, p.Z).Magnitude - majorRadius, p.Y);
        return q.Magnitude - tubeRadius;
    }

    // The signed distance from a point to a capsule running from the origin to
    // (0, height, 0) with the given radius. (IQ: sdVerticalCapsule.)
    DistanceToVerticalCapsule(p: Point3D, height: Number, radius: Number): Number {
        var y = p.Y - p.Y.Clamp(0.0, height);
        return Vector3D(p.X, y, p.Z).Magnitude - radius;
    }

    // The signed distance from a point to a cylinder centred at the origin with
    // its axis along Y, capped flat at plus or minus halfHeight.
    // (IQ: sdCappedCylinder.)
    DistanceToCappedCylinder(p: Point3D, halfHeight: Number, radius: Number): Number {
        var d = Vector2D(
            Vector2D(p.X, p.Z).Magnitude - radius,
            p.Y.Abs - halfHeight);
        return d.X.Max(d.Y).Min(0.0)
             + Vector2D(d.X.Max(0.0), d.Y.Max(0.0)).Magnitude;
    }

    // The signed distance from a point to the plane with the given unit normal at
    // signed offset from the origin. Precondition: normal has unit length.
    // (IQ: sdPlane.)
    DistanceToPlane(p: Point3D, normal: Vector3D, offset: Number): Number
        => p.PositionVector.Dot(normal) + offset;

    //==
    // # Sampled signed distance field evaluation
    //
    // Interpolating evaluation of a discretized SDF (`implicit-sdf.types.plato`).
    // The lattice spans Bounds with its endpoints on the boundary, so a node count
    // of n along an axis divides it into n - 1 cells. Positions outside Bounds
    // clamp to the edge cell and the interpolation extrapolates linearly from it.
    // Precondition: at least two nodes along every axis.

    // The continuous lattice coordinate of a position along one axis: 0 at the low
    // bound, count - 1 at the high bound.
    LatticeCoordinate(coordinate: Number, low: Number, high: Number, count: Integer): Number
        => (coordinate - low) / (high - low) * (count - 1).ToNumber;

    // The index of the cell containing a lattice coordinate, clamped so that both
    // the cell and its successor are valid node indices.
    LatticeCellIndex(latticeCoordinate: Number, count: Integer): Integer
        => latticeCoordinate.Floor.ToInteger.Clamp(0, count - 2);

    // The signed distance at a point, bilinearly interpolated between the four
    // surrounding lattice nodes.
    Eval(self: SampledSdf2D, point: Point2D): Number {
        var u = LatticeCoordinate(point.X, self.Bounds.Min.X, self.Bounds.Max.X, self.Values.ColumnCount);
        var v = LatticeCoordinate(point.Y, self.Bounds.Min.Y, self.Bounds.Max.Y, self.Values.RowCount);
        var column = LatticeCellIndex(u, self.Values.ColumnCount);
        var row = LatticeCellIndex(v, self.Values.RowCount);
        var fu = u - column.ToNumber;
        var fv = v - row.ToNumber;
        var lower = self.Values.At(column, row).Lerp(self.Values.At(column + 1, row), fu);
        var upper = self.Values.At(column, row + 1).Lerp(self.Values.At(column + 1, row + 1), fu);
        return lower.Lerp(upper, fv);
    }

    // The bilinear interpolation within one layer of a spatial lattice: the shared
    // inner step of the trilinear evaluation below, applied to two adjacent layers.
    LayerBilinear(self: SampledSdf3D, column: Integer, row: Integer, layer: Integer, fu: Number, fv: Number): Number {
        var lower = self.Values.At(column, row, layer).Lerp(self.Values.At(column + 1, row, layer), fu);
        var upper = self.Values.At(column, row + 1, layer).Lerp(self.Values.At(column + 1, row + 1, layer), fu);
        return lower.Lerp(upper, fv);
    }

    // The signed distance at a point, trilinearly interpolated between the eight
    // surrounding lattice nodes.
    Eval(self: SampledSdf3D, point: Point3D): Number {
        var u = LatticeCoordinate(point.X, self.Bounds.Min.X, self.Bounds.Max.X, self.Values.ColumnCount);
        var v = LatticeCoordinate(point.Y, self.Bounds.Min.Y, self.Bounds.Max.Y, self.Values.RowCount);
        var w = LatticeCoordinate(point.Z, self.Bounds.Min.Z, self.Bounds.Max.Z, self.Values.LayerCount);
        var column = LatticeCellIndex(u, self.Values.ColumnCount);
        var row = LatticeCellIndex(v, self.Values.RowCount);
        var layer = LatticeCellIndex(w, self.Values.LayerCount);
        var fu = u - column.ToNumber;
        var fv = v - row.ToNumber;
        var near = self.LayerBilinear(column, row, layer, fu, fv);
        var far = self.LayerBilinear(column, row, layer + 1, fu, fv);
        return near.Lerp(far, w - layer.ToNumber);
    }

    //==
    // # SDF combination tree evaluation
    //
    // Recursive evaluation of a flat CSG tree (`implicit-sdf.types.plato`). Leaves
    // resolve against a caller-supplied primitive list; interior nodes combine two
    // lower-indexed nodes, so the recursion is well founded and terminates on any
    // tree obeying the "nodes only reference lower-indexed nodes" invariant.

    // The combination operator applied to two child distances.
    Apply(combine: SdfCombine, a: Number, b: Number): Number =>
        match (combine) {
            Union => UnionDistance(a, b);
            Intersection => IntersectionDistance(a, b);
            Difference => SubtractDistance(a, b);
            ExclusiveOr => ExclusiveOrDistance(a, b);
            SmoothUnion(radius) => SmoothUnionDistance(a, b, radius);
            SmoothIntersection(radius) => SmoothIntersectionDistance(a, b, radius);
            SmoothDifference(radius) => SmoothDifferenceDistance(a, b, radius);
            Blend(weight) => a.Lerp(b, weight.Value);
        };

    // The distance one planar node produces: a leaf samples its primitive, an
    // interior node combines its two children.
    EvalNode(node: SdfNode2D, tree: SdfTree2D, primitives: Array<FunctionSdf2D>, point: Point2D): Number =>
        match (node) {
            Leaf(primitive) => primitives[primitive.Value].Eval(point);
            Interior(combine, left, right) =>
                combine.Apply(
                    tree.EvalNodeAt(left, primitives, point),
                    tree.EvalNodeAt(right, primitives, point));
        };

    // The distance the node at the given index produces.
    EvalNodeAt(tree: SdfTree2D, index: SdfNodeIndex, primitives: Array<FunctionSdf2D>, point: Point2D): Number
        => tree.Nodes[index.Value].EvalNode(tree, primitives, point);

    // The tree's signed distance at a point: the distance its root node produces.
    Eval(tree: SdfTree2D, primitives: Array<FunctionSdf2D>, point: Point2D): Number
        => tree.EvalNodeAt(tree.Root, primitives, point);

    // The distance one spatial node produces.
    EvalNode(node: SdfNode3D, tree: SdfTree3D, primitives: Array<FunctionSdf3D>, point: Point3D): Number =>
        match (node) {
            Leaf(primitive) => primitives[primitive.Value].Eval(point);
            Interior(combine, left, right) =>
                combine.Apply(
                    tree.EvalNodeAt(left, primitives, point),
                    tree.EvalNodeAt(right, primitives, point));
        };

    // The distance the node at the given index produces.
    EvalNodeAt(tree: SdfTree3D, index: SdfNodeIndex, primitives: Array<FunctionSdf3D>, point: Point3D): Number
        => tree.Nodes[index.Value].EvalNode(tree, primitives, point);

    // The tree's signed distance at a point: the distance its root node produces.
    Eval(tree: SdfTree3D, primitives: Array<FunctionSdf3D>, point: Point3D): Number
        => tree.EvalNodeAt(tree.Root, primitives, point);
}
