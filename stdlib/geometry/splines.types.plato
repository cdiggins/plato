//==
// # Splines
//
// Sections, in order:
//  - Bezier splines
//  - B-splines and NURBS
//  - Hermite curves
//  - Interpolating splines

//==
// # Bezier splines
//
// Control-point curves of the Bezier family: arbitrary-degree Bezier curves,
// their rational (weighted) form, and chains of cubic segments. Parallel arrays
// (points + weights) must have equal counts; that invariant is documented rather
// than encoded. Evaluation lives in `splines.library.plato`.

//==
// # Bezier curves of arbitrary degree

// A Bezier curve of arbitrary degree in the plane: degree = control point
// count - 1 (https://en.wikipedia.org/wiki/B%C3%A9zier_curve). Interpolates
// the first and last control points.
type BezierCurve2D
    implements Curve2D
{
    ControlPoints: Array<Point2D>;
}

// A Bezier curve of arbitrary degree in space: degree = control point
// count - 1. Interpolates the first and last control points
// (https://en.wikipedia.org/wiki/B%C3%A9zier_curve).
type BezierCurve3D
    implements Curve3D
{
    ControlPoints: Array<Point3D>;
}

// A rational Bezier curve in the plane: per-point weights (same count as
// ControlPoints) pull the curve toward heavier points. Represents conic
// sections exactly (https://en.wikipedia.org/wiki/B%C3%A9zier_curve).
type RationalBezierCurve2D
    implements Curve2D
{
    ControlPoints: Array<Point2D>;
    Weights: Array<Number>;
}

// A rational Bezier curve in space: per-point weights (same count as
// ControlPoints) pull the curve toward heavier points
// (https://en.wikipedia.org/wiki/B%C3%A9zier_curve).
type RationalBezierCurve3D
    implements Curve3D
{
    ControlPoints: Array<Point3D>;
    Weights: Array<Number>;
}

//==
// # Composite Bezier curves

// A chain of cubic Bezier segments in the plane; consecutive segments must
// share endpoints (P3 of one equals P0 of the next). Font glyphs and vector
// paths in curve form
// (https://en.wikipedia.org/wiki/Composite_B%C3%A9zier_curve).
type CompositeBezier2D
    implements Curve2D
{
    Segments: Array<CubicBezier2D>;
}

// A chain of cubic Bezier segments in space; consecutive segments must share
// endpoints (P3 of one equals P0 of the next)
// (https://en.wikipedia.org/wiki/Composite_B%C3%A9zier_curve).
type CompositeBezier3D
    implements Curve3D
{
    Segments: Array<CubicBezier3D>;
}

//==
// # B-splines and NURBS
//
// The knot-vector curve family: piecewise-polynomial B-splines and their
// non-uniform rational form, the CAD interchange standard. Parallel arrays
// (points + weights) must have equal counts, and the knot count is fixed by the
// point count and the degree; those invariants are documented rather than
// encoded. The knot accessors live in `splines.library.plato`.

//==
// # Knots

// A non-decreasing sequence of parameter values partitioning a B-spline or
// NURBS domain (https://en.wikipedia.org/wiki/B-spline#Definition). For a
// curve with N control points of degree D the knot count must be N + D + 1.
type KnotVector
    implements Value
{
    Knots: Array<Number>;
}

//==
// # B-splines and NURBS

// A piecewise-polynomial B-spline curve in the plane
// (https://en.wikipedia.org/wiki/B-spline). Knots must hold ControlPoints
// count + Degree + 1 values.
type BSplineCurve2D
    implements Curve2D
{
    ControlPoints: Array<Point2D>;
    Degree: Integer;
    Knots: KnotVector;
}

// A piecewise-polynomial B-spline curve in space. Knots must hold
// ControlPoints count + Degree + 1 values
// (https://en.wikipedia.org/wiki/B-spline).
type BSplineCurve3D
    implements Curve3D
{
    ControlPoints: Array<Point3D>;
    Degree: Integer;
    Knots: KnotVector;
}

// A non-uniform rational B-spline curve in the plane: a B-spline with
// per-point weights (same count as ControlPoints)
// (https://en.wikipedia.org/wiki/Non-uniform_rational_B-spline). The CAD
// interchange standard; represents conics exactly.
type NurbsCurve2D
    implements Curve2D
{
    ControlPoints: Array<Point2D>;
    Weights: Array<Number>;
    Degree: Integer;
    Knots: KnotVector;
}

// A non-uniform rational B-spline curve in space: a B-spline with per-point
// weights (same count as ControlPoints)
// (https://en.wikipedia.org/wiki/Non-uniform_rational_B-spline).
type NurbsCurve3D
    implements Curve3D
{
    ControlPoints: Array<Point3D>;
    Weights: Array<Number>;
    Degree: Integer;
    Knots: KnotVector;
}

//==
// # Hermite curves
//
// The control-point curves whose shape is given by explicit tangents rather than
// by off-curve control points: the single cubic Hermite segment and the
// piecewise spline built from a tangent per knot. Parallel arrays (points +
// tangents) must have equal counts; that invariant is documented rather than
// encoded. Evaluation lives in `splines.library.plato`.

//==
// # Hermite curves

// A single cubic Hermite segment in the plane: interpolates Start to End with
// the given outgoing and incoming tangents
// (https://en.wikipedia.org/wiki/Cubic_Hermite_spline).
type HermiteCurve2D
    implements Curve2D
{
    Start: Point2D;
    StartTangent: Vector2D;
    End: Point2D;
    EndTangent: Vector2D;
}

// A single cubic Hermite segment in space: interpolates Start to End with the
// given outgoing and incoming tangents
// (https://en.wikipedia.org/wiki/Cubic_Hermite_spline).
type HermiteCurve3D
    implements Curve3D
{
    Start: Point3D;
    StartTangent: Vector3D;
    End: Point3D;
    EndTangent: Vector3D;
}

// A piecewise cubic Hermite spline in the plane: interpolates every point with
// an explicit tangent per point (same count as Points). Closed joins the last
// point back to the first
// (https://en.wikipedia.org/wiki/Cubic_Hermite_spline).
type HermiteSpline2D
    implements Curve2D
{
    Points: Array<Point2D>;
    Tangents: Array<Vector2D>;
    Closed: Boolean;
}

// A piecewise cubic Hermite spline in space: interpolates every point with an
// explicit tangent per point (same count as Points)
// (https://en.wikipedia.org/wiki/Cubic_Hermite_spline).
type HermiteSpline3D
    implements Curve3D
{
    Points: Array<Point3D>;
    Tangents: Array<Vector3D>;
    Closed: Boolean;
}

//==
// # Interpolating splines
//
// The control-point curves that pass THROUGH every point they are given, with
// tangents derived from the neighbours (Catmull-Rom), shaped per knot
// (Kochanek-Bartels), absent (piecewise linear), or solved for globally (natural
// cubic). Parallel arrays must have equal counts; that invariant is documented
// rather than encoded. Evaluation lives in
// `splines.library.plato`.

//==
// # Interpolating splines

// A Catmull-Rom spline in the plane: interpolates every point with tangents
// derived from neighbors. Alpha selects the parameterization: 0 = uniform,
// 0.5 = centripetal (cusp-free), 1 = chordal
// (https://en.wikipedia.org/wiki/Centripetal_Catmull%E2%80%93Rom_spline).
type CatmullRomCurve2D
    implements Curve2D
{
    Points: Array<Point2D>;
    Alpha: Number;
    Closed: Boolean;
}

// A Catmull-Rom spline in space: interpolates every point with tangents
// derived from neighbors. Alpha selects the parameterization: 0 = uniform,
// 0.5 = centripetal (cusp-free), 1 = chordal
// (https://en.wikipedia.org/wiki/Centripetal_Catmull%E2%80%93Rom_spline).
type CatmullRomCurve3D
    implements Curve3D
{
    Points: Array<Point3D>;
    Alpha: Number;
    Closed: Boolean;
}

// A Kochanek-Bartels (TCB) spline in the plane: per-point Tension, Continuity,
// and Bias arrays (same count as Points) shape the tangents at each knot.
// The classic keyframe-animation spline
// (https://en.wikipedia.org/wiki/Kochanek%E2%80%93Bartels_spline).
type TcbSpline2D
    implements Curve2D
{
    Points: Array<Point2D>;
    Tensions: Array<Number>;
    Continuities: Array<Number>;
    Biases: Array<Number>;
    Closed: Boolean;
}

// A Kochanek-Bartels (TCB) spline in space: per-point Tension, Continuity,
// and Bias arrays (same count as Points) shape the tangents at each knot
// (https://en.wikipedia.org/wiki/Kochanek%E2%80%93Bartels_spline).
type TcbSpline3D
    implements Curve3D
{
    Points: Array<Point3D>;
    Tensions: Array<Number>;
    Continuities: Array<Number>;
    Biases: Array<Number>;
    Closed: Boolean;
}

// A piecewise-linear interpolating spline in the plane: the curve-as-function
// view of a chain of points (the geometric chain itself is Polyline2D,
// `polygons.types.plato`). Closed joins the last point back to the first
// (https://en.wikipedia.org/wiki/Polygonal_chain).
type LinearSpline2D
    implements Curve2D
{
    Points: Array<Point2D>;
    Closed: Boolean;
}

// A piecewise-linear interpolating spline in space: the curve-as-function view
// of a chain of points (the geometric chain itself is Polyline3D,
// `polygons.types.plato`)
// (https://en.wikipedia.org/wiki/Polygonal_chain).
type LinearSpline3D
    implements Curve3D
{
    Points: Array<Point3D>;
    Closed: Boolean;
}

// A natural cubic spline through scalar samples: interpolates Values at the
// strictly increasing Parameters (same counts), with zero second derivative
// at the ends (https://en.wikipedia.org/wiki/Spline_interpolation). A smooth
// Curve1D for profiles and channels.
type NaturalCubicSpline1D
    implements Curve1D
{
    Parameters: Array<Number>;
    Values: Array<Number>;
}
