//==
// # Fields
//
// Sections, in order:
//  - IField interfaces
//  - Differentiable field interfaces
//  - Time-varying field interfaces

//==
// # IField interfaces
//
// The root IField capability and the point-domain field interfaces built on it:
// scalar, vector, direction, color, complex, and tensor fields over the plane
// and over space. Every field is IProcedural over a point domain, so curves,
// easings, and fields share one evaluation vocabulary. Concrete field types
// (noise, SDFs, sampled grids) implement the interfaces declared here; the
// derived bodies live in `fields-implicits.library.plato`.
// See https://en.wikipedia.org/wiki/Scalar_field and
// https://en.wikipedia.org/wiki/Vector_field.

// A pure mapping from positions in a domain to values in a range. The root
// capability for every spatial field; evaluation is side-effect free and
// deterministic for a given field value.
interface IField<TDomain, TValue>
    inherits IProcedural<TDomain, TValue>
{ }

// A real-valued field over the 2D plane: heightmaps, density maps, masks,
// potentials, and signed distances
// (https://en.wikipedia.org/wiki/Scalar_field).
interface IScalarField2D
    inherits IField<Point2D, Number>
{ }

// A real-valued field over 3D space: densities, potentials, temperatures,
// implicit surfaces, and signed distances
// (https://en.wikipedia.org/wiki/Implicit_surface).
interface IScalarField3D
    inherits IField<Point3D, Number>
{ }

// A field assigning a 2D vector to every point of the plane: gradients,
// flows, displacement maps, and wind over a surface
// (https://en.wikipedia.org/wiki/Vector_field).
interface IVectorField2D
    inherits IField<Point2D, Vector2D>
{ }

// A field assigning a 3D vector to every point of space: velocity fields,
// force fields, and displacement fields
// (https://en.wikipedia.org/wiki/Vector_field).
interface IVectorField3D
    inherits IField<Point3D, Vector3D>
{ }

// A field of unit-length 2D directions: orientation fields for strokes,
// hatching, and anisotropy. Magnitude carries no information.
interface IDirectionField2D
    inherits IField<Point2D, Direction2D>
{ }

// A field of unit-length 3D directions: normal fields, grain and fiber
// orientation, and guide fields for grooming or flow alignment.
interface IDirectionField3D
    inherits IField<Point3D, Direction3D>
{ }

// A field assigning a color to every point of the plane: procedural textures,
// gradients, and image-like sources evaluated in continuous coordinates.
interface IColorField2D
    inherits IField<Point2D, Color>
{ }

// A field assigning a color to every point of space: solid procedural
// textures such as wood, marble, and volumetric tints.
interface IColorField3D
    inherits IField<Point3D, Color>
{ }

// A complex-valued field over the plane: fractal iteration, conformal
// mapping, and 2D wave phenomena.
interface IComplexField2D
    inherits IField<Point2D, Complex>
{ }

// A field of 2x2 matrices over the plane: 2D stress, strain, and metric
// tensors, and local linearizations of planar maps
// (https://en.wikipedia.org/wiki/Tensor_field).
interface ITensorField2D
    inherits IField<Point2D, Matrix2x2>
{ }

// A field of 3x3 matrices over space: stress and strain tensors, diffusion
// tensors, and velocity-gradient tensors
// (https://en.wikipedia.org/wiki/Tensor_field).
interface ITensorField3D
    inherits IField<Point3D, Matrix3x3>
{ }

//==
// # Differentiable field interfaces
//
// Scalar and vector fields that carry a first derivative alongside their
// value: the gradient of a scalar field, and the Jacobian, divergence, and
// curl of a vector field. Derivatives may be analytic or numeric; either way
// they are exposed as ordinary field operations
// (https://en.wikipedia.org/wiki/Differentiable_function).

// A planar scalar field with an analytic or numeric first derivative. The
// gradient points in the direction of steepest increase
// (https://en.wikipedia.org/wiki/Gradient).
interface IDifferentiableScalarField2D
    inherits IScalarField2D
{
    GradientAt(x: Self, point: Point2D): Vector2D;
}

// A spatial scalar field with an analytic or numeric first derivative. The
// gradient of a signed distance field is the outward surface normal direction
// (https://en.wikipedia.org/wiki/Signed_distance_function).
interface IDifferentiableScalarField3D
    inherits IScalarField3D
{
    GradientAt(x: Self, point: Point3D): Vector3D;
}

// A planar vector field with first derivatives: the Jacobian, its trace
// (divergence), and the scalar 2D curl (rotation about the plane normal)
// (https://en.wikipedia.org/wiki/Divergence,
// https://en.wikipedia.org/wiki/Curl_(mathematics)).
interface IDifferentiableVectorField2D
    inherits IVectorField2D
{
    JacobianAt(x: Self, point: Point2D): Matrix2x2;
    DivergenceAt(x: Self, point: Point2D): Number;
    CurlAt(x: Self, point: Point2D): Number;
}

// A spatial vector field with first derivatives: the Jacobian, its trace
// (divergence), and the curl vector
// (https://en.wikipedia.org/wiki/Jacobian_matrix_and_determinant).
interface IDifferentiableVectorField3D
    inherits IVectorField3D
{
    JacobianAt(x: Self, point: Point3D): Matrix3x3;
    DivergenceAt(x: Self, point: Point3D): Number;
    CurlAt(x: Self, point: Point3D): Vector3D;
}

//==
// # Time-varying field interfaces
//
// Fields whose values evolve over a timeline. The time argument is an Instant
// on the animation or simulation timeline.

// A planar scalar field that changes over time: animated masks, ripples,
// and evolving density maps.
interface ITimeVaryingScalarField2D
{
    EvalAtTime(x: Self, point: Point2D, time: Instant): Number;
}

// A spatial scalar field that changes over time: simulation densities,
// temperatures, and animated implicit shapes.
interface ITimeVaryingScalarField3D
{
    EvalAtTime(x: Self, point: Point3D, time: Instant): Number;
}

// A planar vector field that changes over time: 2D flows and animated
// displacement maps.
interface ITimeVaryingVectorField2D
{
    EvalAtTime(x: Self, point: Point2D, time: Instant): Vector2D;
}

// A spatial vector field that changes over time: velocity fields of fluids,
// wind, and turbulence used for advection.
interface ITimeVaryingVectorField3D
{
    EvalAtTime(x: Self, point: Point3D, time: Instant): Vector3D;
}
