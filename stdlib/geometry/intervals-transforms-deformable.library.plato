//==
// # IntervalsTransformsDeformable — derived functionality for IDeformable2D/3D
//
// Bodies for the `IDeformable2D` / `IDeformable3D` interfaces declared in
// `transforms.concepts.plato`: translation, scaling, and rotation — about the
// origin or about an arbitrary pivot — all expressed through each type's single
// Deform primitive. The mapping types are concrete, so these build real
// Point2D/Vector2D and Point3D/Vector3D lambdas.

library IntervalsTransformsDeformable
{
    //==
    // IDeformable2D — a value reshaped by an arbitrary Point2D -> Point2D mapping.
    // The mapping type is concrete (Function1<Point2D, Point2D>), so these build
    // real Point2D/Vector2D lambdas.

    // Translate every point by `offset`.
    Translate(self: IDeformable2D, offset: Vector2D): Self
        => self.Deform(p => p + offset);

    // Uniformly scale about `center` by `factor` (1 leaves the shape unchanged).
    ScaleAbout(self: IDeformable2D, center: Point2D, factor: Number): Self
        => self.Deform(p => center + center.Between(p) * factor);

    // Non-uniformly scale about `center` by a per-axis `factors` vector.
    ScaleAbout(self: IDeformable2D, center: Point2D, factors: Number2): Self
        => self.Deform(p => center + center.Between(p) * factors);

    // Rotate every point about `center` by `rotation`.
    RotateAbout(self: IDeformable2D, center: Point2D, rotation: Rotation2D): Self
        => self.Deform(p => center + center.Between(p).Transform(rotation));

    // Rotate every point about `center` by `angle` (counter-clockwise).
    RotateAbout(self: IDeformable2D, center: Point2D, angle: Angle): Self
        => self.RotateAbout(center, Rotation2D(angle));

    // Rotate every point about the origin by `angle` (counter-clockwise).
    Rotate(self: IDeformable2D, angle: Angle): Self
        => self.RotateAbout(Point2D.Origin, angle);

    // Uniformly scale about the origin by `factor`.
    Scale(self: IDeformable2D, factor: Number): Self
        => self.ScaleAbout(Point2D.Origin, factor);

    // Non-uniformly scale about the origin by a per-axis `factors` vector.
    Scale(self: IDeformable2D, factors: Number2): Self
        => self.ScaleAbout(Point2D.Origin, factors);

    // Scale about the origin along X only.
    ScaleX(self: IDeformable2D, factor: Number): Self
        => self.Scale(Number2(factor, 1.0));

    // Scale about the origin along Y only.
    ScaleY(self: IDeformable2D, factor: Number): Self
        => self.Scale(Number2(1.0, factor));

    // Translate along +X by `distance`.
    TranslateX(self: IDeformable2D, distance: Number): Self
        => self.Translate(Vector2D.UnitX * distance);

    // Translate along +Y by `distance`.
    TranslateY(self: IDeformable2D, distance: Number): Self
        => self.Translate(Vector2D.UnitY * distance);

    // The ScaleAbout/RotateAbout helpers use IDifference.Between(a, b) = b - a,
    // the displacement from a to b. That direction is now the documented contract
    // on the IDifference interface (algebra.concepts.plato), so it is relied on here
    // rather than merely assumed.

    // RESOLVED (was TODO(interface-gap): RotateAbout is omitted): rotating a Point2D
    // needed a point-rotation operation, which is now reachable - `library
    // Transforms` in transforms.library.plato supplies
    // Transform(Vector2D, Rotation2D), and
    // constants.library.plato supplies the axis vectors. RotateAbout/Rotate are
    // implemented above.

    //==
    // IDeformable3D — a value reshaped by an arbitrary Point3D -> Point3D mapping.

    // Translate every point by `offset`.
    Translate(self: IDeformable3D, offset: Vector3D): Self
        => self.Deform(p => p + offset);

    // Uniformly scale about `center` by `factor`.
    ScaleAbout(self: IDeformable3D, center: Point3D, factor: Number): Self
        => self.Deform(p => center + center.Between(p) * factor);

    // Non-uniformly scale about `center` by a per-axis `factors` vector.
    ScaleAbout(self: IDeformable3D, center: Point3D, factors: Number3): Self
        => self.Deform(p => center + center.Between(p) * factors);

    // Rotate every point about `center` by `rotation`.
    RotateAbout(self: IDeformable3D, center: Point3D, rotation: Quaternion): Self
        => self.Deform(p => center + center.Between(p).Transform(rotation));

    // Rotate every point about the origin by `rotation`.
    Rotate(self: IDeformable3D, rotation: Quaternion): Self
        => self.RotateAbout(Point3D.Origin, rotation);

    // Rotate about the world X axis through the origin.
    RotateX(self: IDeformable3D, angle: Angle): Self
        => self.Rotate(Quaternion.CreateRotationX(angle));

    // Rotate about the world Y axis through the origin.
    RotateY(self: IDeformable3D, angle: Angle): Self
        => self.Rotate(Quaternion.CreateRotationY(angle));

    // Rotate about the world Z axis through the origin.
    RotateZ(self: IDeformable3D, angle: Angle): Self
        => self.Rotate(Quaternion.CreateRotationZ(angle));

    // Uniformly scale about the origin by `factor`.
    Scale(self: IDeformable3D, factor: Number): Self
        => self.ScaleAbout(Point3D.Origin, factor);

    // Non-uniformly scale about the origin by a per-axis `factors` vector.
    Scale(self: IDeformable3D, factors: Number3): Self
        => self.ScaleAbout(Point3D.Origin, factors);

    // Scale about the origin along X only.
    ScaleX(self: IDeformable3D, factor: Number): Self
        => self.Scale(Number3(factor, 1.0, 1.0));

    // Scale about the origin along Y only.
    ScaleY(self: IDeformable3D, factor: Number): Self
        => self.Scale(Number3(1.0, factor, 1.0));

    // Scale about the origin along Z only.
    ScaleZ(self: IDeformable3D, factor: Number): Self
        => self.Scale(Number3(1.0, 1.0, factor));

    // Translate along +X by `distance`.
    TranslateX(self: IDeformable3D, distance: Number): Self
        => self.Translate(Vector3D.UnitX * distance);

    // Translate along +Y by `distance`.
    TranslateY(self: IDeformable3D, distance: Number): Self
        => self.Translate(Vector3D.UnitY * distance);

    // Translate along +Z by `distance`.
    TranslateZ(self: IDeformable3D, distance: Number): Self
        => self.Translate(Vector3D.UnitZ * distance);

    // RESOLVED (was TODO(interface-gap): RotateAbout is omitted for the same reason as
    // IDeformable2D): the Transform(Vector3D, Quaternion) intrinsic rotates the pivot
    // displacement directly, so RotateAbout/Rotate/RotateX/Y/Z are implemented above.
}
