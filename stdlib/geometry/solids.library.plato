//==
// # Solids
//
// Sections, in order:
//  - Solids — parametric surfaces for the solids
//  - The typed polyhedral solids as polygon meshes
//  - Deformation bodies for the profile-generated solids

library Solids
{
    //==
    // # Solids — parametric surfaces for the solids
    //
    // The parametric boundary surface of each solid, as the IParametricSurface
    // obligations. Solids are centered at the origin with Z as the up axis in their
    // local frame; UV is in [0,1]x[0,1]: U wraps around the Z axis (ClosedU is true
    // for every solid), V runs up the shape (or around it, for the torus). Polygonal
    // solids walk their profile at constant rate with flat sides (linear between
    // vertices), so a UV quad grid meshes them exactly.
    //
    // Every solid carries its own placement, so the local-frame convention above
    // describes the solid's LOCAL frame and the local point is mapped to world at
    // the end of each body — through the type's own `Frame` where it has one,
    // through its `Orientation` quaternion where it has one, and otherwise through
    // `AxisFrame`, which manufactures a stable (but arbitrary) frame around a
    // `Center`/`Axis` pair. The UV seam therefore lands at an arbitrary azimuth for
    // the Center/Axis solids, which is all a seam needs; nothing downstream may
    // assume where it is.
    //
    // Because U always wraps and V (except the torus) does not, the matching face
    // grid is `AllQuadFaceIndices(nCols, nRows, true, false)` from
    // `meshes.library.plato` — the "flat sides, constant rate" clause is what
    // makes that grid mesh the polygonal solids EXACTLY rather than approximately.

    //==
    // Shared profile helpers

    // The point at `radius` from the origin in direction `a`, in the XY plane.
    PointOnCircle(a: Angle, radius: Number): Point2D
        => (a.Cos * radius, a.Sin * radius);

    // The point at angle `a` on the unit circle centered at the origin.
    // Local helper: the point at angle `a` on the unit circle centered at the origin.
    // Defined here so this library is self-contained; if `curves-shapes.types.plato`
    // later grows a canonical unit-circle evaluator, prefer that and delete this.
    PointOnUnitCircle(a: Angle): Point2D
        => PointOnCircle(a, 1.0);

    // A point on the regular n-gon inscribed in the unit circle, walked at
    // CONSTANT RATE: t in [0,1] covers the whole perimeter and the path is linear
    // between vertices (so the sides are genuinely flat, not chorded arcs). t is
    // taken modulo 1, so the walk repeats. Precondition: n >= 3.
    NGonPoint(t: Number, n: Integer): Point2D
    {
        var sides = n.ToNumber;
        var p = (t - t.Floor) * sides;
        var f = p - p.Floor;
        var a = PointOnUnitCircle((p.Floor / sides).Turns);
        var b = PointOnUnitCircle(((p.Floor + 1.0) / sides).Turns);
        return a.Lerp(b, f);
    }

    // A point on the axis-aligned square with corners at (+-1, +-1), walked at
    // constant rate: a 4-gon rotated an eighth turn and scaled by sqrt(2) so its
    // sides — not its vertices — land on the axes.
    SquarePoint(t: Number): Point2D
    {
        var c = (2.0).Sqrt;
        var p = (t - t.Floor) * 4.0;
        var f = p - p.Floor;
        var a = PointOnCircle(((p.Floor + 0.5) / 4.0).Turns, c);
        var b = PointOnCircle(((p.Floor + 1.5) / 4.0).Turns, c);
        return a.Lerp(b, f);
    }

    // The latitude/longitude point on the unit sphere: U wraps around the equator,
    // V runs from the north pole (V = 0) to the south pole (V = 1).
    UnitSpherePoint(uv: UvCoordinate): Vector3D
    {
        var theta = uv.U.Turns;
        var phi = (uv.V * 0.5).Turns;
        return (phi.Sin * theta.Cos, phi.Sin * theta.Sin, phi.Cos);
    }

    // A frame-local point mapped to world coordinates: the frame origin displaced
    // along its own axes by the local coordinates.
    PointInFrame(f: Frame3D, local: Point3D): Point3D
        => (f.Origin.X + f.XAxis.Vector.X * local.X + f.YAxis.Vector.X * local.Y + f.ZAxis.Vector.X * local.Z,
            f.Origin.Y + f.XAxis.Vector.Y * local.X + f.YAxis.Vector.Y * local.Y + f.ZAxis.Vector.Y * local.Z,
            f.Origin.Z + f.XAxis.Vector.Z * local.X + f.YAxis.Vector.Z * local.Y + f.ZAxis.Vector.Z * local.Z);

    // A right-handed orthonormal frame at `center` whose Z axis is `axis`. The X
    // axis is chosen by crossing `axis` with whichever world axis it is least
    // aligned with, so the construction never degenerates; the resulting azimuth
    // is arbitrary but stable, which is all a UV seam requires.
    AxisFrame(center: Point3D, axis: Direction3D): Frame3D
    {
        var z = axis.Vector;
        var helper = z.Z.Abs < 0.9 ? Vector3D.UnitZ : Vector3D.UnitX;
        var x = helper.Cross(z).Normalize;
        var y = z.Cross(x);
        return (center, Direction3D(x), Direction3D(y), Direction3D(z));
    }

    //==
    // Surfaces of revolution

    // U wraps the equator, V runs pole to pole.
    Eval(s: Sphere, uv: UvCoordinate): Point3D
    {
        var d = UnitSpherePoint(uv);
        return (s.Center.X + d.X * s.Radius,
                s.Center.Y + d.Y * s.Radius,
                s.Center.Z + d.Z * s.Radius);
    }
    ClosedU(s: Sphere): Boolean => true;
    ClosedV(s: Sphere): Boolean => false;

    // The unit sphere scaled by the semi-axes, then rotated by Orientation.
    Eval(s: Ellipsoid, uv: UvCoordinate): Point3D
    {
        var d = UnitSpherePoint(uv);
        var local = Vector3D(d.X * s.SemiAxes.X, d.Y * s.SemiAxes.Y, d.Z * s.SemiAxes.Z);
        var w = local.Transform(s.Orientation);
        return (s.Center.X + w.X, s.Center.Y + w.Y, s.Center.Z + w.Z);
    }
    ClosedU(s: Ellipsoid): Boolean => true;
    ClosedV(s: Ellipsoid): Boolean => false;

    // https://en.wikipedia.org/wiki/Torus#Geometry: U goes around the main (Axis)
    // circle, V around the tube — so a torus is the one solid closed in BOTH.
    Eval(s: Torus, uv: UvCoordinate): Point3D
    {
        var f = AxisFrame(s.Center, s.Axis);
        var u = uv.U.Turns;
        var v = uv.V.Turns;
        var ring = s.MajorRadius + s.MinorRadius * v.Cos;
        return f.PointInFrame(Point3D(ring * u.Cos, ring * u.Sin, s.MinorRadius * v.Sin));
    }
    ClosedU(s: Torus): Boolean => true;
    ClosedV(s: Torus): Boolean => true;

    // The lateral wall only (the flat caps are not part of the UV rectangle):
    // V = 0 is the -Height/2 rim, V = 1 the +Height/2 rim.
    Eval(s: Cylinder, uv: UvCoordinate): Point3D
    {
        var f = AxisFrame(s.Center, s.Axis);
        var p = PointOnCircle(uv.U.Turns, s.Radius);
        return f.PointInFrame(Point3D(p.X, p.Y, (uv.V - 0.5) * s.Height));
    }
    ClosedU(s: Cylinder): Boolean => true;
    ClosedV(s: Cylinder): Boolean => false;

    // V = 0 is the base rim, V = 1 the apex (where the U circle degenerates to a
    // point, so the last row of a UV quad grid is a fan of slivers).
    Eval(s: Cone, uv: UvCoordinate): Point3D
    {
        var f = AxisFrame(s.Apex, s.Axis);
        var p = PointOnCircle(uv.U.Turns, s.Radius * (1.0 - uv.V));
        return f.PointInFrame(Point3D(p.X, p.Y, s.Height * (1.0 - uv.V)));
    }
    ClosedU(s: Cone): Boolean => true;
    ClosedV(s: Cone): Boolean => false;

    // The lateral wall, radius interpolating from BottomRadius at V = 0 to
    // TopRadius at V = 1.
    Eval(s: ConicalFrustum, uv: UvCoordinate): Point3D
    {
        var f = AxisFrame(s.Center, s.Axis);
        var p = PointOnCircle(uv.U.Turns, s.BottomRadius.Lerp(s.TopRadius, uv.V));
        return f.PointInFrame(Point3D(p.X, p.Y, (uv.V - 0.5) * s.Height));
    }
    ClosedU(s: ConicalFrustum): Boolean => true;
    ClosedV(s: ConicalFrustum): Boolean => false;

    // Cylindrical side plus two hemispherical caps: V crosses the A-end cap over
    // [0, 0.25], the side over [0.25, 0.75], and the B-end cap over [0.75, 1].
    Eval(s: Capsule3D, uv: UvCoordinate): Point3D
    {
        var seg = s.A.Between(s.B);
        var f = AxisFrame(s.A.Lerp(s.B, 0.5), Direction3D(seg.Normalize));
        var theta = uv.U.Turns;
        var h = seg.Magnitude * 0.5;
        var r = s.Radius;
        var v = uv.V;
        var phiB = (0.5 - 0.25 * (v * 4.0)).Turns;
        var phiT = (0.25 - 0.25 * ((v - 0.75) * 4.0)).Turns;
        var local = v <= 0.25
            ? Point3D(phiB.Sin * theta.Cos * r, phiB.Sin * theta.Sin * r, phiB.Cos * r - h)
            : (v >= 0.75
                ? Point3D(phiT.Sin * theta.Cos * r, phiT.Sin * theta.Sin * r, phiT.Cos * r + h)
                : Point3D(theta.Cos * r, theta.Sin * r, (v - 0.5) * 4.0 * h));
        return f.PointInFrame(local);
    }
    ClosedU(s: Capsule3D): Boolean => true;
    ClosedV(s: Capsule3D): Boolean => false;

    // CylindricalShell UV: the outer wall up over V in [0, 0.5], then the inner wall back
    // down over [0.5, 1], so one UV rectangle covers both walls and the seam at
    // V = 0.5 is the top rim.
    Eval(s: CylindricalShell, uv: UvCoordinate): Point3D
    {
        var f = AxisFrame(s.Center, s.Axis);
        var r = uv.V < 0.5 ? s.OuterRadius : s.InnerRadius;
        var z = (uv.V < 0.5 ? (uv.V * 2.0) - 0.5 : 1.5 - (uv.V * 2.0)) * s.Height;
        var p = PointOnCircle(uv.U.Turns, r);
        return f.PointInFrame(Point3D(p.X, p.Y, z));
    }
    ClosedU(s: CylindricalShell): Boolean => true;
    ClosedV(s: CylindricalShell): Boolean => false;

    //==
    // Polygonal prisms and pyramids
    //
    // These are the payoff of the constant-rate profile walk: because NGonPoint /
    // SquarePoint are linear between vertices, a uniform UV grid puts grid lines
    // exactly on the profile edges and the quad mesh is EXACT, not an approximation.

    Eval(s: RegularPrism, uv: UvCoordinate): Point3D
    {
        var p = NGonPoint(uv.U, s.SideCount);
        return s.Frame.PointInFrame(
            Point3D(p.X * s.Radius, p.Y * s.Radius, (uv.V - 0.5) * s.Height));
    }
    ClosedU(s: RegularPrism): Boolean => true;
    ClosedV(s: RegularPrism): Boolean => false;

    // V = 0 is the base ring, V = 1 the apex.
    Eval(s: RegularPyramid, uv: UvCoordinate): Point3D
    {
        var p = NGonPoint(uv.U, s.SideCount);
        var r = s.Radius * (1.0 - uv.V);
        return s.Frame.PointInFrame(
            Point3D(p.X * r, p.Y * r, (uv.V - 0.5) * s.Height));
    }
    ClosedU(s: RegularPyramid): Boolean => true;
    ClosedV(s: RegularPyramid): Boolean => false;

    // V = 0 is the square base, V = 1 the apex.
    Eval(s: SquarePyramid, uv: UvCoordinate): Point3D
    {
        var p = SquarePoint(uv.U);
        var r = s.BaseLength * 0.5 * (1.0 - uv.V);
        return s.Frame.PointInFrame(
            Point3D(p.X * r, p.Y * r, (uv.V - 0.5) * s.Height));
    }
    ClosedU(s: SquarePyramid): Boolean => true;
    ClosedV(s: SquarePyramid): Boolean => false;

    // The four side walls of a box, as one closed-in-U strip. Size is the FULL
    // extent along each local axis, so the profile is scaled by half of it.
    Eval(s: Box3D, uv: UvCoordinate): Point3D
    {
        var p = SquarePoint(uv.U);
        var local = Vector3D(p.X * s.Size.Width * 0.5,
                             p.Y * s.Size.Height * 0.5,
                             (uv.V - 0.5) * s.Size.Depth);
        var w = local.Transform(s.Orientation);
        return (s.Center.X + w.X, s.Center.Y + w.Y, s.Center.Z + w.Z);
    }
    ClosedU(s: Box3D): Boolean => true;
    ClosedV(s: Box3D): Boolean => false;

    //==
    // # The typed polyhedral solids as polygon meshes
    //
    // The Kind dispatch and Frame/Radius placement that turn the value types of
    // `solids.types.plato` into geometry: each named solid looks up its
    // unit-circumradius mesh (the catalog factories of
    // `polyhedra.library.plato` stays the sole vertex source), rescales it to the requested circumscribed radius, and
    // maps it into the solid's frame. The parametric prism / pyramid / antiprism
    // families build their closed meshes directly from their profile parameters —
    // the parametric surface `Eval` above walks the same
    // boundary but is not a closed polyhedral mesh. Triangulation is the standard
    // second hop through `ToTriangleMesh` (`meshes-polygon.library.plato`).
    //
    // Catalog coverage is total: all thirteen Archimedeans and all thirteen
    // Catalans dispatch into a catalog factory (`polyhedra.library.plato`,
    // `polyhedra.library.plato`,
    // `polyhedra.library.plato`). Catalans
    // are rescaled by their measured circumscribed radius and never through
    // `ProjectedToUnitSphere` — they are face-transitive, so projecting would bend
    // their faces out of plane; a uniform scale cannot.

    //==
    // Placement helpers.

    // The mesh with every vertex mapped from frame-local to world coordinates
    // (`PointInFrame`, `transforms.library.plato`); connectivity is untouched.
    TransformedByFrame(self: PolygonMesh3D, f: Frame3D): PolygonMesh3D
        => (self.Positions.Map(p => f.PointInFrame(p)), self.Faces);

    // The largest distance from the origin to a vertex: the circumscribed
    // radius of an origin-centred polyhedron.
    CircumscribedRadius(self: PolygonMesh3D): Number
        => self.Positions.Map(p => p.PositionVector.Magnitude).Reduce(0.0, (acc, m) => acc.Max(m));

    // The mesh rescaled about the origin so its circumscribed radius is one.
    // A uniform scale, NOT ProjectedToUnitSphere: uniform scaling is
    // meaning-preserving for the face-transitive Catalans too, whose vertices
    // genuinely sit at several radii. The empty mesh passes through unchanged.
    ScaledToUnitCircumradius(self: PolygonMesh3D): PolygonMesh3D
        => self.VertexCount == 0 ? self : self.ScaledAboutOrigin(1.0 / self.CircumscribedRadius);

    // The empty polygon mesh: the explicit "nothing" mesh (no dispatch arm
    // returns it any more, but callers may still want the zero element).
    // Detect it with `MeshIsEmpty` or `VertexCount == 0`.
    EmptyPolygonMesh(_: PolygonMesh3D): PolygonMesh3D
        => PolygonMeshOfFaces(Repeat(0, Point3D.Origin),
                              Repeat(0, Repeat(0, VertexIndex(0))));

    //==
    // Unit meshes by kind: the dispatch from the kind sums into the seed and
    // catalog factories, each result at circumscribed radius one.

    // The five Platonic seeds are already projected onto the unit sphere, so
    // they pass through directly.
    UnitPolygonMesh(kind: PlatonicSolidKind): PolygonMesh3D
        => match (kind) {
            Tetrahedron => PolygonMesh3D.Tetrahedron;
            Cube => PolygonMesh3D.Cube;
            Octahedron => PolygonMesh3D.Octahedron;
            Dodecahedron => PolygonMesh3D.Dodecahedron;
            Icosahedron => PolygonMesh3D.Icosahedron;
        };

    // All thirteen Archimedeans dispatch into the catalog (the base ambo and
    // truncate families in `polyhedra.library.plato`, the expand,
    // bevel and snub families in `polyhedra.library.plato`).
    UnitPolygonMesh(kind: ArchimedeanSolidKind): PolygonMesh3D
        => match (kind) {
            TruncatedTetrahedron => PolygonMesh3D.TruncatedTetrahedron.ScaledToUnitCircumradius;
            Cuboctahedron => PolygonMesh3D.Cuboctahedron.ScaledToUnitCircumradius;
            TruncatedCube => PolygonMesh3D.TruncatedCube.ScaledToUnitCircumradius;
            TruncatedOctahedron => PolygonMesh3D.TruncatedOctahedron.ScaledToUnitCircumradius;
            Rhombicuboctahedron => PolygonMesh3D.Rhombicuboctahedron.ScaledToUnitCircumradius;
            TruncatedCuboctahedron => PolygonMesh3D.TruncatedCuboctahedron.ScaledToUnitCircumradius;
            SnubCube => PolygonMesh3D.SnubCube.ScaledToUnitCircumradius;
            Icosidodecahedron => PolygonMesh3D.Icosidodecahedron.ScaledToUnitCircumradius;
            TruncatedDodecahedron => PolygonMesh3D.TruncatedDodecahedron.ScaledToUnitCircumradius;
            TruncatedIcosahedron => PolygonMesh3D.TruncatedIcosahedron.ScaledToUnitCircumradius;
            Rhombicosidodecahedron => PolygonMesh3D.Rhombicosidodecahedron.ScaledToUnitCircumradius;
            TruncatedIcosidodecahedron => PolygonMesh3D.TruncatedIcosidodecahedron.ScaledToUnitCircumradius;
            SnubDodecahedron => PolygonMesh3D.SnubDodecahedron.ScaledToUnitCircumradius;
        };

    // All thirteen Catalans dispatch into the catalog (rescaled, never
    // projected — see the header; the nine newer duals live in
    // `polyhedra.library.plato`).
    UnitPolygonMesh(kind: CatalanSolidKind): PolygonMesh3D
        => match (kind) {
            TriakisTetrahedron => PolygonMesh3D.TriakisTetrahedron.ScaledToUnitCircumradius;
            RhombicDodecahedron => PolygonMesh3D.RhombicDodecahedron.ScaledToUnitCircumradius;
            TriakisOctahedron => PolygonMesh3D.TriakisOctahedron.ScaledToUnitCircumradius;
            TetrakisHexahedron => PolygonMesh3D.TetrakisHexahedron.ScaledToUnitCircumradius;
            DeltoidalIcositetrahedron => PolygonMesh3D.DeltoidalIcositetrahedron.ScaledToUnitCircumradius;
            DisdyakisDodecahedron => PolygonMesh3D.DisdyakisDodecahedron.ScaledToUnitCircumradius;
            PentagonalIcositetrahedron => PolygonMesh3D.PentagonalIcositetrahedron.ScaledToUnitCircumradius;
            RhombicTriacontahedron => PolygonMesh3D.RhombicTriacontahedron.ScaledToUnitCircumradius;
            TriakisIcosahedron => PolygonMesh3D.TriakisIcosahedron.ScaledToUnitCircumradius;
            PentakisDodecahedron => PolygonMesh3D.PentakisDodecahedron.ScaledToUnitCircumradius;
            DeltoidalHexecontahedron => PolygonMesh3D.DeltoidalHexecontahedron.ScaledToUnitCircumradius;
            DisdyakisTriacontahedron => PolygonMesh3D.DisdyakisTriacontahedron.ScaledToUnitCircumradius;
            PentagonalHexecontahedron => PolygonMesh3D.PentagonalHexecontahedron.ScaledToUnitCircumradius;
        };

    //==
    // Placed instances: unit mesh, scaled to the circumscribed radius, mapped
    // into the frame.

    ToPolygonMesh(s: PlatonicSolid): PolygonMesh3D
        => s.Kind.UnitPolygonMesh.ScaledAboutOrigin(s.Radius).TransformedByFrame(s.Frame);

    ToPolygonMesh(s: ArchimedeanSolid): PolygonMesh3D
        => s.Kind.UnitPolygonMesh.ScaledAboutOrigin(s.Radius).TransformedByFrame(s.Frame);

    ToPolygonMesh(s: CatalanSolid): PolygonMesh3D
        => s.Kind.UnitPolygonMesh.ScaledAboutOrigin(s.Radius).TransformedByFrame(s.Frame);

    //==
    // Parametric builders: closed meshes for the prism, pyramid and antiprism
    // families. Rings walk counter-clockwise seen from +Z, caps and walls wind
    // counter-clockwise seen from outside
    // (Convention: see CONVENTIONS.md - Winding, handedness, and normals).

    // The frame-local point at parameter t (in turns) around the Z axis at
    // radius `radius` and height `z`.
    RimPoint(t: Number, radius: Number, z: Number): Point3D
    {
        var p = PointOnCircle(t.Turns, radius);
        return (p.X, p.Y, z);
    }

    // Two SideCount-gon caps joined by SideCount rectangles: vertices 0..n-1
    // are the bottom ring at -Height/2, n..2n-1 the top ring at +Height/2.
    ToPolygonMesh(s: RegularPrism): PolygonMesh3D
    {
        var n = s.SideCount;
        var sides = n.ToNumber;
        var bottom = n.MapRange(i => RimPoint(i.ToNumber / sides, s.Radius, s.Height * -0.5));
        var top = n.MapRange(i => RimPoint(i.ToNumber / sides, s.Radius, s.Height * 0.5));
        var caps = Concatenate(Repeat(1, n.MapRange(i => n - 1 - i)),
                               Repeat(1, n.MapRange(i => n + i)));
        var walls = n.MapRange(i => [i, (i + 1) % n, n + ((i + 1) % n), n + i]);
        return PolygonMeshOfVertexNumbers(Concatenate(bottom, top), Concatenate(caps, walls))
            .TransformedByFrame(s.Frame);
    }

    // A SideCount-gon base at -Height/2 (vertices 0..n-1) tapering to the apex
    // (vertex n) at +Height/2 through SideCount triangles.
    ToPolygonMesh(s: RegularPyramid): PolygonMesh3D
    {
        var n = s.SideCount;
        var sides = n.ToNumber;
        var ring = n.MapRange(i => RimPoint(i.ToNumber / sides, s.Radius, s.Height * -0.5));
        var apex = Repeat(1, Point3D(0.0, 0.0, s.Height * 0.5));
        var cap = Repeat(1, n.MapRange(i => n - 1 - i));
        var walls = n.MapRange(i => [i, (i + 1) % n, n]);
        return PolygonMeshOfVertexNumbers(Concatenate(ring, apex), Concatenate(cap, walls))
            .TransformedByFrame(s.Frame);
    }

    // The axis-aligned square base at -Height/2 (vertices 0..3, counter-
    // clockwise from (-, -)) tapering to the apex (vertex 4) at +Height/2.
    ToPolygonMesh(s: SquarePyramid): PolygonMesh3D
    {
        var b = s.BaseLength * 0.5;
        var h = s.Height * 0.5;
        var points = [Point3D(-b, -b, -h), Point3D(b, -b, -h),
                      Point3D(b, b, -h), Point3D(-b, b, -h),
                      Point3D(0.0, 0.0, h)];
        var faces = [[3, 2, 1, 0], [0, 1, 4], [1, 2, 4], [2, 3, 4], [3, 0, 4]];
        return PolygonMeshOfVertexNumbers(points, faces).TransformedByFrame(s.Frame);
    }

    // Two SideCount-gon caps a half step out of phase (top ring rotated by half
    // a side) joined by a band of 2 * SideCount triangles: vertices 0..n-1 are
    // the bottom ring, n..2n-1 the top ring.
    ToPolygonMesh(s: Antiprism): PolygonMesh3D
    {
        var n = s.SideCount;
        var sides = n.ToNumber;
        var bottom = n.MapRange(i => RimPoint(i.ToNumber / sides, s.Radius, s.Height * -0.5));
        var top = n.MapRange(i => RimPoint((i.ToNumber + 0.5) / sides, s.Radius, s.Height * 0.5));
        var caps = Concatenate(Repeat(1, n.MapRange(i => n - 1 - i)),
                               Repeat(1, n.MapRange(i => n + i)));
        var lower = n.MapRange(i => [i, (i + 1) % n, n + i]);
        var upper = n.MapRange(i => [(i + 1) % n, n + ((i + 1) % n), n + i]);
        return PolygonMeshOfVertexNumbers(Concatenate(bottom, top),
                                          Concatenate(caps, Concatenate(lower, upper)))
            .TransformedByFrame(s.Frame);
    }

    //==
    // The IMesh3D obligation of every typed solid is the derived
    // ToTriangleMesh(IPolygonMesh3D) in `meshes-polygon.library.plato`: each one
    // triangulates through its own polygon mesh by fan triangulation.

    //==
    // # Deformation bodies for the profile-generated solids
    //
    // The IDeformable3D obligation of the one solid in `solids.types.plato` that
    // is spanned by stored points. Extrude, revolve and sweep are absent: each
    // carries a placement frame, an axis or a path curve, and a point mapping
    // supplies no image for those.

    // Each cross-section deformed in turn; the sections keep their point counts,
    // so the loft's correspondence between them survives, and Closed is a
    // topological flag rather than geometry.
    Deform(self: LoftedSolid, mapping: Function1<Point3D, Point3D>): LoftedSolid
        => (self.Sections.Map(section => section.Deform(mapping)), self.Closed);
}
