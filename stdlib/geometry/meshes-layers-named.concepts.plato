//==
// # Named mesh layers
//
// The named pairings over the generic tower in `meshes-layers.concepts.plato`:
// each fixes the point type and the primitive, and each Indexed* name also
// fixes the typed index tuple that spells that primitive's arity. These are the
// names algorithms and type declarations should use — `TriangleGeometry3D`
// rather than `PrimitiveGeometry<Point3D, Triangle3D>` — so a signature reads as
// the shape it accepts. The plane and space are named together here because the
// layers themselves are dimension-agnostic; only these bindings differ.
//
// The concept names cannot be the bare nouns: `TriangleMesh3D`, `QuadMesh3D`,
// `LineSet3D` and `LineSet2D` are concrete storage types in
// `meshes.types.plato` and `meshes-lines-points.types.plato`. The layer-2 names
// therefore carry the Indexed prefix, which is also what distinguishes them.
// The line primitive is LineSegment2D / LineSegment3D, not Line2D / Line3D:
// a line set stores bounded segments, while Line*D is an infinite line.
// Convention: see CONVENTIONS.md - Winding, handedness, and normals.

//==
// # Layer 1 — the primitive view

// Bounded segments in space over their own endpoints: wireframes, edge
// overlays, sampled space curves.
concept SegmentGeometry3D
    inherits Geometry3D, PrimitiveGeometry<Point3D, LineSegment3D>
{ }

// Triangles in space, wound counter-clockwise seen from the front: the
// universal surface primitive.
concept TriangleGeometry3D
    inherits Geometry3D, PrimitiveGeometry<Point3D, Triangle3D>
{ }

// Quadrilaterals in space, wound counter-clockwise seen from the front.
// Coplanarity is not guaranteed.
concept QuadGeometry3D
    inherits Geometry3D, PrimitiveGeometry<Point3D, Quad3D>
{ }

// Bounded segments in the plane: sketch overlays, hatch patterns, planar
// graphs drawn as geometry.
concept SegmentGeometry2D
    inherits Geometry2D, PrimitiveGeometry<Point2D, LineSegment2D>
{ }

// Triangles in the plane, wound counter-clockwise: triangulations, Delaunay
// output, finite-element cells, UV domains.
concept TriangleGeometry2D
    inherits Geometry2D, PrimitiveGeometry<Point2D, Triangle2D>
{ }

// Quadrilaterals in the plane, wound counter-clockwise: structured grid cells
// and quad-dominant planar layouts.
concept QuadGeometry2D
    inherits Geometry2D, PrimitiveGeometry<Point2D, Quad2D>
{ }

//==
// # Layer 2 — the indexed storage

// Segments in space over a shared vertex pool, each spelled as a vertex pair:
// the storage form of a wireframe. `LineSet3D` is the concrete type.
concept IndexedSegmentGeometry3D
    inherits IndexedGeometry<Point3D, LineSegment3D, VertexPair>, SegmentGeometry3D
{ }

// Triangles in space over a shared vertex pool, each spelled as a TriangleFace:
// the workhorse interchange form, concretely `TriangleMesh3D`.
concept IndexedTriangleGeometry3D
    inherits IndexedGeometry<Point3D, Triangle3D, TriangleFace>, TriangleGeometry3D
{ }

// Quadrilaterals in space over a shared vertex pool, each spelled as a
// QuadFace: subdivision cages, quad-dominant retopology, structured patches.
concept IndexedQuadGeometry3D
    inherits IndexedGeometry<Point3D, Quad3D, QuadFace>, QuadGeometry3D
{ }

// Segments in the plane over a shared vertex pool. `LineSet2D` is the concrete
// type.
concept IndexedSegmentGeometry2D
    inherits IndexedGeometry<Point2D, LineSegment2D, VertexPair>, SegmentGeometry2D
{ }

// Triangles in the plane over a shared vertex pool: concretely
// `TriangleMesh2D`, and the form a UV domain takes when it shares its index
// table with the spatial mesh it parameterizes.
concept IndexedTriangleGeometry2D
    inherits IndexedGeometry<Point2D, Triangle2D, TriangleFace>, TriangleGeometry2D
{ }

// Quadrilaterals in the plane over a shared vertex pool: structured planar
// grids and quad meshing output.
concept IndexedQuadGeometry2D
    inherits IndexedGeometry<Point2D, Quad2D, QuadFace>, QuadGeometry2D
{ }
