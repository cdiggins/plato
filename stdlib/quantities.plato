//==
// # Quantities and units
//
// A quantity is a number with an intrinsic unit of measure implied by its type
// (https://en.wikipedia.org/wiki/Physical_quantity). Quantities add, subtract,
// scale, order, and interpolate — but multiplying two quantities yields a
// different type, so they are deliberately not Arithmetic. Each type's field
// name states its canonical (SI or conventional) unit
// (https://en.wikipedia.org/wiki/International_System_of_Units).

// A one-dimensional measured amount with an implicit unit.
concept Quantity
    inherits Value, Comparable, Hashable, Additive, Scalable, Interpolatable
{
    Amount(x: Self): Number;
    FromAmount(_: Self, x: Number): Self;
}

//==
// # Dynamic units
//
// For unit systems resolved at runtime (file import, UI, scientific data).

// Exponents of the seven SI base dimensions
// (https://en.wikipedia.org/wiki/Dimensional_analysis). A dimensionless value
// has all zeros.
type Dimension
{
    LengthPower: Integer;
    MassPower: Integer;
    TimePower: Integer;
    CurrentPower: Integer;
    TemperaturePower: Integer;
    AmountPower: Integer;
    LuminosityPower: Integer;
}

// A named unit of measure with a conversion to SI: si = value * ScaleToSI + OffsetToSI
// (https://en.wikipedia.org/wiki/Unit_of_measurement).
type UnitOfMeasure
{
    Name: String;
    Symbol: String;
    Dimension: Dimension;
    ScaleToSI: Number;
    OffsetToSI: Number;
}

// A runtime-typed quantity: an amount tagged with a unit value.
type DynamicQuantity
{
    Amount: Number;
    Unit: UnitOfMeasure;
}

//==
// # Geometric and kinematic quantities

// A planar angle, stored in radians (https://en.wikipedia.org/wiki/Angle).
type Angle implements Quantity { Radians: Number; }

// A solid angle, stored in steradians (https://en.wikipedia.org/wiki/Solid_angle).
type SolidAngle implements Quantity { Steradians: Number; }

// A spatial distance, stored in meters.
type Length implements Quantity { Meters: Number; }

// A surface measure, stored in square meters.
type Area implements Quantity { SquareMeters: Number; }

// A spatial volume, stored in cubic meters.
type Volume implements Quantity { CubicMeters: Number; }

// Rate of change of position, stored in meters per second.
type Speed implements Quantity { MetersPerSecond: Number; }

// Rate of change of speed, stored in meters per second squared.
type Acceleration implements Quantity { MetersPerSecondSquared: Number; }

// Rate of change of acceleration, stored in meters per second cubed.
type Jerk implements Quantity { MetersPerSecondCubed: Number; }

// Rate of rotation, stored in radians per second.
type AngularVelocity implements Quantity { RadiansPerSecond: Number; }

// Rate of change of angular velocity, stored in radians per second squared.
type AngularAcceleration implements Quantity { RadiansPerSecondSquared: Number; }

// Spatial frequency (cycles per meter); the reciprocal of wavelength.
type WaveNumber implements Quantity { CyclesPerMeter: Number; }

// Curvature, stored as reciprocal meters (1/radius).
type Curvature implements Quantity { PerMeter: Number; }

//==
// # Mechanical quantities

// Mass, stored in kilograms.
type Mass implements Quantity { Kilograms: Number; }

// Mass per volume, stored in kilograms per cubic meter.
type Density implements Quantity { KilogramsPerCubicMeter: Number; }

// Mass per area, stored in kilograms per square meter.
type ArealDensity implements Quantity { KilogramsPerSquareMeter: Number; }

// Mass per length, stored in kilograms per meter.
type LinearDensity implements Quantity { KilogramsPerMeter: Number; }

// Force, stored in newtons (https://en.wikipedia.org/wiki/Force).
type Force implements Quantity { Newtons: Number; }

// Rotational force, stored in newton-meters (https://en.wikipedia.org/wiki/Torque).
type Torque implements Quantity { NewtonMeters: Number; }

// Impulse (force integrated over time), stored in newton-seconds.
type Impulse implements Quantity { NewtonSeconds: Number; }

// Linear momentum, stored in kilogram-meters per second.
type Momentum implements Quantity { KilogramMetersPerSecond: Number; }

// Angular momentum, stored in kilogram-square-meters per second
// (https://en.wikipedia.org/wiki/Angular_momentum).
type AngularMomentum implements Quantity { KilogramSquareMetersPerSecond: Number; }

// Rotational inertia about an axis, stored in kilogram-square-meters
// (https://en.wikipedia.org/wiki/Moment_of_inertia).
type MomentOfInertia implements Quantity { KilogramSquareMeters: Number; }

// Energy or work, stored in joules (https://en.wikipedia.org/wiki/Energy).
type Energy implements Quantity { Joules: Number; }

// Rate of energy transfer, stored in watts.
type Power implements Quantity { Watts: Number; }

// Force per area, stored in pascals. Also used for stress.
type Pressure implements Quantity { Pascals: Number; }

// Elastic stiffness of a spring, stored in newtons per meter.
type Stiffness implements Quantity { NewtonsPerMeter: Number; }

// Viscous damping coefficient, stored in newton-seconds per meter.
type DampingCoefficient implements Quantity { NewtonSecondsPerMeter: Number; }

// Dynamic viscosity, stored in pascal-seconds.
type DynamicViscosity implements Quantity { PascalSeconds: Number; }

// Kinematic viscosity, stored in square meters per second.
type KinematicViscosity implements Quantity { SquareMetersPerSecond: Number; }

// Mass flow, stored in kilograms per second.
type MassFlowRate implements Quantity { KilogramsPerSecond: Number; }

// Volume flow, stored in cubic meters per second.
type VolumetricFlowRate implements Quantity { CubicMetersPerSecond: Number; }

// Dimensionless deformation ratio (change in length over length).
type Strain implements Quantity { Ratio: Number; }

//==
// # Thermal, electrical, chemical, and photometric quantities

// Absolute temperature, stored in kelvin.
type Temperature implements Quantity { Kelvin: Number; }

// Temperature difference, stored in kelvin.
type TemperatureDelta implements Quantity { Kelvin: Number; }

// Heat capacity, stored in joules per kelvin.
type HeatCapacity implements Quantity { JoulesPerKelvin: Number; }

// Thermal conductivity, stored in watts per meter-kelvin.
type ThermalConductivity implements Quantity { WattsPerMeterKelvin: Number; }

// Repetition rate, stored in hertz (cycles per second).
type Frequency implements Quantity { Hertz: Number; }

// Electric current, stored in amperes.
type ElectricCurrent implements Quantity { Amperes: Number; }

// Electric charge, stored in coulombs.
type ElectricCharge implements Quantity { Coulombs: Number; }

// Electric potential, stored in volts.
type Voltage implements Quantity { Volts: Number; }

// Electrical resistance, stored in ohms.
type Resistance implements Quantity { Ohms: Number; }

// Electrical capacitance, stored in farads.
type Capacitance implements Quantity { Farads: Number; }

// Electrical inductance, stored in henries.
type Inductance implements Quantity { Henries: Number; }

// Amount of substance, stored in moles.
type AmountOfSubstance implements Quantity { Moles: Number; }

// Luminous intensity, stored in candelas.
type LuminousIntensity implements Quantity { Candelas: Number; }

// Luminous flux, stored in lumens.
type LuminousFlux implements Quantity { Lumens: Number; }

// Illuminance, stored in lux.
type Illuminance implements Quantity { Lux: Number; }

// Luminance, stored in candelas per square meter (nits).
type Luminance implements Quantity { CandelasPerSquareMeter: Number; }

// Radiant flux per area, stored in watts per square meter.
type Irradiance implements Quantity { WattsPerSquareMeter: Number; }
