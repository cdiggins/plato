//==
// # Vectors and numeric tuples
//
// Two families share the Vector concept
// (https://en.wikipedia.org/wiki/Euclidean_vector). The Number2/3/4/8 family
// is the low-level intrinsic tier: fixed-arity tuples of Numbers with
// component-wise arithmetic, mapped directly onto each backend's native
// vector type (System.Numerics, vecN, floatN). The Vector2D/3D family is
// geometric: displacements and directions in 2D/3D space. Points (file 11)
// are positions; geometric vectors are the differences between them. Naming
// rule: a bare number counts components (Number3, Tuple3, IntegerVector3); a
// D suffix means the type lives in that-dimensional space (Vector3D, Point3D,
// Ray3D).
//
// Discoverability banner (item 473): the concrete per-component and geometric
// operations for Number2/3/4/8, Vector2D and Vector3D — Normalize, Dot, Cross,
// Length/LengthSquared, Add/Subtract/Multiply/Divide, Reflect, Transform — are
// declared on the intrinsic hub in `intrinsics.plato`, not restated here. The
// concept-generic helpers (Distance, DistanceSquared, projection/rejection,
// AngleBetween, component-wise lifts, and the safe `NormalizeOr` / Direction
// factories below-in-spirit) live in `numeric-structures.library.plato`.

// The family of fixed-arity numeric vectors: component-wise arithmetic, norms,
// dot product, and component-wise extremes
// (https://en.wikipedia.org/wiki/Vector_space).
//
// Indexable<Number> supplies the read half of the component surface (Count is
// the arity, At(i) the i-th component). FromComponents and Broadcast supply the
// construction half, which is what makes component-wise map, zip, and fold
// derivable generically in `numeric-structures.library.plato` — every lifted
// Number function (Abs, Floor, Pow, Lerp, ...) and every reduction
// (SumComponents, MinComponent, Magnitude) is written once against this pair
// rather than once per concrete type.
concept Vector
    inherits Numerical, Arithmetic, Indexable<Number>, Normed, Lattice, Hashable
{
    Dot(a: Self, b: Self): Number;

    // Builds a value of this vector type from its components, in index order.
    // The receiver only selects the type; its own components are ignored.
    // Precondition: xs has exactly Count entries (for fixed-arity vectors).
    FromComponents(_: Self, xs: Array<Number>): Self;

    // Builds a value of this vector type with every component set to x (the
    // component-wise constant). The receiver only selects the type and, for
    // runtime-arity vectors, the arity.
    Broadcast(_: Self, x: Number): Self;
}

// A pair of Numbers: the low-level intrinsic 2-tuple.
type Number2
    implements Vector
{
    X: Number;
    Y: Number;
}

// A triple of Numbers: the low-level intrinsic 3-tuple.
type Number3
    implements Vector
{
    X: Number;
    Y: Number;
    Z: Number;
}

// A quadruple of Numbers: the low-level intrinsic 4-tuple; also used for
// homogeneous coordinates (https://en.wikipedia.org/wiki/Homogeneous_coordinates)
// and RGBA math.
type Number4
    implements Vector
{
    X: Number;
    Y: Number;
    Z: Number;
    W: Number;
}

// An octuple of Numbers: the low-level intrinsic 8-tuple (SIMD-width lane math).
type Number8
    implements Vector
{
    X0: Number;
    X1: Number;
    X2: Number;
    X3: Number;
    X4: Number;
    X5: Number;
    X6: Number;
    X7: Number;
}

// A displacement or direction in 2D space.
type Vector2D
    implements Vector
{
    X: Number;
    Y: Number;
}

// A displacement or direction in 3D space.
type Vector3D
    implements Vector
{
    X: Number;
    Y: Number;
    Z: Number;
}

// An N-dimensional vector with runtime-determined arity.
// VectorN is the one Vector implementor whose components are not its fields, so
// the writer's At/Count synthesis has to delegate to the field rather than count
// fields. It does: verified by emitting and running the code, a 5-component
// VectorN reports Count == 5 and At(2) == 3. The generic bodies in
// numeric-structures.library.plato that read Count/At as the component surface are
// correct here.
//
// This worked only because the field is spelled Array<Number>. Until 099c447 the
// delegation was gated on a type-NAME test ("Array"/"Array2D"/"Array3D"), so an
// IArray<T>-typed field -- the stdlib-legacy spelling -- fell through and emitted
// Count => 1, and Array2D/Array3D matched despite having no linear Count. The fix
// keys off the field type's concept. Keep the field's type Indexable-providing if
// this declaration is ever reshaped.
//
// The real runtime gap is elsewhere and much larger: the emitted vector types
// currently throw NotImplementedException for Add/Subtract/Multiply/Magnitude/Zero,
// so the concept-generic bodies compute only at the Number instantiation today.
// See docs/stdlib-legacy-port-candidates-2026-07-28.md, follow-ups section.
type VectorN
    implements Vector
{
    Components: Array<Number>;
}

// A pair of whole-number components: pixel offsets, grid steps.
type IntegerVector2
    implements Value, Hashable
{
    X: Integer;
    Y: Integer;
}

// A triple of whole-number components: voxel offsets, 3D grid steps.
type IntegerVector3
    implements Value, Hashable
{
    X: Integer;
    Y: Integer;
    Z: Integer;
}

// A quadruple of whole-number components.
type IntegerVector4
    implements Value, Hashable
{
    X: Integer;
    Y: Integer;
    Z: Integer;
    W: Integer;
}

// A 2D direction: a Vector2D with the invariant that its magnitude is one
// (https://en.wikipedia.org/wiki/Unit_vector). The invariant is a promise of
// intent, not a runtime proof: an arbitrary Vector2D may violate unit length
// after a non-rigid transform or manual construction. Construct one via
// normalization of a non-zero displacement — the validated factories
// `FromVector` / `TryFromVector` (and the explicitly unsafe
// `FromVectorUnchecked`) in `numeric-structures.library.plato`; zero input is
// undefined. Check unit length with `IsUnit` (core-algebra) for diagnostics.
type Direction2D
    implements Value
{
    Vector: Vector2D;
}

// A 3D direction: a Vector3D with the invariant that its magnitude is one.
// The invariant is a promise of intent, not a runtime proof: an arbitrary
// Vector3D may violate unit length after a non-rigid transform or manual
// construction. Construct one via normalization of a non-zero displacement —
// the validated factories `FromVector` / `TryFromVector` (and the explicitly
// unsafe `FromVectorUnchecked`) in `numeric-structures.library.plato`; zero
// input is undefined. Check unit length with `IsUnit` (core-algebra) for
// diagnostics.
type Direction3D
    implements Value
{
    Vector: Vector3D;
}
