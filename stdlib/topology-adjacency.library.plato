//==
// # TopologyAdjacency — concrete bodies for the adjacency tables
//
// The `Jagged` projections for the three CSR adjacency tables declared in
// `topology-adjacency.plato`. Each table already stores its boundaries in a
// field literally named `Offsets`, so only the payload projection is written
// here; the shared row vocabulary comes from `collections-jagged.library.plato`.

library TopologyAdjacency
{
    //==
    // # Adjacency tables as Jagged rows
    //
    // Rows are the source elements (vertices, then faces); a row is that
    // element's neighbourhood run.

    // The neighbours of each vertex, packed vertex by vertex.
    Values(self: VertexAdjacency): Array<VertexIndex>
        => self.Neighbors;

    // The edge-adjacent faces of each face, packed face by face.
    Values(self: FaceAdjacency): Array<FaceIndex>
        => self.Neighbors;

    // The incident faces of each vertex, packed vertex by vertex.
    Values(self: VertexFaceAdjacency): Array<FaceIndex>
        => self.Faces;
}
