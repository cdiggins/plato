//==
// # Uncertainty
//
// Sections, in order:
//  - Uncertainty
//  - Uncertain geometry and estimation
//  - Measurements, calibration, and sampled ensembles

//==
// # Uncertainty
//
// Scalar values that carry uncertainty without losing their nominal reading:
// measurement uncertainty, confidence intervals, engineering tolerances, and
// fuzzy numbers. Standard uncertainties are one standard deviation (1-sigma)
// unless a coverage factor says otherwise. Uncertain geometry, state
// estimation, and error propagation follow in the sections below.

// A measured or estimated number with its standard (1-sigma) uncertainty,
// in the same implicit unit as the value.
// (https://en.wikipedia.org/wiki/Measurement_uncertainty)
type UncertainNumber
    implements IValue
{
    Value: Number;
    StandardUncertainty: Number;
}

// A runtime-united measurement: an amount, its standard uncertainty in the
// same unit, and the unit itself.
type UncertainQuantity
    implements IValue
{
    Amount: Number;
    StandardUncertainty: Number;
    Unit: UnitOfMeasure;
}

// An expanded uncertainty per the GUM convention: the reported half-width is
// CoverageFactor times StandardUncertainty (k = 2 gives roughly 95%
// coverage for a normal error model).
type ExpandedUncertainty
    implements IValue
{
    StandardUncertainty: Number;
    CoverageFactor: Number;
}

// An interval asserted to contain the true value with the stated confidence
// Level (e.g. 0.95). Lower does not exceed Upper.
// (https://en.wikipedia.org/wiki/Confidence_interval)
type ConfidenceInterval
    implements IValue
{
    Lower: Number;
    Upper: Number;
    Level: Probability;
}

// The alpha of a hypothesis test: the accepted probability of rejecting a
// true null hypothesis (e.g. 0.05).
// (https://en.wikipedia.org/wiki/Statistical_significance)
type SignificanceLevel
    implements IValue
{
    Alpha: Probability;
}

// An asymmetric engineering tolerance about a nominal value. The acceptable
// range is [Nominal - Minus, Nominal + Plus]; Plus and Minus are
// non-negative magnitudes.
// (https://en.wikipedia.org/wiki/Engineering_tolerance)
// Convention: see CONVENTIONS.md - Floating-point comparison (this is an
// acceptance allowance, explicitly NOT the ComparisonTolerance epsilon record).
type Tolerance
    implements IValue
{
    Nominal: Number;
    Plus: Number;
    Minus: Number;
}

// One endpoint of a one-dimensional range: the endpoint value and whether
// the endpoint itself is included.
// (https://en.wikipedia.org/wiki/Interval_(mathematics))
type IntervalBound
    implements IValue
{
    Value: Number;
    Inclusive: Boolean;
}

//==
// # Fuzzy numbers
//
// Fuzzy membership functions over the real line: membership is 0 outside
// the support, 1 on the core, and ramps linearly between.

// A triangular fuzzy number: support [A, C] with full membership only at
// the peak B, where A <= B <= C.
// (https://en.wikipedia.org/wiki/Fuzzy_number)
type TriangularFuzzyNumber
    implements IValue
{
    A: Number;
    B: Number;
    C: Number;
}

// A trapezoidal fuzzy number: support [A, D] with full membership on the
// core [B, C], where A <= B <= C <= D.
// (https://en.wikipedia.org/wiki/Membership_function_(mathematics))
type TrapezoidalFuzzyNumber
    implements IValue
{
    A: Number;
    B: Number;
    C: Number;
    D: Number;
}

//==
// # Uncertain geometry and estimation
//
// Geometric values carrying Gaussian uncertainty as a covariance, the state
// and model records of a linear Kalman filter, and the choice of how
// uncertainty is carried through a computation. Covariance orders match the
// value they describe; the scalar uncertainty types are the section above.

//==
// # Uncertain geometry

// A 2D vector with a 2x2 covariance of its components.
type UncertainVector2D
    implements IValue
{
    Value: Vector2D;
    Covariance: Covariance2D;
}

// A 3D vector with a 3x3 covariance of its components.
type UncertainVector3D
    implements IValue
{
    Value: Vector3D;
    Covariance: Covariance3D;
}

// A 2D position with a 2x2 covariance of its coordinates.
type UncertainPoint2D
    implements IValue
{
    Value: Point2D;
    Covariance: Covariance2D;
}

// A 3D position with a 3x3 covariance of its coordinates.
type UncertainPoint3D
    implements IValue
{
    Value: Point3D;
    Covariance: Covariance3D;
}

//==
// # State estimation

// A Kalman estimate: the state mean vector and its covariance matrix, whose
// order matches the state length.
// (https://en.wikipedia.org/wiki/Kalman_filter)
type KalmanState
    implements IValue
{
    State: Array<Number>;
    Covariance: MatrixN;
}

// The model matrices of a linear Kalman filter: state Transition (F),
// Observation (H), ProcessNoise covariance (Q), and ObservationNoise
// covariance (R).
type KalmanFilterParameters
    implements IValue
{
    Transition: MatrixN;
    Observation: MatrixN;
    ProcessNoise: MatrixN;
    ObservationNoise: MatrixN;
}

//==
// # Error propagation

// How uncertainty is propagated through a computation: first-order Taylor
// (Linear), sampled with the given count and deterministic seed
// (MonteCarlo), or sigma points (Unscented).
// (https://en.wikipedia.org/wiki/Propagation_of_uncertainty)
type ErrorPropagation
    = Linear
    | MonteCarlo(SampleCount: Integer, Seed: Integer)
    | Unscented;

//==
// # Measurements, calibration, and sampled ensembles
//
// Where an uncertain value came from: an instrument reading with its
// provenance, the calibration model that turns raw instrument output into a
// quantity, and the sample ensembles a Monte-Carlo propagation produces. The
// uncertainty records and the covariance-carrying geometric values live in the
// sections above;
// these types say who measured a value, when, and how well.

//==
// # Measurements

// One reading of any measurable value, with its provenance: when it was taken,
// what produced it, and a Quality in [0, 1] rating the reading's own
// trustworthiness (sensor confidence, fit score, signal strength) — which is a
// different thing from the value's uncertainty. Carry T as an UncertainNumber
// or an UncertainQuantity when the reading has a known uncertainty.
// (https://en.wikipedia.org/wiki/Measurement)
type Measurement<T>
{
    Value: T;
    Timestamp: Instant;
    Source: String;
    Quality: Probability;
}

// A time-ordered run of readings of the same value from the same source:
// a sensor log, a repeated observation, an instrument sweep. Measurements are
// ordered by Timestamp, ascending.
type MeasurementSeries<T>
{
    Measurements: Array<Measurement<T>>;
}

//==
// # Calibration

// One fitted coefficient of a calibration model: its name, its value with the
// uncertainty the fit assigned it, and the unit that value is expressed in.
type CalibrationParameter
    implements IValue
{
    Name: String;
    Value: UncertainNumber;
    Unit: UnitOfMeasure;
}

// The fitted model that converts an instrument's raw output into a physical
// quantity: the named parameter set plus the instant the calibration was
// performed, which is what dates a measurement's traceability.
// (https://en.wikipedia.org/wiki/Calibration)
type CalibrationModel
    implements IValue
{
    Name: String;
    Parameters: Array<CalibrationParameter>;
    PerformedAt: Instant;
}

//==
// # Sampled ensembles
//
// The sampled counterpart of an analytic uncertainty: rather than propagating
// a covariance, propagate many draws and read the statistics off the result.
// The Linear and Unscented alternatives are the ErrorPropagation cases above.

// One draw of a Monte-Carlo propagation: the sampled value and the importance
// weight it carries. Weights are non-negative; a plain unweighted draw uses 1.
// (https://en.wikipedia.org/wiki/Monte_Carlo_method)
type MonteCarloSample<T>
{
    Value: T;
    Weight: Number;
}

// A weighted collection of draws standing in for one uncertain value. The
// ensemble mean and spread are the sampled estimate of that value's nominal
// reading and its uncertainty.
// (https://en.wikipedia.org/wiki/Ensemble_(mathematical_physics))
type Ensemble<T>
{
    Samples: Array<MonteCarloSample<T>>;
}

//==
// # Uncertain pose

// A rigid placement with the 6x6 covariance of its own error, ordered
// translation before rotation. The state a scanner, tracker, or SLAM front end
// actually reports: a pose is never known exactly, and the covariance is what
// downstream registration needs in order to weight it.
// (https://en.wikipedia.org/wiki/Pose_(computer_vision))
type UncertainPose3D
    implements IValue
{
    Value: Pose3D;
    Covariance: MatrixN;
}
