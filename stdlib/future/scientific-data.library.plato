//==
// # ScientificData — derived functions for ITimeSampled
//
// Bodies for the `ITimeSampled` concept declared in
// `scientific-data.concepts.plato`: a time-indexed collection of SampleCount
// samples, each with a TimeAt(index). The helpers are the emptiness,
// index-validity and endpoint-time summaries; sample times are Instants, so a
// span is their IDifference (a Duration). Pure expressions only; all inputs are
// immutable and evaluation is side-effect free. See `README.md` for naming and
// unit conventions.

library ScientificData
{
    //==
    // # ITimeSampled
    //
    // A time-indexed collection: SampleCount samples, each with a TimeAt(index).
    // Times are Instants, so a span is their IDifference (a Duration).

    // True when the collection holds no samples.
    IsEmpty(self: ITimeSampled): Boolean
        => self.SampleCount == 0;

    // True when the collection holds at least one sample.
    IsNotEmpty(self: ITimeSampled): Boolean
        => self.SampleCount > 0;

    // The index of the last sample (SampleCount - 1); negative when empty.
    LastSampleIndex(self: ITimeSampled): Integer
        => self.SampleCount - 1;

    // True when index addresses a real sample, within [0, SampleCount).
    IsValidSampleIndex(self: ITimeSampled, index: Integer): Boolean
        => index >= 0 && index < self.SampleCount;

    // The time of the first sample. Precondition: the collection is not empty.
    FirstTime(self: ITimeSampled): Instant
        => self.TimeAt(0);

    // The time of the last sample. Precondition: the collection is not empty.
    LastTime(self: ITimeSampled): Instant
        => self.TimeAt(self.SampleCount - 1);

    // The elapsed span from the first to the last sample. Precondition: the
    // collection is not empty.
    TimeSpan(self: ITimeSampled): Duration
        => self.TimeAt(0).Between(self.TimeAt(self.SampleCount - 1));

    //==
    // # The ITimeSampled fills
    //
    // Two shapes: a uniform series computes its sample times from Start and
    // SamplePeriod, and an irregular one stores them. The derived surface above
    // does not care which, which is the whole point of the concept.

    // One time per stored value.
    SampleCount(self: TimeSeries): Integer
        => self.Values.Count;

    // Start advanced by index whole sample periods.
    TimeAt(self: TimeSeries, index: Integer): Instant
        => self.Start + self.SamplePeriod * index.ToNumber;

    // One time per stored value; Times and Values are parallel.
    SampleCount(self: IrregularTimeSeries): Integer
        => self.Values.Count;

    // The stored sample time.
    TimeAt(self: IrregularTimeSeries, index: Integer): Instant
        => self.Times[index];

    // One time per stored vector.
    SampleCount(self: Vector3DTimeSeries): Integer
        => self.Values.Count;

    // Start advanced by index whole sample periods.
    TimeAt(self: Vector3DTimeSeries, index: Integer): Instant
        => self.Start + self.SamplePeriod * index.ToNumber;

    // One time per logged occurrence; Times and Labels are parallel.
    SampleCount(self: EventLog): Integer
        => self.Times.Count;

    // The time of the logged occurrence.
    TimeAt(self: EventLog, index: Integer): Instant
        => self.Times[index];
}
