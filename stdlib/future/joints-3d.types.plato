//==
// # 3D joints
//
// The spatial joint zoo (hinges, ball-sockets, sliders, welds, ropes,
// springs, pulleys, the configurable six-degree-of-freedom joint, and gear
// coupling) plus the ragdoll wiring that groups them. BodyA and BodyB are
// zero-based indices into the simulation's body array; -1 attaches that side
// to the static world. Anchors, axes, and frames are expressed in the owning
// body's local frame, in meters. (Skeletal animation owns the bare name Bone;
// every type here is *Joint- or *Constraint-suffixed.)

// A one-degree-of-freedom rotational joint (door hinge, wheel axle). The
// bodies rotate relative to each other only about the axis through the
// anchors; AxisA and AxisB are the hinge axis in each body's local frame.
// (https://en.wikipedia.org/wiki/Revolute_joint)
type HingeJoint
    implements Value
{
    BodyA: BodyIndex;
    BodyB: BodyIndex;
    AnchorA: Point3D;
    AnchorB: Point3D;
    AxisA: Direction3D;
    AxisB: Direction3D;
    Limit: AngularLimit;
    Motor: JointMotor;
}

// A three-degree-of-freedom rotational joint (shoulder, hip): the anchors
// coincide while orientation is free. TwistAxisA is the twist reference axis
// in body A's frame; SwingLimit bounds the cone deviation from that axis and
// TwistLimit bounds rotation about it.
// (https://en.wikipedia.org/wiki/Ball_joint)
type BallSocketJoint
    implements Value
{
    BodyA: BodyIndex;
    BodyB: BodyIndex;
    AnchorA: Point3D;
    AnchorB: Point3D;
    TwistAxisA: Direction3D;
    SwingLimit: AngularLimit;
    TwistLimit: AngularLimit;
}

// A one-degree-of-freedom translational joint (piston): the bodies slide
// along AxisA with relative rotation locked.
// (https://en.wikipedia.org/wiki/Prismatic_joint)
type SliderJoint
    implements Value
{
    BodyA: BodyIndex;
    BodyB: BodyIndex;
    AnchorA: Point3D;
    AnchorB: Point3D;
    AxisA: Direction3D;
    Limit: LinearLimit;
    Motor: JointMotor;
}

// A joint that locks all six degrees of freedom, welding two bodies into one
// rigid assembly. RelativePose is body B's pose expressed in body A's frame.
type FixedJoint
    implements Value
{
    BodyA: BodyIndex;
    BodyB: BodyIndex;
    RelativePose: Pose3D;
}

// A joint that keeps the distance between two anchor points within
// [MinLength, MaxLength] (a rope when MinLength is zero, a rod when the
// bounds are equal).
type DistanceJoint
    implements Value
{
    BodyA: BodyIndex;
    BodyB: BodyIndex;
    AnchorA: Point3D;
    AnchorB: Point3D;
    MinLength: Length;
    MaxLength: Length;
}

// A damped spring between two anchor points: it exerts force
// -Stiffness * (length - RestLength) - Damping * lengthRate along the line
// between the anchors.
// (https://en.wikipedia.org/wiki/Hooke%27s_law)
type SpringJoint
    implements Value
{
    BodyA: BodyIndex;
    BodyB: BodyIndex;
    AnchorA: Point3D;
    AnchorB: Point3D;
    RestLength: Length;
    Stiffness: Stiffness;
    Damping: DampingCoefficient;
}

// An idealized rope over two pulleys: lengthA + Ratio * lengthB stays
// constant, where lengthA runs from GroundAnchorA (world space) to AnchorA
// and lengthB from GroundAnchorB to AnchorB. Ratio is dimensionless.
// (https://en.wikipedia.org/wiki/Pulley)
type PulleyJoint
    implements Value
{
    BodyA: BodyIndex;
    BodyB: BodyIndex;
    GroundAnchorA: Point3D;
    GroundAnchorB: Point3D;
    AnchorA: Point3D;
    AnchorB: Point3D;
    Ratio: Number;
}

// A configurable six-degree-of-freedom joint: each translational axis of the
// joint frames carries a linear limit (meters) and each rotational axis an
// angular limit. FrameA and FrameB are the joint frames in each body's local
// frame.
// (https://en.wikipedia.org/wiki/Degrees_of_freedom_(mechanics))
type GenericJoint
    implements Value
{
    BodyA: BodyIndex;
    BodyB: BodyIndex;
    FrameA: Pose3D;
    FrameB: Pose3D;
    LinearX: LinearLimit;
    LinearY: LinearLimit;
    LinearZ: LinearLimit;
    AngularX: AngularLimit;
    AngularY: AngularLimit;
    AngularZ: AngularLimit;
}

// A velocity coupling between two rotational axes (gear train): body B's
// angular velocity about AxisB is -Ratio times body A's about AxisA. Ratio is
// the dimensionless gear ratio; the axes are in each body's local frame.
// (https://en.wikipedia.org/wiki/Gear_train)
type GearConstraint
    implements Value
{
    BodyA: BodyIndex;
    BodyB: BodyIndex;
    AxisA: Direction3D;
    AxisB: Direction3D;
    Ratio: Number;
}

//==
// # Joint groupings

// A reusable articulated-figure wiring: the joints connecting a ragdoll's
// limbs. Body indices inside the joints refer to the ragdoll's own body
// array; BreakThresholds, when non-empty, applies one threshold per joint in
// declaration order (hinges first, then ball-sockets, then fixed).
// (https://en.wikipedia.org/wiki/Ragdoll_physics)
type RagdollProfile
    implements Value
{
    HingeJoints: Array<HingeJoint>;
    BallSocketJoints: Array<BallSocketJoint>;
    FixedJoints: Array<FixedJoint>;
    BreakThresholds: Array<JointBreakThreshold>;
}
