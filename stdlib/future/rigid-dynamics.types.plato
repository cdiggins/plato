//==
// # Rigid dynamics
//
// Sections, in order:
//  - Rigid-body dynamics
//  - Forces, impulses, and gravitation
//  - The solver view of a body
//  - Simulation worlds

//==
// # Rigid-body dynamics
//
// Mass properties, rigid-body state, surface materials, and simulation
// stepping parameters. Linear quantities are in meters, kilograms, and
// seconds; angular quantities are in radians.

// A zero-based index of a body within an external body array (the simulation
// world's body list). -1 means "none" / "the static environment".
type BodyIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

//==
// # Motion kind and mass properties

// How a body participates in dynamics: never moves (Static), is moved
// externally and treated as infinitely massive (Kinematic), or integrates
// forces and impulses (Dynamic).
type BodyMotion = Static | Kinematic | Dynamic;

// The inertial properties of a planar rigid body: total mass, center of mass
// in the body's local frame (meters), and the scalar moment of inertia about
// the out-of-plane axis through the center of mass.
// (https://en.wikipedia.org/wiki/Center_of_mass)
type MassProperties2D
    implements IValue
{
    Mass: Mass;
    CenterOfMass: Point2D;
    MomentOfInertia: MomentOfInertia;
}

// The inertial properties of a spatial rigid body: total mass, center of mass
// in the body's local frame (meters), and the inertia tensor about the center
// of mass in body space, in kilogram-square-meters.
// (https://en.wikipedia.org/wiki/Moment_of_inertia)
type MassProperties3D
    implements IValue
{
    Mass: Mass;
    CenterOfMass: Point3D;
    InertiaTensor: SymmetricMatrix3x3;
}

//==
// # Rigid bodies

// A planar rigid body. LinearVelocity is in meters per second; LinearDamping
// and AngularDamping are exponential velocity decay rates in units of one per
// second (0 = none); GravityScale is a dimensionless multiplier on world
// gravity (1 = normal, 0 = unaffected).
type RigidBody2D
    implements IValue
{
    Pose: Pose2D;
    LinearVelocity: Vector2D;
    AngularVelocity: AngularVelocity;
    MassProperties: MassProperties2D;
    Motion: BodyMotion;
    LinearDamping: Number;
    AngularDamping: Number;
    GravityScale: Number;
}

// A spatial rigid body. LinearVelocity is in meters per second;
// AngularVelocity is in radians per second about each world axis;
// LinearDamping and AngularDamping are exponential velocity decay rates in
// units of one per second (0 = none); GravityScale is a dimensionless
// multiplier on world gravity (1 = normal, 0 = unaffected).
// (https://en.wikipedia.org/wiki/Rigid_body_dynamics)
type RigidBody3D
    implements IValue
{
    Pose: Pose3D;
    LinearVelocity: Vector3D;
    AngularVelocity: Vector3D;
    MassProperties: MassProperties3D;
    Motion: BodyMotion;
    LinearDamping: Number;
    AngularDamping: Number;
    GravityScale: Number;
}

//==
// # Materials

// How two touching bodies' material coefficients merge into one contact
// coefficient.
type MaterialCombine = Average | Min | Max | Multiply;

// ISurface response properties of a body. StaticFriction and DynamicFriction
// are dimensionless Coulomb coefficients; Restitution is the bounciness in
// [0, 1]; the combine kinds say how the two touching materials' values merge.
// (https://en.wikipedia.org/wiki/Friction)
type PhysicsMaterial
    implements IValue
{
    StaticFriction: Number;
    DynamicFriction: Number;
    Restitution: Proportion;
    FrictionCombine: MaterialCombine;
    RestitutionCombine: MaterialCombine;
}

//==
// # Simulation settings

// When a dynamic body is allowed to fall asleep: both velocity magnitudes
// must stay below their thresholds for at least TimeToSleep.
type SleepSettings
    implements IValue
{
    LinearThreshold: Speed;
    AngularThreshold: AngularVelocity;
    TimeToSleep: Duration;
    Enabled: Boolean;
}

// Fixed-step integration parameters: the fixed step FixedDeltaTime is divided
// into Substeps sub-integrations; VelocityIterations and PositionIterations
// are constraint solver iteration counts; MaxStepsPerFrame caps catch-up
// stepping when the render frame runs long.
type TimeStepSettings
    implements IValue
{
    FixedDeltaTime: Duration;
    Substeps: Integer;
    VelocityIterations: Integer;
    PositionIterations: Integer;
    MaxStepsPerFrame: Integer;
}

//==
// # Forces, impulses, and gravitation
//
// What acts on a rigid body: forces and impulses applied at a point, radial
// blasts, the environmental force models (gravity, drag, buoyancy), and the
// Keplerian elements describing the orbit a point gravity produces. Forces
// are in newtons, impulses in newton-seconds, and positions in meters.

//==
// # Applied forces and impulses

// A force applied to a planar body: the force in newtons and the world-space
// point of application in meters.
type AppliedForce2D
    implements IValue
{
    Force: Vector2D;
    ApplicationPoint: Point2D;
}

// A force applied to a spatial body: the force in newtons and the world-space
// point of application in meters.
type AppliedForce3D
    implements IValue
{
    Force: Vector3D;
    ApplicationPoint: Point3D;
}

// An instantaneous impulse applied to a planar body: the impulse in
// newton-seconds and the world-space point of application in meters.
type AppliedImpulse2D
    implements IValue
{
    Impulse: Vector2D;
    ApplicationPoint: Point2D;
}

// An instantaneous impulse applied to a spatial body: the impulse in
// newton-seconds and the world-space point of application in meters.
// (https://en.wikipedia.org/wiki/Impulse_(physics))
type AppliedImpulse3D
    implements IValue
{
    Impulse: Vector3D;
    ApplicationPoint: Point3D;
}

// An outward radial impulse (explosion): bodies within Radius of Center
// receive an impulse of up to Magnitude directed away from Center, falling
// off linearly to zero at Radius.
type RadialImpulse3D
    implements IValue
{
    Center: Point3D;
    Magnitude: Impulse;
    Radius: Length;
}

//==
// # Environmental force models

// Uniform planar gravity: the same acceleration, in meters per second
// squared, applied to every dynamic body regardless of position.
type UniformGravity2D
    implements IValue, IForceModel2D
{
    Acceleration: Vector2D;
}

// Uniform spatial gravity: the same acceleration, in meters per second
// squared, applied to every dynamic body regardless of position. World space is
// Z-up here, so downward gravity is negative on Z — `UniformGravity3D.Earth` in
// `rigid-dynamics.library.plato` is the value to reach for.
// Convention: see CONVENTIONS.md - World space
type UniformGravity3D
    implements IValue, IForceModel3D
{
    Acceleration: Vector3D;
}

// Newtonian point gravity: bodies are attracted toward Center with
// acceleration mu / r^2. GravitationalParameter is mu = G * M in cubic meters
// per second squared.
// (https://en.wikipedia.org/wiki/Newton%27s_law_of_universal_gravitation)
type PointGravity
    implements IValue, IForceModel3D
{
    Center: Point3D;
    GravitationalParameter: Number;
}

// A drag force opposing velocity: force = -(LinearCoefficient * v +
// QuadraticCoefficient * |v| * v). LinearCoefficient is in newton-seconds per
// meter; QuadraticCoefficient is in newton-seconds-squared per square meter.
// (https://en.wikipedia.org/wiki/Drag_(physics))
type DragModel
    implements IValue, IForceModel3D
{
    LinearCoefficient: Number;
    QuadraticCoefficient: Number;
}

// A buoyancy force model for bodies in a liquid half-space. The fluid fills
// everything below SurfaceHeight measured along UpAxis; FluidVelocity is the
// current in meters per second used for relative drag.
// (https://en.wikipedia.org/wiki/Buoyancy)
type BuoyancyModel
    implements IValue
{
    FluidDensity: Density;
    SurfaceHeight: Length;
    UpAxis: Direction3D;
    FluidVelocity: Vector3D;
}

//==
// # Orbits

// The six classical Keplerian orbital elements. Eccentricity is
// dimensionless (0 = circular, less than 1 = elliptic, 1 = parabolic,
// greater than 1 = hyperbolic); the four angles are in radians.
// (https://en.wikipedia.org/wiki/Orbital_elements)
type OrbitalElements
    implements IValue
{
    SemiMajorAxis: Length;
    Eccentricity: Number;
    Inclination: Angle;
    LongitudeOfAscendingNode: Angle;
    ArgumentOfPeriapsis: Angle;
    TrueAnomaly: Angle;
}

//==
// # The solver view of a body
//
// `RigidBody3D` is the AUTHORING record: it names a material-facing mass, an
// inertia tensor about the centre of mass, a motion kind, and damping rates. The
// integrator and the contact solver want none of that spelling. They want, per
// body, the quantities that appear in an impulse: where the centre of mass is,
// how it is oriented, how fast it is going, and how much velocity one
// newton-second of impulse buys. `SolverBody3D` is that reading of a
// `RigidBody3D` — derived from it by `SolverBody`, never a second authoring
// vocabulary.
//
// Two things collapse in the translation, and both are deliberate:
//
//   * MOTION KIND BECOMES ZERO. A `Static` or `Kinematic` body is a body with
//     `InverseMass` and `InverseInertia` of zero: an impulse changes nothing.
//     The solver then has no case analysis at all, and no branch that a static
//     body could take by accident.
//   * THE INERTIA TENSOR BECOMES ITS PRINCIPAL DIAGONAL. Every primitive whose
//     inertia this library computes is diagonal in its own frame, so the world
//     inverse inertia never has to be assembled or inverted as a full matrix:
//     `I^-1 t` is a rotation into the body frame, three multiplies, and a
//     rotation back (`AngularResponse` in `rigid-dynamics.library.plato`). A body
//     whose tensor is genuinely non-diagonal must be given in its principal frame
//     first (`PrincipalInertia`), which is where that approximation is stated.

// One body as the integrator and the contact solver read it: field for field a
// `RigidBody3D` with the two things a solver cannot use — the motion kind and the
// inertia tensor — replaced by the two it can: a zeroable inverse mass, and the
// reciprocals of the three principal moments.
//
// Center is the world position of the centre of mass, in meters; Orientation maps
// the body's PRINCIPAL axes onto world axes; Velocity is the world-frame twist
// ABOUT THE CENTRE OF MASS (linear in meters per second, angular in radians per
// second); InverseMass is in reciprocal kilograms and InverseInertia holds the
// reciprocals of the three principal moments, in reciprocal
// kilogram-square-meters, with zero in either meaning "immovable in that
// respect"; LinearDamping and AngularDamping are the exponential velocity decay
// rates of the authoring record, in units of one per second; GravityScale is its
// dimensionless gravity multiplier.
type SolverBody3D
    implements IValue
{
    Center: Point3D;
    Orientation: Quaternion;
    Velocity: SpatialVelocity3D;
    InverseMass: Number;
    InverseInertia: Vector3D;
    LinearDamping: Number;
    AngularDamping: Number;
    GravityScale: Number;
}

// The knobs of the contact solver, separate from `TimeStepSettings` because they
// govern the QUALITY of a contact rather than the cadence of the step.
// PenetrationSlop is the overlap deliberately left uncorrected, so a resting
// stack settles instead of hunting about exact touching; BaumgarteFactor is the
// fraction of the remaining overlap the position pass removes per step, in
// [0, 1], where 0 disables positional correction entirely; MaxCorrectionSpeed
// caps the correction so a deep initial overlap cannot fling a body across the
// scene; RestitutionThreshold is the approach speed below which a collision does
// not bounce at all, which is what stops a settling body from buzzing on the
// floor.
//
// The correction these describe is applied as a SEPARATE pseudo-velocity pass
// (`SolvePositions` in `rigid-dynamics.library.plato`), not as a bias inside the
// velocity solve. Why that matters is argued there.
// (https://en.wikipedia.org/wiki/Constraint_(computational_chemistry))
type ContactSolverSettings
    implements IValue
{
    PenetrationSlop: Length;
    BaumgarteFactor: Number;
    MaxCorrectionSpeed: Speed;
    RestitutionThreshold: Speed;
}

//==
// # Simulation worlds
//
// The whole state one fixed step reads and rewrites. A step is a pure function
// `RigidWorld3D -> RigidWorld3D`; nothing else is threaded, and nothing outside
// the record changes.

// A simulation island: the bodies, the contact rows standing between them,
// uniform gravity in meters per second squared, and the two settings blocks.
// Constraints index into Bodies by their BodyA / BodyB fields; a row naming an
// index outside the array is ill-formed rather than "attached to the world" —
// the static world is an ordinary body with zero inverse mass.
//
// The constraint array is part of the state because sequential impulses ACCUMULATE
// into it: the impulse a row carries out of one step is the warm start of the
// next (`WarmStartFrom`), and discarding it between frames is exactly what makes
// a stack of boxes sink and jitter.
type RigidWorld3D
    implements IValue
{
    Bodies: Array<SolverBody3D>;
    Constraints: Array<ContactConstraint3D>;
    Gravity: Vector3D;
    TimeStep: TimeStepSettings;
    Solver: ContactSolverSettings;
}
