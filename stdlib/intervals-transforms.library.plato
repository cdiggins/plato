//==
// # IntervalsTransforms — derived functionality for intervals, bounds, and transforms
//
// Implements P4 of the concept library: pure, expression-bodied helpers for the
// concepts declared in `12-intervals-bounds.plato` (IntervalLike, BoundsLike) and
// `13-transforms.plato` (Transformable, Deformable2D, Deformable3D).
//
// Design notes on the concept surface:
//   * IntervalLike<T> now bounds T to (Additive + Interpolatable + Comparable) —
//     every concrete instance (Number, Angle, Length, Integer) satisfies it, and
//     those are the only capabilities used on T here.
//   * BoundsLike<TPoint, TDelta> now carries a delta type (TDelta = the vector of
//     TPoint, via TPoint: Difference<TDelta>), so Extent/Diagonal are expressible.
//     Contains/Union/Intersection/Clamp still are not: they need component-wise
//     Min/Max (a Lattice) on TPoint, which the point types do not implement.
//   * Directed intervals: Contains/Overlaps/Union/Intersection/Clamp assume the
//     forward orientation Start <= End. Use IsForward to test, Reverse to fix.

library IntervalsTransforms
{
    //==
    // IntervalLike<T> — a directed one-dimensional span from Start to End.
    // T is used only through Additive (Add/Subtract), Interpolatable (Lerp), and
    // Comparable (LessThanOrEquals / Lesser / Greater / Clamp), the capabilities
    // shared by every concrete interval element type (Number, Angle, Length,
    // Integer). The comparison helpers (Lesser/Greater/Clamp) come from P1
    // (01-core-algebra), which derives them for any Orderable. The concept now
    // states the bound explicitly: IntervalLike<T> where T: Additive,
    // Interpolatable, Comparable.

    // The signed span from Start to End (End - Start); negative for a reversed
    // interval. Replaces v1 `Size`, which read ambiguously against area/volume.
    Extent(self: IntervalLike<$T>): $T
        => self.End.Subtract(self.Start);

    // True when the interval is stored in forward orientation (Start <= End).
    IsForward(self: IntervalLike<$T>): Boolean
        => self.Start.LessThanOrEquals(self.End);

    // True when the interval is stored reversed (Start > End).
    IsReversed(self: IntervalLike<$T>): Boolean
        => self.IsForward.Not;

    // The point a fraction `t` of the way from Start to End. t is unclamped:
    // 0 yields Start, 1 yields End, values outside [0,1] extrapolate.
    Lerp(self: IntervalLike<$T>, t: Number): $T
        => self.Start.Lerp(self.End, t);

    // The midpoint of the interval.
    Center(self: IntervalLike<$T>): $T
        => self.Lerp(0.5);

    // True when `value` lies within the closed interval [Start, End] (both
    // endpoints inclusive). Assumes forward orientation; Reverse a reversed span.
    Contains(self: IntervalLike<$T>, value: $T): Boolean
        => self.Start <= value && value <= self.End;

    // True when `other` lies entirely within this closed interval (endpoints
    // inclusive). Forward orientation on both.
    ContainsInterval(self: IntervalLike<$T>, other: IntervalLike<$T>): Boolean
        => self.Contains(other.Start) && self.Contains(other.End);

    // True when the two closed intervals share any point, endpoints inclusive
    // (touching at a single endpoint counts). Closed-form; assumes forward
    // orientation on both.
    Overlaps(self: IntervalLike<$T>, other: IntervalLike<$T>): Boolean
        => self.Start <= other.End && other.Start <= self.End;

    // Restrict `value` to the closed interval [Start, End]. Assumes forward
    // orientation. Uses P1's Clamp(Orderable, lower, upper).
    Clamp(self: IntervalLike<$T>, value: $T): $T
        => value.Clamp(self.Start, self.End);

    // The smallest interval containing both operands (the convex hull of the two).
    // Forward orientation: start at the lesser start, end at the greater end.
    Union(self: IntervalLike<$T>, other: IntervalLike<$T>): IntervalLike<$T>
        => (self.Start.Lesser(other.Start), self.End.Greater(other.End));

    // The overlapping interval common to both. Forward orientation: start at the
    // greater start, end at the lesser end. Empty (Start > End) when they are
    // disjoint — test with IsForward.
    Intersection(self: IntervalLike<$T>, other: IntervalLike<$T>): IntervalLike<$T>
        => (self.Start.Greater(other.Start), self.End.Lesser(other.End));

    // The same span traversed in the opposite direction (End becomes Start).
    Reverse(self: IntervalLike<$T>): IntervalLike<$T>
        => (self.End, self.Start);

    // The interval shifted so it starts at `start`, keeping the same extent.
    // Renamed from v1 `MoveTo` for clarity about which endpoint anchors.
    StartAt(self: IntervalLike<$T>, start: $T): IntervalLike<$T>
        => (start, start.Add(self.Extent));

    // The interval translated by `delta`, moving both endpoints together.
    Translate(self: IntervalLike<$T>, delta: $T): IntervalLike<$T>
        => (self.Start.Add(delta), self.End.Add(delta));

    // The interval grown symmetrically by `amount` at each end (negative shrinks).
    // Replaces the v1 `Recenter`/half-extent dance, which needed scalar division.
    Grow(self: IntervalLike<$T>, amount: $T): IntervalLike<$T>
        => (self.Start.Subtract(amount), self.End.Add(amount));

    // The leading sub-span from Start up to fraction `t`. Renamed from v1 `Left`,
    // which was ambiguous for a directed span.
    Prefix(self: IntervalLike<$T>, t: Number): IntervalLike<$T>
        => (self.Start, self.Lerp(t));

    // The trailing sub-span from fraction `t` to End. Renamed from v1 `Right`.
    Suffix(self: IntervalLike<$T>, t: Number): IntervalLike<$T>
        => (self.Lerp(t), self.End);

    // The first half of the interval.
    FirstHalf(self: IntervalLike<$T>): IntervalLike<$T>
        => self.Prefix(0.5);

    // The second half of the interval.
    SecondHalf(self: IntervalLike<$T>): IntervalLike<$T>
        => self.Suffix(0.5);

    // The sub-interval covering fractions `startFraction`..`endFraction` of this one.
    Subinterval(self: IntervalLike<$T>, startFraction: Number, endFraction: Number): IntervalLike<$T>
        => (self.Lerp(startFraction), self.Lerp(endFraction));

    // Split at fraction `t` into the leading and trailing sub-spans.
    SplitAt(self: IntervalLike<$T>, t: Number): Tuple2<IntervalLike<$T>, IntervalLike<$T>>
        => (self.Prefix(t), self.Suffix(t));

    // Split into two equal halves.
    Split(self: IntervalLike<$T>): Tuple2<IntervalLike<$T>, IntervalLike<$T>>
        => self.SplitAt(0.5);

    // TODO(concept-gap): Normalize (inverse Lerp: value -> fraction) is not
    // derivable here — it needs T/T division, which only Number supports among the
    // interval element types (Angle/Length/Integer are not Divisible by Self).
    // The NumberInterval-specialized ParameterOf below fills exactly this gap.

    //==
    // NumberInterval — the remap primitive (item 466).
    // The generic IntervalLike surface above gives every interval Lerp/Clamp/Extent,
    // but the inverse map (value -> parameter) needs T/T division, which only Number
    // supports. NumberInterval therefore carries the three-function remap kit
    // At / ParameterOf / Clamp; item 210's Remap composes the first two across a
    // pair of intervals. Clamp(interval, value) is already inherited generically from
    // IntervalLike (see above), so it is not re-declared here (LIBRARIES.md rule 11).

    // The value a fraction `t` of the way from Start to End (forward lerp). The
    // remap-primitive spelling of the inherited IntervalLike.Lerp; 0 yields Start,
    // 1 yields End, and t outside [0,1] extrapolates.
    At(self: NumberInterval, t: Number): Number
        => self.Lerp(t);

    // The parameter `t` for which At(self, t) equals `x` (inverse lerp): maps `x`
    // from [Start, End] back onto the unitless fraction line, so Start -> 0 and
    // End -> 1. Precondition: Start != End (a zero-width interval has no inverse).
    ParameterOf(self: NumberInterval, x: Number): Number
        => self.Start.InverseLerp(self.End, x);

    // Remap `x` from the `from` interval onto the `to` interval: the two-inverse-lerp
    // composition At(to, ParameterOf(from, x)) (item 210). Every shader/UI/animation
    // normalized-coordinate remap is this one call. Precondition: from is not
    // zero-width. Unclamped — pass x within `from`, or Clamp first, to stay inside `to`.
    Remap(x: Number, from: NumberInterval, to: NumberInterval): Number
        => to.At(from.ParameterOf(x));

    // The overlapping sub-interval common to `a` and `b` (interval intersection,
    // item 4), returned as a concrete NumberInterval so ray-box slab reductions can
    // chain Overlap and read Start/End directly. When the two are disjoint the result
    // is inverted (Start > End) — the empty encoding (Convention: see CONVENTIONS.md -
    // Bounds); test it with IsForward. Specializes the generic IntervalLike.Intersection
    // to the concrete return type.
    Overlap(a: NumberInterval, b: NumberInterval): NumberInterval
        => (a.Start.Greater(b.Start), a.End.Lesser(b.End));

    //==
    // AngleInterval — a directed angular range / arc sweep (items 11, 14).
    // Convention: endpoints are INCLUSIVE and the sweep is the CCW (increasing-angle)
    // arc from Start to End, which MAY cross the +/-pi seam — an arc from 170 deg to
    // -170 deg is the short 20 deg sweep across the seam, not the long way round. The
    // wrap-aware helpers below reduce every offset into [0, one turn) via Angle.Wrap
    // (angles.library.plato) before comparing, so they are stable across the seam,
    // unlike the generic linear IntervalLike.Contains/Extent (which read Start<=End
    // literally and are only correct for non-wrapping ranges). Union/Intersection are
    // deliberately NOT specialized for angular ranges: the union of two circular arcs
    // is not always an arc, so no sound closed form exists on this type; consumers
    // that need a set operation must work in the reduced [0, tau) parameter space.

    // The CCW angular width of the arc, reduced to [0, one turn). Unlike the generic
    // Extent (raw End - Start, which can be negative or exceed a turn), Span is the
    // seam-stable sweep magnitude: a full-turn arc (Start == End) reads as 0.
    Span(self: AngleInterval): Angle
        => self.End.Subtract(self.Start).Wrap(1.0.Turns);

    // True when `a` lies on the CCW arc from Start to End, endpoints inclusive and
    // seam-crossing handled: `a`'s CCW offset from Start (reduced to [0, one turn))
    // must not exceed the arc's Span. Correct across the +/-pi seam, where the linear
    // IntervalLike.Contains is not.
    Contains(self: AngleInterval, a: Angle): Boolean
        => a.Subtract(self.Start).Wrap(1.0.Turns) <= self.End.Subtract(self.Start).Wrap(1.0.Turns);

    //==
    // BoundsLike<TPoint, TDelta> — an axis-aligned region between corner points
    // Min and Max, with TDelta the displacement type (TPoint: Difference<TDelta>).
    // TPoint's instances (Point2D/3D/4D) are Coordinate (=> Interpolatable) and
    // Difference, but NOT Orderable/Lattice.

    // The center point of the region. Uses P1's MidPoint(Interpolatable).
    Center(self: BoundsLike<$TPoint, $TDelta>): $TPoint
        => self.Min.MidPoint(self.Max);

    // The point a fraction `t` of the way along the Min -> Max diagonal. t is
    // unclamped. For per-axis interpolation use a point-typed parameter once the
    // concept exposes component access (see the note below).
    Lerp(self: BoundsLike<$TPoint, $TDelta>, t: Number): $TPoint
        => self.Min.Lerp(self.Max, t);

    // The displacement spanning the region: Max - Min (the Min -> Max diagonal
    // vector). Now expressible via TPoint: Difference<TDelta>.
    Extent(self: BoundsLike<$TPoint, $TDelta>): $TDelta
        => self.Min.Between(self.Max);

    // The Min -> Max diagonal displacement; a named alias for Extent.
    Diagonal(self: BoundsLike<$TPoint, $TDelta>): $TDelta
        => self.Extent;

    // Not derivable GENERICALLY here: Contains(point|bounds), Union, Intersection,
    // Expand, and corner enumeration need component-wise Min/Max (a Lattice) on
    // TPoint, which Point2D/Point3D do not implement. They ARE expressible on the
    // CONCRETE Bounds2D/Bounds3D via per-axis (X/Y/Z) field access, so the mirror of
    // the IntervalLike surface is written concretely below (items 29, 185). Making the
    // point types Lattice/Clampable would let it collapse back to one generic body.

    //==
    // Bounds2D / Bounds3D — concrete AABB operations (items 29, 185, 186, 188).
    // Convention: bounds are INCLUSIVE on Min and Max; an inverted box (Min greater
    // than Max on any axis) is EMPTY and is the identity for Union — this is what makes
    // "grow from Empty()" correct (Convention: see CONVENTIONS.md - Bounds). Endpoints
    // reached via the Number Min/Max lattice ops, exactly as BoundsOfPoints does.

    // The canonical empty box: Min at +infinity, Max at -infinity, so it contains no
    // point and is absorbed by Union with any real box (item 186, the empty sentinel).
    Empty(_: Bounds2D): Bounds2D
        => (Point2D(Number.MaxValue, Number.MaxValue), Point2D(Number.MinValue, Number.MinValue));

    // True when the box is empty (inverted on either axis): no point lies inside.
    IsEmpty(self: Bounds2D): Boolean
        => self.Min.X > self.Max.X || self.Min.Y > self.Max.Y;

    // True when `p` lies within the closed box [Min, Max] on every axis (inclusive).
    Contains(self: Bounds2D, p: Point2D): Boolean
        => self.Min.X <= p.X && p.X <= self.Max.X
        && self.Min.Y <= p.Y && p.Y <= self.Max.Y;

    // True when `other` lies entirely within this box (both its corners inside).
    Contains(self: Bounds2D, other: Bounds2D): Boolean
        => self.Contains(other.Min) && self.Contains(other.Max);

    // True when the two boxes share any point (closed overlap on every axis).
    Overlaps(self: Bounds2D, other: Bounds2D): Boolean
        => self.Min.X <= other.Max.X && other.Min.X <= self.Max.X
        && self.Min.Y <= other.Max.Y && other.Min.Y <= self.Max.Y;

    // The smallest box containing both operands (component-wise Min of mins, Max of
    // maxs). Union with Empty() returns the other operand unchanged.
    Union(self: Bounds2D, other: Bounds2D): Bounds2D
        => (Point2D(self.Min.X.Min(other.Min.X), self.Min.Y.Min(other.Min.Y)),
            Point2D(self.Max.X.Max(other.Max.X), self.Max.Y.Max(other.Max.Y)));

    // The box grown to also contain `p` (the grow-from-Empty accumulation step).
    Union(self: Bounds2D, p: Point2D): Bounds2D
        => (Point2D(self.Min.X.Min(p.X), self.Min.Y.Min(p.Y)),
            Point2D(self.Max.X.Max(p.X), self.Max.Y.Max(p.Y)));

    // The box grown outward by `amount` on every side (negative shrinks / can empty it).
    Expand(self: Bounds2D, amount: Number): Bounds2D
        => (Point2D(self.Min.X - amount, self.Min.Y - amount),
            Point2D(self.Max.X + amount, self.Max.Y + amount));

    // The canonical empty box in 3D: Min at +infinity, Max at -infinity (item 186).
    Empty(_: Bounds3D): Bounds3D
        => (Point3D(Number.MaxValue, Number.MaxValue, Number.MaxValue),
            Point3D(Number.MinValue, Number.MinValue, Number.MinValue));

    // True when the box is empty (inverted on any axis).
    IsEmpty(self: Bounds3D): Boolean
        => self.Min.X > self.Max.X || self.Min.Y > self.Max.Y || self.Min.Z > self.Max.Z;

    // True when `p` lies within the closed box [Min, Max] on every axis (inclusive).
    Contains(self: Bounds3D, p: Point3D): Boolean
        => self.Min.X <= p.X && p.X <= self.Max.X
        && self.Min.Y <= p.Y && p.Y <= self.Max.Y
        && self.Min.Z <= p.Z && p.Z <= self.Max.Z;

    // True when `other` lies entirely within this box (both its corners inside).
    Contains(self: Bounds3D, other: Bounds3D): Boolean
        => self.Contains(other.Min) && self.Contains(other.Max);

    // True when the two boxes share any point (closed overlap on every axis).
    Overlaps(self: Bounds3D, other: Bounds3D): Boolean
        => self.Min.X <= other.Max.X && other.Min.X <= self.Max.X
        && self.Min.Y <= other.Max.Y && other.Min.Y <= self.Max.Y
        && self.Min.Z <= other.Max.Z && other.Min.Z <= self.Max.Z;

    // The smallest box containing both operands. Union with Empty() is the identity.
    Union(self: Bounds3D, other: Bounds3D): Bounds3D
        => (Point3D(self.Min.X.Min(other.Min.X), self.Min.Y.Min(other.Min.Y), self.Min.Z.Min(other.Min.Z)),
            Point3D(self.Max.X.Max(other.Max.X), self.Max.Y.Max(other.Max.Y), self.Max.Z.Max(other.Max.Z)));

    // The box grown to also contain `p` (the grow-from-Empty accumulation step).
    Union(self: Bounds3D, p: Point3D): Bounds3D
        => (Point3D(self.Min.X.Min(p.X), self.Min.Y.Min(p.Y), self.Min.Z.Min(p.Z)),
            Point3D(self.Max.X.Max(p.X), self.Max.Y.Max(p.Y), self.Max.Z.Max(p.Z)));

    // The box grown outward by `amount` on every side (negative shrinks / can empty it).
    Expand(self: Bounds3D, amount: Number): Bounds3D
        => (Point3D(self.Min.X - amount, self.Min.Y - amount, self.Min.Z - amount),
            Point3D(self.Max.X + amount, self.Max.Y + amount, self.Max.Z + amount));

    // The circumscribed sphere of the box: centered at the box center with radius
    // half the Min -> Max diagonal length (item 28, the universal AABB-diagonal
    // construction). Reuses the BoundsLike Center/Diagonal declared above; Sphere is
    // declared in spatial-primitives.plato and only constructed here.
    BoundingSphere(self: Bounds3D): Sphere
        => Sphere(self.Center, self.Diagonal.Magnitude.Half);

    // Corner enumeration (item 185) is left out: it needs an 8- (or 4-) element array
    // literal of Point3D/Point2D, and this vocabulary has no array-literal constructor
    // (arrays arrive as function inputs; see geometry.library.plato BoundsOfPoints).
    // Add it once a literal exists, or expose corners lazily via an Indexable.

    //==
    // Transformable<TTransform> — a value that can be carried through a transform.
    // The convenience overloads below are named ThenTransform rather than reusing
    // the concept's `Transform` name: overloading a concept-declared member on arity
    // alone is easy to misread, and ThenTransform states the sequencing intent.

    // Apply two transforms in order: `first` then `second`. A convenience over
    // chaining Transform calls; the concept exposes no transform composition of its
    // own to fold these into a single map.
    ThenTransform(self: Transformable<$TTransform>, first: $TTransform, second: $TTransform): Self
        => self.Transform(first).Transform(second);

    // Apply three transforms in order.
    ThenTransform(self: Transformable<$TTransform>, first: $TTransform, second: $TTransform, third: $TTransform): Self
        => self.Transform(first).Transform(second).Transform(third);

    // Deliberately NOT extended: richer helpers (inverse-transform,
    // transform-about-a-pivot, identity) need Invertible/Composable/Identity on
    // TTransform. Constraining Transformable that way is not sound, because the
    // transform family is not uniformly invertible or composable — the TRS types
    // (Transform2D/Transform3D) are not closed under composition (see
    // transforms.plato) and the projective types expose no inverse. The pivot and
    // identity helpers therefore live per-representation, not on the concept.

    //==
    // Deformable2D — a value reshaped by an arbitrary Point2D -> Point2D mapping.
    // The mapping type is concrete (Function1<Point2D, Point2D>), so these build
    // real Point2D/Vector2D lambdas.

    // Translate every point by `offset`.
    Translate(self: Deformable2D, offset: Vector2D): Self
        => self.Deform(p => p.Add(offset));

    // Uniformly scale about `center` by `factor` (1 leaves the shape unchanged).
    ScaleAbout(self: Deformable2D, center: Point2D, factor: Number): Self
        => self.Deform(p => center.Add(center.Between(p).Multiply(factor)));

    // Non-uniformly scale about `center` by a per-axis `factors` vector.
    ScaleAbout(self: Deformable2D, center: Point2D, factors: Number2): Self
        => self.Deform(p => center.Add(center.Between(p).Multiply(factors)));

    // Rotate every point about `center` by `rotation`.
    RotateAbout(self: Deformable2D, center: Point2D, rotation: Rotation2D): Self
        => self.Deform(p => center.Add(center.Between(p).Transform(rotation)));

    // Rotate every point about `center` by `angle` (counter-clockwise).
    RotateAbout(self: Deformable2D, center: Point2D, angle: Angle): Self
        => self.RotateAbout(center, Rotation2D(angle));

    // Rotate every point about the origin by `angle` (counter-clockwise).
    Rotate(self: Deformable2D, angle: Angle): Self
        => self.RotateAbout(Point2D(0.0, 0.0), angle);

    // Uniformly scale about the origin by `factor`.
    Scale(self: Deformable2D, factor: Number): Self
        => self.ScaleAbout(Point2D(0.0, 0.0), factor);

    // Non-uniformly scale about the origin by a per-axis `factors` vector.
    Scale(self: Deformable2D, factors: Number2): Self
        => self.ScaleAbout(Point2D(0.0, 0.0), factors);

    // Scale about the origin along X only.
    ScaleX(self: Deformable2D, factor: Number): Self
        => self.Scale(Number2(factor, 1.0));

    // Scale about the origin along Y only.
    ScaleY(self: Deformable2D, factor: Number): Self
        => self.Scale(Number2(1.0, factor));

    // Translate along +X by `distance`.
    TranslateX(self: Deformable2D, distance: Number): Self
        => self.Translate(Vector2D.UnitX.Multiply(distance));

    // Translate along +Y by `distance`.
    TranslateY(self: Deformable2D, distance: Number): Self
        => self.Translate(Vector2D.UnitY.Multiply(distance));

    // The ScaleAbout/RotateAbout helpers use Difference.Between(a, b) = b - a,
    // the displacement from a to b. That direction is now the documented contract
    // on the Difference concept (algebra.concepts.plato), so it is relied on here
    // rather than merely assumed.

    // RESOLVED (was TODO(concept-gap): RotateAbout is omitted): rotating a Point2D
    // needed a point-rotation operation, which is now reachable - `library
    // Transforms` in transforms.plato supplies Transform(Vector2D, Rotation2D), and
    // constants.library.plato supplies the axis vectors. RotateAbout/Rotate are
    // implemented above.

    //==
    // Deformable3D — a value reshaped by an arbitrary Point3D -> Point3D mapping.

    // Translate every point by `offset`.
    Translate(self: Deformable3D, offset: Vector3D): Self
        => self.Deform(p => p.Add(offset));

    // Uniformly scale about `center` by `factor`.
    ScaleAbout(self: Deformable3D, center: Point3D, factor: Number): Self
        => self.Deform(p => center.Add(center.Between(p).Multiply(factor)));

    // Non-uniformly scale about `center` by a per-axis `factors` vector.
    ScaleAbout(self: Deformable3D, center: Point3D, factors: Number3): Self
        => self.Deform(p => center.Add(center.Between(p).Multiply(factors)));

    // Rotate every point about `center` by `rotation`.
    RotateAbout(self: Deformable3D, center: Point3D, rotation: Quaternion): Self
        => self.Deform(p => center.Add(center.Between(p).Transform(rotation)));

    // Rotate every point about the origin by `rotation`.
    Rotate(self: Deformable3D, rotation: Quaternion): Self
        => self.RotateAbout(Point3D(0.0, 0.0, 0.0), rotation);

    // Rotate about the world X axis through the origin.
    RotateX(self: Deformable3D, angle: Angle): Self
        => self.Rotate(Quaternion.CreateRotationX(angle));

    // Rotate about the world Y axis through the origin.
    RotateY(self: Deformable3D, angle: Angle): Self
        => self.Rotate(Quaternion.CreateRotationY(angle));

    // Rotate about the world Z axis through the origin.
    RotateZ(self: Deformable3D, angle: Angle): Self
        => self.Rotate(Quaternion.CreateRotationZ(angle));

    // Uniformly scale about the origin by `factor`.
    Scale(self: Deformable3D, factor: Number): Self
        => self.ScaleAbout(Point3D(0.0, 0.0, 0.0), factor);

    // Non-uniformly scale about the origin by a per-axis `factors` vector.
    Scale(self: Deformable3D, factors: Number3): Self
        => self.ScaleAbout(Point3D(0.0, 0.0, 0.0), factors);

    // Scale about the origin along X only.
    ScaleX(self: Deformable3D, factor: Number): Self
        => self.Scale(Number3(factor, 1.0, 1.0));

    // Scale about the origin along Y only.
    ScaleY(self: Deformable3D, factor: Number): Self
        => self.Scale(Number3(1.0, factor, 1.0));

    // Scale about the origin along Z only.
    ScaleZ(self: Deformable3D, factor: Number): Self
        => self.Scale(Number3(1.0, 1.0, factor));

    // Translate along +X by `distance`.
    TranslateX(self: Deformable3D, distance: Number): Self
        => self.Translate(Vector3D.UnitX.Multiply(distance));

    // Translate along +Y by `distance`.
    TranslateY(self: Deformable3D, distance: Number): Self
        => self.Translate(Vector3D.UnitY.Multiply(distance));

    // Translate along +Z by `distance`.
    TranslateZ(self: Deformable3D, distance: Number): Self
        => self.Translate(Vector3D.UnitZ.Multiply(distance));

    //==
    // Deform implies Transform - the legacy insight
    // (stdlib-legacy/meshes.library.plato:84) generalized to every transform
    // representation. `library Transforms` in transforms.plato already applies each
    // representation to a bare Point2D/Point3D; lifting that point map through
    // Deform gives EVERY deformable type a complete transform surface from its
    // single Deform primitive. Implementing Deform for a new shape therefore also
    // satisfies Transformable<T> for all thirteen T below.

    // Rotate a 2D shape about the origin.
    Transform(self: Deformable2D, transform: Rotation2D): Self
        => self.Deform(p => p.Transform(transform));

    // Rotate a 2D shape about the origin with a rotor.
    Transform(self: Deformable2D, transform: Rotor2D): Self
        => self.Deform(p => p.Transform(transform));

    // Apply a rigid 2D placement (rotate, then translate).
    Transform(self: Deformable2D, transform: Pose2D): Self
        => self.Deform(p => p.Transform(transform));

    // Apply a 2D TRS transform (scale, rotate, then translate).
    Transform(self: Deformable2D, transform: Transform2D): Self
        => self.Deform(p => p.Transform(transform));

    // Apply a general 2D affine map.
    Transform(self: Deformable2D, transform: AffineTransform2D): Self
        => self.Deform(p => p.Transform(transform));

    // Apply a 2D homography. Precondition: no point of the shape maps onto the
    // line at infinity.
    Transform(self: Deformable2D, transform: ProjectiveTransform2D): Self
        => self.Deform(p => p.Transform(transform));

    // Rotate a 3D shape about the origin.
    Transform(self: Deformable3D, transform: Quaternion): Self
        => self.Deform(p => p.Transform(transform));

    // Rotate a 3D shape about the origin with a rotor.
    Transform(self: Deformable3D, transform: Rotor3D): Self
        => self.Deform(p => p.Transform(transform));

    // Apply a rigid 3D placement (rotate, then translate).
    Transform(self: Deformable3D, transform: Pose3D): Self
        => self.Deform(p => p.Transform(transform));

    // Apply a rigid motion in motor (dual-quaternion) form.
    Transform(self: Deformable3D, transform: Motor3D): Self
        => self.Deform(p => p.Transform(transform));

    // Apply a 3D TRS transform (scale, rotate, then translate).
    Transform(self: Deformable3D, transform: Transform3D): Self
        => self.Deform(p => p.Transform(transform));

    // Apply a general 3D affine map.
    Transform(self: Deformable3D, transform: AffineTransform3D): Self
        => self.Deform(p => p.Transform(transform));

    // Apply a 3D homography. Precondition: no point of the shape maps onto the
    // plane at infinity.
    Transform(self: Deformable3D, transform: ProjectiveTransform3D): Self
        => self.Deform(p => p.Transform(transform));

    // TODO(follow-up): the concrete per-type `Deform` bodies (Line2D/3D, Ray2D/3D,
    // Triangle2D/3D, Quad2D/3D, Circle, Ellipse, Polygon2D/3D, Polyline2D/3D,
    // RegularPolygon, PolygonWithHoles2D, Tetrahedron, and the mesh types) are the
    // remaining half of this item. They are one-liners over each type's fields
    // (see stdlib-legacy/meshes.library.plato:49-75) but belong to the packages that
    // own those declarations, so they are not written here.

    // RESOLVED (was TODO(concept-gap): RotateAbout is omitted for the same reason as
    // Deformable2D): the Transform(Vector3D, Quaternion) intrinsic rotates the pivot
    // displacement directly, so RotateAbout/Rotate/RotateX/Y/Z are implemented above.
}
