//==
// # FunctionalProcedural
//
// Derived functionality for the function-like concepts
// (`functional.concepts.plato`): batch evaluation, bijection round trips, and
// the accessors over a preferred parameter domain
// (https://en.wikipedia.org/wiki/Domain_of_a_function). Shared provenance note:
// `collections-indexable.library.plato`.

library FunctionalProcedural
{
    //==
    // # Procedural
    //
    // Evaluation over a batch of inputs. The result collection is constructed by
    // the Array.Map intrinsic, so this no longer needs a concept that can build
    // one.

    // Evaluate the mapping at every input, preserving order. Result element i is
    // Eval(inputs[i]).
    EvalAll(self: Procedural<$TDomain, $TRange>, inputs: Array<$TDomain>): Array<$TRange>
        => inputs.Map(input => self.Eval(input));

    //==
    // # Bijective
    //
    // Round-trip identities for an invertible mapping
    // (https://en.wikipedia.org/wiki/Bijection).

    // Map forward then back; equals the original input for a true bijection.
    RoundTripDomain(self: Bijective<$TDomain, $TRange>, input: $TDomain): $TDomain
        => self.EvalInverse(self.Eval(input));

    // Map back then forward; equals the original output for a true bijection.
    RoundTripRange(self: Bijective<$TDomain, $TRange>, output: $TRange): $TRange
        => self.Eval(self.EvalInverse(output));

    //==
    // # Periodic
    //
    // TODO(concept-gap): a wrapping helper (WrapPhase, mapping a domain value into
    // [0, Period)) needs Modulo on the period type.
    //
    // An earlier note here claimed Plato has no type-parameter constraint syntax.
    // That was wrong. Concept `where` clauses are live and used — see
    // IntervalLike / BoundsLike in intervals-bounds.concepts.plato and
    // MetricSpace in algebra-metric.concepts.plato — so the bound is expressible
    // as `concept Periodic<TPeriod> where TPeriod: Modular` on the declaration in
    // functional.concepts.plato. `concept Modular` is declared in
    // algebra-operations.concepts.plato, and the one implementor path
    // (PeriodicCurve<TRange> inherits Periodic<Number>) satisfies it: Number
    // implements Real, which inherits Arithmetic, which inherits Modular.
    //
    // The bound is therefore a one-line edit to a file this library-body pass does
    // not own. It is not sufficient on its own, though: Periodic carries no Eval
    // (it does not inherit Procedural), so there is no domain value on the surface
    // to wrap and the bound alone ships no helper. Both halves are owned by the
    // functional package.
    //
    // What genuinely has no syntax is a bound on a *library function's* type
    // variables — MethodDeclaration takes no type parameters at all (see
    // PlatoGrammar.MethodDeclaration), so a constraint can only ever sit on a
    // concept declaration. That limit does not block this item.

    //==
    // # ParameterDomain
    //
    // Convenience accessors over the preferred evaluation interval. The Domain is
    // a NumberInterval with Start and End fields.

    // The lower bound of the preferred parameter range.
    DomainStart(self: ParameterDomain): Number
        => self.Domain.Start;

    // The upper bound of the preferred parameter range.
    DomainEnd(self: ParameterDomain): Number
        => self.Domain.End;

    // The width of the preferred parameter range (End - Start).
    DomainWidth(self: ParameterDomain): Number
        => self.Domain.End - self.Domain.Start;

    // The midpoint of the preferred parameter range.
    DomainCenter(self: ParameterDomain): Number
        => (self.Domain.Start + self.Domain.End) / 2.0;

    // True when t lies within the preferred parameter range (inclusive).
    DomainContains(self: ParameterDomain, t: Number): Boolean
        => t >= self.Domain.Start && t <= self.Domain.End;
}
