//==
// # Deformations — Eval bodies and apply lifts
//
// Bodies for Deformation2D/Deformation3D (`deformations.concepts.plato`) on the
// catalog types in `deformations.types.plato`, plus lifts onto Deformable2D/3D and
// point sugar. Weighted apply takes a ScalarField as a separate modulator —
// falloff is never a field of the warp itself.
//
// Normals contract: Eval moves points only. After deforming meshes, recompute
// normals from the new positions (no analytic Jacobian in this library yet).

library Deformations
{
    //==
    // # Helpers

    // Rotate the displacement from origin to point about axis by angle, then
    // re-seat at origin. Shared by Twist3D and Bend3D.
    RotateAboutAxis(origin: Point3D, axis: Direction3D, angle: Angle, point: Point3D): Point3D
        => origin + origin.Between(point).Transform(Quaternion(AxisAngle(axis, angle)));

    //==
    // # Deformation3D catalog

    // Twist about Axis: angle accumulates with signed height along the axis.
    Eval(self: Twist3D, p: Point3D): Point3D
        => RotateAboutAxis(
            self.Origin,
            self.Axis,
            self.AnglePerUnit * self.Origin.Between(p).Dot(self.Axis.Vector),
            p);

    // Cheap bend: rotate about Axis by Curvature times progress along Direction.
    Eval(self: Bend3D, p: Point3D): Point3D
        => RotateAboutAxis(
            self.Origin,
            self.Axis,
            (self.Curvature * self.Origin.Between(p).Dot(self.Direction.Vector)).Angle,
            p);

    // Taper: scale the perpendicular offset by (1 + Rate * t).
    Eval(self: Taper3D, p: Point3D): Point3D
    {
        var o = self.Origin.Between(p);
        var t = o.Dot(self.Axis.Vector);
        var scale = 1.0 + self.Rate * t;
        return self.Origin
            + self.Axis.Vector * t
            + PerpendicularComponent(o, self.Axis.Vector) * scale;
    }

    // Shear: translate by Rate scaled by signed progress along Axis.
    Eval(self: Shear3D, p: Point3D): Point3D
        => p + self.Rate * self.Origin.Between(p).Dot(self.Axis.Vector);

    // Spherify: lerp toward the radial projection onto the sphere.
    Eval(self: Spherify3D, p: Point3D): Point3D
    {
        var o = self.Center.Between(p);
        var lenSq = o.Dot(o);
        var dir = lenSq > 0.0000001 ? o.Normalize : Vector3D(0.0, 0.0, 1.0);
        return p.Lerp(self.Center + dir * self.Radius, self.Strength);
    }

    //==
    // # Deformation2D catalog

    // Planar shear: translate by Rate scaled by signed progress along Axis.
    Eval(self: Shear2D, p: Point2D): Point2D
        => p + self.Rate * self.Origin.Between(p).Dot(self.Axis.Vector);

    // Planar taper: scale the perpendicular offset by (1 + Rate * t).
    Eval(self: Taper2D, p: Point2D): Point2D
    {
        var o = self.Origin.Between(p);
        var axis = self.Axis.Vector;
        var t = o.Dot(axis);
        var scale = 1.0 + self.Rate * t;
        var perp = o - axis * t;
        return self.Origin + axis * t + perp * scale;
    }

    // Polar swirl: rotate about Origin by AnglePerUnit times radius.
    Eval(self: Twist2D, p: Point2D): Point2D
    {
        var o = self.Origin.Between(p);
        var r = o.Magnitude;
        return self.Origin + o.Transform(Rotation2D(self.AnglePerUnit * r));
    }

    // Evaluate a stored planar point map.
    Eval(self: MappingDeformation2D, p: Point2D): Point2D
        => self.Mapping(p);

    // Evaluate a stored spatial point map.
    Eval(self: MappingDeformation3D, p: Point3D): Point3D
        => self.Mapping(p);

    //==
    // # Compose and Multiply
    //
    // Same contract as transforms: Compose(first, second) applies first, then
    // second. Multiply on two deformations is that Compose (enables `*`).
    // Multiply by a Number scales strength: p.Lerp(d.Eval(p), t).

    // Planar composition: apply first, then second.
    Compose(first: Deformation2D, second: Deformation2D): MappingDeformation2D
        => MappingDeformation2D(p => second.Eval(first.Eval(p)));

    // Spatial composition: apply first, then second.
    Compose(first: Deformation3D, second: Deformation3D): MappingDeformation3D
        => MappingDeformation3D(p => second.Eval(first.Eval(p)));

    // Alias for Compose — enables `a * b` (applies a first).
    Multiply(a: Deformation2D, b: Deformation2D): MappingDeformation2D
        => a.Compose(b);

    // Alias for Compose — enables `a * b` (applies a first).
    Multiply(a: Deformation3D, b: Deformation3D): MappingDeformation3D
        => a.Compose(b);

    // Constant-strength planar warp: t of 0 is identity, 1 is full warp.
    Multiply(d: Deformation2D, t: Number): MappingDeformation2D
        => MappingDeformation2D(p => p.Lerp(d.Eval(p), t));

    // Constant-strength spatial warp: t of 0 is identity, 1 is full warp.
    Multiply(d: Deformation3D, t: Number): MappingDeformation3D
        => MappingDeformation3D(p => p.Lerp(d.Eval(p), t));

    // Commutative strength: `t * d` same as `d * t`.
    Multiply(t: Number, d: Deformation2D): MappingDeformation2D
        => d.Multiply(t);

    // Commutative strength: `t * d` same as `d * t`.
    Multiply(t: Number, d: Deformation3D): MappingDeformation3D
        => d.Multiply(t);

    //==
    // # Apply lifts
    //
    // Bridge Deformation* into the existing Deformable* seam and point sugar.
    // Weighted forms take a scalar field; weight 0 is identity, 1 is full warp.
    // Apply a planar deformation to deformable geometry.
    Deform(self: Deformable2D, d: Deformation2D): Self
        => self.Deform(p => d.Eval(p));

    // Apply a spatial deformation to deformable geometry.
    Deform(self: Deformable3D, d: Deformation3D): Self
        => self.Deform(p => d.Eval(p));

    // Point sugar: p.Deform(d), parallel to p.Transform(m).
    Deform(p: Point2D, d: Deformation2D): Point2D
        => d.Eval(p);

    // Point sugar: p.Deform(d), parallel to p.Transform(m).
    Deform(p: Point3D, d: Deformation3D): Point3D
        => d.Eval(p);

    // Weighted planar deform: lerp between p and d.Eval(p) by weight.Eval(p).
    Deform(self: Deformable2D, d: Deformation2D, weight: ScalarField2D): Self
        => self.Deform(p => p.Lerp(d.Eval(p), weight.Eval(p)));

    // Weighted spatial deform: lerp between p and d.Eval(p) by weight.Eval(p).
    Deform(self: Deformable3D, d: Deformation3D, weight: ScalarField3D): Self
        => self.Deform(p => p.Lerp(d.Eval(p), weight.Eval(p)));
}
