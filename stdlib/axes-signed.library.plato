//==
// # SignedAxis3D conversions and algebra
//
// Total, one-way conversions from the oriented 3D cardinal axis (`axes.types.plato`)
// out to the geometric vocabulary — unsigned axis, sense, unit vector, unit
// direction — plus the opposite-orientation flip.

library SignedAxes
{
    // The unsigned axis this oriented axis lies along (drops the sign).
    Axis3D(self: SignedAxis3D): Axis3D
        => match (self) {
            PosX => Axis3D.X;
            NegX => Axis3D.X;
            PosY => Axis3D.Y;
            NegY => Axis3D.Y;
            PosZ => Axis3D.Z;
            NegZ => Axis3D.Z;
        };

    // The sense of this axis: +1 for the positive faces, -1 for the negative faces.
    Sign(self: SignedAxis3D): Integer
        => match (self) {
            PosX => 1;
            NegX => -1;
            PosY => 1;
            NegY => -1;
            PosZ => 1;
            NegZ => -1;
        };

    // The unit vector of this oriented axis (the unsigned basis vector times Sign).
    Vector3D(self: SignedAxis3D): Vector3D
        => match (self) {
            PosX => Vector3D(1.0, 0.0, 0.0);
            NegX => Vector3D(-1.0, 0.0, 0.0);
            PosY => Vector3D(0.0, 1.0, 0.0);
            NegY => Vector3D(0.0, -1.0, 0.0);
            PosZ => Vector3D(0.0, 0.0, 1.0);
            NegZ => Vector3D(0.0, 0.0, -1.0);
        };

    // The unit direction of this oriented axis (its vector, already unit length).
    Direction3D(self: SignedAxis3D): Direction3D
        => Direction3D(self.Vector3D);

    // The oppositely oriented axis along the same line: PosX <=> NegX, etc.
    Opposite(self: SignedAxis3D): SignedAxis3D
        => match (self) {
            PosX => SignedAxis3D.NegX;
            NegX => SignedAxis3D.PosX;
            PosY => SignedAxis3D.NegY;
            NegY => SignedAxis3D.PosY;
            PosZ => SignedAxis3D.NegZ;
            NegZ => SignedAxis3D.PosZ;
        };
}
