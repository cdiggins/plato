//==
// # Polygons and polylines
//
// Point-list geometry: open and closed vertex chains, simple polygons, polygons
// with holes, and the solids obtained by extruding or coning a polygon.
// Winding convention: counter-clockwise boundaries enclose positive area;
// holes wind opposite to the boundary that contains them.

//==
// # Polylines

// A chain of straight segments joining consecutive Points. When Closed, an
// extra segment joins the last point back to the first. At least two points.
type Polyline2D
    implements Geometry2D, Connected, Bounded2D, LengthMeasurable, PointSet2D, Deformable2D
{
    Points: Array<Point2D>;
    Closed: Boolean;
}

// A chain of straight segments in space. When Closed, an extra segment joins
// the last point back to the first.
type Polyline3D
    implements Geometry3D, Connected, Bounded3D, LengthMeasurable, PointSet3D, Deformable3D
{
    Points: Array<Point3D>;
    Closed: Boolean;
}

// A chain of straight segments in N-dimensional space. When Closed, an extra
// segment joins the last point back to the first. All points share one arity.
type PolylineN
    implements GeometryND, Connected, LengthMeasurable
{
    Points: Array<PointN>;
    Closed: Boolean;
}

//==
// # Polygons in the plane

// A simple closed polygon: Points are the boundary vertices in order, the last
// implicitly joined to the first. Invariants: at least three vertices, no edge
// crossings; counter-clockwise winding encloses positive area.
type Polygon2D
    implements Geometry2D, ClosedShape, Connected, PlanarMeasurable, Bounded2D, PointSet2D, Centroid2D, ContainsPoint2D, NearestPoint2D, Deformable2D
{
    Points: Array<Point2D>;
}

// A polygon whose vertices are in strictly convex position, counter-clockwise.
// The stronger invariant unlocks constant-cost support mapping and logarithmic
// containment tests.
type ConvexPolygon2D
    implements Geometry2D, ClosedShape, ConvexShape, Connected, PlanarMeasurable, Bounded2D, PointSet2D, Centroid2D, ContainsPoint2D, NearestPoint2D, SupportMappable2D, Deformable2D
{
    Points: Array<Point2D>;
}

// A polygonal region with holes: the area inside Boundary and outside every
// hole. Invariants: holes lie strictly inside the boundary, are mutually
// disjoint, and wind opposite to it.
type PolygonWithHoles2D
    implements Geometry2D, ClosedShape, Connected, PlanarMeasurable, Bounded2D, Centroid2D, ContainsPoint2D, Deformable2D
{
    Boundary: Polygon2D;
    Holes: Array<Polygon2D>;
}

// A multi-polygon region: the union of mutually disjoint components. The result
// shape of Boolean operations over polygons; possibly disconnected, possibly
// empty.
type PolygonSet2D
    implements Geometry2D, ClosedShape, PlanarMeasurable, Bounded2D, ContainsPoint2D, Deformable2D
{
    Polygons: Array<PolygonWithHoles2D>;
}

// A star polygon with PointCount tips alternating between OuterRadius and
// InnerRadius vertices about Center (2 * PointCount vertices in all); Rotation
// turns the first tip away from +X. Invariants: PointCount >= 3,
// 0 < InnerRadius <= OuterRadius.
type RegularStar2D
    implements Geometry2D, ClosedShape, Connected, PlanarMeasurable, Bounded2D, Centroid2D, ContainsPoint2D
{
    Center: Point2D;
    OuterRadius: Number;
    InnerRadius: Number;
    PointCount: Integer;
    Rotation: Angle;
}

//==
// # Polygons in space

// A planar polygon embedded in 3D: Points are coplanar boundary vertices in
// order, the last implicitly joined to the first. The normal follows the
// right-hand rule around the winding.
type Polygon3D
    implements Geometry3D, ClosedShape, Connected, Manifold, Orientable, PlanarMeasurable, Bounded3D, PointSet3D, Centroid3D, NearestPoint3D
{
    Points: Array<Point3D>;
}

//==
// # Polygon-derived solids

// The solid swept by translating Base along Offset: a general prism. Oblique
// when Offset is not perpendicular to the base plane; convex when the base is
// convex.
type Prism3D
    implements Geometry3D, ClosedShape, Connected, SpatialMeasurable, Bounded3D, Centroid3D, ContainsPoint3D
{
    Base: Polygon3D;
    Offset: Vector3D;
}

// The solid cone over a polygon: all segments from points of Base to Apex.
// Degenerate when Apex lies in the base plane.
type Pyramid3D
    implements Geometry3D, ClosedShape, Connected, SpatialMeasurable, Bounded3D, Centroid3D, ContainsPoint3D
{
    Base: Polygon3D;
    Apex: Point3D;
}

//==
// # Polygon and polyline operations
//
// Bodies for the types above (`LIBRARIES.md` ground rules 1 and 10). The 2D ring
// kernels — shoelace area, area centroid, even-odd containment, chain length,
// chain projection — live in `geometry.library.plato`; this block supplies the
// SPACE analogues (Newell vector area, planar-polygon centroid and containment)
// and wires every declared type to one or the other.
//
// Conventions fixed here:
//
//   * WINDING: counter-clockwise boundaries enclose positive area; holes wind
//     opposite to the boundary that contains them (this file's header). The
//     hole-aware bodies below rely only on the DECLARED containment invariants,
//     never on the stored hole winding — `Area(PolygonWithHoles2D)` subtracts
//     absolute hole areas rather than adding signed ones, so a hole stored with
//     the wrong winding still subtracts.
//   * `Area` is NON-NEGATIVE everywhere. `SignedArea(Polygon2D)` is offered
//     separately for callers that need the orientation; it is the raw shoelace
//     value, which for a self-intersecting ring is the winding-weighted area, not
//     the area of the covered point set.
//   * CONTAINMENT is the even-odd rule (2D) or its in-plane projection (3D), so a
//     point exactly on a boundary edge is not classified reliably. Every other
//     containment test here — the prism's and pyramid's height parameters — IS
//     boundary inclusive.
//   * `Perimeter` of a region with holes counts EVERY boundary component: the
//     outer ring plus every hole ring. Likewise `Perimeter(PolygonSet2D)` sums all
//     components.
//   * The polyline `Closed` flag decides whether the wrap-around edge counts; a
//     polygon ring always counts it.
//   * Polygon3D is assumed PLANAR (its declaration says so) and SIMPLE.

library Polygons
{
    //==
    // # Planar-polygon kernels in space

    // The vector area of a closed ring: (1/2) * sum of Pi x Pi+1 over the position
    // vectors. Its magnitude is the enclosed area and its direction is the
    // right-hand-rule normal, both independent of where the origin sits (the
    // origin-dependent terms cancel around a closed loop). Newell's method.
    // https://en.wikipedia.org/wiki/Polygon#Area
    VectorArea(points: Array<Point3D>): Vector3D
        => points.Count
            .MapRange(i => points.At(i).PositionVector.Cross(points.AtModulo(i + 1).PositionVector))
            .Reduce(Vector3D(0.0, 0.0, 0.0), (acc, c) => acc.Add(c))
            .Multiply(0.5);

    // Any unit vector perpendicular to `normal`. Crossed against whichever world
    // axis `normal` is least aligned with, so the construction never degenerates;
    // the resulting azimuth is arbitrary but stable, which is all a projection
    // basis needs. Precondition: normal is non-zero.
    PlaneTangent(normal: Vector3D): Vector3D
        => (normal.Z.Abs < 0.9 ? Vector3D(0.0, 0.0, 1.0) : Vector3D(1.0, 0.0, 0.0))
            .Cross(normal).Normalize;

    // A space point expressed in the plane coordinates (u, v) anchored at `origin`.
    PlaneCoordinates(origin: Point3D, u: Vector3D, v: Vector3D, p: Point3D): Point2D
        => (origin.Between(p).Dot(u), origin.Between(p).Dot(v));

    // True when `point` projects INSIDE the planar ring. Only the in-plane position
    // is tested: a point far off the plane whose projection lands inside reports
    // true, so callers must check the plane distance themselves when they care.
    // Exact for any simple planar polygon, convex or not.
    PlanarPolygonContains(points: Array<Point3D>, normal: Vector3D, point: Point3D): Boolean
    {
        var u = PlaneTangent(normal);
        var v = normal.Normalize.Cross(u);
        var origin = points.First;
        var flat = points.Map(q => PlaneCoordinates(origin, u, v, q));
        return flat.PolygonContainsPoint(PlaneCoordinates(origin, u, v, point));
    }

    // The area centroid of a planar ring in space: the area-weighted mean of the
    // fan triangles (P0, Pi, Pi+1), each weighted by its SIGNED area about the
    // polygon normal. The signs make the fan exact for a non-convex simple polygon
    // too — the triangles that stray outside the ring cancel.
    // https://en.wikipedia.org/wiki/Centroid#By_geometric_decomposition
    // Precondition: non-zero area.
    PlanarPolygonCentroid(points: Array<Point3D>): Point3D
    {
        var normal = points.VectorArea.Normalize;
        var origin = points.First;
        var count = points.Count;
        var areas = count.MapRange(i => 0.5 * origin.Between(points.At(i))
            .Cross(origin.Between(points.AtModulo(i + 1))).Dot(normal));
        var total = SumOf(areas);
        var cx = SumOf(count.MapRange(i => areas.At(i)
            * (origin.X + points.At(i).X + points.AtModulo(i + 1).X) / 3.0));
        var cy = SumOf(count.MapRange(i => areas.At(i)
            * (origin.Y + points.At(i).Y + points.AtModulo(i + 1).Y) / 3.0));
        var cz = SumOf(count.MapRange(i => areas.At(i)
            * (origin.Z + points.At(i).Z + points.AtModulo(i + 1).Z) / 3.0));
        return (cx / total, cy / total, cz / total);
    }

    // The bounds translated bodily by `offset`.
    TranslateBounds(b: Bounds3D, offset: Vector3D): Bounds3D
        => (b.Min.Add(offset), b.Max.Add(offset));

    //==
    // # Polylines

    // The summed length of the chain; the wrap-around edge counts only when Closed.
    Length(p: Polyline2D): Number
        => p.Points.ChainLength(p.Closed);

    // The summed length of the chain in space.
    Length(p: Polyline3D): Number
        => p.Points.ChainLength(p.Closed);

    // The summed length of the chain in N dimensions. Written out rather than
    // delegated because ChainLength is spelled for Point2D/Point3D only; PointN's
    // delta type is VectorN, whose Magnitude comes from Normed.
    Length(p: PolylineN): Number
        => SumOf((p.Closed ? p.Points.Count : p.Points.Count - 1)
            .MapRange(i => p.Points.At(i).Between(p.Points.AtModulo(i + 1)).Magnitude));

    // The polyline with every vertex carried through the mapping; Closed is kept.
    Deform(p: Polyline2D, mapping: Function1<Point2D, Point2D>): Polyline2D
        => (p.Points.Map(mapping), p.Closed);

    // The polyline with every vertex carried through the mapping; Closed is kept.
    Deform(p: Polyline3D, mapping: Function1<Point3D, Point3D>): Polyline3D
        => (p.Points.Map(mapping), p.Closed);

    //==
    // # Polygon2D and ConvexPolygon2D

    // The SIGNED shoelace area: positive for counter-clockwise winding, negative
    // for clockwise. https://en.wikipedia.org/wiki/Shoelace_formula
    SignedArea(p: Polygon2D): Number
        => p.Points.ShoelaceArea;

    // The enclosed area, always non-negative.
    Area(p: Polygon2D): Number
        => p.Points.ShoelaceArea.Abs;

    // The total boundary length, including the closing edge.
    Perimeter(p: Polygon2D): Number
        => p.Points.ChainLength(true);

    // The area centroid (NOT the mean of the vertices).
    Centroid(p: Polygon2D): Point2D
        => p.Points.PolygonAreaCentroid;

    // Even-odd containment.
    Contains(p: Polygon2D, point: Point2D): Boolean
        => p.Points.PolygonContainsPoint(point);

    // The query point when it lies in the polygon, otherwise the nearest point of
    // the boundary.
    ClosestPoint(p: Polygon2D, point: Point2D): Point2D
        => p.Contains(point) ? point : p.Points.ClosestPointOnChain(true, point);

    // The polygon with every vertex carried through the mapping.
    Deform(p: Polygon2D, mapping: Function1<Point2D, Point2D>): Polygon2D
        => Polygon2D(p.Points.Map(mapping));

    // The enclosed area. Non-negative; the convex invariant does not change the
    // formula, only guarantees the ring is simple.
    Area(p: ConvexPolygon2D): Number
        => p.Points.ShoelaceArea.Abs;

    // The total boundary length.
    Perimeter(p: ConvexPolygon2D): Number
        => p.Points.ChainLength(true);

    // The area centroid.
    Centroid(p: ConvexPolygon2D): Point2D
        => p.Points.PolygonAreaCentroid;

    // Even-odd containment. A half-plane sweep would exploit convexity, but the
    // even-odd test is already exact for a simple ring and needs no winding
    // assumption.
    Contains(p: ConvexPolygon2D, point: Point2D): Boolean
        => p.Points.PolygonContainsPoint(point);

    // The query point when it lies in the polygon, otherwise the nearest boundary
    // point.
    ClosestPoint(p: ConvexPolygon2D, point: Point2D): Point2D
        => p.Contains(point) ? point : p.Points.ClosestPointOnChain(true, point);

    // The vertex farthest along `direction`. Exact because the polygon is convex,
    // so a support point is always a vertex. Linear scan, not the binary search the
    // declaration's "constant-cost support mapping" note anticipates.
    // TODO(content): binary search over the convex vertex ring.
    Support(p: ConvexPolygon2D, direction: Direction2D): Point2D
        => p.Points.Reduce(p.Points.First, (best, v) =>
            direction.Vector.Dot(v.PositionVector) > direction.Vector.Dot(best.PositionVector)
                ? v : best);

    // The polygon with every vertex carried through the mapping. Convexity is NOT
    // re-checked; a non-affine mapping can break the type's invariant.
    Deform(p: ConvexPolygon2D, mapping: Function1<Point2D, Point2D>): ConvexPolygon2D
        => ConvexPolygon2D(p.Points.Map(mapping));

    //==
    // # PolygonWithHoles2D

    // The boundary's area less every hole's area.
    Area(r: PolygonWithHoles2D): Number
        => r.Boundary.Area - SumOf(r.Holes.Map(h => h.Area));

    // EVERY boundary component: the outer ring plus every hole ring.
    Perimeter(r: PolygonWithHoles2D): Number
        => r.Boundary.Perimeter + SumOf(r.Holes.Map(h => h.Perimeter));

    // The area-weighted centroid of the boundary minus the holes: each hole
    // contributes its centroid with a NEGATIVE weight.
    // https://en.wikipedia.org/wiki/Centroid#By_geometric_decomposition
    // Precondition: the net area is non-zero.
    Centroid(r: PolygonWithHoles2D): Point2D
    {
        var boundaryArea = r.Boundary.Area;
        var holeAreas = r.Holes.Map(h => h.Area);
        var net = boundaryArea - SumOf(holeAreas);
        var centre = r.Boundary.Centroid;
        var cx = centre.X * boundaryArea
            - SumOf(r.Holes.Count.MapRange(i => r.Holes.At(i).Centroid.X * holeAreas.At(i)));
        var cy = centre.Y * boundaryArea
            - SumOf(r.Holes.Count.MapRange(i => r.Holes.At(i).Centroid.Y * holeAreas.At(i)));
        return (cx / net, cy / net);
    }

    // The bounds of the outer boundary; the holes lie strictly inside it.
    Bounds(r: PolygonWithHoles2D): Bounds2D
        => r.Boundary.Bounds;

    // Inside the boundary and outside every hole.
    Contains(r: PolygonWithHoles2D, point: Point2D): Boolean
        => r.Boundary.Contains(point) && r.Holes.Any(h => h.Contains(point)).Not;

    // The region with the boundary and every hole carried through the mapping.
    Deform(r: PolygonWithHoles2D, mapping: Function1<Point2D, Point2D>): PolygonWithHoles2D
        => (r.Boundary.Deform(mapping), r.Holes.Map(h => h.Deform(mapping)));

    //==
    // # PolygonSet2D
    //
    // The components are mutually disjoint, so every measure is a plain sum and
    // containment is a disjunction.

    // The summed area of the components.
    Area(s: PolygonSet2D): Number
        => SumOf(s.Polygons.Map(p => p.Area));

    // The summed boundary length of the components (holes included).
    Perimeter(s: PolygonSet2D): Number
        => SumOf(s.Polygons.Map(p => p.Perimeter));

    // The union of the component bounds. Precondition: at least one component (the
    // declaration allows an empty set, for which there is no bounding rectangle).
    Bounds(s: PolygonSet2D): Bounds2D
        => s.Polygons.Map(p => p.Bounds)
            .Reduce(s.Polygons.First.Bounds, (acc, b) => UnionOfBounds(acc, b));

    // Inside any component.
    Contains(s: PolygonSet2D, point: Point2D): Boolean
        => s.Polygons.Any(p => p.Contains(point));

    // The set with every component carried through the mapping.
    Deform(s: PolygonSet2D, mapping: Function1<Point2D, Point2D>): PolygonSet2D
        => PolygonSet2D(s.Polygons.Map(p => p.Deform(mapping)));

    //==
    // # RegularStar2D
    //
    // https://en.wikipedia.org/wiki/Star_polygon

    // The 2 * PointCount vertices in ring order, alternating outer and inner,
    // counter-clockwise from Rotation. Even indices are tips.
    RegularStarVertices(s: RegularStar2D): Array<Point2D>
        => (s.PointCount * 2).MapRange(i =>
        {
            var radius = i.IsEven ? s.OuterRadius : s.InnerRadius;
            var a = s.Rotation + (i.ToNumber / (2.0 * s.PointCount.ToNumber)).Turns;
            return s.Center.Add(Vector2D(a.Cos, a.Sin).Multiply(radius));
        });

    // n * R * r * sin(pi/n): the star is 2n triangles from the centre, each with
    // sides R and r meeting at pi/n, so each has area (1/2)*R*r*sin(pi/n).
    Area(s: RegularStar2D): Number
        => s.PointCount.ToNumber * s.OuterRadius * s.InnerRadius
        * (0.5 / s.PointCount.ToNumber).Turns.Sin;

    // 2n equal edges, each the third side of a triangle with sides R and r meeting
    // at pi/n: sqrt(R^2 + r^2 - 2*R*r*cos(pi/n)) by the law of cosines.
    // https://en.wikipedia.org/wiki/Law_of_cosines
    Perimeter(s: RegularStar2D): Number
        => 2.0 * s.PointCount.ToNumber
        * (s.OuterRadius.Square + s.InnerRadius.Square
            - 2.0 * s.OuterRadius * s.InnerRadius
                * (0.5 / s.PointCount.ToNumber).Turns.Cos).Sqrt;

    // The stored centre, by the star's n-fold rotational symmetry.
    Centroid(s: RegularStar2D): Point2D
        => s.Center;

    // TIGHT: the bounds of the computed vertices (only the tips can be extreme).
    Bounds(s: RegularStar2D): Bounds2D
        => s.RegularStarVertices.BoundsOfPoints;

    // Even-odd containment over the computed vertex ring. The star is non-convex,
    // which the even-odd rule handles correctly.
    Contains(s: RegularStar2D, point: Point2D): Boolean
        => s.RegularStarVertices.PolygonContainsPoint(point);

    //==
    // # Polygon3D

    // The magnitude of the vector area (Newell). Exact for a planar ring; for a
    // non-planar ring it is the area of the ring's projection onto the best-fit
    // plane, which the declaration's planarity invariant rules out.
    Area(p: Polygon3D): Number
        => p.Points.VectorArea.Magnitude;

    // The total boundary length, including the closing edge.
    Perimeter(p: Polygon3D): Number
        => p.Points.ChainLength(true);

    // The area centroid of the planar ring.
    Centroid(p: Polygon3D): Point3D
        => p.Points.PlanarPolygonCentroid;

    // The unit normal, following the right-hand rule around the winding.
    Normal(p: Polygon3D): Direction3D
        => Direction3D(p.Points.VectorArea.Normalize);

    // The query projected onto the polygon's plane when that projection lands
    // inside the ring, otherwise the nearest point of the boundary. Exact for any
    // simple planar polygon, convex or not.
    ClosestPoint(p: Polygon3D, point: Point3D): Point3D
    {
        var normal = p.Points.VectorArea.Normalize;
        var origin = p.Points.First;
        var projected = point.Subtract(normal.Multiply(origin.Between(point).Dot(normal)));
        return p.Points.PlanarPolygonContains(normal, projected)
            ? projected
            : p.Points.ClosestPointOnChain(true, point);
    }

    //==
    // # Prism3D
    //
    // The base swept along Offset. Precondition throughout: Offset is not parallel
    // to the base plane (the prism would have zero height and the containment test
    // would divide by zero).

    // |vectorArea . Offset| — the base area times the component of Offset
    // perpendicular to the base, which is the prism's height. Correct for an
    // oblique prism (Cavalieri's principle).
    // https://en.wikipedia.org/wiki/Prism_(geometry)#Volume
    Volume(p: Prism3D): Number
        => p.Base.Points.VectorArea.Dot(p.Offset).Abs;

    // The two parallel bases plus one parallelogram per base edge, each of area
    // |edge x Offset|.
    SurfaceArea(p: Prism3D): Number
        => 2.0 * p.Base.Area
        + SumOf(p.Base.Points.Count.MapRange(i => p.Base.Points.At(i)
            .Between(p.Base.Points.AtModulo(i + 1)).Cross(p.Offset).Magnitude));

    // The base centroid displaced by half the sweep: the prism is uniform along
    // Offset.
    Centroid(p: Prism3D): Point3D
        => p.Base.Centroid.Add(p.Offset.Multiply(0.5));

    // The union of the base's bounds and the swept copy's.
    Bounds(p: Prism3D): Bounds3D
        => UnionOfBounds(p.Base.Bounds, p.Base.Bounds.TranslateBounds(p.Offset));

    // True when the query's sweep parameter lies in [0, 1] AND the query slid back
    // along Offset onto the base plane lands inside the base ring.
    Contains(p: Prism3D, point: Point3D): Boolean
    {
        var normal = p.Base.Points.VectorArea.Normalize;
        var origin = p.Base.Points.First;
        var s = origin.Between(point).Dot(normal) / p.Offset.Dot(normal);
        return s >= 0.0 && s <= 1.0
            && p.Base.Points.PlanarPolygonContains(normal, point.Subtract(p.Offset.Multiply(s)));
    }

    //==
    // # Pyramid3D
    //
    // Precondition throughout: the Apex is not in the base plane (the declaration's
    // stated degenerate case).

    // (1/3) * baseArea * height, with the height the perpendicular distance from
    // the Apex to the base plane — written as |vectorArea . (Apex - P0)| / 3.
    // https://en.wikipedia.org/wiki/Pyramid_(geometry)#Volume
    Volume(y: Pyramid3D): Number
        => y.Base.Points.VectorArea.Dot(y.Base.Points.First.Between(y.Apex)).Abs / 3.0;

    // The base plus one triangle per base edge, each spanned by that edge and the
    // Apex.
    SurfaceArea(y: Pyramid3D): Number
        => y.Base.Area
        + SumOf(y.Base.Points.Count.MapRange(i => 0.5 * y.Base.Points.At(i)
            .Between(y.Base.Points.AtModulo(i + 1))
            .Cross(y.Base.Points.At(i).Between(y.Apex)).Magnitude));

    // One quarter of the way from the base centroid towards the Apex: the standard
    // centroid of any solid cone over a planar base.
    // https://en.wikipedia.org/wiki/Pyramid_(geometry)
    Centroid(y: Pyramid3D): Point3D
        => y.Base.Centroid.Add(y.Base.Centroid.Between(y.Apex).Multiply(0.25));

    // The union of the base's bounds and the Apex.
    Bounds(y: Pyramid3D): Bounds3D
        => UnionOfBounds(y.Base.Bounds, Bounds3D(y.Apex, y.Apex));

    // True when the query lies between the Apex plane-height and the base
    // (parameter t in [0, 1], t = 0 at the Apex, t = 1 in the base plane) AND the
    // ray from the Apex through the query meets the base plane inside the base
    // ring. Boundary inclusive on t.
    Contains(y: Pyramid3D, point: Point3D): Boolean
    {
        var normal = y.Base.Points.VectorArea.Normalize;
        var origin = y.Base.Points.First;
        var t = 1.0 - origin.Between(point).Dot(normal)
            / origin.Between(y.Apex).Dot(normal);
        return t >= 0.0 && t <= 1.0
            && (t <= 0.0 || y.Base.Points.PlanarPolygonContains(normal,
                y.Apex.Add(y.Apex.Between(point).Multiply(1.0 / t))));
    }
}
